theorem holomorphicCoordinate_complexCoverWeight
    {n : ℕ} {a : LogSpace n → ℝ}
    (ha : ContDiff ℝ 1 a) (x : LogSpace n) (j : Fin n) :
    holomorphicCoordinate (complexCoverWeight a) x j =
      -complexCoverWeight a x *
        holomorphicCoordinate (fun y => (a y : ℂ)) x j := by
