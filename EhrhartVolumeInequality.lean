theorem angularWeakSourceCutoffAdjointDefectL2_tendsto
    {n : ℕ} {a : LogTorus n → ℝ}
    (d : angularWeightedScalarL2 a)
    (W : angularWeightedFormL2 a)
    {C : ℝ} (hC₀ : 0 ≤ C)
