theorem sourceJointSpatialComplexHessian_isHermitian {n : ℕ}
    {f : SourceJointComplexCover n → ℝ}
    (hf : ContDiff ℝ 2 f)
    (τ : ℂ)
    (z : TorusCharacters.LogSpace n) :
    (sourceJointSpatialComplexHessian f τ z).IsHermitian := by
