def angularClosedMollifiedRadialAdjointCommutatorL2
    {n : ℕ} {a : LogTorus n → ℝ}
    (ha : Continuous a) (W : angularWeightedFormL2 a)
    (ℓ m : ℕ) : angularWeightedScalarL2 a :=
