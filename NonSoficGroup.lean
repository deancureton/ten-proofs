    Subgroup.closure
      (sourceCompressionUAlphaEquiv.toMonoidHom ''
        (SΓ : Set
          (SoficGroups.prefixElementaryGroup
            SoficGroups.alphaPrefixCode))) = ⊤
  rw [← MonoidHom.map_closure, hgenerates,
    Subgroup.map_top_of_surjective
