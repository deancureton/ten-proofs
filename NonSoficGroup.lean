        (hx : x ∈ (Finset.univ \ D n :
          Finset {y : Fin (A.model (ν (n + N))).size //
            y ∈ C (n + N)}))
        (_hi : completedRestriction
          ((A.model (ν (n + N))).action ((i : K), (1 : J)))
          (C (n + N)) x ∈
            (Finset.univ \ D n :
              Finset {y : Fin (A.model (ν (n + N))).size //
