                    SoficGroups.alphaPrefixCode)) *
              ((A.model n).action
                (SoficGroups.SourceBothCompressionNormalization.sourceCompressionTable j))⁻¹)).card : ℝ) /
                (A.model n).size) from funext hidentity]
