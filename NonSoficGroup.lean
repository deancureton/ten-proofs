        (fun n =>
          (∑ i : ι ⊕ κ,
            ((SoficGroups.MidrankPermutationEnergy.rankDecreasingVertices
              Finset.univ
              (SoficGroups.SourceCommonOffsetMidrankEnergy.componentLogRank
                (Q n) (H n) (r n))
              (Sum.elim (σ n) (T n) i)).card : ℝ)) /
