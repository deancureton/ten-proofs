    rw [← hreal, Finset.sum_div]
  rw [show
    (fun n =>
      (∑ C ∈ (Q n).parts,
        (SoficGroups.boundary
          (fun i : ↥S =>
            (A.model n).action
                (SoficGroups.SourceBothCompressionNormalization.sourceCompressionTable j) *
