            ((A.model (n + N)).action
              SoficGroups.SourceBothCompressionNormalization.sourceCompressionUElement)⁻¹)
        D : ℝ)
    exact htransported (n + N) (C n) (hCpart n) D hDC hhalf
  · simpa only [sigma] using hCboundary
  · simpa only [P, E, sourceTransportedPartition,
