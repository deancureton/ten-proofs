  have hE : ∀ k, Tendsto
      (fun n => ((E n k).card : ℝ) / (A.model n).size)
      atTop (𝓝 0) := by
    intro k
    simpa only [E] using
      sourceGeneratorFamilyConjugacyBad_density_tendsto_zero A S
  have hboundary : Tendsto
      (fun n =>
        (∑ D ∈ (P n).parts,
          (SoficGroups.boundary (sigma n) D : ℝ)) /
            (A.model n).size)
      atTop (𝓝 0) := by
    change Tendsto
      (fun n =>
        (∑ D ∈
