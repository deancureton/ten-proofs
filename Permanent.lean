theorem homogeneousMap_allTarget_rees_isScalarTower
    {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ) (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    @IsScalarTower
      (homogeneousMapSubalgebra F)
      (Polynomial ℂ)
      (homogeneousMapAllTargetReesQuotient F target e)
      (@Algebra.toSMul
        (homogeneousMapSubalgebra F) (Polynomial ℂ)
        inferInstance inferInstance
        (homogeneousMapReesTargetHom
          F e he hF hzero target).toRingHom.toAlgebra)
      (@Algebra.toSMul
        (Polynomial ℂ) (homogeneousMapAllTargetReesQuotient F target e)
        inferInstance inferInstance
        (homogeneousMapAllTargetReesParameterAlgebra F target e))
      (@Algebra.toSMul
        (homogeneousMapSubalgebra F)
        (homogeneousMapAllTargetReesQuotient F target e)
        inferInstance inferInstance
        (homogeneousMapAllTargetReesSourceAlgebra F target e)) := by
  letI : Algebra (homogeneousMapSubalgebra F) (Polynomial ℂ) :=
    (homogeneousMapReesTargetHom
      F e he hF hzero target).toRingHom.toAlgebra
  letI : Algebra (Polynomial ℂ)
      (homogeneousMapAllTargetReesQuotient F target e) :=
    homogeneousMapAllTargetReesParameterAlgebra F target e
  letI : Algebra (homogeneousMapSubalgebra F)
      (homogeneousMapAllTargetReesQuotient F target e) :=
    homogeneousMapAllTargetReesSourceAlgebra F target e
  apply IsScalarTower.of_algebraMap_eq
  intro x
  let E := homogeneousMapCoordinateAlgEquiv F e he hF hzero
  obtain ⟨p, rfl⟩ := E.surjective x
  induction p using MvPolynomial.induction_on with
  | C c =>
      have hEc : (E (MvPolynomial.C c) : MvPolynomial (Fin k) ℂ) =
          MvPolynomial.C c := by
        simpa only [MvPolynomial.algebraMap_eq, Subalgebra.coe_algebraMap] using
          congrArg (fun z : homogeneousMapSubalgebra F => (z : MvPolynomial (Fin k) ℂ)) (E.commutes c)
      simp only [RingHom.algebraMap_toAlgebra, homogeneousMapAllTargetReesSourceRingHom, AlgHom.toRingHom_eq_coe,
        RingHom.coe_comp, RingHom.coe_coe, Subalgebra.coe_val, Function.comp_apply, hEc, MvPolynomial.algHom_C,
        MvPolynomial.algebraMap_eq, homogeneousMapAllTargetReesParameterRingHom, homogeneousMapReesTargetHom,
        AlgHom.coe_comp, AlgEquiv.coe_toAlgHom, AlgEquiv.symm_apply_apply, Polynomial.algebraMap_eq, Polynomial.aeval_C, E]
  | add p q hp hq =>
      simpa only [map_add] using congrArg₂ (· + ·) hp hq
  | mul_X p i hp =>
      have hE : E (MvPolynomial.X i) =
          (⟨F i, homogeneousMap_coordinate_mem_subalgebra F i⟩ :
            homogeneousMapSubalgebra F) := by
        apply Subtype.ext
        change MvPolynomial.aeval F (MvPolynomial.X i) = F i
        simp only [MvPolynomial.aeval_eq_bind₁, MvPolynomial.bind₁_X_right]
      rw [map_mul, map_mul, map_mul]
      rw [hp, hE]
      rw [map_mul]
      change _ *
          homogeneousMapAllTargetReesSourceRingHom F target e
            (⟨F i, homogeneousMap_coordinate_mem_subalgebra F i⟩ :
              homogeneousMapSubalgebra F) =
        _ * homogeneousMapAllTargetReesParameterRingHom F target e
          (homogeneousMapReesTargetHom
            F e he hF hzero target
            (⟨F i, homogeneousMap_coordinate_mem_subalgebra F i⟩ :
              homogeneousMapSubalgebra F))
      rw [homogeneousMapReesTargetHom_coordinate]
      rw [homogeneousMap_allTarget_rees_source_coordinate]

open scoped TensorProduct

theorem homogeneousMap_allTarget_rees_moduleFinite
    {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ) (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    letI : Algebra (Polynomial ℂ)
      (homogeneousMapAllTargetReesQuotient F target e) :=
        homogeneousMapAllTargetReesParameterAlgebra F target e
    Module.Finite (Polynomial ℂ)
      (homogeneousMapAllTargetReesQuotient F target e) := by
  classical
  let T := homogeneousMapSubalgebra F
  let S := MvPolynomial (Fin k) ℂ
  let P := Polynomial ℂ
  let Q := homogeneousMapAllTargetReesQuotient F target e
  let I : Ideal (MvPolynomial (Fin (k + 1)) ℂ) :=
    Ideal.span (Set.range (homogeneousMapAllTargetReesCoordinate F target e))
  let sourceMap : S →+* Q :=
    (Ideal.Quotient.mk I).comp (MvPolynomial.rename Fin.succ).toRingHom
  letI : Algebra T P :=
    (homogeneousMapReesTargetHom
      F e he hF hzero target).toRingHom.toAlgebra
  letI : Algebra P Q := homogeneousMapAllTargetReesParameterAlgebra F target e
  letI : Algebra T Q := homogeneousMapAllTargetReesSourceAlgebra F target e
  letI : Algebra S Q := sourceMap.toAlgebra
  letI : IsScalarTower T P Q :=
    homogeneousMap_allTarget_rees_isScalarTower F target e he hF hzero
  letI : Module.Finite T S :=
    homogeneousMap_moduleFinite F e he hF hzero
  let g : S →ₐ[T] Q :=
    { toRingHom := sourceMap
      commutes' := fun _ => rfl }
  let L : TensorProduct T P S →ₐ[P] Q :=
    @Algebra.TensorProduct.lift T P P S Q
      inferInstance inferInstance inferInstance
      inferInstance inferInstance inferInstance inferInstance
      inferInstance inferInstance
      inferInstance inferInstance inferInstance
      (homogeneousMap_allTarget_rees_isScalarTower F target e he hF hzero)
      (Algebra.ofId P Q) g (fun _ _ => Commute.all _ _)
  have hsurj : Function.Surjective L := by
    intro y
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    have hrange : Ideal.Quotient.mk I p ∈ L.range := by
      induction p using MvPolynomial.induction_on with
      | C c =>
          refine ⟨algebraMap P (TensorProduct T P S)
            (Polynomial.C c), ?_⟩
          change L (algebraMap P (TensorProduct T P S)
            (Polynomial.C c)) = _
          rw [L.commutes]
          change homogeneousMapAllTargetReesParameterRingHom F target e
            (Polynomial.C c) = _
          simp only [homogeneousMapAllTargetReesParameterRingHom, AlgHom.toRingHom_eq_coe, RingHom.coe_comp,
            RingHom.coe_coe, Function.comp_apply, Polynomial.aeval_C, MvPolynomial.algebraMap_eq, I]
      | add f g hf hg =>
          rw [map_add]
          exact L.range.add_mem hf hg
      | mul_X f i hf =>
          rw [map_mul]
          apply L.range.mul_mem hf
          cases i using Fin.cases with
          | zero =>
              refine ⟨algebraMap P (TensorProduct T P S)
                Polynomial.X, ?_⟩
              change L (algebraMap P (TensorProduct T P S)
                Polynomial.X) = _
              rw [L.commutes]
              change homogeneousMapAllTargetReesParameterRingHom F target e
                Polynomial.X = _
              simp only [homogeneousMapAllTargetReesParameterRingHom, AlgHom.toRingHom_eq_coe, RingHom.coe_comp,
                RingHom.coe_coe, Function.comp_apply, Polynomial.aeval_X, I]
          | succ i =>
              refine ⟨TensorProduct.tmul T (1 : P)
                (MvPolynomial.X i), ?_⟩
              change L (TensorProduct.tmul T (1 : P)
                (MvPolynomial.X i)) = _
              simp only [AlgHom.toRingHom_eq_coe, Algebra.TensorProduct.lift_tmul, map_one, AlgHom.coe_mk,
                RingHom.coe_comp, RingHom.coe_coe, Function.comp_apply, one_mul, L, g,
                sourceMap, I]
              rw [MvPolynomial.rename_X]
    exact hrange
  exact Module.Finite.of_surjective L.toLinearMap hsurj

