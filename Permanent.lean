      (MvPolynomial.homogeneousSubmodule (Fin k) ℂ n) :=
    (Submodule.fg_iff_finiteDimensional _).mp
      (MvPolynomial.homogeneousSubmodule_fg (Fin k) ℂ n)
  have hleft := homogeneousMap_allRank_coordinateSubsetGradedIdealPiece_eq_bot_of_lt
    F hF (insert j restricted) n hn
  have hright := homogeneousMap_allRank_coordinateSubsetGradedIdealPiece_eq_bot_of_lt
    F hF restricted n hn
  unfold homogeneousMapAllKActualCoordinateHilbert
  exact (Submodule.quotEquivOfEq _ _
    (hleft.trans hright.symm)).finrank_eq

theorem homogeneousMap_allRank_actualCoordinateHilbert_insert_recurrence_of_regular
    {k e : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (restricted : Finset (Fin k)) (j : Fin k)
    (hregular : IsSMulRegular
      (MvPolynomial (Fin k) ℂ ⧸ homogeneousMapAllKCoordinateSubsetIdeal F restricted)
      (F j))
    (n : ℕ) :
    homogeneousMapAllKActualCoordinateHilbert F (insert j restricted) (e + n) +
      homogeneousMapAllKActualCoordinateHilbert F restricted n =
      homogeneousMapAllKActualCoordinateHilbert F restricted (e + n) := by
  have hrec := homogeneousMapGradedSupSpan_finrank_add_of_regular
    (homogeneousMapAllKCoordinateSubsetIdeal F restricted)
    (homogeneousMap_allRank_coordinateSubsetIdeal_isHomogeneous F hF restricted)
    (F j) (hF j) hregular n
