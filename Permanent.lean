    RingTheory.Sequence.IsWeaklyRegular R (List.ofFn f) := by
  apply (homogeneousMap_allRank_ringEquiv_isWeaklyRegular_iff_aux e
    (List.ofFn f)).mpr
  simpa only [List.map_ofFn, Function.comp_def] using hregular

