    ∃ (W : (Fin (sliceRank n d) → ℂ) →ₗ[ℂ]
          (Fin (blockVariables n d) → ℂ))
      (A : (Fin (blockVariables n d) → ℂ) →ₗ[ℂ]
          (Fin (sliceRank n d) → ℂ)),
      Function.Injective W ∧
      (∀ i : Fin (sliceRank n d),
        (slicedGradientPolynomial
          (sourceSeparatedBlockMinorSum n d weight) W A i).IsHomogeneous
            (d - 1)) ∧
      (∀ u : Fin (sliceRank n d) → ℂ,
        (∀ i : Fin (sliceRank n d),
          MvPolynomial.eval u
            (slicedGradientPolynomial
              (sourceSeparatedBlockMinorSum n d weight) W A i) = 0) ↔
                u = 0) := by
  exact exists_source_block_slicedGradient hd hn hscale
    (sourceSeparatedBlockMinorSum n d weight)
    (sourceSeparatedBlockMinorSum_isHomogeneous n d weight)
    (sourceSeparatedBlockMinorSum_criticalLocusDimension_le hd weight hw)

theorem exists_sourceTreeBlock_slicedGradient
    {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n)
    (hscale : 4 * powerSumParameter d ≤
      blockWidth d * blockColumns n d)
    (tree : BlockTree (Fin (blockCount n d)))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ) :
    ∃ (W : (Fin (sliceRank n d) → ℂ) →ₗ[ℂ]
          (Fin (blockVariables n d) → ℂ))
      (A : (Fin (blockVariables n d) → ℂ) →ₗ[ℂ]
          (Fin (sliceRank n d) → ℂ)),
      Function.Injective W ∧
      (∀ i : Fin (sliceRank n d),
        (slicedGradientPolynomial
          (sourceSeparatedBlockMinorSum n d
            (sourceTreeBlockWeight (blockCount n d) d tree)) W A i).IsHomogeneous
              (d - 1)) ∧
      (∀ u : Fin (sliceRank n d) → ℂ,
        (∀ i : Fin (sliceRank n d),
          MvPolynomial.eval u
            (slicedGradientPolynomial
              (sourceSeparatedBlockMinorSum n d
                (sourceTreeBlockWeight (blockCount n d) d tree)) W A i) = 0) ↔
                  u = 0) := by
  exact exists_sourceSeparatedBlockMinorSum_slicedGradient
    hd hn hscale (sourceTreeBlockWeight (blockCount n d) d tree)
    (sourceTreeBlockWeight_ne_zero (by omega) tree hnodup hleaves)

theorem permanent_circuit_logarithmic_bound_of_gradient
    {n d : ℕ} (hd : 3 ≤ d) (hn : 6 * blockWidth d ≤ n)
    (circuit : ArithmeticCircuit (Fin n × Fin n))
    (_hpermanent : circuit.polynomial = permanent n)
    (hgradient :
      (sliceRank n d : ℝ) * Real.logb 2 ((d : ℝ) - 1) ≤
        3 * (circuit.size : ℝ)) :
    (n : ℝ) ^ 2 * Real.logb 2 ((d : ℝ) - 1) / 144 ≤
      (circuit.size : ℝ) := by
  exact logarithmic_lower_bound_of_gradient hd hn hgradient

theorem exists_blockTree_leafList {ι : Type*}
    (labels : List ι) (hne : labels ≠ []) :
    ∃ tree : BlockTree ι, tree.leafList = labels := by
  induction labels with
  | nil => exact (hne rfl).elim
  | cons head tail ih =>
      by_cases htail : tail = []
      · subst tail
        exact ⟨BlockTree.leaf head, rfl⟩
      · obtain ⟨tree, htree⟩ := ih htail
        exact ⟨BlockTree.branch (BlockTree.leaf head) tree, by
          simp only [BlockTree.leafList, htree, List.cons_append, List.nil_append]⟩

theorem exists_source_floor_blockTree
    {n d : ℕ} (hd : 3 ≤ d) (hn : 6 * blockWidth d ≤ n) :
    ∃ tree : BlockTree (Fin (blockCount n d)),
      tree.leafList.Nodup ∧ tree.leaves = Finset.univ := by
  classical
  let labels : List (Fin (blockCount n d)) :=
    (Finset.univ : Finset (Fin (blockCount n d))).toList
  have hcount : 3 ≤ blockCount n d := three_le_blockCount hd hn
  have hlabels : labels ≠ [] := by
    intro hempty
    have hmember : (⟨0, by omega⟩ : Fin (blockCount n d)) ∈ labels := by
      simp only [Finset.mem_toList, Finset.mem_univ, labels]
    rw [hempty] at hmember
    exact List.not_mem_nil hmember
  obtain ⟨tree, htree⟩ := exists_blockTree_leafList labels hlabels
  refine ⟨tree, ?_, ?_⟩
  · rw [htree]
    exact Finset.nodup_toList _
  · ext i
    rw [BlockTree.mem_leaves_iff, htree]
    simp only [Finset.mem_toList, Finset.mem_univ, labels]

theorem sourceTreeSeparatedMinorSum_eq_separatedBlockMinorSum
    (b t s d : ℕ) (tree : BlockTree (Fin b)) :
    sourceTreeSeparatedMinorSum b t s d tree =
      separatedBlockMinorSum b t s d
        (sourceTreeBlockWeight b d tree) := by
  rfl

theorem flattened_sourceTreeSeparatedMinorSum_eq_flattenedSeparatedBlockMinorSum
    (b t s d : ℕ) (tree : BlockTree (Fin b)) :
    MvPolynomial.rename
        (finProdFinEquiv :
          Fin (b * t) × Fin s ≃ Fin ((b * t) * s))
        (sourceTreeSeparatedMinorSum b t s d tree) =
      flattenedSeparatedBlockMinorSum b t s d
        (sourceTreeBlockWeight b d tree) := by
  unfold flattenedSeparatedBlockMinorSum
  rw [sourceTreeSeparatedMinorSum_eq_separatedBlockMinorSum]

theorem floor_sourceTreeSeparatedMinorSum_eq_sourceSeparatedBlockMinorSum
    (n d : ℕ) (tree : BlockTree (Fin (blockCount n d))) :
    MvPolynomial.rename
        (finProdFinEquiv :
          Fin (blockRows n d) × Fin (blockColumns n d) ≃
            Fin (blockVariables n d))
        (sourceTreeSeparatedMinorSum
          (blockCount n d) (blockWidth d) (blockColumns n d) d tree) =
      sourceSeparatedBlockMinorSum n d
        (sourceTreeBlockWeight (blockCount n d) d tree) := by
  exact flattened_sourceTreeSeparatedMinorSum_eq_flattenedSeparatedBlockMinorSum
    (blockCount n d) (blockWidth d) (blockColumns n d) d tree

theorem sourceTreeBlock_slicedGradient_homogeneousFiberDegree_le_two_pow
    {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n)
    (circuit : ArithmeticCircuit (Fin n × Fin n))
    (hpermanent : circuit.polynomial = permanent n)
    (tree : BlockTree (Fin (blockCount n d)))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ)
    (W : (Fin (sliceRank n d) → ℂ) →ₗ[ℂ]
      (Fin (blockVariables n d) → ℂ))
    (A : (Fin (blockVariables n d) → ℂ) →ₗ[ℂ]
      (Fin (sliceRank n d) → ℂ))
    (hhomogeneous : ∀ i : Fin (sliceRank n d),
      (slicedGradientPolynomial
        (sourceSeparatedBlockMinorSum n d
          (sourceTreeBlockWeight (blockCount n d) d tree)) W A i).IsHomogeneous
        (d - 1))
    (hzero : ∀ point : Fin (sliceRank n d) → ℂ,
      (∀ i, MvPolynomial.eval point
        (slicedGradientPolynomial
          (sourceSeparatedBlockMinorSum n d
            (sourceTreeBlockWeight (blockCount n d) d tree)) W A i) = 0) ↔
        point = 0) :
    (d - 1) ^ sliceRank n d ≤ 2 ^ (3 * circuit.size) := by
  let ζ : ℂ := Complex.exp (2 * Real.pi * Complex.I / (d : ℂ))
  have hζ : IsPrimitiveRoot ζ d :=
    Complex.isPrimitiveRoot_exp d (by omega)
  obtain ⟨substitution, coefficient, hcoefficient, hspecialization⟩ :=
    sourceTreeBlock_affine_permanent_specialization
      hd hn hζ tree hnodup hleaves
  have hsource :
      MvPolynomial.aeval
          (fun ij => (substitution ij).polynomial) (permanent n) =
        MvPolynomial.C coefficient *
          sourceSeparatedBlockMinorSum n d
            (sourceTreeBlockWeight (blockCount n d) d tree) := by
    rw [floor_sourceTreeSeparatedMinorSum_eq_sourceSeparatedBlockMinorSum]
      at hspecialization
    exact hspecialization
  exact normalizedPermanent_slicedGradient_homogeneousFiberDegree_le_two_pow
    circuit hpermanent substitution
    (sourceSeparatedBlockMinorSum n d
      (sourceTreeBlockWeight (blockCount n d) d tree))
    coefficient hcoefficient hsource W A (d - 1) (by omega)
    hhomogeneous hzero

theorem permanent_circuit_gradient_bound
    {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n)
    (hscale : 4 * powerSumParameter d ≤
      blockWidth d * blockColumns n d)
    (circuit : ArithmeticCircuit (Fin n × Fin n))
    (hpermanent : circuit.polynomial = permanent n) :
    (sliceRank n d : ℝ) * Real.logb 2 ((d : ℝ) - 1) ≤
      3 * (circuit.size : ℝ) := by
  obtain ⟨tree, hnodup, hleaves⟩ :=
    exists_source_floor_blockTree hd hn
  obtain ⟨W, A, _, hhomogeneous, hzero⟩ :=
    exists_sourceTreeBlock_slicedGradient
      hd hn hscale tree hnodup hleaves
  have hpower :=
    sourceTreeBlock_slicedGradient_homogeneousFiberDegree_le_two_pow
      hd hn circuit hpermanent tree hnodup hleaves W A
      hhomogeneous hzero
  simpa only [ge_iff_le, Nat.cast_mul, Nat.cast_ofNat] using
    (sliced_gradient_logarithmic_bound_of_fiber_cardinalities (k := sliceRank n d) (d := d) (q := 3 * circuit.size)
      (cardinality := (d - 1) ^ sliceRank n d) (by omega) (le_refl _) hpower)

open scoped LinearAlgebra.Projectivization

theorem source_fixedDegree_permanent_circuit_logarithmic_bound
    {n d : ℕ}
    (circuit : ArithmeticCircuit (Fin n × Fin n)) :
    3 ≤ d →
    6 * blockWidth d ≤ n →
    4 * powerSumParameter d ≤ blockWidth d * blockColumns n d →
    circuit.polynomial = permanent n →
      (n : ℝ) ^ 2 * Real.logb 2 ((d : ℝ) - 1) / 144 ≤
        (circuit.size : ℝ) := by
  intro hd hn hscale hpermanent
  exact permanent_circuit_logarithmic_bound_of_gradient
    hd hn circuit hpermanent
    (permanent_circuit_gradient_bound hd hn hscale circuit hpermanent)

private theorem six_mul_le_two_pow_of_sixteen_le {k : ℕ} (hk : 16 ≤ k) :
    6 * k ≤ 2 ^ k := by
  induction k, hk using Nat.le_induction with
  | base => norm_num
  | succ k hk ih =>
      rw [pow_succ]
      omega

theorem permanent_circuit_loglog_lower_bound {n : ℕ} (hn : 2 ^ 16 ≤ n) :
    (n : ℝ) ^ 2 * (Real.logb 2 (Real.logb 2 (n : ℝ)) - 3) / 144 ≤
      (circuitComplexity (permanent n) : ℝ) := by
  let L : ℕ := Nat.log 2 n
  let d : ℕ := L / 4
  have hnzero : n ≠ 0 := by omega
  have hL : 16 ≤ L := by
    exact (Nat.le_log_iff_pow_le (by norm_num) hnzero).2 hn
  have hd : 4 ≤ d := by
    dsimp [d]
    omega
  have hwidth : 4 * d ≤ L := by
    dsimp [d]
    omega
  have hpower : 2 ^ (4 * d) ≤ n := by
    exact Nat.pow_le_of_le_log hnzero hwidth
  have hlarge : 6 * blockWidth d ≤ n := by
    have hlinear : 6 * L ≤ 2 ^ L := six_mul_le_two_pow_of_sixteen_le hL
    have hlogpower : 2 ^ L ≤ n := Nat.pow_log_le_self 2 hnzero
    dsimp [blockWidth]
    omega
  have hrho : powerSumParameter d ≤ n := by
    dsimp [powerSumParameter, blockWidth]
    omega
  have hscale : 4 * powerSumParameter d ≤ blockWidth d * blockColumns n d := by
    have hcolumns := le_two_mul_blockColumns n d
    have hwidth' : 8 ≤ blockWidth d := by
      dsimp [blockWidth]
      omega
    nlinarith [Nat.mul_le_mul_left 4 hrho,
      Nat.mul_le_mul_right (blockColumns n d) hwidth']
  have hcomplexity :
      (n : ℝ) ^ 2 * Real.logb 2 ((d : ℝ) - 1) / 144 ≤
        (circuitComplexity (permanent n) : ℝ) := by
    apply (real_le_circuitComplexity_iff (permanent n) _).2
    intro circuit hcircuit
    exact source_fixedDegree_permanent_circuit_logarithmic_bound circuit
      (by omega) hlarge hscale hcircuit
  have hlogpos : 0 < Real.logb 2 (n : ℝ) := by
    apply Real.logb_pos (by norm_num)
    exact_mod_cast (show 1 < n by omega)
  have hloglt : Real.logb 2 (n : ℝ) < (L + 1 : ℕ) := by
    have hpowlt : n < 2 ^ (L + 1) := by
      simpa only [Nat.succ_eq_add_one] using Nat.lt_pow_succ_log_self (by norm_num : 1 < 2) n
    have hcast : (n : ℝ) < (2 : ℝ) ^ (L + 1) := by
      exact_mod_cast hpowlt
    calc
      Real.logb 2 (n : ℝ) < Real.logb 2 ((2 : ℝ) ^ (L + 1)) :=
        Real.logb_lt_logb (by norm_num) (by exact_mod_cast (show 0 < n by omega)) hcast
      _ = (L + 1 : ℕ) := by norm_num [Real.logb_pow]
  have hLd : L + 1 ≤ 8 * (d - 1) := by
    have hrem := Nat.mod_lt L (by omega : 0 < (4 : ℕ))
    have hdecomp := Nat.mod_add_div L 4
    dsimp [d]
    omega
  have hinner : Real.logb 2 (n : ℝ) / 8 ≤ (d : ℝ) - 1 := by
    have hcast : ((L + 1 : ℕ) : ℝ) ≤ (8 * (d - 1) : ℕ) := by
      exact_mod_cast hLd
    have hcastsub : ((d - 1 : ℕ) : ℝ) = (d : ℝ) - 1 := by
      rw [Nat.cast_sub (by omega : 1 ≤ d)]
      norm_num
    push_cast at hcast
    push_cast at hloglt
    rw [hcastsub] at hcast
    linarith
  have hlog8 : Real.logb 2 (8 : ℝ) = 3 := by
    calc
      Real.logb 2 (8 : ℝ) = Real.logb 2 ((2 : ℝ) ^ (3 : ℕ)) := by norm_num
      _ = 3 := by rw [Real.logb_pow]; norm_num
  have hlogcompare :
      Real.logb 2 (Real.logb 2 (n : ℝ)) - 3 ≤
        Real.logb 2 ((d : ℝ) - 1) := by
    calc
      Real.logb 2 (Real.logb 2 (n : ℝ)) - 3 =
          Real.logb 2 (Real.logb 2 (n : ℝ) / 8) := by
            rw [Real.logb_div (ne_of_gt hlogpos) (by norm_num), hlog8]
      _ ≤ Real.logb 2 ((d : ℝ) - 1) :=
        Real.logb_le_logb_of_le (by norm_num)
          (div_pos hlogpos (by norm_num)) hinner
  calc
    (n : ℝ) ^ 2 * (Real.logb 2 (Real.logb 2 (n : ℝ)) - 3) / 144 ≤
        (n : ℝ) ^ 2 * Real.logb 2 ((d : ℝ) - 1) / 144 := by
          gcongr
    _ ≤ (circuitComplexity (permanent n) : ℝ) := hcomplexity

theorem permanent_circuit_loglog_lower_bound_288 {n : ℕ} (hn : 2 ^ 64 ≤ n) :
    (1 / 288 : ℝ) * (n : ℝ) ^ 2 * Real.logb 2 (Real.logb 2 (n : ℝ)) ≤
      (circuitComplexity (permanent n) : ℝ) := by
  have hnmain : 2 ^ 16 ≤ n := by
    have hthreshold : (2 : ℕ) ^ 16 ≤ 2 ^ 64 := by norm_num
    exact hthreshold.trans hn
  have hinner : (64 : ℝ) ≤ Real.logb 2 (n : ℝ) := by
    calc
      (64 : ℝ) = Real.logb 2 ((2 : ℝ) ^ (64 : ℕ)) := by
        rw [Real.logb_pow]
        norm_num
      _ ≤ Real.logb 2 (n : ℝ) := by
        apply Real.logb_le_logb_of_le (by norm_num) (by positivity)
        exact_mod_cast hn
  have houter : (6 : ℝ) ≤ Real.logb 2 (Real.logb 2 (n : ℝ)) := by
    calc
      (6 : ℝ) = Real.logb 2 ((2 : ℝ) ^ (6 : ℕ)) := by
        rw [Real.logb_pow]
        norm_num
      _ ≤ Real.logb 2 (Real.logb 2 (n : ℝ)) := by
        apply Real.logb_le_logb_of_le (by norm_num) (by norm_num)
        norm_num
        exact hinner
  have hcoefficient :
      Real.logb 2 (Real.logb 2 (n : ℝ)) / 288 ≤
        (Real.logb 2 (Real.logb 2 (n : ℝ)) - 3) / 144 := by
    linarith
  have hproduct := mul_le_mul_of_nonneg_left hcoefficient
    (sq_nonneg (n : ℝ))
  calc
    (1 / 288 : ℝ) * (n : ℝ) ^ 2 * Real.logb 2 (Real.logb 2 (n : ℝ)) ≤
        (n : ℝ) ^ 2 * (Real.logb 2 (Real.logb 2 (n : ℝ)) - 3) / 144 := by
          nlinarith
    _ ≤ (circuitComplexity (permanent n) : ℝ) :=
      permanent_circuit_loglog_lower_bound hnmain

theorem permanent_circuit_loglog_bigOmega :
    ∃ c : ℝ, 0 < c ∧ ∃ N : ℕ, ∀ n : ℕ, N ≤ n →
      c * (n : ℝ) ^ 2 * Real.logb 2 (Real.logb 2 (n : ℝ)) ≤
        (circuitComplexity (permanent n) : ℝ) := by
  exact ⟨1 / 288, by norm_num, 2 ^ 64,
    fun n hn => permanent_circuit_loglog_lower_bound_288 hn⟩

end

end Standalone_MainReduction

