theorem homogeneousMap_allRank_fin_last_mem_span_of_weaklyRegular_aux
    {R : Type*} [CommRing R] {n : ℕ}
    (f : Fin (n + 1) → R)
    (hregular : RingTheory.Sequence.IsWeaklyRegular R (List.ofFn f))
    {a : R}
    (ha : f (Fin.last n) * a ∈
      Ideal.span (Set.range fun i : Fin n => f i.castSucc)) :
    a ∈ Ideal.span (Set.range fun i : Fin n => f i.castSucc) := by
  let rs : List R := List.ofFn fun i : Fin n => f i.castSucc
  have hlist : List.ofFn f = rs ++ [f (Fin.last n)] :=
    List.ofFn_succ_last
  have hregular' :
      RingTheory.Sequence.IsWeaklyRegular R
        (rs ++ [f (Fin.last n)]) := hlist ▸ hregular
  have hlast :=
    (RingTheory.Sequence.isWeaklyRegular_append_iff
      R rs [f (Fin.last n)]).mp hregular'
  have hlast' :
      IsSMulRegular
        (R ⧸ (Ideal.ofList rs • (⊤ : Submodule R R)))
        (f (Fin.last n)) :=
    (RingTheory.Sequence.isWeaklyRegular_singleton_iff
      (R ⧸ (Ideal.ofList rs • (⊤ : Submodule R R)))
      (f (Fin.last n))).mp hlast.2
  have hspan :
      Ideal.ofList rs =
        Ideal.span (Set.range fun i : Fin n => f i.castSucc) := by
    change Ideal.span {x : R | x ∈ List.ofFn
      (fun i : Fin n => f i.castSucc)} = _
    congr 1
    ext x
    simp only [List.mem_ofFn, Set.mem_setOf_eq, Set.mem_range]
  have hideal :
      Ideal.ofList rs • (⊤ : Submodule R R) =
        (Ideal.span (Set.range fun i : Fin n => f i.castSucc) :
          Submodule R R) := by
    simp only [hspan, smul_eq_mul, Ideal.mul_top]
  have hmem :=
    (isSMulRegular_quotient_iff_mem_of_smul_mem
      (Ideal.ofList rs • (⊤ : Submodule R R))
      (f (Fin.last n))).mp hlast'
  change a ∈
    (Ideal.span (Set.range fun i : Fin n => f i.castSucc) :
      Submodule R R)
  rw [← hideal]
  apply hmem a
  rw [hideal]
  simpa only [smul_eq_mul] using ha

theorem homogeneousMap_allRank_weaklyRegular_fin_syzygy_lifts_aux
    {R S : Type*} [CommRing R] [CommRing S]
    (q : R →+* S) (hq : Function.Surjective q) :
    ∀ (n : ℕ) (f : Fin n → R),
      RingTheory.Sequence.IsWeaklyRegular S
        (List.ofFn fun i => q (f i)) →
      ∀ a : Fin n → S,
        (∑ i, a i * q (f i)) = 0 →
          ∃ b : Fin n → R,
            (∀ i, q (b i) = a i) ∧
              (∑ i, b i * f i) = 0 := by
  intro n
  induction n with
  | zero =>
      intro f _ a _
      refine ⟨Fin.elim0, ?_, ?_⟩
      · exact fun i => Fin.elim0 i
      · simp only [Finset.univ_eq_empty, Finset.sum_empty]
  | succ n ih =>
      intro f hregular a hrelation
      have hlist :
          List.ofFn (fun i : Fin (n + 1) => q (f i)) =
            (List.ofFn fun i : Fin n => q (f i.castSucc)) ++
              [q (f (Fin.last n))] :=
        List.ofFn_succ_last
      have hregular' :
          RingTheory.Sequence.IsWeaklyRegular S
            ((List.ofFn fun i : Fin n => q (f i.castSucc)) ++
              [q (f (Fin.last n))]) :=
        hlist ▸ hregular
      have hprefix :
          RingTheory.Sequence.IsWeaklyRegular S
            (List.ofFn fun i : Fin n => q (f i.castSucc)) :=
        ((RingTheory.Sequence.isWeaklyRegular_append_iff S
          (List.ofFn fun i : Fin n => q (f i.castSucc))
          [q (f (Fin.last n))]).mp hregular').1
      have hsum :
          (∑ i : Fin n, a i.castSucc * q (f i.castSucc)) +
            a (Fin.last n) * q (f (Fin.last n)) = 0 := by
        simpa only [Fin.sum_univ_castSucc] using hrelation
      have hproduct :
          q (f (Fin.last n)) * a (Fin.last n) ∈
            Ideal.span
              (Set.range fun i : Fin n => q (f i.castSucc)) := by
        apply Ideal.mem_span_range_iff_exists_fun.mpr
        refine ⟨fun i => -a i.castSucc, ?_⟩
        calc
          (∑ i : Fin n, -a i.castSucc * q (f i.castSucc)) =
              -(∑ i : Fin n, a i.castSucc * q (f i.castSucc)) := by
                simp only [neg_mul, Finset.sum_neg_distrib]
          _ = q (f (Fin.last n)) * a (Fin.last n) := by
                linear_combination -hsum
      have hlast :
          a (Fin.last n) ∈
            Ideal.span
              (Set.range fun i : Fin n => q (f i.castSucc)) :=
        homogeneousMap_allRank_fin_last_mem_span_of_weaklyRegular_aux
          (fun i : Fin (n + 1) => q (f i)) hregular hproduct
      obtain ⟨t, ht⟩ :=
        Ideal.mem_span_range_iff_exists_fun.mp hlast
      choose d hd using fun i : Fin n => hq (t i)
      have hcorrected :
          (∑ i : Fin n,
            (a i.castSucc + t i * q (f (Fin.last n))) *
              q (f i.castSucc)) = 0 := by
        calc
          (∑ i : Fin n,
            (a i.castSucc + t i * q (f (Fin.last n))) *
              q (f i.castSucc)) =
            (∑ i : Fin n, a i.castSucc * q (f i.castSucc)) +
              (∑ i : Fin n, t i * q (f i.castSucc)) *
                q (f (Fin.last n)) := by
                  simp_rw [add_mul]
                  rw [Finset.sum_add_distrib, Finset.sum_mul]
                  congr 1
                  apply Finset.sum_congr rfl
                  intro i _
                  ring
          _ = 0 := by
            rw [ht]
            linear_combination hsum
      obtain ⟨b, hb, hbsum⟩ :=
        ih (fun i : Fin n => f i.castSucc) hprefix
          (fun i : Fin n => a i.castSucc +
            t i * q (f (Fin.last n))) hcorrected
      let blast : R := ∑ i : Fin n, d i * f i.castSucc
      let result : Fin (n + 1) → R :=
        Fin.snoc
          (fun i : Fin n => b i - d i * f (Fin.last n)) blast
      refine ⟨result, ?_, ?_⟩
      · intro i
        induction i using Fin.lastCases with
        | last =>
            change q ((Fin.snoc
              (fun i : Fin n => b i - d i * f (Fin.last n))
                blast : Fin (n + 1) → R) (Fin.last n)) = a (Fin.last n)
            rw [Fin.snoc_last]
            change q (∑ i : Fin n, d i * f i.castSucc) =
              a (Fin.last n)
            simpa only [map_sum, map_mul, hd] using ht
        | cast i =>
            change q ((Fin.snoc
              (fun i : Fin n => b i - d i * f (Fin.last n))
                blast : Fin (n + 1) → R) i.castSucc) = a i.castSucc
            rw [Fin.snoc_castSucc]
            rw [map_sub, map_mul, hb i, hd i]
            ring
      · rw [Fin.sum_univ_castSucc]
        simp only [result, Fin.snoc_castSucc, Fin.snoc_last]
        change
          (∑ i : Fin n,
            (b i - d i * f (Fin.last n)) * f i.castSucc) +
            (∑ i : Fin n, d i * f i.castSucc) *
              f (Fin.last n) = 0
        simp_rw [sub_mul]
        rw [Finset.sum_sub_distrib, hbsum]
        have hfactor :
            (∑ i : Fin n,
              d i * f (Fin.last n) * f i.castSucc) =
              (∑ i : Fin n, d i * f i.castSucc) *
                f (Fin.last n) := by
          rw [Finset.sum_mul]
          apply Finset.sum_congr rfl
          intro i _
          ring
        rw [hfactor]
        ring

theorem homogeneousMap_allRank_fin_hyperplane_isSMulRegular_of_quotient_weaklyRegular_aux
    {R : Type*} [CommRing R] [IsDomain R]
    {n : ℕ} (f : Fin n → R) (ell : R) (hell : ell ≠ 0)
    (hregular :
      RingTheory.Sequence.IsWeaklyRegular
        (R ⧸ Ideal.span ({ell} : Set R))
        (List.ofFn fun i : Fin n =>
          Ideal.Quotient.mk (Ideal.span ({ell} : Set R)) (f i))) :
    IsSMulRegular (R ⧸ Ideal.span (Set.range f)) ell := by
  classical
  apply (isSMulRegular_quotient_iff_mem_of_smul_mem
    (Ideal.span (Set.range f)) ell).mpr
  intro p hp
  have hp' : ell * p ∈ Ideal.span (Set.range f) := by
    simpa only [smul_eq_mul] using hp
  obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp hp'
  let J : Ideal R := Ideal.span ({ell} : Set R)
  let q : R →+* R ⧸ J := Ideal.Quotient.mk J
  have hrelation : (∑ i : Fin n, q (a i) * q (f i)) = 0 := by
    calc
      (∑ i : Fin n, q (a i) * q (f i)) =
          q (∑ i : Fin n, a i * f i) := by simp only [map_sum, map_mul]
      _ = q (ell * p) := congrArg q ha
      _ = 0 := by
        apply Ideal.Quotient.eq_zero_iff_mem.mpr
        exact J.mul_mem_right p
          (Ideal.subset_span (Set.mem_singleton ell))
  obtain ⟨b, hb, hbsum⟩ :=
    homogeneousMap_allRank_weaklyRegular_fin_syzygy_lifts_aux
      q Ideal.Quotient.mk_surjective n f hregular
      (fun i => q (a i)) hrelation
  have hdiff (i : Fin n) : a i - b i ∈ J := by
    apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem (a i) (b i)).mp
    exact (hb i).symm
  choose d hd using fun i : Fin n =>
    Ideal.mem_span_singleton'.mp (hdiff i)
  apply Ideal.mem_span_range_iff_exists_fun.mpr
  refine ⟨d, ?_⟩
  apply mul_left_cancel₀ hell
  calc
    ell * (∑ i : Fin n, d i * f i) =
        ∑ i : Fin n, (d i * ell) * f i := by
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro i _
          ring
    _ = ∑ i : Fin n, (a i - b i) * f i := by
      apply Finset.sum_congr rfl
      intro i _
      rw [hd i]
    _ = (∑ i : Fin n, a i * f i) -
        (∑ i : Fin n, b i * f i) := by
      simp_rw [sub_mul]
      rw [Finset.sum_sub_distrib]
    _ = ell * p := by rw [ha, hbsum, sub_zero]

theorem homogeneousMap_allRank_homogeneous_isSMulRegular_of_linear_hyperplane_aux
    {ι : Type*}
    (I : Ideal (MvPolynomial ι ℂ))
    (hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule ι ℂ))
    (f ell : MvPolynomial ι ℂ) {e : ℕ}
    (hf : f.IsHomogeneous e)
    (hellhom : ell.IsHomogeneous 1)
    (hellregular : IsSMulRegular (MvPolynomial ι ℂ ⧸ I) ell)
    (hfmod : IsSMulRegular
      (MvPolynomial ι ℂ ⧸
        (I ⊔ Ideal.span ({ell} : Set (MvPolynomial ι ℂ)))) f) :
    IsSMulRegular (MvPolynomial ι ℂ ⧸ I) f := by
  classical
  have hellcolon :=
    (isSMulRegular_quotient_iff_mem_of_smul_mem I ell).mp hellregular
  have hfcolon :=
    (isSMulRegular_quotient_iff_mem_of_smul_mem
      (I ⊔ Ideal.span ({ell} : Set (MvPolynomial ι ℂ))) f).mp hfmod
  have homogeneous_aux : ∀ m : ℕ,
      ∀ p : MvPolynomial ι ℂ,
        p.IsHomogeneous m → f * p ∈ I → p ∈ I := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
      intro p hp hfp
      have hpmod : p ∈
          I ⊔ Ideal.span ({ell} : Set (MvPolynomial ι ℂ)) := by
        apply hfcolon p
        change f * p ∈ I ⊔ Ideal.span ({ell} : Set _)
        exact Ideal.mem_sup_left hfp
      obtain ⟨v, hv, w, hw, hvw⟩ := Submodule.mem_sup.mp hpmod
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hw
      have hdecomp : v + r * ell = p := by simpa only [hr] using hvw
      have hvcomponent : MvPolynomial.homogeneousComponent m v ∈ I :=
        MvPolynomial.homogeneousComponent_mem_of_mem hI hv m
      by_cases hm : m = 0
      · subst m
        have hzero :
            MvPolynomial.homogeneousComponent 0 (r * ell) = 0 :=
          homogeneousComponent_mul_of_right_isHomogeneous_of_lt
            r ell hellhom (by omega)
        have hcomp := congrArg
          (MvPolynomial.homogeneousComponent 0) hdecomp
        rw [map_add, hzero, add_zero,
          MvPolynomial.homogeneousComponent_eq_self hp] at hcomp
        exact hcomp ▸ hvcomponent
      · have hmpos : 0 < m := Nat.pos_of_ne_zero hm
        let r' := MvPolynomial.homogeneousComponent (m - 1) r
        have hrhom : r'.IsHomogeneous (m - 1) :=
          MvPolynomial.homogeneousComponent_isHomogeneous (m - 1) r
        have hcomp := congrArg
          (MvPolynomial.homogeneousComponent m) hdecomp
        rw [map_add,
          homogeneousComponent_mul_of_right_isHomogeneous
            r ell hellhom (by omega),
          MvPolynomial.homogeneousComponent_eq_self hp] at hcomp
        change MvPolynomial.homogeneousComponent m v + r' * ell = p
          at hcomp
        have hfr' : f * r' ∈ I := by
          apply hellcolon (f * r')
          change ell * (f * r') ∈ I
          have hfv : f * MvPolynomial.homogeneousComponent m v ∈ I :=
            I.mul_mem_left f hvcomponent
          have hsubtract : f * p -
              f * MvPolynomial.homogeneousComponent m v ∈ I :=
            I.sub_mem hfp hfv
          convert hsubtract using 1
          rw [← hcomp]
          ring
        have hr'I : r' ∈ I := ih (m - 1) (by omega) r' hrhom hfr'
        rw [← hcomp]
        exact I.add_mem hvcomponent (I.mul_mem_right ell hr'I)
  apply (isSMulRegular_quotient_iff_mem_of_smul_mem I f).mpr
  intro p hp
  have hp' : f * p ∈ I := by simpa only [smul_eq_mul] using hp
  apply (MvPolynomial.mem_iff_homogeneousComponent_mem hI p).mpr
  intro m
  apply homogeneous_aux m (MvPolynomial.homogeneousComponent m p)
    (MvPolynomial.homogeneousComponent_isHomogeneous m p)
  have hcomponent :=
    MvPolynomial.homogeneousComponent_mem_of_mem hI hp' (e + m)
  rw [mul_comm f p,
    homogeneousComponent_mul_of_right_isHomogeneous p f hf
      (by omega)] at hcomponent
  simpa only [add_tsub_cancel_left, mul_comm] using hcomponent

open scoped Pointwise BigOperators

attribute [local instance] MvPolynomial.gradedAlgebra

theorem homogeneousMap_allRank_isSMulRegular_sup_of_quotient_map_aux
    {R : Type*} [CommRing R]
    (I J : Ideal R) (g : R)
    (hregular : IsSMulRegular
      ((R ⧸ J) ⧸ I.map (Ideal.Quotient.mk J))
      (Ideal.Quotient.mk J g)) :
    IsSMulRegular (R ⧸ (I ⊔ J)) g := by
  have hcolon :=
    (isSMulRegular_quotient_iff_mem_of_smul_mem
      (I.map (Ideal.Quotient.mk J))
      (Ideal.Quotient.mk J g)).mp hregular
  apply (isSMulRegular_quotient_iff_mem_of_smul_mem (I ⊔ J) g).mpr
  intro p hp
  have hp' : g * p ∈ I ⊔ J := by simpa only [smul_eq_mul] using hp
  have himage : Ideal.Quotient.mk J (g * p) ∈
      I.map (Ideal.Quotient.mk J) :=
    Ideal.mem_quotient_iff_mem_sup.mpr hp'
  have hproduct :
      Ideal.Quotient.mk J g • Ideal.Quotient.mk J p ∈
        (I.map (Ideal.Quotient.mk J) :
          Submodule (R ⧸ J) (R ⧸ J)) := by
    simpa only [smul_eq_mul, map_mul] using himage
  have hmember := hcolon (Ideal.Quotient.mk J p) hproduct
  exact Ideal.mem_quotient_iff_mem_sup.mp hmember

theorem homogeneousMap_allRank_homogeneous_fin_isWeaklyRegular_of_linear_quotient_aux
    {ι : Type*} {e : ℕ}
    (ell : MvPolynomial ι ℂ)
    (hell : ell ≠ 0)
    (hellhom : ell.IsHomogeneous 1) :
    ∀ (n : ℕ) (f : Fin n → MvPolynomial ι ℂ),
      (∀ i, (f i).IsHomogeneous e) →
      RingTheory.Sequence.IsWeaklyRegular
        (MvPolynomial ι ℂ ⧸
          Ideal.span ({ell} : Set (MvPolynomial ι ℂ)))
        (List.ofFn fun i =>
          Ideal.Quotient.mk
            (Ideal.span ({ell} : Set (MvPolynomial ι ℂ))) (f i)) →
      RingTheory.Sequence.IsWeaklyRegular
        (MvPolynomial ι ℂ) (List.ofFn f) := by
  classical
  intro n
  induction n with
  | zero =>
      intro f _ _
      exact RingTheory.Sequence.IsWeaklyRegular.nil _ _
  | succ n ih =>
      intro f hf hregular
      let R := MvPolynomial ι ℂ
      let J : Ideal R := Ideal.span ({ell} : Set R)
      let q : R →+* R ⧸ J := Ideal.Quotient.mk J
      let fp : Fin n → R := fun i => f i.castSucc
      let g : R := f (Fin.last n)
      let I : Ideal R := Ideal.span (Set.range fp)
      have hlist :
          List.ofFn (fun i : Fin (n + 1) => q (f i)) =
            (List.ofFn fun i : Fin n => q (fp i)) ++ [q g] :=
        List.ofFn_succ_last
      have hsplit :=
        (RingTheory.Sequence.isWeaklyRegular_append_iff
          (R ⧸ J) (List.ofFn fun i : Fin n => q (fp i)) [q g]).mp
          (hlist ▸ hregular)
      have hprefix : RingTheory.Sequence.IsWeaklyRegular
          (R ⧸ J) (List.ofFn fun i : Fin n => q (fp i)) := hsplit.1
      have hsourceprefix : RingTheory.Sequence.IsWeaklyRegular
          R (List.ofFn fp) :=
        ih fp (fun i => hf i.castSucc) hprefix
      have himage :
          Ideal.ofList (List.ofFn fun i : Fin n => q (fp i)) =
            I.map q := by
        change Ideal.span {x : R ⧸ J |
          x ∈ List.ofFn (fun i : Fin n => q (fp i))} =
          (Ideal.span (Set.range fp)).map q
        rw [Ideal.map_span]
        congr 1
        ext x
        simp only [List.mem_ofFn, Set.mem_setOf_eq, Set.mem_image, Set.mem_range, exists_exists_eq_and]
      have hquotientlast : IsSMulRegular
          ((R ⧸ J) ⧸ I.map q) (q g) := by
        have hlast :=
          (RingTheory.Sequence.isWeaklyRegular_singleton_iff
            ((R ⧸ J) ⧸
              (Ideal.ofList
                (List.ofFn fun i : Fin n => q (fp i)) •
                  (⊤ : Submodule (R ⧸ J) (R ⧸ J))))
            (q g)).mp hsplit.2
        have hsub :
            Ideal.ofList (List.ofFn fun i : Fin n => q (fp i)) •
                (⊤ : Submodule (R ⧸ J) (R ⧸ J)) =
              (I.map q : Submodule (R ⧸ J) (R ⧸ J)) := by
          simp only [himage, smul_eq_mul, Ideal.mul_top]
        let E := Submodule.quotEquivOfEq _ _ hsub
        exact (E.isSMulRegular_congr (q g)).mp hlast
      have hgmod : IsSMulRegular (R ⧸ (I ⊔ J)) g :=
        homogeneousMap_allRank_isSMulRegular_sup_of_quotient_map_aux
          I J g hquotientlast
      have hI : I.IsHomogeneous
          (MvPolynomial.homogeneousSubmodule ι ℂ) := by
        apply Ideal.homogeneous_span
        rintro _ ⟨i, rfl⟩
        exact ⟨e, hf i.castSucc⟩
      have hellI : IsSMulRegular (R ⧸ I) ell :=
        homogeneousMap_allRank_fin_hyperplane_isSMulRegular_of_quotient_weaklyRegular_aux
          fp ell hell hprefix
      have hgI : IsSMulRegular (R ⧸ I) g :=
        homogeneousMap_allRank_homogeneous_isSMulRegular_of_linear_hyperplane_aux
          I hI g ell (hf (Fin.last n)) hellhom hellI hgmod
      rw [List.ofFn_succ_last]
      apply (RingTheory.Sequence.isWeaklyRegular_append_iff
        R (List.ofFn fp) [g]).mpr
      refine ⟨hsourceprefix, ?_⟩
      rw [RingTheory.Sequence.isWeaklyRegular_singleton_iff]
      have hspan : Ideal.ofList (List.ofFn fp) = I := by
        change Ideal.span {x : R | x ∈ List.ofFn fp} =
          Ideal.span (Set.range fp)
        congr 1
        ext x
        simp only [List.mem_ofFn, Set.mem_setOf_eq, Set.mem_range]
      have hsub :
          Ideal.ofList (List.ofFn fp) •
              (⊤ : Submodule R R) =
            (I : Submodule R R) := by
        simp only [hspan, smul_eq_mul, Ideal.mul_top]
      let E := Submodule.quotEquivOfEq _ _ hsub
      exact (E.isSMulRegular_congr g).mpr hgI

open scoped Pointwise BigOperators

theorem homogeneousMap_allRank_fin_last_mem_span_of_weaklyRegular
    {R : Type*} [CommRing R] {n : ℕ}
    (f : Fin (n + 1) → R)
    (hregular : RingTheory.Sequence.IsWeaklyRegular R (List.ofFn f))
    {a : R}
    (ha : f (Fin.last n) * a ∈
      Ideal.span (Set.range fun i : Fin n => f i.castSucc)) :
    a ∈ Ideal.span (Set.range fun i : Fin n => f i.castSucc) := by
  let rs : List R := List.ofFn fun i : Fin n => f i.castSucc
  have hlist : List.ofFn f = rs ++ [f (Fin.last n)] :=
    List.ofFn_succ_last
  have hregular' :
      RingTheory.Sequence.IsWeaklyRegular R
        (rs ++ [f (Fin.last n)]) := hlist ▸ hregular
  have hlast :=
    (RingTheory.Sequence.isWeaklyRegular_append_iff
      R rs [f (Fin.last n)]).mp hregular'
  have hlast' :
      IsSMulRegular
        (R ⧸ (Ideal.ofList rs • (⊤ : Submodule R R)))
        (f (Fin.last n)) :=
    (RingTheory.Sequence.isWeaklyRegular_singleton_iff
      (R ⧸ (Ideal.ofList rs • (⊤ : Submodule R R)))
      (f (Fin.last n))).mp hlast.2
  have hspan :
      Ideal.ofList rs =
        Ideal.span (Set.range fun i : Fin n => f i.castSucc) := by
    change Ideal.span {x : R | x ∈ List.ofFn
      (fun i : Fin n => f i.castSucc)} = _
    congr 1
    ext x
    simp only [List.mem_ofFn, Set.mem_setOf_eq, Set.mem_range]
  have hideal :
      Ideal.ofList rs • (⊤ : Submodule R R) =
        (Ideal.span (Set.range fun i : Fin n => f i.castSucc) :
          Submodule R R) := by
    simp only [hspan, smul_eq_mul, Ideal.mul_top]
  have hmem :=
    (isSMulRegular_quotient_iff_mem_of_smul_mem
      (Ideal.ofList rs • (⊤ : Submodule R R))
      (f (Fin.last n))).mp hlast'
  change a ∈
    (Ideal.span (Set.range fun i : Fin n => f i.castSucc) :
      Submodule R R)
  rw [← hideal]
  apply hmem a
  rw [hideal]
  simpa only [smul_eq_mul] using ha

theorem homogeneousMap_allRank_weaklyRegular_fin_syzygy_lifts
    {R S : Type*} [CommRing R] [CommRing S]
    (q : R →+* S) (hq : Function.Surjective q) :
    ∀ (n : ℕ) (f : Fin n → R),
      RingTheory.Sequence.IsWeaklyRegular S
        (List.ofFn fun i => q (f i)) →
      ∀ a : Fin n → S,
        (∑ i, a i * q (f i)) = 0 →
          ∃ b : Fin n → R,
            (∀ i, q (b i) = a i) ∧
              (∑ i, b i * f i) = 0 := by
  intro n
  induction n with
  | zero =>
      intro f hregular a hrelation
      refine ⟨Fin.elim0, ?_, ?_⟩
      · exact fun i => Fin.elim0 i
      · simp only [Finset.univ_eq_empty, Finset.sum_empty]
  | succ n ih =>
      intro f hregular a hrelation
      have hlist :
          List.ofFn (fun i : Fin (n + 1) => q (f i)) =
            (List.ofFn fun i : Fin n => q (f i.castSucc)) ++
              [q (f (Fin.last n))] :=
        List.ofFn_succ_last
      have hprefix :
          RingTheory.Sequence.IsWeaklyRegular S
            (List.ofFn fun i : Fin n => q (f i.castSucc)) := by
        have hsplit :=
          (RingTheory.Sequence.isWeaklyRegular_append_iff S
            (List.ofFn fun i : Fin n => q (f i.castSucc))
            [q (f (Fin.last n))]).mp
            (hlist ▸ hregular)
        exact hsplit.1
      have hsum :
          (∑ i : Fin n, a i.castSucc * q (f i.castSucc)) +
            a (Fin.last n) * q (f (Fin.last n)) = 0 := by
        simpa only [Fin.sum_univ_castSucc] using hrelation
      have hproduct :
          q (f (Fin.last n)) * a (Fin.last n) ∈
            Ideal.span
              (Set.range fun i : Fin n => q (f i.castSucc)) := by
        apply Ideal.mem_span_range_iff_exists_fun.mpr
        refine ⟨fun i => -a i.castSucc, ?_⟩
        calc
          (∑ i : Fin n, -a i.castSucc * q (f i.castSucc)) =
              -(∑ i : Fin n, a i.castSucc * q (f i.castSucc)) := by
                simp only [neg_mul, Finset.sum_neg_distrib]
          _ = q (f (Fin.last n)) * a (Fin.last n) := by
                linear_combination -hsum
      have hlast :
          a (Fin.last n) ∈
            Ideal.span
              (Set.range fun i : Fin n => q (f i.castSucc)) :=
        homogeneousMap_allRank_fin_last_mem_span_of_weaklyRegular
          (fun i : Fin (n + 1) => q (f i)) hregular hproduct
      obtain ⟨t, ht⟩ :=
        Ideal.mem_span_range_iff_exists_fun.mp hlast
      choose d hd using fun i : Fin n => hq (t i)
      have hcorrected :
          (∑ i : Fin n,
            (a i.castSucc + t i * q (f (Fin.last n))) *
              q (f i.castSucc)) = 0 := by
        calc
          (∑ i : Fin n,
            (a i.castSucc + t i * q (f (Fin.last n))) *
              q (f i.castSucc)) =
            (∑ i : Fin n, a i.castSucc * q (f i.castSucc)) +
              (∑ i : Fin n, t i * q (f i.castSucc)) *
                q (f (Fin.last n)) := by
                  simp_rw [add_mul]
                  rw [Finset.sum_add_distrib, Finset.sum_mul]
                  congr 1
                  apply Finset.sum_congr rfl
                  intro i _
                  ring
          _ = 0 := by
            rw [ht]
            linear_combination hsum
      obtain ⟨b, hb, hbsum⟩ :=
        ih (fun i : Fin n => f i.castSucc) hprefix
          (fun i : Fin n => a i.castSucc +
            t i * q (f (Fin.last n))) hcorrected
      let blast : R := ∑ i : Fin n, d i * f i.castSucc
      let result : Fin (n + 1) → R :=
        Fin.snoc
          (fun i : Fin n => b i - d i * f (Fin.last n)) blast
      refine ⟨result, ?_, ?_⟩
      · intro i
        induction i using Fin.lastCases with
        | last =>
            simp only [result, Fin.snoc_last]
            change q (∑ i : Fin n, d i * f i.castSucc) =
              a (Fin.last n)
            simpa only [map_sum, map_mul, hd] using ht
        | cast i =>
            simp only [result, Fin.snoc_castSucc]
            rw [map_sub, map_mul, hb i, hd i]
            ring
      · rw [Fin.sum_univ_castSucc]
        simp only [result, Fin.snoc_castSucc, Fin.snoc_last]
        change
          (∑ i : Fin n,
            (b i - d i * f (Fin.last n)) * f i.castSucc) +
            (∑ i : Fin n, d i * f i.castSucc) *
              f (Fin.last n) = 0
        simp_rw [sub_mul]
        rw [Finset.sum_sub_distrib, Finset.sum_mul, hbsum]
        simp only [zero_sub]
        have hcomm :
            (∑ i : Fin n,
              d i * f (Fin.last n) * f i.castSucc) =
            ∑ i : Fin n,
              d i * f i.castSucc * f (Fin.last n) := by
          apply Finset.sum_congr rfl
          intro i _
          ring
        rw [hcomm]
        exact neg_add_cancel _

theorem homogeneousMap_allRank_ringEquiv_isWeaklyRegular_iff_aux
    {R S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S) (rs : List R) :
    RingTheory.Sequence.IsWeaklyRegular R rs ↔
      RingTheory.Sequence.IsWeaklyRegular S (rs.map e) := by
