    homogeneousMapAllTargetReesChartHyperplaneEquiv k a
      (Ideal.Quotient.mk (homogeneousMapAllTargetReesChartIdeal k a) p) = 0 ↔
      p ∈ homogeneousMapAllTargetReesChartIdeal k a
