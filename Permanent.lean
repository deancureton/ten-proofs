theorem homogeneousMap_allRank_actualSourcePrefixHilbert_eq_bounded
    (k : ℕ)
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (j : ℕ) (hj : j ≤ k) (n : ℕ) :
    homogeneousMapAllKActualCoordinateHilbert F (homogeneousMapAllKSourcePrefix k j) n =
      homogeneousMapAllKBoundedHomogeneousHilbertCoefficient
        k e n (homogeneousMapAllKSourcePrefix k j) := by
  induction j generalizing n with
  | zero =>
      rw [homogeneousMap_allRank_sourcePrefix_zero,
        homogeneousMap_allRank_actualCoordinateHilbert_empty,
        homogeneousMap_allRank_bounded_homogeneous_hilbert_coefficient_empty]
  | succ j ih =>
      have hjlt : j < k := by omega
      let i : Fin k := ⟨j, hjlt⟩
      have hprev : ∀ m,
          homogeneousMapAllKActualCoordinateHilbert F
            (homogeneousMapAllKSourcePrefix k j) m =
          homogeneousMapAllKBoundedHomogeneousHilbertCoefficient
            k e m (homogeneousMapAllKSourcePrefix k j) := by
        intro m
        exact ih (by omega) m
      have hreg : IsSMulRegular
          (MvPolynomial (Fin k) ℂ ⧸
            homogeneousMapAllKCoordinateSubsetIdeal F (homogeneousMapAllKSourcePrefix k j))
          (F i) := by
        change IsSMulRegular
          (MvPolynomial (Fin k) ℂ ⧸
            Ideal.span (F ''
              (homogeneousMapAllKSourcePrefix k j : Set (Fin k))))
          (F ⟨j, hjlt⟩)
        exact homogeneousMap_allRank_sourcePrefix_isSMulRegular
          k F e he hF hzero j hjlt
      have hnext :=
        homogeneousMap_allRank_hilbert_coefficient_eq_bounded_of_insert_recurrence
          k e (homogeneousMapAllKSourcePrefix k j) i
          (homogeneousMap_allRank_sourcePrefix_not_mem hjlt)
          (homogeneousMapAllKActualCoordinateHilbert F
            (homogeneousMapAllKSourcePrefix k j))
          (homogeneousMapAllKActualCoordinateHilbert F
            (insert i (homogeneousMapAllKSourcePrefix k j))) hprev
          (fun m hm => homogeneousMap_allRank_actualCoordinateHilbert_insert_of_lt
            F hF (homogeneousMapAllKSourcePrefix k j) i m hm)
          (fun m =>
            homogeneousMap_allRank_actualCoordinateHilbert_insert_recurrence_of_regular
              F hF (homogeneousMapAllKSourcePrefix k j) i hreg m)
      rw [homogeneousMap_allRank_sourcePrefix_succ hjlt]
      exact hnext n

theorem homogeneousMap_zeroFiberIdeal_finrank_of_pos_rank
    (k : ℕ) (hk : 0 < k)
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    Module.finrank ℂ
      (MvPolynomial (Fin k) ℂ ⧸ homogeneousMapIdeal F) = e ^ k := by
  classical
  obtain ⟨N₀, hN₀⟩ :=
    exists_high_homogeneousSubmodule_le_homogeneousMapIdeal F hzero
  let N : ℕ := max N₀ (k * e)
  have hhigh : ∀ n : ℕ, N ≤ n →
      ∀ p : MvPolynomial (Fin k) ℂ,
        p.IsHomogeneous n → p ∈ homogeneousMapIdeal F := by
    intro n hn p hp
    exact hN₀ n (le_trans (Nat.le_max_left _ _) hn) p hp
  calc
    Module.finrank ℂ
        (MvPolynomial (Fin k) ℂ ⧸ homogeneousMapIdeal F) =
      ∑ i : Fin N,
        Module.finrank ℂ
          (homogeneousMapGradedQuotientPiece (homogeneousMapIdeal F) i) :=
      homogeneousMapFiniteGradedQuotient_finrank_eq_sum
        (homogeneousMapIdeal F)
        (homogeneousMapIdeal_isHomogeneous F e hF) N hhigh
    _ = ∑ i : Fin N,
        homogeneousMapAllKBoundedHomogeneousHilbertCoefficient
          k e i Finset.univ := by
      apply Finset.sum_congr rfl
      intro i _
      rw [← homogeneousMap_allRank_coordinateSubsetIdeal_univ F,
        ← homogeneousMap_allRank_sourcePrefix_full k]
      exact homogeneousMap_allRank_actualSourcePrefixHilbert_eq_bounded
        k F e he hF hzero k (le_refl k) i
    _ = ∑ n ∈ Finset.range N,
        homogeneousMapAllKBoundedHomogeneousHilbertCoefficient
          k e n Finset.univ :=
      Fin.sum_univ_eq_sum_range
        (fun n => homogeneousMapAllKBoundedHomogeneousHilbertCoefficient
          k e n Finset.univ) N
    _ = e ^ k :=
      homogeneousMap_allRank_bounded_homogeneous_hilbert_coefficient_univ_sum_of_cutoff
        k e N hk (Nat.le_max_right _ _)

theorem homogeneousMap_zeroFiberIdeal_finrank
    (k : ℕ)
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    Module.finrank ℂ
      (MvPolynomial (Fin k) ℂ ⧸ homogeneousMapIdeal F) = e ^ k := by
  classical
  cases k with
  | zero =>
      have hI : homogeneousMapIdeal F =
          (⊥ : Ideal (MvPolynomial (Fin 0) ℂ)) := by
        simp only [homogeneousMapIdeal, Matrix.range_empty, Submodule.span_empty]
      rw [hI]
      calc
        Module.finrank ℂ
            (MvPolynomial (Fin 0) ℂ ⧸
              (⊥ : Ideal (MvPolynomial (Fin 0) ℂ))) =
            Module.finrank ℂ (MvPolynomial (Fin 0) ℂ) :=
          (Submodule.quotEquivOfEqBot _ rfl).finrank_eq
        _ = Module.finrank ℂ ℂ :=
          (MvPolynomial.isEmptyAlgEquiv ℂ (Fin 0)).toLinearEquiv.finrank_eq
        _ = e ^ 0 := by simp only [Module.finrank_self, pow_zero]
  | succ k =>
      exact homogeneousMap_zeroFiberIdeal_finrank_of_pos_rank
        (k + 1) (Nat.zero_lt_succ k) F e he hF hzero

theorem homogeneousMap_zeroClosedFiber_finrank
    (k : ℕ)
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    Module.finrank ℂ (homogeneousMapClosedFiber F 0) = e ^ k := by
  change Module.finrank ℂ
    (MvPolynomial (Fin k) ℂ ⧸ homogeneousMapFiberIdeal F 0) = e ^ k
  rw [homogeneousMapFiberIdeal_zero]
  exact homogeneousMap_zeroFiberIdeal_finrank
    k F e he hF hzero

