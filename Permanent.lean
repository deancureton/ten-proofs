attribute [local instance] MvPolynomial.gradedAlgebra

theorem finiteDimensional_quotient_radical_of_zeroLocus_finite
    {ι : Type*} [Finite ι]
    (I : Ideal (MvPolynomial ι ℂ))
    (hfinite : (MvPolynomial.zeroLocus ℂ I).Finite) :
    Module.Finite ℂ (MvPolynomial ι ℂ ⧸ I.radical) := by
  classical
  let Z : Type _ := {x : ι → ℂ // x ∈ MvPolynomial.zeroLocus ℂ I}
  letI : Finite Z := Set.finite_coe_iff.mpr hfinite
  have hvanish (x : Z) (p : MvPolynomial ι ℂ)
      (hp : p ∈ I.radical) : MvPolynomial.aeval (x : ι → ℂ) p = 0 := by
    rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := ℂ)] at hp
    exact (MvPolynomial.mem_vanishingIdeal_iff.mp hp) x x.property
  let evalAt (x : Z) : (MvPolynomial ι ℂ ⧸ I.radical) →ₐ[ℂ] ℂ :=
    Ideal.Quotient.liftₐ I.radical
      (MvPolynomial.aeval (x : ι → ℂ)) (hvanish x)
  let E : (MvPolynomial ι ℂ ⧸ I.radical) →ₗ[ℂ] (Z → ℂ) :=
    LinearMap.pi fun x => (evalAt x).toLinearMap
  have hinj : Function.Injective E := by
    intro a b hab
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
    obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective b
    apply Ideal.Quotient.eq.mpr
    rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := ℂ)]
    apply MvPolynomial.mem_vanishingIdeal_iff.mpr
    intro x hx
    have hvalue := congr_fun hab (⟨x, hx⟩ : Z)
    change MvPolynomial.aeval x p = MvPolynomial.aeval x q at hvalue
    rw [map_sub, hvalue, sub_self]
  exact Module.Finite.of_injective E hinj

theorem finiteDimensional_quotient_of_zeroLocus_finite
    {ι : Type*} [Finite ι]
    (I : Ideal (MvPolynomial ι ℂ))
    (hfinite : (MvPolynomial.zeroLocus ℂ I).Finite) :
    Module.Finite ℂ (MvPolynomial ι ℂ ⧸ I) := by
  classical
  let A := MvPolynomial ι ℂ ⧸ I
  let B := MvPolynomial ι ℂ ⧸ I.radical
  letI : Module.Finite ℂ B :=
    finiteDimensional_quotient_radical_of_zeroLocus_finite I hfinite
  let φ : A →ₐ[ℂ] B := Ideal.Quotient.factorₐ ℂ I.le_radical
  have hsurj : Function.Surjective φ :=
    Ideal.Quotient.factor_surjective I.le_radical
  have hnil : RingHom.ker φ.toRingHom ≤ nilradical A := by
    intro a ha
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
    have hp : p ∈ I.radical := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      exact ha
    obtain ⟨n, hn⟩ := hp
    rw [mem_nilradical]
    refine ⟨n, ?_⟩
    simpa only [map_pow] using (Ideal.Quotient.eq_zero_iff_mem.mpr hn)
  exact Module.finite_of_surjective_of_ker_le_nilradical φ hsurj hnil
    (IsNoetherian.noetherian _)

noncomputable def affineTotalDegreeFilteredPiece
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ)) (n : ℕ) :
    Submodule ℂ (MvPolynomial ι ℂ ⧸ I) :=
  (MvPolynomial.restrictTotalDegree ι ℂ n).map
    (Ideal.Quotient.mkₐ ℂ I).toLinearMap

noncomputable def affineTotalDegreeFilteredProjection
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ)) (n : ℕ) :
    MvPolynomial.restrictTotalDegree ι ℂ n →ₗ[ℂ]
      affineTotalDegreeFilteredPiece I n :=
  LinearMap.codRestrict (affineTotalDegreeFilteredPiece I n)
    ((Ideal.Quotient.mkₐ ℂ I).toLinearMap.domRestrict
      (MvPolynomial.restrictTotalDegree ι ℂ n)) (by
        intro p
        apply Submodule.mem_map.mpr
        exact ⟨p, p.property, rfl⟩)

theorem affine_total_degree_filtered_projection_surjective
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ)) (n : ℕ) :
    Function.Surjective (affineTotalDegreeFilteredProjection I n) := by
  intro x
  obtain ⟨p, hp, hpimage⟩ := Submodule.mem_map.mp x.property
  refine ⟨⟨p, hp⟩, ?_⟩
  apply Subtype.ext
  exact hpimage

noncomputable instance affine_total_degree_filtered_piece_finite
    {ι : Type*} [Finite ι]
    (I : Ideal (MvPolynomial ι ℂ)) (n : ℕ) :
    Module.Finite ℂ (affineTotalDegreeFilteredPiece I n) :=
  Module.Finite.of_surjective
    (affineTotalDegreeFilteredProjection I n)
    (affine_total_degree_filtered_projection_surjective I n)

theorem affine_total_degree_filtered_piece_mem_iff
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ)) (n : ℕ)
    (x : MvPolynomial ι ℂ ⧸ I) :
    x ∈ affineTotalDegreeFilteredPiece I n ↔
      ∃ p : MvPolynomial ι ℂ, p.totalDegree ≤ n ∧
        Ideal.Quotient.mk I p = x := by
  simp only [affineTotalDegreeFilteredPiece, Submodule.mem_map, MvPolynomial.mem_restrictTotalDegree,
    AlgHom.toLinearMap_apply, Ideal.Quotient.mkₐ_eq_mk]

theorem affine_total_degree_filtered_piece_mono
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ))
    {m n : ℕ} (h : m ≤ n) :
    affineTotalDegreeFilteredPiece I m ≤
      affineTotalDegreeFilteredPiece I n := by
  apply Submodule.map_mono
  intro p hp
  apply (MvPolynomial.mem_restrictTotalDegree _ _ p).mpr
  exact ((MvPolynomial.mem_restrictTotalDegree _ _ p).mp hp).trans h

theorem affine_restrictTotalDegree_finrank
    {ι : Type*} [Fintype ι] (N : ℕ) :
    Module.finrank ℂ (MvPolynomial.restrictTotalDegree ι ℂ N) =
      (N + Fintype.card ι).choose (Fintype.card ι) := by
  classical
  let T : Set (ι →₀ ℕ) := {d | d.degree ≤ N}
  have hT : T.Finite := Finsupp.finite_of_degree_le N
  letI : Fintype T := hT.fintype
  let s : Finset (ι →₀ ℕ) := hT.toFinset
  have hrestrict :
      MvPolynomial.restrictTotalDegree ι ℂ N =
        MvPolynomial.restrictSupport ℂ T := by
    ext p
    simp only [MvPolynomial.mem_restrictTotalDegree, MvPolynomial.totalDegree, Finsupp.sum, Finset.sup_le_iff,
      MvPolynomial.mem_support_iff, ne_eq, Finsupp.degree_apply, MvPolynomial.mem_restrictSupport_iff, Set.subset_def,
      SetLike.mem_coe, Set.mem_setOf_eq, T]
  have hsubtype : Fintype.card T = s.card := by
    let E : T ≃ {d // d ∈ s} :=
      Equiv.subtypeEquiv (Equiv.refl (ι →₀ ℕ)) (by
        intro d
        simp only [Set.mem_setOf_eq, Set.toFinite_toFinset, Equiv.refl_apply, Set.mem_toFinset, T, s])
    exact (Fintype.card_congr E).trans (Fintype.card_coe s)
  have hmaps :
      (s : Set (ι →₀ ℕ)).MapsTo Finsupp.degree
        (Finset.range (N + 1) : Set ℕ) := by
    intro d hd
    have hle : d.degree ≤ N := by
      simpa [s, T] using hd
    simp only [Finset.mem_coe, Finset.mem_range]
    omega
  have hfiber (n : ℕ) (hn : n < N + 1) :
      s.filter (fun d => d.degree = n) =
        (Finset.univ : Finset ι).finsuppAntidiag n := by
    ext d
    simp only [Finset.mem_filter, s, Set.Finite.mem_toFinset,
      T, Set.mem_setOf_eq, Finset.mem_finsuppAntidiag,
      Finset.subset_univ, and_true]
    rw [← Finsupp.degree_eq_sum]
    constructor
    · exact fun h => h.2
    · intro h
      exact ⟨by omega, h⟩
  have hcard := Finset.card_eq_sum_card_fiberwise
    (f := Finsupp.degree) (s := s) (t := Finset.range (N + 1)) hmaps
  calc
    Module.finrank ℂ (MvPolynomial.restrictTotalDegree ι ℂ N) =
        Fintype.card T := by
      rw [hrestrict]
      exact Module.finrank_eq_card_basis
        (MvPolynomial.basisRestrictSupport ℂ T)
    _ = s.card := hsubtype
    _ = ∑ n ∈ Finset.range (N + 1),
          (Fintype.card ι).multichoose n := by
      rw [hcard]
      apply Finset.sum_congr rfl
      intro n hn
      rw [hfiber n (Finset.mem_range.mp hn),
        Finset.card_finsuppAntidiag_nat_eq_multichoose]
      simp only [Finset.card_univ]
    _ = (N + Fintype.card ι).choose (Fintype.card ι) :=
      Nat.sum_range_multichoose N (Fintype.card ι)

theorem affine_total_degree_filtered_bot_finrank
    {ι : Type*} [Fintype ι] (N : ℕ) :
    Module.finrank ℂ
        (affineTotalDegreeFilteredPiece
          (⊥ : Ideal (MvPolynomial ι ℂ)) N) =
      (N + Fintype.card ι).choose (Fintype.card ι) := by
  let q := affineTotalDegreeFilteredProjection
    (⊥ : Ideal (MvPolynomial ι ℂ)) N
  have hmk :
      Function.Injective
        (Ideal.Quotient.mk (⊥ : Ideal (MvPolynomial ι ℂ))) :=
    ((Ideal.Quotient.mk_bijective_iff_eq_bot
      (⊥ : Ideal (MvPolynomial ι ℂ))).mpr rfl).1
  have hqinj : Function.Injective q := by
    intro x y hxy
    apply Subtype.ext
    apply hmk
    have h := congrArg Subtype.val hxy
    exact h
  have hqsurj : Function.Surjective q :=
    affine_total_degree_filtered_projection_surjective
      (⊥ : Ideal (MvPolynomial ι ℂ)) N
  have hequiv := (LinearEquiv.ofBijective q ⟨hqinj, hqsurj⟩).finrank_eq
  calc
    Module.finrank ℂ
        (affineTotalDegreeFilteredPiece
          (⊥ : Ideal (MvPolynomial ι ℂ)) N) =
        Module.finrank ℂ (MvPolynomial.restrictTotalDegree ι ℂ N) :=
      hequiv.symm
    _ = (N + Fintype.card ι).choose (Fintype.card ι) :=
      affine_restrictTotalDegree_finrank N

theorem affine_total_degree_filtered_piece_exists_eq_top
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ))
    [Module.Finite ℂ (MvPolynomial ι ℂ ⧸ I)] :
    ∃ n : ℕ, affineTotalDegreeFilteredPiece I n = ⊤ := by
  classical
  let b := Module.finBasis ℂ (MvPolynomial ι ℂ ⧸ I)
  let p : Fin (Module.finrank ℂ (MvPolynomial ι ℂ ⧸ I)) →
      MvPolynomial ι ℂ := fun i =>
    (Ideal.Quotient.mk_surjective (I := I) (b i)).choose
  have hp (i : Fin (Module.finrank ℂ (MvPolynomial ι ℂ ⧸ I))) :
      Ideal.Quotient.mk I (p i) = b i :=
    (Ideal.Quotient.mk_surjective (I := I) (b i)).choose_spec
  let n : ℕ := Finset.univ.sup fun i => (p i).totalDegree
  refine ⟨n, top_unique ?_⟩
  rw [← b.span_eq, Submodule.span_le]
  rintro _ ⟨i, rfl⟩
  apply (affine_total_degree_filtered_piece_mem_iff I n (b i)).mpr
  refine ⟨p i, ?_, hp i⟩
  change (p i).totalDegree ≤
    (Finset.univ : Finset
      (Fin (Module.finrank ℂ (MvPolynomial ι ℂ ⧸ I)))).sup
        (fun j => (p j).totalDegree)
  exact Finset.le_sup
    (s := (Finset.univ : Finset
      (Fin (Module.finrank ℂ (MvPolynomial ι ℂ ⧸ I)))))
    (f := fun j => (p j).totalDegree) (Finset.mem_univ i)

theorem affine_total_degree_filtered_piece_eventually_eq_top
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ))
    [Module.Finite ℂ (MvPolynomial ι ℂ ⧸ I)] :
    ∃ n : ℕ, ∀ m : ℕ, n ≤ m →
      affineTotalDegreeFilteredPiece I m = ⊤ := by
  obtain ⟨n, hn⟩ := affine_total_degree_filtered_piece_exists_eq_top I
  refine ⟨n, fun m hm => ?_⟩
  apply top_unique
  rw [← hn]
  exact affine_total_degree_filtered_piece_mono I hm

theorem affine_total_degree_filtered_piece_eventual_finrank
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ))
    [Module.Finite ℂ (MvPolynomial ι ℂ ⧸ I)] :
    ∃ n : ℕ, ∀ m : ℕ, n ≤ m →
      Module.finrank ℂ (affineTotalDegreeFilteredPiece I m) =
        Module.finrank ℂ (MvPolynomial ι ℂ ⧸ I) := by
  obtain ⟨n, hn⟩ := affine_total_degree_filtered_piece_eventually_eq_top I
  refine ⟨n, fun m hm => ?_⟩
  rw [hn m hm, finrank_top]

noncomputable def affineTotalDegreeFilteredFactor
    {ι : Type*} {I J : Ideal (MvPolynomial ι ℂ)}
    (hIJ : I ≤ J) (n : ℕ) :
    affineTotalDegreeFilteredPiece I n →ₗ[ℂ]
      affineTotalDegreeFilteredPiece J n :=
  LinearMap.codRestrict (affineTotalDegreeFilteredPiece J n)
    ((Ideal.Quotient.factorₐ ℂ hIJ).toLinearMap.domRestrict
      (affineTotalDegreeFilteredPiece I n)) (by
        intro x
        obtain ⟨p, hp, hpimage⟩ :=
          (affine_total_degree_filtered_piece_mem_iff
            I n x).mp x.property
        apply (affine_total_degree_filtered_piece_mem_iff J n _).mpr
        refine ⟨p, hp, ?_⟩
        change Ideal.Quotient.mk J p =
          Ideal.Quotient.factorₐ ℂ hIJ (x : MvPolynomial ι ℂ ⧸ I)
        rw [← hpimage]
        rfl)

theorem affine_total_degree_filtered_factor_surjective
    {ι : Type*} {I J : Ideal (MvPolynomial ι ℂ)}
    (hIJ : I ≤ J) (n : ℕ) :
    Function.Surjective (affineTotalDegreeFilteredFactor hIJ n) := by
  intro y
  obtain ⟨p, hp, hpimage⟩ :=
    (affine_total_degree_filtered_piece_mem_iff J n y).mp y.property
  have hpmem : Ideal.Quotient.mk I p ∈
      affineTotalDegreeFilteredPiece I n :=
    (affine_total_degree_filtered_piece_mem_iff
      I n (Ideal.Quotient.mk I p)).mpr ⟨p, hp, rfl⟩
  refine ⟨⟨Ideal.Quotient.mk I p, hpmem⟩, ?_⟩
  apply Subtype.ext
  change Ideal.Quotient.factorₐ ℂ hIJ (Ideal.Quotient.mk I p) =
    (y : MvPolynomial ι ℂ ⧸ J)
  change Ideal.Quotient.mk J p = _
  exact hpimage

theorem affine_total_degree_filtered_factor_finrank_le
    {ι : Type*} [Finite ι] {I J : Ideal (MvPolynomial ι ℂ)}
    (hIJ : I ≤ J) (n : ℕ) :
    Module.finrank ℂ (affineTotalDegreeFilteredPiece J n) ≤
      Module.finrank ℂ (affineTotalDegreeFilteredPiece I n) := by
  apply LinearMap.finrank_le_finrank_of_surjective
  exact affine_total_degree_filtered_factor_surjective hIJ n

noncomputable def affineTotalDegreeFilteredMul
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ))
    (g : MvPolynomial ι ℂ) (n : ℕ) :
    affineTotalDegreeFilteredPiece I n →ₗ[ℂ]
      affineTotalDegreeFilteredPiece I (g.totalDegree + n) :=
  LinearMap.codRestrict
    (affineTotalDegreeFilteredPiece I (g.totalDegree + n))
    ((LinearMap.mulLeft ℂ (Ideal.Quotient.mk I g)).domRestrict
        (affineTotalDegreeFilteredPiece I n)) (by
      intro x
      obtain ⟨p, hp, hpimage⟩ :=
        (affine_total_degree_filtered_piece_mem_iff I n x).mp x.property
      apply (affine_total_degree_filtered_piece_mem_iff
        I (g.totalDegree + n) _).mpr
      refine ⟨g * p,
        (MvPolynomial.totalDegree_mul g p).trans
          (Nat.add_le_add_left hp g.totalDegree), ?_⟩
      change Ideal.Quotient.mk I (g * p) =
        Ideal.Quotient.mk I g * (x : MvPolynomial ι ℂ ⧸ I)
      rw [map_mul, hpimage])

theorem affine_total_degree_filtered_mul_injective
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ))
    (g : MvPolynomial ι ℂ)
    (hregular : IsSMulRegular (MvPolynomial ι ℂ ⧸ I) g)
    (n : ℕ) :
    Function.Injective (affineTotalDegreeFilteredMul I g n) := by
  intro x y hxy
  apply Subtype.ext
  have h := congrArg Subtype.val hxy
  change Ideal.Quotient.mk I g * (x : MvPolynomial ι ℂ ⧸ I) =
    Ideal.Quotient.mk I g * (y : MvPolynomial ι ℂ ⧸ I) at h
  obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective
    ((x : MvPolynomial ι ℂ ⧸ I) - (y : MvPolynomial ι ℂ ⧸ I))
  have hprod : g * p ∈ I := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    rw [map_mul, hp, mul_sub, sub_eq_zero]
    exact h
  have hpI : p ∈ I := by
    apply (isSMulRegular_quotient_iff_mem_of_smul_mem I g).mp hregular p
    simpa only [smul_eq_mul] using hprod
  apply sub_eq_zero.mp
  rw [← hp]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hpI

theorem affine_total_degree_filtered_mul_range_le_factor_ker
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ))
    (g : MvPolynomial ι ℂ) (n : ℕ) :
    (affineTotalDegreeFilteredMul I g n).range ≤
      (affineTotalDegreeFilteredFactor
        (show I ≤ I ⊔ Ideal.span ({g} : Set (MvPolynomial ι ℂ)) from
          le_sup_left)
        (g.totalDegree + n)).ker := by
  intro x hx
  obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hx
  apply LinearMap.mem_ker.mpr
  apply Subtype.ext
  change
    Ideal.Quotient.factorₐ ℂ
        (show I ≤ I ⊔ Ideal.span ({g} : Set (MvPolynomial ι ℂ)) from
          le_sup_left)
      (Ideal.Quotient.mk I g *
        (y : MvPolynomial ι ℂ ⧸ I)) = 0
  rw [map_mul]
  have hg :
      Ideal.Quotient.mk (I ⊔ Ideal.span ({g} : Set (MvPolynomial ι ℂ))) g =
        0 := by
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    exact
      (show Ideal.span ({g} : Set (MvPolynomial ι ℂ)) ≤
        I ⊔ Ideal.span ({g} : Set (MvPolynomial ι ℂ)) from le_sup_right)
        (Ideal.subset_span (by simp only [Set.mem_singleton_iff]))
  change
    Ideal.Quotient.mk (I ⊔ Ideal.span ({g} : Set (MvPolynomial ι ℂ))) g *
      _ = 0
  rw [hg, zero_mul]

theorem affine_total_degree_filtered_regular_finrank_inequality
    {ι : Type*} [Finite ι]
    (I : Ideal (MvPolynomial ι ℂ)) (g : MvPolynomial ι ℂ)
    (hregular : IsSMulRegular (MvPolynomial ι ℂ ⧸ I) g)
    (n : ℕ) :
    Module.finrank ℂ
        (affineTotalDegreeFilteredPiece
          (I ⊔ Ideal.span ({g} : Set (MvPolynomial ι ℂ)))
          (g.totalDegree + n)) +
      Module.finrank ℂ (affineTotalDegreeFilteredPiece I n) ≤
        Module.finrank ℂ
          (affineTotalDegreeFilteredPiece I (g.totalDegree + n)) := by
  let q := affineTotalDegreeFilteredFactor
    (show I ≤ I ⊔ Ideal.span ({g} : Set (MvPolynomial ι ℂ)) from
      le_sup_left)
    (g.totalDegree + n)
  let μ := affineTotalDegreeFilteredMul I g n
  have hμ : Function.Injective μ :=
    affine_total_degree_filtered_mul_injective I g hregular n
  have hq : Function.Surjective q :=
    affine_total_degree_filtered_factor_surjective
      (show I ≤ I ⊔ Ideal.span ({g} : Set (MvPolynomial ι ℂ)) from
        le_sup_left)
      (g.totalDegree + n)
  have hkernel : μ.range ≤ q.ker :=
    affine_total_degree_filtered_mul_range_le_factor_ker I g n
  have hμrank :
      Module.finrank ℂ μ.range =
        Module.finrank ℂ (affineTotalDegreeFilteredPiece I n) :=
    LinearMap.finrank_range_of_inj hμ
  have hqrank :
      Module.finrank ℂ q.range =
        Module.finrank ℂ
          (affineTotalDegreeFilteredPiece
            (I ⊔ Ideal.span ({g} : Set (MvPolynomial ι ℂ)))
              (g.totalDegree + n)) := by
    rw [LinearMap.range_eq_top_of_surjective q hq, finrank_top]
  have hkerle := Submodule.finrank_mono hkernel
  have hnullity := q.finrank_range_add_finrank_ker
  omega

def affineCumulative (H : ℕ → ℕ) (m : ℕ) : ℕ :=
  ∑ i ∈ Finset.range (m + 1), H i

theorem affine_sum_range_degree_shift
    (H : ℕ → ℕ) (d N : ℕ) :
    (∑ m ∈ Finset.range N, if d ≤ m then H (m - d) else 0) =
      ∑ m ∈ Finset.range (N - d), H m := by
  induction N with
  | zero => simp only [Finset.range_zero, Finset.sum_empty, zero_tsub]
  | succ N ih =>
      rw [Finset.sum_range_succ, ih]
      by_cases h : d ≤ N
      · have hs : N + 1 - d = (N - d) + 1 := by omega
        rw [if_pos h, hs, Finset.sum_range_succ]
      · have hN : N - d = 0 := by omega
        have hs : N + 1 - d = 0 := by omega
        simp only [hN, Finset.range_zero, Finset.sum_empty, h, ↓reduceIte, add_zero, hs]

theorem affine_cumulative_le_degree_mul_of_filtered_step
    (Hprev Hnext : ℕ → ℕ) (d : ℕ)
    (hmono : Monotone Hprev)
    (hstep : ∀ m : ℕ,
      Hnext m + (if d ≤ m then Hprev (m - d) else 0) ≤ Hprev m)
    (M : ℕ) :
    affineCumulative Hnext M ≤ d * Hprev M := by
  let N := M + 1
  let a := N - d
  let r := min d N
  have har : a + r = N := by
    dsimp [a, r, N]
    omega
  have hsum :
      (∑ m ∈ Finset.range N, Hnext m) +
        (∑ m ∈ Finset.range a, Hprev m) ≤
          ∑ m ∈ Finset.range N, Hprev m := by
    have h := Finset.sum_le_sum
      (s := Finset.range N) (fun m _ => hstep m)
    simpa only [ge_iff_le, Finset.sum_add_distrib, affine_sum_range_degree_shift] using h
  have hsplit :
      (∑ m ∈ Finset.range N, Hprev m) =
        (∑ m ∈ Finset.range a, Hprev m) +
          (∑ j ∈ Finset.range r, Hprev (a + j)) := by
    rw [← har, Finset.sum_range_add]
  rw [hsplit] at hsum
  have htail :
      (∑ j ∈ Finset.range r, Hprev (a + j)) ≤ r * Hprev M := by
    calc
      (∑ j ∈ Finset.range r, Hprev (a + j)) ≤
          ∑ _j ∈ Finset.range r, Hprev M := by
        apply Finset.sum_le_sum
        intro j hj
        apply hmono
        have hj' := Finset.mem_range.mp hj
        dsimp [N] at har
        omega
      _ = r * Hprev M := by simp only [Finset.sum_const, Finset.card_range, smul_eq_mul]
  have hrd : r ≤ d := min_le_left _ _
  unfold affineCumulative
  change (∑ m ∈ Finset.range N, Hnext m) ≤ d * Hprev M
  have hcancel :
      (∑ m ∈ Finset.range N, Hnext m) ≤
        ∑ j ∈ Finset.range r, Hprev (a + j) := by
    omega
  exact hcancel.trans
    (htail.trans (Nat.mul_le_mul_right _ hrd))

theorem affine_cumulative_mono
    {H K : ℕ → ℕ} (h : ∀ m, H m ≤ K m) (M : ℕ) :
    affineCumulative H M ≤ affineCumulative K M := by
  unfold affineCumulative
  exact Finset.sum_le_sum (fun i _ => h i)

theorem affine_cumulative_iterate_mono
    {H K : ℕ → ℕ} (h : ∀ m, H m ≤ K m)
    (j M : ℕ) :
    (affineCumulative^[j]) H M ≤ (affineCumulative^[j]) K M := by
  induction j generalizing M with
  | zero => exact h M
  | succ j ih =>
      rw [Function.iterate_succ_apply']
      rw [Function.iterate_succ_apply']
      exact affine_cumulative_mono (fun m => ih m) M

theorem affine_cumulative_iterate_const_mul
    (d : ℕ) (H : ℕ → ℕ) (j M : ℕ) :
    (affineCumulative^[j]) (fun m => d * H m) M =
      d * (affineCumulative^[j]) H M := by
  induction j generalizing M with
  | zero => rfl
  | succ j ih =>
      rw [Function.iterate_succ_apply']
      rw [Function.iterate_succ_apply']
      change
        (∑ i ∈ Finset.range (M + 1),
          (affineCumulative^[j]) (fun m => d * H m) i) =
        d * (∑ i ∈ Finset.range (M + 1),
          (affineCumulative^[j]) H i)
      simp_rw [ih]
      rw [← Finset.mul_sum]

theorem affine_cumulative_iterate_le_degree_product
    (H : ℕ → ℕ → ℕ) (d : ℕ → ℕ) (n : ℕ)
    (hmono : ∀ i, i < n → Monotone (H i))
    (hstep : ∀ i, i < n → ∀ m,
      H (i + 1) m +
        (if d i ≤ m then H i (m - d i) else 0) ≤ H i m)
    (M : ℕ) :
    (affineCumulative^[n]) (H n) M ≤
      (∏ i ∈ Finset.range n, d i) * H 0 M := by
  have aux : ∀ j, j ≤ n → ∀ m,
      (affineCumulative^[j]) (H j) m ≤
        (∏ i ∈ Finset.range j, d i) * H 0 m := by
    intro j hj
    induction j with
    | zero =>
        intro m
        simp only [Function.iterate_zero, id_eq, Finset.range_zero, Finset.prod_empty, one_mul, Std.le_refl]
    | succ j ih =>
        have hjn : j < n := by omega
        intro m
        have hone : ∀ q,
            affineCumulative (H (j + 1)) q ≤ d j * H j q :=
          affine_cumulative_le_degree_mul_of_filtered_step
            (H j) (H (j + 1)) (d j)
            (hmono j hjn) (hstep j hjn)
        calc
          (affineCumulative^[j + 1]) (H (j + 1)) m =
              (affineCumulative^[j])
                (affineCumulative (H (j + 1))) m := by
                  rw [Function.iterate_succ_apply]
          _ ≤ (affineCumulative^[j])
                (fun q => d j * H j q) m :=
              affine_cumulative_iterate_mono hone j m
          _ = d j * (affineCumulative^[j]) (H j) m :=
              affine_cumulative_iterate_const_mul (d j) (H j) j m
          _ ≤ d j * ((∏ i ∈ Finset.range j, d i) * H 0 m) :=
              Nat.mul_le_mul_left (d j) (ih (by omega) m)
          _ = (∏ i ∈ Finset.range (j + 1), d i) * H 0 m := by
              rw [Finset.prod_range_succ]
              ac_rfl
  exact aux n le_rfl M

theorem affine_cumulative_iterate_eventual_constant_lower
    (H : ℕ → ℕ) (L M₀ : ℕ)
    (heventual : ∀ m, M₀ ≤ m → H m = L)
    (n m : ℕ) :
    L * (m + n).choose n ≤
      (affineCumulative^[n]) H (M₀ + m) := by
  induction n generalizing m with
  | zero =>
      simpa only [add_zero, Nat.choose_zero_right, mul_one, Function.iterate_zero, id_eq] using
        (heventual (M₀ + m) (by omega)).ge
  | succ n ih =>
      rw [Function.iterate_succ_apply']
      change L * (m + (n + 1)).choose (n + 1) ≤
        ∑ i ∈ Finset.range (M₀ + m + 1),
          (affineCumulative^[n]) H i
      have hsplit :
          (∑ i ∈ Finset.range (M₀ + m + 1),
            (affineCumulative^[n]) H i) =
          (∑ i ∈ Finset.range M₀,
            (affineCumulative^[n]) H i) +
          (∑ i ∈ Finset.range (m + 1),
            (affineCumulative^[n]) H (M₀ + i)) := by
        simpa only [Nat.add_assoc] using (Finset.sum_range_add (fun i => (affineCumulative^[n]) H i) M₀ (m + 1))
      calc
        L * (m + (n + 1)).choose (n + 1) =
            ∑ i ∈ Finset.range (m + 1),
              L * (i + n).choose n := by
                rw [← Finset.mul_sum, Nat.sum_range_add_choose]
                congr 1
        _ ≤ ∑ i ∈ Finset.range (m + 1),
              (affineCumulative^[n]) H (M₀ + i) :=
            Finset.sum_le_sum (fun i _ => ih i)
        _ ≤ ∑ i ∈ Finset.range (M₀ + m + 1),
              (affineCumulative^[n]) H i := by
            rw [hsplit]
            omega

theorem affine_tendsto_shifted_choose_ratio
    (n M₀ : ℕ) :
    Tendsto
      (fun m : ℕ =>
        ((m + M₀ + n).choose n : ℝ) /
          ((m + n).choose n : ℝ))
      atTop (𝓝 1) := by
  have hnum :
      (fun m : ℕ => ((m + M₀ + n).choose n : ℝ)) ~[atTop]
        (fun m : ℕ =>
          ((m + M₀ + n : ℕ) : ℝ) ^ n / (n.factorial : ℝ)) := by
    simpa only [Nat.add_assoc, Nat.cast_add, Function.comp_def] using
      (isEquivalent_choose n).comp_tendsto (tendsto_add_atTop_nat (M₀ + n))
  have hden :
      (fun m : ℕ => ((m + n).choose n : ℝ)) ~[atTop]
        (fun m : ℕ =>
          ((m + n : ℕ) : ℝ) ^ n / (n.factorial : ℝ)) := by
    simpa only [Nat.cast_add, Function.comp_def] using
      (isEquivalent_choose n).comp_tendsto (tendsto_add_atTop_nat n)
  have hbase :
      Tendsto
        (fun m : ℕ =>
          (((M₀ + n : ℕ) : ℝ) + 1 * (m : ℝ)) /
            (((n : ℕ) : ℝ) + 1 * (m : ℝ)))
        atTop (𝓝 (1 : ℝ)) := by
    simpa only [Nat.cast_add, one_mul, ne_eq, one_ne_zero, not_false_eq_true, div_self] using
      (tendsto_add_mul_div_add_mul_atTop_nhds (((M₀ + n : ℕ) : ℝ)) (((n : ℕ) : ℝ)) (1 : ℝ) (one_ne_zero : (1 : ℝ) ≠ 0))
  have hpow :
      Tendsto
        (fun m : ℕ =>
          ((m + M₀ + n : ℕ) : ℝ) ^ n /
            ((m + n : ℕ) : ℝ) ^ n)
        atTop (𝓝 (1 : ℝ)) := by
    convert hbase.pow n using 1
    · ext m
      simp only [add_comm, Nat.cast_add, one_mul, add_assoc, div_pow]
    · simp only [one_pow]
  have hfact : (n.factorial : ℝ) ≠ 0 := by
    exact_mod_cast n.factorial_ne_zero
  have hequiv :
      (fun m : ℕ =>
        ((m + M₀ + n).choose n : ℝ) /
          ((m + n).choose n : ℝ)) ~[atTop]
        (fun m : ℕ =>
          ((m + M₀ + n : ℕ) : ℝ) ^ n /
            ((m + n : ℕ) : ℝ) ^ n) := by
    convert hnum.div hden using 1
    · rfl
    · ext m
      dsimp
      field_simp
  exact hequiv.symm.tendsto_nhds hpow

theorem affine_le_of_shifted_choose_bounds
    (L P n M₀ : ℕ)
    (hbound : ∀ m : ℕ,
      L * (m + n).choose n ≤
        P * (m + M₀ + n).choose n) :
    L ≤ P := by
  have hratio := affine_tendsto_shifted_choose_ratio n M₀
  have hlim :
      Tendsto
        (fun m : ℕ =>
          (P : ℝ) *
            (((m + M₀ + n).choose n : ℝ) /
              ((m + n).choose n : ℝ)))
        atTop (𝓝 (P : ℝ)) := by
    simpa only [mul_one] using tendsto_const_nhds.mul hratio
  have hle : ∀ m : ℕ,
      (L : ℝ) ≤
        (P : ℝ) *
          (((m + M₀ + n).choose n : ℝ) /
            ((m + n).choose n : ℝ)) := by
    intro m
    have hpos : (0 : ℝ) < ((m + n).choose n : ℝ) := by
      exact_mod_cast Nat.choose_pos (show n ≤ m + n by omega)
    have hb :
        (L : ℝ) * ((m + n).choose n : ℝ) ≤
          (P : ℝ) * ((m + M₀ + n).choose n : ℝ) := by
      exact_mod_cast hbound m
    rw [← mul_div_assoc]
    exact (le_div_iff₀ hpos).2 hb
  have hreal : (L : ℝ) ≤ (P : ℝ) :=
    le_of_tendsto_of_tendsto' tendsto_const_nhds hlim hle
  exact_mod_cast hreal

noncomputable def affineTotalDegreeHilbert
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ)) (n : ℕ) : ℕ :=
  Module.finrank ℂ (affineTotalDegreeFilteredPiece I n)

theorem affine_total_degree_hilbert_mono
    {ι : Type*} [Finite ι] (I : Ideal (MvPolynomial ι ℂ)) :
    Monotone (affineTotalDegreeHilbert I) := by
  intro m n hmn
  exact Submodule.finrank_mono
    (affine_total_degree_filtered_piece_mono I hmn)

theorem affine_total_degree_hilbert_regular_step
    {ι : Type*} [Finite ι]
    (I : Ideal (MvPolynomial ι ℂ)) (g : MvPolynomial ι ℂ)
    (hregular : IsSMulRegular (MvPolynomial ι ℂ ⧸ I) g)
    (m : ℕ) :
    affineTotalDegreeHilbert
        (I ⊔ Ideal.span ({g} : Set (MvPolynomial ι ℂ))) m +
      (if g.totalDegree ≤ m then
        affineTotalDegreeHilbert I (m - g.totalDegree) else 0) ≤
          affineTotalDegreeHilbert I m := by
  by_cases hm : g.totalDegree ≤ m
  · obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le hm
    have hsub : g.totalDegree + n - g.totalDegree = n := by omega
    have hle : g.totalDegree ≤ g.totalDegree + n := by omega
    change
      Module.finrank ℂ
          (affineTotalDegreeFilteredPiece
            (I ⊔ Ideal.span ({g} : Set (MvPolynomial ι ℂ)))
              (g.totalDegree + n)) +
        (if g.totalDegree ≤ g.totalDegree + n then
          Module.finrank ℂ
            (affineTotalDegreeFilteredPiece I
              (g.totalDegree + n - g.totalDegree)) else 0) ≤
          Module.finrank ℂ
            (affineTotalDegreeFilteredPiece I (g.totalDegree + n))
    rw [if_pos hle, hsub]
    exact affine_total_degree_filtered_regular_finrank_inequality
      I g hregular n
  · simp only [if_neg hm, add_zero]
    exact affine_total_degree_filtered_factor_finrank_le
      (show I ≤ I ⊔ Ideal.span ({g} : Set (MvPolynomial ι ℂ)) from
        le_sup_left) m

theorem affine_total_degree_cumulative_iterate_regular
    {ι : Type*} [Fintype ι]
    (I : ℕ → Ideal (MvPolynomial ι ℂ))
    (g : ℕ → MvPolynomial ι ℂ)
    (n : ℕ)
    (hzero : I 0 = ⊥)
    (hnext : ∀ i, i < n →
      I (i + 1) = I i ⊔ Ideal.span ({g i} : Set (MvPolynomial ι ℂ)))
    (hregular : ∀ i, i < n →
      IsSMulRegular (MvPolynomial ι ℂ ⧸ I i) (g i))
    (M : ℕ) :
    (affineCumulative^[n]) (affineTotalDegreeHilbert (I n)) M ≤
      (∏ i ∈ Finset.range n, (g i).totalDegree) *
        (M + Fintype.card ι).choose (Fintype.card ι) := by
  have hbound := affine_cumulative_iterate_le_degree_product
    (fun i => affineTotalDegreeHilbert (I i))
    (fun i => (g i).totalDegree) n
    (fun i _ => affine_total_degree_hilbert_mono (I i))
    (by
      intro i hi m
      rw [hnext i hi]
      exact affine_total_degree_hilbert_regular_step
        (I i) (g i) (hregular i hi) m)
    M
  have hbase :
      affineTotalDegreeHilbert (I 0) M =
        (M + Fintype.card ι).choose (Fintype.card ι) := by
    rw [hzero]
    exact affine_total_degree_filtered_bot_finrank M
  rwa [hbase] at hbound

theorem affine_finrank_le_degree_product_of_regular_prefix
    {ι : Type*} [Fintype ι]
    (I : ℕ → Ideal (MvPolynomial ι ℂ))
    (g : ℕ → MvPolynomial ι ℂ)
    (hzero : I 0 = ⊥)
    (hnext : ∀ i, i < Fintype.card ι →
      I (i + 1) = I i ⊔ Ideal.span ({g i} : Set (MvPolynomial ι ℂ)))
    (hregular : ∀ i, i < Fintype.card ι →
      IsSMulRegular (MvPolynomial ι ℂ ⧸ I i) (g i))
    [Module.Finite ℂ (MvPolynomial ι ℂ ⧸ I (Fintype.card ι))] :
    Module.finrank ℂ (MvPolynomial ι ℂ ⧸ I (Fintype.card ι)) ≤
      ∏ i ∈ Finset.range (Fintype.card ι), (g i).totalDegree := by
  let n := Fintype.card ι
  let L := Module.finrank ℂ (MvPolynomial ι ℂ ⧸ I n)
  let P := ∏ i ∈ Finset.range n, (g i).totalDegree
  obtain ⟨N, hN⟩ :=
    affine_total_degree_filtered_piece_eventual_finrank (I n)
  have heventual : ∀ m : ℕ, N ≤ m →
      affineTotalDegreeHilbert (I n) m = L := by
    intro m hm
    exact hN m hm
  change L ≤ P
  apply affine_le_of_shifted_choose_bounds L P n N
  intro m
  calc
    L * (m + n).choose n ≤
        (affineCumulative^[n])
          (affineTotalDegreeHilbert (I n)) (N + m) :=
      affine_cumulative_iterate_eventual_constant_lower
        (affineTotalDegreeHilbert (I n)) L N heventual n m
    _ ≤ P * (N + m + n).choose n := by
      exact affine_total_degree_cumulative_iterate_regular
        I g n hzero hnext hregular (N + m)
    _ = P * (m + N + n).choose n := by
      simp only [Nat.add_comm]

theorem affine_finrank_le_degree_product_of_weaklyRegular
    {ι : Type*} [Fintype ι]
    (f : Fin (Fintype.card ι) → MvPolynomial ι ℂ)
    (hweak : RingTheory.Sequence.IsWeaklyRegular
      (MvPolynomial ι ℂ) (List.ofFn f))
    (hfinite :
      (MvPolynomial.zeroLocus ℂ (Ideal.span (Set.range f))).Finite) :
    Module.finrank ℂ
        (MvPolynomial ι ℂ ⧸ Ideal.span (Set.range f)) ≤
      ∏ i, (f i).totalDegree := by
  classical
  let n := Fintype.card ι
  let s : List (MvPolynomial ι ℂ) := List.ofFn f
  let I : ℕ → Ideal (MvPolynomial ι ℂ) :=
    fun j => Ideal.ofList (s.take j)
  let g : ℕ → MvPolynomial ι ℂ :=
    fun j => if h : j < n then f ⟨j, h⟩ else 0
  have hIzero : I 0 = ⊥ := by
    simp only [List.take_zero, Ideal.ofList_nil, I]
  have hIn : I n = Ideal.span (Set.range f) := by
    change Ideal.ofList ((List.ofFn f).take (Fintype.card ι)) = _
    have htake :
        (List.ofFn f).take (Fintype.card ι) = List.ofFn f := by
      exact List.take_of_length_le (by simp only [List.length_ofFn, Std.le_refl])
    rw [htake]
    change Ideal.span {p : MvPolynomial ι ℂ | p ∈ List.ofFn f} =
      Ideal.span (Set.range f)
    congr 1
    ext p
    simp only [List.mem_ofFn, Set.mem_setOf_eq, Set.mem_range]
  have hInext : ∀ j, j < n →
      I (j + 1) = I j ⊔
        Ideal.span ({g j} : Set (MvPolynomial ι ℂ)) := by
    intro j hj
    dsimp [I]
    rw [List.take_succ_eq_append_getElem
      (show j < s.length by simpa only [List.length_ofFn, s, n] using hj)]
    rw [Ideal.ofList_append, Ideal.ofList_singleton]
    simp only [List.getElem_ofFn, hj, ↓reduceDIte, s, g]
  have hIregular : ∀ j, j < n →
      IsSMulRegular (MvPolynomial ι ℂ ⧸ I j) (g j) := by
    intro j hj
    have hprev := hweak.regular_mod_prev j
      (show j < (List.ofFn f).length by
        simpa only [List.length_ofFn, n] using hj)
    have hsub :
        Ideal.ofList ((List.ofFn f).take j) •
          (⊤ : Submodule (MvPolynomial ι ℂ) (MvPolynomial ι ℂ)) =
            (I j : Submodule (MvPolynomial ι ℂ)
              (MvPolynomial ι ℂ)) := by
      simp only [smul_eq_mul, Ideal.mul_top, I, s]
    apply ((Submodule.quotEquivOfEq _ _ hsub).isSMulRegular_congr
      (g j)).mp
    simpa [g, hj] using hprev
  letI : Module.Finite ℂ (MvPolynomial ι ℂ ⧸ I n) := by
    rw [hIn]
    exact finiteDimensional_quotient_of_zeroLocus_finite
      (Ideal.span (Set.range f)) hfinite
  have hbound := affine_finrank_le_degree_product_of_regular_prefix
    I g hIzero hInext hIregular
  have hproduct :
      (∏ j ∈ Finset.range n, (g j).totalDegree) =
        ∏ i, (f i).totalDegree := by
    calc
      (∏ j ∈ Finset.range n, (g j).totalDegree) =
          ∏ i : Fin n, (g i).totalDegree :=
        (Fin.prod_univ_eq_prod_range (fun j => (g j).totalDegree) n).symm
      _ = ∏ i : Fin n, (f i).totalDegree := by
        apply Finset.prod_congr rfl
        intro i _
        simp only [i.isLt, ↓reduceDIte, Fin.eta, g]
  rw [hIn, hproduct] at hbound
  exact hbound

theorem affine_isSMulRegular_sup_span_swap
    {R : Type*} [CommRing R]
    (I : Ideal R) (f ell : R)
    (hf : IsSMulRegular (R ⧸ I) f)
    (hell : IsSMulRegular (R ⧸
      (I ⊔ Ideal.span ({f} : Set R))) ell) :
    IsSMulRegular (R ⧸
      (I ⊔ Ideal.span ({ell} : Set R))) f := by
  classical
  apply (isSMulRegular_quotient_iff_mem_of_smul_mem
    (I ⊔ Ideal.span ({ell} : Set R)) f).mpr
  intro p hp
  have hfp : f * p ∈ I ⊔ Ideal.span ({ell} : Set R) := by
    simpa only [smul_eq_mul] using hp
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hfp
  obtain ⟨q, hq⟩ := Ideal.mem_span_singleton'.mp hb
  have hrel : f * p = a + ell * q := by
    calc
      f * p = a + b := hab.symm
      _ = a + ell * q := by rw [← hq]; ring
  have hellq : ell * q ∈ I ⊔ Ideal.span ({f} : Set R) := by
    have hrewrite : ell * q = f * p - a := by rw [hrel]; ring
    rw [hrewrite]
    apply (I ⊔ Ideal.span ({f} : Set R)).sub_mem
    · exact (I ⊔ Ideal.span ({f} : Set R)).mul_mem_right p
        (Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton f)))
    · exact Ideal.mem_sup_left ha
  have hqmem : q ∈ I ⊔ Ideal.span ({f} : Set R) := by
    apply (isSMulRegular_quotient_iff_mem_of_smul_mem
      (I ⊔ Ideal.span ({f} : Set R)) ell).mp hell
    simpa only [smul_eq_mul] using hellq
  obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp hqmem
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hv
  have hqdecomp : q = u + f * r := by
    calc
      q = u + v := huv.symm
      _ = u + f * r := by rw [← hr]; ring
  have hsmall : f * (p - ell * r) ∈ I := by
    have hrewrite : f * (p - ell * r) = a + ell * u := by
      calc
        f * (p - ell * r) = f * p - f * ell * r := by ring
        _ = a + ell * q - f * ell * r := by rw [hrel]
        _ = a + ell * u := by rw [hqdecomp]; ring
    rw [hrewrite]
    exact I.add_mem ha (I.mul_mem_left ell hu)
  have hpminus : p - ell * r ∈ I := by
    apply (isSMulRegular_quotient_iff_mem_of_smul_mem I f).mp hf
    simpa only [smul_eq_mul] using hsmall
  have hdecomp : p = (p - ell * r) + ell * r := by ring
  rw [hdecomp]
  apply (I ⊔ Ideal.span ({ell} : Set R)).add_mem
  · exact Ideal.mem_sup_left hpminus
  · apply Ideal.mem_sup_right
    exact (Ideal.span ({ell} : Set R)).mul_mem_right r
      (Ideal.subset_span (Set.mem_singleton ell))

noncomputable def affineGateGraphIdeal {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ) :
    Ideal (MvPolynomial (Fin k ⊕ Fin q) ℂ) :=
  Ideal.span (Set.range fun j : Fin q =>
    MvPolynomial.X (Sum.inr j) -
      MvPolynomial.rename Sum.inl (gate j))

noncomputable def affineGateGraphEvaluation {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ) :
    MvPolynomial (Fin k ⊕ Fin q) ℂ →ₐ[ℂ]
      MvPolynomial (Fin k) ℂ :=
  MvPolynomial.aeval (Sum.elim MvPolynomial.X gate)

theorem affineGateGraphEvaluation_kills {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (f : MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (hf : f ∈ affineGateGraphIdeal gate) :
    affineGateGraphEvaluation gate f = 0 := by
  rw [affineGateGraphIdeal, Ideal.mem_span_range_iff_exists_fun] at hf
  obtain ⟨coefficients, hcoefficients⟩ := hf
  rw [← hcoefficients, map_sum]
  apply Finset.sum_eq_zero
  intro j _
  rw [map_mul]
  have hgate : affineGateGraphEvaluation gate
      (MvPolynomial.X (Sum.inr j) -
        MvPolynomial.rename Sum.inl (gate j)) = 0 := by
    unfold affineGateGraphEvaluation
    rw [map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_rename]
    simp only [Sum.elim_inr, Function.comp_def, Sum.elim_inl, MvPolynomial.aeval_eq_bind₁,
      MvPolynomial.bind₁_X_left, AlgHom.coe_id, id_eq, sub_self]
  rw [hgate, mul_zero]

noncomputable def affineGateGraphToInput {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ) :
    (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸ affineGateGraphIdeal gate) →ₐ[ℂ]
      MvPolynomial (Fin k) ℂ :=
  Ideal.Quotient.liftₐ (affineGateGraphIdeal gate)
    (affineGateGraphEvaluation gate)
    (affineGateGraphEvaluation_kills gate)

noncomputable def affineGateGraphFromInput {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ) :
    MvPolynomial (Fin k) ℂ →ₐ[ℂ]
      (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸ affineGateGraphIdeal gate) :=
  (Ideal.Quotient.mkₐ ℂ (affineGateGraphIdeal gate)).comp
    (MvPolynomial.rename Sum.inl)

theorem affineGateGraph_mk_gate_eq {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ) (j : Fin q) :
    Ideal.Quotient.mk (affineGateGraphIdeal gate)
        (MvPolynomial.X (Sum.inr j)) =
      Ideal.Quotient.mk (affineGateGraphIdeal gate)
        (MvPolynomial.rename Sum.inl (gate j)) := by
  rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span ⟨j, rfl⟩

theorem affineGateGraphToInput_comp_fromInput {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ) :
    (affineGateGraphToInput gate).comp (affineGateGraphFromInput gate) =
      AlgHom.id ℂ (MvPolynomial (Fin k) ℂ) := by
  apply MvPolynomial.algHom_ext
  intro i
  change MvPolynomial.aeval (Sum.elim MvPolynomial.X gate)
      (MvPolynomial.rename Sum.inl (MvPolynomial.X i)) =
    MvPolynomial.X i
  simp only [MvPolynomial.aeval_eq_bind₁, MvPolynomial.rename_X, MvPolynomial.bind₁_X_right, Sum.elim_inl]

theorem affineGateGraphFromInput_comp_toInput {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ) :
    (affineGateGraphFromInput gate).comp (affineGateGraphToInput gate) =
      AlgHom.id ℂ
        (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸ affineGateGraphIdeal gate) := by
  apply Ideal.Quotient.algHom_ext
  simp only [AlgHom.comp_assoc, affineGateGraphToInput,
    Ideal.Quotient.liftₐ_comp, AlgHom.id_comp]
  apply MvPolynomial.algHom_ext
  intro i
  rcases i with i | j
  · simp only [affineGateGraphFromInput, affineGateGraphEvaluation, MvPolynomial.aeval_eq_bind₁, AlgHom.coe_comp,
      Ideal.Quotient.mkₐ_eq_mk, Function.comp_apply, MvPolynomial.bind₁_X_right, Sum.elim_inl, MvPolynomial.rename_X]
  · simpa only [affineGateGraphFromInput, affineGateGraphEvaluation, MvPolynomial.aeval_eq_bind₁, AlgHom.coe_comp,
      Ideal.Quotient.mkₐ_eq_mk, Function.comp_apply, MvPolynomial.bind₁_X_right, Sum.elim_inr] using
      (affineGateGraph_mk_gate_eq gate j).symm

noncomputable def affineGateGraphInputAlgEquiv {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ) :
    (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸ affineGateGraphIdeal gate) ≃ₐ[ℂ]
      MvPolynomial (Fin k) ℂ :=
  AlgEquiv.ofAlgHom (affineGateGraphToInput gate)
    (affineGateGraphFromInput gate)
    (affineGateGraphToInput_comp_fromInput gate)
    (affineGateGraphFromInput_comp_toInput gate)

noncomputable def affineGateRawOutputIdeal {k q : ℕ}
    (output : Fin k → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (target : Fin k → ℂ) :
    Ideal (MvPolynomial (Fin k ⊕ Fin q) ℂ) :=
  Ideal.span (Set.range fun i : Fin k =>
    output i - MvPolynomial.C (target i))

noncomputable def affineGateGraphOutputIdeal {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (output : Fin k → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (target : Fin k → ℂ) :
    Ideal (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸ affineGateGraphIdeal gate) :=
  (affineGateRawOutputIdeal output target).map
    (Ideal.Quotient.mkₐ ℂ (affineGateGraphIdeal gate))

theorem affineGateRawOutputIdeal_map_evaluation {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (output : Fin k → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ)
    (houtput : ∀ i, affineGateGraphEvaluation gate (output i) = F i) :
    (affineGateRawOutputIdeal output target).map
        (affineGateGraphEvaluation gate).toRingHom =
      homogeneousMapFiberIdeal F target := by
  classical
  rw [affineGateRawOutputIdeal, homogeneousMapFiberIdeal, Ideal.map_span]
  congr 1
  ext p
  constructor
  · rintro ⟨_, ⟨i, rfl⟩, rfl⟩
    refine ⟨i, ?_⟩
    simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_sub, houtput i, MvPolynomial.algHom_C,
      MvPolynomial.algebraMap_eq]
  · rintro ⟨i, rfl⟩
    refine ⟨_, ⟨i, rfl⟩, ?_⟩
    simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_sub, houtput i, MvPolynomial.algHom_C,
      MvPolynomial.algebraMap_eq]

theorem affineGateGraphOutputIdeal_map {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (output : Fin k → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ)
    (houtput : ∀ i, affineGateGraphEvaluation gate (output i) = F i) :
    (affineGateGraphOutputIdeal gate output target).map
        (affineGateGraphInputAlgEquiv gate :
          (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸ affineGateGraphIdeal gate) →+*
            MvPolynomial (Fin k) ℂ) =
      homogeneousMapFiberIdeal F target := by
  unfold affineGateGraphOutputIdeal
  calc
    ((affineGateRawOutputIdeal output target).map
      (Ideal.Quotient.mkₐ ℂ (affineGateGraphIdeal gate))).map
        (affineGateGraphInputAlgEquiv gate :
          (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸ affineGateGraphIdeal gate) →+*
            MvPolynomial (Fin k) ℂ) =
      (affineGateRawOutputIdeal output target).map
        ((affineGateGraphInputAlgEquiv gate :
          (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸ affineGateGraphIdeal gate) →+*
            MvPolynomial (Fin k) ℂ).comp
              (Ideal.Quotient.mk (affineGateGraphIdeal gate))) := by
                exact Ideal.map_map _ _
    _ = homogeneousMapFiberIdeal F target := by
      exact affineGateRawOutputIdeal_map_evaluation
        gate output F target houtput

noncomputable def affineGateGraphClosedFiberAlgEquiv {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (output : Fin k → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ)
    (houtput : ∀ i, affineGateGraphEvaluation gate (output i) = F i) :
    ((MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸ affineGateGraphIdeal gate) ⧸
      affineGateGraphOutputIdeal gate output target) ≃ₐ[ℂ]
        homogeneousMapClosedFiber F target :=
  Ideal.quotientEquivAlg
    (affineGateGraphOutputIdeal gate output target)
    (homogeneousMapFiberIdeal F target)
    (affineGateGraphInputAlgEquiv gate)
    (affineGateGraphOutputIdeal_map gate output F target houtput).symm

noncomputable def affineGateGraphTotalIdeal {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (output : Fin k → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (target : Fin k → ℂ) :
    Ideal (MvPolynomial (Fin k ⊕ Fin q) ℂ) :=
  affineGateGraphIdeal gate ⊔ affineGateRawOutputIdeal output target

noncomputable def affineGateGraphTotalClosedFiberAlgEquiv {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (output : Fin k → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ)
    (houtput : ∀ i, affineGateGraphEvaluation gate (output i) = F i) :
    (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸
      affineGateGraphTotalIdeal gate output target) ≃ₐ[ℂ]
        homogeneousMapClosedFiber F target := by
  unfold affineGateGraphTotalIdeal
  exact (DoubleQuot.quotQuotEquivQuotSupₐ ℂ
    (affineGateGraphIdeal gate)
    (affineGateRawOutputIdeal output target)).symm.trans
      (affineGateGraphClosedFiberAlgEquiv gate output F target houtput)

theorem homogeneousMap_allTarget_reesCoordinate_isWeaklyRegular
    {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ) (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    RingTheory.Sequence.IsWeaklyRegular
      (MvPolynomial (Fin (k + 1)) ℂ)
      (List.ofFn (homogeneousMapAllTargetReesCoordinate F target e)) := by
  apply homogeneousMap_allRank_homogeneous_fin_isWeaklyRegular_of_linear_quotient_aux
    (MvPolynomial.X (R := ℂ) (0 : Fin (k + 1)))
    (MvPolynomial.X_ne_zero (R := ℂ) (0 : Fin (k + 1)))
    (MvPolynomial.isHomogeneous_X ℂ 0)
    k (homogeneousMapAllTargetReesCoordinate F target e)
  · exact homogeneousMap_allTarget_reesCoordinate_isHomogeneous F target e hF
  · exact homogeneousMap_allTarget_reesCoordinate_quotient_isWeaklyRegular
      F target e he hF hzero

theorem homogeneousMap_allTarget_rees_prefix_parameter_isSMulRegular
    {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ) (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (j : ℕ) (hj : j ≤ k) :
    IsSMulRegular
      (MvPolynomial (Fin (k + 1)) ℂ ⧸
        Ideal.ofList
          ((List.ofFn
            (homogeneousMapAllTargetReesCoordinate F target e)).take j))
      (MvPolynomial.X (R := ℂ) (0 : Fin (k + 1))) := by
  classical
  let R := MvPolynomial (Fin (k + 1)) ℂ
  let z : R := MvPolynomial.X (0 : Fin (k + 1))
  let G : Fin k → R := homogeneousMapAllTargetReesCoordinate F target e
  let gp : Fin j → R :=
    fun i => G ⟨i.val, Nat.lt_of_lt_of_le i.isLt hj⟩
  let J : Ideal R := Ideal.span ({z} : Set R)
  have hmod : RingTheory.Sequence.IsWeaklyRegular (R ⧸ J)
      (List.ofFn fun i : Fin k => Ideal.Quotient.mk J (G i)) :=
    homogeneousMap_allTarget_reesCoordinate_quotient_isWeaklyRegular
      F target e he hF hzero
  have htake :
      List.ofFn (fun i : Fin j => Ideal.Quotient.mk J (gp i)) =
        (List.ofFn fun i : Fin k =>
          Ideal.Quotient.mk J (G i)).take j := by
    apply List.ext_getElem
    · simp only [List.length_ofFn, List.length_take, hj, inf_of_le_left]
    · intro i hleft hright
      simp only [List.getElem_ofFn, List.getElem_take, gp]
  have hprefix : RingTheory.Sequence.IsWeaklyRegular (R ⧸ J)
      (List.ofFn fun i : Fin j => Ideal.Quotient.mk J (gp i)) := by
    rw [htake]
    have hsplit :
        (List.ofFn fun i : Fin k => Ideal.Quotient.mk J (G i)) =
          (List.ofFn fun i : Fin k =>
            Ideal.Quotient.mk J (G i)).take j ++
          (List.ofFn fun i : Fin k =>
            Ideal.Quotient.mk J (G i)).drop j :=
      (List.take_append_drop j _).symm
    exact (RingTheory.Sequence.isWeaklyRegular_append_iff (R ⧸ J)
      ((List.ofFn fun i : Fin k => Ideal.Quotient.mk J (G i)).take j)
      ((List.ofFn fun i : Fin k => Ideal.Quotient.mk J (G i)).drop j)).mp
      (hsplit ▸ hmod) |>.1
  have hspan :
      Ideal.ofList ((List.ofFn G).take j) =
        Ideal.span (Set.range gp) := by
    have hGtake : List.ofFn gp = (List.ofFn G).take j := by
      apply List.ext_getElem
      · simp only [List.length_ofFn, List.length_take, hj, inf_of_le_left]
      · intro i hleft hright
        simp only [List.getElem_ofFn, List.getElem_take, gp]
    rw [← hGtake]
    change Ideal.span {x : R | x ∈ List.ofFn gp} =
      Ideal.span (Set.range gp)
    congr 1
    ext x
    simp only [List.mem_ofFn, Set.mem_setOf_eq, Set.mem_range]
  rw [hspan]
  exact homogeneousMap_allRank_fin_hyperplane_isSMulRegular_of_quotient_weaklyRegular
    gp z (MvPolynomial.X_ne_zero (R := ℂ) (0 : Fin (k + 1))) hprefix

theorem homogeneousMap_allTarget_rees_prefix_parameter_sub_isSMulRegular
    {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ) (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (j : ℕ) (hj : j ≤ k) (a : ℂ) :
    IsSMulRegular
      (MvPolynomial (Fin (k + 1)) ℂ ⧸
        Ideal.ofList
          ((List.ofFn
            (homogeneousMapAllTargetReesCoordinate F target e)).take j))
      (MvPolynomial.X (R := ℂ) (0 : Fin (k + 1)) -
        MvPolynomial.C a) := by
  apply homogeneousMap_allTarget_homogeneous_linear_sub_constant_isSMulRegular
    (Ideal.ofList
      ((List.ofFn
        (homogeneousMapAllTargetReesCoordinate F target e)).take j))
  · change
      (Ideal.span
        {p : MvPolynomial (Fin (k + 1)) ℂ |
          p ∈ (List.ofFn
            (homogeneousMapAllTargetReesCoordinate F target e)).take j}).IsHomogeneous _
    apply Ideal.homogeneous_span
    intro p hp
    have hpfull : p ∈
        List.ofFn (homogeneousMapAllTargetReesCoordinate F target e) :=
      List.mem_of_mem_take hp
    obtain ⟨i, rfl⟩ := (List.mem_ofFn.mp hpfull)
    exact ⟨e,
      homogeneousMap_allTarget_reesCoordinate_isHomogeneous F target e hF i⟩
  · exact MvPolynomial.isHomogeneous_X ℂ 0
  · exact homogeneousMap_allTarget_rees_prefix_parameter_isSMulRegular
      F target e he hF hzero j hj

theorem homogeneousMap_allTarget_rees_chartCoordinate_isWeaklyRegular
    {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ) (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    RingTheory.Sequence.IsWeaklyRegular
      (MvPolynomial (Fin (k + 1)) ℂ ⧸
        homogeneousMapAllTargetReesChartIdeal k (1 : ℂ))
      (List.ofFn fun i : Fin k =>
        Ideal.Quotient.mk
          (homogeneousMapAllTargetReesChartIdeal k (1 : ℂ))
          (homogeneousMapAllTargetReesCoordinate F target e i)) := by
  classical
  let R := MvPolynomial (Fin (k + 1)) ℂ
  let G : Fin k → R := homogeneousMapAllTargetReesCoordinate F target e
  let ell : R :=
    MvPolynomial.X (0 : Fin (k + 1)) - MvPolynomial.C (1 : ℂ)
  let J : Ideal R := Ideal.span ({ell} : Set R)
  let q : R →+* R ⧸ J := Ideal.Quotient.mk J
  have hG := homogeneousMap_allTarget_reesCoordinate_isWeaklyRegular
    F target e he hF hzero
  change RingTheory.Sequence.IsWeaklyRegular (R ⧸ J)
    (List.ofFn fun i : Fin k => q (G i))
  refine ⟨?_⟩
  intro j hjlist
  have hj : j < k := by
    simpa only [List.length_ofFn] using hjlist
  let idx : Fin k := ⟨j, hj⟩
  let I : Ideal R := Ideal.ofList ((List.ofFn G).take j)
  have hgreg : IsSMulRegular (R ⧸ I) (G idx) := by
    have hprev := hG.regular_mod_prev j (by
      simpa only [List.length_ofFn] using hj)
    have hsub :
        Ideal.ofList ((List.ofFn G).take j) •
          (⊤ : Submodule R R) = (I : Submodule R R) := by
      simp only [smul_eq_mul, Ideal.mul_top, I]
    apply ((Submodule.quotEquivOfEq _ _ hsub).isSMulRegular_congr
      (G idx)).mp
    simpa only [smul_eq_mul, List.getElem_ofFn] using hprev
  have hnext :
      I ⊔ Ideal.span ({G idx} : Set R) =
        Ideal.ofList ((List.ofFn G).take (j + 1)) := by
    change
      Ideal.ofList ((List.ofFn G).take j) ⊔
          Ideal.span ({G ⟨j, hj⟩} : Set R) =
        Ideal.ofList ((List.ofFn G).take (j + 1))
    exact
      PermanentCircuitCompatibility.ofList_take_succ
        G j hj
  have hell : IsSMulRegular
      (R ⧸ (I ⊔ Ideal.span ({G idx} : Set R))) ell := by
    rw [hnext]
    exact homogeneousMap_allTarget_rees_prefix_parameter_sub_isSMulRegular
      F target e he hF hzero (j + 1) (by omega) 1
  have hswap : IsSMulRegular
      (R ⧸ (I ⊔ Ideal.span ({ell} : Set R))) (G idx) :=
    affine_isSMulRegular_sup_span_swap I (G idx) ell hgreg hell
  have himage :
      Ideal.ofList
        ((List.ofFn fun i : Fin k => q (G i)).take j) = I.map q := by
    have hlist :
        (List.ofFn fun i : Fin k => q (G i)).take j =
          ((List.ofFn G).take j).map q := by
      simp only [List.map_take, List.map_ofFn, Function.comp_def]
    change
      Ideal.span
        {x : R ⧸ J |
          x ∈ (List.ofFn fun i : Fin k => q (G i)).take j} =
        (Ideal.span {x : R | x ∈ (List.ofFn G).take j}).map q
    rw [hlist, Ideal.map_span]
    congr 1
    ext x
    change
      x ∈ ((List.ofFn G).take j).map q ↔
        ∃ y, y ∈ (List.ofFn G).take j ∧ q y = x
    exact List.mem_map
  have hdouble : IsSMulRegular
      ((R ⧸ J) ⧸ I.map q) (q (G idx)) := by
    apply (isSMulRegular_quotient_iff_mem_of_smul_mem
      (I.map q) (q (G idx))).mpr
    intro p hp
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective p
    have hproduct : G idx * r ∈ I ⊔ J := by
      apply Ideal.mem_quotient_iff_mem_sup.mp
      simpa only [map_mul, smul_eq_mul] using hp
    have hr : r ∈ I ⊔ J := by
      apply (isSMulRegular_quotient_iff_mem_of_smul_mem
        (I ⊔ J) (G idx)).mp hswap r
      simpa only [smul_eq_mul] using hproduct
    exact Ideal.mem_quotient_iff_mem_sup.mpr hr
  have hsub :
      Ideal.ofList
          ((List.ofFn fun i : Fin k => q (G i)).take j) •
        (⊤ : Submodule (R ⧸ J) (R ⧸ J)) =
          (I.map q : Submodule (R ⧸ J) (R ⧸ J)) := by
    simp only [himage, smul_eq_mul, Ideal.mul_top]
  simpa only [smul_eq_mul, List.getElem_ofFn] using
    ((Submodule.quotEquivOfEq _ _ hsub).isSMulRegular_congr (q (G idx))).mpr hdouble

theorem homogeneousMap_allTarget_translated_isWeaklyRegular
    {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ) (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    RingTheory.Sequence.IsWeaklyRegular
      (MvPolynomial (Fin k) ℂ)
      (List.ofFn fun i : Fin k => F i - MvPolynomial.C (target i)) := by
  let E := homogeneousMapAllTargetReesChartHyperplaneEquiv k (1 : ℂ)
  have hchart := homogeneousMap_allTarget_rees_chartCoordinate_isWeaklyRegular
    F target e he hF hzero
  have himage :=
    (homogeneousMap_allRank_ringEquiv_isWeaklyRegular_iff_aux
      E.toRingEquiv
      (List.ofFn fun i : Fin k =>
        Ideal.Quotient.mk
          (homogeneousMapAllTargetReesChartIdeal k (1 : ℂ))
          (homogeneousMapAllTargetReesCoordinate F target e i))).mp hchart
  have hcoordinate (i : Fin k) :
      E.toRingEquiv (Ideal.Quotient.mk
        (homogeneousMapAllTargetReesChartIdeal k (1 : ℂ))
        (homogeneousMapAllTargetReesCoordinate F target e i)) =
          F i - MvPolynomial.C (target i) := by
    simpa only [RingEquiv.coe_mk, AlgEquiv.toEquiv_eq_coe, EquivLike.coe_coe, one_pow, mul_one] using
      homogeneousMap_allTarget_reesChartHyperplaneEquiv_coordinate F target e (1 : ℂ) i
  simpa only [List.map_ofFn, Function.comp_def, hcoordinate] using himage

noncomputable def affineGatePrefixGraphIdeal {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ) (n : ℕ) :
    Ideal (MvPolynomial (Fin k ⊕ Fin q) ℂ) :=
  Ideal.span (Set.range fun j : {j : Fin q // j.val < n} =>
    MvPolynomial.X (Sum.inr (j : Fin q)) -
      MvPolynomial.rename Sum.inl (gate j))

noncomputable def affineGatePrefixEvaluation {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ) (n : ℕ) :
    MvPolynomial (Fin k ⊕ Fin q) ℂ →ₐ[ℂ]
      MvPolynomial (Fin k ⊕ Fin q) ℂ :=
  MvPolynomial.aeval (Sum.elim
    (fun i : Fin k => MvPolynomial.X (Sum.inl i))
    (fun j : Fin q => if j.val < n then
      MvPolynomial.rename Sum.inl (gate j) else
      MvPolynomial.X (Sum.inr j)))

theorem affine_gate_prefix_graph_ideal_eq_ker {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ) (n : ℕ) :
    affineGatePrefixGraphIdeal gate n =
      RingHom.ker (affineGatePrefixEvaluation gate n).toRingHom := by
  classical
  apply le_antisymm
  · rw [affineGatePrefixGraphIdeal, Ideal.span_le]
    rintro _ ⟨⟨j, hj⟩, rfl⟩
    change affineGatePrefixEvaluation gate n
      (MvPolynomial.X (Sum.inr j) -
        MvPolynomial.rename Sum.inl (gate j)) = 0
    unfold affineGatePrefixEvaluation
    rw [map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_rename]
    simp only [Sum.elim_inr, if_pos hj]
    have hinput :
        ((Sum.elim
          (fun i : Fin k => MvPolynomial.X (Sum.inl i))
          (fun j : Fin q => if j.val < n then
            MvPolynomial.rename Sum.inl (gate j) else
            MvPolynomial.X (Sum.inr j))) ∘ Sum.inl) =
          (fun i : Fin k => MvPolynomial.X (Sum.inl i)) := by
      funext i
      rfl
    rw [hinput]
    have hrename :
        MvPolynomial.rename (Sum.inl : Fin k → Fin k ⊕ Fin q) (gate j) =
          MvPolynomial.aeval
            (fun i : Fin k => MvPolynomial.X (Sum.inl i)) (gate j) := by
      simpa only [MvPolynomial.aeval_eq_bind₁, Function.comp_def] using
        DFunLike.congr_fun (MvPolynomial.rename_eq_aeval (R := ℂ) (Sum.inl : Fin k → Fin k ⊕ Fin q)) (gate j)
    rw [← hrename, sub_self]
  · intro p hp
    let I := affineGatePrefixGraphIdeal gate n
    let φ : MvPolynomial (Fin k ⊕ Fin q) ℂ →+*
        (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸ I) :=
      Ideal.Quotient.mk I
    let ψ : MvPolynomial (Fin k ⊕ Fin q) ℂ →+*
        (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸ I) :=
      φ.comp (affineGatePrefixEvaluation gate n).toRingHom
    have hC : φ.comp MvPolynomial.C = ψ.comp MvPolynomial.C := by
      ext c
      simp only [RingHom.coe_comp, Function.comp_apply, affineGatePrefixEvaluation, MvPolynomial.aeval_eq_bind₁,
        AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.algHom_C, MvPolynomial.algebraMap_eq, φ, ψ]
    have heq : φ p = ψ p := by
      apply MvPolynomial.hom_congr_vars hC (p₁ := p) (p₂ := p)
        (hp := rfl)
      intro v _ _
      rcases v with i | j
      · simp only [affineGatePrefixEvaluation, MvPolynomial.aeval_eq_bind₁, AlgHom.toRingHom_eq_coe, RingHom.coe_comp,
          RingHom.coe_coe, Function.comp_apply, MvPolynomial.bind₁_X_right, Sum.elim_inl, φ, ψ]
      · by_cases hj : j.val < n
        · have hmem : MvPolynomial.X (Sum.inr j) -
              MvPolynomial.rename Sum.inl (gate j) ∈ I :=
            Ideal.subset_span ⟨⟨j, hj⟩, rfl⟩
          have hquot :
              Ideal.Quotient.mk I (MvPolynomial.X (Sum.inr j)) =
                Ideal.Quotient.mk I
                  (MvPolynomial.rename Sum.inl (gate j)) := by
            rw [← sub_eq_zero, ← map_sub,
              Ideal.Quotient.eq_zero_iff_mem]
            exact hmem
          simpa [φ, ψ, affineGatePrefixEvaluation, hj]
            using hquot
        · simp only [affineGatePrefixEvaluation, MvPolynomial.aeval_eq_bind₁, AlgHom.toRingHom_eq_coe, RingHom.coe_comp,
            RingHom.coe_coe, Function.comp_apply, MvPolynomial.bind₁_X_right, Sum.elim_inr, hj, ↓reduceIte, φ, ψ]
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change φ p = 0
    rw [heq]
    change φ (affineGatePrefixEvaluation gate n p) = 0
    change affineGatePrefixEvaluation gate n p = 0 at hp
    rw [hp, map_zero]

theorem affine_gate_prefix_graph_ideal_isPrime {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ) (n : ℕ) :
    (affineGatePrefixGraphIdeal gate n).IsPrime := by
  rw [affine_gate_prefix_graph_ideal_eq_ker gate n]
  exact RingHom.ker_isPrime
    (affineGatePrefixEvaluation gate n).toRingHom

theorem affine_gate_graph_equation_ne_zero {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ) (j : Fin q) :
    MvPolynomial.X (Sum.inr j) -
      MvPolynomial.rename Sum.inl (gate j) ≠ 0 := by
  intro h
  have heq : (MvPolynomial.X (Sum.inr j) :
      MvPolynomial (Fin k ⊕ Fin q) ℂ) =
      MvPolynomial.rename Sum.inl (gate j) := sub_eq_zero.mp h
  have hvar : Sum.inr j ∈
      (MvPolynomial.rename Sum.inl (gate j)).vars := by
    rw [← heq]
    simp only [MvPolynomial.vars_X, Finset.mem_singleton]
  obtain ⟨i, _, hi⟩ := MvPolynomial.mem_vars_rename
    Sum.inl (gate j) hvar
  cases hi

theorem affine_gate_prefix_evaluation_eq_graph_of_previous
    {k q : ℕ} (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (n : ℕ) (p : MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (hprevious : ∀ i : Fin q, Sum.inr i ∈ p.vars → i.val < n) :
    affineGatePrefixEvaluation gate n p =
      MvPolynomial.rename Sum.inl (affineGateGraphEvaluation gate p) := by
  classical
  let φ : MvPolynomial (Fin k ⊕ Fin q) ℂ →+*
      MvPolynomial (Fin k ⊕ Fin q) ℂ :=
    (affineGatePrefixEvaluation gate n).toRingHom
  let ψ : MvPolynomial (Fin k ⊕ Fin q) ℂ →+*
      MvPolynomial (Fin k ⊕ Fin q) ℂ :=
    ((MvPolynomial.rename Sum.inl).comp
      (affineGateGraphEvaluation gate)).toRingHom
  have hC : φ.comp MvPolynomial.C = ψ.comp MvPolynomial.C := by
    ext c
    simp only [AlgHom.toRingHom_eq_coe, affineGatePrefixEvaluation, MvPolynomial.aeval_eq_bind₁, RingHom.coe_comp,
      RingHom.coe_coe, Function.comp_apply, MvPolynomial.algHom_C, MvPolynomial.algebraMap_eq, MvPolynomial.coeff_C,
      affineGateGraphEvaluation, AlgHom.coe_comp, φ, ψ]
  change φ p = ψ p
  apply MvPolynomial.hom_congr_vars hC (p₁ := p) (p₂ := p)
    (hp := rfl)
  intro v hv _
  rcases v with i | i
  · simp only [AlgHom.toRingHom_eq_coe, affineGatePrefixEvaluation, MvPolynomial.aeval_eq_bind₁, RingHom.coe_coe,
      MvPolynomial.bind₁_X_right, Sum.elim_inl, affineGateGraphEvaluation, AlgHom.coe_comp, Function.comp_apply,
      MvPolynomial.rename_X, φ, ψ]
  · have hi : i.val < n := hprevious i hv
    simp only [AlgHom.toRingHom_eq_coe, affineGatePrefixEvaluation, MvPolynomial.aeval_eq_bind₁, RingHom.coe_coe,
      MvPolynomial.bind₁_X_right, Sum.elim_inr, hi, ↓reduceIte, affineGateGraphEvaluation, AlgHom.coe_comp,
      Function.comp_apply, φ, ψ]

theorem affine_gate_prefix_evaluation_instruction_eq_graph
    {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (j : Fin q)
    (hprevious : ∀ i : Fin q,
      Sum.inr i ∈ (rhs j).vars → i.val < j.val)
    (hgate : gate j = affineGateGraphEvaluation gate (rhs j)) :
    affineGatePrefixEvaluation gate j.val
        (MvPolynomial.X (Sum.inr j) - rhs j) =
      MvPolynomial.X (Sum.inr j) -
        MvPolynomial.rename Sum.inl (gate j) := by
  rw [map_sub,
    affine_gate_prefix_evaluation_eq_graph_of_previous
      gate j.val (rhs j) hprevious]
  have hX : affineGatePrefixEvaluation gate j.val
      (MvPolynomial.X (Sum.inr j)) =
        MvPolynomial.X (Sum.inr j) := by
    simp only [affineGatePrefixEvaluation, Fin.val_fin_lt, MvPolynomial.aeval_eq_bind₁,
      MvPolynomial.bind₁_X_right, Sum.elim_inr, lt_self_iff_false, ↓reduceIte]
  rw [hX, ← hgate]

theorem affine_instruction_not_mem_prefix_graph
    {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (j : Fin q)
    (hprevious : ∀ i : Fin q,
      Sum.inr i ∈ (rhs j).vars → i.val < j.val)
    (hgate : gate j = affineGateGraphEvaluation gate (rhs j)) :
    MvPolynomial.X (Sum.inr j) - rhs j ∉
      affineGatePrefixGraphIdeal gate j.val := by
  intro hmem
  rw [affine_gate_prefix_graph_ideal_eq_ker] at hmem
  change affineGatePrefixEvaluation gate j.val
    (MvPolynomial.X (Sum.inr j) - rhs j) = 0 at hmem
  rw [affine_gate_prefix_evaluation_instruction_eq_graph
    gate rhs j hprevious hgate] at hmem
  exact affine_gate_graph_equation_ne_zero gate j hmem

theorem affine_instruction_isSMulRegular_mod_prefix_graph
    {k q : ℕ}
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (j : Fin q)
    (hprevious : ∀ i : Fin q,
      Sum.inr i ∈ (rhs j).vars → i.val < j.val)
    (hgate : gate j = affineGateGraphEvaluation gate (rhs j)) :
    IsSMulRegular
      (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸
        affineGatePrefixGraphIdeal gate j.val)
      (MvPolynomial.X (Sum.inr j) - rhs j) := by
  let I := affineGatePrefixGraphIdeal gate j.val
  have hprime : I.IsPrime :=
    affine_gate_prefix_graph_ideal_isPrime gate j.val
  have hnot : MvPolynomial.X (Sum.inr j) - rhs j ∉ I :=
    affine_instruction_not_mem_prefix_graph
      gate rhs j hprevious hgate
  apply (isSMulRegular_quotient_iff_mem_of_smul_mem
    I (MvPolynomial.X (Sum.inr j) - rhs j)).mpr
  intro p hp
  rw [smul_eq_mul] at hp
  exact (hprime.mem_or_mem hp).resolve_left hnot

noncomputable def affineTriangularInstructionPrefixIdeal {k q : ℕ}
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ) (n : ℕ) :
    Ideal (MvPolynomial (Fin k ⊕ Fin q) ℂ) :=
  Ideal.span (Set.range fun j : {j : Fin q // j.val < n} =>
    MvPolynomial.X (Sum.inr (j : Fin q)) - rhs j)

theorem affine_triangular_instruction_prefix_ideal_eq_graph
    {k q : ℕ}
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (hgate : ∀ j, gate j = affineGateGraphEvaluation gate (rhs j))
    (htop : ∀ j i : Fin q,
      Sum.inr i ∈ (rhs j).vars → i.val < j.val)
    (n : ℕ) :
    affineTriangularInstructionPrefixIdeal rhs n =
      affineGatePrefixGraphIdeal gate n := by
  classical
  let I := affineTriangularInstructionPrefixIdeal rhs n
  have hgraph : ∀ m : ℕ, ∀ j : Fin q, j.val = m → j.val < n →
      MvPolynomial.X (Sum.inr j) -
        MvPolynomial.rename Sum.inl (gate j) ∈ I := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
      intro j hj hjn
      let φ : MvPolynomial (Fin k ⊕ Fin q) ℂ →+*
          (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸ I) :=
        Ideal.Quotient.mk I
      let ψ : MvPolynomial (Fin k ⊕ Fin q) ℂ →+*
          (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸ I) :=
        ((Ideal.Quotient.mkₐ ℂ I).comp
          ((MvPolynomial.rename Sum.inl).comp
            (affineGateGraphEvaluation gate))).toRingHom
      have hC : φ.comp MvPolynomial.C = ψ.comp MvPolynomial.C := by
        ext c
        simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe, affineGateGraphEvaluation,
          MvPolynomial.aeval_eq_bind₁, RingHom.coe_coe, AlgHom.coe_comp, Ideal.Quotient.mkₐ_eq_mk, MvPolynomial.algHom_C,
          MvPolynomial.algebraMap_eq, φ, ψ]
      have hprevious (p : MvPolynomial (Fin k ⊕ Fin q) ℂ)
          (hp : ∀ i : Fin q, Sum.inr i ∈ p.vars → i.val < j.val) :
          φ p = ψ p := by
        apply MvPolynomial.hom_congr_vars hC (p₁ := p) (p₂ := p)
          (hp := rfl)
        intro v hv _
        rcases v with i | i
        · simp only [AlgHom.toRingHom_eq_coe, affineGateGraphEvaluation, MvPolynomial.aeval_eq_bind₁, RingHom.coe_coe,
            AlgHom.coe_comp, Ideal.Quotient.mkₐ_eq_mk, Function.comp_apply, MvPolynomial.bind₁_X_right, Sum.elim_inl,
            MvPolynomial.rename_X, φ, ψ]
        · have him : i.val < m := hj ▸ hp i hv
          have hin : i.val < n := (hp i hv).trans hjn
          have himem := ih i.val him i rfl hin
          have hieq :
              Ideal.Quotient.mk I (MvPolynomial.X (Sum.inr i)) =
                Ideal.Quotient.mk I
                  (MvPolynomial.rename Sum.inl (gate i)) := by
            rw [← sub_eq_zero, ← map_sub,
              Ideal.Quotient.eq_zero_iff_mem]
            exact himem
          simpa [φ, ψ, affineGateGraphEvaluation] using hieq
      have hprimitive :
          MvPolynomial.X (Sum.inr j) - rhs j ∈ I :=
        Ideal.subset_span ⟨⟨j, hjn⟩, rfl⟩
      have heq :
          Ideal.Quotient.mk I (MvPolynomial.X (Sum.inr j)) =
            Ideal.Quotient.mk I
              (MvPolynomial.rename Sum.inl (gate j)) := by
        calc
          Ideal.Quotient.mk I (MvPolynomial.X (Sum.inr j)) =
              Ideal.Quotient.mk I (rhs j) := by
                rw [← sub_eq_zero, ← map_sub,
                  Ideal.Quotient.eq_zero_iff_mem]
                exact hprimitive
          _ = φ (rhs j) := rfl
          _ = ψ (rhs j) := hprevious (rhs j) (htop j)
          _ = Ideal.Quotient.mk I
                (MvPolynomial.rename Sum.inl (gate j)) := by
                simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.coe_comp, Ideal.Quotient.mkₐ_eq_mk,
                  Function.comp_apply, hgate j, ψ]
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
      exact heq
  apply le_antisymm
  · rw [affineTriangularInstructionPrefixIdeal, Ideal.span_le,
      affine_gate_prefix_graph_ideal_eq_ker]
    rintro _ ⟨⟨j, hj⟩, rfl⟩
    change affineGatePrefixEvaluation gate n
      (MvPolynomial.X (Sum.inr j) - rhs j) = 0
    rw [map_sub,
      affine_gate_prefix_evaluation_eq_graph_of_previous
        gate n (rhs j) (fun i hi => (htop j i hi).trans hj)]
    have hX : affineGatePrefixEvaluation gate n
        (MvPolynomial.X (Sum.inr j)) =
          MvPolynomial.rename Sum.inl (gate j) := by
      simp only [affineGatePrefixEvaluation, MvPolynomial.aeval_eq_bind₁, MvPolynomial.bind₁_X_right, Sum.elim_inr,
        hj, ↓reduceIte]
    rw [hX, ← hgate j, sub_self]
  · rw [affineGatePrefixGraphIdeal, Ideal.span_le]
    rintro _ ⟨⟨j, hj⟩, rfl⟩
    exact hgraph j.val j rfl hj

theorem affine_triangular_instruction_prefix_ideal_ofList
    {k q : ℕ}
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ) (n : ℕ) :
    Ideal.ofList
        ((List.ofFn fun j : Fin q =>
          MvPolynomial.X (Sum.inr j) - rhs j).take n) =
      affineTriangularInstructionPrefixIdeal rhs n := by
  classical
  change Ideal.span
      {p | p ∈ (List.ofFn fun j : Fin q =>
        MvPolynomial.X (Sum.inr j) - rhs j).take n} =
    Ideal.span (Set.range fun j : {j : Fin q // j.val < n} =>
      MvPolynomial.X (Sum.inr (j : Fin q)) - rhs j)
  congr 1
  ext p
  constructor
  · intro hp
    obtain ⟨i, hi, heq⟩ := List.mem_take_iff_getElem.mp hp
    have hiq : i < q := by
      simpa only [List.length_ofFn] using
        (lt_of_lt_of_le hi (Nat.min_le_right _ _))
    have hin : i < n :=
      lt_of_lt_of_le hi (Nat.min_le_left _ _)
    refine ⟨⟨⟨i, hiq⟩, hin⟩, ?_⟩
    simpa only [List.getElem_ofFn] using heq
  · rintro ⟨⟨i, hi⟩, rfl⟩
    apply List.mem_take_iff_getElem.mpr
    refine ⟨i.val, ?_, ?_⟩
    · simpa only [List.length_ofFn] using (lt_min hi i.isLt)
    · simp only [List.getElem_ofFn, Fin.eta]

theorem affine_triangular_instructions_isWeaklyRegular
    {k q : ℕ}
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (hgate : ∀ j, gate j = affineGateGraphEvaluation gate (rhs j))
    (htop : ∀ j i : Fin q,
      Sum.inr i ∈ (rhs j).vars → i.val < j.val) :
    RingTheory.Sequence.IsWeaklyRegular
      (MvPolynomial (Fin k ⊕ Fin q) ℂ)
      (List.ofFn fun j : Fin q =>
        MvPolynomial.X (Sum.inr j) - rhs j) := by
  classical
  constructor
  intro n hn
  have hnq : n < q := by
    simpa only [List.length_ofFn] using hn
  let j : Fin q := ⟨n, hnq⟩
  let R := MvPolynomial (Fin k ⊕ Fin q) ℂ
  let I := affineGatePrefixGraphIdeal gate n
  have hsub :
      (Ideal.ofList
        ((List.ofFn fun i : Fin q =>
          MvPolynomial.X (Sum.inr i) - rhs i).take n) •
          (⊤ : Submodule R R)) = (I : Submodule R R) := by
    rw [affine_triangular_instruction_prefix_ideal_ofList rhs n,
      affine_triangular_instruction_prefix_ideal_eq_graph
        rhs gate hgate htop n]
    simp only [smul_eq_mul, Ideal.mul_top, I]
  have hreg : IsSMulRegular (R ⧸ I)
      (MvPolynomial.X (Sum.inr j) - rhs j) :=
    affine_instruction_isSMulRegular_mod_prefix_graph
      gate rhs j (htop j) (hgate j)
  have htransport :=
    ((Submodule.quotEquivOfEq _ _ hsub).isSMulRegular_congr
      (MvPolynomial.X (Sum.inr j) - rhs j)).mpr hreg
  simpa only [List.getElem_ofFn] using htransport

noncomputable def affineTriangularInstructionIdeal {k q : ℕ}
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ) :
    Ideal (MvPolynomial (Fin k ⊕ Fin q) ℂ) :=
  Ideal.span (Set.range fun j : Fin q =>
    MvPolynomial.X (Sum.inr j) - rhs j)

theorem affine_triangular_instruction_ideal_eq_graph
    {k q : ℕ}
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (hgate : ∀ j, gate j = affineGateGraphEvaluation gate (rhs j))
    (htop : ∀ j i : Fin q,
      Sum.inr i ∈ (rhs j).vars → i.val < j.val) :
    affineTriangularInstructionIdeal rhs = affineGateGraphIdeal gate := by
  classical
  have hinstruction :
      affineTriangularInstructionPrefixIdeal rhs q =
        affineTriangularInstructionIdeal rhs := by
    unfold affineTriangularInstructionPrefixIdeal
      affineTriangularInstructionIdeal
    congr 1
    ext p
    simp only [Set.mem_range, Subtype.exists, Fin.is_lt, exists_const]
  have hgraph : affineGatePrefixGraphIdeal gate q =
      affineGateGraphIdeal gate := by
    unfold affineGatePrefixGraphIdeal affineGateGraphIdeal
    congr 1
    ext p
    simp only [Set.mem_range, Subtype.exists, Fin.is_lt, exists_const]
  calc
    affineTriangularInstructionIdeal rhs =
        affineTriangularInstructionPrefixIdeal rhs q := hinstruction.symm
    _ = affineGatePrefixGraphIdeal gate q :=
      affine_triangular_instruction_prefix_ideal_eq_graph
        rhs gate hgate htop q
    _ = affineGateGraphIdeal gate := hgraph

noncomputable def affineTriangularInstructionInputAlgEquiv
    {k q : ℕ}
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (hgate : ∀ j, gate j = affineGateGraphEvaluation gate (rhs j))
    (htop : ∀ j i : Fin q,
      Sum.inr i ∈ (rhs j).vars → i.val < j.val) :
    (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸
      affineTriangularInstructionIdeal rhs) ≃ₐ[ℂ]
        MvPolynomial (Fin k) ℂ :=
  (Ideal.quotientEquivAlgOfEq ℂ
    (affine_triangular_instruction_ideal_eq_graph
      rhs gate hgate htop)).trans
        (affineGateGraphInputAlgEquiv gate)

theorem affineTriangularInstructionInputAlgEquiv_mk
    {k q : ℕ}
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (hgate : ∀ j, gate j = affineGateGraphEvaluation gate (rhs j))
    (htop : ∀ j i : Fin q,
      Sum.inr i ∈ (rhs j).vars → i.val < j.val)
    (p : MvPolynomial (Fin k ⊕ Fin q) ℂ) :
    affineTriangularInstructionInputAlgEquiv rhs gate hgate htop
      (Ideal.Quotient.mk (affineTriangularInstructionIdeal rhs) p) =
        affineGateGraphEvaluation gate p := by
  rw [affineTriangularInstructionInputAlgEquiv, AlgEquiv.trans_apply,
    Ideal.quotientEquivAlgOfEq_mk]
  rfl

theorem affine_triangular_instruction_output_isWeaklyRegular
    {k q : ℕ}
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (output : Fin k → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ)
    (hgate : ∀ j, gate j = affineGateGraphEvaluation gate (rhs j))
    (htop : ∀ j i : Fin q,
      Sum.inr i ∈ (rhs j).vars → i.val < j.val)
    (houtput : ∀ i, affineGateGraphEvaluation gate (output i) = F i)
    (hregular : RingTheory.Sequence.IsWeaklyRegular
      (MvPolynomial (Fin k) ℂ)
        (List.ofFn fun i : Fin k => F i - MvPolynomial.C (target i))) :
    RingTheory.Sequence.IsWeaklyRegular
      (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸
        affineTriangularInstructionIdeal rhs)
      (List.ofFn fun i : Fin k =>
        Ideal.Quotient.mk (affineTriangularInstructionIdeal rhs)
          (output i - MvPolynomial.C (target i))) := by
  let E := affineTriangularInstructionInputAlgEquiv
    rhs gate hgate htop
  apply homogeneousMap_allRank_ringEquiv_isWeaklyRegular_ofFn_image
    E.toRingEquiv
  have himage : ∀ i : Fin k,
      E (Ideal.Quotient.mk (affineTriangularInstructionIdeal rhs)
        (output i - MvPolynomial.C (target i))) =
          F i - MvPolynomial.C (target i) := by
    intro i
    change affineTriangularInstructionInputAlgEquiv
      rhs gate hgate htop
        (Ideal.Quotient.mk (affineTriangularInstructionIdeal rhs)
          (output i - MvPolynomial.C (target i))) = _
    rw [affineTriangularInstructionInputAlgEquiv_mk]
    simp only [map_sub, houtput i, MvPolynomial.algHom_C, MvPolynomial.algebraMap_eq]
  have hfun :
      (fun i : Fin k =>
        E.toRingEquiv
          (Ideal.Quotient.mk (affineTriangularInstructionIdeal rhs)
            (output i - MvPolynomial.C (target i)))) =
        (fun i : Fin k => F i - MvPolynomial.C (target i)) := by
    funext i
    exact himage i
  rw [hfun]
  exact hregular

theorem affine_triangular_instruction_output_equations_isWeaklyRegular
    {k q : ℕ}
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (output : Fin k → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ)
    (hgate : ∀ j, gate j = affineGateGraphEvaluation gate (rhs j))
    (htop : ∀ j i : Fin q,
      Sum.inr i ∈ (rhs j).vars → i.val < j.val)
    (houtput : ∀ i, affineGateGraphEvaluation gate (output i) = F i)
    (hregular : RingTheory.Sequence.IsWeaklyRegular
      (MvPolynomial (Fin k) ℂ)
        (List.ofFn fun i : Fin k => F i - MvPolynomial.C (target i))) :
    RingTheory.Sequence.IsWeaklyRegular
      (MvPolynomial (Fin k ⊕ Fin q) ℂ)
      ((List.ofFn fun j : Fin q =>
          MvPolynomial.X (Sum.inr j) - rhs j) ++
        (List.ofFn fun i : Fin k =>
          output i - MvPolynomial.C (target i))) := by
  classical
  let R := MvPolynomial (Fin k ⊕ Fin q) ℂ
  let I := affineTriangularInstructionIdeal rhs
  let gates : List R := List.ofFn fun j : Fin q =>
    MvPolynomial.X (Sum.inr j) - rhs j
  let outputs : List R := List.ofFn fun i : Fin k =>
    output i - MvPolynomial.C (target i)
  have hgateweak : RingTheory.Sequence.IsWeaklyRegular R gates :=
    affine_triangular_instructions_isWeaklyRegular
      rhs gate hgate htop
  have hlist : Ideal.ofList gates = I := by
    change Ideal.span {p | p ∈ List.ofFn fun j : Fin q =>
      MvPolynomial.X (Sum.inr j) - rhs j} =
      Ideal.span (Set.range fun j : Fin q =>
        MvPolynomial.X (Sum.inr j) - rhs j)
    congr 1
    ext p
    simp only [List.mem_ofFn, Set.mem_setOf_eq, Set.mem_range]
  have hsub :
      (Ideal.ofList gates • (⊤ : Submodule R R)) =
        (I : Submodule R R) := by
    rw [hlist]
    simp only [smul_eq_mul, Ideal.mul_top]
  have houtputquot :
      RingTheory.Sequence.IsWeaklyRegular (R ⧸ I)
        (List.ofFn fun i : Fin k =>
          Ideal.Quotient.mk I
            (output i - MvPolynomial.C (target i))) :=
    affine_triangular_instruction_output_isWeaklyRegular
      rhs gate output F target hgate htop houtput hregular
  have houtputmap :
      RingTheory.Sequence.IsWeaklyRegular (R ⧸ I)
        (outputs.map (algebraMap R (R ⧸ I))) := by
    dsimp only [outputs]
    rw [← List.ofFn_comp']
    change RingTheory.Sequence.IsWeaklyRegular (R ⧸ I)
      (List.ofFn fun i : Fin k =>
        Ideal.Quotient.mk I
          (output i - MvPolynomial.C (target i)))
    exact houtputquot
  have houtputR :
      RingTheory.Sequence.IsWeaklyRegular (R ⧸ I) outputs :=
    (RingTheory.Sequence.isWeaklyRegular_map_algebraMap_iff
      (R ⧸ I) (R ⧸ I) outputs).mp houtputmap
  change RingTheory.Sequence.IsWeaklyRegular R (gates ++ outputs)
  rw [RingTheory.Sequence.isWeaklyRegular_append_iff]
  refine ⟨hgateweak, ?_⟩
  exact ((Submodule.quotEquivOfEq _ _ hsub).isWeaklyRegular_congr
    outputs).mpr houtputR

noncomputable def affineTriangularInstructionOutputClosedFiberAlgEquiv
    {k q : ℕ}
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (output : Fin k → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ)
    (hgate : ∀ j, gate j = affineGateGraphEvaluation gate (rhs j))
    (htop : ∀ j i : Fin q,
      Sum.inr i ∈ (rhs j).vars → i.val < j.val)
    (houtput : ∀ i, affineGateGraphEvaluation gate (output i) = F i) :
    (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸
      (affineTriangularInstructionIdeal rhs ⊔
        affineGateRawOutputIdeal output target)) ≃ₐ[ℂ]
      homogeneousMapClosedFiber F target := by
  have hideal :
      affineTriangularInstructionIdeal rhs ⊔
          affineGateRawOutputIdeal output target =
        affineGateGraphTotalIdeal gate output target := by
    unfold affineGateGraphTotalIdeal
    rw [affine_triangular_instruction_ideal_eq_graph
      rhs gate hgate htop]
  exact (Ideal.quotientEquivAlgOfEq ℂ hideal).trans
    (affineGateGraphTotalClosedFiberAlgEquiv
      gate output F target houtput)

theorem affineTriangularInstructionOutputClosedFiber_finrank
    {k q : ℕ}
    (rhs : Fin q → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (gate : Fin q → MvPolynomial (Fin k) ℂ)
    (output : Fin k → MvPolynomial (Fin k ⊕ Fin q) ℂ)
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (target : Fin k → ℂ)
    (hgate : ∀ j, gate j = affineGateGraphEvaluation gate (rhs j))
    (htop : ∀ j i : Fin q,
      Sum.inr i ∈ (rhs j).vars → i.val < j.val)
    (houtput : ∀ i, affineGateGraphEvaluation gate (output i) = F i) :
    Module.finrank ℂ
      (MvPolynomial (Fin k ⊕ Fin q) ℂ ⧸
        (affineTriangularInstructionIdeal rhs ⊔
          affineGateRawOutputIdeal output target)) = e ^ k := by
  let E := affineTriangularInstructionOutputClosedFiberAlgEquiv
    rhs gate output F target hgate htop houtput
  exact E.toLinearEquiv.finrank_eq.trans
    (homogeneousMap_closedFiber_finrank k F e he hF hzero target)

theorem affine_zeroLocus_finite_of_moduleFinite_quotient
    {ι : Type*}
    (I : Ideal (MvPolynomial ι ℂ))
    (hfinite : Module.Finite ℂ (MvPolynomial ι ℂ ⧸ I)) :
    (MvPolynomial.zeroLocus ℂ I).Finite := by
  classical
  let A := MvPolynomial ι ℂ ⧸ I
  let Z := {x : ι → ℂ // x ∈ MvPolynomial.zeroLocus ℂ I}
  letI : Module.Finite ℂ A := hfinite
  letI : IsArtinianRing A := IsArtinianRing.of_finite ℂ A
  let pointEval (x : Z) : A →ₐ[ℂ] ℂ :=
    Ideal.Quotient.liftₐ I (MvPolynomial.aeval (x : ι → ℂ))
      (fun p hp => (MvPolynomial.mem_zeroLocus_iff.mp x.property) p hp)
  have hsurj (x : Z) : Function.Surjective (pointEval x) := by
    intro c
    refine ⟨algebraMap ℂ A c, ?_⟩
    exact (pointEval x).commutes c
  let pointIdeal (x : Z) : MaximalSpectrum A :=
    ⟨RingHom.ker (pointEval x).toRingHom,
      RingHom.ker_isMaximal_of_surjective
        (pointEval x).toRingHom (hsurj x)⟩
  have hinj : Function.Injective pointIdeal := by
    intro x y hxy
    apply Subtype.ext
    funext i
    have hker : RingHom.ker (pointEval x).toRingHom =
        RingHom.ker (pointEval y).toRingHom :=
      congrArg MaximalSpectrum.asIdeal hxy
    have hxmem :
        Ideal.Quotient.mk I
            (MvPolynomial.X i - MvPolynomial.C ((x : ι → ℂ) i)) ∈
          RingHom.ker (pointEval x).toRingHom := by
      change MvPolynomial.aeval (x : ι → ℂ)
        (MvPolynomial.X i - MvPolynomial.C ((x : ι → ℂ) i)) = 0
      simp only [MvPolynomial.aeval_eq_eval, map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, sub_self]
    have hymem :
        Ideal.Quotient.mk I
            (MvPolynomial.X i - MvPolynomial.C ((x : ι → ℂ) i)) ∈
          RingHom.ker (pointEval y).toRingHom := hker ▸ hxmem
    change MvPolynomial.aeval (y : ι → ℂ)
      (MvPolynomial.X i - MvPolynomial.C ((x : ι → ℂ) i)) = 0 at hymem
    have heq : (y : ι → ℂ) i - (x : ι → ℂ) i = 0 := by
      simpa only [MvPolynomial.aeval_eq_eval, map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C] using hymem
    exact (sub_eq_zero.mp heq).symm
  exact Set.finite_coe_iff.mp (Finite.of_injective pointIdeal hinj)

noncomputable def freeAffineGateReference {k n : ℕ} (r : ℕ) :
    MvPolynomial (Fin k ⊕ Fin n) ℂ :=
  if h : r < n then MvPolynomial.X (Sum.inr ⟨r, h⟩) else 0

noncomputable def freeAffineExtendedForm {k n : ℕ}
    (form : FreeAffineForm (Fin k)) :
    MvPolynomial (Fin k ⊕ Fin n) ℂ :=
  MvPolynomial.C form.constant +
    Finsupp.linearCombination ℂ
      (fun i : Fin k => MvPolynomial.X (Sum.inl i))
      form.inputCoefficients +
    Finsupp.linearCombination ℂ
      (freeAffineGateReference (k := k) (n := n))
      form.gateCoefficients

noncomputable def freeAffineInstructionRhs {k n : ℕ} :
    FreeAffineInstruction (Fin k) → MvPolynomial (Fin k ⊕ Fin n) ℂ
  | .affine form => freeAffineExtendedForm form
  | .mul left right =>
      freeAffineGateReference (k := k) (n := n) left *
        freeAffineGateReference (k := k) (n := n) right

noncomputable def freeAffineCircuitGate
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k))
    (j : Fin circuit.program.length) : MvPolynomial (Fin k) ℂ :=
  circuit.values.getD j.val 0

theorem freeAffineGateReference_totalDegree_le_one
    {k n : ℕ} (r : ℕ) :
    (freeAffineGateReference (k := k) (n := n) r).totalDegree ≤ 1 := by
  classical
  unfold freeAffineGateReference
  split <;> simp

theorem freeAffineExtendedForm_totalDegree_le_one
    {k n : ℕ} (form : FreeAffineForm (Fin k)) :
    (freeAffineExtendedForm (n := n) form).totalDegree ≤ 1 := by
  classical
  unfold freeAffineExtendedForm
  apply (MvPolynomial.totalDegree_add _ _).trans
  apply max_le
  · apply (MvPolynomial.totalDegree_add _ _).trans
    apply max_le
    · simp only [MvPolynomial.totalDegree_C, zero_le]
    · simp only [Finsupp.linearCombination_apply, Finsupp.sum]
      apply MvPolynomial.totalDegree_finsetSum_le
      intro i hi
      rw [MvPolynomial.smul_eq_C_mul]
      exact (MvPolynomial.totalDegree_mul _ _).trans (by simp only [MvPolynomial.totalDegree_C, MvPolynomial.totalDegree_X, zero_add, Std.le_refl])
  · simp only [Finsupp.linearCombination_apply, Finsupp.sum]
    apply MvPolynomial.totalDegree_finsetSum_le
    intro i hi
    rw [MvPolynomial.smul_eq_C_mul]
    exact (MvPolynomial.totalDegree_mul _ _).trans
      (by simpa only [MvPolynomial.totalDegree_C, zero_add] using
            freeAffineGateReference_totalDegree_le_one (k := k) (n := n) i)

theorem freeAffineGateReference_mem_vars
    {k n : ℕ} (r : ℕ) (i : Fin n)
    (hi : Sum.inr i ∈
      (freeAffineGateReference (k := k) (n := n) r).vars) :
    i.val = r := by
  classical
  unfold freeAffineGateReference at hi
  split at hi
  next h =>
    simp only [MvPolynomial.vars_X, Finset.mem_singleton] at hi
    exact congrArg Fin.val (Sum.inr_injective hi)
  next h =>
    simp only [MvPolynomial.vars_0, Finset.notMem_empty] at hi

theorem freeAffineGateCombination_mem_vars
    {k n : ℕ} (coefficients : ℕ →₀ ℂ) (i : Fin n)
    (hi : Sum.inr i ∈
      (Finsupp.linearCombination ℂ
        (freeAffineGateReference (k := k) (n := n))
        coefficients).vars) :
    ∃ r ∈ coefficients.support, i.val = r := by
  classical
  simp only [Finsupp.linearCombination_apply, Finsupp.sum] at hi
  have hsum := MvPolynomial.vars_sum_subset coefficients.support
    (fun r => coefficients r •
      freeAffineGateReference (k := k) (n := n) r) hi
  rw [Finset.mem_biUnion] at hsum
  obtain ⟨r, hr, hvar⟩ := hsum
  rw [MvPolynomial.smul_eq_C_mul] at hvar
  have hproduct := MvPolynomial.vars_mul
    (MvPolynomial.C (coefficients r))
    (freeAffineGateReference (k := k) (n := n) r) hvar
  rw [Finset.mem_union, MvPolynomial.vars_C] at hproduct
  have href : Sum.inr i ∈
      (freeAffineGateReference (k := k) (n := n) r).vars := by
    simpa only [Finset.notMem_empty, false_or] using hproduct
  exact ⟨r, hr, freeAffineGateReference_mem_vars r i href⟩

theorem freeAffineInputCombination_not_mem_gate_vars
    {k n : ℕ} (coefficients : Fin k →₀ ℂ) (i : Fin n) :
    Sum.inr i ∉
      (Finsupp.linearCombination ℂ
        (fun a : Fin k => MvPolynomial.X (Sum.inl a))
        coefficients : MvPolynomial (Fin k ⊕ Fin n) ℂ).vars := by
  classical
  intro hi
  simp only [Finsupp.linearCombination_apply, Finsupp.sum] at hi
  have hsum := MvPolynomial.vars_sum_subset coefficients.support
    (fun r => coefficients r •
      (MvPolynomial.X (Sum.inl r) : MvPolynomial (Fin k ⊕ Fin n) ℂ)) hi
  rw [Finset.mem_biUnion] at hsum
  obtain ⟨r, _, hvar⟩ := hsum
  rw [MvPolynomial.smul_eq_C_mul] at hvar
  have hproduct := MvPolynomial.vars_mul
    (MvPolynomial.C (coefficients r))
    (MvPolynomial.X (Sum.inl r)) hvar
  simp only [MvPolynomial.vars_C, MvPolynomial.vars_X, Finset.empty_union, Finset.mem_singleton,
    reduceCtorEq] at hproduct

theorem freeAffineExtendedForm_mem_gate_vars
    {k n : ℕ} (form : FreeAffineForm (Fin k))
    (position : ℕ)
    (hposition : ∀ r ∈ form.gateCoefficients.support, r < position)
    (i : Fin n)
    (hi : Sum.inr i ∈
      (freeAffineExtendedForm (n := n) form).vars) :
    i.val < position := by
  classical
  unfold freeAffineExtendedForm at hi
  have houter := MvPolynomial.vars_add_subset
    (MvPolynomial.C form.constant +
      Finsupp.linearCombination ℂ
        (fun a : Fin k => MvPolynomial.X (Sum.inl a))
        form.inputCoefficients)
    (Finsupp.linearCombination ℂ
      (freeAffineGateReference (k := k) (n := n))
      form.gateCoefficients) hi
  rw [Finset.mem_union] at houter
  rcases houter with hconstantOrInput | hgate
  · have hinner := MvPolynomial.vars_add_subset
      (MvPolynomial.C form.constant)
      (Finsupp.linearCombination ℂ
        (fun a : Fin k => MvPolynomial.X (Sum.inl a))
        form.inputCoefficients) hconstantOrInput
    rw [Finset.mem_union, MvPolynomial.vars_C] at hinner
    have hinput : Sum.inr i ∈
        (Finsupp.linearCombination ℂ
          (fun a : Fin k => MvPolynomial.X (Sum.inl a))
          form.inputCoefficients :
            MvPolynomial (Fin k ⊕ Fin n) ℂ).vars := by
      simpa only [Finset.notMem_empty, false_or] using hinner
    exact False.elim
      (freeAffineInputCombination_not_mem_gate_vars
        form.inputCoefficients i hinput)
  · obtain ⟨r, hr, heq⟩ :=
      freeAffineGateCombination_mem_vars
        form.gateCoefficients i hgate
    simpa only [heq, gt_iff_lt] using hposition r hr

theorem freeAffineInstructionRhs_mem_gate_vars
    {k n : ℕ} (instruction : FreeAffineInstruction (Fin k))
    (position : Fin n)
    (hvalid : instruction.referencesBounded position.val)
    (i : Fin n)
    (hi : Sum.inr i ∈
      (freeAffineInstructionRhs (n := n) instruction).vars) :
    i.val < position.val := by
  classical
  cases instruction with
  | affine form =>
      simp only [FreeAffineInstruction.referencesBounded,
        decide_eq_true_eq] at hvalid
      exact freeAffineExtendedForm_mem_gate_vars
        form position.val hvalid i hi
  | mul left right =>
      simp only [FreeAffineInstruction.referencesBounded,
        Bool.and_eq_true, decide_eq_true_eq] at hvalid
      change Sum.inr i ∈
        (freeAffineGateReference (k := k) (n := n) left *
          freeAffineGateReference (k := k) (n := n) right).vars at hi
      have hmul := MvPolynomial.vars_mul
        (freeAffineGateReference (k := k) (n := n) left)
        (freeAffineGateReference (k := k) (n := n) right) hi
      rw [Finset.mem_union] at hmul
      rcases hmul with hl | hr
      · rw [freeAffineGateReference_mem_vars left i hl]
        exact hvalid.1
      · rw [freeAffineGateReference_mem_vars right i hr]
        exact hvalid.2

noncomputable def freeAffineCircuitGraphEvaluation
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k)) :
    MvPolynomial (Fin k ⊕ Fin circuit.program.length) ℂ →ₐ[ℂ]
      MvPolynomial (Fin k) ℂ :=
  MvPolynomial.aeval
    (Sum.elim MvPolynomial.X (freeAffineCircuitGate circuit))

theorem freeAffineCircuitGraphEvaluation_reference
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k)) (r : ℕ) :
    freeAffineCircuitGraphEvaluation circuit
      (freeAffineGateReference
        (k := k) (n := circuit.program.length) r) =
      circuit.values.getD r 0 := by
  classical
  unfold freeAffineGateReference
  split
  next h =>
    simp only [freeAffineCircuitGraphEvaluation, MvPolynomial.aeval_eq_bind₁, MvPolynomial.bind₁_X_right,
      Sum.elim_inr, freeAffineCircuitGate, Array.getD_eq_getD_getElem?]
  next h =>
    have hsize := ReverseAdjoint.circuit_values_size circuit
    have hout : circuit.values.size ≤ r := by omega
    simp only [map_zero, Array.getD_eq_getD_getElem?, not_lt, hout, getElem?_neg, Option.getD_none]

theorem freeAffineCircuitGraphEvaluation_extendedForm
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k))
    (form : FreeAffineForm (Fin k)) :
    freeAffineCircuitGraphEvaluation circuit
      (freeAffineExtendedForm
        (n := circuit.program.length) form) =
      form.eval circuit.values := by
  classical
  simp only [freeAffineCircuitGraphEvaluation, MvPolynomial.aeval_eq_bind₁, freeAffineExtendedForm,
    Finsupp.linearCombination_apply, Finsupp.sum, MvPolynomial.smul_eq_C_mul, map_add, MvPolynomial.algHom_C,
    MvPolynomial.algebraMap_eq, map_sum, map_mul, MvPolynomial.bind₁_X_right, Sum.elim_inl, FreeAffineForm.eval,
    Array.getD_eq_getD_getElem?, add_right_inj]
  apply Finset.sum_congr rfl
  intro r _
  congr 1
  simpa only [freeAffineCircuitGraphEvaluation, MvPolynomial.aeval_eq_bind₁, Array.getD_eq_getD_getElem?] using
    freeAffineCircuitGraphEvaluation_reference circuit r

theorem freeAffineCircuitGraphEvaluation_instructionRhs
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k))
    (instruction : FreeAffineInstruction (Fin k)) :
    freeAffineCircuitGraphEvaluation circuit
      (freeAffineInstructionRhs
        (n := circuit.program.length) instruction) =
      instruction.eval circuit.values := by
  cases instruction with
  | affine form =>
      exact freeAffineCircuitGraphEvaluation_extendedForm circuit form
  | mul left right =>
      change
        freeAffineCircuitGraphEvaluation circuit
          (freeAffineGateReference left *
            freeAffineGateReference right) = _
      rw [map_mul,
        freeAffineCircuitGraphEvaluation_reference,
        freeAffineCircuitGraphEvaluation_reference]
      rfl

theorem freeAffineCircuitGate_eq_graphEvaluation_rhs
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k))
    (j : Fin circuit.program.length) :
    freeAffineCircuitGate circuit j =
      freeAffineCircuitGraphEvaluation circuit
        (freeAffineInstructionRhs
          (n := circuit.program.length) (circuit.program.get j)) := by
  rw [freeAffineCircuitGraphEvaluation_instructionRhs]
  exact ReverseAdjoint.circuit_gateEquation circuit j

noncomputable def freeAffineCircuitInstructionEquation
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k))
    (j : Fin circuit.program.length) :
    MvPolynomial (Fin k ⊕ Fin circuit.program.length) ℂ :=
  MvPolynomial.X (Sum.inr j) -
    freeAffineInstructionRhs
      (n := circuit.program.length) (circuit.program.get j)

theorem freeAffineCircuitInstructionEquation_totalDegree_le
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k))
    (j : Fin circuit.program.length) :
    (freeAffineCircuitInstructionEquation circuit j).totalDegree ≤
      if (circuit.program.get j).isMultiplication then 2 else 1 := by
  classical
  unfold freeAffineCircuitInstructionEquation
  generalize heq : circuit.program.get j = instruction
  cases instruction with
  | affine form =>
      simp only [FreeAffineInstruction.isMultiplication,
        Bool.false_eq_true, ↓reduceIte]
      exact (MvPolynomial.totalDegree_sub _ _).trans
        (max_le (by simp only [MvPolynomial.totalDegree_X, Std.le_refl])
          (freeAffineExtendedForm_totalDegree_le_one form))
  | mul left right =>
      simp only [FreeAffineInstruction.isMultiplication,
        ↓reduceIte]
      exact multiplication_gate_equation_totalDegree_le_two
        (Sum.inr j)
        (freeAffineGateReference left)
        (freeAffineGateReference right)
        (freeAffineGateReference_totalDegree_le_one left)
        (freeAffineGateReference_totalDegree_le_one right)

theorem freeAffineInstruction_program_cost_product
    {k : ℕ} (program : List (FreeAffineInstruction (Fin k))) :
    (program.map fun instruction =>
      if instruction.isMultiplication then (2 : ℕ) else 1).prod =
      2 ^ (program.filter FreeAffineInstruction.isMultiplication).length := by
  induction program with
  | nil => simp only [List.map_nil, List.prod_nil, List.filter_nil, List.length_nil, pow_zero]
  | cons instruction rest ih =>
      cases instruction with
      | affine form =>
          change
            1 * (rest.map fun instruction =>
              if instruction.isMultiplication then (2 : ℕ) else 1).prod =
              2 ^ (rest.filter FreeAffineInstruction.isMultiplication).length
          simpa only [one_mul] using ih
      | mul left right =>
          change
            2 * (rest.map fun instruction =>
              if instruction.isMultiplication then (2 : ℕ) else 1).prod =
              2 ^ ((rest.filter FreeAffineInstruction.isMultiplication).length + 1)
          calc
            2 * (rest.map fun instruction =>
              if instruction.isMultiplication then (2 : ℕ) else 1).prod =
                2 * 2 ^ (rest.filter FreeAffineInstruction.isMultiplication).length :=
                  congrArg (fun z : ℕ => 2 * z) ih
            _ = 2 ^ ((rest.filter FreeAffineInstruction.isMultiplication).length + 1) := by
                  rw [pow_succ, Nat.mul_comm]

theorem freeAffineCircuitInstructionEquation_degree_product_le
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k)) :
    (∏ j : Fin circuit.program.length,
      (freeAffineCircuitInstructionEquation circuit j).totalDegree) ≤
      2 ^ circuit.multiplicationCount := by
  classical
  calc
    (∏ j : Fin circuit.program.length,
      (freeAffineCircuitInstructionEquation circuit j).totalDegree) ≤
      ∏ j : Fin circuit.program.length,
        if (circuit.program.get j).isMultiplication then (2 : ℕ) else 1 := by
          apply Finset.prod_le_prod'
          intro j _
          exact freeAffineCircuitInstructionEquation_totalDegree_le
            circuit j
    _ = (circuit.program.map fun instruction =>
        if instruction.isMultiplication then (2 : ℕ) else 1).prod := by
          exact Fin.prod_univ_fun_getElem circuit.program
            (fun instruction =>
              if instruction.isMultiplication then (2 : ℕ) else 1)
    _ = 2 ^ circuit.multiplicationCount :=
      freeAffineInstruction_program_cost_product circuit.program

end Standalone_AffineBezout

section Standalone_ParameterBounds

def blockWidth (d : ℕ) : ℕ := 4 * d

def blockCount (n d : ℕ) : ℕ := n / (2 * blockWidth d)

def blockRows (n d : ℕ) : ℕ := blockCount n d * blockWidth d

def blockColumns (n d : ℕ) : ℕ := n - blockRows n d + d

def blockVariables (n d : ℕ) : ℕ := blockRows n d * blockColumns n d

def powerSumParameter (d : ℕ) : ℕ := 2 ^ blockWidth d - 1

def sliceRank (n d : ℕ) : ℕ := blockVariables n d / 4

theorem two_mul_blockRows_le (n d : ℕ) : 2 * blockRows n d ≤ n := by
  simpa only [blockRows, blockCount, mul_comm, mul_assoc] using Nat.div_mul_le_self n (2 * blockWidth d)

theorem three_le_blockCount {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n) : 3 ≤ blockCount n d := by
  have hden : 0 < 2 * blockWidth d := by
    simp only [blockWidth]
    omega
  unfold blockCount
  apply (Nat.le_div_iff_mul_le hden).2
  omega

theorem three_mul_blockWidth_le_blockRows {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n) : 3 * blockWidth d ≤ blockRows n d := by
  simpa only [blockRows] using Nat.mul_le_mul_right (blockWidth d) (three_le_blockCount hd hn)

theorem le_three_mul_blockRows {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n) : n ≤ 3 * blockRows n d := by
  have hden : 0 < 2 * blockWidth d := by
    simp only [blockWidth]
    omega
  have hrem := Nat.mod_lt n hden
  have hrows := three_mul_blockWidth_le_blockRows hd hn
  have hdecomp :
      n % (2 * blockWidth d) + 2 * blockRows n d = n := by
    simpa only [blockRows, blockCount, mul_comm, mul_assoc] using Nat.mod_add_div n (2 * blockWidth d)
  omega

theorem degree_le_blockRows {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n) : d ≤ blockRows n d := by
  have hrows := three_mul_blockWidth_le_blockRows hd hn
  simp only [blockWidth] at hrows
  omega

theorem degree_le_blockColumns (n d : ℕ) : d ≤ blockColumns n d := by
  have hrows := two_mul_blockRows_le n d
  unfold blockColumns
  omega

theorem block_size_identity (n d : ℕ) :
    blockRows n d + blockColumns n d - d = n := by
  have hrows := two_mul_blockRows_le n d
  unfold blockColumns
  omega

theorem le_two_mul_blockColumns (n d : ℕ) : n ≤ 2 * blockColumns n d := by
  have hrows := two_mul_blockRows_le n d
  unfold blockColumns
  omega

theorem square_le_six_mul_blockVariables {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n) : n ^ 2 ≤ 6 * blockVariables n d := by
  have hproduct := Nat.mul_le_mul (le_three_mul_blockRows hd hn)
    (le_two_mul_blockColumns n d)
  calc
    n ^ 2 = n * n := by rw [pow_two]
    _ ≤ (3 * blockRows n d) * (2 * blockColumns n d) := hproduct
    _ = 6 * blockVariables n d := by
      unfold blockVariables
      ring

theorem blockVariables_eq_four_mul (n d : ℕ) :
    blockVariables n d = 4 * (blockCount n d * blockColumns n d * d) := by
  simp only [blockVariables, blockRows, blockWidth, mul_comm, mul_assoc, mul_left_comm]

theorem blockVariables_div_four (n d : ℕ) :
    blockVariables n d / 4 = blockCount n d * blockColumns n d * d := by
  rw [blockVariables_eq_four_mul]
  simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, mul_div_cancel_left₀]

theorem powerSum_cost_le_quarter {n d : ℕ}
    (hscale : 4 * powerSumParameter d ≤ blockWidth d * blockColumns n d) :
    blockCount n d * powerSumParameter d ≤ blockVariables n d / 4 := by
  apply (Nat.le_div_iff_mul_le (by omega : 0 < (4 : ℕ))).2
  have hmul := Nat.mul_le_mul_left (blockCount n d) hscale
  simpa only [mul_comm, blockVariables, blockRows, ge_iff_le, mul_left_comm] using hmul

theorem minorSum_cost_lt_quarter {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n) :
    blockCount n d * blockColumns n d * (d - 2) < blockVariables n d / 4 := by
  have hb : 0 < blockCount n d := by
    have hthree := three_le_blockCount hd hn
    omega
  have hs : 0 < blockColumns n d := by
    have hcolumns := degree_le_blockColumns n d
    omega
  rw [blockVariables_div_four]
  exact Nat.mul_lt_mul_of_pos_left (by omega : d - 2 < d) (Nat.mul_pos hb hs)

theorem eight_le_blockVariables {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n) : 8 ≤ blockVariables n d := by
  have hdegrees := Nat.mul_le_mul (degree_le_blockRows hd hn)
    (degree_le_blockColumns n d)
  have hsquare := Nat.mul_le_mul hd hd
  unfold blockVariables
  omega

theorem twice_criticalDimension_lt_blockVariables {n d dimension : ℕ}
    (hd : 3 ≤ d) (hn : 6 * blockWidth d ≤ n)
    (hscale : 4 * powerSumParameter d ≤ blockWidth d * blockColumns n d)
    (hdimension : dimension ≤ blockCount n d *
      (powerSumParameter d + blockColumns n d * (d - 2))) :
    2 * dimension < blockVariables n d := by
  have hpower := powerSum_cost_le_quarter hscale
  have hminor := minorSum_cost_lt_quarter hd hn
  have hfloor := Nat.div_mul_le_self (blockVariables n d) 4
  have hbound : dimension ≤ blockCount n d * powerSumParameter d +
      blockCount n d * blockColumns n d * (d - 2) := by
    simpa only [mul_assoc, mul_add] using hdimension
  omega

theorem sliceRank_lt_blockVariables {n d : ℕ} (hm : 8 ≤ blockVariables n d) :
    sliceRank n d < blockVariables n d := by
  unfold sliceRank
  exact Nat.div_lt_self (by omega) (by omega)

theorem blockVariables_le_eight_mul_sliceRank {n d : ℕ}
    (hm : 8 ≤ blockVariables n d) :
    blockVariables n d ≤ 8 * sliceRank n d := by
  unfold sliceRank
  have hrem := Nat.mod_lt (blockVariables n d) (by omega : 0 < (4 : ℕ))
  have hdecomp := Nat.mod_add_div (blockVariables n d) 4
  omega

theorem sliceRank_le_codimension {n d dimension : ℕ}
    (hd : 3 ≤ d) (hn : 6 * blockWidth d ≤ n)
    (hscale : 4 * powerSumParameter d ≤ blockWidth d * blockColumns n d)
    (hdimension : dimension ≤ blockCount n d *
      (powerSumParameter d + blockColumns n d * (d - 2))) :
    sliceRank n d ≤ blockVariables n d - dimension := by
  have hhalf := twice_criticalDimension_lt_blockVariables hd hn hscale hdimension
  have hfloor := Nat.div_mul_le_self (blockVariables n d) 4
  unfold sliceRank
  omega

theorem square_le_fortyEight_mul_sliceRank {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n) : n ^ 2 ≤ 48 * sliceRank n d := by
  have hmass := square_le_six_mul_blockVariables hd hn
  have height := blockVariables_le_eight_mul_sliceRank
    (eight_le_blockVariables hd hn)
  omega

theorem logarithmic_lower_bound_of_gradient {n d q : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n)
    (hgradient : (sliceRank n d : ℝ) * Real.logb 2 ((d : ℝ) - 1) ≤
      3 * (q : ℝ)) :
    (n : ℝ) ^ 2 * Real.logb 2 ((d : ℝ) - 1) / 144 ≤ (q : ℝ) := by
  have hd_real : (3 : ℝ) ≤ (d : ℝ) := by
    exact_mod_cast hd
  have hlog : 0 ≤ Real.logb 2 ((d : ℝ) - 1) :=
    Real.logb_nonneg (by norm_num : (1 : ℝ) < 2) (by linarith)
  have hsquare_nat := square_le_fortyEight_mul_sliceRank hd hn
  have hsquare : (n : ℝ) ^ 2 ≤ 48 * (sliceRank n d : ℝ) := by
    exact_mod_cast hsquare_nat
  have hproduct := mul_le_mul_of_nonneg_right hsquare hlog
  nlinarith

end Standalone_ParameterBounds

section Standalone_Asymptotics

end Standalone_Asymptotics

section Standalone_BlockPermanent

open scoped BigOperators

attribute [local instance] Classical.propDecidable Classical.decEq

noncomputable def rectangularPermanent
    {α β R : Type*} [Fintype α] [Fintype β] [CommSemiring R]
    (A : Matrix α β R) : R :=
  ∑ matching : α ≃ β, ∏ row : α, A row (matching row)

noncomputable def sourceBlockMatrix
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R) :
    Matrix (Fin r ⊕ Fin (s - d)) (Fin s ⊕ Fin (r - d)) R :=
  Matrix.fromBlocks X U
    (fun (_ : Fin (s - d)) (_ : Fin s) => 1)
    (0 : Matrix (Fin (s - d)) (Fin (r - d)) R)

@[simp] theorem sourceBlockMatrix_apply₁₁
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R)
    (row : Fin r) (column : Fin s) :
    sourceBlockMatrix r s d X U (.inl row) (.inl column) = X row column := by
  rfl

@[simp] theorem sourceBlockMatrix_apply₁₂
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R)
    (row : Fin r) (column : Fin (r - d)) :
    sourceBlockMatrix r s d X U (.inl row) (.inr column) = U row column := by
  rfl

@[simp] theorem sourceBlockMatrix_apply₂₁
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R)
    (row : Fin (s - d)) (column : Fin s) :
    sourceBlockMatrix r s d X U (.inr row) (.inl column) = 1 := by
  rfl

@[simp] theorem sourceBlockMatrix_apply₂₂
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R)
    (row : Fin (s - d)) (column : Fin (r - d)) :
    sourceBlockMatrix r s d X U (.inr row) (.inr column) = 0 := by
  rfl

noncomputable def sourceBlockMatchingWeight
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d))) : R :=
  ∏ row, sourceBlockMatrix r s d X U row (matching row)

noncomputable def sourceBlockAlpha
    {R : Type*} [CommSemiring R] (r d : ℕ)
    (U : Matrix (Fin r) (Fin (r - d)) R)
    (I : Finset (Fin r)) : R :=
  ∑ matching : {row : Fin r // row ∉ I} ≃ Fin (r - d),
    ∏ row : {row : Fin r // row ∉ I}, U row.val (matching row)

noncomputable def sourceBlockMinor
    {R : Type*} [CommSemiring R] (r s : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (I : Finset (Fin r)) (J : Finset (Fin s)) : R :=
  ∑ matching : I ≃ J,
    ∏ row : I, X row.val (matching row).val

noncomputable def sourceBlockMatchingExpansion
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R) : R :=
  ((s - d).factorial : R) *
    ∑ I ∈ (Finset.univ : Finset (Fin r)).powersetCard d,
      ∑ J ∈ (Finset.univ : Finset (Fin s)).powersetCard d,
        sourceBlockAlpha r d U I * sourceBlockMinor r s X I J

noncomputable def sourceBlockMatchingOf
    (r s d : ℕ) (I : Finset (Fin r)) (J : Finset (Fin s))
    (variableMatching : I ≃ J)
    (constantMatching : {row : Fin r // row ∉ I} ≃ Fin (r - d))
    (onesMatching : Fin (s - d) ≃ {column : Fin s // column ∉ J}) :
    (Fin r ⊕ Fin (s - d)) ≃ (Fin s ⊕ Fin (r - d)) :=
  calc
    Fin r ⊕ Fin (s - d) ≃
        (I ⊕ {row : Fin r // row ∉ I}) ⊕ Fin (s - d) :=
      (Equiv.sumCompl (fun row : Fin r => row ∈ I)).symm.sumCongr
        (Equiv.refl (Fin (s - d)))
    _ ≃ (J ⊕ Fin (r - d)) ⊕ {column : Fin s // column ∉ J} :=
      (variableMatching.sumCongr constantMatching).sumCongr onesMatching
    _ ≃ J ⊕ (Fin (r - d) ⊕ {column : Fin s // column ∉ J}) :=
      Equiv.sumAssoc _ _ _
    _ ≃ J ⊕ ({column : Fin s // column ∉ J} ⊕ Fin (r - d)) :=
      (Equiv.refl J).sumCongr (Equiv.sumComm _ _)
    _ ≃ (J ⊕ {column : Fin s // column ∉ J}) ⊕ Fin (r - d) :=
      (Equiv.sumAssoc _ _ _).symm
    _ ≃ Fin s ⊕ Fin (r - d) :=
      (Equiv.sumCompl (fun column : Fin s => column ∈ J)).sumCongr
        (Equiv.refl (Fin (r - d)))

@[simp] theorem sourceBlockMatchingOf_apply_selected
    (r s d : ℕ) (I : Finset (Fin r)) (J : Finset (Fin s))
    (variableMatching : I ≃ J)
    (constantMatching : {row : Fin r // row ∉ I} ≃ Fin (r - d))
    (onesMatching : Fin (s - d) ≃ {column : Fin s // column ∉ J})
    (row : I) :
    sourceBlockMatchingOf r s d I J
        variableMatching constantMatching onesMatching (.inl row.val) =
      .inl (variableMatching row).val := by
  simp only [sourceBlockMatchingOf, Equiv.trans_def, Equiv.sumCongr_trans, Equiv.refl_trans, Equiv.trans_apply,
    Equiv.sumCongr_apply, Equiv.coe_trans, Sum.map_inl, Function.comp_apply, row.property,
    Equiv.sumCompl_symm_apply_of_pos, Subtype.coe_eta, Equiv.sumAssoc_apply_inl_inl, Equiv.coe_refl,
    Equiv.sumComm_apply, id_eq, Equiv.sumAssoc_symm_apply_inl, Equiv.sumCompl_apply_inl]

@[simp] theorem sourceBlockMatchingOf_apply_complement
    (r s d : ℕ) (I : Finset (Fin r)) (J : Finset (Fin s))
    (variableMatching : I ≃ J)
    (constantMatching : {row : Fin r // row ∉ I} ≃ Fin (r - d))
    (onesMatching : Fin (s - d) ≃ {column : Fin s // column ∉ J})
    (row : {row : Fin r // row ∉ I}) :
    sourceBlockMatchingOf r s d I J
        variableMatching constantMatching onesMatching (.inl row.val) =
      .inr (constantMatching row) := by
  simp only [sourceBlockMatchingOf, Equiv.trans_def, Equiv.sumCongr_trans, Equiv.refl_trans, Equiv.trans_apply,
    Equiv.sumCongr_apply, Equiv.coe_trans, Sum.map_inl, Function.comp_apply, row.property, not_false_eq_true,
    Equiv.sumCompl_symm_apply_of_neg, Subtype.coe_eta, Sum.map_inr, Equiv.sumAssoc_apply_inl_inr, Equiv.coe_refl,
    Equiv.sumComm_apply, Sum.swap_inl, Equiv.sumAssoc_symm_apply_inr_inr, id_eq]

@[simp] theorem sourceBlockMatchingOf_apply_lower
    (r s d : ℕ) (I : Finset (Fin r)) (J : Finset (Fin s))
    (variableMatching : I ≃ J)
    (constantMatching : {row : Fin r // row ∉ I} ≃ Fin (r - d))
    (onesMatching : Fin (s - d) ≃ {column : Fin s // column ∉ J})
    (row : Fin (s - d)) :
    sourceBlockMatchingOf r s d I J
        variableMatching constantMatching onesMatching (.inr row) =
      .inl (onesMatching row).val := by
  simp only [sourceBlockMatchingOf, Equiv.trans_def, Equiv.sumCongr_trans, Equiv.refl_trans, Equiv.trans_apply,
    Equiv.sumCongr_apply, Equiv.coe_trans, Sum.map_inr, Equiv.sumAssoc_apply_inr, Equiv.coe_refl, Equiv.sumComm_apply,
    Sum.swap_inr, Equiv.sumAssoc_symm_apply_inr_inl, Sum.map_inl, Equiv.sumCompl_apply_inr]

noncomputable def sourceBlockSelectedRows
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d))) : Finset (Fin r) :=
  Finset.univ.filter
    (fun row => ∃ column : Fin s, matching (.inl row) = .inl column)

noncomputable def sourceBlockSelectedColumns
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d))) : Finset (Fin s) :=
  Finset.univ.filter
    (fun column => ∃ row : Fin r, matching (.inl row) = .inl column)

@[simp] theorem sourceBlock_mem_selectedRows
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (row : Fin r) :
    row ∈ sourceBlockSelectedRows r s d matching ↔
      ∃ column : Fin s, matching (.inl row) = .inl column := by
  simp only [sourceBlockSelectedRows, Finset.mem_filter, Finset.mem_univ, true_and]

@[simp] theorem sourceBlock_mem_selectedColumns
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (column : Fin s) :
    column ∈ sourceBlockSelectedColumns r s d matching ↔
      ∃ row : Fin r, matching (.inl row) = .inl column := by
  simp only [sourceBlockSelectedColumns, Finset.mem_filter, Finset.mem_univ, true_and]

theorem sourceBlockMatchingOf_isValid
    (r s d : ℕ) (I : Finset (Fin r)) (J : Finset (Fin s))
    (variableMatching : I ≃ J)
    (constantMatching : {row : Fin r // row ∉ I} ≃ Fin (r - d))
    (onesMatching : Fin (s - d) ≃ {column : Fin s // column ∉ J}) :
    ∀ row : Fin (s - d), ∃ column : Fin s,
      sourceBlockMatchingOf r s d I J
        variableMatching constantMatching onesMatching
          (.inr row) = .inl column := by
  intro row
  exact ⟨(onesMatching row).val,
    sourceBlockMatchingOf_apply_lower r s d I J
      variableMatching constantMatching onesMatching row⟩

noncomputable def sourceBlockVariableFunction
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d))) :
    sourceBlockSelectedRows r s d matching →
      sourceBlockSelectedColumns r s d matching := by
  intro row
  have hcolumn : ∃ column : Fin s,
      matching (.inl row.val) = .inl column :=
    (sourceBlock_mem_selectedRows r s d matching row.val).mp row.property
  refine ⟨Classical.choose hcolumn, ?_⟩
  exact (sourceBlock_mem_selectedColumns r s d matching _).mpr
    ⟨row.val, Classical.choose_spec hcolumn⟩

theorem sourceBlockVariableFunction_spec
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (row : sourceBlockSelectedRows r s d matching) :
    matching (.inl row.val) =
      .inl (sourceBlockVariableFunction r s d matching row).val := by
  unfold sourceBlockVariableFunction
  exact Classical.choose_spec
    ((sourceBlock_mem_selectedRows r s d matching row.val).mp row.property)

theorem sourceBlockVariableFunction_bijective
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d))) :
    Function.Bijective (sourceBlockVariableFunction r s d matching) := by
  constructor
  · intro row₁ row₂ heq
    apply Subtype.ext
    have hmatch :
        matching (.inl row₁.val) = matching (.inl row₂.val) := by
      calc
        matching (.inl row₁.val) =
            .inl (sourceBlockVariableFunction r s d matching row₁).val :=
          sourceBlockVariableFunction_spec r s d matching row₁
        _ = .inl (sourceBlockVariableFunction r s d matching row₂).val :=
          congrArg Sum.inl (congrArg Subtype.val heq)
        _ = matching (.inl row₂.val) :=
          (sourceBlockVariableFunction_spec r s d matching row₂).symm
    exact Sum.inl.inj (matching.injective hmatch)
  · intro column
    obtain ⟨row, hrow⟩ :=
      (sourceBlock_mem_selectedColumns r s d matching column.val).mp
        column.property
    have hselected : row ∈ sourceBlockSelectedRows r s d matching :=
      (sourceBlock_mem_selectedRows r s d matching row).mpr
        ⟨column.val, hrow⟩
    refine ⟨⟨row, hselected⟩, ?_⟩
    apply Subtype.ext
    exact Sum.inl.inj
      ((sourceBlockVariableFunction_spec r s d matching
        ⟨row, hselected⟩).symm.trans hrow)

noncomputable def sourceBlockVariableMatchingOf
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d))) :
    sourceBlockSelectedRows r s d matching ≃
      sourceBlockSelectedColumns r s d matching :=
  Equiv.ofBijective (sourceBlockVariableFunction r s d matching)
    (sourceBlockVariableFunction_bijective r s d matching)

theorem sourceBlockVariableMatchingOf_spec
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (row : sourceBlockSelectedRows r s d matching) :
    matching (.inl row.val) =
      .inl (sourceBlockVariableMatchingOf r s d matching row).val := by
  exact sourceBlockVariableFunction_spec r s d matching row

theorem sourceBlockConstant_exists
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (row : {row : Fin r //
      row ∉ sourceBlockSelectedRows r s d matching}) :
    ∃ column : Fin (r - d), matching (.inl row.val) = .inr column := by
  cases hcolumn : matching (.inl row.val) with
  | inl column =>
      exfalso
      exact row.property
        ((sourceBlock_mem_selectedRows r s d matching row.val).mpr
          ⟨column, hcolumn⟩)
  | inr column =>
      exact ⟨column, rfl⟩

noncomputable def sourceBlockConstantFunction
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (row : {row : Fin r //
      row ∉ sourceBlockSelectedRows r s d matching}) : Fin (r - d) :=
  Classical.choose (sourceBlockConstant_exists r s d matching row)

theorem sourceBlockConstantFunction_spec
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (row : {row : Fin r //
      row ∉ sourceBlockSelectedRows r s d matching}) :
    matching (.inl row.val) =
      .inr (sourceBlockConstantFunction r s d matching row) :=
  Classical.choose_spec (sourceBlockConstant_exists r s d matching row)

theorem sourceBlockConstantFunction_bijective
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (hvalid : ∀ row : Fin (s - d),
      ∃ column : Fin s, matching (.inr row) = .inl column) :
    Function.Bijective (sourceBlockConstantFunction r s d matching) := by
  constructor
  · intro row₁ row₂ heq
    apply Subtype.ext
    have hmatch :
        matching (.inl row₁.val) = matching (.inl row₂.val) := by
      calc
        matching (.inl row₁.val) =
            .inr (sourceBlockConstantFunction r s d matching row₁) :=
          sourceBlockConstantFunction_spec r s d matching row₁
        _ = .inr (sourceBlockConstantFunction r s d matching row₂) :=
          congrArg Sum.inr heq
        _ = matching (.inl row₂.val) :=
          (sourceBlockConstantFunction_spec r s d matching row₂).symm
    exact Sum.inl.inj (matching.injective hmatch)
  · intro column
    have hpre := matching.apply_symm_apply (.inr column)
    cases hrow : matching.symm (.inr column) with
    | inl row =>
        have hhit : matching (.inl row) = .inr column := by
          simpa only [hrow] using hpre
        have hnot : row ∉ sourceBlockSelectedRows r s d matching := by
          intro hselected
          obtain ⟨left, hleft⟩ :=
            (sourceBlock_mem_selectedRows r s d matching row).mp hselected
          rw [hhit] at hleft
          cases hleft
        refine ⟨⟨row, hnot⟩, ?_⟩
        exact Sum.inr.inj
          ((sourceBlockConstantFunction_spec r s d matching
            ⟨row, hnot⟩).symm.trans hhit)
    | inr row =>
        have hhit : matching (.inr row) = .inr column := by
          simpa only [hrow] using hpre
        obtain ⟨left, hleft⟩ := hvalid row
        rw [hleft] at hhit
        cases hhit

noncomputable def sourceBlockConstantMatchingOf
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (hvalid : ∀ row : Fin (s - d),
      ∃ column : Fin s, matching (.inr row) = .inl column) :
    {row : Fin r // row ∉ sourceBlockSelectedRows r s d matching} ≃
      Fin (r - d) :=
  Equiv.ofBijective (sourceBlockConstantFunction r s d matching)
    (sourceBlockConstantFunction_bijective r s d matching hvalid)

theorem sourceBlockConstantMatchingOf_spec
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (hvalid : ∀ row : Fin (s - d),
      ∃ column : Fin s, matching (.inr row) = .inl column)
    (row : {row : Fin r //
      row ∉ sourceBlockSelectedRows r s d matching}) :
    matching (.inl row.val) =
      .inr (sourceBlockConstantMatchingOf r s d matching hvalid row) := by
  exact sourceBlockConstantFunction_spec r s d matching row

noncomputable def sourceBlockOnesFunction
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (hvalid : ∀ row : Fin (s - d),
      ∃ column : Fin s, matching (.inr row) = .inl column) :
    Fin (s - d) →
      {column : Fin s //
        column ∉ sourceBlockSelectedColumns r s d matching} := by
  intro row
  refine ⟨Classical.choose (hvalid row), ?_⟩
  intro hselected
  obtain ⟨upper, hupper⟩ :=
    (sourceBlock_mem_selectedColumns r s d matching
      (Classical.choose (hvalid row))).mp hselected
  have hconflict :
      (Sum.inl upper : Fin r ⊕ Fin (s - d)) = .inr row :=
    matching.injective (hupper.trans (Classical.choose_spec (hvalid row)).symm)
  cases hconflict

theorem sourceBlockOnesFunction_spec
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (hvalid : ∀ row : Fin (s - d),
      ∃ column : Fin s, matching (.inr row) = .inl column)
    (row : Fin (s - d)) :
    matching (.inr row) =
      .inl (sourceBlockOnesFunction r s d matching hvalid row).val := by
  unfold sourceBlockOnesFunction
  exact Classical.choose_spec (hvalid row)

theorem sourceBlockOnesFunction_bijective
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (hvalid : ∀ row : Fin (s - d),
      ∃ column : Fin s, matching (.inr row) = .inl column) :
    Function.Bijective (sourceBlockOnesFunction r s d matching hvalid) := by
  constructor
  · intro row₁ row₂ heq
    have hmatch : matching (.inr row₁) = matching (.inr row₂) := by
      calc
        matching (.inr row₁) =
            .inl (sourceBlockOnesFunction r s d matching hvalid row₁).val :=
          sourceBlockOnesFunction_spec r s d matching hvalid row₁
        _ = .inl (sourceBlockOnesFunction r s d matching hvalid row₂).val :=
          congrArg Sum.inl (congrArg Subtype.val heq)
        _ = matching (.inr row₂) :=
          (sourceBlockOnesFunction_spec r s d matching hvalid row₂).symm
    exact Sum.inr.inj (matching.injective hmatch)
  · intro column
    have hpre := matching.apply_symm_apply (.inl column.val)
    cases hrow : matching.symm (.inl column.val) with
    | inl row =>
        have hhit : matching (.inl row) = .inl column.val := by
          simpa only [hrow] using hpre
        exact (column.property
          ((sourceBlock_mem_selectedColumns r s d matching column.val).mpr
            ⟨row, hhit⟩)).elim
    | inr row =>
        have hhit : matching (.inr row) = .inl column.val := by
          simpa only [hrow] using hpre
        refine ⟨row, ?_⟩
        apply Subtype.ext
        exact Sum.inl.inj
          ((sourceBlockOnesFunction_spec r s d matching hvalid row).symm.trans
            hhit)

noncomputable def sourceBlockOnesMatchingOf
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (hvalid : ∀ row : Fin (s - d),
      ∃ column : Fin s, matching (.inr row) = .inl column) :
    Fin (s - d) ≃
      {column : Fin s //
        column ∉ sourceBlockSelectedColumns r s d matching} :=
  Equiv.ofBijective (sourceBlockOnesFunction r s d matching hvalid)
    (sourceBlockOnesFunction_bijective r s d matching hvalid)

theorem sourceBlockOnesMatchingOf_spec
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (hvalid : ∀ row : Fin (s - d),
      ∃ column : Fin s, matching (.inr row) = .inl column)
    (row : Fin (s - d)) :
    matching (.inr row) =
      .inl (sourceBlockOnesMatchingOf r s d matching hvalid row).val := by
  exact sourceBlockOnesFunction_spec r s d matching hvalid row

theorem sourceBlockMatchingOf_recovered
    (r s d : ℕ)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (hvalid : ∀ row : Fin (s - d),
      ∃ column : Fin s, matching (.inr row) = .inl column) :
    sourceBlockMatchingOf r s d
      (sourceBlockSelectedRows r s d matching)
      (sourceBlockSelectedColumns r s d matching)
      (sourceBlockVariableMatchingOf r s d matching)
      (sourceBlockConstantMatchingOf r s d matching hvalid)
      (sourceBlockOnesMatchingOf r s d matching hvalid) = matching := by
  apply Equiv.ext
  intro row
  cases row with
  | inl upper =>
      by_cases hupper : upper ∈ sourceBlockSelectedRows r s d matching
      · exact
          (sourceBlockMatchingOf_apply_selected r s d
            (sourceBlockSelectedRows r s d matching)
            (sourceBlockSelectedColumns r s d matching)
            (sourceBlockVariableMatchingOf r s d matching)
            (sourceBlockConstantMatchingOf r s d matching hvalid)
            (sourceBlockOnesMatchingOf r s d matching hvalid)
            ⟨upper, hupper⟩).trans
          (sourceBlockVariableMatchingOf_spec r s d matching
            ⟨upper, hupper⟩).symm
      · exact
          (sourceBlockMatchingOf_apply_complement r s d
            (sourceBlockSelectedRows r s d matching)
            (sourceBlockSelectedColumns r s d matching)
            (sourceBlockVariableMatchingOf r s d matching)
            (sourceBlockConstantMatchingOf r s d matching hvalid)
            (sourceBlockOnesMatchingOf r s d matching hvalid)
            ⟨upper, hupper⟩).trans
          (sourceBlockConstantMatchingOf_spec r s d matching hvalid
            ⟨upper, hupper⟩).symm
  | inr lower =>
      exact
        (sourceBlockMatchingOf_apply_lower r s d
          (sourceBlockSelectedRows r s d matching)
          (sourceBlockSelectedColumns r s d matching)
          (sourceBlockVariableMatchingOf r s d matching)
          (sourceBlockConstantMatchingOf r s d matching hvalid)
          (sourceBlockOnesMatchingOf r s d matching hvalid) lower).trans
        (sourceBlockOnesMatchingOf_spec r s d matching hvalid lower).symm

theorem sourceBlockSelectedRows_card_of_valid
    (r s d : ℕ) (hr : d ≤ r)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (hvalid : ∀ row : Fin (s - d),
      ∃ column : Fin s, matching (.inr row) = .inl column) :
    (sourceBlockSelectedRows r s d matching).card = d := by
  have hconstant := Fintype.card_congr
    (sourceBlockConstantMatchingOf r s d matching hvalid)
  rw [Fintype.card_subtype_compl
    (fun row : Fin r => row ∈ sourceBlockSelectedRows r s d matching)]
    at hconstant
  simp only [Fintype.card_fin, Fintype.card_coe] at hconstant
  have hbound : (sourceBlockSelectedRows r s d matching).card ≤ r := by
    simpa only [Fintype.card_fin] using Finset.card_le_univ (sourceBlockSelectedRows r s d matching)
  omega

theorem sourceBlockSelectedColumns_card_of_valid
    (r s d : ℕ) (hr : d ≤ r)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (hvalid : ∀ row : Fin (s - d),
      ∃ column : Fin s, matching (.inr row) = .inl column) :
    (sourceBlockSelectedColumns r s d matching).card = d := by
  have hvariable := Fintype.card_congr
    (sourceBlockVariableMatchingOf r s d matching)
  simp only [Fintype.card_coe] at hvariable
  have hrows := sourceBlockSelectedRows_card_of_valid r s d hr matching hvalid
  omega

@[simp] theorem sourceBlockSelectedRows_matchingOf
    (r s d : ℕ) (I : Finset (Fin r)) (J : Finset (Fin s))
    (variableMatching : I ≃ J)
    (constantMatching : {row : Fin r // row ∉ I} ≃ Fin (r - d))
    (onesMatching : Fin (s - d) ≃ {column : Fin s // column ∉ J}) :
    sourceBlockSelectedRows r s d
      (sourceBlockMatchingOf r s d I J
        variableMatching constantMatching onesMatching) = I := by
  ext row
  simp only [sourceBlockSelectedRows, Finset.mem_filter,
    Finset.mem_univ, true_and]
  constructor
  · rintro ⟨column, hcolumn⟩
    by_contra hrow
    have hright := sourceBlockMatchingOf_apply_complement r s d I J
      variableMatching constantMatching onesMatching ⟨row, hrow⟩
    rw [hright] at hcolumn
    cases hcolumn
  · intro hrow
    refine ⟨(variableMatching ⟨row, hrow⟩).val, ?_⟩
    exact sourceBlockMatchingOf_apply_selected r s d I J
      variableMatching constantMatching onesMatching ⟨row, hrow⟩

@[simp] theorem sourceBlockSelectedColumns_matchingOf
    (r s d : ℕ) (I : Finset (Fin r)) (J : Finset (Fin s))
    (variableMatching : I ≃ J)
    (constantMatching : {row : Fin r // row ∉ I} ≃ Fin (r - d))
    (onesMatching : Fin (s - d) ≃ {column : Fin s // column ∉ J}) :
    sourceBlockSelectedColumns r s d
      (sourceBlockMatchingOf r s d I J
        variableMatching constantMatching onesMatching) = J := by
  ext column
  simp only [sourceBlockSelectedColumns, Finset.mem_filter,
    Finset.mem_univ, true_and]
  constructor
  · rintro ⟨row, hcolumn⟩
    have hrow : row ∈ I := by
      by_contra hn
      have hright := sourceBlockMatchingOf_apply_complement r s d I J
        variableMatching constantMatching onesMatching ⟨row, hn⟩
      rw [hright] at hcolumn
      cases hcolumn
    have hleft := sourceBlockMatchingOf_apply_selected r s d I J
      variableMatching constantMatching onesMatching ⟨row, hrow⟩
    have heq : (variableMatching ⟨row, hrow⟩).val = column :=
      Sum.inl_injective (hleft.symm.trans hcolumn)
    rw [← heq]
    exact (variableMatching ⟨row, hrow⟩).property
  · intro hcolumn
    let row : I := variableMatching.symm ⟨column, hcolumn⟩
    refine ⟨row.val, ?_⟩
    simpa only [row, Equiv.apply_symm_apply] using
      sourceBlockMatchingOf_apply_selected r s d I J
        variableMatching constantMatching onesMatching row

theorem sourceBlockMatchingOf_injective
    (r s d : ℕ) (I : Finset (Fin r)) (J : Finset (Fin s)) :
    Function.Injective
      (fun data :
        (I ≃ J) ×
          ({row : Fin r // row ∉ I} ≃ Fin (r - d)) ×
          (Fin (s - d) ≃ {column : Fin s // column ∉ J}) =>
        sourceBlockMatchingOf r s d I J data.1 data.2.1 data.2.2) := by
  rintro ⟨variable₁, constant₁, ones₁⟩
    ⟨variable₂, constant₂, ones₂⟩ hmatching
  have hvariable : variable₁ = variable₂ := by
    apply Equiv.ext
    intro row
    apply Subtype.ext
    simpa only [SetLike.coe_eq_coe, sourceBlockMatchingOf_apply_selected, Sum.inl.injEq] using
      congrArg (fun matching => matching (.inl row.val)) hmatching
  have hconstant : constant₁ = constant₂ := by
    apply Equiv.ext
    intro row
    simpa only [sourceBlockMatchingOf_apply_complement, Sum.inr.injEq] using
      congrArg (fun matching => matching (.inl row.val)) hmatching
  have hones : ones₁ = ones₂ := by
    apply Equiv.ext
    intro row
    apply Subtype.ext
    simpa only [sourceBlockMatchingOf_apply_lower, Sum.inl.injEq] using
      congrArg (fun matching => matching (.inr row)) hmatching
  simp only [hvariable, hconstant, hones]

abbrev SourceBlockMatchingData (r s d : ℕ) : Type :=
  Σ I : ((Finset.univ : Finset (Fin r)).powersetCard d),
    Σ J : ((Finset.univ : Finset (Fin s)).powersetCard d),
      (I.val ≃ J.val) ×
        ({row : Fin r // row ∉ I.val} ≃ Fin (r - d)) ×
        (Fin (s - d) ≃ {column : Fin s // column ∉ J.val})

noncomputable def sourceBlockDataMatching
    (r s d : ℕ) (data : SourceBlockMatchingData r s d) :
    (Fin r ⊕ Fin (s - d)) ≃ (Fin s ⊕ Fin (r - d)) :=
  sourceBlockMatchingOf r s d data.1.val data.2.1.val
    data.2.2.1 data.2.2.2.1 data.2.2.2.2

@[simp] theorem sourceBlockSelectedRows_dataMatching
    (r s d : ℕ) (data : SourceBlockMatchingData r s d) :
    sourceBlockSelectedRows r s d (sourceBlockDataMatching r s d data) =
      data.1.val := by
  exact sourceBlockSelectedRows_matchingOf r s d data.1.val data.2.1.val
    data.2.2.1 data.2.2.2.1 data.2.2.2.2

@[simp] theorem sourceBlockSelectedColumns_dataMatching
    (r s d : ℕ) (data : SourceBlockMatchingData r s d) :
    sourceBlockSelectedColumns r s d (sourceBlockDataMatching r s d data) =
      data.2.1.val := by
  exact sourceBlockSelectedColumns_matchingOf r s d data.1.val data.2.1.val
    data.2.2.1 data.2.2.2.1 data.2.2.2.2

theorem sourceBlockDataMatching_injective
    (r s d : ℕ) :
    Function.Injective (sourceBlockDataMatching r s d) := by
  intro data₁ data₂ hmatching
  have hrows : data₁.1 = data₂.1 := by
    apply Subtype.ext
    exact
      (sourceBlockSelectedRows_dataMatching r s d data₁).symm.trans
      ((congrArg (sourceBlockSelectedRows r s d) hmatching).trans
        (sourceBlockSelectedRows_dataMatching r s d data₂))
  have hcolumns : data₁.2.1 = data₂.2.1 := by
    apply Subtype.ext
    exact
      (sourceBlockSelectedColumns_dataMatching r s d data₁).symm.trans
      ((congrArg (sourceBlockSelectedColumns r s d) hmatching).trans
        (sourceBlockSelectedColumns_dataMatching r s d data₂))
  rcases data₁ with ⟨I, ⟨J, components₁⟩⟩
  rcases data₂ with ⟨I', ⟨J', components₂⟩⟩
  change I = I' at hrows
  change J = J' at hcolumns
  subst I'
  subst J'
  change
    sourceBlockMatchingOf r s d I.val J.val
        components₁.1 components₁.2.1 components₁.2.2 =
      sourceBlockMatchingOf r s d I.val J.val
        components₂.1 components₂.2.1 components₂.2.2 at hmatching
  have hdata := sourceBlockMatchingOf_injective r s d I.val J.val hmatching
  exact congrArg
    (fun components :
      (I.val ≃ J.val) ×
        ({row : Fin r // row ∉ I.val} ≃ Fin (r - d)) ×
        (Fin (s - d) ≃ {column : Fin s // column ∉ J.val}) =>
      (⟨I, ⟨J, components⟩⟩ : SourceBlockMatchingData r s d))
    hdata

abbrev SourceBlockValidMatching (r s d : ℕ) : Type :=
  {matching :
    (Fin r ⊕ Fin (s - d)) ≃ (Fin s ⊕ Fin (r - d)) //
      ∀ row : Fin (s - d),
        ∃ column : Fin s, matching (.inr row) = .inl column}

noncomputable def sourceBlockDataValidMatching
    (r s d : ℕ) (data : SourceBlockMatchingData r s d) :
    SourceBlockValidMatching r s d :=
  ⟨sourceBlockDataMatching r s d data,
    sourceBlockMatchingOf_isValid r s d data.1.val data.2.1.val
      data.2.2.1 data.2.2.2.1 data.2.2.2.2⟩

theorem sourceBlockDataValidMatching_bijective
    (r s d : ℕ) (hr : d ≤ r) :
    Function.Bijective (sourceBlockDataValidMatching r s d) := by
  constructor
  · intro data₁ data₂ hdata
    apply sourceBlockDataMatching_injective r s d
    exact congrArg Subtype.val hdata
  · rintro ⟨matching, hvalid⟩
    let selectedRows :
        ((Finset.univ : Finset (Fin r)).powersetCard d) :=
      ⟨sourceBlockSelectedRows r s d matching, by
        rw [Finset.mem_powersetCard]
        exact ⟨Finset.subset_univ _,
          sourceBlockSelectedRows_card_of_valid r s d hr matching hvalid⟩⟩
    let selectedColumns :
        ((Finset.univ : Finset (Fin s)).powersetCard d) :=
      ⟨sourceBlockSelectedColumns r s d matching, by
        rw [Finset.mem_powersetCard]
        exact ⟨Finset.subset_univ _,
          sourceBlockSelectedColumns_card_of_valid r s d hr matching hvalid⟩⟩
    refine ⟨⟨selectedRows, ⟨selectedColumns,
      sourceBlockVariableMatchingOf r s d matching,
      sourceBlockConstantMatchingOf r s d matching hvalid,
      sourceBlockOnesMatchingOf r s d matching hvalid⟩⟩, ?_⟩
    apply Subtype.ext
    exact sourceBlockMatchingOf_recovered r s d matching hvalid

noncomputable def sourceBlockMatchingDataEquiv
    (r s d : ℕ) (hr : d ≤ r) :
    SourceBlockMatchingData r s d ≃ SourceBlockValidMatching r s d :=
  Equiv.ofBijective (sourceBlockDataValidMatching r s d)
    (sourceBlockDataValidMatching_bijective r s d hr)

theorem sourceBlockMatchingOf_weight
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R)
    (I : Finset (Fin r)) (J : Finset (Fin s))
    (variableMatching : I ≃ J)
    (constantMatching : {row : Fin r // row ∉ I} ≃ Fin (r - d))
    (onesMatching : Fin (s - d) ≃ {column : Fin s // column ∉ J}) :
    (∏ row, sourceBlockMatrix r s d X U row
      (sourceBlockMatchingOf r s d I J
        variableMatching constantMatching onesMatching row)) =
      (∏ row : I, X row.val (variableMatching row).val) *
        (∏ row : {row : Fin r // row ∉ I},
          U row.val (constantMatching row)) := by
  rw [Fintype.prod_sum_type]
  rw [← (Equiv.sumCompl (fun row : Fin r => row ∈ I)).prod_comp
    (fun row : Fin r =>
      sourceBlockMatrix r s d X U (.inl row)
        (sourceBlockMatchingOf r s d I J
          variableMatching constantMatching onesMatching (.inl row)))]
  rw [Fintype.prod_sum_type]
  simp only [Finset.univ_eq_attach, Equiv.sumCompl_apply_inl, sourceBlockMatchingOf_apply_selected,
    sourceBlockMatrix_apply₁₁, Equiv.sumCompl_apply_inr, sourceBlockMatchingOf_apply_complement,
    sourceBlockMatrix_apply₁₂, sourceBlockMatchingOf_apply_lower, sourceBlockMatrix_apply₂₁, Finset.prod_const_one,
    mul_one]

theorem sourceBlock_column_complement_card
    (s d : ℕ) (J : Finset (Fin s)) (hJ : J.card = d) :
    Fintype.card {column : Fin s // column ∉ J} = s - d := by
  rw [Fintype.card_subtype_compl (fun column : Fin s => column ∈ J)]
  simp only [Fintype.card_fin, Fintype.card_coe, hJ]

noncomputable def sourceBlockOnesEquiv
    (s d : ℕ) (J : Finset (Fin s)) (hJ : J.card = d) :
    Fin (s - d) ≃ {column : Fin s // column ∉ J} :=
  Fintype.equivOfCardEq (by
    simp only [Fintype.card_fin, sourceBlock_column_complement_card s d J hJ])

theorem sourceBlock_ones_matching_card
    (s d : ℕ) (J : Finset (Fin s)) (hJ : J.card = d) :
    Fintype.card
      (Fin (s - d) ≃ {column : Fin s // column ∉ J}) =
      (s - d).factorial := by
  simpa only [Fintype.card_fin] using Fintype.card_equiv (sourceBlockOnesEquiv s d J hJ)

private theorem sourceBlock_weighted_double_sum
    {α β R : Type*} [Fintype α] [Fintype β] [CommSemiring R]
    (c : R) (f : α → R) (g : β → R) :
    (∑ a : α, ∑ b : β, c * (f a * g b)) =
      c * ((∑ a : α, f a) * (∑ b : β, g b)) := by
  rw [Fintype.sum_mul_sum]
  simp_rw [Finset.mul_sum]

theorem sourceBlockMatchingOf_sum_weight
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R)
    (I : Finset (Fin r)) (J : Finset (Fin s))
    (hJ : J.card = d) :
    (∑ variableMatching : I ≃ J,
      ∑ constantMatching :
        {row : Fin r // row ∉ I} ≃ Fin (r - d),
      ∑ onesMatching :
        Fin (s - d) ≃ {column : Fin s // column ∉ J},
        ∏ row, sourceBlockMatrix r s d X U row
          (sourceBlockMatchingOf r s d I J
            variableMatching constantMatching onesMatching row)) =
      ((s - d).factorial : R) *
        (sourceBlockAlpha r d U I * sourceBlockMinor r s X I J) := by
  simp_rw [sourceBlockMatchingOf_weight]
  simp_rw [Finset.sum_const, nsmul_eq_mul, Finset.card_univ]
  rw [sourceBlock_ones_matching_card s d J hJ]
  rw [sourceBlock_weighted_double_sum]
  unfold sourceBlockAlpha sourceBlockMinor
  congr 1
  apply mul_comm

noncomputable def sourceBlockGluedFibre
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R)
    (I : Finset (Fin r)) (J : Finset (Fin s)) : R :=
  ∑ variableMatching : I ≃ J,
    ∑ constantMatching :
      {row : Fin r // row ∉ I} ≃ Fin (r - d),
      ∑ onesMatching :
        Fin (s - d) ≃ {column : Fin s // column ∉ J},
        ∏ row, sourceBlockMatrix r s d X U row
          (sourceBlockMatchingOf r s d I J
            variableMatching constantMatching onesMatching row)

theorem sourceBlockGluedFibre_eq
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R)
    (I : Finset (Fin r)) (J : Finset (Fin s))
    (hJ : J.card = d) :
    sourceBlockGluedFibre r s d X U I J =
      ((s - d).factorial : R) *
        (sourceBlockAlpha r d U I * sourceBlockMinor r s X I J) := by
  exact sourceBlockMatchingOf_sum_weight r s d X U I J hJ

theorem sourceBlockMatchingExpansion_eq_sum_glued_fibres
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R) :
    sourceBlockMatchingExpansion r s d X U =
      ∑ I ∈ (Finset.univ : Finset (Fin r)).powersetCard d,
        ∑ J ∈ (Finset.univ : Finset (Fin s)).powersetCard d,
          sourceBlockGluedFibre r s d X U I J := by
  unfold sourceBlockMatchingExpansion
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro I hI
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro J hJ
  exact (sourceBlockGluedFibre_eq r s d X U I J
    (Finset.mem_powersetCard.mp hJ).2).symm

theorem sourceBlockMatrix_matching_eq_zero_of_lower_right
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (row : Fin (s - d)) (column : Fin (r - d))
    (h : matching (.inr row) = .inr column) :
    (∏ i, sourceBlockMatrix r s d X U i (matching i)) = 0 := by
  classical
  apply Finset.prod_eq_zero (Finset.mem_univ (.inr row))
  simp only [h, sourceBlockMatrix_apply₂₂]

theorem sourceBlockMatrix_matching_eq_zero_of_invalid
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R)
    (matching : (Fin r ⊕ Fin (s - d)) ≃
      (Fin s ⊕ Fin (r - d)))
    (hinvalid : ¬ ∀ row : Fin (s - d),
      ∃ column : Fin s, matching (.inr row) = .inl column) :
    (∏ row, sourceBlockMatrix r s d X U row (matching row)) = 0 := by
  obtain ⟨row, hrow⟩ := not_forall.mp hinvalid
  cases hcolumn : matching (.inr row) with
  | inl column =>
      exact (hrow ⟨column, hcolumn⟩).elim
  | inr column =>
      exact sourceBlockMatrix_matching_eq_zero_of_lower_right
        r s d X U matching row column hcolumn

private theorem sourceBlock_sum_subtype_of_zero
    {α R : Type*} [Fintype α] [CommSemiring R]
    (p : α → Prop) (f : α → R)
    (hzero : ∀ a, ¬ p a → f a = 0) :
    (∑ a : α, f a) = ∑ a : {a : α // p a}, f a.val := by
  exact Finset.sum_congr_set {a | p a} f (fun a => f a.val)
    (fun _ _ => rfl) hzero

private theorem rectangularPermanent_sum_subtype_of_zero
    {α β R : Type*} [Fintype α] [Fintype β] [CommSemiring R]
    (A : Matrix α β R) (p : (α ≃ β) → Prop)
    (hzero : ∀ matching : α ≃ β,
      ¬ p matching → (∏ row, A row (matching row)) = 0) :
    rectangularPermanent A =
      ∑ matching : {matching : α ≃ β // p matching},
        ∏ row, A row (matching.val row) := by
  unfold rectangularPermanent
  exact sourceBlock_sum_subtype_of_zero p
    (fun matching : α ≃ β => ∏ row, A row (matching row)) hzero

theorem sourceBlockMatrix_permanent_eq_valid_sum
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R) :
    rectangularPermanent (sourceBlockMatrix r s d X U) =
      ∑ matching : SourceBlockValidMatching r s d,
        sourceBlockMatchingWeight r s d X U matching.val := by
  have hsum := rectangularPermanent_sum_subtype_of_zero
    (sourceBlockMatrix r s d X U)
    (fun matching => ∀ row : Fin (s - d),
      ∃ column : Fin s, matching (.inr row) = .inl column)
    (fun matching hinvalid =>
      sourceBlockMatrix_matching_eq_zero_of_invalid
        r s d X U matching hinvalid)
  unfold sourceBlockMatchingWeight
  convert hsum using 1
  apply Finset.sum_congr
  · ext matching
    simp only [Finset.mem_univ]
  · intro matching _
    rfl

theorem sourceBlockMatchingData_sum
    {R : Type*} [CommSemiring R] (r s d : ℕ)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R) :
    (∑ data : SourceBlockMatchingData r s d,
      sourceBlockMatchingWeight r s d X U
        (sourceBlockDataMatching r s d data)) =
      ∑ I ∈ (Finset.univ : Finset (Fin r)).powersetCard d,
        ∑ J ∈ (Finset.univ : Finset (Fin s)).powersetCard d,
          sourceBlockGluedFibre r s d X U I J := by
  simp only [Fintype.sum_sigma, Fintype.sum_prod_type,
    sourceBlockDataMatching, sourceBlockMatchingWeight]
  let rowSet : Finset (Finset (Fin r)) :=
    (Finset.univ : Finset (Fin r)).powersetCard d
  let columnSet : Finset (Finset (Fin s)) :=
    (Finset.univ : Finset (Fin s)).powersetCard d
  let rowFibre : Finset (Fin r) → R :=
    fun I => ∑ J : columnSet, sourceBlockGluedFibre r s d X U I J.val
  change
    (∑ I : rowSet, rowFibre I.val) =
      ∑ I ∈ rowSet,
        ∑ J ∈ columnSet,
          sourceBlockGluedFibre r s d X U I J
  rw [Finset.sum_coe_sort rowSet rowFibre]
  apply Finset.sum_congr rfl
  intro I hI
  exact Finset.sum_coe_sort columnSet
    (fun J => sourceBlockGluedFibre r s d X U I J)

theorem sourceBlockMatrix_permanent_eq_matchingExpansion
    {R : Type*} [CommSemiring R] (r s d : ℕ) (hr : d ≤ r)
    (X : Matrix (Fin r) (Fin s) R)
    (U : Matrix (Fin r) (Fin (r - d)) R) :
    rectangularPermanent (sourceBlockMatrix r s d X U) =
      sourceBlockMatchingExpansion r s d X U := by
  calc
    rectangularPermanent (sourceBlockMatrix r s d X U) =
        ∑ matching : SourceBlockValidMatching r s d,
          sourceBlockMatchingWeight r s d X U matching.val :=
      sourceBlockMatrix_permanent_eq_valid_sum r s d X U
    _ = ∑ data : SourceBlockMatchingData r s d,
          sourceBlockMatchingWeight r s d X U
            (sourceBlockDataMatching r s d data) := by
      symm
      exact Fintype.sum_equiv
        (sourceBlockMatchingDataEquiv r s d hr)
        (fun data : SourceBlockMatchingData r s d =>
          sourceBlockMatchingWeight r s d X U
            (sourceBlockDataMatching r s d data))
        (fun matching : SourceBlockValidMatching r s d =>
          sourceBlockMatchingWeight r s d X U matching.val)
        (fun _ => rfl)
    _ = ∑ I ∈ (Finset.univ : Finset (Fin r)).powersetCard d,
          ∑ J ∈ (Finset.univ : Finset (Fin s)).powersetCard d,
            sourceBlockGluedFibre r s d X U I J :=
      sourceBlockMatchingData_sum r s d X U
    _ = sourceBlockMatchingExpansion r s d X U :=
      (sourceBlockMatchingExpansion_eq_sum_glued_fibres r s d X U).symm

end Standalone_BlockPermanent

