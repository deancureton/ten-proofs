attribute [local instance] MvPolynomial.gradedAlgebra

theorem homogeneousMap_subalgebra_sub_target_mem_fiberIdeal
    {ι : Type*} [Finite ι]
    (F : ι → MvPolynomial ι ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : ι → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (target : ι → ℂ)
    (t : homogeneousMapSubalgebra F) :
    (t : MvPolynomial ι ℂ) -
        MvPolynomial.C
          (((MvPolynomial.aeval target).comp
            (homogeneousMapCoordinateAlgEquiv F e he hF hzero).symm.toAlgHom) t) ∈
      homogeneousMapFiberIdeal F target := by
  classical
  let T := homogeneousMapSubalgebra F
  let I := homogeneousMapFiberIdeal F target
  let E := homogeneousMapCoordinateAlgEquiv F e he hF hzero
  let φ : T →ₐ[ℂ] ℂ := (MvPolynomial.aeval target).comp E.symm
  change (t : MvPolynomial ι ℂ) - MvPolynomial.C (φ t) ∈ I
  obtain ⟨x, hx⟩ := t
  change x - MvPolynomial.C (φ ⟨x, hx⟩) ∈ I
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      have hcoordinate :
          E (MvPolynomial.X i) =
            ⟨F i, homogeneousMap_coordinate_mem_subalgebra F i⟩ := by
        apply Subtype.ext
        change MvPolynomial.bind₁ F (MvPolynomial.X i) = F i
        simp only [MvPolynomial.bind₁_X_right]
      have hφ : φ ⟨F i, homogeneousMap_coordinate_mem_subalgebra F i⟩ =
          target i := by
        change MvPolynomial.aeval target
          (E.symm ⟨F i, homogeneousMap_coordinate_mem_subalgebra F i⟩) = _
        rw [← hcoordinate, E.symm_apply_apply]
        simp only [MvPolynomial.aeval_X]
      rw [hφ]
      change F i - MvPolynomial.C (target i) ∈
        Ideal.span (Set.range fun j => F j - MvPolynomial.C (target j))
      exact Ideal.subset_span (Set.mem_range_self i)
  | algebraMap c =>
      change MvPolynomial.C c -
        MvPolynomial.C (φ (algebraMap ℂ T c)) ∈ I
      simp only [AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self, zero_mem]
  | add x y hx hy ihx ihy =>
      change x + y -
        MvPolynomial.C (φ (⟨x, hx⟩ + ⟨y, hy⟩)) ∈ I
      rw [map_add, map_add]
      convert I.add_mem ihx ihy using 1
      ring
  | mul x y hx hy ihx ihy =>
      change x * y -
        MvPolynomial.C (φ (⟨x, hx⟩ * ⟨y, hy⟩)) ∈ I
      rw [map_mul, map_mul]
      have hmem := I.add_mem (I.mul_mem_right y ihx)
        (I.mul_mem_left (MvPolynomial.C (φ ⟨x, hx⟩)) ihy)
      convert hmem using 1
      ring

theorem homogeneousMapFiber_finiteDimensional
    {ι : Type*} [Finite ι]
    (F : ι → MvPolynomial ι ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : ι → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (target : ι → ℂ) :
    FiniteDimensional ℂ
      (MvPolynomial ι ℂ ⧸ homogeneousMapFiberIdeal F target) := by
  classical
  let T := homogeneousMapSubalgebra F
  let S := MvPolynomial ι ℂ
  let I := homogeneousMapFiberIdeal F target
  let E := homogeneousMapCoordinateAlgEquiv F e he hF hzero
  let φ : T →ₐ[ℂ] ℂ := (MvPolynomial.aeval target).comp E.symm
  letI : RingHomSurjective φ.toRingHom :=
    ⟨by
      intro c
      refine ⟨algebraMap ℂ T c, ?_⟩
      exact φ.commutes c⟩
  letI : Module.Finite T S := homogeneousMap_moduleFinite F e he hF hzero
  let π : S →ₛₗ[φ.toRingHom] (S ⧸ I) :=
    { toFun := Ideal.Quotient.mk I
      map_add' := (Ideal.Quotient.mk I).map_add
      map_smul' := by
        intro t s
        change Ideal.Quotient.mk I ((t : S) * s) =
          φ t • (Ideal.Quotient.mkₐ ℂ I) s
        calc
          Ideal.Quotient.mk I ((t : S) * s) =
              Ideal.Quotient.mk I (MvPolynomial.C (φ t) * s) := by
            apply (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mpr
            rw [← sub_mul]
            apply I.mul_mem_right s
            exact homogeneousMap_subalgebra_sub_target_mem_fiberIdeal
              F e he hF hzero target t
          _ = φ t • (Ideal.Quotient.mkₐ ℂ I) s := by
            calc
              Ideal.Quotient.mk I (MvPolynomial.C (φ t) * s) =
                  (Ideal.Quotient.mkₐ ℂ I) (φ t • s) := by
                change Ideal.Quotient.mk I (MvPolynomial.C (φ t) * s) =
                  Ideal.Quotient.mk I (φ t • s)
                apply congrArg (Ideal.Quotient.mk I)
                exact (Algebra.smul_def (φ t) s).symm
              _ = φ t • (Ideal.Quotient.mkₐ ℂ I) s :=
                (Ideal.Quotient.mkₐ ℂ I).toLinearMap.map_smul (φ t) s }
  exact Module.Finite.of_surjective π Ideal.Quotient.mk_surjective

noncomputable def homogeneousPolynomialMulLinearMap
    {ι : Type*} (f : MvPolynomial ι ℂ) {e : ℕ}
    (hf : f.IsHomogeneous e) (n : ℕ) :
    MvPolynomial.homogeneousSubmodule ι ℂ n →ₗ[ℂ]
      MvPolynomial.homogeneousSubmodule ι ℂ (e + n) :=
  LinearMap.codRestrict (MvPolynomial.homogeneousSubmodule ι ℂ (e + n))
    ((Algebra.lmul ℂ (MvPolynomial ι ℂ) f).domRestrict
      (MvPolynomial.homogeneousSubmodule ι ℂ n))
    (fun p => hf.mul p.property)

noncomputable def homogeneousMapGradedIdealPiece
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ)) (n : ℕ) :
    Submodule ℂ (MvPolynomial.homogeneousSubmodule ι ℂ n) :=
  (I.restrictScalars ℂ).comap
    (MvPolynomial.homogeneousSubmodule ι ℂ n).subtype

abbrev homogeneousMapGradedQuotientPiece
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ)) (n : ℕ) : Type _ :=
  MvPolynomial.homogeneousSubmodule ι ℂ n ⧸
    homogeneousMapGradedIdealPiece I n

noncomputable def homogeneousMapGradedQuotientMulLinearMap
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ))
    (f : MvPolynomial ι ℂ) {e : ℕ} (hf : f.IsHomogeneous e) (n : ℕ) :
    homogeneousMapGradedQuotientPiece I n →ₗ[ℂ]
      homogeneousMapGradedQuotientPiece I (e + n) :=
  (homogeneousMapGradedIdealPiece I n).mapQ
    (homogeneousMapGradedIdealPiece I (e + n))
    (homogeneousPolynomialMulLinearMap f hf n)
    (by
      intro p hp
      change f * (p : MvPolynomial ι ℂ) ∈ I
      exact I.mul_mem_left f hp)

theorem homogeneousMapGradedQuotientMulLinearMap_injective_iff
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ))
    (f : MvPolynomial ι ℂ) {e : ℕ} (hf : f.IsHomogeneous e) (n : ℕ) :
    Function.Injective (homogeneousMapGradedQuotientMulLinearMap I f hf n) ↔
      ∀ p : MvPolynomial.homogeneousSubmodule ι ℂ n,
        f * (p : MvPolynomial ι ℂ) ∈ I →
          (p : MvPolynomial ι ℂ) ∈ I := by
  constructor
  · intro hinj p hp
    have hmul :
        (homogeneousMapGradedQuotientMulLinearMap I f hf n)
          (Submodule.Quotient.mk p) = 0 := by
      change Submodule.Quotient.mk
        (homogeneousPolynomialMulLinearMap f hf n p) = 0
      apply (Submodule.Quotient.mk_eq_zero _).mpr
      exact hp
    have hz :
        (Submodule.Quotient.mk p : homogeneousMapGradedQuotientPiece I n) = 0 :=
      hinj (hmul.trans (map_zero _).symm)
    change p ∈ homogeneousMapGradedIdealPiece I n
    exact (Submodule.Quotient.mk_eq_zero
      (homogeneousMapGradedIdealPiece I n)).mp hz
  · intro hcolon
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro x hx
    induction x using Submodule.Quotient.induction_on with
    | _ p =>
      apply (Submodule.Quotient.mk_eq_zero _).mpr
      apply hcolon
      change Submodule.Quotient.mk
        (homogeneousPolynomialMulLinearMap f hf n p) = 0 at hx
      change homogeneousPolynomialMulLinearMap f hf n p ∈
        homogeneousMapGradedIdealPiece I (e + n)
      exact (Submodule.Quotient.mk_eq_zero
        (homogeneousMapGradedIdealPiece I (e + n))).mp hx

theorem isSMulRegular_iff_avoid_associatedPrimes
    {R M : Type*} [CommRing R] [IsNoetherianRing R]
    [AddCommGroup M] [Module R M] (r : R) :
    IsSMulRegular M r ↔
      ∀ P ∈ associatedPrimes R M, r ∉ P := by
  have heq := biUnion_associatedPrimes_eq_compl_regular R M
  constructor
  · intro hregular P hP hrP
    have hunion : r ∈ ⋃ Q ∈ associatedPrimes R M, Q :=
      Set.mem_iUnion₂_of_mem hP hrP
    have hnot : r ∈ {x : R | IsSMulRegular M x}ᶜ :=
      heq ▸ hunion
    exact hnot hregular
  · intro havoid
    by_contra hnot
    have hcompl : r ∈ {x : R | IsSMulRegular M x}ᶜ := hnot
    have hunion : r ∈ ⋃ Q ∈ associatedPrimes R M, Q :=
      heq.symm ▸ hcompl
    obtain ⟨P, hP⟩ := Set.mem_iUnion.mp hunion
    obtain ⟨hassoc, hrP⟩ := Set.mem_iUnion.mp hP
    exact havoid P hassoc hrP

theorem isSMulRegular_of_maximal_radical_and_regular_witness
    {R : Type*} [CommRing R] [IsNoetherianRing R]
    (I : Ideal R) (g ell : R) (m : Ideal R)
    (hm : m.IsMaximal)
    (hrad : (I ⊔ Ideal.span ({g} : Set R)).radical = m)
    (hellm : ell ∈ m)
    (hellregular : IsSMulRegular (R ⧸ I) ell) :
    IsSMulRegular (R ⧸ I) g := by
  apply (isSMulRegular_iff_avoid_associatedPrimes g).mpr
  intro P hP hgP
  have hPassociated : IsAssociatedPrime P (R ⧸ I) := hP
  have hPprime : P.IsPrime := hPassociated.isPrime
  have hIP : I ≤ P := by
    have hann := hPassociated.annihilator_le
    simpa only [ge_iff_le, Submodule.annihilator_top, Ideal.annihilator_quotient] using hann
  have hsupP : I ⊔ Ideal.span ({g} : Set R) ≤ P := by
    apply sup_le hIP
    exact Ideal.span_le.mpr (by simpa only [Set.singleton_subset_iff, SetLike.mem_coe] using hgP)
  have hmP : m ≤ P := by
    rw [← hrad]
    exact hPprime.radical_le_iff.mpr hsupP
  have heq : m = P := hm.eq_of_le hPprime.ne_top hmP
  have hellP : ell ∈ P := heq ▸ hellm
  exact ((isSMulRegular_iff_avoid_associatedPrimes ell).mp
    hellregular) P hP hellP

theorem homogeneousMapGradedQuotientMulLinearMap_finrank_quotient_add_kernel
    {ι : Type*} [Finite ι] (I : Ideal (MvPolynomial ι ℂ))
    (f : MvPolynomial ι ℂ) {e : ℕ} (hf : f.IsHomogeneous e) (n : ℕ) :
    Module.finrank ℂ
        (homogeneousMapGradedQuotientPiece I (e + n) ⧸
          LinearMap.range
            (homogeneousMapGradedQuotientMulLinearMap I f hf n)) +
      Module.finrank ℂ (homogeneousMapGradedQuotientPiece I n) =
        Module.finrank ℂ (homogeneousMapGradedQuotientPiece I (e + n)) +
          Module.finrank ℂ
            (LinearMap.ker
              (homogeneousMapGradedQuotientMulLinearMap I f hf n)) := by
  letI : Module.Finite ℂ (MvPolynomial.homogeneousSubmodule ι ℂ n) :=
    (Submodule.fg_iff_finiteDimensional _).mp
      (MvPolynomial.homogeneousSubmodule_fg ι ℂ n)
  letI : Module.Finite ℂ (MvPolynomial.homogeneousSubmodule ι ℂ (e + n)) :=
    (Submodule.fg_iff_finiteDimensional _).mp
      (MvPolynomial.homogeneousSubmodule_fg ι ℂ (e + n))
  let m := homogeneousMapGradedQuotientMulLinearMap I f hf n
  have hrange :=
    Submodule.finrank_quotient_add_finrank (LinearMap.range m)
  have hkernel := LinearMap.finrank_range_add_finrank_ker m
  dsimp [m] at hrange hkernel
  omega

theorem homogeneousMapGradedQuotientMulLinearMap_finrank_quotient_add
    {ι : Type*} [Finite ι] (I : Ideal (MvPolynomial ι ℂ))
    (f : MvPolynomial ι ℂ) {e : ℕ} (hf : f.IsHomogeneous e) (n : ℕ)
    (hcolon : ∀ p : MvPolynomial.homogeneousSubmodule ι ℂ n,
      f * (p : MvPolynomial ι ℂ) ∈ I →
        (p : MvPolynomial ι ℂ) ∈ I) :
    Module.finrank ℂ
        (homogeneousMapGradedQuotientPiece I (e + n) ⧸
          LinearMap.range
            (homogeneousMapGradedQuotientMulLinearMap I f hf n)) +
      Module.finrank ℂ (homogeneousMapGradedQuotientPiece I n) =
        Module.finrank ℂ (homogeneousMapGradedQuotientPiece I (e + n)) := by
  have hinj :=
    (homogeneousMapGradedQuotientMulLinearMap_injective_iff
      I f hf n).mpr hcolon
  have hker :
      LinearMap.ker
        (homogeneousMapGradedQuotientMulLinearMap I f hf n) = ⊥ :=
    LinearMap.ker_eq_bot.mpr hinj
  have hkerfin :
      Module.finrank ℂ
        (LinearMap.ker
          (homogeneousMapGradedQuotientMulLinearMap I f hf n)) = 0 := by
    rw [hker]
    exact finrank_bot ℂ _
  have hrec :=
    homogeneousMapGradedQuotientMulLinearMap_finrank_quotient_add_kernel
      I f hf n
  omega

theorem homogeneousMap_degreeSupport_eq_antidiagonal
    {ι : Type*} [Fintype ι] [DecidableEq ι] (n : ℕ) :
    {d : ι →₀ ℕ | d.degree = n} =
      (((Finset.univ : Finset ι).finsuppAntidiag n : Finset (ι →₀ ℕ)) :
        Set (ι →₀ ℕ)) := by
  classical
  ext d
  simp only [Finsupp.degree_eq_sum, Set.mem_setOf_eq, SetLike.mem_coe, Finset.mem_finsuppAntidiag,
    Finset.subset_univ, and_true]

theorem homogeneousMap_homogeneousSubmodule_finrank
    {ι : Type*} [Fintype ι] (n : ℕ) :
    Module.finrank ℂ (MvPolynomial.homogeneousSubmodule ι ℂ n) =
      (Fintype.card ι + n - 1).choose n := by
  classical
  let a : Finset (ι →₀ ℕ) :=
    (Finset.univ : Finset ι).finsuppAntidiag n
  have ha : {d : ι →₀ ℕ | d.degree = n} =
      (a : Set (ι →₀ ℕ)) :=
    homogeneousMap_degreeSupport_eq_antidiagonal n
  rw [MvPolynomial.homogeneousSubmodule_eq_finsupp_supported, ha]
  change Module.finrank ℂ
    (MvPolynomial.restrictSupport ℂ (a : Set (ι →₀ ℕ))) =
      (Fintype.card ι + n - 1).choose n
  rw [Module.finrank_eq_card_finset_basis
    (MvPolynomial.basisRestrictSupport ℂ (a : Set (ι →₀ ℕ)))]
  exact Finset.card_finsuppAntidiag_nat_eq_choose n

theorem homogeneousMap_coordinateSubset_quotient_ringKrullDim_le
    {ι : Type*} [Fintype ι]
    (F : ι → MvPolynomial ι ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : ι → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (coordinates : Finset ι) :
    ringKrullDim
      (MvPolynomial ι ℂ ⧸
        Ideal.span (F '' (coordinates : Set ι))) ≤
      ((Fintype.card ι - coordinates.card : ℕ) : WithBot ℕ∞) := by
  classical
  let R := MvPolynomial ι ℂ
  let T := homogeneousMapSubalgebra F
  let J : Ideal R := Ideal.span (F '' (coordinates : Set ι))
  let P : Ideal T := J.comap (algebraMap T R)
  let E : MvPolynomial ι ℂ ≃ₐ[ℂ] T :=
    homogeneousMapCoordinateAlgEquiv F e he hF hzero
  letI : Algebra.IsIntegral T R :=
    homogeneousMap_isIntegral F e he hF hzero
  letI : Algebra.IsIntegral (T ⧸ P) (R ⧸ J) :=
    Algebra.IsIntegral.quotient
  let remaining := {i : ι // i ∉ coordinates}
  let psi : MvPolynomial ι ℂ →ₐ[ℂ] T ⧸ P :=
    (Ideal.Quotient.mkₐ ℂ P).comp E.toAlgHom
  let phi : MvPolynomial remaining ℂ →ₐ[ℂ] T ⧸ P :=
    MvPolynomial.aeval fun i : remaining =>
      psi (MvPolynomial.X i.val)
  have hpsi_coordinate (i : ι) (hi : i ∈ coordinates) :
      psi (MvPolynomial.X i) = 0 := by
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    change (E (MvPolynomial.X i) : R) ∈ J
    change MvPolynomial.aeval F (MvPolynomial.X i) ∈ J
    simp only [MvPolynomial.aeval_X]
    exact Ideal.subset_span ⟨i, hi, rfl⟩
  have hsurj : Function.Surjective phi := by
    have hpsisurj : Function.Surjective psi :=
      (Ideal.Quotient.mkₐ_surjective ℂ P).comp E.surjective
    have hrange : psi.range ≤ phi.range := by
      rintro x ⟨f, rfl⟩
      induction f using MvPolynomial.induction_on with
      | C c =>
          change psi (MvPolynomial.C c) ∈ phi.range
          simp only [MvPolynomial.algHom_C, algebraMap_mem]
      | add f g hf hg =>
          rw [map_add]
          exact phi.range.add_mem hf hg
      | mul_X f i hf =>
          rw [map_mul]
          apply phi.range.mul_mem hf
          by_cases hi : i ∈ coordinates
          · change psi (MvPolynomial.X i) ∈ phi.range
            rw [hpsi_coordinate i hi]
            exact phi.range.zero_mem
          · change psi (MvPolynomial.X i) ∈ phi.range
            exact ⟨MvPolynomial.X (⟨i, hi⟩ : remaining), by
              simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X, phi]⟩
    intro x
    obtain ⟨f, hf⟩ := hpsisurj x
    have hx : x ∈ psi.range := ⟨f, hf⟩
    exact hrange hx
  change ringKrullDim (R ⧸ J) ≤ _
  calc
    ringKrullDim (R ⧸ J) ≤ ringKrullDim (T ⧸ P) :=
      ringKrullDim_le_of_isIntegral (R := T ⧸ P) (S := R ⧸ J)
    _ ≤ ringKrullDim (MvPolynomial remaining ℂ) :=
      ringKrullDim_le_of_surjective phi.toRingHom hsurj
    _ = ((Fintype.card ι - coordinates.card : ℕ) : WithBot ℕ∞) := by
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing,
        ringKrullDim_eq_zero_of_field, Nat.card_eq_fintype_card]
      simp only [zero_add]
      congr 1
      simp only [Fintype.card_subtype_compl, Fintype.card_coe, remaining]

theorem homogeneousMap_exists_coordinateSubset_independent_linear_origin_slices
    {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (coordinates : Finset (Fin k)) :
    ∃ c : Fin (k - coordinates.card) → Fin k → ℂ,
      LinearIndependent ℂ c ∧
      MvPolynomial.zeroLocus ℂ
        (homogeneousLinearSliceIdeal
          (Ideal.span (F '' (coordinates : Set (Fin k)))) c) =
        ({0} : Set (Fin k → ℂ)) := by
  classical
  let I : Ideal (MvPolynomial (Fin k) ℂ) :=
    Ideal.span (F '' (coordinates : Set (Fin k)))
  have hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin k) ℂ) := by
    apply Ideal.homogeneous_span
    rintro _ ⟨i, _, rfl⟩
    exact ⟨e, hF i⟩
  have hproper : I ≠ ⊤ := by
    intro htop
    have hone : (1 : MvPolynomial (Fin k) ℂ) ∈ I := by
      simp only [htop, Submodule.mem_top]
    have hcontain : I ≤
        RingHom.ker (MvPolynomial.eval (0 : Fin k → ℂ)) := by
      rw [show I = Ideal.span
        (F '' (coordinates : Set (Fin k))) by rfl,
        Ideal.span_le]
      rintro _ ⟨i, _, rfl⟩
      exact homogeneous_eval_zero_of_pos he (hF i)
    have hbad := hcontain hone
    simp only [MvPolynomial.eval_zero, RingHom.mem_ker, map_one, one_ne_zero] at hbad
  have hdim :
      ringKrullDim (MvPolynomial (Fin k) ℂ ⧸ I) ≤
        ((k - coordinates.card : ℕ) : WithBot ℕ∞) := by
    simpa only [Fintype.card_fin] using
      (homogeneousMap_coordinateSubset_quotient_ringKrullDim_le F e he hF hzero coordinates)
  exact homogeneousIdeal_exists_independent_linear_origin_slices
    I hI hproper (Nat.sub_le _ _) hdim

noncomputable def homogeneousMapFiniteGradedQuotientSumLinearMap
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ)) (N : ℕ) :
    ((i : Fin N) → homogeneousMapGradedQuotientPiece I i) →ₗ[ℂ]
      (MvPolynomial ι ℂ ⧸ I) :=
  Submodule.piQuotientLift
    (fun i : Fin N => homogeneousMapGradedIdealPiece I i)
    (I.restrictScalars ℂ)
    (fun i : Fin N =>
      (MvPolynomial.homogeneousSubmodule ι ℂ i).subtype)
    (fun i => show homogeneousMapGradedIdealPiece I i ≤
      (I.restrictScalars ℂ).comap
        (MvPolynomial.homogeneousSubmodule ι ℂ i).subtype from le_rfl)

theorem homogeneousMapFiniteGradedQuotientSumLinearMap_injective
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ))
    (hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule ι ℂ))
    (N : ℕ) :
    Function.Injective (homogeneousMapFiniteGradedQuotientSumLinearMap I N) := by
  classical
  intro x y hxy
  have hx :
      homogeneousMapFiniteGradedQuotientSumLinearMap I N (x - y) = 0 := by
    calc
      homogeneousMapFiniteGradedQuotientSumLinearMap I N (x - y) =
          homogeneousMapFiniteGradedQuotientSumLinearMap I N x -
            homogeneousMapFiniteGradedQuotientSumLinearMap I N y :=
        (homogeneousMapFiniteGradedQuotientSumLinearMap I N).map_sub x y
      _ = 0 := sub_eq_zero.mpr hxy
  let z := x - y
  have hz : homogeneousMapFiniteGradedQuotientSumLinearMap I N z = 0 := hx
  choose p hp using fun i : Fin N =>
    (homogeneousMapGradedIdealPiece I i).mkQ_surjective (z i)
  have hzp : z = fun i : Fin N => Submodule.Quotient.mk (p i) :=
    funext fun i => (hp i).symm
  rw [hzp] at hz
  change
    Submodule.piQuotientLift
      (fun i : Fin N => homogeneousMapGradedIdealPiece I i)
      (I.restrictScalars ℂ)
      (fun i : Fin N =>
        (MvPolynomial.homogeneousSubmodule ι ℂ i).subtype)
      (fun i => show homogeneousMapGradedIdealPiece I i ≤
        (I.restrictScalars ℂ).comap
          (MvPolynomial.homogeneousSubmodule ι ℂ i).subtype from le_rfl)
      (fun i => Submodule.Quotient.mk (p i)) = 0 at hz
  rw [Submodule.piQuotientLift_mk] at hz
  have hsum := (Submodule.Quotient.mk_eq_zero
    (I.restrictScalars ℂ)).mp hz
  simp only [LinearMap.lsum_apply, LinearMap.coe_sum, LinearMap.coe_comp, Submodule.coe_subtype,
    LinearMap.coe_proj, Finset.sum_apply, Function.comp_apply, Function.eval, Submodule.restrictScalars_mem] at hsum
  have hz0 : z = 0 := by
    apply funext
    intro i
    rw [Pi.zero_apply]
    rw [hzp]
    apply (Submodule.Quotient.mk_eq_zero
      (homogeneousMapGradedIdealPiece I i)).mpr
    have hcomponent :=
      MvPolynomial.homogeneousComponent_mem_of_mem hI hsum (i : ℕ)
    have hcomponent_eq :
        MvPolynomial.homogeneousComponent (i : ℕ)
          (∑ j : Fin N, (p j : MvPolynomial ι ℂ)) = p i := by
      rw [map_sum]
      calc
        (∑ j : Fin N,
          MvPolynomial.homogeneousComponent (i : ℕ)
            (p j : MvPolynomial ι ℂ)) =
            ∑ j : Fin N,
              if (i : ℕ) = (j : ℕ) then
                (p j : MvPolynomial ι ℂ) else 0 := by
          apply Finset.sum_congr rfl
          intro j _
          exact MvPolynomial.homogeneousComponent_of_mem (p j).property
        _ = (if (i : ℕ) = (i : ℕ) then
              (p i : MvPolynomial ι ℂ) else 0) := by
          apply Finset.sum_eq_single i
          · intro j _ hj
            rw [if_neg]
            intro hij
            exact hj (Fin.ext hij.symm)
          · simp only [Finset.mem_univ, not_true_eq_false, ↓reduceIte, ZeroMemClass.coe_eq_zero, IsEmpty.forall_iff]
        _ = p i := if_pos rfl
    rw [hcomponent_eq] at hcomponent
    exact hcomponent
  exact sub_eq_zero.mp hz0

theorem homogeneousMapFiniteGradedQuotientSumLinearMap_surjective
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ)) (N : ℕ)
    (hhigh : ∀ n : ℕ, N ≤ n →
      ∀ p : MvPolynomial ι ℂ, p.IsHomogeneous n → p ∈ I) :
    Function.Surjective
      (homogeneousMapFiniteGradedQuotientSumLinearMap I N) := by
  classical
  intro x
  induction x using Submodule.Quotient.induction_on with
  | _ p =>
    let q : (i : Fin N) →
        MvPolynomial.homogeneousSubmodule ι ℂ i :=
      fun i => ⟨MvPolynomial.homogeneousComponent i p,
        MvPolynomial.homogeneousComponent_isHomogeneous i p⟩
    refine ⟨fun i => Submodule.Quotient.mk (q i), ?_⟩
    change
      Submodule.piQuotientLift
        (fun i : Fin N => homogeneousMapGradedIdealPiece I i)
        (I.restrictScalars ℂ)
        (fun i : Fin N =>
          (MvPolynomial.homogeneousSubmodule ι ℂ i).subtype)
        (fun i => show homogeneousMapGradedIdealPiece I i ≤
          (I.restrictScalars ℂ).comap
            (MvPolynomial.homogeneousSubmodule ι ℂ i).subtype from le_rfl)
        (fun i => Submodule.Quotient.mk (q i)) =
          Submodule.Quotient.mk p
    rw [Submodule.piQuotientLift_mk]
    apply (Submodule.Quotient.eq (I.restrictScalars ℂ)).mpr
    have hfull :
        (∑ j ∈ Finset.range (N + (p.totalDegree + 1)),
          MvPolynomial.homogeneousComponent j p) = p := by
      have htailzero :
          (∑ j ∈ Finset.range N,
            MvPolynomial.homogeneousComponent
              (p.totalDegree + 1 + j) p) = 0 := by
        apply Finset.sum_eq_zero
        intro j _
        apply MvPolynomial.homogeneousComponent_eq_zero
        omega
      rw [Nat.add_comm, Finset.sum_range_add]
      rw [MvPolynomial.sum_homogeneousComponent]
      rw [htailzero, add_zero]
    have hsplit :
        p = (∑ i : Fin N, (q i : MvPolynomial ι ℂ)) +
          ∑ j ∈ Finset.range (p.totalDegree + 1),
            MvPolynomial.homogeneousComponent (N + j) p := by
      calc
        p = (∑ j ∈ Finset.range (N + (p.totalDegree + 1)),
          MvPolynomial.homogeneousComponent j p) := hfull.symm
        _ = (∑ j ∈ Finset.range N,
              MvPolynomial.homogeneousComponent j p) +
            ∑ j ∈ Finset.range (p.totalDegree + 1),
              MvPolynomial.homogeneousComponent (N + j) p :=
          Finset.sum_range_add _ _ _
        _ = (∑ i : Fin N, (q i : MvPolynomial ι ℂ)) +
            ∑ j ∈ Finset.range (p.totalDegree + 1),
              MvPolynomial.homogeneousComponent (N + j) p := by
          congr 1
          change
            (∑ j ∈ Finset.range N,
              MvPolynomial.homogeneousComponent j p) =
                ∑ i : Fin N, MvPolynomial.homogeneousComponent (i : ℕ) p
          exact
            (Fin.sum_univ_eq_sum_range
              (fun j => MvPolynomial.homogeneousComponent j p) N).symm
    have htail :
        (∑ j ∈ Finset.range (p.totalDegree + 1),
          MvPolynomial.homogeneousComponent (N + j) p) ∈ I := by
      apply Ideal.sum_mem
      intro j _
      apply hhigh (N + j) (Nat.le_add_right N j)
      exact MvPolynomial.homogeneousComponent_isHomogeneous (N + j) p
    simp only [LinearMap.lsum_apply, LinearMap.coe_sum, LinearMap.coe_comp, Submodule.coe_subtype,
      LinearMap.coe_proj, Finset.sum_apply, Function.comp_apply, Function.eval, Submodule.restrictScalars_mem]
    rw [hsplit]
    simpa only [sub_add_cancel_left, neg_mem_iff] using I.neg_mem htail

noncomputable def homogeneousMapFiniteGradedQuotientEquiv
    {ι : Type*} (I : Ideal (MvPolynomial ι ℂ))
    (hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule ι ℂ))
    (N : ℕ)
    (hhigh : ∀ n : ℕ, N ≤ n →
      ∀ p : MvPolynomial ι ℂ, p.IsHomogeneous n → p ∈ I) :
    ((i : Fin N) → homogeneousMapGradedQuotientPiece I i) ≃ₗ[ℂ]
      (MvPolynomial ι ℂ ⧸ I) :=
  LinearEquiv.ofBijective
    (homogeneousMapFiniteGradedQuotientSumLinearMap I N)
    ⟨homogeneousMapFiniteGradedQuotientSumLinearMap_injective I hI N,
      homogeneousMapFiniteGradedQuotientSumLinearMap_surjective I N hhigh⟩

theorem homogeneousMapFiniteGradedQuotient_finrank_eq_sum
    {ι : Type*} [Finite ι] (I : Ideal (MvPolynomial ι ℂ))
    (hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule ι ℂ))
    (N : ℕ)
    (hhigh : ∀ n : ℕ, N ≤ n →
      ∀ p : MvPolynomial ι ℂ, p.IsHomogeneous n → p ∈ I) :
    Module.finrank ℂ (MvPolynomial ι ℂ ⧸ I) =
      ∑ i : Fin N,
        Module.finrank ℂ (homogeneousMapGradedQuotientPiece I i) := by
  classical
  letI (i : Fin N) :
      Module.Finite ℂ (MvPolynomial.homogeneousSubmodule ι ℂ (i : ℕ)) :=
    (Submodule.fg_iff_finiteDimensional _).mp
      (MvPolynomial.homogeneousSubmodule_fg ι ℂ i)
  letI (i : Fin N) :
      Module.Finite ℂ (homogeneousMapGradedQuotientPiece I i) :=
    inferInstance
  letI (i : Fin N) :
      Module.Free ℂ (homogeneousMapGradedQuotientPiece I i) :=
    Module.Free.of_divisionRing ℂ (homogeneousMapGradedQuotientPiece I i)
  let E := homogeneousMapFiniteGradedQuotientEquiv I hI N hhigh
  calc
    Module.finrank ℂ (MvPolynomial ι ℂ ⧸ I) =
        Module.finrank ℂ
          ((i : Fin N) → homogeneousMapGradedQuotientPiece I i) :=
      E.finrank_eq.symm
    _ = ∑ i : Fin N,
        Module.finrank ℂ (homogeneousMapGradedQuotientPiece I i) :=
      Module.finrank_pi_fintype ℂ

theorem homogeneousComponent_mul_of_right_isHomogeneous_of_lt
    {ι : Type*} (g f : MvPolynomial ι ℂ) {e n : ℕ}
    (hf : f.IsHomogeneous e) (hn : n < e) :
    MvPolynomial.homogeneousComponent n (g * f) = 0 := by
  have hcomponent (q : MvPolynomial ι ℂ) (j : ℕ) :
      (DirectSum.decompose
        (MvPolynomial.homogeneousSubmodule ι ℂ) q j :
          MvPolynomial ι ℂ) = MvPolynomial.homogeneousComponent j q := by
    change
      (((inferInstance : DirectSum.Decomposition
        (MvPolynomial.homogeneousSubmodule ι ℂ)).decompose' q j :
          MvPolynomial ι ℂ)) = _
    rw [show (inferInstance : DirectSum.Decomposition
      (MvPolynomial.homogeneousSubmodule ι ℂ)) =
        MvPolynomial.decomposition from Subsingleton.elim _ _]
    exact MvPolynomial.decomposition.decompose'_apply q j
  have hprojection :=
    DirectSum.coe_decompose_mul_of_right_mem_of_not_le
      (𝒜 := MvPolynomial.homogeneousSubmodule ι ℂ)
      (a := g) (b := f) (n := n) (i := e) hf (by omega)
  simpa only [hcomponent] using hprojection

