namespace MvPolynomial.IsWeightedHomogeneous

theorem eq_monomial_of_unique_weight
    {σ R M : Type*} [CommSemiring R] [AddCommMonoid M]
    {w : σ → M} {p : MvPolynomial σ R} {m : M} {d : σ →₀ ℕ}
    (hp : MvPolynomial.IsWeightedHomogeneous w p m)
    (hunique : ∀ b : σ →₀ ℕ, Finsupp.weight w b = m → b = d) :
    p = MvPolynomial.monomial d (MvPolynomial.coeff d p) := by
  classical
  apply MvPolynomial.ext
  intro b
  by_cases h : b = d
  · subst b
    simp only [coeff_monomial, ↓reduceIte]
  · have hz : MvPolynomial.coeff b p = 0 := by
      by_contra hb
      exact h (hunique b (hp hb))
    rw [MvPolynomial.coeff_monomial, if_neg (Ne.symm h), hz]

end MvPolynomial.IsWeightedHomogeneous

namespace Finset

noncomputable def equivMap {α β : Type*}
    (f : α ↪ β) (s : Finset α) : s ≃ s.map f :=
  Equiv.ofBijective
    (fun a : s =>
      (⟨f a, Finset.mem_map.mpr ⟨a, a.property, rfl⟩⟩ : s.map f))
    ⟨by
      intro a b h
      apply Subtype.ext
      exact f.injective (congrArg Subtype.val h), by
      intro b
      obtain ⟨a, ha, hab⟩ := Finset.mem_map.mp b.property
      exact ⟨⟨a, ha⟩, Subtype.ext hab⟩⟩

end Finset

namespace PermanentCircuitCompatibility

theorem ofList_take_succ {R : Type*} [CommRing R]
    {k : ℕ} (G : Fin k → R) (j : ℕ) (hj : j < k) :
    Ideal.ofList ((List.ofFn G).take j) ⊔
        Ideal.span ({G ⟨j, hj⟩} : Set R) =
      Ideal.ofList ((List.ofFn G).take (j + 1)) := by
  rw [List.take_succ_eq_append_getElem
    (show j < (List.ofFn G).length by
      simpa only [List.length_ofFn] using hj)]
  rw [Ideal.ofList_append, Ideal.ofList_singleton]
  simp only [List.getElem_ofFn]

end PermanentCircuitCompatibility

namespace PermanentRollout

section Standalone_PermanentRolloutRoot

open scoped BigOperators

inductive Instruction (ι : Type) where
  | input (i : ι)
  | scalar (c : ℂ)
  | add (left right : ℕ)
  | sub (left right : ℕ)
  | mul (left right : ℕ)

def Instruction.referencesBounded {ι : Type} (position : ℕ) : Instruction ι → Bool
  | .input _ => true
  | .scalar _ => true
  | .add left right => left < position && right < position
  | .sub left right => left < position && right < position
  | .mul left right => left < position && right < position

def Instruction.isArithmetic {ι : Type} : Instruction ι → Bool
  | .input _ => false
  | .scalar _ => false
  | .add _ _ => true
  | .sub _ _ => true
  | .mul _ _ => true

noncomputable def Instruction.eval {ι : Type}
    (values : Array (MvPolynomial ι ℂ)) : Instruction ι → MvPolynomial ι ℂ
  | .input i => MvPolynomial.X i
  | .scalar c => MvPolynomial.C c
  | .add left right => values.getD left 0 + values.getD right 0
  | .sub left right => values.getD left 0 - values.getD right 0
  | .mul left right => values.getD left 0 * values.getD right 0

structure ArithmeticCircuit (ι : Type) where
  program : List (Instruction ι)
  output : ℕ
  output_lt : output < program.length
  valid : ∀ position : Fin program.length,
    (program.get position).referencesBounded position.val

noncomputable def ArithmeticCircuit.values {ι : Type}
    (circuit : ArithmeticCircuit ι) : Array (MvPolynomial ι ℂ) :=
  circuit.program.foldl
    (fun values instruction => values.push (instruction.eval values)) #[]

noncomputable def ArithmeticCircuit.polynomial {ι : Type}
    (circuit : ArithmeticCircuit ι) : MvPolynomial ι ℂ :=
  circuit.values.getD circuit.output 0

def ArithmeticCircuit.size {ι : Type} (circuit : ArithmeticCircuit ι) : ℕ :=
  (circuit.program.filter Instruction.isArithmetic).length

noncomputable def circuitComplexity {ι : Type} (f : MvPolynomial ι ℂ) : ℕ :=
  sInf {size : ℕ | ∃ circuit : ArithmeticCircuit ι,
    circuit.polynomial = f ∧ circuit.size = size}

noncomputable def permanent (n : ℕ) : MvPolynomial (Fin n × Fin n) ℂ :=
  Matrix.permanent (fun row column => MvPolynomial.X (row, column))

noncomputable def minorSum (t s d : ℕ) : MvPolynomial (Fin t × Fin s) ℂ :=
  ∑ rows ∈ (Finset.univ : Finset (Fin t)).powersetCard d,
    ∑ columns ∈ (Finset.univ : Finset (Fin s)).powersetCard d,
      ∑ matching : rows ≃ columns,
        ∏ row : rows, MvPolynomial.X (row.val, (matching row).val)

noncomputable def powerSum (t s : ℕ) (rows : Finset (Fin t)) :
    MvPolynomial (Fin t × Fin s) ℂ :=
  ∑ column : Fin s, ∏ row ∈ rows, MvPolynomial.X (row, column)

noncomputable def criticalLocus {ι : Type}
    (P : MvPolynomial ι ℂ) : Set (ι → ℂ) :=
  {point | ∀ i : ι, MvPolynomial.eval point (MvPolynomial.pderiv i P) = 0}

end Standalone_PermanentRolloutRoot

section Standalone_Geometry

open scoped BigOperators

@[simp] theorem mem_criticalLocus_iff {ι : Type} (P : MvPolynomial ι ℂ)
    (point : ι → ℂ) :
    point ∈ criticalLocus P ↔
      ∀ i : ι, MvPolynomial.eval point (MvPolynomial.pderiv i P) = 0 := by
  rfl

theorem criticalLocus_eq_zeroLocus_pderiv_span {ι : Type} (P : MvPolynomial ι ℂ) :
    criticalLocus P =
      MvPolynomial.zeroLocus ℂ
        (Ideal.span (Set.range fun i : ι => MvPolynomial.pderiv i P)) := by
  rw [MvPolynomial.zeroLocus_span]
  ext point
  simp only [criticalLocus, Set.mem_setOf_eq, Set.mem_range, MvPolynomial.aeval_def, Algebra.algebraMap_self,
    MvPolynomial.eval₂_id, forall_exists_index, forall_apply_eq_imp_iff]

noncomputable def linearSubspaceCoordinatePolynomial {k m : ℕ}
    (E : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ)) (i : Fin m) :
    MvPolynomial (Fin k) ℂ :=
  ∑ j : Fin k,
    MvPolynomial.C ((E (Pi.single j 1)) i) * MvPolynomial.X j

theorem eval_linearSubspaceCoordinatePolynomial {k m : ℕ}
    (E : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (i : Fin m) (u : Fin k → ℂ) :
    MvPolynomial.eval u (linearSubspaceCoordinatePolynomial E i) = E u i := by
  classical
  calc
    MvPolynomial.eval u (linearSubspaceCoordinatePolynomial E i) =
        ∑ j : Fin k, (E (Pi.single j 1)) i * u j := by
      simp only [linearSubspaceCoordinatePolynomial, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]
    _ = E u i := by
      conv_rhs => rw [pi_eq_sum_univ' u]
      simp only [mul_comm, map_sum, map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]

noncomputable def linearSubspacePolynomialPullback {k m : ℕ}
    (E : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ)) :
    MvPolynomial (Fin m) ℂ →ₐ[ℂ] MvPolynomial (Fin k) ℂ :=
  MvPolynomial.aeval (linearSubspaceCoordinatePolynomial E)

theorem eval_linearSubspacePolynomialPullback {k m : ℕ}
    (E : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (u : Fin k → ℂ) (p : MvPolynomial (Fin m) ℂ) :
    MvPolynomial.eval u (linearSubspacePolynomialPullback E p) =
      MvPolynomial.eval (E u) p := by
  change
    MvPolynomial.aeval u
        (MvPolynomial.aeval (linearSubspaceCoordinatePolynomial E) p) =
      MvPolynomial.aeval (E u) p
  have hcoordinates :
      (fun i =>
        MvPolynomial.aeval u (linearSubspaceCoordinatePolynomial E i)) =
        E u := by
    funext i
    exact eval_linearSubspaceCoordinatePolynomial E i u
  rw [MvPolynomial.comp_aeval_apply, hcoordinates]

theorem linearSubspacePolynomialPullback_surjective_of_leftInverse
    {k m : ℕ}
    (E : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (R : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ))
    (hleft : Function.LeftInverse R E) :
    Function.Surjective (linearSubspacePolynomialPullback E) := by
  intro p
  refine ⟨linearSubspacePolynomialPullback R p,
    MvPolynomial.funext ?_⟩
  intro u
  rw [eval_linearSubspacePolynomialPullback,
    eval_linearSubspacePolynomialPullback, hleft u]

noncomputable def submoduleCoordinateEmbedding {t : ℕ}
    (W : Submodule ℂ (Fin t → ℂ)) :
    (Fin (Module.finrank ℂ W) → ℂ) →ₗ[ℂ] (Fin t → ℂ) :=
  W.subtype.comp (Module.finBasis ℂ W).equivFun.symm.toLinearMap

noncomputable def submoduleCoordinateRetraction {t : ℕ}
    (W : Submodule ℂ (Fin t → ℂ)) :
    (Fin t → ℂ) →ₗ[ℂ] (Fin (Module.finrank ℂ W) → ℂ) :=
  (Module.finBasis ℂ W).equivFun.toLinearMap.comp W.subtype.leftInverse

theorem submoduleCoordinateRetraction_leftInverse {t : ℕ}
    (W : Submodule ℂ (Fin t → ℂ)) :
    Function.LeftInverse (submoduleCoordinateRetraction W)
      (submoduleCoordinateEmbedding W) := by
  intro u
  change
    (Module.finBasis ℂ W).equivFun
        (W.subtype.leftInverse
          (W.subtype ((Module.finBasis ℂ W).equivFun.symm u))) = u
  rw [LinearMap.leftInverse_apply_of_inj W.ker_subtype]
  exact (Module.finBasis ℂ W).equivFun.apply_symm_apply u

noncomputable def submodulePolynomialRestriction {t : ℕ}
    (W : Submodule ℂ (Fin t → ℂ)) :
    MvPolynomial (Fin t) ℂ →ₐ[ℂ]
      MvPolynomial (Fin (Module.finrank ℂ W)) ℂ :=
  linearSubspacePolynomialPullback (submoduleCoordinateEmbedding W)

theorem submodulePolynomialRestriction_surjective {t : ℕ}
    (W : Submodule ℂ (Fin t → ℂ)) :
    Function.Surjective (submodulePolynomialRestriction W) :=
  linearSubspacePolynomialPullback_surjective_of_leftInverse
    (submoduleCoordinateEmbedding W) (submoduleCoordinateRetraction W)
    (submoduleCoordinateRetraction_leftInverse W)

theorem ker_submodulePolynomialRestriction_eq_vanishingIdeal {t : ℕ}
    (W : Submodule ℂ (Fin t → ℂ)) :
    RingHom.ker (submodulePolynomialRestriction W).toRingHom =
      MvPolynomial.vanishingIdeal ℂ
        (W : Set (Fin t → ℂ)) := by
  ext p
  change
    submodulePolynomialRestriction W p = 0 ↔
      ∀ v ∈ (W : Set (Fin t → ℂ)), MvPolynomial.aeval v p = 0
  constructor
  · intro hp v hv
    let w : W := ⟨v, hv⟩
    let u : Fin (Module.finrank ℂ W) → ℂ :=
      (Module.finBasis ℂ W).equivFun w
    have heval := congrArg (MvPolynomial.eval u) hp
    rw [map_zero] at heval
    change
      MvPolynomial.eval u
          (linearSubspacePolynomialPullback
            (submoduleCoordinateEmbedding W) p) = 0 at heval
    rw [eval_linearSubspacePolynomialPullback] at heval
    have hpoint : submoduleCoordinateEmbedding W u = v := by
      change
        (↑((Module.finBasis ℂ W).equivFun.symm
          ((Module.finBasis ℂ W).equivFun w)) : Fin t → ℂ) = v
      rw [LinearEquiv.symm_apply_apply]
    rw [hpoint] at heval
    simpa only [MvPolynomial.aeval_def, Algebra.algebraMap_self, MvPolynomial.eval₂_id] using heval
  · intro hp
    apply MvPolynomial.funext
    intro u
    simp only [map_zero]
    change
      MvPolynomial.eval u
        (linearSubspacePolynomialPullback
          (submoduleCoordinateEmbedding W) p) = 0
    rw [eval_linearSubspacePolynomialPullback]
    apply hp
    exact ((Module.finBasis ℂ W).equivFun.symm u).property

noncomputable def submoduleVanishingIdealCoordinateRingEquiv {t : ℕ}
    (W : Submodule ℂ (Fin t → ℂ)) :
    (MvPolynomial (Fin t) ℂ ⧸
      MvPolynomial.vanishingIdeal ℂ (W : Set (Fin t → ℂ))) ≃ₐ[ℂ]
        MvPolynomial (Fin (Module.finrank ℂ W)) ℂ :=
  (Ideal.quotientEquivAlgOfEq ℂ
    (ker_submodulePolynomialRestriction_eq_vanishingIdeal W).symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective
        (submodulePolynomialRestriction_surjective W))

theorem submoduleVanishingIdealCoordinateRing_ringKrullDim {t : ℕ}
    (W : Submodule ℂ (Fin t → ℂ)) :
    ringKrullDim
      (MvPolynomial (Fin t) ℂ ⧸
        MvPolynomial.vanishingIdeal ℂ (W : Set (Fin t → ℂ))) =
      (↑(Module.finrank ℂ W) : WithBot ℕ∞) := by
  rw [ringKrullDim_eq_of_ringEquiv
    (submoduleVanishingIdealCoordinateRingEquiv W).toRingEquiv,
    MvPolynomial.ringKrullDim_of_isNoetherianRing,
    ringKrullDim_eq_zero_of_field]
  simp only [Nat.card_eq_fintype_card, Fintype.card_fin, zero_add]

end Standalone_Geometry

section Standalone_Bezout

theorem multiplication_gate_equation_totalDegree_le_two
    {ι : Type*} (j : ι) (left right : MvPolynomial ι ℂ)
    (hleft : left.totalDegree ≤ 1)
    (hright : right.totalDegree ≤ 1) :
    (MvPolynomial.X j - left * right).totalDegree ≤ 2 := by
  calc
    (MvPolynomial.X j - left * right).totalDegree ≤
        max (MvPolynomial.X j).totalDegree (left * right).totalDegree :=
      MvPolynomial.totalDegree_sub _ _
    _ ≤ max 1 (1 + 1) :=
      max_le_max (by simp only [MvPolynomial.totalDegree_X, Std.le_refl])
        ((MvPolynomial.totalDegree_mul _ _).trans
          (Nat.add_le_add hleft hright))
    _ = 2 := by decide

theorem affine_output_equation_totalDegree_le_one
    {ι : Type*} (output : MvPolynomial ι ℂ) (η : ℂ)
    (houtput : output.totalDegree ≤ 1) :
    (output - MvPolynomial.C η).totalDegree ≤ 1 :=
  (MvPolynomial.totalDegree_sub_C_le output η).trans houtput

end Standalone_Bezout

section Standalone_FiberDimension

open Ideal

variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

theorem ringKrullDim_le_of_isIntegral
    [Algebra.IsIntegral R S] :
    ringKrullDim S ≤ ringKrullDim R := by
  unfold ringKrullDim
  apply Order.krullDim_le_of_strictMono
    (PrimeSpectrum.comap (algebraMap R S))
  intro P Q hPQ
  exact Ideal.IsIntegral.comap_lt_comap hPQ

end Standalone_FiberDimension

section Standalone_GenericAvoidance

open Set Filter Module

open scoped BigOperators ENNReal

noncomputable section

theorem permanent_rollout_exists_avoiding_finite_smooth_chart_images
    {ι E F : Type*} [Finite ι]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [SecondCountableTopology E]
    [NormedAddCommGroup F] [NormedSpace ℝ F]
    [FiniteDimensional ℝ F]
    (f : ι → E → F) (s : ι → Set E)
    (hsmooth : ∀ i x, x ∈ s i → ContDiffAt ℝ 1 (f i) x)
    (hdim : finrank ℝ E < finrank ℝ F) :
    ∃ y : F, ∀ i : ι, y ∉ f i '' s i := by
  classical
  let _ : Fintype ι := Fintype.ofFinite ι
  have hchart (i : ι) :
      dimH (f i '' s i) ≤
        (finrank ℝ E : ENNReal) := by
    calc
      dimH (f i '' s i) ≤ dimH (s i) := by
        apply dimH_image_le_of_locally_lipschitzOn
        intro x hx
        obtain ⟨C, t, ht, hlip⟩ := (hsmooth i x hx).exists_lipschitzOnWith
        exact ⟨C, t, mem_nhdsWithin_of_mem_nhds ht, hlip⟩
      _ ≤ dimH (Set.univ : Set E) :=
        dimH_mono (Set.subset_univ _)
      _ = (finrank ℝ E : ENNReal) :=
        Real.dimH_univ_eq_finrank E
  have hunion :
      dimH (⋃ i, f i '' s i) ≤
        (finrank ℝ E : ENNReal) := by
    rw [dimH_iUnion]
    exact iSup_le hchart
  have hstrict :
      dimH (⋃ i, f i '' s i) <
        (finrank ℝ F : ENNReal) :=
    hunion.trans_lt (by exact_mod_cast hdim)
  have hdense : Dense (⋃ i, f i '' s i)ᶜ :=
    dense_compl_of_dimH_lt_finrank hstrict
  obtain ⟨y, hy⟩ := hdense.nonempty
  refine ⟨y, ?_⟩
  intro i hi
  exact hy (Set.mem_iUnion.mpr ⟨i, hi⟩)

abbrev permanentRolloutUniformOutputChartDomain (k m : ℕ) : Type :=
  (Fin k → ℂ) × (Fin (k + 1) → Fin m → ℂ)

def permanentRolloutNormalizedInput {k : ℕ}
    (j : Fin (k + 1)) (x : Fin k → ℂ) : Fin (k + 1) → ℂ :=
  j.insertNth 1 x

def permanentRolloutOutputChart {k m : ℕ}
    (g : (Fin (k + 1) → ℂ) → (Fin (m + 1) → ℂ))
    (j : Fin (k + 1)) (ell : Fin (m + 1))
    (z : permanentRolloutUniformOutputChartDomain k m) :
    Fin (k + 1) → Fin (m + 1) → ℂ :=
  fun r =>
    ell.insertNth
      (-(∑ q : Fin m,
        z.2 r q * g (permanentRolloutNormalizedInput j z.1)
          (ell.succAbove q)) /
        g (permanentRolloutNormalizedInput j z.1) ell)
      (z.2 r)

theorem permanent_rollout_complex_div_contDiffAt
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {f h : E → ℂ} {x : E}
    (hf : ContDiffAt ℝ 1 f x) (hh : ContDiffAt ℝ 1 h x)
    (hne : h x ≠ 0) :
    ContDiffAt ℝ 1 (fun y => f y / h y) x := by
  have hfr : ContDiffAt ℝ 1 (fun y => (f y).re) x := by
    exact Complex.reCLM.contDiff.contDiffAt.comp x hf
  have hfi : ContDiffAt ℝ 1 (fun y => (f y).im) x := by
    exact Complex.imCLM.contDiff.contDiffAt.comp x hf
  have hhr : ContDiffAt ℝ 1 (fun y => (h y).re) x := by
    exact Complex.reCLM.contDiff.contDiffAt.comp x hh
  have hhi : ContDiffAt ℝ 1 (fun y => (h y).im) x := by
    exact Complex.imCLM.contDiff.contDiffAt.comp x hh
  have hnorm : ContDiffAt ℝ 1
      (fun y => Complex.normSq (h y)) x := by
    simpa only [Complex.normSq_apply] using
      (hhr.mul hhr).add (hhi.mul hhi)
  have hnorm_ne : Complex.normSq (h x) ≠ 0 :=
    (Complex.normSq_eq_zero.not).mpr hne
  have hreal : ContDiffAt ℝ 1
      (fun y =>
        (f y).re * (h y).re / Complex.normSq (h y) +
          (f y).im * (h y).im / Complex.normSq (h y)) x :=
    ((hfr.mul hhr).div hnorm hnorm_ne).add
      ((hfi.mul hhi).div hnorm hnorm_ne)
  have himag : ContDiffAt ℝ 1
      (fun y =>
        (f y).im * (h y).re / Complex.normSq (h y) -
          (f y).re * (h y).im / Complex.normSq (h y)) x :=
    ((hfi.mul hhr).div hnorm hnorm_ne).sub
      ((hfr.mul hhi).div hnorm hnorm_ne)
  convert Complex.equivRealProdCLM.symm.contDiff.contDiffAt.comp x
    (hreal.prodMk himag) using 1
  funext y
  apply Complex.ext
  · change
      (f y / h y).re =
        (f y).re * (h y).re / Complex.normSq (h y) +
          (f y).im * (h y).im / Complex.normSq (h y)
    exact Complex.div_re (f y) (h y)
  · change
      (f y / h y).im =
        (f y).im * (h y).re / Complex.normSq (h y) -
          (f y).re * (h y).im / Complex.normSq (h y)
    exact Complex.div_im (f y) (h y)

theorem permanent_rollout_normalized_input_contDiff
    {k m : ℕ} (j : Fin (k + 1)) :
    ContDiff ℝ 1
      (fun z : permanentRolloutUniformOutputChartDomain k m =>
        permanentRolloutNormalizedInput j z.1) := by
  apply contDiff_pi.2
  intro a
  induction a using Fin.succAboveCases j with
  | x =>
      simp only [permanentRolloutNormalizedInput,
        Fin.insertNth_apply_same]
      fun_prop
  | p q =>
      simp only [permanentRolloutNormalizedInput,
        Fin.insertNth_apply_succAbove]
      fun_prop

theorem permanent_rollout_output_chart_contDiffAt
    {k m : ℕ}
    (g : (Fin (k + 1) → ℂ) → (Fin (m + 1) → ℂ))
    (hg : ContDiff ℝ 1 g)
    (j : Fin (k + 1)) (ell : Fin (m + 1))
    (z : permanentRolloutUniformOutputChartDomain k m)
    (hz : g (permanentRolloutNormalizedInput j z.1) ell ≠ 0) :
    ContDiffAt ℝ 1 (permanentRolloutOutputChart g j ell) z := by
  have hnorm := permanent_rollout_normalized_input_contDiff (m := m) j
  have hgrad : ContDiff ℝ 1
      (fun w : permanentRolloutUniformOutputChartDomain k m =>
        g (permanentRolloutNormalizedInput j w.1)) :=
    hg.comp hnorm
  apply contDiffAt_pi.2
  intro r
  apply contDiffAt_pi.2
  intro a
  induction a using Fin.succAboveCases ell with
  | x =>
      simp only [permanentRolloutOutputChart,
        Fin.insertNth_apply_same]
      apply permanent_rollout_complex_div_contDiffAt
      · apply ContDiffAt.neg
        apply ContDiffAt.sum
        intro q _
        apply ContDiffAt.mul
        · fun_prop
        · exact ((contDiff_apply ℝ ℂ (ell.succAbove q)).comp
            hgrad).contDiffAt
      · exact ((contDiff_apply ℝ ℂ ell).comp hgrad).contDiffAt
      · exact hz
  | p q =>
      simp only [permanentRolloutOutputChart,
        Fin.insertNth_apply_succAbove]
      fun_prop

theorem permanent_rollout_uniform_output_chart_real_finrank_lt
    (k m : ℕ) :
    finrank ℝ (permanentRolloutUniformOutputChartDomain k m) <
      finrank ℝ (Fin (k + 1) → Fin (m + 1) → ℂ) := by
  rw [finrank_real_of_complex, finrank_real_of_complex]
  change
    2 * finrank ℂ
      ((Fin k → ℂ) × (Fin (k + 1) → Fin m → ℂ)) <
      2 * finrank ℂ (Fin (k + 1) → Fin (m + 1) → ℂ)
  simp only [finrank_prod, finrank_pi_fintype,
    finrank_self, Fintype.card_fin,
    Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  nlinarith

theorem permanent_rollout_output_chart_eq_of_mulVec_zero
    {k m : ℕ}
    (g : (Fin (k + 1) → ℂ) → (Fin (m + 1) → ℂ))
    (j : Fin (k + 1)) (ell : Fin (m + 1))
    (w : Fin (k + 1) → ℂ) (hwj : w j = 1)
    (hell : g w ell ≠ 0)
    (A : Matrix (Fin (k + 1)) (Fin (m + 1)) ℂ)
    (hA : Matrix.mulVec A (g w) = 0) :
    permanentRolloutOutputChart g j ell
        (j.removeNth w,
          fun r q => A r (ell.succAbove q)) = A := by
  have hnormalize :
      permanentRolloutNormalizedInput j (j.removeNth w) = w := by
    simpa only [permanentRolloutNormalizedInput, hwj] using
      Fin.insertNth_self_removeNth j w
  funext r
  funext q
  induction q using Fin.succAboveCases ell with
  | p q =>
      simp only [permanentRolloutOutputChart, Fin.insertNth_apply_succAbove]
  | x =>
      simp only [permanentRolloutOutputChart,
        Fin.insertNth_apply_same, hnormalize]
      have hrow : ∑ q : Fin (m + 1), A r q * g w q = 0 := by
        simpa only [Matrix.mulVec, dotProduct, Pi.zero_apply] using congrFun hA r
      rw [Fin.sum_univ_succAbove (fun q => A r q * g w q) ell] at hrow
      field_simp
      linear_combination -hrow

theorem permanent_rollout_exists_output_matrix_of_smooth_homogeneous
    {k m e : ℕ}
    (g : (Fin k → ℂ) → (Fin m → ℂ))
    (hg : ContDiff ℝ 1 g)
    (hnonzero : ∀ u : Fin k → ℂ, u ≠ 0 → g u ≠ 0)
    (hscale : ∀ (a : ℂ) (u : Fin k → ℂ),
      g (a • u) = a ^ e • g u) :
    ∃ A : Matrix (Fin k) (Fin m) ℂ,
      ∀ u : Fin k → ℂ, u ≠ 0 → Matrix.mulVec A (g u) ≠ 0 := by
  classical
  cases k with
  | zero =>
      refine ⟨0, ?_⟩
      intro u hu
      exact (hu (Subsingleton.elim u 0)).elim
  | succ k =>
      cases m with
      | zero =>
          have hu : (fun _ : Fin (k + 1) => (1 : ℂ)) ≠ 0 := by
            intro h
            have := congrFun h (0 : Fin (k + 1))
            simp only [Pi.zero_apply, one_ne_zero] at this
          exact (hnonzero _ hu (Subsingleton.elim _ _)).elim
      | succ m =>
          let charts :
              Fin (k + 1) × Fin (m + 1) →
                permanentRolloutUniformOutputChartDomain k m →
                  (Fin (k + 1) → Fin (m + 1) → ℂ) :=
            fun i => permanentRolloutOutputChart g i.1 i.2
          let chartDomains :
              Fin (k + 1) × Fin (m + 1) →
                Set (permanentRolloutUniformOutputChartDomain k m) :=
            fun i =>
              {z | g (permanentRolloutNormalizedInput i.1 z.1) i.2 ≠ 0}
          obtain ⟨A, hA⟩ :=
            permanent_rollout_exists_avoiding_finite_smooth_chart_images
              charts chartDomains
              (fun i z hz =>
                permanent_rollout_output_chart_contDiffAt
                  g hg i.1 i.2 z hz)
              (permanent_rollout_uniform_output_chart_real_finrank_lt k m)
          refine ⟨A, ?_⟩
          intro u hu hzero
          obtain ⟨j, hj⟩ : ∃ j : Fin (k + 1), u j ≠ 0 := by
            simpa only [ne_eq, funext_iff, Pi.zero_apply, not_forall] using hu
          let w : Fin (k + 1) → ℂ := (u j)⁻¹ • u
          have hwj : w j = 1 := by
            simp only [Pi.smul_apply, smul_eq_mul, ne_eq, hj, not_false_eq_true, inv_mul_cancel₀, w]
          have hw : w ≠ 0 := by
            intro h
            have := congrFun h j
            simp only [hwj, Pi.zero_apply, one_ne_zero] at this
          obtain ⟨ell, hell⟩ : ∃ ell : Fin (m + 1), g w ell ≠ 0 := by
            simpa only [ne_eq, funext_iff, Pi.zero_apply, not_forall] using hnonzero w hw
          have hAzero : Matrix.mulVec A (g w) = 0 := by
            rw [show w = (u j)⁻¹ • u from rfl, hscale]
            apply funext
            intro r
            change
              (∑ q, A r q * (((u j)⁻¹ ^ e • g u) q)) = 0
            simp only [Pi.smul_apply, smul_eq_mul]
            calc
              (∑ q, A r q * ((u j)⁻¹ ^ e * g u q)) =
                  (u j)⁻¹ ^ e * (∑ q, A r q * g u q) := by
                    rw [Finset.mul_sum]
                    apply Finset.sum_congr rfl
                    intro q _
                    ring
              _ = 0 := by
                have hr := congrFun hzero r
                change (∑ q, A r q * g u q) = 0 at hr
                rw [hr, mul_zero]
          have hchart := permanent_rollout_output_chart_eq_of_mulVec_zero
            g j ell w hwj hell A hAzero
          apply hA (j, ell)
          refine ⟨(j.removeNth w,
            fun r q => A r (ell.succAbove q)), ?_, hchart⟩
          change
            g (permanentRolloutNormalizedInput j
              (j.removeNth w)) ell ≠ 0
          have hnormalize :
              permanentRolloutNormalizedInput j (j.removeNth w) = w := by
            simpa only [permanentRolloutNormalizedInput, hwj] using
              Fin.insertNth_self_removeNth j w
          rwa [hnormalize]

theorem permanent_rollout_minimalPrime_isHomogeneous
    {ι σ R : Type*} [CommRing R]
    [AddCommMonoid ι] [LinearOrder ι] [IsOrderedCancelAddMonoid ι]
    [SetLike σ R] [AddSubmonoidClass σ R]
    {𝒜 : ι → σ} [GradedRing 𝒜]
    {I p : Ideal R}
    (hI : I.IsHomogeneous 𝒜)
    (hp : p ∈ I.minimalPrimes) :
    p.IsHomogeneous 𝒜 := by
  let core : Ideal R := (p.homogeneousCore 𝒜).toIdeal
  have hcoreprime : core.IsPrime := hp.isPrime.homogeneousCore
  have hcore_le : core ≤ p := Ideal.toIdeal_homogeneousCore_le 𝒜 p
  have hIcore : I ≤ core := by
    change I ≤ (p.homogeneousCore 𝒜).toIdeal
    rw [← hI.toIdeal_homogeneousCore_eq_self]
    exact Ideal.homogeneousCore_mono 𝒜 hp.le
  have hcoreeq : core = p :=
    le_antisymm hcore_le (hp.2 ⟨hcoreprime, hIcore⟩ hcore_le)
  rw [← hcoreeq]
  exact (p.homogeneousCore 𝒜).isHomogeneous

noncomputable def permanentRolloutLinearCoordinateCombination
    (m : ℕ) :
    (Fin m → ℂ) →ₗ[ℂ] MvPolynomial (Fin m) ℂ where
  toFun c := ∑ i, c i • MvPolynomial.X i
  map_add' c d := by
    simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
  map_smul' a c := by
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.smul_sum, smul_smul]

theorem permanent_rollout_exists_linear_avoiding_minimalPrimes
    {m : ℕ} (I : Ideal (MvPolynomial (Fin m) ℂ))
    (hcoordinate : ∀ p ∈ I.minimalPrimes,
      ∃ i : Fin m, MvPolynomial.X i ∉ p) :
    ∃ c : Fin m → ℂ,
      ∀ p ∈ I.minimalPrimes,
        (∑ i, c i • MvPolynomial.X i) ∉ p := by
  classical
  let index := {p : Ideal (MvPolynomial (Fin m) ℂ) //
    p ∈ I.minimalPrimes}
  letI : Fintype index :=
    (I.finite_minimalPrimes_of_isNoetherianRing
      (MvPolynomial (Fin m) ℂ)).fintype
  let bad : index → Submodule ℂ (Fin m → ℂ) :=
    fun p => (p.val.restrictScalars ℂ).comap
      (permanentRolloutLinearCoordinateCombination m)
  have hbad : ∀ p : index, bad p ≠ ⊤ := by
    intro p htop
    obtain ⟨i, hi⟩ := hcoordinate p.val p.property
    let unit : Fin m → ℂ := Pi.single i (1 : ℂ)
    have hsingle : unit ∈ bad p := by
      rw [htop]
      trivial
    apply hi
    change
      (∑ j, unit j •
        MvPolynomial.X j) ∈ p.val at hsingle
    simpa [unit] using hsingle
  obtain ⟨c, hc⟩ :=
    Submodule.exists_forall_notMem_of_forall_ne_top bad hbad
  refine ⟨c, ?_⟩
  intro p hp
  exact hc ⟨p, hp⟩

section HomogeneousPrimeInputAvoidance

attribute [local instance] MvPolynomial.gradedAlgebra

theorem permanent_rollout_homogeneousPrime_le_idealOfVars
    {m : ℕ} (p : Ideal (MvPolynomial (Fin m) ℂ))
    (hprime : p.IsPrime)
    (hhomogeneous :
      p.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin m) ℂ)) :
    p ≤ MvPolynomial.idealOfVars (Fin m) ℂ := by
  letI : p.IsPrime := hprime
  intro f hf
  have hconstant : MvPolynomial.coeff 0 f = 0 := by
    by_contra hnonzero
    have hcomponent :
        MvPolynomial.homogeneousComponent 0 f ∈ p :=
      MvPolynomial.homogeneousComponent_mem_of_mem hhomogeneous hf 0
    rw [MvPolynomial.homogeneousComponent_zero] at hcomponent
    have hunit : IsUnit
        (MvPolynomial.C (MvPolynomial.coeff 0 f) :
          MvPolynomial (Fin m) ℂ) :=
      (isUnit_iff_ne_zero.mpr hnonzero).map MvPolynomial.C
    exact (Ideal.notMem_of_isUnit p hunit) hcomponent
  rw [← pow_one (MvPolynomial.idealOfVars (Fin m) ℂ),
    MvPolynomial.mem_pow_idealOfVars_iff']
  intro exponent hexponent
  have hezero : exponent = 0 :=
    (Finsupp.degree_eq_zero_iff exponent).mp
      (Nat.lt_one_iff.mp hexponent)
  simpa only [hezero] using hconstant

theorem permanent_rollout_idealOfVars_isMaximal (m : ℕ) :
    (MvPolynomial.idealOfVars (Fin m) ℂ).IsMaximal := by
  have hkernel :
      RingHom.ker
        (MvPolynomial.constantCoeff : MvPolynomial (Fin m) ℂ →+* ℂ) =
        MvPolynomial.idealOfVars (Fin m) ℂ := by
    ext f
    change MvPolynomial.coeff 0 f = 0 ↔
      f ∈ MvPolynomial.idealOfVars (Fin m) ℂ
    rw [← pow_one (MvPolynomial.idealOfVars (Fin m) ℂ),
      MvPolynomial.mem_pow_idealOfVars_iff']
    constructor
    · intro hf exponent hexponent
      have hezero : exponent = 0 :=
        (Finsupp.degree_eq_zero_iff exponent).mp
          (Nat.lt_one_iff.mp hexponent)
      simpa only [hezero] using hf
    · intro hf
      exact hf 0 (by simp only [map_zero, Order.lt_one_iff])
  rw [← hkernel]
  apply RingHom.ker_isMaximal_of_surjective
  intro a
  exact ⟨MvPolynomial.C a, MvPolynomial.constantCoeff_C _ a⟩

theorem permanent_rollout_minimalPrime_exists_variable_of_positive_dimension
    {m : ℕ} (I : Ideal (MvPolynomial (Fin m) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin m) ℂ))
    (hdimension :
      (0 : WithBot ℕ∞) <
        ringKrullDim (MvPolynomial (Fin m) ℂ ⧸ I))
    (p : Ideal (MvPolynomial (Fin m) ℂ))
    (hp : p ∈ I.minimalPrimes) :
    ∃ i : Fin m, MvPolynomial.X i ∉ p := by
  classical
  by_contra hnone
  simp only [not_exists, not_not] at hnone
  have hvertex_le : MvPolynomial.idealOfVars (Fin m) ℂ ≤ p := by
    rw [MvPolynomial.idealOfVars, Ideal.span_le]
    rintro f ⟨i, rfl⟩
    exact hnone i
  have hp_vertex : p = MvPolynomial.idealOfVars (Fin m) ℂ :=
    le_antisymm
      (permanent_rollout_homogeneousPrime_le_idealOfVars p hp.isPrime
        (permanent_rollout_minimalPrime_isHomogeneous hI hp))
      hvertex_le
  have hallmaximal :
      ∀ q ∈ I.minimalPrimes, q.IsMaximal := by
    intro q hq
    have hq_vertex : q ≤ MvPolynomial.idealOfVars (Fin m) ℂ :=
      permanent_rollout_homogeneousPrime_le_idealOfVars q hq.isPrime
        (permanent_rollout_minimalPrime_isHomogeneous hI hq)
    have hq_p : q ≤ p := hp_vertex.symm ▸ hq_vertex
    have hp_q : p ≤ q := hp.2 ⟨hq.isPrime, hq.le⟩ hq_p
    have hqeq : q = MvPolynomial.idealOfVars (Fin m) ℂ :=
      (le_antisymm hq_p hp_q).trans hp_vertex
    rw [hqeq]
    exact permanent_rollout_idealOfVars_isMaximal m
  have hzero :
      Ring.KrullDimLE 0 (MvPolynomial (Fin m) ℂ ⧸ I) :=
    Ideal.krullDimLE_zero_quotient_iff_forall_minimalPrimes_isMaximal.mpr
      hallmaximal
  have hnonpositive :
      ringKrullDim (MvPolynomial (Fin m) ℂ ⧸ I) ≤
        (0 : WithBot ℕ∞) :=
    Ring.krullDimLE_iff.mp hzero
  exact (not_lt_of_ge hnonpositive) hdimension

theorem permanent_rollout_supportDim_quotSMulTop_idealQuotient_eq_ringKrullDim_sup
    {R : Type*} [CommRing R] (I : Ideal R) (x : R) :
    Module.supportDim R (QuotSMulTop x (R ⧸ I)) =
      ringKrullDim (R ⧸ (I ⊔ Ideal.span ({x} : Set R))) := by
  rw [Module.supportDim, Module.support_quotSMulTop,
    Module.support_eq_zeroLocus, Ideal.annihilator_quotient,
    ringKrullDim_quotient, PrimeSpectrum.zeroLocus_sup,
    PrimeSpectrum.zeroLocus_span]

theorem permanent_rollout_linearCoordinateCombination_isHomogeneousElem
    {m : ℕ} (c : Fin m → ℂ) :
    SetLike.IsHomogeneousElem
      (MvPolynomial.homogeneousSubmodule (Fin m) ℂ)
      (permanentRolloutLinearCoordinateCombination m c) := by
  refine ⟨1, ?_⟩
  change (∑ i, c i • MvPolynomial.X i) ∈
    MvPolynomial.homogeneousSubmodule (Fin m) ℂ 1
  apply Submodule.sum_mem
  intro i _
  exact Submodule.smul_mem _ _ (MvPolynomial.isHomogeneous_X ℂ i)

noncomputable def permanentRolloutHomogeneousLinearSliceIdeal
    {m n : ℕ} (I : Ideal (MvPolynomial (Fin m) ℂ))
    (c : Fin n → Fin m → ℂ) : Ideal (MvPolynomial (Fin m) ℂ) :=
  I ⊔ Ideal.span (Set.range fun j =>
    permanentRolloutLinearCoordinateCombination m (c j))

theorem permanent_rollout_homogeneous_linear_slice_ideal_isHomogeneous
    {m n : ℕ} (I : Ideal (MvPolynomial (Fin m) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin m) ℂ))
    (c : Fin n → Fin m → ℂ) :
    (permanentRolloutHomogeneousLinearSliceIdeal I c).IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin m) ℂ) := by
  unfold permanentRolloutHomogeneousLinearSliceIdeal
  apply hI.sup
  apply Ideal.homogeneous_span
  rintro _ ⟨j, rfl⟩
  exact permanent_rollout_linearCoordinateCombination_isHomogeneousElem (c j)

theorem permanent_rollout_homogeneous_linear_slice_ideal_snoc
    {m n : ℕ} (I : Ideal (MvPolynomial (Fin m) ℂ))
    (c : Fin n → Fin m → ℂ) (x : Fin m → ℂ) :
    permanentRolloutHomogeneousLinearSliceIdeal I (Fin.snoc c x) =
      permanentRolloutHomogeneousLinearSliceIdeal I c ⊔
        Ideal.span
          ({permanentRolloutLinearCoordinateCombination m x} :
            Set (MvPolynomial (Fin m) ℂ)) := by
  unfold permanentRolloutHomogeneousLinearSliceIdeal
  have hsnoc :
      (fun j : Fin (n + 1) =>
        permanentRolloutLinearCoordinateCombination m
          ((Fin.snoc c x : Fin (n + 1) → Fin m → ℂ) j)) =
      Fin.snoc
        (fun j => permanentRolloutLinearCoordinateCombination m (c j))
        (permanentRolloutLinearCoordinateCombination m x) := by
    funext j
    induction j using Fin.lastCases <;> simp
  rw [hsnoc, Fin.range_snoc, Ideal.span_insert]
  ac_rfl

theorem permanent_rollout_homogeneous_linear_slice_coefficient_span_le_minimalPrime
    {m n : ℕ} (I : Ideal (MvPolynomial (Fin m) ℂ))
    (c : Fin n → Fin m → ℂ)
    (p : Ideal (MvPolynomial (Fin m) ℂ))
    (hp : p ∈ (permanentRolloutHomogeneousLinearSliceIdeal I c).minimalPrimes) :
    Submodule.span ℂ (Set.range c) ≤
      (p.restrictScalars ℂ).comap
        (permanentRolloutLinearCoordinateCombination m) := by
  rw [Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  change permanentRolloutLinearCoordinateCombination m (c j) ∈ p
  apply hp.le
  exact (show Ideal.span (Set.range fun j =>
      permanentRolloutLinearCoordinateCombination m (c j)) ≤
        permanentRolloutHomogeneousLinearSliceIdeal I c from
      le_sup_right) (Ideal.subset_span ⟨j, rfl⟩)

theorem permanent_rollout_homogeneous_linear_slice_exists_independent_dimension_drop
    {m n : ℕ} (I : Ideal (MvPolynomial (Fin m) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin m) ℂ))
    (c : Fin n → Fin m → ℂ)
    (hindependent : LinearIndependent ℂ c)
    (hpositive : (0 : WithBot ℕ∞) <
      ringKrullDim
        (MvPolynomial (Fin m) ℂ ⧸
          permanentRolloutHomogeneousLinearSliceIdeal I c)) :
    ∃ x : Fin m → ℂ,
      LinearIndependent ℂ (Fin.snoc c x) ∧
        ringKrullDim
          (MvPolynomial (Fin m) ℂ ⧸
            permanentRolloutHomogeneousLinearSliceIdeal I (Fin.snoc c x)) + 1 ≤
          ringKrullDim
            (MvPolynomial (Fin m) ℂ ⧸
              permanentRolloutHomogeneousLinearSliceIdeal I c) := by
  let J := permanentRolloutHomogeneousLinearSliceIdeal I c
  change (0 : WithBot ℕ∞) <
    ringKrullDim (MvPolynomial (Fin m) ℂ ⧸ J) at hpositive
  have hJhomogeneous : J.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin m) ℂ) :=
    permanent_rollout_homogeneous_linear_slice_ideal_isHomogeneous I hI c
  have hcoordinate : ∀ p ∈ J.minimalPrimes,
      ∃ i : Fin m, MvPolynomial.X i ∉ p := by
    intro p hp
    exact permanent_rollout_minimalPrime_exists_variable_of_positive_dimension
      J hJhomogeneous hpositive p hp
  obtain ⟨x, hx⟩ :=
    permanent_rollout_exists_linear_avoiding_minimalPrimes J hcoordinate
  have hproper : J ≠ ⊤ := by
    intro htop
    letI : Subsingleton (MvPolynomial (Fin m) ℂ ⧸ J) :=
      Ideal.Quotient.subsingleton_iff.mpr htop
    rw [ringKrullDim_eq_bot_of_subsingleton] at hpositive
    exact (not_lt_of_ge bot_le) hpositive
  obtain ⟨⟨p, hp⟩⟩ := Ideal.nonempty_minimalPrimes hproper
  have hxspan : x ∉ Submodule.span ℂ (Set.range c) := by
    intro hspan
    apply hx p hp
    exact permanent_rollout_homogeneous_linear_slice_coefficient_span_le_minimalPrime
      I c p hp hspan
  refine ⟨x, hindependent.finSnoc hxspan, ?_⟩
  have hdrop :=
    Module.supportDim_quotSMulTop_succ_le_of_notMem_minimalPrimes
      (R := MvPolynomial (Fin m) ℂ)
      (M := MvPolynomial (Fin m) ℂ ⧸ J)
      (x := permanentRolloutLinearCoordinateCombination m x)
      (by
        intro q hq
        rw [Ideal.annihilator_quotient] at hq
        exact hx q hq)
  rw [permanent_rollout_supportDim_quotSMulTop_idealQuotient_eq_ringKrullDim_sup,
    Module.supportDim_quotient_eq_ringKrullDim] at hdrop
  rw [permanent_rollout_homogeneous_linear_slice_ideal_snoc]
  exact hdrop

theorem permanent_rollout_exists_iterated_independent_linear_ideal_dimension_zero
    {m n : ℕ} (I : Ideal (MvPolynomial (Fin m) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin m) ℂ))
    (c : Fin n → Fin m → ℂ)
    (hindependent : LinearIndependent ℂ c)
    (r : ℕ)
    (hdim : ringKrullDim
        (MvPolynomial (Fin m) ℂ ⧸
          permanentRolloutHomogeneousLinearSliceIdeal I c) ≤
      (r : WithBot ℕ∞)) :
    ∃ (q : ℕ) (d : Fin q → Fin m → ℂ),
      n ≤ q ∧ q ≤ n + r ∧ LinearIndependent ℂ d ∧
      ringKrullDim
        (MvPolynomial (Fin m) ℂ ⧸
          permanentRolloutHomogeneousLinearSliceIdeal I d) ≤
        (0 : WithBot ℕ∞) := by
  induction r generalizing n with
  | zero =>
      exact ⟨n, c, le_rfl, by omega, hindependent, hdim⟩
  | succ r ih =>
      by_cases hpositive :
          (0 : WithBot ℕ∞) <
            ringKrullDim
              (MvPolynomial (Fin m) ℂ ⧸
                permanentRolloutHomogeneousLinearSliceIdeal I c)
      · obtain ⟨x, hxindependent, hxdrop⟩ :=
          permanent_rollout_homogeneous_linear_slice_exists_independent_dimension_drop
            I hI c hindependent hpositive
        have hxbound :
            ringKrullDim
              (MvPolynomial (Fin m) ℂ ⧸
                permanentRolloutHomogeneousLinearSliceIdeal I (Fin.snoc c x)) ≤
              (r : WithBot ℕ∞) := by
          apply ENat.WithBot.add_le_add_one_right_iff.mp
          have hstep := hxdrop.trans hdim
          simpa only [ge_iff_le, Nat.cast_add, Nat.cast_one] using hstep
        obtain ⟨q, d, hnq, hqbound, hdindependent, hdzero⟩ :=
          ih (Fin.snoc c x) hxindependent hxbound
        exact ⟨q, d, by omega, by omega, hdindependent, hdzero⟩
      · exact ⟨n, c, le_rfl, by omega, hindependent,
          le_of_not_gt hpositive⟩

theorem permanent_rollout_exists_independent_linear_ideal_dimension_zero
    {m : ℕ} (I : Ideal (MvPolynomial (Fin m) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin m) ℂ))
    (r : ℕ)
    (hdim : ringKrullDim (MvPolynomial (Fin m) ℂ ⧸ I) ≤
      (r : WithBot ℕ∞)) :
    ∃ (q : ℕ) (c : Fin q → Fin m → ℂ),
      q ≤ r ∧ LinearIndependent ℂ c ∧
      ringKrullDim
        (MvPolynomial (Fin m) ℂ ⧸
          permanentRolloutHomogeneousLinearSliceIdeal I c) ≤
        (0 : WithBot ℕ∞) := by
  have hstart :
      ringKrullDim
        (MvPolynomial (Fin m) ℂ ⧸
          permanentRolloutHomogeneousLinearSliceIdeal I
            (Fin.elim0 : Fin 0 → Fin m → ℂ)) ≤
        (r : WithBot ℕ∞) := by
    change
      ringKrullDim
        (MvPolynomial (Fin m) ℂ ⧸
          (I ⊔ Ideal.span
            (Set.range fun j : Fin 0 =>
              permanentRolloutLinearCoordinateCombination m
                ((Fin.elim0 : Fin 0 → Fin m → ℂ) j)))) ≤
        (r : WithBot ℕ∞)
    rw [show Set.range (fun j : Fin 0 =>
      permanentRolloutLinearCoordinateCombination m
        ((Fin.elim0 : Fin 0 → Fin m → ℂ) j)) = ∅ by
      exact Set.eq_empty_iff_forall_notMem.mpr fun _ ⟨j, _⟩ => Fin.elim0 j,
      Ideal.span_empty, sup_bot_eq]
    exact hdim
  obtain ⟨q, c, -, hq, hc, hzero⟩ :=
    permanent_rollout_exists_iterated_independent_linear_ideal_dimension_zero
      I hI (Fin.elim0 : Fin 0 → Fin m → ℂ)
      linearIndependent_empty_type r hstart
  exact ⟨q, c, by simpa only [zero_add] using hq, hc, hzero⟩

end HomogeneousPrimeInputAvoidance

end
end Standalone_GenericAvoidance

section Standalone_FiniteMaps

noncomputable def homogeneousMapIdeal {ι : Type*}
    (F : ι → MvPolynomial ι ℂ) : Ideal (MvPolynomial ι ℂ) :=
  Ideal.span (Set.range F)

noncomputable def homogeneousMapSubalgebra {ι : Type*}
    (F : ι → MvPolynomial ι ℂ) : Subalgebra ℂ (MvPolynomial ι ℂ) :=
  Algebra.adjoin ℂ (Set.range F)

noncomputable def homogeneousMapFiberIdeal {ι : Type*}
    (F : ι → MvPolynomial ι ℂ) (point : ι → ℂ) :
    Ideal (MvPolynomial ι ℂ) :=
  Ideal.span (Set.range fun i => F i - MvPolynomial.C (point i))

abbrev homogeneousMapClosedFiber {ι : Type*}
    (F : ι → MvPolynomial ι ℂ) (point : ι → ℂ) :=
  MvPolynomial ι ℂ ⧸ homogeneousMapFiberIdeal F point

theorem homogeneousMapFiberIdeal_zero {ι : Type*}
    (F : ι → MvPolynomial ι ℂ) :
    homogeneousMapFiberIdeal F 0 = homogeneousMapIdeal F := by
  simp only [homogeneousMapFiberIdeal, Pi.zero_apply, MvPolynomial.C_0, sub_zero, homogeneousMapIdeal]

theorem zeroLocus_homogeneousMapIdeal {ι : Type*}
    (F : ι → MvPolynomial ι ℂ) :
    MvPolynomial.zeroLocus ℂ (homogeneousMapIdeal F) =
      {point : ι → ℂ | ∀ i, MvPolynomial.eval point (F i) = 0} := by
  rw [homogeneousMapIdeal, MvPolynomial.zeroLocus_span]
  ext point
  simp only [Set.mem_range, MvPolynomial.aeval_def, Algebra.algebraMap_self, MvPolynomial.eval₂_id,
    forall_exists_index, forall_apply_eq_imp_iff, Set.mem_setOf_eq]

theorem zeroLocus_idealOfVars {ι : Type*} :
    MvPolynomial.zeroLocus ℂ (MvPolynomial.idealOfVars ι ℂ) =
      ({0} : Set (ι → ℂ)) := by
  rw [MvPolynomial.idealOfVars, MvPolynomial.zeroLocus_span]
  ext point
  simp only [Set.mem_range, MvPolynomial.aeval_def, Algebra.algebraMap_self, MvPolynomial.eval₂_id,
    forall_exists_index, forall_apply_eq_imp_iff, MvPolynomial.eval_X, Set.mem_setOf_eq, Set.mem_singleton_iff,
    funext_iff, Pi.zero_apply]

theorem homogeneous_eval_zero_of_pos {ι : Type*} {f : MvPolynomial ι ℂ}
    {e : ℕ} (he : 0 < e) (hf : f.IsHomogeneous e) :
    MvPolynomial.eval (0 : ι → ℂ) f = 0 := by
  rw [MvPolynomial.eval_zero, MvPolynomial.constantCoeff_eq]
  exact hf.coeff_eq_zero (by simpa only [map_zero, ne_eq] using he.ne)

theorem vanishingIdeal_origin_eq_idealOfVars {ι : Type*} :
    MvPolynomial.vanishingIdeal ℂ ({0} : Set (ι → ℂ)) =
      MvPolynomial.idealOfVars ι ℂ := by
  ext p
  rw [MvPolynomial.mem_vanishingIdeal_singleton_iff,
    MvPolynomial.aeval_zero]
  change MvPolynomial.constantCoeff p = 0 ↔
    p ∈ MvPolynomial.idealOfVars ι ℂ
  rw [← pow_one (MvPolynomial.idealOfVars ι ℂ),
    MvPolynomial.mem_pow_idealOfVars_iff']
  constructor
  · intro hp m hm
    have hmzero : m = 0 :=
      (Finsupp.degree_eq_zero_iff m).mp (Nat.lt_one_iff.mp hm)
    simpa only [hmzero, ← MvPolynomial.constantCoeff_eq] using hp
  · intro hp
    simpa only [← MvPolynomial.constantCoeff_eq] using hp 0 (by simp)

theorem radical_homogeneousMapIdeal_eq_idealOfVars {ι : Type*} [Finite ι]
    (F : ι → MvPolynomial ι ℂ)
    (hzero : ∀ point : ι → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    (homogeneousMapIdeal F).radical = MvPolynomial.idealOfVars ι ℂ := by
  have hfiber : MvPolynomial.zeroLocus ℂ (homogeneousMapIdeal F) =
      ({0} : Set (ι → ℂ)) := by
    rw [zeroLocus_homogeneousMapIdeal]
    ext point
    simpa only [Set.mem_setOf_eq, Set.mem_singleton_iff] using hzero point
  rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := ℂ), hfiber,
    vanishingIdeal_origin_eq_idealOfVars]

theorem exists_idealOfVars_pow_le_homogeneousMapIdeal {ι : Type*} [Finite ι]
    (F : ι → MvPolynomial ι ℂ)
    (hzero : ∀ point : ι → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    ∃ n : ℕ, MvPolynomial.idealOfVars ι ℂ ^ n ≤ homogeneousMapIdeal F := by
  have hrad := radical_homogeneousMapIdeal_eq_idealOfVars F hzero
  obtain ⟨n, hn⟩ := (homogeneousMapIdeal F).exists_radical_pow_le_of_fg
    (hrad.symm ▸ MvPolynomial.idealOfVars_fg ι ℂ)
  exact ⟨n, hrad ▸ hn⟩

theorem finiteFree_maximalFiber_finrank
    {R S : Type*} [CommRing R] [IsDomain R]
    [CommRing S] [Algebra R S] [Module.Free R S]
    (p : Ideal R) [p.IsMaximal] :
    Module.finrank (R ⧸ p)
      (S ⧸ p.map (algebraMap R S)) = Module.finrank R S := by
  letI : Field (R ⧸ p) := Ideal.Quotient.field p
  calc
    Module.finrank (R ⧸ p)
        (S ⧸ p.map (algebraMap R S)) =
      Module.finrank (R ⧸ p)
        (TensorProduct R (R ⧸ p) S) :=
      (Algebra.TensorProduct.quotIdealMapEquivQuotTensor S p).toLinearEquiv.finrank_eq
    _ = Module.finrank R S := Module.finrank_baseChange

theorem finiteFree_complexTargetFiber_finrank
    {R S : Type*} [CommRing R] [IsDomain R]
    [CommRing S] [Algebra ℂ R] [Algebra ℂ S] [Algebra R S]
    [IsScalarTower ℂ R S] [Module.Free R S]
    (φ : R →ₐ[ℂ] ℂ) (hφ : Function.Surjective φ) :
    Module.finrank ℂ
      (S ⧸ (RingHom.ker φ.toRingHom).map (algebraMap R S)) =
        Module.finrank R S := by
  let p : Ideal R := RingHom.ker φ.toRingHom
  letI : p.IsMaximal :=
    RingHom.ker_isMaximal_of_surjective φ.toRingHom hφ
  letI : Field (R ⧸ p) := Ideal.Quotient.field p
  letI : IsScalarTower ℂ (R ⧸ p)
      (S ⧸ p.map (algebraMap R S)) :=
    IsScalarTower.of_algebraMap_eq (by
      intro c
      change Ideal.Quotient.mk (p.map (algebraMap R S))
          (algebraMap ℂ S c) =
        Ideal.Quotient.mk (p.map (algebraMap R S))
          (algebraMap R S (algebraMap ℂ R c))
      rw [IsScalarTower.algebraMap_apply ℂ R S c])
  have hres : Module.finrank ℂ (R ⧸ p) = 1 := by
    calc
      Module.finrank ℂ (R ⧸ p) = Module.finrank ℂ ℂ :=
        (Ideal.quotientKerAlgEquivOfSurjective hφ).toLinearEquiv.finrank_eq
      _ = 1 := Module.finrank_self ℂ
  have htower := Module.finrank_mul_finrank ℂ (R ⧸ p)
    (S ⧸ p.map (algebraMap R S))
  change Module.finrank ℂ
    (S ⧸ p.map (algebraMap R S)) = Module.finrank R S
  rw [hres, one_mul] at htower
  exact htower.symm.trans (finiteFree_maximalFiber_finrank p)

end Standalone_FiniteMaps

section Standalone_HomogeneousFiniteness

open scoped BigOperators

attribute [local instance] MvPolynomial.gradedAlgebra

theorem homogeneousMap_coordinate_mem_subalgebra
    {ι : Type*} (F : ι → MvPolynomial ι ℂ) (i : ι) :
    F i ∈ homogeneousMapSubalgebra F := by
  exact Algebra.subset_adjoin (Set.mem_range_self i)

noncomputable def homogeneousMapLowDegreeSubmodule
    (ι : Type*) (N : ℕ) : Submodule ℂ (MvPolynomial ι ℂ) :=
  ⨆ n ∈ Finset.range N, MvPolynomial.homogeneousSubmodule ι ℂ n

theorem homogeneousMapLowDegreeSubmodule_fg
    {ι : Type*} [Finite ι] (N : ℕ) :
    (homogeneousMapLowDegreeSubmodule ι N).FG := by
  unfold homogeneousMapLowDegreeSubmodule
  exact Submodule.fg_biSup (Finset.range N)
    (MvPolynomial.homogeneousSubmodule ι ℂ)
    (fun n _ => MvPolynomial.homogeneousSubmodule_fg ι ℂ n)

theorem homogeneous_mem_homogeneousMapLowDegreeSubmodule
    {ι : Type*} {p : MvPolynomial ι ℂ} {n N : ℕ}
    (hp : p.IsHomogeneous n) (hn : n < N) :
    p ∈ homogeneousMapLowDegreeSubmodule ι N := by
  unfold homogeneousMapLowDegreeSubmodule
  apply (le_iSup (fun j : ℕ =>
    ⨆ _ : j ∈ Finset.range N,
      MvPolynomial.homogeneousSubmodule ι ℂ j) n)
  apply (le_iSup (fun _ : n ∈ Finset.range N =>
    MvPolynomial.homogeneousSubmodule ι ℂ n)
    (Finset.mem_range.mpr hn))
  exact hp

theorem homogeneous_mem_idealOfVars_pow_of_le
    {ι : Type*} {p : MvPolynomial ι ℂ} {n N : ℕ}
    (hp : p.IsHomogeneous n) (hN : N ≤ n) :
    p ∈ MvPolynomial.idealOfVars ι ℂ ^ N := by
  rw [MvPolynomial.mem_pow_idealOfVars_iff']
  intro monomial hmonomial
  apply hp.coeff_eq_zero
  omega

theorem exists_high_homogeneousSubmodule_le_homogeneousMapIdeal
    {ι : Type*} [Finite ι]
    (F : ι → MvPolynomial ι ℂ)
    (hzero : ∀ point : ι → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    ∃ N : ℕ, ∀ n : ℕ, N ≤ n →
      ∀ p : MvPolynomial ι ℂ,
        p.IsHomogeneous n → p ∈ homogeneousMapIdeal F := by
  obtain ⟨N, hN⟩ :=
    exists_idealOfVars_pow_le_homogeneousMapIdeal F hzero
  refine ⟨N, ?_⟩
  intro n hn p hp
  exact hN (homogeneous_mem_idealOfVars_pow_of_le hp hn)

theorem homogeneousMapIdeal_isHomogeneous
    {ι : Type*} (F : ι → MvPolynomial ι ℂ) (e : ℕ)
    (hF : ∀ i, (F i).IsHomogeneous e) :
    Ideal.IsHomogeneous (MvPolynomial.homogeneousSubmodule ι ℂ)
      (homogeneousMapIdeal F) := by
  classical
  unfold homogeneousMapIdeal
  apply Ideal.homogeneous_span
  rintro _ ⟨i, rfl⟩
  exact ⟨e, hF i⟩

theorem homogeneousComponent_mul_of_right_isHomogeneous
    {ι : Type*} (g f : MvPolynomial ι ℂ) {e n : ℕ}
    (hf : f.IsHomogeneous e) (hen : e ≤ n) :
    MvPolynomial.homogeneousComponent n (g * f) =
      MvPolynomial.homogeneousComponent (n - e) g * f := by
  have hcomponent (q : MvPolynomial ι ℂ) (j : ℕ) :
      (DirectSum.decompose
        (MvPolynomial.homogeneousSubmodule ι ℂ) q j :
          MvPolynomial ι ℂ) = MvPolynomial.homogeneousComponent j q := by
    change
      (((inferInstance : DirectSum.Decomposition
        (MvPolynomial.homogeneousSubmodule ι ℂ)).decompose' q j :
          MvPolynomial ι ℂ)) = _
    rw [show (inferInstance : DirectSum.Decomposition
      (MvPolynomial.homogeneousSubmodule ι ℂ)) =
        MvPolynomial.decomposition from Subsingleton.elim _ _]
    exact MvPolynomial.decomposition.decompose'_apply q j
  have hprojection :=
    DirectSum.coe_decompose_mul_of_right_mem_of_le
      (𝒜 := MvPolynomial.homogeneousSubmodule ι ℂ)
      (a := g) (b := f) (n := n) (i := e) hf hen
  simpa only [hcomponent] using hprojection

theorem homogeneousMapIdeal_homogeneous_representation
    {ι : Type*} [Fintype ι]
    (F : ι → MvPolynomial ι ℂ) {e n : ℕ}
    (hF : ∀ i, (F i).IsHomogeneous e) (hen : e ≤ n)
    (p : MvPolynomial ι ℂ) (hp : p.IsHomogeneous n)
    (hmem : p ∈ homogeneousMapIdeal F) :
    ∃ coefficients : ι → MvPolynomial ι ℂ,
      (∀ i, (coefficients i).IsHomogeneous (n - e)) ∧
      ∑ i, coefficients i * F i = p := by
  classical
  unfold homogeneousMapIdeal at hmem
  obtain ⟨coefficients, hcoefficients⟩ :=
    (Ideal.mem_span_range_iff_exists_fun).mp hmem
  refine ⟨fun i =>
    MvPolynomial.homogeneousComponent (n - e) (coefficients i),
    fun i => MvPolynomial.homogeneousComponent_isHomogeneous
      (n - e) (coefficients i), ?_⟩
  have hcomponent := congrArg
    (fun q : MvPolynomial ι ℂ => MvPolynomial.homogeneousComponent n q)
    hcoefficients
  simp only [map_sum] at hcomponent
  simp_rw [homogeneousComponent_mul_of_right_isHomogeneous _ _ (hF _) hen]
    at hcomponent
  simpa only [MvPolynomial.homogeneousComponent_eq_self hp] using hcomponent

theorem homogeneousMap_moduleFinite
    {ι : Type*} [Finite ι]
    (F : ι → MvPolynomial ι ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : ι → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    Module.Finite (homogeneousMapSubalgebra F) (MvPolynomial ι ℂ) := by
  classical
  letI := Fintype.ofFinite ι
  obtain ⟨N₀, hN₀⟩ :=
    exists_idealOfVars_pow_le_homogeneousMapIdeal F hzero
  obtain ⟨generators, hgenerators⟩ :=
    homogeneousMapLowDegreeSubmodule_fg (ι := ι) (max N₀ e)
  let T := homogeneousMapSubalgebra F
  let M : Submodule T (MvPolynomial ι ℂ) :=
    Submodule.span T (generators : Set (MvPolynomial ι ℂ))
  have hlow :
      homogeneousMapLowDegreeSubmodule ι (max N₀ e) ≤
        M.restrictScalars ℂ := by
    rw [← hgenerators]
    exact Submodule.span_le_restrictScalars ℂ T
      (generators : Set (MvPolynomial ι ℂ))
  have hgraded : ∀ n : ℕ, ∀ p : MvPolynomial ι ℂ,
      p.IsHomogeneous n → p ∈ M := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro p hp
      by_cases hn : n < max N₀ e
      · exact hlow
          (homogeneous_mem_homogeneousMapLowDegreeSubmodule hp hn)
      · have hmax : max N₀ e ≤ n := Nat.le_of_not_gt hn
        have he_le : e ≤ n := le_trans (Nat.le_max_right N₀ e) hmax
        have hN_le : N₀ ≤ n := le_trans (Nat.le_max_left N₀ e) hmax
        have hp_ideal : p ∈ homogeneousMapIdeal F :=
          hN₀ (homogeneous_mem_idealOfVars_pow_of_le hp hN_le)
        obtain ⟨coefficients, hcoefficients, hsum⟩ :=
          homogeneousMapIdeal_homogeneous_representation
            F hF he_le p hp hp_ideal
        rw [← hsum]
        apply M.sum_mem
        intro i _
        have hcoefficient : coefficients i ∈ M :=
          ih (n - e) (by omega) (coefficients i) (hcoefficients i)
        have hscalar := M.smul_mem
          (⟨F i, homogeneousMap_coordinate_mem_subalgebra F i⟩ : T)
          hcoefficient
        simpa only [mul_comm, Algebra.smul_def, Subalgebra.algebraMap_apply] using hscalar
  apply Module.Finite.of_fg_top
  refine ⟨generators, ?_⟩
  change M = ⊤
  apply top_unique
  intro p _
  rw [← MvPolynomial.sum_homogeneousComponent p]
  exact M.sum_mem fun n _ =>
    hgraded n (MvPolynomial.homogeneousComponent n p)
      (MvPolynomial.homogeneousComponent_isHomogeneous n p)

theorem homogeneousMap_isIntegral
    {ι : Type*} [Finite ι]
    (F : ι → MvPolynomial ι ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : ι → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    Algebra.IsIntegral (homogeneousMapSubalgebra F)
      (MvPolynomial ι ℂ) := by
  letI := homogeneousMap_moduleFinite F e he hF hzero
  exact Algebra.IsIntegral.of_finite _ _

theorem homogeneousMap_isTranscendenceBasis
    {ι : Type*} [Finite ι]
    (F : ι → MvPolynomial ι ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : ι → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    IsTranscendenceBasis ℂ F := by
  letI : Module.Finite (Algebra.adjoin ℂ (Set.range F))
      (MvPolynomial ι ℂ) :=
    homogeneousMap_moduleFinite F e he hF hzero
  apply Algebra.IsAlgebraic.isTranscendenceBasis_of_le_trdeg_of_finite ℂ F
  simp only [MvPolynomial.trdeg_of_isDomain, Cardinal.lift_uzero, Std.le_refl]

theorem homogeneousMap_algebraicIndependent
    {ι : Type*} [Finite ι]
    (F : ι → MvPolynomial ι ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : ι → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    AlgebraicIndependent ℂ F :=
  (homogeneousMap_isTranscendenceBasis F e he hF hzero).1

noncomputable def homogeneousMapCoordinateAlgEquiv
    {ι : Type*} [Finite ι]
    (F : ι → MvPolynomial ι ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : ι → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    MvPolynomial ι ℂ ≃ₐ[ℂ] homogeneousMapSubalgebra F :=
  (homogeneousMap_algebraicIndependent F e he hF hzero).aevalEquiv

section FractionField

theorem finite_of_totalDegree_power_reductions
    {ι B A : Type*} [Fintype ι] [CommRing B] [CommRing A] [Algebra B A]
    (x : ι → A) (q : ℕ) (_hq : 0 < q)
    (remainder : ι → MvPolynomial ι B)
    (hdegree : ∀ i, (remainder i).totalDegree < q)
    (hrel : ∀ i, x i ^ q = MvPolynomial.aeval x (remainder i))
    (hgen : Algebra.adjoin B (Set.range x) = ⊤) :
    Module.Finite B A := by
  classical
  let N : ℕ := Fintype.card ι * q + 1
  let small : Set A :=
    (fun m : ι →₀ ℕ =>
      MvPolynomial.aeval x (MvPolynomial.monomial m (1 : B))) ''
        {m : ι →₀ ℕ | m.degree < N}
  let M : Submodule B A := Submodule.span B small
  have hfinite : small.Finite :=
    (Finsupp.finite_of_degree_lt N).image _
  have hlarge (m : ι →₀ ℕ) (hm : N ≤ m.degree) :
      ∃ i : ι, q ≤ m i := by
    by_contra hnone
    push Not at hnone
    have hbound :
        ∑ i : ι, m i ≤ ∑ _i : ι, q := by
      apply Finset.sum_le_sum
      intro i _
      exact Nat.le_of_lt (hnone i)
    have hbound' :
        ∑ i : ι, m i ≤ Fintype.card ι * q := by
      simpa only [Finset.sum_const, Finset.card_univ, smul_eq_mul] using hbound
    rw [Finsupp.degree_eq_sum] at hm
    dsimp [N] at hm
    omega
  have hmonomial : ∀ n : ℕ, ∀ m : ι →₀ ℕ,
      m.degree = n →
        MvPolynomial.aeval x (MvPolynomial.monomial m (1 : B)) ∈ M := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro m hm
      by_cases hn : m.degree < N
      · exact Submodule.subset_span ⟨m, hn, rfl⟩
      · obtain ⟨i, hi⟩ := hlarge m (Nat.le_of_not_gt hn)
        let m' : ι →₀ ℕ := m - Finsupp.single i q
        have hdecomp : m' + Finsupp.single i q = m :=
          tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr hi)
        have hrest : m'.degree + q = m.degree := by
          rw [← Finsupp.degree_single i q, ← map_add, hdecomp]
        have hfactor :
            MvPolynomial.aeval x (MvPolynomial.monomial m (1 : B)) =
              MvPolynomial.aeval x (MvPolynomial.monomial m' (1 : B)) *
                x i ^ q := by
          conv_lhs => rw [← hdecomp]
          rw [MvPolynomial.monomial_add_single, map_mul, map_pow]
          simp only [MvPolynomial.aeval_X]
        rw [hfactor, hrel i, (remainder i).as_sum, map_sum,
          Finset.mul_sum]
        apply M.sum_mem
        intro d hd
        have hdlt : d.degree < q :=
          lt_of_le_of_lt (MvPolynomial.le_totalDegree hd) (hdegree i)
        have hnew : (m' + d).degree < n := by
          rw [map_add]
          omega
        have hmem :
            MvPolynomial.aeval x
              (MvPolynomial.monomial (m' + d) (1 : B)) ∈ M :=
          ih _ hnew (m' + d) rfl
        have hterm :
            MvPolynomial.aeval x (MvPolynomial.monomial m' (1 : B)) *
                MvPolynomial.aeval x
                  (MvPolynomial.monomial d ((remainder i).coeff d)) =
              ((remainder i).coeff d) • MvPolynomial.aeval x
                (MvPolynomial.monomial (m' + d) (1 : B)) := by
          rw [← map_mul, MvPolynomial.monomial_mul]
          simp only [one_mul, MvPolynomial.aeval_monomial, Finsupp.prod_pow, Finsupp.coe_add, Pi.add_apply, map_one,
            Algebra.smul_def]
        rw [hterm]
        exact M.smul_mem _ hmem
  have hfg : M.FG := Submodule.fg_span hfinite
  have hsurj : Function.Surjective
      (MvPolynomial.aeval x : MvPolynomial ι B →ₐ[B] A) := by
    apply (AlgHom.range_eq_top _).mp
    rw [← Algebra.adjoin_range_eq_range_aeval, hgen]
  have htop : M = (⊤ : Submodule B A) := by
    apply top_unique
    intro a _
    obtain ⟨p, rfl⟩ := hsurj a
    rw [p.as_sum, map_sum]
    apply M.sum_mem
    intro d _
    have hmem := hmonomial d.degree d rfl
    have hterm :
        MvPolynomial.aeval x (MvPolynomial.monomial d (p.coeff d)) =
          (p.coeff d) •
            MvPolynomial.aeval x (MvPolynomial.monomial d (1 : B)) := by
      simp only [MvPolynomial.aeval_monomial, Finsupp.prod_pow, map_one, one_mul, Algebra.smul_def]
    rw [hterm]
    exact M.smul_mem _ hmem
  apply Module.Finite.of_fg_top
  rw [← htop]
  exact hfg

end FractionField

end Standalone_HomogeneousFiniteness

section Standalone_LeadingForms

open scoped BigOperators

noncomputable def coordinateEsymm {t : ℕ} (u : Fin t → ℂ) (q : ℕ) : ℂ :=
  ((Finset.univ : Finset (Fin t)).val.map u).esymm q

noncomputable def deletedCoordinateEsymm {t : ℕ}
    (u : Fin t → ℂ) (i : Fin t) (q : ℕ) : ℂ :=
  (((Finset.univ : Finset (Fin t)).erase i).val.map u).esymm q

noncomputable def deletedCoordinateEsymmPolynomial (t q : ℕ) (i : Fin t) :
    MvPolynomial (Fin t) ℂ :=
  (((Finset.univ : Finset (Fin t)).erase i).val.map
    (fun j => (MvPolynomial.X j : MvPolynomial (Fin t) ℂ))).esymm q

theorem eval_deletedCoordinateEsymmPolynomial {t : ℕ}
    (u : Fin t → ℂ) (i : Fin t) (q : ℕ) :
    MvPolynomial.eval u (deletedCoordinateEsymmPolynomial t q i) =
      deletedCoordinateEsymm u i q := by
  classical
  simp only [deletedCoordinateEsymmPolynomial, deletedCoordinateEsymm,
    Finset.esymm_map_val, map_sum, map_prod, MvPolynomial.eval_X]

theorem coordinateEsymm_succ_eq_deleted {t : ℕ}
    (u : Fin t → ℂ) (i : Fin t) (q : ℕ) :
    coordinateEsymm u (q + 1) =
      deletedCoordinateEsymm u i (q + 1) +
        u i * deletedCoordinateEsymm u i q := by
  classical
  have hvars :
      ((Finset.univ : Finset (Fin t)).val.map u) =
        u i ::ₘ (((Finset.univ : Finset (Fin t)).erase i).val.map u) := by
    conv_lhs =>
      rw [← Finset.insert_erase (Finset.mem_univ i),
        Finset.insert_val_of_notMem (Finset.notMem_erase i _), Multiset.map_cons]
  simp only [coordinateEsymm, Multiset.esymm, hvars, Finset.erase_val, Multiset.powersetCard_cons,
    Multiset.map_add, Multiset.map_map, Function.comp_apply, Multiset.prod_cons, Multiset.sum_add,
    Multiset.sum_map_mul_left, deletedCoordinateEsymm]

theorem powersetCard_erase_eq_filter_not_mem {α : Type*} [DecidableEq α]
    (s : Finset α) (i : α) (q : ℕ) :
    (s.erase i).powersetCard q =
      (s.powersetCard q).filter (fun rows => i ∉ rows) := by
  ext rows
  simp only [Finset.mem_powersetCard, Finset.mem_filter]
  constructor
  · rintro ⟨hrows, hcard⟩
    refine ⟨⟨fun j hj => (Finset.mem_erase.mp (hrows hj)).2, hcard⟩, ?_⟩
    intro hi
    exact Finset.notMem_erase i s (hrows hi)
  · rintro ⟨⟨hrows, hcard⟩, hi⟩
    refine ⟨fun j hj => Finset.mem_erase.mpr ⟨?_, hrows hj⟩, hcard⟩
    intro heq
    exact hi (heq ▸ hj)

theorem sum_deletedCoordinateEsymm {t : ℕ}
    (u : Fin t → ℂ) (q : ℕ) :
    (∑ i : Fin t, deletedCoordinateEsymm u i q) =
      ((t - q : ℕ) : ℂ) * coordinateEsymm u q := by
  classical
  calc
    (∑ i : Fin t, deletedCoordinateEsymm u i q) =
        ∑ i : Fin t,
          ∑ rows ∈ ((Finset.univ : Finset (Fin t)).powersetCard q).filter
            (fun rows => i ∉ rows), ∏ j ∈ rows, u j := by
      simp_rw [deletedCoordinateEsymm, Finset.esymm_map_val,
        powersetCard_erase_eq_filter_not_mem]
    _ = ∑ i : Fin t, ∑ rows ∈
          (Finset.univ : Finset (Fin t)).powersetCard q,
            if i ∉ rows then ∏ j ∈ rows, u j else 0 := by
      simp_rw [Finset.sum_filter]
    _ = ∑ rows ∈ (Finset.univ : Finset (Fin t)).powersetCard q,
          ∑ i : Fin t, if i ∉ rows then ∏ j ∈ rows, u j else 0 := by
      rw [Finset.sum_comm]
    _ = ((t - q : ℕ) : ℂ) * coordinateEsymm u q := by
      rw [coordinateEsymm, Finset.esymm_map_val, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro rows hrows
      have hcard : rows.card = q := (Finset.mem_powersetCard.mp hrows).2
      calc
        (∑ i : Fin t, if i ∉ rows then ∏ j ∈ rows, u j else 0) =
            (∑ i : Fin t, if i ∉ rows then (1 : ℂ) else 0) *
              ∏ j ∈ rows, u j := by
          rw [Finset.sum_mul]
          apply Finset.sum_congr rfl
          intro i _
          split_ifs <;> simp
        _ = ((t - q : ℕ) : ℂ) * ∏ j ∈ rows, u j := by
          rw [Finset.sum_boole]
          congr 1
          simp only [Finset.filter_notMem_eq_sdiff, Finset.card_sdiff_of_subset (Finset.subset_univ rows),
            Finset.card_univ, Fintype.card_fin, hcard]

end Standalone_LeadingForms

section Standalone_ProjectiveDimension

open scoped LinearAlgebra.Projectivization

section AlgebraicProjectiveLeadingForms

attribute [local instance] MvPolynomial.gradedAlgebra

theorem leadingFormProjective_idealOfVars_isPrime (t : ℕ) :
    (MvPolynomial.idealOfVars (Fin t) ℂ).IsPrime := by
  rw [← vanishingIdeal_origin_eq_idealOfVars]
  infer_instance

theorem homogeneousIdeal_minimalPrime_isHomogeneous {t : ℕ}
    (I P : Ideal (MvPolynomial (Fin t) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ))
    (hP : P ∈ I.minimalPrimes) :
    P.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin t) ℂ) := by
  let core := P.homogeneousCore
    (MvPolynomial.homogeneousSubmodule (Fin t) ℂ)
  have hcoreprime : core.toIdeal.IsPrime :=
    hP.isPrime.homogeneousCore
  have hcorele : core.toIdeal ≤ P :=
    Ideal.toIdeal_homogeneousCore_le
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ) P
  have hIcore : I ≤ core.toIdeal := by
    rw [← hI.toIdeal_homogeneousCore_eq_self]
    exact Ideal.homogeneousCore_mono
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ) hP.le
  have hreverse : P ≤ core.toIdeal :=
    hP.2 ⟨hcoreprime, hIcore⟩ hcorele
  have heq : core.toIdeal = P :=
    le_antisymm hcorele hreverse
  rw [← heq]
  exact core.isHomogeneous

theorem homogeneousPrime_le_idealOfVars {t : ℕ}
    (P : Ideal (MvPolynomial (Fin t) ℂ)) (hP : P.IsPrime)
    (hhomogeneous : P.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ)) :
    P ≤ MvPolynomial.idealOfVars (Fin t) ℂ := by
  letI : P.IsPrime := hP
  intro p hp
  rw [← vanishingIdeal_origin_eq_idealOfVars,
    MvPolynomial.mem_vanishingIdeal_singleton_iff,
    MvPolynomial.aeval_zero]
  by_contra hconstant
  have hcomponent :
      MvPolynomial.homogeneousComponent 0 p ∈ P :=
    MvPolynomial.homogeneousComponent_mem_of_mem hhomogeneous hp 0
  rw [MvPolynomial.homogeneousComponent_zero] at hcomponent
  have hunit :
      IsUnit (MvPolynomial.C (MvPolynomial.coeff 0 p) :
        MvPolynomial (Fin t) ℂ) :=
    (isUnit_iff_ne_zero.mpr
      (by simpa only [ne_eq, Algebra.algebraMap_self, MvPolynomial.constantCoeff_eq, RingHom.id_apply] using hconstant)).map
        MvPolynomial.C
  exact (Ideal.notMem_of_isUnit P hunit) hcomponent

theorem homogeneousIdeal_radical_eq_idealOfVars_of_vertex_minimal {t : ℕ}
    (I : Ideal (MvPolynomial (Fin t) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ))
    (hvertex : MvPolynomial.idealOfVars (Fin t) ℂ ∈ I.minimalPrimes) :
    I.radical = MvPolynomial.idealOfVars (Fin t) ℂ := by
  rw [← I.sInf_minimalPrimes]
  apply le_antisymm
  · exact sInf_le hvertex
  · apply le_sInf
    intro P hP
    have hPhomogeneous :=
      homogeneousIdeal_minimalPrime_isHomogeneous I P hI hP
    have hPvertex : P ≤ MvPolynomial.idealOfVars (Fin t) ℂ :=
      homogeneousPrime_le_idealOfVars P hP.isPrime hPhomogeneous
    exact hvertex.2 ⟨hP.isPrime, hP.le⟩ hPvertex

theorem homogeneousIdeal_vertex_not_minimal_of_ringKrullDim_pos {t : ℕ}
    (I : Ideal (MvPolynomial (Fin t) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ))
    (hpositive :
      (0 : WithBot ℕ∞) < ringKrullDim
        (MvPolynomial (Fin t) ℂ ⧸ I)) :
    MvPolynomial.idealOfVars (Fin t) ℂ ∉ I.minimalPrimes := by
  intro hvertex
  have hradical :=
    homogeneousIdeal_radical_eq_idealOfVars_of_vertex_minimal
      I hI hvertex
  have hvertexDimension :
      ringKrullDim
        (MvPolynomial (Fin t) ℂ ⧸
          MvPolynomial.idealOfVars (Fin t) ℂ) =
        (0 : WithBot ℕ∞) := by
    rw [← vanishingIdeal_origin_eq_idealOfVars]
    simpa only [Submodule.bot_coe, finrank_bot, CharP.cast_eq_zero] using
      submoduleVanishingIdealCoordinateRing_ringKrullDim (⊥ : Submodule ℂ (Fin t → ℂ))
  have hzero :
      ringKrullDim (MvPolynomial (Fin t) ℂ ⧸ I) =
        (0 : WithBot ℕ∞) := by
    calc
      ringKrullDim (MvPolynomial (Fin t) ℂ ⧸ I) =
          ringKrullDim (MvPolynomial (Fin t) ℂ ⧸ I.radical) := by
        rw [ringKrullDim_quotient, ringKrullDim_quotient,
          PrimeSpectrum.zeroLocus_radical]
      _ = ringKrullDim
          (MvPolynomial (Fin t) ℂ ⧸
            MvPolynomial.idealOfVars (Fin t) ℂ) := by rw [hradical]
      _ = (0 : WithBot ℕ∞) := hvertexDimension
  rw [hzero] at hpositive
  exact (lt_irrefl _ hpositive)

theorem homogeneousIdeal_minimalPrime_exists_variable_notMem
    {t : ℕ} (I : Ideal (MvPolynomial (Fin t) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ))
    (hpositive :
      (0 : WithBot ℕ∞) < ringKrullDim
        (MvPolynomial (Fin t) ℂ ⧸ I)) :
    ∀ P ∈ I.minimalPrimes,
      ∃ i : Fin t, MvPolynomial.X i ∉ P := by
  intro P hP
  by_contra hnone
  simp only [not_exists, not_not] at hnone
  have hvariables : MvPolynomial.idealOfVars (Fin t) ℂ ≤ P := by
    rw [MvPolynomial.idealOfVars, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact hnone i
  have hhomogeneous :=
    homogeneousIdeal_minimalPrime_isHomogeneous I P hI hP
  have hreverse : P ≤ MvPolynomial.idealOfVars (Fin t) ℂ :=
    homogeneousPrime_le_idealOfVars P hP.isPrime hhomogeneous
  have heq : P = MvPolynomial.idealOfVars (Fin t) ℂ :=
    le_antisymm hreverse hvariables
  exact homogeneousIdeal_vertex_not_minimal_of_ringKrullDim_pos
    I hI hpositive (heq ▸ hP)

theorem homogeneousIdeal_radical_eq_idealOfVars_of_ringKrullDim_le_zero
    {t : ℕ} (I : Ideal (MvPolynomial (Fin t) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ))
    (hproper : I ≠ ⊤)
    (hdimension : ringKrullDim (MvPolynomial (Fin t) ℂ ⧸ I) ≤
      (0 : WithBot ℕ∞)) :
    I.radical = MvPolynomial.idealOfVars (Fin t) ℂ := by
  have hzero : Ring.KrullDimLE 0 (MvPolynomial (Fin t) ℂ ⧸ I) :=
    Ring.krullDimLE_iff.mpr hdimension
  have hallmaximal : ∀ P ∈ I.minimalPrimes, P.IsMaximal :=
    Ideal.krullDimLE_zero_quotient_iff_forall_minimalPrimes_isMaximal.mp
      hzero
  have hvertexprime := leadingFormProjective_idealOfVars_isPrime t
  rw [← I.sInf_minimalPrimes]
  apply le_antisymm
  · obtain ⟨⟨P, hP⟩⟩ := Ideal.nonempty_minimalPrimes hproper
    have hPhomogeneous :=
      homogeneousIdeal_minimalPrime_isHomogeneous I P hI hP
    have hPvertex :=
      homogeneousPrime_le_idealOfVars P hP.isPrime hPhomogeneous
    have hPeq : P = MvPolynomial.idealOfVars (Fin t) ℂ :=
      (hallmaximal P hP).eq_of_le hvertexprime.ne_top hPvertex
    rw [← hPeq]
    exact sInf_le hP
  · apply le_sInf
    intro P hP
    have hPhomogeneous :=
      homogeneousIdeal_minimalPrime_isHomogeneous I P hI hP
    have hPvertex :=
      homogeneousPrime_le_idealOfVars P hP.isPrime hPhomogeneous
    have hPeq : P = MvPolynomial.idealOfVars (Fin t) ℂ :=
      (hallmaximal P hP).eq_of_le hvertexprime.ne_top hPvertex
    exact hPeq.symm.le

theorem supportDim_quotSMulTop_idealQuotient_eq_ringKrullDim_sup
    {R : Type*} [CommRing R] (I : Ideal R) (x : R) :
    Module.supportDim R (QuotSMulTop x (R ⧸ I)) =
      ringKrullDim (R ⧸ (I ⊔ Ideal.span ({x} : Set R))) := by
  rw [Module.supportDim, Module.support_quotSMulTop,
    Module.support_eq_zeroLocus, Ideal.annihilator_quotient,
    ringKrullDim_quotient, PrimeSpectrum.zeroLocus_sup,
    PrimeSpectrum.zeroLocus_span]

theorem permanentRolloutLinearCoordinateCombination_isHomogeneous
    {t : ℕ} (c : Fin t → ℂ) :
    (permanentRolloutLinearCoordinateCombination t c).IsHomogeneous 1 := by
  change (∑ i, c i • MvPolynomial.X i) ∈
    MvPolynomial.homogeneousSubmodule (Fin t) ℂ 1
  apply Submodule.sum_mem
  intro i _
  exact Submodule.smul_mem _ _ (MvPolynomial.isHomogeneous_X ℂ i)

noncomputable def homogeneousLinearSliceIdeal {t n : ℕ}
    (I : Ideal (MvPolynomial (Fin t) ℂ)) (c : Fin n → Fin t → ℂ) :
    Ideal (MvPolynomial (Fin t) ℂ) :=
  I ⊔ Ideal.span (Set.range fun j =>
    permanentRolloutLinearCoordinateCombination t (c j))

theorem homogeneousLinearSliceIdeal_isHomogeneous {t n : ℕ}
    (I : Ideal (MvPolynomial (Fin t) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ))
    (c : Fin n → Fin t → ℂ) :
    (homogeneousLinearSliceIdeal I c).IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ) := by
  unfold homogeneousLinearSliceIdeal
  apply hI.sup
  apply Ideal.homogeneous_span
  rintro _ ⟨j, rfl⟩
  exact ⟨1, permanentRolloutLinearCoordinateCombination_isHomogeneous (c j)⟩

theorem homogeneousLinearSliceIdeal_snoc {t n : ℕ}
    (I : Ideal (MvPolynomial (Fin t) ℂ))
    (c : Fin n → Fin t → ℂ) (x : Fin t → ℂ) :
    homogeneousLinearSliceIdeal I (Fin.snoc c x) =
      homogeneousLinearSliceIdeal I c ⊔
        Ideal.span
          ({permanentRolloutLinearCoordinateCombination t x} :
            Set (MvPolynomial (Fin t) ℂ)) := by
  unfold homogeneousLinearSliceIdeal
  have hsnoc :
      (fun j : Fin (n + 1) =>
        permanentRolloutLinearCoordinateCombination t
          ((Fin.snoc c x : Fin (n + 1) → Fin t → ℂ) j)) =
      Fin.snoc
        (fun j => permanentRolloutLinearCoordinateCombination t (c j))
        (permanentRolloutLinearCoordinateCombination t x) := by
    funext j
    induction j using Fin.lastCases <;> simp
  rw [hsnoc, Fin.range_snoc, Ideal.span_insert]
  ac_rfl

theorem homogeneousLinearSliceIdeal_coefficient_span_le_minimalPrime
    {t n : ℕ} (I : Ideal (MvPolynomial (Fin t) ℂ))
    (c : Fin n → Fin t → ℂ)
    (P : Ideal (MvPolynomial (Fin t) ℂ))
    (hP : P ∈ (homogeneousLinearSliceIdeal I c).minimalPrimes) :
    Submodule.span ℂ (Set.range c) ≤
      (P.restrictScalars ℂ).comap
        (permanentRolloutLinearCoordinateCombination t) := by
  rw [Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  change permanentRolloutLinearCoordinateCombination t (c j) ∈ P
  apply hP.le
  exact (show Ideal.span (Set.range fun k =>
    permanentRolloutLinearCoordinateCombination t (c k)) ≤
      homogeneousLinearSliceIdeal I c from le_sup_right)
    (Ideal.subset_span ⟨j, rfl⟩)

theorem homogeneousLinearSliceIdeal_exists_independent_dimension_drop
    {t n : ℕ} (I : Ideal (MvPolynomial (Fin t) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ))
    (c : Fin n → Fin t → ℂ)
    (hindependent : LinearIndependent ℂ c)
    (hpositive : (0 : WithBot ℕ∞) <
      ringKrullDim
        (MvPolynomial (Fin t) ℂ ⧸ homogeneousLinearSliceIdeal I c)) :
    ∃ x : Fin t → ℂ,
      LinearIndependent ℂ (Fin.snoc c x) ∧
        ringKrullDim
          (MvPolynomial (Fin t) ℂ ⧸
            homogeneousLinearSliceIdeal I (Fin.snoc c x)) + 1 ≤
          ringKrullDim
            (MvPolynomial (Fin t) ℂ ⧸
              homogeneousLinearSliceIdeal I c) := by
  let J := homogeneousLinearSliceIdeal I c
  change (0 : WithBot ℕ∞) <
    ringKrullDim (MvPolynomial (Fin t) ℂ ⧸ J) at hpositive
  have hJhomogeneous : J.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ) :=
    homogeneousLinearSliceIdeal_isHomogeneous I hI c
  have hcoordinate : ∀ P ∈ J.minimalPrimes,
      ∃ i : Fin t, MvPolynomial.X i ∉ P :=
    homogeneousIdeal_minimalPrime_exists_variable_notMem
      J hJhomogeneous hpositive
  obtain ⟨x, hx⟩ :=
    permanent_rollout_exists_linear_avoiding_minimalPrimes J hcoordinate
  have hproper : J ≠ ⊤ := by
    intro htop
    have hbottom : ringKrullDim (MvPolynomial (Fin t) ℂ ⧸ J) =
        (⊥ : WithBot ℕ∞) := by
      rw [htop]
      exact ringKrullDim_eq_bot_of_subsingleton
    rw [hbottom] at hpositive
    exact (not_lt_bot hpositive)
  obtain ⟨⟨P, hP⟩⟩ := Ideal.nonempty_minimalPrimes hproper
  have hxspan : x ∉ Submodule.span ℂ (Set.range c) := by
    intro hspan
    apply hx P hP
    exact homogeneousLinearSliceIdeal_coefficient_span_le_minimalPrime
      I c P hP hspan
  refine ⟨x, hindependent.finSnoc hxspan, ?_⟩
  have hdrop :=
    Module.supportDim_quotSMulTop_succ_le_of_notMem_minimalPrimes
      (R := MvPolynomial (Fin t) ℂ)
      (M := MvPolynomial (Fin t) ℂ ⧸ J)
      (x := permanentRolloutLinearCoordinateCombination t x)
      (by
        intro Q hQ
        rw [Ideal.annihilator_quotient] at hQ
        exact hx Q hQ)
  rw [supportDim_quotSMulTop_idealQuotient_eq_ringKrullDim_sup,
    Module.supportDim_quotient_eq_ringKrullDim] at hdrop
  rw [homogeneousLinearSliceIdeal_snoc]
  exact hdrop

theorem homogeneousLinearSliceIdeal_exists_independent_zeroDimensional_extension
    {t p : ℕ} (I : Ideal (MvPolynomial (Fin t) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ))
    (c : Fin p → Fin t → ℂ)
    (hindependent : LinearIndependent ℂ c)
    (q : ℕ) (hlength : p + q ≤ t)
    (hdimension : ringKrullDim
      (MvPolynomial (Fin t) ℂ ⧸ homogeneousLinearSliceIdeal I c) ≤
        (↑q : WithBot ℕ∞)) :
    ∃ x : Fin (p + q) → Fin t → ℂ,
      LinearIndependent ℂ x ∧
        ringKrullDim
          (MvPolynomial (Fin t) ℂ ⧸ homogeneousLinearSliceIdeal I x) ≤
          (0 : WithBot ℕ∞) := by
  induction q generalizing p c with
  | zero =>
      simpa only [Nat.add_zero] using ⟨c, hindependent, hdimension⟩
  | succ q ih =>
      by_cases hpositive : (0 : WithBot ℕ∞) <
          ringKrullDim
            (MvPolynomial (Fin t) ℂ ⧸ homogeneousLinearSliceIdeal I c)
      · obtain ⟨a, hindependent', hdrop⟩ :=
          homogeneousLinearSliceIdeal_exists_independent_dimension_drop
            I hI c hindependent hpositive
        have hdimension' : ringKrullDim
            (MvPolynomial (Fin t) ℂ ⧸
              homogeneousLinearSliceIdeal I (Fin.snoc c a)) ≤
              (↑q : WithBot ℕ∞) := by
          apply ENat.WithBot.add_le_add_one_right_iff.mp
          calc
            ringKrullDim
                (MvPolynomial (Fin t) ℂ ⧸
                  homogeneousLinearSliceIdeal I (Fin.snoc c a)) + 1 ≤
                ringKrullDim
                  (MvPolynomial (Fin t) ℂ ⧸
                    homogeneousLinearSliceIdeal I c) := hdrop
            _ ≤ (↑(q + 1) : WithBot ℕ∞) := hdimension
            _ = (↑q : WithBot ℕ∞) + 1 := by simp only [Nat.cast_add, Nat.cast_one]
        have hlength' : (p + 1) + q ≤ t := by omega
        have hindex : (p + 1) + q = p + (q + 1) := by omega
        rw [← hindex]
        exact ih (Fin.snoc c a) hindependent' hlength' hdimension'
      · have hzero : ringKrullDim
            (MvPolynomial (Fin t) ℂ ⧸ homogeneousLinearSliceIdeal I c) ≤
              (0 : WithBot ℕ∞) := le_of_not_gt hpositive
        have hroom : p < Module.finrank ℂ (Fin t → ℂ) := by
          rw [Module.finrank_fintype_fun_eq_card, Fintype.card_fin]
          omega
        obtain ⟨a, hindependent'⟩ :=
          exists_linearIndependent_snoc_of_lt_finrank hindependent hroom
        have hstage : homogeneousLinearSliceIdeal I c ≤
            homogeneousLinearSliceIdeal I (Fin.snoc c a) := by
          rw [homogeneousLinearSliceIdeal_snoc]
          exact le_sup_left
        have hdimension' : ringKrullDim
            (MvPolynomial (Fin t) ℂ ⧸
              homogeneousLinearSliceIdeal I (Fin.snoc c a)) ≤
              (↑q : WithBot ℕ∞) := by
          calc
            ringKrullDim
                (MvPolynomial (Fin t) ℂ ⧸
                  homogeneousLinearSliceIdeal I (Fin.snoc c a)) ≤
                ringKrullDim
                  (MvPolynomial (Fin t) ℂ ⧸
                    homogeneousLinearSliceIdeal I c) :=
              ringKrullDim_le_of_surjective
                (Ideal.Quotient.factor hstage)
                (Ideal.Quotient.factor_surjective hstage)
            _ ≤ (0 : WithBot ℕ∞) := hzero
            _ ≤ (↑q : WithBot ℕ∞) := by exact_mod_cast Nat.zero_le q
        have hlength' : (p + 1) + q ≤ t := by omega
        have hindex : (p + 1) + q = p + (q + 1) := by omega
        rw [← hindex]
        exact ih (Fin.snoc c a) hindependent' hlength' hdimension'

theorem homogeneousIdeal_exists_independent_linear_zeroDimensional_slices
    {t n : ℕ} (I : Ideal (MvPolynomial (Fin t) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ))
    (hlength : n ≤ t)
    (hdimension : ringKrullDim (MvPolynomial (Fin t) ℂ ⧸ I) ≤
      (↑n : WithBot ℕ∞)) :
    ∃ c : Fin n → Fin t → ℂ,
      LinearIndependent ℂ c ∧
        ringKrullDim
          (MvPolynomial (Fin t) ℂ ⧸ homogeneousLinearSliceIdeal I c) ≤
          (0 : WithBot ℕ∞) := by
  have hempty : homogeneousLinearSliceIdeal I
      (Fin.elim0 : Fin 0 → Fin t → ℂ) = I := by
    simp only [homogeneousLinearSliceIdeal, Matrix.range_empty, Submodule.span_empty, bot_le, sup_of_le_left]
  have hbound : ringKrullDim
      (MvPolynomial (Fin t) ℂ ⧸
        homogeneousLinearSliceIdeal I
          (Fin.elim0 : Fin 0 → Fin t → ℂ)) ≤
        (↑n : WithBot ℕ∞) := by
    rwa [hempty]
  have hresult :=
    homogeneousLinearSliceIdeal_exists_independent_zeroDimensional_extension
      I hI (Fin.elim0 : Fin 0 → Fin t → ℂ)
      linearIndependent_empty_type n (by simpa only [zero_add] using hlength) hbound
  rw [zero_add] at hresult
  exact hresult

theorem homogeneousIdeal_le_idealOfVars_of_ne_top
    {t : ℕ} (I : Ideal (MvPolynomial (Fin t) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ))
    (hproper : I ≠ ⊤) :
    I ≤ MvPolynomial.idealOfVars (Fin t) ℂ := by
  obtain ⟨⟨P, hP⟩⟩ := Ideal.nonempty_minimalPrimes hproper
  exact hP.le.trans
    (homogeneousPrime_le_idealOfVars P hP.isPrime
      (homogeneousIdeal_minimalPrime_isHomogeneous I P hI hP))

theorem homogeneousLinearSliceIdeal_le_idealOfVars
    {t n : ℕ} (I : Ideal (MvPolynomial (Fin t) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ))
    (hproper : I ≠ ⊤) (c : Fin n → Fin t → ℂ) :
    homogeneousLinearSliceIdeal I c ≤
      MvPolynomial.idealOfVars (Fin t) ℂ := by
  unfold homogeneousLinearSliceIdeal
  apply sup_le
  · exact homogeneousIdeal_le_idealOfVars_of_ne_top I hI hproper
  · rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    change (∑ i, c j i • MvPolynomial.X i) ∈
      (MvPolynomial.idealOfVars (Fin t) ℂ).restrictScalars ℂ
    apply Submodule.sum_mem
    intro i _
    apply Submodule.smul_mem
    exact Ideal.subset_span ⟨i, rfl⟩

theorem homogeneousIdeal_zeroLocus_eq_singleton_of_ringKrullDim_le_zero
    {t : ℕ} (I : Ideal (MvPolynomial (Fin t) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ))
    (hproper : I ≠ ⊤)
    (hdimension : ringKrullDim (MvPolynomial (Fin t) ℂ ⧸ I) ≤
      (0 : WithBot ℕ∞)) :
    MvPolynomial.zeroLocus ℂ I =
      ({0} : Set (Fin t → ℂ)) := by
  have hradical :=
    homogeneousIdeal_radical_eq_idealOfVars_of_ringKrullDim_le_zero
      I hI hproper hdimension
  calc
    MvPolynomial.zeroLocus ℂ I =
        MvPolynomial.zeroLocus ℂ I.radical := by
      apply le_antisymm
      · intro u hu f hf
        exact
          MvPolynomial.radical_le_vanishingIdeal_zeroLocus
            (K := ℂ) I hf u hu
      · exact MvPolynomial.zeroLocus_anti_mono I.le_radical
    _ = MvPolynomial.zeroLocus ℂ
          (MvPolynomial.idealOfVars (Fin t) ℂ) := by rw [hradical]
    _ = ({0} : Set (Fin t → ℂ)) := zeroLocus_idealOfVars

theorem homogeneousIdeal_exists_independent_linear_origin_slices
    {t n : ℕ} (I : Ideal (MvPolynomial (Fin t) ℂ))
    (hI : I.IsHomogeneous
      (MvPolynomial.homogeneousSubmodule (Fin t) ℂ))
    (hproper : I ≠ ⊤) (hlength : n ≤ t)
    (hdimension : ringKrullDim (MvPolynomial (Fin t) ℂ ⧸ I) ≤
      (↑n : WithBot ℕ∞)) :
    ∃ c : Fin n → Fin t → ℂ,
      LinearIndependent ℂ c ∧
        MvPolynomial.zeroLocus ℂ (homogeneousLinearSliceIdeal I c) =
          ({0} : Set (Fin t → ℂ)) := by
  obtain ⟨c, hc, hzero⟩ :=
    homogeneousIdeal_exists_independent_linear_zeroDimensional_slices
      I hI hlength hdimension
  refine ⟨c, hc, ?_⟩
  apply homogeneousIdeal_zeroLocus_eq_singleton_of_ringKrullDim_le_zero
  · exact homogeneousLinearSliceIdeal_isHomogeneous I hI c
  · intro htop
    have hvertex := homogeneousLinearSliceIdeal_le_idealOfVars
      I hI hproper c
    rw [htop] at hvertex
    exact (leadingFormProjective_idealOfVars_isPrime t).ne_top
      (top_unique hvertex)
  · exact hzero

end AlgebraicProjectiveLeadingForms

end Standalone_ProjectiveDimension

noncomputable section Standalone_ProjectiveSlicing

open scoped BigOperators LinearAlgebra.Projectivization

noncomputable abbrev criticalCoordinateRing {m : ℕ}
    (P : MvPolynomial (Fin m) ℂ) : Type :=
  MvPolynomial (Fin m) ℂ ⧸
    homogeneousMapIdeal (fun i : Fin m => MvPolynomial.pderiv i P)

noncomputable def criticalLocusDimension {m : ℕ}
    (P : MvPolynomial (Fin m) ℂ) : WithBot ℕ∞ :=
  ringKrullDim (criticalCoordinateRing P)

theorem zeroLocus_gradientIdeal_eq_criticalLocus {m : ℕ}
    (P : MvPolynomial (Fin m) ℂ) :
    MvPolynomial.zeroLocus ℂ
        (homogeneousMapIdeal (fun i : Fin m => MvPolynomial.pderiv i P)) =
      criticalLocus P := by
  simpa only [homogeneousMapIdeal] using (criticalLocus_eq_zeroLocus_pderiv_span P).symm

noncomputable def gradientVector {m : ℕ}
    (P : MvPolynomial (Fin m) ℂ) (v : Fin m → ℂ) : Fin m → ℂ :=
  fun i => MvPolynomial.eval v (MvPolynomial.pderiv i P)

theorem gradientVector_eq_zero_iff {m : ℕ}
    (P : MvPolynomial (Fin m) ℂ) (v : Fin m → ℂ) :
    gradientVector P v = 0 ↔ v ∈ criticalLocus P := by
  simp only [funext_iff, gradientVector, Pi.zero_apply, criticalLocus, Set.mem_setOf_eq]

def projectiveCriticalLocus {m : ℕ}
    (P : MvPolynomial (Fin m) ℂ) : Set (ℙ ℂ (Fin m → ℂ)) :=
  {point | ∃ (v : Fin m → ℂ) (hv : v ≠ 0),
    Projectivization.mk ℂ v hv = point ∧ v ∈ criticalLocus P}

theorem mk_mem_projectiveCriticalLocus {m : ℕ}
    (P : MvPolynomial (Fin m) ℂ) (v : Fin m → ℂ)
    (hv : v ≠ 0) (hcritical : v ∈ criticalLocus P) :
    Projectivization.mk ℂ v hv ∈ projectiveCriticalLocus P :=
  ⟨v, hv, rfl, hcritical⟩

noncomputable def linearCoordinatePolynomial {k m : ℕ}
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (row : Fin m) : MvPolynomial (Fin k) ℂ :=
  ∑ j : Fin k,
    MvPolynomial.C ((W (Pi.single j 1)) row) * MvPolynomial.X j

theorem linearCoordinatePolynomial_isHomogeneous {k m : ℕ}
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ)) (row : Fin m) :
    (linearCoordinatePolynomial W row).IsHomogeneous 1 := by
  unfold linearCoordinatePolynomial
  exact MvPolynomial.IsHomogeneous.sum Finset.univ _ 1
    (fun j _ => MvPolynomial.isHomogeneous_C_mul_X _ j)

theorem linearCoordinatePolynomial_eval {k m : ℕ}
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (row : Fin m) (u : Fin k → ℂ) :
    MvPolynomial.eval u (linearCoordinatePolynomial W row) = W u row := by
  classical
  calc
    MvPolynomial.eval u (linearCoordinatePolynomial W row) =
        ∑ j : Fin k, (W (Pi.single j 1)) row * u j := by
      simp only [linearCoordinatePolynomial, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]
    _ = W u row := by
      conv_rhs => rw [pi_eq_sum_univ' u]
      simp only [mul_comm, map_sum, map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]

theorem eval_aeval_linearCoordinatePolynomial {k m : ℕ}
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (u : Fin k → ℂ) (f : MvPolynomial (Fin m) ℂ) :
    MvPolynomial.eval u
        (MvPolynomial.aeval (fun row => linearCoordinatePolynomial W row) f) =
      MvPolynomial.eval (W u) f := by
  change
    (MvPolynomial.aeval u)
        (MvPolynomial.aeval (fun row => linearCoordinatePolynomial W row) f) =
      (MvPolynomial.aeval (W u)) f
  have hcoordinates :
      (fun row =>
        (MvPolynomial.aeval u) (linearCoordinatePolynomial W row)) =
        W u := by
    funext row
    exact linearCoordinatePolynomial_eval W row u
  rw [MvPolynomial.comp_aeval_apply, hcoordinates]

noncomputable def slicedGradientPolynomial {m k : ℕ}
    (P : MvPolynomial (Fin m) ℂ)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ))
    (i : Fin k) : MvPolynomial (Fin k) ℂ :=
  ∑ j : Fin m,
    MvPolynomial.C ((A (Pi.single j 1)) i) *
      MvPolynomial.aeval
        (fun row => linearCoordinatePolynomial W row)
        (MvPolynomial.pderiv j P)

theorem slicedGradientPolynomial_eval {m k : ℕ}
    (P : MvPolynomial (Fin m) ℂ)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ))
    (i : Fin k) (u : Fin k → ℂ) :
    MvPolynomial.eval u (slicedGradientPolynomial P W A i) =
      A (gradientVector P (W u)) i := by
  classical
  calc
    MvPolynomial.eval u (slicedGradientPolynomial P W A i) =
        ∑ j : Fin m,
          (A (Pi.single j 1)) i *
            MvPolynomial.eval (W u) (MvPolynomial.pderiv j P) := by
      simp only [slicedGradientPolynomial, map_sum,
        MvPolynomial.eval_mul, MvPolynomial.eval_C]
      apply Finset.sum_congr rfl
      intro j _
      rw [eval_aeval_linearCoordinatePolynomial]
    _ = A (gradientVector P (W u)) i := by
      conv_rhs => rw [pi_eq_sum_univ' (gradientVector P (W u))]
      simp only [gradientVector, map_sum, map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, mul_comm]

theorem slicedGradientPolynomial_isHomogeneous {m k d : ℕ}
    (P : MvPolynomial (Fin m) ℂ)
    (hP : P.IsHomogeneous d)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ))
    (i : Fin k) :
    (slicedGradientPolynomial P W A i).IsHomogeneous (d - 1) := by
  unfold slicedGradientPolynomial
  refine MvPolynomial.IsHomogeneous.sum Finset.univ _ (d - 1) ?_
  intro j _
  simpa only [one_mul] using
    ((hP.pderiv (i := j)).aeval
      (fun row => linearCoordinatePolynomial W row)
      (fun row => linearCoordinatePolynomial_isHomogeneous W row)).C_mul
        ((A (Pi.single j 1)) i)

theorem homogeneous_fin_one_eq_C_mul_X_pow
    {f : MvPolynomial (Fin 1) ℂ} {e : ℕ}
    (hf : f.IsHomogeneous e) :
    f =
      MvPolynomial.C
          (MvPolynomial.coeff (Finsupp.single (0 : Fin 1) e) f) *
        MvPolynomial.X 0 ^ e := by
  rw [MvPolynomial.C_mul_X_pow_eq_monomial]
  apply MvPolynomial.IsWeightedHomogeneous.eq_monomial_of_unique_weight hf
  intro a ha
  apply Finsupp.ext
  intro i
  have hi : i = (0 : Fin 1) := Subsingleton.elim _ _
  subst i
  have hdegree : a.degree = e := by
    rw [Finsupp.degree_eq_weight_one]
    exact ha
  simpa only [Fin.isValue, Finsupp.single_eq_same, Finsupp.degree_eq_sum, Finset.univ_unique,
    Fin.default_eq_zero, Finset.sum_singleton] using hdegree

theorem homogeneous_fin_one_eval
    {f : MvPolynomial (Fin 1) ℂ} {e : ℕ}
    (hf : f.IsHomogeneous e) (u : Fin 1 → ℂ) :
    MvPolynomial.eval u f =
      u 0 ^ e * MvPolynomial.eval (fun _ : Fin 1 => 1) f := by
  rw [homogeneous_fin_one_eq_C_mul_X_pow hf]
  simp only [Fin.isValue, mul_comm, map_mul, map_pow, MvPolynomial.eval_X, MvPolynomial.eval_C, one_pow,
    one_mul]

noncomputable def oneDimensionalInputSlice {m : ℕ}
    (v : Fin m → ℂ) : (Fin 1 → ℂ) →ₗ[ℂ] (Fin m → ℂ) :=
  LinearMap.smulRight
    (LinearMap.proj (0 : Fin 1) : (Fin 1 → ℂ) →ₗ[ℂ] ℂ) v

theorem slicedGradientPolynomial_eval_zero {m k d : ℕ}
    (P : MvPolynomial (Fin m) ℂ)
    (hd : 2 ≤ d) (hP : P.IsHomogeneous d)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ))
    (i : Fin k) :
    MvPolynomial.eval (0 : Fin k → ℂ)
        (slicedGradientPolynomial P W A i) = 0 := by
  exact homogeneous_eval_zero_of_pos (by omega)
    (slicedGradientPolynomial_isHomogeneous P hP W A i)

theorem slicedGradient_zero_iff_mem_kernel {m k : ℕ}
    (P : MvPolynomial (Fin m) ℂ)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ))
    (u : Fin k → ℂ) :
    (∀ i, MvPolynomial.eval u (slicedGradientPolynomial P W A i) = 0) ↔
      gradientVector P (W u) ∈ LinearMap.ker A := by
  rw [LinearMap.mem_ker]
  simp only [slicedGradientPolynomial_eval, funext_iff, Pi.zero_apply]

theorem slicedGradient_zero_fiber_of_kernel_avoidance {m k d : ℕ}
    (P : MvPolynomial (Fin m) ℂ)
    (hd : 2 ≤ d) (hP : P.IsHomogeneous d)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ))
    (havoid : ∀ u : Fin k → ℂ, u ≠ 0 →
      gradientVector P (W u) ∉ LinearMap.ker A) :
    ∀ u : Fin k → ℂ,
      (∀ i, MvPolynomial.eval u (slicedGradientPolynomial P W A i) = 0) ↔
        u = 0 := by
  intro u
  constructor
  · intro hzero
    by_contra hne
    exact havoid u hne
      ((slicedGradient_zero_iff_mem_kernel P W A u).mp hzero)
  · rintro rfl i
    exact slicedGradientPolynomial_eval_zero P hd hP W A i

def projectiveSlicedGradientImage {m k : ℕ}
    (P : MvPolynomial (Fin m) ℂ)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ)) :
    Set (ℙ ℂ (Fin m → ℂ)) :=
  {point | ∃ (u : Fin k → ℂ) (_hu : u ≠ 0)
      (hgradient : gradientVector P (W u) ≠ 0),
    Projectivization.mk ℂ (gradientVector P (W u)) hgradient = point}

theorem gradientVector_after_embedding_ne_zero_of_projective_disjoint
    {m k : ℕ} (P : MvPolynomial (Fin m) ℂ)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (hW : Function.Injective W)
    (hdisjoint : Disjoint
      ((LinearMap.range W).projectivization : Set (ℙ ℂ (Fin m → ℂ)))
      (projectiveCriticalLocus P))
    (u : Fin k → ℂ) (hu : u ≠ 0) :
    gradientVector P (W u) ≠ 0 := by
  intro hgradient
  have hWu : W u ≠ 0 := by
    intro hzero
    exact hu (hW (by simpa only [map_zero] using hzero))
  have hpoint_range :
      Projectivization.mk ℂ (W u) hWu ∈
        (LinearMap.range W).projectivization :=
    (Submodule.mk_mem_projectivization_iff _ hWu).mpr ⟨u, rfl⟩
  have hpoint_critical :
      Projectivization.mk ℂ (W u) hWu ∈ projectiveCriticalLocus P :=
    mk_mem_projectiveCriticalLocus P (W u) hWu
      ((gradientVector_eq_zero_iff P (W u)).mp hgradient)
  exact Set.disjoint_left.mp hdisjoint hpoint_range hpoint_critical

theorem projective_input_disjoint_iff {m k : ℕ}
    (P : MvPolynomial (Fin m) ℂ)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (hW : Function.Injective W) :
    Disjoint
      ((LinearMap.range W).projectivization : Set (ℙ ℂ (Fin m → ℂ)))
      (projectiveCriticalLocus P) ↔
      ∀ (u : Fin k → ℂ), u ≠ 0 → gradientVector P (W u) ≠ 0 := by
  constructor
  · exact gradientVector_after_embedding_ne_zero_of_projective_disjoint
      P W hW
  · intro hnonzero
    apply Set.disjoint_left.mpr
    intro point hpoint_range hpoint_critical
    obtain ⟨v, hv, hpoint, hcritical⟩ := hpoint_critical
    rw [← hpoint] at hpoint_range
    have hv_range : v ∈ LinearMap.range W :=
      (Submodule.mk_mem_projectivization_iff _ hv).mp hpoint_range
    obtain ⟨u, hu⟩ := hv_range
    have hu_ne : u ≠ 0 := by
      intro hu_zero
      apply hv
      rw [← hu, hu_zero]
      exact W.map_zero
    apply hnonzero u hu_ne
    rw [hu]
    exact (gradientVector_eq_zero_iff P v).mpr hcritical

theorem slicedGradient_kernel_avoidance_of_projective_disjoint
    {m k : ℕ} (P : MvPolynomial (Fin m) ℂ)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ))
    (hnonzero : ∀ (u : Fin k → ℂ), u ≠ 0 →
      gradientVector P (W u) ≠ 0)
    (hdisjoint : Disjoint
      (projectiveSlicedGradientImage P W)
      ((LinearMap.ker A).projectivization : Set (ℙ ℂ (Fin m → ℂ)))) :
    ∀ (u : Fin k → ℂ), u ≠ 0 →
      gradientVector P (W u) ∉ LinearMap.ker A := by
  intro u hu hkernel
  have hgradient := hnonzero u hu
  have himage :
      Projectivization.mk ℂ (gradientVector P (W u)) hgradient ∈
        projectiveSlicedGradientImage P W :=
    ⟨u, hu, hgradient, rfl⟩
  have hprojective_kernel :
      Projectivization.mk ℂ (gradientVector P (W u)) hgradient ∈
        (LinearMap.ker A).projectivization :=
    (Submodule.mk_mem_projectivization_iff _ hgradient).mpr hkernel
  exact Set.disjoint_left.mp hdisjoint himage hprojective_kernel

theorem projective_output_disjoint_iff {m k : ℕ}
    (P : MvPolynomial (Fin m) ℂ)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ))
    (hnonzero : ∀ (u : Fin k → ℂ), u ≠ 0 →
      gradientVector P (W u) ≠ 0) :
    Disjoint (projectiveSlicedGradientImage P W)
      ((LinearMap.ker A).projectivization : Set (ℙ ℂ (Fin m → ℂ))) ↔
      ∀ (u : Fin k → ℂ), u ≠ 0 →
        gradientVector P (W u) ∉ LinearMap.ker A := by
  constructor
  · exact slicedGradient_kernel_avoidance_of_projective_disjoint
      P W A hnonzero
  · intro havoid
    apply Set.disjoint_left.mpr
    intro point hpoint_image hpoint_kernel
    obtain ⟨u, hu, hgradient, hpoint⟩ := hpoint_image
    rw [← hpoint] at hpoint_kernel
    exact havoid u hu
      ((Submodule.mk_mem_projectivization_iff _ hgradient).mp hpoint_kernel)

theorem slicedGradient_of_projective_disjoint {m k d : ℕ}
    (P : MvPolynomial (Fin m) ℂ)
    (hd : 2 ≤ d) (hP : P.IsHomogeneous d)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ))
    (hW : Function.Injective W)
    (hinput : Disjoint
      ((LinearMap.range W).projectivization : Set (ℙ ℂ (Fin m → ℂ)))
      (projectiveCriticalLocus P))
    (houtput : Disjoint
      (projectiveSlicedGradientImage P W)
      ((LinearMap.ker A).projectivization : Set (ℙ ℂ (Fin m → ℂ)))) :
    (∀ i : Fin k,
      (slicedGradientPolynomial P W A i).IsHomogeneous (d - 1)) ∧
    (∀ u : Fin k → ℂ,
      (∀ i : Fin k,
        MvPolynomial.eval u (slicedGradientPolynomial P W A i) = 0) ↔
          u = 0) := by
  refine ⟨fun i => slicedGradientPolynomial_isHomogeneous P hP W A i, ?_⟩
  apply slicedGradient_zero_fiber_of_kernel_avoidance P hd hP W A
  exact slicedGradient_kernel_avoidance_of_projective_disjoint P W A
    (gradientVector_after_embedding_ne_zero_of_projective_disjoint
      P W hW hinput)
    houtput

theorem homogeneous_eval_smul {m e : ℕ}
    (f : MvPolynomial (Fin m) ℂ) (hf : f.IsHomogeneous e)
    (a : ℂ) (v : Fin m → ℂ) :
    MvPolynomial.eval (a • v) f = a ^ e * MvPolynomial.eval v f := by
  let W := oneDimensionalInputSlice v
  have hg :
      (MvPolynomial.aeval
        (fun row => linearCoordinatePolynomial W row) f).IsHomogeneous e := by
    simpa only [one_mul] using
      hf.aeval (fun row => linearCoordinatePolynomial W row)
        (fun row => linearCoordinatePolynomial_isHomogeneous W row)
  have hline := homogeneous_fin_one_eval hg (fun _ : Fin 1 => a)
  change
    MvPolynomial.eval (fun _ : Fin 1 => a)
        (MvPolynomial.aeval
          (fun row => linearCoordinatePolynomial W row) f) =
      a ^ e *
        MvPolynomial.eval (fun _ : Fin 1 => 1)
          (MvPolynomial.aeval
            (fun row => linearCoordinatePolynomial W row) f) at hline
  rw [eval_aeval_linearCoordinatePolynomial,
    eval_aeval_linearCoordinatePolynomial] at hline
  simpa [W, oneDimensionalInputSlice] using hline

theorem gradientVector_smul_of_isHomogeneous {m d : ℕ}
    (P : MvPolynomial (Fin m) ℂ) (hP : P.IsHomogeneous d)
    (a : ℂ) (v : Fin m → ℂ) :
    gradientVector P (a • v) = a ^ (d - 1) • gradientVector P v := by
  funext i
  simpa only [gradientVector, Pi.smul_apply, smul_eq_mul] using
    homogeneous_eval_smul (MvPolynomial.pderiv i P) (hP.pderiv (i := i)) a v

theorem gradientVector_comp_linearMap_contDiff {m k : ℕ}
    (P : MvPolynomial (Fin m) ℂ)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ)) :
    ContDiff ℝ 1 (fun u : Fin k → ℂ => gradientVector P (W u)) := by
  apply contDiff_pi.mpr
  intro i
  change ContDiff ℝ 1
    (fun u : Fin k → ℂ =>
      MvPolynomial.eval (W u) (MvPolynomial.pderiv i P))
  exact (AnalyticOnNhd.eval_linearMap W
    (MvPolynomial.pderiv i P)).contDiff.restrict_scalars ℝ

theorem exists_outputSlice_projective_disjoint {m k d : ℕ}
    (P : MvPolynomial (Fin m) ℂ) (hP : P.IsHomogeneous d)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (hnonzero : ∀ (u : Fin k → ℂ), u ≠ 0 →
      gradientVector P (W u) ≠ 0) :
    ∃ A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ),
      Disjoint (projectiveSlicedGradientImage P W)
        ((LinearMap.ker A).projectivization : Set (ℙ ℂ (Fin m → ℂ))) := by
  obtain ⟨B, hB⟩ :=
    permanent_rollout_exists_output_matrix_of_smooth_homogeneous
      (e := d - 1)
      (fun u : Fin k → ℂ => gradientVector P (W u))
      (gradientVector_comp_linearMap_contDiff P W)
      hnonzero
      (fun a u => by
        rw [W.map_smul, gradientVector_smul_of_isHomogeneous P hP])
  refine ⟨B.mulVecLin,
    (projective_output_disjoint_iff P W B.mulVecLin hnonzero).mpr ?_⟩
  intro u hu hkernel
  apply hB u hu
  exact (LinearMap.mem_ker.mp hkernel)

theorem exists_slicedGradient_of_projective_input_disjoint {m k d : ℕ}
    (P : MvPolynomial (Fin m) ℂ)
    (hd : 2 ≤ d) (hP : P.IsHomogeneous d)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (hW : Function.Injective W)
    (hinput : Disjoint
      ((LinearMap.range W).projectivization : Set (ℙ ℂ (Fin m → ℂ)))
      (projectiveCriticalLocus P)) :
    ∃ A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ),
      (∀ i : Fin k,
        (slicedGradientPolynomial P W A i).IsHomogeneous (d - 1)) ∧
      (∀ u : Fin k → ℂ,
        (∀ i : Fin k,
          MvPolynomial.eval u (slicedGradientPolynomial P W A i) = 0) ↔
            u = 0) := by
  have hnonzero :=
    gradientVector_after_embedding_ne_zero_of_projective_disjoint
      P W hW hinput
  obtain ⟨A, houtput⟩ :=
    exists_outputSlice_projective_disjoint P hP W hnonzero
  exact ⟨A,
    slicedGradient_of_projective_disjoint P hd hP W A hW hinput houtput⟩

attribute [local instance] MvPolynomial.gradedAlgebra

theorem criticalGradientIdeal_isHomogeneous {m d : ℕ}
    (P : MvPolynomial (Fin m) ℂ) (hP : P.IsHomogeneous d) :
    (homogeneousMapIdeal
      (fun i : Fin m => MvPolynomial.pderiv i P)).IsHomogeneous
        (MvPolynomial.homogeneousSubmodule (Fin m) ℂ) := by
  change
    (Ideal.span
      (Set.range fun i : Fin m => MvPolynomial.pderiv i P)).IsHomogeneous
        (MvPolynomial.homogeneousSubmodule (Fin m) ℂ)
  apply Ideal.homogeneous_span
  rintro _ ⟨i, rfl⟩
  exact ⟨d - 1, hP.pderiv (i := i)⟩

theorem criticalGradientIdeal_ne_top {m d : ℕ}
    (P : MvPolynomial (Fin m) ℂ)
    (hd : 2 ≤ d) (hP : P.IsHomogeneous d) :
    homogeneousMapIdeal
      (fun i : Fin m => MvPolynomial.pderiv i P) ≠ ⊤ := by
  intro htop
  have horigin : (0 : Fin m → ℂ) ∈ criticalLocus P := by
    rw [mem_criticalLocus_iff]
    intro i
    exact homogeneous_eval_zero_of_pos (by omega) (hP.pderiv (i := i))
  have hzero : (0 : Fin m → ℂ) ∈
      MvPolynomial.zeroLocus ℂ
        (homogeneousMapIdeal
          (fun i : Fin m => MvPolynomial.pderiv i P)) := by
    rw [zeroLocus_gradientIdeal_eq_criticalLocus]
    exact horigin
  rw [htop, MvPolynomial.zeroLocus_top] at hzero
  exact hzero

theorem exists_injective_inputMap_into_linearCoordinateKernel
    {m k n : ℕ} (c : Fin n → Fin m → ℂ)
    (hk : k + n ≤ m) :
    ∃ W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ),
      Function.Injective W ∧
        ∀ u : Fin k → ℂ, (Matrix.mulVecLin
          (c : Matrix (Fin n) (Fin m) ℂ) :
          (Fin m → ℂ) →ₗ[ℂ] (Fin n → ℂ)) (W u) = 0 := by
  let L : (Fin m → ℂ) →ₗ[ℂ] (Fin n → ℂ) :=
    Matrix.mulVecLin (c : Matrix (Fin n) (Fin m) ℂ)
  have hrange : Module.finrank ℂ (LinearMap.range L) ≤ n := by
    simpa only [Module.finrank_fintype_fun_eq_card, Fintype.card_fin] using (LinearMap.range L).finrank_le
  have hnullity :
      Module.finrank ℂ (LinearMap.range L) +
        Module.finrank ℂ (LinearMap.ker L) = m := by
    simpa only [Module.finrank_fintype_fun_eq_card, Fintype.card_fin] using L.finrank_range_add_finrank_ker
  have hkernel : k ≤ Module.finrank ℂ (LinearMap.ker L) := by
    omega
  have hsource :
      Module.finrank ℂ (Fin k → ℂ) ≤
        Module.finrank ℂ (LinearMap.ker L) := by
    simpa only [Module.finrank_fintype_fun_eq_card, Fintype.card_fin] using hkernel
  obtain ⟨f, hf⟩ := finrank_le_iff_exists_linearMap.mp hsource
  refine ⟨(LinearMap.ker L).subtype.comp f,
    Subtype.val_injective.comp hf, ?_⟩
  intro u
  exact (f u).property

theorem eq_zero_of_mem_zeroLocus_of_linearCoordinateKernel_of_radical
    {m n : ℕ} (I : Ideal (MvPolynomial (Fin m) ℂ))
    (c : Fin n → Fin m → ℂ)
    (hradical :
      (I ⊔ Ideal.span (Set.range fun j =>
        permanentRolloutLinearCoordinateCombination m (c j))).radical =
        MvPolynomial.idealOfVars (Fin m) ℂ)
    {v : Fin m → ℂ}
    (hv : v ∈ MvPolynomial.zeroLocus ℂ I)
    (hkernel : Matrix.mulVecLin (c : Matrix (Fin n) (Fin m) ℂ) v = 0) :
    v = 0 := by
  let J : Ideal (MvPolynomial (Fin m) ℂ) :=
    I ⊔ Ideal.span (Set.range fun j =>
      permanentRolloutLinearCoordinateCombination m (c j))
  have hvanishing : J ≤ MvPolynomial.vanishingIdeal ℂ {v} := by
    apply sup_le
    · intro f hf
      rw [MvPolynomial.mem_vanishingIdeal_singleton_iff]
      exact hv f hf
    · rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      change permanentRolloutLinearCoordinateCombination m (c j) ∈
        MvPolynomial.vanishingIdeal ℂ {v}
      rw [MvPolynomial.mem_vanishingIdeal_singleton_iff]
      have hj := congrFun hkernel j
      change (∑ i, c j i * v i) = 0 at hj
      simpa only [permanentRolloutLinearCoordinateCombination, LinearMap.coe_mk, AddHom.coe_mk, map_sum, map_smul,
        MvPolynomial.aeval_def, Algebra.algebraMap_self, MvPolynomial.eval₂_X, smul_eq_mul] using hj
  have hvJ : v ∈ MvPolynomial.zeroLocus ℂ J := by
    intro f hf
    exact hvanishing hf v (Set.mem_singleton v)
  funext i
  have hXi : MvPolynomial.X i ∈ J.radical := by
    change MvPolynomial.X i ∈
      (I ⊔ Ideal.span (Set.range fun j =>
        permanentRolloutLinearCoordinateCombination m (c j))).radical
    rw [hradical, MvPolynomial.idealOfVars]
    exact Ideal.subset_span (Set.mem_range_self i)
  have hzero :=
    (MvPolynomial.radical_le_vanishingIdeal_zeroLocus (K := ℂ) J hXi)
      v hvJ
  simpa only [Pi.zero_apply, MvPolynomial.aeval_def, Algebra.algebraMap_self, MvPolynomial.eval₂_X] using hzero

theorem criticalLinearSliceIdeal_radical_eq_idealOfVars_of_dimension_le_zero
    {m n d : ℕ} (P : MvPolynomial (Fin m) ℂ)
    (hd : 2 ≤ d) (hP : P.IsHomogeneous d)
    (c : Fin n → Fin m → ℂ)
    (hdimension :
      ringKrullDim
        (MvPolynomial (Fin m) ℂ ⧸
          permanentRolloutHomogeneousLinearSliceIdeal
            (homogeneousMapIdeal
              (fun i : Fin m => MvPolynomial.pderiv i P)) c) ≤
        (0 : WithBot ℕ∞)) :
    (permanentRolloutHomogeneousLinearSliceIdeal
      (homogeneousMapIdeal
        (fun i : Fin m => MvPolynomial.pderiv i P)) c).radical =
      MvPolynomial.idealOfVars (Fin m) ℂ := by
  let I : Ideal (MvPolynomial (Fin m) ℂ) :=
    homogeneousMapIdeal (fun i : Fin m => MvPolynomial.pderiv i P)
  let J : Ideal (MvPolynomial (Fin m) ℂ) :=
    permanentRolloutHomogeneousLinearSliceIdeal I c
  have hIproper : I ≠ ⊤ := criticalGradientIdeal_ne_top P hd hP
  obtain ⟨⟨Q, hQ⟩⟩ := Ideal.nonempty_minimalPrimes hIproper
  have hIvertex : I ≤ MvPolynomial.idealOfVars (Fin m) ℂ :=
    hQ.le.trans
      (permanent_rollout_homogeneousPrime_le_idealOfVars Q hQ.isPrime
        (permanent_rollout_minimalPrime_isHomogeneous
          (criticalGradientIdeal_isHomogeneous P hP) hQ))
  have hJvertex : J ≤ MvPolynomial.idealOfVars (Fin m) ℂ := by
    apply sup_le hIvertex
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    change (∑ i, c j i • MvPolynomial.X i) ∈
      MvPolynomial.idealOfVars (Fin m) ℂ
    apply Ideal.sum_mem
    intro i _
    rw [Algebra.smul_def]
    exact (MvPolynomial.idealOfVars (Fin m) ℂ).mul_mem_left _
      (Ideal.subset_span (Set.mem_range_self i))
  have hvertexproper : MvPolynomial.idealOfVars (Fin m) ℂ ≠ ⊤ :=
    (permanent_rollout_idealOfVars_isMaximal m).ne_top
  have hJproper : J ≠ ⊤ := by
    intro htop
    apply hvertexproper
    apply top_unique
    rw [← htop]
    exact hJvertex
  have hJhomogeneous :
      J.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin m) ℂ) :=
    permanent_rollout_homogeneous_linear_slice_ideal_isHomogeneous
      I (criticalGradientIdeal_isHomogeneous P hP) c
  have hzero : Ring.KrullDimLE 0 (MvPolynomial (Fin m) ℂ ⧸ J) :=
    Ring.krullDimLE_iff.mpr hdimension
  have hallmaximal : ∀ p ∈ J.minimalPrimes, p.IsMaximal :=
    Ideal.krullDimLE_zero_quotient_iff_forall_minimalPrimes_isMaximal.mp
      hzero
  change J.radical = MvPolynomial.idealOfVars (Fin m) ℂ
  rw [← J.sInf_minimalPrimes]
  apply le_antisymm
  · obtain ⟨⟨p, hp⟩⟩ := Ideal.nonempty_minimalPrimes hJproper
    have hpvertex : p ≤ MvPolynomial.idealOfVars (Fin m) ℂ :=
      permanent_rollout_homogeneousPrime_le_idealOfVars p hp.isPrime
        (permanent_rollout_minimalPrime_isHomogeneous hJhomogeneous hp)
    have hpeq : p = MvPolynomial.idealOfVars (Fin m) ℂ :=
      (hallmaximal p hp).eq_of_le hvertexproper hpvertex
    rw [← hpeq]
    exact sInf_le hp
  · apply le_sInf
    intro p hp
    have hpvertex : p ≤ MvPolynomial.idealOfVars (Fin m) ℂ :=
      permanent_rollout_homogeneousPrime_le_idealOfVars p hp.isPrime
        (permanent_rollout_minimalPrime_isHomogeneous hJhomogeneous hp)
    have hpeq : p = MvPolynomial.idealOfVars (Fin m) ℂ :=
      (hallmaximal p hp).eq_of_le hvertexproper hpvertex
    exact hpeq.symm.le

theorem exists_inputSlice_projective_disjoint_of_criticalLocusDimension
    {m k d : ℕ} (P : MvPolynomial (Fin m) ℂ)
    (hd : 2 ≤ d) (hP : P.IsHomogeneous d)
    (hk : k ≤ m)
    (hcodimension : criticalLocusDimension P ≤
      ((m - k : ℕ) : WithBot ℕ∞)) :
    ∃ W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ),
      Function.Injective W ∧
      Disjoint
        ((LinearMap.range W).projectivization : Set (ℙ ℂ (Fin m → ℂ)))
        (projectiveCriticalLocus P) := by
  let I : Ideal (MvPolynomial (Fin m) ℂ) :=
    homogeneousMapIdeal (fun i : Fin m => MvPolynomial.pderiv i P)
  have hIhomogeneous :
      I.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin m) ℂ) :=
    criticalGradientIdeal_isHomogeneous P hP
  have hIdimension :
      ringKrullDim (MvPolynomial (Fin m) ℂ ⧸ I) ≤
        ((m - k : ℕ) : WithBot ℕ∞) := hcodimension
  obtain ⟨q, c, hq, _, hzero_dimension⟩ :=
    permanent_rollout_exists_independent_linear_ideal_dimension_zero
      I hIhomogeneous (m - k) hIdimension
  have hkq : k + q ≤ m := by omega
  obtain ⟨W, hW, hkernel⟩ :=
    exists_injective_inputMap_into_linearCoordinateKernel c hkq
  have hradical :=
    criticalLinearSliceIdeal_radical_eq_idealOfVars_of_dimension_le_zero
      P hd hP c hzero_dimension
  refine ⟨W, hW, (projective_input_disjoint_iff P W hW).mpr ?_⟩
  intro u hu hgradient
  have hcritical : W u ∈ criticalLocus P :=
    (gradientVector_eq_zero_iff P (W u)).mp hgradient
  have hvanishing : W u ∈ MvPolynomial.zeroLocus ℂ I := by
    change W u ∈ MvPolynomial.zeroLocus ℂ
      (homogeneousMapIdeal
        (fun i : Fin m => MvPolynomial.pderiv i P))
    rw [zeroLocus_gradientIdeal_eq_criticalLocus]
    exact hcritical
  have hradical' :
      (I ⊔ Ideal.span (Set.range fun j =>
        permanentRolloutLinearCoordinateCombination m (c j))).radical =
        MvPolynomial.idealOfVars (Fin m) ℂ := hradical
  have hWu : W u = 0 :=
    eq_zero_of_mem_zeroLocus_of_linearCoordinateKernel_of_radical
      I c hradical' hvanishing (hkernel u)
  exact hu (hW (by simpa only [map_zero] using hWu))

theorem exists_inputSlice_projective_disjoint_of_criticalLocus_codimension
    {m k c d : ℕ} (P : MvPolynomial (Fin m) ℂ)
    (hd : 2 ≤ d) (hP : P.IsHomogeneous d)
    (hk : k ≤ c) (hm : k < m)
    (hcodimension : criticalLocusDimension P ≤
      ((m - c : ℕ) : WithBot ℕ∞)) :
    ∃ W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ),
      Function.Injective W ∧
      Disjoint
        ((LinearMap.range W).projectivization : Set (ℙ ℂ (Fin m → ℂ)))
        (projectiveCriticalLocus P) := by
  have hsubtraction : m - c ≤ m - k := by omega
  have hcast :
      ((m - c : ℕ) : WithBot ℕ∞) ≤
        ((m - k : ℕ) : WithBot ℕ∞) := by
    exact_mod_cast hsubtraction
  exact exists_inputSlice_projective_disjoint_of_criticalLocusDimension
    P hd hP hm.le (hcodimension.trans hcast)

theorem exists_slicedGradient_of_criticalLocus_codimension
    {m k c d : ℕ} (P : MvPolynomial (Fin m) ℂ)
    (hd : 2 ≤ d) (hP : P.IsHomogeneous d)
    (hk : k ≤ c) (hm : k < m)
    (hcodimension : criticalLocusDimension P ≤
      ((m - c : ℕ) : WithBot ℕ∞)) :
    ∃ (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
      (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ)),
      Function.Injective W ∧
      (∀ i : Fin k,
        (slicedGradientPolynomial P W A i).IsHomogeneous (d - 1)) ∧
      (∀ u : Fin k → ℂ,
        (∀ i : Fin k,
          MvPolynomial.eval u (slicedGradientPolynomial P W A i) = 0) ↔
            u = 0) := by
  obtain ⟨W, hW, hinput⟩ :=
    exists_inputSlice_projective_disjoint_of_criticalLocus_codimension
      P hd hP hk hm hcodimension
  obtain ⟨A, hdegree, hzero⟩ :=
    exists_slicedGradient_of_projective_input_disjoint
      P hd hP W hW hinput
  exact ⟨W, A, hW, hdegree, hzero⟩

