noncomputable def homogeneousMapFinSuccFirstPivotPlaneRoot
    {n : ℕ} (c : Fin (n + 1) → ℂ) :
    MvPolynomial (Fin n) ℂ :=
  -(MvPolynomial.C ((c 0)⁻¹) *
    ∑ i : Fin n, MvPolynomial.C (c i.succ) * MvPolynomial.X i)

theorem homogeneousMapFinSuccFirstPivotPlaneMap_coordinate_zero
    {n : ℕ} (c : Fin (n + 1) → ℂ) :
    linearCoordinatePolynomial
      (homogeneousMapFinSuccFirstPivotPlaneMap c) 0 =
      homogeneousMapFinSuccFirstPivotPlaneRoot c := by
  classical
  apply MvPolynomial.funext
  intro u
  rw [linearCoordinatePolynomial_eval]
  simp only [homogeneousMapFinSuccFirstPivotPlaneMap, neg_smul, LinearMap.pi_apply, Fin.cases_zero,
    LinearMap.neg_apply, LinearMap.smul_apply, LinearMap.coe_sum, LinearMap.coe_smul, LinearMap.coe_proj,
    Finset.sum_apply, Pi.smul_apply, Function.eval, smul_eq_mul, homogeneousMapFinSuccFirstPivotPlaneRoot, map_neg,
    map_mul, MvPolynomial.eval_C, map_sum, MvPolynomial.eval_X]

theorem homogeneousMapFinSuccFirstPivotPlaneMap_coordinate_succ
    {n : ℕ} (c : Fin (n + 1) → ℂ) (i : Fin n) :
    linearCoordinatePolynomial
      (homogeneousMapFinSuccFirstPivotPlaneMap c) i.succ =
      MvPolynomial.X i := by
  classical
  apply MvPolynomial.funext
  intro u
  rw [linearCoordinatePolynomial_eval]
  simp only [homogeneousMapFinSuccFirstPivotPlaneMap, neg_smul, LinearMap.pi_apply, Fin.cases_succ,
    LinearMap.coe_proj, Function.eval, MvPolynomial.eval_X]

theorem homogeneousMapFinSuccFirstPivotPlaneMap_substitution
    {n : ℕ} (c : Fin (n + 1) → ℂ)
    (p : MvPolynomial (Fin (n + 1)) ℂ) :
    (MvPolynomial.finSuccEquiv ℂ n p).eval
        (homogeneousMapFinSuccFirstPivotPlaneRoot c) =
      MvPolynomial.aeval
        (fun row => linearCoordinatePolynomial
          (homogeneousMapFinSuccFirstPivotPlaneMap c) row) p := by
  classical
  induction p using MvPolynomial.induction_on with
  | C z =>
      simpa only [MvPolynomial.aeval_eq_bind₁, MvPolynomial.algHom_C, MvPolynomial.algebraMap_eq,
        Polynomial.algebraMap_apply, Polynomial.eval_C] using
        congrArg (Polynomial.eval (homogeneousMapFinSuccFirstPivotPlaneRoot c)) ((MvPolynomial.finSuccEquiv ℂ n).commutes z)
  | add f g hf hg => simp only [map_add, Polynomial.eval_add, hf, MvPolynomial.aeval_eq_bind₁, hg]
  | mul_X f i hf =>
      simp only [map_mul, Polynomial.eval_mul, MvPolynomial.aeval_X]
      rw [hf]
      cases i using Fin.cases with
      | zero =>
          simp only [MvPolynomial.aeval_eq_bind₁, MvPolynomial.finSuccEquiv_X_zero, Polynomial.eval_X,
            homogeneousMapFinSuccFirstPivotPlaneMap_coordinate_zero]
      | succ i =>
          rw [MvPolynomial.finSuccEquiv_X_succ,
            Polynomial.eval_C,
            homogeneousMapFinSuccFirstPivotPlaneMap_coordinate_succ]

noncomputable def homogeneousMapFinSuccPivotPermutation
    {n : ℕ} (j : Fin (n + 1)) :
    (Fin (n + 1) → ℂ) →ₗ[ℂ] (Fin (n + 1) → ℂ) :=
  LinearMap.pi fun i : Fin (n + 1) =>
    LinearMap.proj (Equiv.swap (0 : Fin (n + 1)) j i)

noncomputable def homogeneousMapFinSuccArbitraryPivotPlaneMap
    {n : ℕ} (c : Fin (n + 1) → ℂ) (j : Fin (n + 1)) :
    (Fin n → ℂ) →ₗ[ℂ] (Fin (n + 1) → ℂ) :=
  (homogeneousMapFinSuccPivotPermutation j).comp
    (homogeneousMapFinSuccFirstPivotPlaneMap
      (fun i => c ((Equiv.swap (0 : Fin (n + 1)) j).symm i)))

theorem homogeneousMapFinSuccArbitraryPivotPlaneMap_injective
    {n : ℕ} (c : Fin (n + 1) → ℂ) (j : Fin (n + 1)) :
    Function.Injective (homogeneousMapFinSuccArbitraryPivotPlaneMap c j) := by
  intro u v huv
  apply homogeneousMapFinSuccFirstPivotPlaneMap_injective
    (fun i => c ((Equiv.swap (0 : Fin (n + 1)) j).symm i))
  funext i
  have hi := congrFun huv
    ((Equiv.swap (0 : Fin (n + 1)) j).symm i)
  simpa only [Equiv.symm_swap, homogeneousMapFinSuccArbitraryPivotPlaneMap,
    homogeneousMapFinSuccPivotPermutation, LinearMap.coe_comp, Function.comp_apply, LinearMap.pi_apply,
    Equiv.swap_apply_self, LinearMap.coe_proj, Function.eval] using hi

theorem homogeneousMapFinSuccArbitraryPivotPlaneMap_coordinate
    {n : ℕ} (c : Fin (n + 1) → ℂ)
    (j i : Fin (n + 1)) :
    linearCoordinatePolynomial
      (homogeneousMapFinSuccArbitraryPivotPlaneMap c j) i =
    linearCoordinatePolynomial
      (homogeneousMapFinSuccFirstPivotPlaneMap
        (fun q => c ((Equiv.swap (0 : Fin (n + 1)) j).symm q)))
      (Equiv.swap (0 : Fin (n + 1)) j i) := by
  simp only [linearCoordinatePolynomial, homogeneousMapFinSuccArbitraryPivotPlaneMap,
    homogeneousMapFinSuccPivotPermutation, Equiv.symm_swap, LinearMap.coe_comp, Function.comp_apply, LinearMap.pi_apply,
    LinearMap.coe_proj, Function.eval]

theorem homogeneousMapFinSuccArbitraryPivotPlaneMap_substitution
    {n : ℕ} (c : Fin (n + 1) → ℂ)
    (j : Fin (n + 1))
    (p : MvPolynomial (Fin (n + 1)) ℂ) :
    (MvPolynomial.finSuccEquiv ℂ n
      (MvPolynomial.rename (Equiv.swap (0 : Fin (n + 1)) j) p)).eval
        (homogeneousMapFinSuccFirstPivotPlaneRoot
          (fun i => c ((Equiv.swap (0 : Fin (n + 1)) j).symm i))) =
      MvPolynomial.aeval
        (fun row => linearCoordinatePolynomial
          (homogeneousMapFinSuccArbitraryPivotPlaneMap c j) row) p := by
  rw [homogeneousMapFinSuccFirstPivotPlaneMap_substitution,
    MvPolynomial.aeval_rename]
  apply congrArg
    (fun coordinates : Fin (n + 1) → MvPolynomial (Fin n) ℂ =>
      MvPolynomial.aeval coordinates p)
  funext i
  exact (homogeneousMapFinSuccArbitraryPivotPlaneMap_coordinate c j i).symm

theorem homogeneousMapFinSuccArbitraryPivotPlaneMap_kernel
    {n : ℕ} (c : Fin (n + 1) → ℂ)
    (j : Fin (n + 1)) (hj : c j ≠ 0)
    (u : Fin n → ℂ) :
    ∑ i : Fin (n + 1),
      c i * homogeneousMapFinSuccArbitraryPivotPlaneMap c j u i = 0 := by
  let swap := Equiv.swap (0 : Fin (n + 1)) j
  let d : Fin (n + 1) → ℂ := fun i => c (swap.symm i)
  have hd : d 0 ≠ 0 := by
    simpa [d, swap] using hj
  have hsum := homogeneousMapFinSuccFirstPivotPlaneMap_kernel d hd u
  have hreindex :
      (∑ i : Fin (n + 1),
        c i * homogeneousMapFinSuccArbitraryPivotPlaneMap c j u i) =
      ∑ i : Fin (n + 1),
        d i * homogeneousMapFinSuccFirstPivotPlaneMap d u i := by
    refine Fintype.sum_equiv swap
      (fun i : Fin (n + 1) =>
        c i * homogeneousMapFinSuccArbitraryPivotPlaneMap c j u i)
      (fun i : Fin (n + 1) =>
        d i * homogeneousMapFinSuccFirstPivotPlaneMap d u i) ?_
    intro i
    simp only [homogeneousMapFinSuccArbitraryPivotPlaneMap, homogeneousMapFinSuccPivotPermutation,
      Equiv.symm_swap, LinearMap.coe_comp, Function.comp_apply, LinearMap.pi_apply, LinearMap.coe_proj, Function.eval,
      Equiv.swap_apply_self, d, swap]
  rw [hreindex]
  exact hsum

theorem homogeneousMapFinSuccArbitraryPivotPlaneMap_restricted_zeroFiber
    {n : ℕ}
    (F : Fin (n + 1) → MvPolynomial (Fin (n + 1)) ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (c : Fin (n + 1) → ℂ)
    (j : Fin (n + 1)) (hj : c j ≠ 0)
    (hradical :
      ((Ideal.span (Set.range fun i : Fin n => F i.castSucc)) ⊔
        Ideal.span (Set.range fun _ : Fin 1 =>
          permanentRolloutLinearCoordinateCombination (n + 1) c)).radical =
        MvPolynomial.idealOfVars (Fin (n + 1)) ℂ) :
    ∀ u : Fin n → ℂ,
      (∀ i : Fin n,
        MvPolynomial.eval u
          (MvPolynomial.aeval
            (fun row => linearCoordinatePolynomial
              (homogeneousMapFinSuccArbitraryPivotPlaneMap c j) row)
            (F i.castSucc)) = 0) ↔ u = 0 := by
  classical
  intro u
  constructor
  · intro hu
    let W := homogeneousMapFinSuccArbitraryPivotPlaneMap c j
    let I : Ideal (MvPolynomial (Fin (n + 1)) ℂ) :=
      Ideal.span (Set.range fun i : Fin n => F i.castSucc)
    have hvanishing : W u ∈ MvPolynomial.zeroLocus ℂ I := by
      intro p hp
      have hs : I ≤ MvPolynomial.vanishingIdeal ℂ {W u} := by
        change Ideal.span (Set.range fun i : Fin n => F i.castSucc) ≤ _
        rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        change F i.castSucc ∈ MvPolynomial.vanishingIdeal ℂ {W u}
        rw [MvPolynomial.mem_vanishingIdeal_singleton_iff]
        exact (eval_aeval_linearCoordinatePolynomial W u
          (F i.castSucc)).symm.trans (hu i)
      exact hs hp (W u) (Set.mem_singleton _)
    have hkernel :
        Matrix.mulVecLin
          ((fun _ : Fin 1 => c) : Matrix (Fin 1) (Fin (n + 1)) ℂ)
            (W u) = 0 := by
      funext q
      fin_cases q
      change (∑ i : Fin (n + 1), c i * W u i) = 0
      exact homogeneousMapFinSuccArbitraryPivotPlaneMap_kernel c j hj u
    have hWu : W u = 0 :=
      eq_zero_of_mem_zeroLocus_of_linearCoordinateKernel_of_radical
        I (fun _ : Fin 1 => c) hradical hvanishing hkernel
    exact homogeneousMapFinSuccArbitraryPivotPlaneMap_injective c j
      (hWu.trans (map_zero W).symm)
  · rintro rfl i
    rw [eval_aeval_linearCoordinatePolynomial,
      map_zero]
    exact homogeneous_eval_zero_of_pos he (hF i.castSucc)

theorem homogeneousMapFinSucc_source_prefix_plane_data
    {n : ℕ}
    (F : Fin (n + 1) → MvPolynomial (Fin (n + 1)) ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin (n + 1) → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    ∃ c : Fin 1 → Fin (n + 1) → ℂ,
      LinearIndependent ℂ c ∧
      MvPolynomial.zeroLocus ℂ
        (Ideal.span (Set.range fun i : Fin n => F i.castSucc) ⊔
          Ideal.span (Set.range fun i : Fin 1 =>
            permanentRolloutLinearCoordinateCombination (n + 1) (c i))) =
        ({0} : Set (Fin (n + 1) → ℂ)) := by
  classical
  have hcard :
      (Finset.univ.erase (Fin.last n) : Finset (Fin (n + 1))).card = n := by
    simp only [Finset.mem_univ, Finset.card_erase_of_mem, Finset.card_univ, Fintype.card_fin,
      add_tsub_cancel_right]
  have hslices :
      ∃ c : Fin 1 → Fin (n + 1) → ℂ,
        LinearIndependent ℂ c ∧
        MvPolynomial.zeroLocus ℂ
          (homogeneousLinearSliceIdeal
            (Ideal.span
              (F '' ((Finset.univ.erase (Fin.last n) :
                Finset (Fin (n + 1))) : Set (Fin (n + 1))))) c) =
          ({0} : Set (Fin (n + 1) → ℂ)) := by
    have h :=
      homogeneousMap_exists_coordinateSubset_independent_linear_origin_slices
        F e he hF hzero (Finset.univ.erase (Fin.last n))
    have hsub : n + 1 - n = 1 := by omega
    rw [hcard, hsub] at h
    exact h
  obtain ⟨c, hc, hslice⟩ := hslices
  have himage :
      F '' ((Finset.univ.erase (Fin.last n) :
        Finset (Fin (n + 1))) : Set (Fin (n + 1))) =
        Set.range (fun i : Fin n => F i.castSucc) := by
    ext p
    constructor
    · rintro ⟨i, hi, rfl⟩
      have hlast : i ≠ Fin.last n := by
        simpa only [ne_eq, Finset.coe_erase, Finset.coe_univ, Set.mem_sdiff, Set.mem_univ, Set.mem_singleton_iff,
          true_and] using hi
      obtain ⟨q, rfl⟩ := Fin.eq_castSucc_of_ne_last hlast
      exact ⟨q, rfl⟩
    · rintro ⟨i, rfl⟩
      refine ⟨i.castSucc, ?_, rfl⟩
      simp only [Finset.coe_erase, Finset.coe_univ, Set.mem_sdiff, Set.mem_univ, Set.mem_singleton_iff,
        Fin.castSucc_ne_last, not_false_eq_true, and_self]
  refine ⟨c, hc, ?_⟩
  change MvPolynomial.zeroLocus ℂ
    (Ideal.span
      (F '' ((Finset.univ.erase (Fin.last n) :
        Finset (Fin (n + 1))) : Set (Fin (n + 1)))) ⊔
      Ideal.span (Set.range fun i : Fin 1 =>
        permanentRolloutLinearCoordinateCombination (n + 1) (c i))) =
    ({0} : Set (Fin (n + 1) → ℂ)) at hslice
  rw [himage] at hslice
  exact hslice

theorem homogeneousMapFinSucc_exists_source_arbitraryPivot_restricted_zeroFiber
    {n : ℕ}
    (F : Fin (n + 1) → MvPolynomial (Fin (n + 1)) ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin (n + 1) → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0) :
    ∃ (c : Fin (n + 1) → ℂ) (j : Fin (n + 1)),
      c j ≠ 0 ∧
      (∀ i : Fin n,
        (MvPolynomial.aeval
          (fun row => linearCoordinatePolynomial
            (homogeneousMapFinSuccArbitraryPivotPlaneMap c j) row)
          (F i.castSucc)).IsHomogeneous e) ∧
      (∀ u : Fin n → ℂ,
        (∀ i : Fin n,
          MvPolynomial.eval u
            (MvPolynomial.aeval
              (fun row => linearCoordinatePolynomial
                (homogeneousMapFinSuccArbitraryPivotPlaneMap c j) row)
              (F i.castSucc)) = 0) ↔ u = 0) := by
  classical
  obtain ⟨c, hc, hslicedZero⟩ :=
    homogeneousMapFinSucc_source_prefix_plane_data F e he hF hzero
  have hc0 : c 0 ≠ 0 := hc.ne_zero 0
  obtain ⟨j, hj⟩ : ∃ j : Fin (n + 1), c 0 j ≠ 0 := by
    by_contra h
    simp only [not_exists, not_not] at h
    exact hc0 (funext fun i => h i)
  have hrange :
      Set.range (fun i : Fin 1 =>
        permanentRolloutLinearCoordinateCombination (n + 1) (c i)) =
      Set.range (fun _ : Fin 1 =>
        permanentRolloutLinearCoordinateCombination (n + 1) (c 0)) := by
    ext p
    constructor
    · rintro ⟨i, rfl⟩
      have hi : i = 0 := Subsingleton.elim i 0
      exact ⟨0, by simp only [Fin.isValue, hi]⟩
    · rintro ⟨i, rfl⟩
      exact ⟨0, rfl⟩
  have hradical :
      ((Ideal.span (Set.range fun i : Fin n => F i.castSucc)) ⊔
        Ideal.span (Set.range fun _ : Fin 1 =>
          permanentRolloutLinearCoordinateCombination (n + 1)
            (c 0))).radical =
        MvPolynomial.idealOfVars (Fin (n + 1)) ℂ := by
    rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := ℂ)]
    have hzeroPlane :
        MvPolynomial.zeroLocus ℂ
          ((Ideal.span (Set.range fun i : Fin n => F i.castSucc)) ⊔
            Ideal.span (Set.range fun _ : Fin 1 =>
              permanentRolloutLinearCoordinateCombination (n + 1)
                (c 0))) =
          ({0} : Set (Fin (n + 1) → ℂ)) := by
      rw [← hrange]
      exact hslicedZero
    rw [hzeroPlane, vanishingIdeal_origin_eq_idealOfVars]
  refine ⟨c 0, j, hj, ?_,
    homogeneousMapFinSuccArbitraryPivotPlaneMap_restricted_zeroFiber
      F e he hF (c 0) j hj hradical⟩
  intro i
  simpa only [Fin.isValue, MvPolynomial.aeval_eq_bind₁, one_mul] using
    (hF i.castSucc).aeval
      (fun row => linearCoordinatePolynomial (homogeneousMapFinSuccArbitraryPivotPlaneMap (c 0) j) row)
      (fun row => linearCoordinatePolynomial_isHomogeneous (homogeneousMapFinSuccArbitraryPivotPlaneMap (c 0) j) row)

theorem homogeneousMap_allRank_finSucc_arbitraryPivotPlaneQuotientEquiv_mk_eq_aeval
    {n : ℕ} (c : Fin (n + 1) → ℂ)
    (j : Fin (n + 1)) (hj : c j ≠ 0)
    (p : MvPolynomial (Fin (n + 1)) ℂ) :
    homogeneousMapFinSuccArbitraryPivotPlaneQuotientEquiv c j hj
      (Ideal.Quotient.mk
        (Ideal.span
          ({permanentRolloutLinearCoordinateCombination (n + 1) c} :
            Set (MvPolynomial (Fin (n + 1)) ℂ))) p) =
      MvPolynomial.aeval
        (fun row => linearCoordinatePolynomial
          (homogeneousMapFinSuccArbitraryPivotPlaneMap c j) row) p := by
  rw [homogeneousMap_allRank_finSucc_arbitraryPivotPlaneQuotientEquiv_mk]
  change
