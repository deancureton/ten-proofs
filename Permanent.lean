section Standalone_Combinatorics

open scoped BigOperators

theorem rootOfUnity_node_product_algebra
    {R : Type*} [CommRing R] [Algebra ℂ R]
    {d : ℕ} (hd : 0 < d) {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ d) (x y : R) :
    (∏ j ∈ Finset.range d,
      (x + algebraMap ℂ R (2 * ζ ^ j) * y)) =
      x ^ d - (algebraMap ℂ R (-2) * y) ^ d := by
  let alpha : Polynomial ℂ := Polynomial.C (-2) * Polynomial.X
  have hroot : IsPrimitiveRoot (Polynomial.C ζ) d :=
    hζ.map_of_injective Polynomial.C_injective
  have hfactor := X_pow_sub_C_eq_prod hroot hd
    (α := alpha) (a := alpha ^ d) rfl
  let coeffHom : Polynomial ℂ →+* R :=
    Polynomial.eval₂RingHom (algebraMap ℂ R) y
  have hterm (j : ℕ) :
      Polynomial.eval₂ coeffHom x
        ((Polynomial.X : Polynomial (Polynomial ℂ)) -
          Polynomial.C ((Polynomial.C ζ) ^ j * alpha)) =
        x + algebraMap ℂ R (2 * ζ ^ j) * y := by
    simp only [map_neg, neg_mul, mul_neg, map_mul, map_pow, sub_neg_eq_add, Polynomial.eval₂_add,
      Polynomial.eval₂_X, Polynomial.eval₂_mul, Polynomial.eval₂_pow, Polynomial.eval₂_C, Polynomial.coe_eval₂RingHom,
      add_right_inj, coeffHom, alpha]
    ring
  calc
    (∏ j ∈ Finset.range d,
      (x + algebraMap ℂ R (2 * ζ ^ j) * y)) =
        Polynomial.eval₂ coeffHom x
          (∏ j ∈ Finset.range d,
            ((Polynomial.X : Polynomial (Polynomial ℂ)) -
              Polynomial.C ((Polynomial.C ζ) ^ j * alpha))) := by
                rw [Polynomial.eval₂_finsetProd]
                apply Finset.prod_congr rfl
                intro j _
                exact (hterm j).symm
    _ = x ^ d - (algebraMap ℂ R (-2) * y) ^ d := by
      rw [← hfactor]
      simp only [map_neg, neg_mul, map_pow, map_mul, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_neg, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.coe_eval₂RingHom, coeffHom, alpha]

theorem rootOfUnity_node_product_source_algebra
    {R : Type*} [CommRing R] [Algebra ℂ R]
    {d : ℕ} (hd : 0 < d) {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ d) (x y : R) :
    (∏ j ∈ Finset.range d,
      (x + algebraMap ℂ R (2 * ζ ^ j) * y)) =
      x ^ d +
        algebraMap ℂ R (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) * y ^ d := by
  rw [rootOfUnity_node_product_algebra hd hζ x y]
  have hneg : algebraMap ℂ R (-2) = -(algebraMap ℂ R 2) := by
    norm_num
  rw [hneg, neg_mul, neg_pow, mul_pow,
    map_mul, map_pow, map_pow, pow_succ]
  norm_num
  ring

theorem rootOfUnity_node_coefficient_ne_zero (d : ℕ) :
    ((-1 : ℂ) ^ (d + 1) * (2 : ℂ) ^ d) ≠ 0 := by
  exact mul_ne_zero (pow_ne_zero _ (by norm_num)) (pow_ne_zero _ (by norm_num))

theorem rootOfUnity_node_coefficient_add_one_ne_zero {d : ℕ} (hd : 0 < d) :
    1 + (-1 : ℂ) ^ (d + 1) * (2 : ℂ) ^ d ≠ 0 := by
  intro h
  have heq : (-1 : ℂ) ^ (d + 1) * (2 : ℂ) ^ d = -1 := by
    linear_combination h
  have hnorm := congrArg norm heq
  norm_num [norm_mul, norm_pow] at hnorm
  have hpow : (1 : ℝ) < 2 ^ d := one_lt_pow₀ (by norm_num) hd.ne'
  linarith

end Standalone_Combinatorics

section Standalone_SquareZero

open scoped BigOperators

noncomputable def squareZeroIdeal (r : ℕ) : Ideal (MvPolynomial (Fin r) ℂ) :=
  Ideal.span (Set.range fun i : Fin r => (MvPolynomial.X i) ^ 2)

abbrev SquareZeroAlgebra (r : ℕ) :=
  MvPolynomial (Fin r) ℂ ⧸ squareZeroIdeal r

noncomputable def squareZeroVariable (r : ℕ) (i : Fin r) : SquareZeroAlgebra r :=
  Ideal.Quotient.mk (squareZeroIdeal r) (MvPolynomial.X i)

@[simp] theorem squareZeroVariable_sq (r : ℕ) (i : Fin r) :
    squareZeroVariable r i ^ 2 = 0 := by
  change (Ideal.Quotient.mk (squareZeroIdeal r) (MvPolynomial.X i)) ^ 2 = 0
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span ⟨i, rfl⟩

noncomputable def squareZeroBlockSum (r : ℕ) (block : Finset (Fin r)) :
    SquareZeroAlgebra r :=
  ∑ i ∈ block, squareZeroVariable r i

theorem square_zero_add_pow_succ {R : Type*} [CommSemiring R]
    {x y : R} {n : ℕ} (hx : x ^ 2 = 0) (hy : y ^ (n + 1) = 0) :
    (x + y) ^ (n + 1) = (n + 1 : ℕ) * x * y ^ n := by
  classical
  rw [add_pow, Finset.sum_eq_single 1]
  · simp only [pow_one, add_tsub_cancel_right, Nat.choose_one_right, Nat.cast_add, Nat.cast_one, mul_assoc,
      mul_comm, mul_left_comm]
  · intro j _ hj
    by_cases hzero : j = 0
    · subst j
      simp only [pow_zero, tsub_zero, hy, mul_zero, Nat.choose_zero_right, Nat.cast_one, mul_one]
    · have htwo : 2 ≤ j := by omega
      simp only [pow_eq_zero_of_le htwo hx, zero_mul]
  · simp only [Finset.mem_range, lt_add_iff_pos_left, Order.lt_add_one_iff, zero_le, not_true_eq_false, pow_one,
      add_tsub_cancel_right, Nat.choose_one_right, Nat.cast_add, Nat.cast_one, IsEmpty.forall_iff]

theorem square_zero_sum_pow_card_and_succ {R ι : Type*} [CommSemiring R]
    (s : Finset ι) (z : ι → R)
    (hz : ∀ i ∈ s, z i ^ 2 = 0) :
    ((∑ i ∈ s, z i) ^ s.card = (s.card.factorial : R) * ∏ i ∈ s, z i) ∧
      (∑ i ∈ s, z i) ^ (s.card + 1) = 0 := by
  classical
  induction s using Finset.induction_on with
  | empty => simp only [Finset.sum_empty, Finset.card_empty, pow_zero, Nat.factorial_zero, Nat.cast_one, Finset.prod_empty,
               mul_one, zero_add, pow_one, and_self]
  | @insert a s ha ih =>
    have hza : z a ^ 2 = 0 := hz a (by simp only [Finset.mem_insert, true_or])
    have hzs : ∀ i ∈ s, z i ^ 2 = 0 := fun i hi => hz i (by simp only [Finset.mem_insert, hi, or_true])
    obtain ⟨hcard, hnext⟩ := ih hzs
    constructor
    · rw [Finset.sum_insert ha, Finset.prod_insert ha,
        Finset.card_insert_of_notMem ha,
        square_zero_add_pow_succ hza hnext, hcard, Nat.factorial_succ, Nat.cast_mul]
      ring
    · rw [Finset.sum_insert ha, Finset.card_insert_of_notMem ha]
      have hnext' : (∑ i ∈ s, z i) ^ (s.card + 1 + 1) = 0 := by
        rw [pow_succ, hnext, zero_mul]
      simpa only [Nat.add_assoc, Nat.reduceAdd, Nat.cast_add, Nat.cast_ofNat, hnext, mul_zero] using
        (square_zero_add_pow_succ (n := s.card + 1) hza hnext')

theorem squareZeroBlockSum_pow_card (r : ℕ) (block : Finset (Fin r)) :
    squareZeroBlockSum r block ^ block.card =
      (block.card.factorial : SquareZeroAlgebra r) *
        ∏ i ∈ block, squareZeroVariable r i := by
  exact (square_zero_sum_pow_card_and_succ block (squareZeroVariable r)
    (fun i _ => squareZeroVariable_sq r i)).1

theorem squareZeroBlockSum_pow_card_succ (r : ℕ) (block : Finset (Fin r)) :
    squareZeroBlockSum r block ^ (block.card + 1) = 0 := by
  exact (square_zero_sum_pow_card_and_succ block (squareZeroVariable r)
    (fun i _ => squareZeroVariable_sq r i)).2

end Standalone_SquareZero

section Standalone_Subtree

open scoped BigOperators

inductive BlockTree (ι : Type*) where
  | leaf (label : ι)
  | branch (left right : BlockTree ι)

namespace BlockTree

@[simp] def leaves {ι : Type*} [DecidableEq ι] : BlockTree ι → Finset ι
  | .leaf i => {i}
  | .branch left right => leaves left ∪ leaves right

@[simp] def leafList {ι : Type*} : BlockTree ι → List ι
  | .leaf i => [i]
  | .branch left right => leafList left ++ leafList right

theorem mem_leaves_iff {ι : Type*} [DecidableEq ι]
    (tree : BlockTree ι) (i : ι) :
    i ∈ tree.leaves ↔ i ∈ tree.leafList := by
  induction tree with
  | leaf label => simp only [leaves, Finset.mem_singleton, leafList, List.mem_cons, List.not_mem_nil, or_false]
  | branch left right left_ih right_ih =>
    simp only [leaves, Finset.mem_union, left_ih, right_ih, leafList, List.mem_append]

theorem disjoint_leaves_of_nodup {ι : Type*} [DecidableEq ι]
    {left right : BlockTree ι}
    (h : (BlockTree.branch left right).leafList.Nodup) :
    Disjoint left.leaves right.leaves := by
  rw [Finset.disjoint_left]
  intro i hi_left hi_right
  have hparts := (List.nodup_append.mp h).2.2
  exact hparts i ((mem_leaves_iff left i).mp hi_left)
    i ((mem_leaves_iff right i).mp hi_right) rfl

end BlockTree

@[simp] noncomputable def subtreeCoefficient {ι : Type*} [DecidableEq ι]
    (lam : ℂ) : BlockTree ι → ι → ℂ
  | .leaf label, i => if i = label then 1 else 0
  | .branch left right, i =>
      (∑ j ∈ left.leaves, subtreeCoefficient lam left j) *
          subtreeCoefficient lam right i +
        lam * (∑ j ∈ right.leaves, subtreeCoefficient lam right j) *
          subtreeCoefficient lam left i

noncomputable def subtreeCoefficientTotal {ι : Type*} [DecidableEq ι]
    (lam : ℂ) (tree : BlockTree ι) : ℂ :=
  ∑ i ∈ tree.leaves, subtreeCoefficient lam tree i

@[simp] theorem subtreeCoefficientTotal_leaf {ι : Type*} [DecidableEq ι]
    (lam : ℂ) (label : ι) :
    subtreeCoefficientTotal lam (.leaf label) = 1 := by
  simp only [subtreeCoefficientTotal, BlockTree.leaves, subtreeCoefficient, Finset.sum_ite_eq',
    Finset.mem_singleton, ↓reduceIte]

theorem subtreeCoefficient_eq_zero_of_not_mem {ι : Type*} [DecidableEq ι]
    (lam : ℂ) (tree : BlockTree ι) {i : ι} (hi : i ∉ tree.leaves) :
    subtreeCoefficient lam tree i = 0 := by
  induction tree with
  | leaf label =>
    simp_all
  | branch left right left_ih right_ih =>
    have hi_left : i ∉ left.leaves := by
      intro h
      exact hi (Finset.mem_union_left _ h)
    have hi_right : i ∉ right.leaves := by
      intro h
      exact hi (Finset.mem_union_right _ h)
    simp only [subtreeCoefficient, right_ih hi_right, mul_zero, left_ih hi_left, add_zero]

theorem subtreeCoefficient_branch_right {ι : Type*} [DecidableEq ι]
    (lam : ℂ) {left right : BlockTree ι}
    (hdisj : Disjoint left.leaves right.leaves) {i : ι}
    (hi : i ∈ right.leaves) :
    subtreeCoefficient lam (.branch left right) i =
      subtreeCoefficientTotal lam left * subtreeCoefficient lam right i := by
  have hnot : i ∉ left.leaves :=
    fun h => (Finset.disjoint_left.mp hdisj) h hi
  simp only [subtreeCoefficient, subtreeCoefficient_eq_zero_of_not_mem lam left hnot, mul_zero, add_zero,
    subtreeCoefficientTotal]

theorem subtreeCoefficient_branch_left {ι : Type*} [DecidableEq ι]
    (lam : ℂ) {left right : BlockTree ι}
    (hdisj : Disjoint left.leaves right.leaves) {i : ι}
    (hi : i ∈ left.leaves) :
    subtreeCoefficient lam (.branch left right) i =
      lam * subtreeCoefficientTotal lam right * subtreeCoefficient lam left i := by
  have hnot : i ∉ right.leaves :=
    fun h => (Finset.disjoint_left.mp hdisj) hi h
  simp only [subtreeCoefficient, subtreeCoefficient_eq_zero_of_not_mem lam right hnot, mul_zero, zero_add,
    subtreeCoefficientTotal]

theorem subtreeCoefficientTotal_branch {ι : Type*} [DecidableEq ι]
    (lam : ℂ) {left right : BlockTree ι}
    (hdisj : Disjoint left.leaves right.leaves) :
    subtreeCoefficientTotal lam (.branch left right) =
      (1 + lam) * subtreeCoefficientTotal lam left *
        subtreeCoefficientTotal lam right := by
  change
    (∑ i ∈ left.leaves ∪ right.leaves,
      subtreeCoefficient lam (.branch left right) i) =
      (1 + lam) * subtreeCoefficientTotal lam left *
        subtreeCoefficientTotal lam right
  rw [Finset.sum_union hdisj]
  have hleft :
      (∑ i ∈ left.leaves,
        subtreeCoefficient lam (.branch left right) i) =
        lam * subtreeCoefficientTotal lam right *
          subtreeCoefficientTotal lam left := by
    calc
      (∑ i ∈ left.leaves,
        subtreeCoefficient lam (.branch left right) i) =
          ∑ i ∈ left.leaves,
            lam * subtreeCoefficientTotal lam right *
              subtreeCoefficient lam left i := by
                apply Finset.sum_congr rfl
                intro i hi
                exact subtreeCoefficient_branch_left lam hdisj hi
      _ = lam * subtreeCoefficientTotal lam right *
          subtreeCoefficientTotal lam left := by
            rw [← Finset.mul_sum]
            rfl
  have hright :
      (∑ i ∈ right.leaves,
        subtreeCoefficient lam (.branch left right) i) =
        subtreeCoefficientTotal lam left *
          subtreeCoefficientTotal lam right := by
    calc
      (∑ i ∈ right.leaves,
        subtreeCoefficient lam (.branch left right) i) =
          ∑ i ∈ right.leaves,
            subtreeCoefficientTotal lam left *
              subtreeCoefficient lam right i := by
                apply Finset.sum_congr rfl
                intro i hi
                exact subtreeCoefficient_branch_right lam hdisj hi
      _ = subtreeCoefficientTotal lam left *
          subtreeCoefficientTotal lam right := by
            rw [← Finset.mul_sum]
            rfl
  rw [hleft, hright]
  ring

theorem subtreeCoefficient_and_total_ne_zero {ι : Type*} [DecidableEq ι]
    (lam : ℂ) (hlam : lam ≠ 0) (hlamone : 1 + lam ≠ 0)
    (tree : BlockTree ι) (hnodup : tree.leafList.Nodup) :
    (∀ i ∈ tree.leaves, subtreeCoefficient lam tree i ≠ 0) ∧
      subtreeCoefficientTotal lam tree ≠ 0 := by
  induction tree with
  | leaf label =>
    simp only [BlockTree.leaves, Finset.mem_singleton, subtreeCoefficient, ne_eq, ite_eq_right_iff, one_ne_zero,
      imp_false, Decidable.not_not, imp_self, implies_true, subtreeCoefficientTotal_leaf, not_false_eq_true, and_self]
  | branch left right left_ih right_ih =>
    have hparts := List.nodup_append.mp hnodup
    have hdisj := BlockTree.disjoint_leaves_of_nodup hnodup
    obtain ⟨hleft_coeff, hleft_total⟩ := left_ih hparts.1
    obtain ⟨hright_coeff, hright_total⟩ := right_ih hparts.2.1
    constructor
    · intro i hi
      rcases Finset.mem_union.mp hi with hi_left | hi_right
      · rw [subtreeCoefficient_branch_left lam hdisj hi_left]
        exact mul_ne_zero (mul_ne_zero hlam hright_total)
          (hleft_coeff i hi_left)
      · rw [subtreeCoefficient_branch_right lam hdisj hi_right]
        exact mul_ne_zero hleft_total (hright_coeff i hi_right)
    · rw [subtreeCoefficientTotal_branch lam hdisj]
      exact mul_ne_zero (mul_ne_zero hlamone hleft_total) hright_total

theorem rootOfUnity_subtreeCoefficient_and_total_ne_zero
    {ι : Type*} [DecidableEq ι] {d : ℕ} (hd : 0 < d)
    (tree : BlockTree ι) (hnodup : tree.leafList.Nodup) :
    let lam : ℂ := (-1 : ℂ) ^ (d + 1) * (2 : ℂ) ^ d
    (∀ i ∈ tree.leaves, subtreeCoefficient lam tree i ≠ 0) ∧
      subtreeCoefficientTotal lam tree ≠ 0 := by
  dsimp
  exact subtreeCoefficient_and_total_ne_zero _
    (rootOfUnity_node_coefficient_ne_zero d)
    (rootOfUnity_node_coefficient_add_one_ne_zero hd) tree hnodup

theorem subtreeTopProduct_mul_mem_eq_zero
    {R ι : Type*} [CommSemiring R] [DecidableEq ι]
    (s : Finset ι) (y : ι → R) (t : ℕ) {i : ι}
    (hi : i ∈ s) (hnil : y i ^ (t + 1) = 0) :
    (∏ j ∈ s, y j ^ t) * y i = 0 := by
  calc
    (∏ j ∈ s, y j ^ t) * y i =
        (∏ j ∈ s.erase i, y j ^ t) * (y i ^ t * y i) := by
          rw [← Finset.prod_erase_mul s (fun j => y j ^ t) hi]
          ring
    _ = 0 := by rw [← pow_succ, hnil, mul_zero]

theorem subtreeTopProduct_mul_other_sum_eq_zero
    {R ι : Type*} [CommSemiring R] [DecidableEq ι]
    (s : Finset ι) (y : ι → R) (t : ℕ) (i : ι)
    (hnil : ∀ j ∈ s, y j ^ (t + 1) = 0) :
    (∏ j ∈ s.erase i, y j ^ t) *
        (∑ j ∈ s.erase i, y j) = 0 := by
  rw [Finset.mul_sum]
  apply Finset.sum_eq_zero
  intro j hj
  exact subtreeTopProduct_mul_mem_eq_zero (s.erase i) y t hj
    (hnil j (Finset.mem_of_mem_erase hj))

theorem subtree_mul_add_pow_eq_of_annihilates
    {R : Type*} [CommSemiring R] (p x z : R)
    (hp : p * z = 0) (d : ℕ) :
    p * (x + z) ^ d = p * x ^ d := by
  induction d with
  | zero => simp only [pow_zero, mul_one]
  | succ d ih =>
    calc
      p * (x + z) ^ (d + 1) =
          (p * (x + z) ^ d) * (x + z) := by
            rw [pow_succ, mul_assoc]
      _ = (p * x ^ d) * (x + z) := by rw [ih]
      _ = p * x ^ (d + 1) := by
        rw [mul_add]
        have hzero : (p * x ^ d) * z = 0 := by
          calc
            (p * x ^ d) * z = (p * z) * x ^ d := by ring
            _ = 0 := by rw [hp, zero_mul]
        rw [hzero, add_zero, pow_succ, mul_assoc]

theorem subtree_single_surviving_block
    {R ι : Type*} [CommSemiring R] [DecidableEq ι]
    (s : Finset ι) (y : ι → R) (t d : ℕ) {i : ι}
    (hi : i ∈ s) (hd : d ≤ t)
    (hnil : ∀ j ∈ s, y j ^ (t + 1) = 0) :
    (y i ^ (t - d) * ∏ j ∈ s.erase i, y j ^ t) *
        (∑ j ∈ s, y j) ^ d =
      ∏ j ∈ s, y j ^ t := by
  have hother := subtreeTopProduct_mul_other_sum_eq_zero s y t i hnil
  have hsum : (∑ j ∈ s, y j) = y i + ∑ j ∈ s.erase i, y j :=
    (Finset.add_sum_erase s y hi).symm
  have hcut := subtree_mul_add_pow_eq_of_annihilates
    (∏ j ∈ s.erase i, y j ^ t) (y i)
    (∑ j ∈ s.erase i, y j) hother d
  have hdegree : t - d + d = t := Nat.sub_add_cancel hd
  calc
    (y i ^ (t - d) * ∏ j ∈ s.erase i, y j ^ t) *
          (∑ j ∈ s, y j) ^ d =
        y i ^ (t - d) *
          ((∏ j ∈ s.erase i, y j ^ t) *
            (y i + ∑ j ∈ s.erase i, y j) ^ d) := by
              rw [hsum]
              ring
    _ = y i ^ (t - d) *
          ((∏ j ∈ s.erase i, y j ^ t) * y i ^ d) := by rw [hcut]
    _ = (∏ j ∈ s.erase i, y j ^ t) *
          (y i ^ (t - d) * y i ^ d) := by ring
    _ = (∏ j ∈ s.erase i, y j ^ t) * y i ^ t := by
      rw [← pow_add, hdegree]
    _ = ∏ j ∈ s, y j ^ t :=
      Finset.prod_erase_mul s (fun j => y j ^ t) hi

theorem subtree_weighted_sum_mul_block_sum_pow
    {R ι : Type*} [CommSemiring R] [DecidableEq ι]
    (s : Finset ι) (y a : ι → R) (t d : ℕ) (hd : d ≤ t)
    (hnil : ∀ j ∈ s, y j ^ (t + 1) = 0) :
    (∑ i ∈ s, a i *
      (y i ^ (t - d) * ∏ j ∈ s.erase i, y j ^ t)) *
        (∑ j ∈ s, y j) ^ d =
      (∑ i ∈ s, a i) * ∏ j ∈ s, y j ^ t := by
  calc
    (∑ i ∈ s, a i *
      (y i ^ (t - d) * ∏ j ∈ s.erase i, y j ^ t)) *
          (∑ j ∈ s, y j) ^ d =
        ∑ i ∈ s, a i *
          ((y i ^ (t - d) * ∏ j ∈ s.erase i, y j ^ t) *
            (∑ j ∈ s, y j) ^ d) := by
              rw [Finset.sum_mul]
              apply Finset.sum_congr rfl
              intro i _
              ring
    _ = ∑ i ∈ s, a i * (∏ j ∈ s, y j ^ t) := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [subtree_single_surviving_block s y t d hi hd hnil]
    _ = (∑ i ∈ s, a i) * ∏ j ∈ s, y j ^ t := by
      rw [Finset.sum_mul]

noncomputable def subtreeFormProduct
    {R ι : Type*} [CommSemiring R] [Algebra ℂ R] [DecidableEq ι]
    (y : ι → R) (t d : ℕ) (lam : ℂ) : BlockTree ι → R
  | .leaf i => y i ^ (t - d)
  | .branch left right =>
      subtreeFormProduct y t d lam left *
        subtreeFormProduct y t d lam right *
          ((∑ i ∈ left.leaves, y i) ^ d +
            algebraMap ℂ R lam * (∑ i ∈ right.leaves, y i) ^ d)

@[simp] theorem subtreeFormProduct_branch
    {R ι : Type*} [CommSemiring R] [Algebra ℂ R] [DecidableEq ι]
    (y : ι → R) (t d : ℕ) (lam : ℂ) (left right : BlockTree ι) :
    subtreeFormProduct y t d lam (.branch left right) =
      subtreeFormProduct y t d lam left *
        subtreeFormProduct y t d lam right *
          ((∑ i ∈ left.leaves, y i) ^ d +
            algebraMap ℂ R lam * (∑ i ∈ right.leaves, y i) ^ d) := rfl

noncomputable def subtreeLinearFormProduct
    {R ι : Type*} [CommRing R] [Algebra ℂ R] [DecidableEq ι]
    (y : ι → R) (t d : ℕ) (ζ : ℂ) : BlockTree ι → R
  | .leaf i => y i ^ (t - d)
  | .branch left right =>
      subtreeLinearFormProduct y t d ζ left *
        subtreeLinearFormProduct y t d ζ right *
          ∏ j ∈ Finset.range d,
            ((∑ i ∈ left.leaves, y i) +
              algebraMap ℂ R (2 * ζ ^ j) *
                (∑ i ∈ right.leaves, y i))

theorem subtreeLinearFormProduct_eq_subtreeFormProduct
    {R ι : Type*} [CommRing R] [Algebra ℂ R] [DecidableEq ι]
    (y : ι → R) (t d : ℕ) (hd : 0 < d) {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ d) (tree : BlockTree ι) :
    subtreeLinearFormProduct y t d ζ tree =
      subtreeFormProduct y t d
        (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) tree := by
  induction tree with
  | leaf i => rfl
  | branch left right ih_left ih_right =>
      simp only [subtreeLinearFormProduct, subtreeFormProduct]
      rw [ih_left, ih_right,
        rootOfUnity_node_product_source_algebra hd hζ]

theorem subtree_topProduct_union_erase_left
    {R ι : Type*} [CommSemiring R] [DecidableEq ι]
    (left right : Finset ι) (hdisj : Disjoint left right)
    (y : ι → R) (t : ℕ) {i : ι} (hi : i ∈ left) :
    (∏ j ∈ (left ∪ right).erase i, y j ^ t) =
      (∏ j ∈ left.erase i, y j ^ t) *
        ∏ j ∈ right, y j ^ t := by
  have hnot : i ∉ right := fun h => (Finset.disjoint_left.mp hdisj) hi h
  have hdisj' : Disjoint (left.erase i) right :=
    Finset.disjoint_of_subset_left (Finset.erase_subset i left) hdisj
  rw [Finset.erase_union_distrib, Finset.erase_eq_self.mpr hnot]
  exact Finset.prod_union hdisj'

theorem subtree_topProduct_union_erase_right
    {R ι : Type*} [CommSemiring R] [DecidableEq ι]
    (left right : Finset ι) (hdisj : Disjoint left right)
    (y : ι → R) (t : ℕ) {i : ι} (hi : i ∈ right) :
    (∏ j ∈ (left ∪ right).erase i, y j ^ t) =
      (∏ j ∈ left, y j ^ t) *
        ∏ j ∈ right.erase i, y j ^ t := by
  have hnot : i ∉ left := fun h => (Finset.disjoint_left.mp hdisj) h hi
  have hdisj' : Disjoint left (right.erase i) :=
    Finset.disjoint_of_subset_right (Finset.erase_subset i right) hdisj
  rw [Finset.erase_union_distrib, Finset.erase_eq_self.mpr hnot]
  exact Finset.prod_union hdisj'

theorem subtreeFormProduct_eq_expansion
    {R ι : Type*} [CommSemiring R] [Algebra ℂ R] [DecidableEq ι]
    (y : ι → R) (t d : ℕ) (hd : d ≤ t) (lam : ℂ)
    (tree : BlockTree ι) (hnodup : tree.leafList.Nodup)
    (hnil : ∀ i ∈ tree.leaves, y i ^ (t + 1) = 0) :
    subtreeFormProduct y t d lam tree =
      ∑ i ∈ tree.leaves,
        algebraMap ℂ R (subtreeCoefficient lam tree i) *
          (y i ^ (t - d) * ∏ j ∈ tree.leaves.erase i, y j ^ t) := by
  induction tree with
  | leaf i =>
      simp only [subtreeFormProduct, BlockTree.leaves, subtreeCoefficient, MonoidWithZeroHom.map_ite_one_zero,
        ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_singleton, ↓reduceIte, Finset.erase_singleton,
        Finset.prod_empty, mul_one]
  | branch left right ih_left ih_right =>
      have hparts := List.nodup_append.mp hnodup
      have hdisj := BlockTree.disjoint_leaves_of_nodup hnodup
      have hnil_left : ∀ i ∈ left.leaves, y i ^ (t + 1) = 0 := by
        intro i hi
        exact hnil i (Finset.mem_union_left _ hi)
      have hnil_right : ∀ i ∈ right.leaves, y i ^ (t + 1) = 0 := by
        intro i hi
        exact hnil i (Finset.mem_union_right _ hi)
      have hleft_expansion := ih_left hparts.1 hnil_left
      have hright_expansion := ih_right hparts.2.1 hnil_right
      have hleft_fill :
          (∑ i ∈ left.leaves,
            algebraMap ℂ R (subtreeCoefficient lam left i) *
              (y i ^ (t - d) * ∏ j ∈ left.leaves.erase i, y j ^ t)) *
              (∑ j ∈ left.leaves, y j) ^ d =
            algebraMap ℂ R (subtreeCoefficientTotal lam left) *
              ∏ j ∈ left.leaves, y j ^ t := by
        simpa only [subtreeCoefficientTotal, map_sum] using
          subtree_weighted_sum_mul_block_sum_pow left.leaves y (fun i => algebraMap ℂ R (subtreeCoefficient lam left i)) t d
            hd hnil_left
      have hright_fill :
          (∑ i ∈ right.leaves,
            algebraMap ℂ R (subtreeCoefficient lam right i) *
              (y i ^ (t - d) * ∏ j ∈ right.leaves.erase i, y j ^ t)) *
              (∑ j ∈ right.leaves, y j) ^ d =
            algebraMap ℂ R (subtreeCoefficientTotal lam right) *
              ∏ j ∈ right.leaves, y j ^ t := by
        simpa only [subtreeCoefficientTotal, map_sum] using
          subtree_weighted_sum_mul_block_sum_pow right.leaves y (fun i => algebraMap ℂ R (subtreeCoefficient lam right i)) t d
            hd hnil_right
      have hsum_left :
          (∑ i ∈ left.leaves,
            algebraMap ℂ R
              (subtreeCoefficient lam (.branch left right) i) *
              (y i ^ (t - d) *
                ∏ j ∈ (left.leaves ∪ right.leaves).erase i, y j ^ t)) =
            (algebraMap ℂ R lam *
              algebraMap ℂ R (subtreeCoefficientTotal lam right) *
              (∏ j ∈ right.leaves, y j ^ t)) *
              (∑ i ∈ left.leaves,
                algebraMap ℂ R (subtreeCoefficient lam left i) *
                  (y i ^ (t - d) *
                    ∏ j ∈ left.leaves.erase i, y j ^ t)) := by
        calc
          (∑ i ∈ left.leaves,
            algebraMap ℂ R
              (subtreeCoefficient lam (.branch left right) i) *
              (y i ^ (t - d) *
                ∏ j ∈ (left.leaves ∪ right.leaves).erase i, y j ^ t)) =
              ∑ i ∈ left.leaves,
                (algebraMap ℂ R lam *
                  algebraMap ℂ R (subtreeCoefficientTotal lam right) *
                  (∏ j ∈ right.leaves, y j ^ t)) *
                  (algebraMap ℂ R (subtreeCoefficient lam left i) *
                    (y i ^ (t - d) *
                      ∏ j ∈ left.leaves.erase i, y j ^ t)) := by
                  apply Finset.sum_congr rfl
                  intro i hi
                  rw [subtreeCoefficient_branch_left lam hdisj hi,
                    subtree_topProduct_union_erase_left
                      left.leaves right.leaves hdisj y t hi]
                  simp only [map_mul]
                  ring
          _ = _ := by rw [Finset.mul_sum]
      have hsum_right :
          (∑ i ∈ right.leaves,
            algebraMap ℂ R
              (subtreeCoefficient lam (.branch left right) i) *
              (y i ^ (t - d) *
                ∏ j ∈ (left.leaves ∪ right.leaves).erase i, y j ^ t)) =
            (algebraMap ℂ R (subtreeCoefficientTotal lam left) *
              (∏ j ∈ left.leaves, y j ^ t)) *
              (∑ i ∈ right.leaves,
                algebraMap ℂ R (subtreeCoefficient lam right i) *
                  (y i ^ (t - d) *
                    ∏ j ∈ right.leaves.erase i, y j ^ t)) := by
        calc
          (∑ i ∈ right.leaves,
            algebraMap ℂ R
              (subtreeCoefficient lam (.branch left right) i) *
              (y i ^ (t - d) *
                ∏ j ∈ (left.leaves ∪ right.leaves).erase i, y j ^ t)) =
              ∑ i ∈ right.leaves,
                (algebraMap ℂ R (subtreeCoefficientTotal lam left) *
                  (∏ j ∈ left.leaves, y j ^ t)) *
                  (algebraMap ℂ R (subtreeCoefficient lam right i) *
                    (y i ^ (t - d) *
                      ∏ j ∈ right.leaves.erase i, y j ^ t)) := by
                  apply Finset.sum_congr rfl
                  intro i hi
                  rw [subtreeCoefficient_branch_right lam hdisj hi,
                    subtree_topProduct_union_erase_right
                      left.leaves right.leaves hdisj y t hi]
                  simp only [map_mul]
                  ring
          _ = _ := by rw [Finset.mul_sum]
      calc
        subtreeFormProduct y t d lam (.branch left right) =
            (∑ i ∈ left.leaves,
              algebraMap ℂ R (subtreeCoefficient lam left i) *
                (y i ^ (t - d) * ∏ j ∈ left.leaves.erase i, y j ^ t)) *
            (∑ i ∈ right.leaves,
              algebraMap ℂ R (subtreeCoefficient lam right i) *
                (y i ^ (t - d) * ∏ j ∈ right.leaves.erase i, y j ^ t)) *
              ((∑ i ∈ left.leaves, y i) ^ d +
                algebraMap ℂ R lam *
                  (∑ i ∈ right.leaves, y i) ^ d) := by
                    rw [subtreeFormProduct_branch,
                      hleft_expansion, hright_expansion]
        _ =
            ((∑ i ∈ left.leaves,
              algebraMap ℂ R (subtreeCoefficient lam left i) *
                (y i ^ (t - d) * ∏ j ∈ left.leaves.erase i, y j ^ t)) *
              (∑ i ∈ left.leaves, y i) ^ d) *
              (∑ i ∈ right.leaves,
                algebraMap ℂ R (subtreeCoefficient lam right i) *
                  (y i ^ (t - d) * ∏ j ∈ right.leaves.erase i, y j ^ t)) +
            algebraMap ℂ R lam *
              (∑ i ∈ left.leaves,
                algebraMap ℂ R (subtreeCoefficient lam left i) *
                  (y i ^ (t - d) * ∏ j ∈ left.leaves.erase i, y j ^ t)) *
              ((∑ i ∈ right.leaves,
                algebraMap ℂ R (subtreeCoefficient lam right i) *
                  (y i ^ (t - d) * ∏ j ∈ right.leaves.erase i, y j ^ t)) *
                (∑ i ∈ right.leaves, y i) ^ d) := by ring
        _ =
            (algebraMap ℂ R (subtreeCoefficientTotal lam left) *
              (∏ j ∈ left.leaves, y j ^ t)) *
              (∑ i ∈ right.leaves,
                algebraMap ℂ R (subtreeCoefficient lam right i) *
                  (y i ^ (t - d) * ∏ j ∈ right.leaves.erase i, y j ^ t)) +
            algebraMap ℂ R lam *
              (∑ i ∈ left.leaves,
                algebraMap ℂ R (subtreeCoefficient lam left i) *
                  (y i ^ (t - d) * ∏ j ∈ left.leaves.erase i, y j ^ t)) *
              (algebraMap ℂ R (subtreeCoefficientTotal lam right) *
                ∏ j ∈ right.leaves, y j ^ t) := by
                  rw [hleft_fill, hright_fill]
        _ =
            (∑ i ∈ left.leaves,
              algebraMap ℂ R
                (subtreeCoefficient lam (.branch left right) i) *
                (y i ^ (t - d) *
                  ∏ j ∈ (left.leaves ∪ right.leaves).erase i, y j ^ t)) +
            (∑ i ∈ right.leaves,
              algebraMap ℂ R
                (subtreeCoefficient lam (.branch left right) i) *
                (y i ^ (t - d) *
                  ∏ j ∈ (left.leaves ∪ right.leaves).erase i, y j ^ t)) := by
                    rw [hsum_left, hsum_right]
                    ring
        _ =
            ∑ i ∈ (left.leaves ∪ right.leaves),
              algebraMap ℂ R
                (subtreeCoefficient lam (.branch left right) i) *
                (y i ^ (t - d) *
                  ∏ j ∈ (left.leaves ∪ right.leaves).erase i, y j ^ t) :=
                    (Finset.sum_union hdisj).symm

theorem subtreeLinearFormProduct_eq_expansion
    {R ι : Type*} [CommRing R] [Algebra ℂ R] [DecidableEq ι]
    (y : ι → R) (t d : ℕ) (hdpos : 0 < d) (hd : d ≤ t)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ d)
    (tree : BlockTree ι) (hnodup : tree.leafList.Nodup)
    (hnil : ∀ i ∈ tree.leaves, y i ^ (t + 1) = 0) :
    subtreeLinearFormProduct y t d ζ tree =
      ∑ i ∈ tree.leaves,
        algebraMap ℂ R
            (subtreeCoefficient
              (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) tree i) *
          (y i ^ (t - d) * ∏ j ∈ tree.leaves.erase i, y j ^ t) := by
  rw [subtreeLinearFormProduct_eq_subtreeFormProduct
    y t d hdpos hζ tree]
  exact subtreeFormProduct_eq_expansion y t d hd
    (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) tree hnodup hnil

theorem squareZero_subtreeLinearFormProduct_eq_expansion
    {ι : Type*} [DecidableEq ι] (r : ℕ)
    (blocks : ι → Finset (Fin r)) (tree : BlockTree ι)
    (t d : ℕ) (hdpos : 0 < d) (hd : d ≤ t)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ d)
    (hnodup : tree.leafList.Nodup)
    (hcard : ∀ i ∈ tree.leaves, (blocks i).card = t) :
    subtreeLinearFormProduct
        (fun i => squareZeroBlockSum r (blocks i)) t d ζ tree =
      ∑ i ∈ tree.leaves,
        algebraMap ℂ (SquareZeroAlgebra r)
            (subtreeCoefficient
              (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) tree i) *
          (squareZeroBlockSum r (blocks i) ^ (t - d) *
            ∏ j ∈ tree.leaves.erase i,
              squareZeroBlockSum r (blocks j) ^ t) := by
  apply subtreeLinearFormProduct_eq_expansion
    (fun i => squareZeroBlockSum r (blocks i)) t d hdpos hd hζ tree hnodup
  intro i hi
  simpa only [hcard i hi] using squareZeroBlockSum_pow_card_succ r (blocks i)

end Standalone_Subtree

section Standalone_Coefficients

open scoped BigOperators

noncomputable def squareFreeExponent {ι : Type*} (rows : Finset ι) : ι →₀ ℕ :=
  Finsupp.indicator rows (fun _ _ => 1)

@[simp] theorem squareFreeExponent_apply {ι : Type*} [DecidableEq ι]
    (rows : Finset ι) (i : ι) :
    squareFreeExponent rows i = if i ∈ rows then 1 else 0 := by
  classical
  simp only [squareFreeExponent, Finsupp.indicator_apply, dite_eq_ite]

@[simp] theorem squareFreeExponent_support {ι : Type*} (rows : Finset ι) :
    (squareFreeExponent rows).support = rows := by
  classical
  ext i
  simp only [Finsupp.mem_support_iff, squareFreeExponent_apply, ne_eq, ite_eq_right_iff, one_ne_zero, imp_false,
    Decidable.not_not]

theorem eq_squareFreeExponent_support_of_le {ι : Type*}
    (rows : Finset ι) (exponent : ι →₀ ℕ)
    (hle : exponent ≤ squareFreeExponent rows) :
    exponent = squareFreeExponent exponent.support := by
  classical
  ext i
  by_cases hi : exponent i = 0
  · simp only [hi, squareFreeExponent_apply, Finsupp.mem_support_iff, ne_eq, not_true_eq_false, ↓reduceIte]
  · have hpos : 1 ≤ exponent i := Nat.one_le_iff_ne_zero.mpr hi
    have hupper : exponent i ≤ squareFreeExponent rows i := hle i
    have hbound : squareFreeExponent rows i ≤ 1 := by
      rw [squareFreeExponent_apply]
      split <;> omega
    have hone : exponent i = 1 := by omega
    simp only [hone, squareFreeExponent_apply, Finsupp.mem_support_iff, ne_eq, one_ne_zero, not_false_eq_true,
      ↓reduceIte]

noncomputable def squareFreeMonomial {ι : Type*}
    (rows : Finset ι) : MvPolynomial ι ℂ :=
  ∏ i ∈ rows, MvPolynomial.X i

theorem squareFreeMonomial_eq_monomial {ι : Type*} (rows : Finset ι) :
    squareFreeMonomial rows =
      MvPolynomial.monomial (squareFreeExponent rows) (1 : ℂ) := by
  classical
  simpa only [squareFreeMonomial, squareFreeExponent, pow_one] using
    (MvPolynomial.prod_X_pow (R := ℂ) (fun _ : ι => 1) rows)

theorem coeff_squareFree_variable_sq_mul {ι : Type*}
    (rows : Finset ι) (i : ι) (p : MvPolynomial ι ℂ) :
    MvPolynomial.coeff (squareFreeExponent rows)
      ((MvPolynomial.X i) ^ 2 * p) = 0 := by
  classical
  rw [MvPolynomial.X_pow_eq_monomial,
    MvPolynomial.coeff_monomial_mul']
  split_ifs with h
  · have hi : 2 ≤ squareFreeExponent rows i :=
      Finsupp.single_le_iff.mp h
    have hbound : squareFreeExponent rows i ≤ 1 := by
      rw [squareFreeExponent_apply]
      split <;> omega
    omega
  · rfl

theorem coeff_squareFree_mul_of_forall_eq_zero {ι : Type*}
    (p q : MvPolynomial ι ℂ)
    (hp : ∀ rows : Finset ι,
      MvPolynomial.coeff (squareFreeExponent rows) p = 0)
    (rows : Finset ι) :
    MvPolynomial.coeff (squareFreeExponent rows) (q * p) = 0 := by
  classical
  rw [MvPolynomial.coeff_mul]
  apply Finset.sum_eq_zero
  intro decomposition hdecomposition
  have hsum : decomposition.1 + decomposition.2 = squareFreeExponent rows :=
    Finset.HasAntidiagonal.mem_antidiagonal.mp hdecomposition
  have hle : decomposition.2 ≤ squareFreeExponent rows := by
    rw [← hsum]
    exact le_add_left le_rfl
  have hsquare := eq_squareFreeExponent_support_of_le
    rows decomposition.2 hle
  rw [hsquare, hp decomposition.2.support, mul_zero]

theorem coeff_squareFree_eq_zero_of_mem_squareZeroIdeal
    (r : ℕ) {p : MvPolynomial (Fin r) ℂ}
    (hp : p ∈ squareZeroIdeal r) (rows : Finset (Fin r)) :
    MvPolynomial.coeff (squareFreeExponent rows) p = 0 := by
  change p ∈ Ideal.span
    (Set.range fun i : Fin r => (MvPolynomial.X i) ^ 2) at hp
  have hall : ∀ target : Finset (Fin r),
      MvPolynomial.coeff (squareFreeExponent target) p = 0 := by
    induction hp using Submodule.span_induction with
    | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        intro target
        simpa only [mul_one] using coeff_squareFree_variable_sq_mul target i (1 : MvPolynomial (Fin r) ℂ)
    | zero =>
        intro target
        simp only [MvPolynomial.coeff_zero]
    | add x y hx hy ihx ihy =>
        intro target
        rw [MvPolynomial.coeff_add, ihx target, ihy target, add_zero]
    | smul a x hx ih =>
        intro target
        simpa only [smul_eq_mul] using
          coeff_squareFree_mul_of_forall_eq_zero x a ih target
  exact hall rows

noncomputable def squareZeroCoefficient (r : ℕ) (rows : Finset (Fin r)) :
    SquareZeroAlgebra r →ₗ[ℂ] ℂ := by
  let I : Submodule ℂ (MvPolynomial (Fin r) ℂ) :=
    (squareZeroIdeal r).restrictScalars ℂ
  let coefficient : MvPolynomial (Fin r) ℂ →ₗ[ℂ] ℂ :=
    MvPolynomial.lcoeff ℂ (squareFreeExponent rows)
  have hkernel : I ≤ LinearMap.ker coefficient := by
    intro p hp
    change MvPolynomial.coeff (squareFreeExponent rows) p = 0
    exact coeff_squareFree_eq_zero_of_mem_squareZeroIdeal r hp rows
  exact (I.liftQ coefficient hkernel).comp
    (Submodule.Quotient.restrictScalarsEquiv ℂ
      (squareZeroIdeal r)).symm.toLinearMap

@[simp] theorem squareZeroCoefficient_mk (r : ℕ)
    (rows : Finset (Fin r)) (p : MvPolynomial (Fin r) ℂ) :
    squareZeroCoefficient r rows (Ideal.Quotient.mk (squareZeroIdeal r) p) =
      MvPolynomial.coeff (squareFreeExponent rows) p := by
  rfl

theorem squareFreeMonomial_quotient_eq_variable_product
    (r : ℕ) (rows : Finset (Fin r)) :
    Ideal.Quotient.mk (squareZeroIdeal r) (squareFreeMonomial rows) =
      ∏ i ∈ rows, squareZeroVariable r i := by
  simp only [squareFreeMonomial, map_prod, squareZeroVariable]

noncomputable def columnLinearForm {r k : ℕ}
    (U : Matrix (Fin r) (Fin k) ℂ) (column : Fin k) :
    MvPolynomial (Fin r) ℂ :=
  ∑ row : Fin r, MvPolynomial.C (U row column) * MvPolynomial.X row

noncomputable def columnLinearFormProduct {r k : ℕ}
    (U : Matrix (Fin r) (Fin k) ℂ) : MvPolynomial (Fin r) ℂ :=
  ∏ column : Fin k, columnLinearForm U column

noncomputable def columnAssignmentExponent {r k : ℕ}
    (assignment : Fin k → Fin r) : Fin r →₀ ℕ :=
  ∑ column : Fin k, Finsupp.single (assignment column) 1

theorem columnAssignmentExponent_apply {r k : ℕ}
    (assignment : Fin k → Fin r) (row : Fin r) :
    columnAssignmentExponent assignment row =
      ((Finset.univ : Finset (Fin k)).filter
        (fun column => assignment column = row)).card := by
  classical
  simp only [columnAssignmentExponent, Finsupp.coe_finsetSum, Finset.sum_apply, Finsupp.single_apply,
    Finset.sum_boole, Nat.cast_id]

@[simp] theorem columnAssignmentExponent_support {r k : ℕ}
    (assignment : Fin k → Fin r) :
    (columnAssignmentExponent assignment).support =
      (Finset.univ : Finset (Fin k)).image assignment := by
  classical
  ext row
  simp only [Finsupp.mem_support_iff, columnAssignmentExponent_apply, ne_eq, Finset.card_eq_zero,
    Finset.filter_eq_empty_iff, Finset.mem_univ, forall_const, not_forall, Decidable.not_not, Finset.mem_image,
    true_and]

theorem columnAssignment_injective_of_squareFree {r k : ℕ}
    (assignment : Fin k → Fin r) (rows : Finset (Fin r))
    (hassignment : columnAssignmentExponent assignment =
      squareFreeExponent rows) :
    Function.Injective assignment := by
  classical
  intro left right heq
  let fiber : Finset (Fin k) :=
    (Finset.univ : Finset (Fin k)).filter
      (fun column => assignment column = assignment left)
  have hcard : fiber.card ≤ 1 := by
    change ((Finset.univ : Finset (Fin k)).filter
      (fun column => assignment column = assignment left)).card ≤ 1
    rw [← columnAssignmentExponent_apply, hassignment,
      squareFreeExponent_apply]
    split <;> omega
  exact (Finset.card_le_one.mp hcard)
    left (by simp only [Finset.mem_filter, Finset.mem_univ, and_self, fiber]) right (by simp only [heq, Finset.mem_filter, Finset.mem_univ, and_self, fiber])

theorem columnAssignment_image_eq_of_squareFree {r k : ℕ}
    (assignment : Fin k → Fin r) (rows : Finset (Fin r))
    (hassignment : columnAssignmentExponent assignment =
      squareFreeExponent rows) :
    (Finset.univ : Finset (Fin k)).image assignment = rows := by
  have hs := congrArg Finsupp.support hassignment
  simpa only [columnAssignmentExponent_support,
    squareFreeExponent_support] using hs

theorem columnAssignment_product_eq_monomial {r k : ℕ}
    (U : Matrix (Fin r) (Fin k) ℂ) (assignment : Fin k → Fin r) :
    (∏ column : Fin k,
      MvPolynomial.C (U (assignment column) column) *
        MvPolynomial.X (assignment column)) =
      MvPolynomial.monomial (columnAssignmentExponent assignment)
        (∏ column : Fin k, U (assignment column) column) := by
  classical
  simpa only [MvPolynomial.C_mul_X_eq_monomial, columnAssignmentExponent] using
    (MvPolynomial.monomial_sum_prod (R := ℂ) (Finset.univ : Finset (Fin k))
        (fun column => Finsupp.single (assignment column) 1) (fun column => U (assignment column) column)).symm

theorem coeff_columnLinearFormProduct_eq_assignment_sum {r k : ℕ}
    (U : Matrix (Fin r) (Fin k) ℂ) (rows : Finset (Fin r)) :
    MvPolynomial.coeff (squareFreeExponent rows)
      (columnLinearFormProduct U) =
        ∑ assignment : Fin k → Fin r,
          if columnAssignmentExponent assignment = squareFreeExponent rows
          then ∏ column : Fin k, U (assignment column) column
          else 0 := by
  classical
  unfold columnLinearFormProduct columnLinearForm
  rw [Fintype.prod_sum]
  change (MvPolynomial.coeffAddMonoidHom (squareFreeExponent rows))
    (∑ assignment : Fin k → Fin r,
      ∏ column : Fin k,
        MvPolynomial.C (U (assignment column) column) *
          MvPolynomial.X (assignment column)) = _
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro assignment _
  rw [columnAssignment_product_eq_monomial]
  change MvPolynomial.coeff (squareFreeExponent rows)
    (MvPolynomial.monomial (columnAssignmentExponent assignment)
      (∏ column : Fin k, U (assignment column) column)) = _
  rw [MvPolynomial.coeff_monomial]

theorem columnAssignmentExponent_equiv_apply {r k : ℕ}
    (rows : Finset (Fin r)) (rowEquiv : Fin k ≃ {row // row ∈ rows})
    (permutation : Equiv.Perm (Fin k)) :
    columnAssignmentExponent
      (fun column => (rowEquiv (permutation column)).val) =
        squareFreeExponent rows := by
  classical
  ext row
  rw [columnAssignmentExponent_apply, squareFreeExponent_apply]
  by_cases hrow : row ∈ rows
  · have hfiber :
        ((Finset.univ : Finset (Fin k)).filter
          (fun column => (rowEquiv (permutation column)).val = row)) =
            {permutation.symm (rowEquiv.symm ⟨row, hrow⟩)} := by
      ext column
      simp only [Finset.mem_filter, Finset.mem_univ, true_and,
        Finset.mem_singleton]
      constructor
      · intro hcolumn
        have hsubtype : rowEquiv (permutation column) =
            (⟨row, hrow⟩ : {row // row ∈ rows}) :=
          Subtype.ext hcolumn
        calc
          column = permutation.symm (permutation column) :=
            (permutation.symm_apply_apply column).symm
          _ = permutation.symm (rowEquiv.symm ⟨row, hrow⟩) := by
            simpa only [Equiv.symm_apply_apply] using
              congrArg (fun selected : { row // row ∈ rows } => permutation.symm (rowEquiv.symm selected)) hsubtype
      · intro hcolumn
        subst column
        simp only [Equiv.apply_symm_apply]
    simp only [hfiber, Finset.card_singleton, hrow, ↓reduceIte]
  · have hfiber :
        ((Finset.univ : Finset (Fin k)).filter
          (fun column => (rowEquiv (permutation column)).val = row)) = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro column hcolumn
      have hvalue := (Finset.mem_filter.mp hcolumn).2
      apply hrow
      rw [← hvalue]
      exact (rowEquiv (permutation column)).property
    simp only [hfiber, Finset.card_empty, hrow, ↓reduceIte]

noncomputable def squareFreeColumnMatchingPermutation {r k : ℕ}
    (rows : Finset (Fin r)) (rowEquiv : Fin k ≃ {row // row ∈ rows})
    (assignment : Fin k → Fin r)
    (hassignment : columnAssignmentExponent assignment =
      squareFreeExponent rows) : Equiv.Perm (Fin k) :=
  Equiv.ofBijective
    (fun column => rowEquiv.symm
      ⟨assignment column, by
        rw [← columnAssignment_image_eq_of_squareFree assignment rows
          hassignment]
        exact Finset.mem_image.mpr
          ⟨column, Finset.mem_univ column, rfl⟩⟩)
    (by
      apply (Fintype.bijective_iff_injective_and_card _).mpr
      constructor
      · intro left right hmatch
        apply columnAssignment_injective_of_squareFree
          assignment rows hassignment
        have hrows := congrArg rowEquiv hmatch
        simpa only [Equiv.apply_symm_apply] using congrArg Subtype.val hrows
      · rfl)

@[simp] theorem squareFreeColumnMatchingPermutation_apply {r k : ℕ}
    (rows : Finset (Fin r)) (rowEquiv : Fin k ≃ {row // row ∈ rows})
    (assignment : Fin k → Fin r)
    (hassignment : columnAssignmentExponent assignment =
      squareFreeExponent rows) (column : Fin k) :
    (rowEquiv
      (squareFreeColumnMatchingPermutation rows rowEquiv assignment
        hassignment column)).val = assignment column := by
  simp only [squareFreeColumnMatchingPermutation, Equiv.ofBijective_apply, Equiv.apply_symm_apply]

theorem coeff_columnLinearFormProduct_eq_permanent {r k : ℕ}
    (U : Matrix (Fin r) (Fin k) ℂ) (rows : Finset (Fin r))
    (rowEquiv : Fin k ≃ {row // row ∈ rows}) :
    MvPolynomial.coeff (squareFreeExponent rows)
      (columnLinearFormProduct U) =
        Matrix.permanent
          (fun i j : Fin k => U (rowEquiv i).val j) := by
  classical
  rw [coeff_columnLinearFormProduct_eq_assignment_sum]
  unfold Matrix.permanent
  rw [← Finset.sum_filter]
  refine Finset.sum_bij
    (fun assignment hassignment =>
      squareFreeColumnMatchingPermutation rows rowEquiv assignment
        (Finset.mem_filter.mp hassignment).2)
    (fun _ _ => Finset.mem_univ _) ?_ ?_ ?_
  · intro left hleft right hright hmatch
    funext column
    have hvalues := congrArg
      (fun permutation : Equiv.Perm (Fin k) =>
        (rowEquiv (permutation column)).val) hmatch
    simpa only [squareFreeColumnMatchingPermutation_apply] using hvalues
  · intro permutation _
    let assignment : Fin k → Fin r :=
      fun column => (rowEquiv (permutation column)).val
    have hassignment : columnAssignmentExponent assignment =
        squareFreeExponent rows :=
      columnAssignmentExponent_equiv_apply rows rowEquiv permutation
    refine ⟨assignment,
      Finset.mem_filter.mpr ⟨Finset.mem_univ assignment, hassignment⟩, ?_⟩
    apply Equiv.ext
    intro column
    apply rowEquiv.injective
    apply Subtype.ext
    simpa only [squareFreeColumnMatchingPermutation_apply] using
      (show assignment column =
        (rowEquiv (permutation column)).val from rfl)
  · intro assignment hassignment
    apply Finset.prod_congr rfl
    intro column _
    change U (assignment column) column =
      U (rowEquiv
        (squareFreeColumnMatchingPermutation rows rowEquiv assignment
          (Finset.mem_filter.mp hassignment).2 column)).val column
    rw [squareFreeColumnMatchingPermutation_apply]

end Standalone_Coefficients

section Standalone_Partition

open scoped BigOperators

noncomputable def partitionMobius {t : ℕ} {rows : Finset (Fin t)}
    (partition : Finpartition rows) : ℂ :=
  ∏ block ∈ partition.parts,
    (-1 : ℂ) ^ (block.card - 1) * (block.card - 1).factorial

noncomputable def partitionBlockFactor {t : ℕ} {rows : Finset (Fin t)}
    (p : Finset (Fin t) → ℂ) (partition : Finpartition rows) :
    MvPolynomial (Fin t) ℂ :=
  ∏ block ∈ partition.parts,
    (MvPolynomial.C (p block) - ∏ row ∈ block, MvPolynomial.X row)

noncomputable def partitionDerivative (t d : ℕ) (i : Fin t)
    (p : Finset (Fin t) → ℂ) : MvPolynomial (Fin t) ℂ :=
  ∑ rows ∈ ((Finset.univ : Finset (Fin t)).erase i).powersetCard (d - 1),
    ∑ partition : Finpartition rows,
      MvPolynomial.C (partitionMobius partition) * partitionBlockFactor p partition

theorem partitionMobius_mul_neg_one_pow {t : ℕ} {rows : Finset (Fin t)}
    (partition : Finpartition rows) :
    partitionMobius partition * (-1 : ℂ) ^ partition.parts.card =
      (-1 : ℂ) ^ rows.card *
        ∏ block ∈ partition.parts, ((block.card - 1).factorial : ℂ) := by
  classical
  calc
    partitionMobius partition * (-1 : ℂ) ^ partition.parts.card =
        (∏ block ∈ partition.parts,
          (-1 : ℂ) ^ (block.card - 1) * ((block.card - 1).factorial : ℂ)) *
          ∏ _block ∈ partition.parts, (-1 : ℂ) := by
      simp only [partitionMobius, Finset.prod_const]
    _ = ∏ block ∈ partition.parts,
          ((-1 : ℂ) ^ (block.card - 1) * ((block.card - 1).factorial : ℂ)) * -1 :=
      Finset.prod_mul_distrib.symm
    _ = ∏ block ∈ partition.parts,
          (-1 : ℂ) ^ block.card * ((block.card - 1).factorial : ℂ) := by
      apply Finset.prod_congr rfl
      intro block hblock
      have hcard : 0 < block.card :=
        Finset.card_pos.mpr (partition.nonempty_of_mem_parts hblock)
      have hsucc : block.card - 1 + 1 = block.card :=
        Nat.sub_add_cancel hcard
      have hpow : (-1 : ℂ) ^ block.card = (-1 : ℂ) ^ (block.card - 1) * -1 := by
        conv_lhs => rw [← hsucc, pow_succ]
      rw [hpow]
      ac_rfl
    _ = (-1 : ℂ) ^ (∑ block ∈ partition.parts, block.card) *
          ∏ block ∈ partition.parts, ((block.card - 1).factorial : ℂ) := by
      rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum]
    _ = (-1 : ℂ) ^ rows.card *
          ∏ block ∈ partition.parts, ((block.card - 1).factorial : ℂ) := by
      rw [partition.sum_card_parts]

theorem minorSum_isHomogeneous (t s d : ℕ) :
    (minorSum t s d).IsHomogeneous d := by
  classical
  unfold minorSum
  apply MvPolynomial.IsHomogeneous.sum
  intro rows hrows
  apply MvPolynomial.IsHomogeneous.sum
  intro columns _
  apply MvPolynomial.IsHomogeneous.sum
  intro matching _
  have hcard : rows.card = d := (Finset.mem_powersetCard.mp hrows).2
  convert MvPolynomial.IsHomogeneous.prod Finset.univ
    (fun row : rows =>
      MvPolynomial.X (row.val, (matching row).val) :
        rows → MvPolynomial (Fin t × Fin s) ℂ)
    (fun _ => 1)
    (fun row _ => MvPolynomial.isHomogeneous_X ℂ (row.val, (matching row).val)) using 1
  simp only [Finset.univ_eq_attach, Finset.sum_const, Finset.card_attach, hcard, smul_eq_mul, mul_one]

end Standalone_Partition

section Standalone_PartitionMatching

open scoped BigOperators

noncomputable def sourceMatchingEmbedding
    {t s : ℕ} (rows : Finset (Fin t))
    (data : Σ columns :
      {columns : Finset (Fin s) //
        columns ∈ (Finset.univ : Finset (Fin s)).powersetCard rows.card},
      rows ≃ columns.val) : rows ↪ Fin s :=
  data.2.toEmbedding.trans (Function.Embedding.subtype _)

theorem sourceMatchingEmbedding_bijective
    {t s : ℕ} (rows : Finset (Fin t)) :
    Function.Bijective (sourceMatchingEmbedding (s := s) rows) := by
  classical
  constructor
  · rintro ⟨⟨leftColumns, hleftColumns⟩, leftMatching⟩
      ⟨⟨rightColumns, hrightColumns⟩, rightMatching⟩ heq
    have hcolumns : leftColumns = rightColumns := by
      ext column
      constructor
      · intro hcolumn
        obtain ⟨row, hrow⟩ := leftMatching.surjective ⟨column, hcolumn⟩
        have hpoint := DFunLike.congr_fun heq row
        change (leftMatching row).val = (rightMatching row).val at hpoint
        have hleft : (leftMatching row).val = column :=
          congrArg Subtype.val hrow
        have hright : (rightMatching row).val = column := hpoint.symm.trans hleft
        exact hright ▸ (rightMatching row).property
      · intro hcolumn
        obtain ⟨row, hrow⟩ := rightMatching.surjective ⟨column, hcolumn⟩
        have hpoint := DFunLike.congr_fun heq row
        change (leftMatching row).val = (rightMatching row).val at hpoint
        have hright : (rightMatching row).val = column :=
          congrArg Subtype.val hrow
        have hleft : (leftMatching row).val = column := hpoint.trans hright
        exact hleft ▸ (leftMatching row).property
    subst rightColumns
    have hmatching : leftMatching = rightMatching := by
      apply Equiv.ext
      intro row
      apply Subtype.ext
      have hpoint := DFunLike.congr_fun heq row
      change (leftMatching row).val = (rightMatching row).val at hpoint
      exact hpoint
    subst rightMatching
    rfl
  · intro embedding
    let columns : Finset (Fin s) :=
      (Finset.univ : Finset rows).map embedding
    have hcard :
        columns ∈ (Finset.univ : Finset (Fin s)).powersetCard rows.card := by
      simp only [Finset.univ_eq_attach, Finset.mem_powersetCard, Finset.subset_univ, Finset.card_map,
        Finset.card_attach, and_self, columns]
    let matching : rows ≃ columns := Equiv.ofBijective
      (fun row : rows => (⟨embedding row, by
        simp only [Finset.univ_eq_attach, Finset.mem_map', Finset.mem_attach, columns]⟩ : columns)) (by
        constructor
        · intro left right h
          exact embedding.injective (congrArg Subtype.val h)
        · intro column
          have hmem : column.val ∈ columns := column.property
          simp only [columns, Finset.mem_map, Finset.mem_univ, true_and] at hmem
          obtain ⟨row, hrow⟩ := hmem
          exact ⟨row, Subtype.ext hrow⟩)
    refine ⟨⟨⟨columns, hcard⟩, matching⟩, ?_⟩
    ext row
    rfl

theorem sourceMatching_sum_eq_embeddings
    {t s : ℕ} {R : Type*} [CommSemiring R]
    (rows : Finset (Fin t)) (weight : Fin t → Fin s → R) :
    (∑ columns ∈ (Finset.univ : Finset (Fin s)).powersetCard rows.card,
      ∑ matching : rows ≃ columns,
        ∏ row : rows, weight row.val (matching row).val) =
      ∑ embedding : rows ↪ Fin s,
        ∏ row : rows, weight row.val (embedding row) := by
  classical
  let columnSet :=
    (Finset.univ : Finset (Fin s)).powersetCard rows.card
  let dataType := Σ columns : columnSet, rows ≃ columns.val
  calc
    (∑ columns ∈ (Finset.univ : Finset (Fin s)).powersetCard rows.card,
      ∑ matching : rows ≃ columns,
        ∏ row : rows, weight row.val (matching row).val) =
      ∑ data : dataType,
        ∏ row : rows, weight row.val (data.2 row).val := by
          change
            (∑ columns ∈ columnSet,
              ∑ matching : rows ≃ columns,
                ∏ row : rows, weight row.val (matching row).val) =
              ∑ data : (Σ columns : columnSet, rows ≃ columns.val),
                ∏ row : rows, weight row.val (data.2 row).val
          rw [Fintype.sum_sigma]
          exact (Finset.sum_coe_sort columnSet
            (fun columns => ∑ matching : rows ≃ columns,
              ∏ row : rows, weight row.val (matching row).val)).symm
    _ = ∑ embedding : rows ↪ Fin s,
        ∏ row : rows, weight row.val (embedding row) := by
          exact Fintype.sum_bijective
            (sourceMatchingEmbedding (s := s) rows)
            (sourceMatchingEmbedding_bijective rows)
            _ _ (fun _ => rfl)

theorem minorSum_eq_source_embeddings (t s d : ℕ) :
    minorSum t s d =
      ∑ rows ∈ (Finset.univ : Finset (Fin t)).powersetCard d,
        ∑ embedding : rows ↪ Fin s,
          ∏ row : rows,
            (MvPolynomial.X (row.val, embedding row) :
              MvPolynomial (Fin t × Fin s) ℂ) := by
  classical
  unfold minorSum
  apply Finset.sum_congr rfl
  intro rows hrows
  have hcard : rows.card = d := by
    simpa only [Finset.mem_powersetCard, Finset.subset_univ, true_and] using hrows
  simpa only [Finset.univ_eq_attach, hcard] using
    sourceMatching_sum_eq_embeddings rows
      (fun row column => (MvPolynomial.X (row, column) : MvPolynomial (Fin t × Fin s) ℂ))

noncomputable def sourceFixedEdgeEmbedding
    {t s : ℕ} (rows : Finset (Fin t)) (i : Fin t) (column : Fin s)
    (hrow : i ∈ rows)
    (data : {embedding : rows ↪ Fin s //
      embedding (⟨i, hrow⟩ : rows) = column}) :
    (rows.erase i) ↪ {other : Fin s // other ≠ column} where
  toFun row :=
    ⟨data.val ⟨row.val, Finset.mem_of_mem_erase row.property⟩, by
      intro hcolumn
      have heq :
          data.val ⟨row.val, Finset.mem_of_mem_erase row.property⟩ =
            data.val (⟨i, hrow⟩ : rows) := hcolumn.trans data.property.symm
      have hrows := data.val.injective heq
      exact (Finset.mem_erase.mp row.property).1
        (congrArg (fun r : rows => r.val) hrows)⟩
  inj' := by
    intro left right h
    apply Subtype.ext
    have hvalues :=
      congrArg (fun c : {other : Fin s // other ≠ column} => c.val) h
    have hrows := data.val.injective hvalues
    exact congrArg (fun r : rows => r.val) hrows

theorem sourceFixedEdgeEmbedding_bijective
    {t s : ℕ} (rows : Finset (Fin t)) (i : Fin t) (column : Fin s)
    (hrow : i ∈ rows) :
    Function.Bijective (sourceFixedEdgeEmbedding rows i column hrow) := by
  classical
  constructor
  · intro left right heq
    apply Subtype.ext
    apply DFunLike.ext
    intro row
    by_cases h : row.val = i
    · have hroweq : row = (⟨i, hrow⟩ : rows) := Subtype.ext h
      rw [hroweq, left.property, right.property]
    · let remaining : rows.erase i :=
        ⟨row.val, Finset.mem_erase.mpr ⟨h, row.property⟩⟩
      have hpoint := DFunLike.congr_fun heq remaining
      exact congrArg
        (fun c : {other : Fin s // other ≠ column} => c.val) hpoint
  · intro embedding
    let extend : rows → Fin s := fun row =>
      if h : row.val = i then column
      else (embedding ⟨row.val, Finset.mem_erase.mpr
        ⟨h, row.property⟩⟩).val
    have hinjective : Function.Injective extend := by
      intro left right hvalues
      by_cases hleft : left.val = i
      · by_cases hright : right.val = i
        · exact Subtype.ext (hleft.trans hright.symm)
        · have hnot :=
            (embedding ⟨right.val,
              Finset.mem_erase.mpr ⟨hright, right.property⟩⟩).property
          apply False.elim
          apply hnot
          simpa [extend, hleft, hright] using hvalues.symm
      · by_cases hright : right.val = i
        · have hnot :=
            (embedding ⟨left.val,
              Finset.mem_erase.mpr ⟨hleft, left.property⟩⟩).property
          apply False.elim
          apply hnot
          simpa [extend, hleft, hright] using hvalues
        · have hremaining :
              (embedding ⟨left.val,
                Finset.mem_erase.mpr ⟨hleft, left.property⟩⟩).val =
              (embedding ⟨right.val,
                Finset.mem_erase.mpr ⟨hright, right.property⟩⟩).val := by
              simpa [extend, hleft, hright] using hvalues
          have hembedding := embedding.injective (Subtype.ext hremaining)
          exact Subtype.ext
            (congrArg (fun r : rows.erase i => r.val) hembedding)
    let whole : rows ↪ Fin s := ⟨extend, hinjective⟩
    have hwhole : whole (⟨i, hrow⟩ : rows) = column := by
      simp only [ne_eq, Function.Embedding.coeFn_mk, ↓reduceDIte, whole, extend]
    refine ⟨⟨whole, hwhole⟩, ?_⟩
    apply DFunLike.ext
    intro row
    apply Subtype.ext
    have hnot : row.val ≠ i := (Finset.mem_erase.mp row.property).1
    simp only [ne_eq, sourceFixedEdgeEmbedding, Function.Embedding.coeFn_mk, Subtype.coe_eta, dite_eq_ite, hnot,
      ↓reduceIte, whole, extend]

theorem sourceFixedEdgeEmbedding_prod
    {t s : ℕ} (rows : Finset (Fin t)) (i : Fin t) (column : Fin s)
    (hrow : i ∈ rows) (point : Fin t × Fin s → ℂ)
    (data : {embedding : rows ↪ Fin s //
      embedding (⟨i, hrow⟩ : rows) = column}) :
    (∏ other ∈ (Finset.univ : Finset rows).erase (⟨i, hrow⟩ : rows),
      point (other.val, data.val other)) =
      ∏ other : rows.erase i,
        point (other.val,
          (sourceFixedEdgeEmbedding rows i column hrow data other).val) := by
  classical
  refine Finset.prod_bij
    (fun other hother =>
      (⟨other.val, Finset.mem_erase.mpr
        ⟨by
          intro heq
          apply (Finset.mem_erase.mp hother).1
          exact Subtype.ext heq,
         other.property⟩⟩ : rows.erase i))
    (fun _ _ => Finset.mem_univ _) ?_ ?_ ?_
  · intro left _ right _ heq
    exact Subtype.ext (congrArg
      (fun row : rows.erase i => row.val) heq)
  · intro other _
    let whole : rows :=
      ⟨other.val, Finset.mem_of_mem_erase other.property⟩
    have hne : whole ≠ (⟨i, hrow⟩ : rows) := by
      intro heq
      exact (Finset.mem_erase.mp other.property).1
        (congrArg (fun row : rows => row.val) heq)
    refine ⟨whole, Finset.mem_erase.mpr
      ⟨hne, Finset.mem_univ whole⟩, ?_⟩
    exact Subtype.ext rfl
  · intro other hother
    rfl

theorem sourceFixedEdgeEmbedding_weighted_sum
    {t s : ℕ} (rows : Finset (Fin t)) (i : Fin t) (column : Fin s)
    (hrow : i ∈ rows) (point : Fin t × Fin s → ℂ) :
    (∑ embedding : rows ↪ Fin s,
      if embedding (⟨i, hrow⟩ : rows) = column then
        ∏ other ∈ (Finset.univ : Finset rows).erase (⟨i, hrow⟩ : rows),
          point (other.val, embedding other)
      else 0) =
      ∑ embedding : (rows.erase i) ↪ {other : Fin s // other ≠ column},
        ∏ other : rows.erase i, point (other.val, (embedding other).val) := by
  classical
  let fixed := {embedding : rows ↪ Fin s //
    embedding (⟨i, hrow⟩ : rows) = column}
  calc
    (∑ embedding : rows ↪ Fin s,
      if embedding (⟨i, hrow⟩ : rows) = column then
        ∏ other ∈ (Finset.univ : Finset rows).erase (⟨i, hrow⟩ : rows),
          point (other.val, embedding other)
      else 0) =
      ∑ data : fixed,
        ∏ other ∈ (Finset.univ : Finset rows).erase (⟨i, hrow⟩ : rows),
          point (other.val, data.val other) := by
            change
              (∑ embedding : rows ↪ Fin s,
                if embedding (⟨i, hrow⟩ : rows) = column then
                  ∏ other ∈ (Finset.univ : Finset rows).erase
                    (⟨i, hrow⟩ : rows),
                    point (other.val, embedding other)
                else 0) =
                ∑ data : {embedding : rows ↪ Fin s //
                    embedding (⟨i, hrow⟩ : rows) = column},
                  ∏ other ∈ (Finset.univ : Finset rows).erase
                    (⟨i, hrow⟩ : rows),
                    point (other.val, data.val other)
            rw [← Finset.sum_filter]
            exact Finset.sum_subtype _ (by simp only [Finset.mem_filter, Finset.mem_univ, true_and, implies_true]) _
    _ = ∑ embedding : (rows.erase i) ↪
          {other : Fin s // other ≠ column},
        ∏ other : rows.erase i,
          point (other.val, (embedding other).val) := by
            exact Fintype.sum_bijective
              (sourceFixedEdgeEmbedding rows i column hrow)
              (sourceFixedEdgeEmbedding_bijective rows i column hrow)
              _ _ (sourceFixedEdgeEmbedding_prod rows i column hrow point)

private theorem sourceMatching_pderiv_finset_prod
    {ι σ R : Type*} [DecidableEq ι] [CommSemiring R]
    (coordinate : σ) (indices : Finset ι)
    (f : ι → MvPolynomial σ R) :
    MvPolynomial.pderiv coordinate (∏ index ∈ indices, f index) =
      ∑ index ∈ indices,
        MvPolynomial.pderiv coordinate (f index) *
          ∏ other ∈ indices.erase index, f other := by
  classical
  induction indices using Finset.induction_on with
  | empty => simp only [Finset.prod_empty, Derivation.map_one_eq_zero, Finset.notMem_empty, not_false_eq_true,
               Finset.erase_eq_of_notMem, mul_one, Finset.sum_empty]
  | @insert index indices hnot ih =>
    rw [Finset.prod_insert hnot, MvPolynomial.pderiv_mul, ih,
      Finset.sum_insert hnot, Finset.mul_sum,
      Finset.erase_insert hnot]
    apply congrArg (fun value : MvPolynomial σ R =>
      MvPolynomial.pderiv coordinate (f index) *
        (∏ other ∈ indices, f other) + value)
    apply Finset.sum_congr rfl
    intro other hother
    have hne : index ≠ other := fun heq => hnot (heq ▸ hother)
    rw [Finset.erase_insert_of_ne hne,
      Finset.prod_insert (fun h => hnot (Finset.mem_of_mem_erase h))]
    ac_rfl

theorem eval_minorSum_pderiv_source_embeddings
    (t s d : ℕ) (point : Fin t × Fin s → ℂ)
    (i : Fin t) (column : Fin s) :
    MvPolynomial.eval point
        (MvPolynomial.pderiv (i, column) (minorSum t s d)) =
      ∑ rows ∈ (Finset.univ : Finset (Fin t)).powersetCard d,
        ∑ embedding : rows ↪ Fin s,
          ∑ row : rows,
            if (row.val, embedding row) = (i, column) then
              ∏ other ∈ (Finset.univ : Finset rows).erase row,
                point (other.val, embedding other)
            else 0 := by
  classical
  rw [minorSum_eq_source_embeddings]
  simp only [map_sum]
  apply Finset.sum_congr rfl
  intro rows _
  apply Finset.sum_congr rfl
  intro embedding _
  rw [sourceMatching_pderiv_finset_prod (i, column)
    (Finset.univ : Finset rows)
    (fun row : rows =>
      (MvPolynomial.X (row.val, embedding row) :
        MvPolynomial (Fin t × Fin s) ℂ))]
  simp only [map_sum]
  apply Finset.sum_congr rfl
  intro row _
  by_cases h : (row.val, embedding row) = (i, column)
  · simp only [h, MvPolynomial.pderiv_X, Pi.single_eq_same, Finset.univ_eq_attach, one_mul, map_prod,
      MvPolynomial.eval_X, ↓reduceIte]
  · simp only [MvPolynomial.pderiv_X, ne_eq, h, not_false_eq_true, Pi.single_eq_of_ne, Finset.univ_eq_attach,
      zero_mul, map_zero, ↓reduceIte]

theorem sourceMatching_embedding_edge_sum
    {t s : ℕ} (rows : Finset (Fin t))
    (i : Fin t) (column : Fin s)
    (point : Fin t × Fin s → ℂ) (embedding : rows ↪ Fin s) :
    (∑ row : rows,
      if (row.val, embedding row) = (i, column) then
        ∏ other ∈ (Finset.univ : Finset rows).erase row,
          point (other.val, embedding other)
      else 0) =
      if hrow : i ∈ rows then
        if embedding (⟨i, hrow⟩ : rows) = column then
          ∏ other ∈ (Finset.univ : Finset rows).erase
            (⟨i, hrow⟩ : rows),
            point (other.val, embedding other)
        else 0
      else 0 := by
  classical
  split_ifs with hrow hcolumn
  · rw [Finset.sum_eq_single (⟨i, hrow⟩ : rows)]
    · simp only [hcolumn, ↓reduceIte, Finset.univ_eq_attach]
    · intro other _ hother
      have hne : other.val ≠ i := by
        intro heq
        exact hother (Subtype.ext heq)
      simp only [Prod.mk.injEq, hne, false_and, ↓reduceIte]
    · simp only [Finset.univ_eq_attach, Finset.mem_attach, not_true_eq_false, Prod.mk.injEq, true_and,
        ite_eq_right_iff, IsEmpty.forall_iff]
  · apply Finset.sum_eq_zero
    intro other _
    by_cases hother : other.val = i
    · have heq : other = (⟨i, hrow⟩ : rows) := Subtype.ext hother
      subst other
      simp only [Prod.mk.injEq, hcolumn, and_false, ↓reduceIte]
    · simp only [Prod.mk.injEq, hother, false_and, ↓reduceIte]
  · apply Finset.sum_eq_zero
    intro other _
    have hne : other.val ≠ i := fun heq => hrow (heq ▸ other.property)
    simp only [Prod.mk.injEq, hne, false_and, ↓reduceIte]

theorem sourceMatching_row_derivative_eq_excluded_embeddings
    {t s : ℕ} (rows : Finset (Fin t))
    (i : Fin t) (column : Fin s)
    (point : Fin t × Fin s → ℂ) (hrow : i ∈ rows) :
    (∑ embedding : rows ↪ Fin s,
      ∑ row : rows,
        if (row.val, embedding row) = (i, column) then
          ∏ other ∈ (Finset.univ : Finset rows).erase row,
            point (other.val, embedding other)
        else 0) =
      ∑ embedding : (rows.erase i) ↪ {other : Fin s // other ≠ column},
        ∏ other : rows.erase i,
          point (other.val, (embedding other).val) := by
  classical
  calc
    (∑ embedding : rows ↪ Fin s,
      ∑ row : rows,
        if (row.val, embedding row) = (i, column) then
          ∏ other ∈ (Finset.univ : Finset rows).erase row,
            point (other.val, embedding other)
        else 0) =
      ∑ embedding : rows ↪ Fin s,
        if embedding (⟨i, hrow⟩ : rows) = column then
          ∏ other ∈ (Finset.univ : Finset rows).erase
            (⟨i, hrow⟩ : rows),
            point (other.val, embedding other)
        else 0 := by
          apply Finset.sum_congr rfl
          intro embedding _
          simpa only [Finset.univ_eq_attach, Prod.mk.injEq, hrow, ↓reduceDIte] using
            sourceMatching_embedding_edge_sum rows i column point embedding
    _ = _ := sourceFixedEdgeEmbedding_weighted_sum
      rows i column hrow point

theorem eval_minorSum_pderiv_eq_excluded_embeddings
    (t s d : ℕ) (hd : 0 < d) (point : Fin t × Fin s → ℂ)
    (i : Fin t) (column : Fin s) :
    MvPolynomial.eval point
        (MvPolynomial.pderiv (i, column) (minorSum t s d)) =
      ∑ rows ∈
          ((Finset.univ : Finset (Fin t)).erase i).powersetCard (d - 1),
        ∑ embedding : rows ↪ {other : Fin s // other ≠ column},
          ∏ row : rows, point (row.val, (embedding row).val) := by
  classical
  rw [eval_minorSum_pderiv_source_embeddings]
  let sourceRows := (Finset.univ : Finset (Fin t)).powersetCard d
  let validRows := sourceRows.filter (fun rows => i ∈ rows)
  let remainingRows :=
    ((Finset.univ : Finset (Fin t)).erase i).powersetCard (d - 1)
  let edgeWeight : Finset (Fin t) → ℂ := fun rows =>
    ∑ embedding : rows ↪ Fin s,
      ∑ row : rows,
        if (row.val, embedding row) = (i, column) then
          ∏ other ∈ (Finset.univ : Finset rows).erase row,
            point (other.val, embedding other)
        else 0
  let remainingWeight : Finset (Fin t) → ℂ := fun rows =>
    ∑ embedding : rows ↪ {other : Fin s // other ≠ column},
      ∏ row : rows, point (row.val, (embedding row).val)
  change (∑ rows ∈ sourceRows, edgeWeight rows) =
    ∑ rows ∈ remainingRows, remainingWeight rows
  calc
    (∑ rows ∈ sourceRows, edgeWeight rows) =
      ∑ rows ∈ validRows, edgeWeight rows := by
        symm
        apply Finset.sum_subset (Finset.filter_subset _ _)
        intro rows hsource hnot
        have hrow : i ∉ rows := by
          intro hmem
          apply hnot
          exact Finset.mem_filter.mpr ⟨hsource, hmem⟩
        change
          (∑ embedding : rows ↪ Fin s,
            ∑ row : rows,
              if (row.val, embedding row) = (i, column) then
                ∏ other ∈ (Finset.univ : Finset rows).erase row,
                  point (other.val, embedding other)
              else 0) = 0
        apply Finset.sum_eq_zero
        intro embedding _
        simpa only [Finset.univ_eq_attach, Prod.mk.injEq, hrow, ↓reduceDIte] using
          sourceMatching_embedding_edge_sum rows i column point embedding
    _ = ∑ rows ∈ validRows, remainingWeight (rows.erase i) := by
        apply Finset.sum_congr rfl
        intro rows hrows
        have hrow : i ∈ rows := (Finset.mem_filter.mp hrows).2
        exact sourceMatching_row_derivative_eq_excluded_embeddings
          rows i column point hrow
    _ = ∑ rows ∈ remainingRows, remainingWeight rows := by
        refine Finset.sum_bij
          (fun rows _ => rows.erase i) ?_ ?_ ?_ ?_
        · intro rows hrows
          have hmem := Finset.mem_filter.mp hrows
          apply Finset.mem_powersetCard.mpr
          constructor
          · intro row hrow
            exact Finset.mem_erase.mpr
              ⟨(Finset.mem_erase.mp hrow).1, Finset.mem_univ row⟩
          · have hcard : rows.card = d := by
              simpa only [Finset.mem_powersetCard, Finset.subset_univ, true_and, sourceRows] using hmem.1
            rw [Finset.card_erase_of_mem hmem.2, hcard]
        · intro left hleft right hright herase
          have hlefti := (Finset.mem_filter.mp hleft).2
          have hrighti := (Finset.mem_filter.mp hright).2
          calc
            left = insert i (left.erase i) :=
              (Finset.insert_erase hlefti).symm
            _ = insert i (right.erase i) := congrArg (insert i) herase
            _ = right := Finset.insert_erase hrighti
        · intro rows hrows
          have hmem := Finset.mem_powersetCard.mp hrows
          have hnot : i ∉ rows := by
            intro hi
            exact Finset.notMem_erase i Finset.univ (hmem.1 hi)
          let whole := insert i rows
          have hwhole : whole ∈ validRows := by
            apply Finset.mem_filter.mpr
            constructor
            · apply Finset.mem_powersetCard.mpr
              constructor
              · exact Finset.subset_univ whole
              · simp only [whole, Finset.card_insert_of_notMem hnot]
                omega
            · exact Finset.mem_insert_self i rows
          refine ⟨whole, hwhole, ?_⟩
          simp only [Finset.erase_insert_eq_erase, hnot, not_false_eq_true, Finset.erase_eq_of_notMem, whole]
        · intro rows hrows
          rfl

end Standalone_PartitionMatching

section Standalone_PartitionInversion

open scoped BigOperators

theorem partition_empty_eq {α : Type*} [DecidableEq α]
    (partition : Finpartition (∅ : Finset α)) :
    partition = Finpartition.empty (Finset α) := by
  apply Finpartition.ext
  change partition.parts = ∅
  exact Finpartition.parts_eq_empty_iff.mpr rfl

theorem partition_cycle_factorial_empty (t : ℕ) :
    (∑ partition : Finpartition (∅ : Finset (Fin t)),
      ∏ block ∈ partition.parts, (block.card - 1).factorial) =
        (0 : ℕ).factorial := by
  classical
  let emptyPartition : Finpartition (∅ : Finset (Fin t)) :=
    Finpartition.empty (Finset (Fin t))
  have huniv :
      (Finset.univ : Finset (Finpartition (∅ : Finset (Fin t)))) =
        {emptyPartition} := by
    ext partition
    simp only [Finset.mem_univ, Finset.mem_singleton, true_iff]
    change partition = Finpartition.empty (Finset (Fin t))
    exact partition_empty_eq partition
  rw [huniv]
  simp only [Finpartition.empty, Finset.bot_eq_empty, Finset.sum_singleton, Finset.prod_empty,
    Nat.factorial_zero, emptyPartition]

noncomputable def partitionRemovePart {α : Type*} [DecidableEq α]
    {rows : Finset α} (partition : Finpartition rows)
    (block : Finset α) (hblock : block ∈ partition.parts) :
    Finpartition (rows \ block) :=
  partition.ofSubset (Finset.erase_subset block partition.parts) (by
    ext row
    simp only [Finset.mem_sup, id_eq, Finset.mem_erase,
      Finset.mem_sdiff]
    constructor
    · rintro ⟨part, ⟨hne, hpart⟩, hrow⟩
      refine ⟨partition.subset hpart hrow, ?_⟩
      intro hrowblock
      exact Finset.disjoint_left.mp
        (partition.disjoint hpart hblock hne) hrow hrowblock
    · rintro ⟨hrow, hnot⟩
      obtain ⟨part, hpart, hrowpart⟩ := partition.exists_mem hrow
      refine ⟨part, ⟨?_, hpart⟩, hrowpart⟩
      intro heq
      apply hnot
      simpa only [heq] using hrowpart)

@[simp] theorem partitionRemovePart_parts {α : Type*} [DecidableEq α]
    {rows : Finset α} (partition : Finpartition rows)
    (block : Finset α) (hblock : block ∈ partition.parts) :
    (partitionRemovePart partition block hblock).parts =
      partition.parts.erase block := by
  rfl

noncomputable def partitionAddPart {α : Type*} [DecidableEq α]
    {rows : Finset α} (block : Finset α)
    (hnonempty : block.Nonempty) (hsubset : block ⊆ rows)
    (partition : Finpartition (rows \ block)) : Finpartition rows :=
  partition.extend hnonempty.ne_empty Finset.sdiff_disjoint (by
    change rows \ block ∪ block = rows
    exact Finset.sdiff_union_of_subset hsubset)

theorem partition_block_not_mem_complement
    {α : Type*} [DecidableEq α] {rows : Finset α}
    (block : Finset α) (hnonempty : block.Nonempty)
    (partition : Finpartition (rows \ block)) :
    block ∉ partition.parts := by
  intro hblock
  obtain ⟨row, hrow⟩ := hnonempty
  exact (Finset.mem_sdiff.mp
    ((partition.subset hblock) hrow)).2 hrow

theorem partition_weight_fiber {α R : Type*}
    [DecidableEq α] [CommSemiring R]
    (weight : Finset α → R) (rows : Finset α)
    (distinguished : α) (hdistinguished : distinguished ∈ rows)
    (selected : Finset α) (hselected : selected ⊆ rows.erase distinguished) :
    (∑ partition ∈
        (Finset.univ : Finset (Finpartition rows)).filter
          (fun partition => (partition.part distinguished).erase distinguished =
            selected),
        ∏ block ∈ partition.parts, weight block) =
      weight (insert distinguished selected) *
        ∑ partition : Finpartition (rows \ insert distinguished selected),
          ∏ block ∈ partition.parts, weight block := by
  classical
  let block : Finset α := insert distinguished selected
  have hnonempty : block.Nonempty :=
    ⟨distinguished, Finset.mem_insert_self distinguished selected⟩
  have hsubset : block ⊆ rows := by
    intro row hrow
    rcases Finset.mem_insert.mp hrow with hrow | hrow
    · simpa only [hrow] using hdistinguished
    · exact (Finset.mem_erase.mp (hselected hrow)).2
  have hnot : distinguished ∉ selected := by
    intro hmem
    exact Finset.notMem_erase distinguished rows (hselected hmem)
  have hpart (partition : Finpartition rows)
      (hpartition : partition ∈
        (Finset.univ : Finset (Finpartition rows)).filter
          (fun partition =>
            (partition.part distinguished).erase distinguished = selected)) :
      partition.part distinguished = block := by
    have herase := (Finset.mem_filter.mp hpartition).2
    calc
      partition.part distinguished =
          insert distinguished
            ((partition.part distinguished).erase distinguished) :=
        (Finset.insert_erase
          (partition.mem_part hdistinguished)).symm
      _ = block := by rw [herase]
  have hblock (partition : Finpartition rows)
      (hpartition : partition ∈
        (Finset.univ : Finset (Finpartition rows)).filter
          (fun partition =>
            (partition.part distinguished).erase distinguished = selected)) :
      block ∈ partition.parts := by
    rw [← hpart partition hpartition]
    exact partition.part_mem.mpr hdistinguished
  rw [Finset.mul_sum]
  change
    (∑ partition ∈
        (Finset.univ : Finset (Finpartition rows)).filter
          (fun partition => (partition.part distinguished).erase distinguished =
            selected),
        ∏ part ∈ partition.parts, weight part) =
      ∑ partition : Finpartition (rows \ block),
        weight block * ∏ part ∈ partition.parts, weight part
  refine Finset.sum_bij
    (fun partition hpartition =>
      partitionRemovePart partition block (hblock partition hpartition))
    (fun _ _ => Finset.mem_univ _) ?_ ?_ ?_
  · intro left hleft right hright heq
    apply Finpartition.ext
    have herase := congrArg Finpartition.parts heq
    change left.parts.erase block = right.parts.erase block at herase
    calc
      left.parts = insert block (left.parts.erase block) :=
        (Finset.insert_erase (hblock left hleft)).symm
      _ = insert block (right.parts.erase block) :=
        congrArg (insert block) herase
      _ = right.parts := Finset.insert_erase (hblock right hright)
  · intro complement _
    let partition : Finpartition rows :=
      partitionAddPart block hnonempty hsubset complement
    have hpart_block : partition.part distinguished = block := by
      apply partition.part_eq_of_mem
      · change block ∈ insert block complement.parts
        exact Finset.mem_insert_self block complement.parts
      · exact Finset.mem_insert_self distinguished selected
    have hfilter : partition ∈
        (Finset.univ : Finset (Finpartition rows)).filter
          (fun partition =>
            (partition.part distinguished).erase distinguished = selected) := by
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_univ partition, ?_⟩
      rw [hpart_block]
      simp only [Finset.erase_insert_eq_erase, hnot, not_false_eq_true, Finset.erase_eq_of_notMem, block]
    refine ⟨partition, hfilter, ?_⟩
    apply Finpartition.ext
    change (insert block complement.parts).erase block = complement.parts
    rw [Finset.erase_insert
      (partition_block_not_mem_complement block hnonempty complement)]
  · intro partition hpartition
    rw [partitionRemovePart_parts]
    exact (Finset.mul_prod_erase partition.parts weight
      (hblock partition hpartition)).symm

theorem partition_weight_sum {α R : Type*}
    [DecidableEq α] [CommSemiring R]
    (weight : Finset α → R) (rows : Finset α)
    (distinguished : α) (hdistinguished : distinguished ∈ rows) :
    (∑ partition : Finpartition rows,
      ∏ block ∈ partition.parts, weight block) =
      ∑ selected ∈ (rows.erase distinguished).powerset,
        weight (insert distinguished selected) *
          ∑ partition : Finpartition (rows \ insert distinguished selected),
            ∏ block ∈ partition.parts, weight block := by
  classical
  have hmaps :
      ∀ partition ∈ (Finset.univ : Finset (Finpartition rows)),
        (partition.part distinguished).erase distinguished ∈
          (rows.erase distinguished).powerset := by
    intro partition _
    apply Finset.mem_powerset.mpr
    intro row hrow
    obtain ⟨hne, hpart⟩ := Finset.mem_erase.mp hrow
    exact Finset.mem_erase.mpr
      ⟨hne, partition.part_subset distinguished hpart⟩
  calc
    (∑ partition : Finpartition rows,
        ∏ block ∈ partition.parts, weight block) =
      ∑ selected ∈ (rows.erase distinguished).powerset,
        ∑ partition ∈
            (Finset.univ : Finset (Finpartition rows)).filter
              (fun partition =>
                (partition.part distinguished).erase distinguished = selected),
          ∏ block ∈ partition.parts, weight block :=
        (Finset.sum_fiberwise_of_maps_to hmaps
          (fun partition : Finpartition rows =>
            ∏ block ∈ partition.parts, weight block)).symm
    _ = ∑ selected ∈ (rows.erase distinguished).powerset,
        weight (insert distinguished selected) *
          ∑ partition : Finpartition (rows \ insert distinguished selected),
            ∏ block ∈ partition.parts, weight block := by
      apply Finset.sum_congr rfl
      intro selected hselected
      exact partition_weight_fiber weight rows distinguished hdistinguished
        selected (Finset.mem_powerset.mp hselected)

theorem partition_cycle_factorial_fiber
    {α : Type*} [DecidableEq α] (rows : Finset α)
    (distinguished : α) (hdistinguished : distinguished ∈ rows)
    (selected : Finset α) (hselected : selected ⊆ rows.erase distinguished) :
    (∑ partition ∈
        (Finset.univ : Finset (Finpartition rows)).filter
          (fun partition => (partition.part distinguished).erase distinguished =
            selected),
        ∏ block ∈ partition.parts, (block.card - 1).factorial) =
      selected.card.factorial *
        ∑ partition : Finpartition (rows \ insert distinguished selected),
          ∏ block ∈ partition.parts, (block.card - 1).factorial := by
  classical
  have hnot : distinguished ∉ selected := by
    intro hmem
    exact Finset.notMem_erase distinguished rows (hselected hmem)
  simpa only [hnot, not_false_eq_true, Finset.card_insert_of_notMem, add_tsub_cancel_right] using
    (partition_weight_fiber (fun block : Finset α => (block.card - 1).factorial) rows distinguished hdistinguished
      selected hselected)

theorem sum_powerset_factorial_mul_factorial {α : Type*}
    [DecidableEq α] (rows : Finset α) :
    (∑ selected ∈ rows.powerset,
      selected.card.factorial * (rows \ selected).card.factorial) =
        (rows.card + 1).factorial := by
  classical
  rw [Finset.sum_powerset]
  calc
    (∑ k ∈ Finset.range (rows.card + 1),
        ∑ selected ∈ rows.powersetCard k,
          selected.card.factorial * (rows \ selected).card.factorial) =
      ∑ _k ∈ Finset.range (rows.card + 1), rows.card.factorial := by
        apply Finset.sum_congr rfl
        intro k hk
        have hkle : k ≤ rows.card := by
          have := Finset.mem_range.mp hk
          omega
        calc
          (∑ selected ∈ rows.powersetCard k,
              selected.card.factorial *
                (rows \ selected).card.factorial) =
            ∑ _selected ∈ rows.powersetCard k,
              k.factorial * (rows.card - k).factorial := by
                apply Finset.sum_congr rfl
                intro selected hselected
                obtain ⟨hsubset, hcard⟩ :=
                  Finset.mem_powersetCard.mp hselected
                rw [Finset.card_sdiff_of_subset hsubset, hcard]
          _ = rows.card.choose k *
              (k.factorial * (rows.card - k).factorial) := by
                simp only [Finset.sum_const, Finset.card_powersetCard, smul_eq_mul]
          _ = rows.card.factorial := by
                simpa only [mul_assoc] using (Nat.choose_mul_factorial_mul_factorial hkle)
    _ = (rows.card + 1).factorial := by
      simp only [Finset.sum_const, Finset.card_range, smul_eq_mul, mul_comm, Nat.factorial_succ]

theorem signed_factorial_powerset {α : Type*}
    [DecidableEq α] (others : Finset α) :
    (∑ selected ∈ others.powerset,
      ((-1 : ℂ) ^ selected.card * (selected.card.factorial : ℂ)) *
        if (others \ selected).card ≤ 1 then (1 : ℂ) else 0) =
      if others.Nonempty then (0 : ℂ) else 1 := by
  classical
  rw [Finset.sum_powerset]
  calc
    (∑ k ∈ Finset.range (others.card + 1),
        ∑ selected ∈ others.powersetCard k,
          ((-1 : ℂ) ^ selected.card *
              (selected.card.factorial : ℂ)) *
            if (others \ selected).card ≤ 1 then (1 : ℂ) else 0) =
      ∑ k ∈ Finset.range (others.card + 1),
        (others.card.choose k : ℂ) *
          (((-1 : ℂ) ^ k * (k.factorial : ℂ)) *
            if others.card - k ≤ 1 then (1 : ℂ) else 0) := by
        apply Finset.sum_congr rfl
        intro k _
        calc
          (∑ selected ∈ others.powersetCard k,
              ((-1 : ℂ) ^ selected.card *
                  (selected.card.factorial : ℂ)) *
                if (others \ selected).card ≤ 1 then (1 : ℂ) else 0) =
            ∑ _selected ∈ others.powersetCard k,
              (((-1 : ℂ) ^ k * (k.factorial : ℂ)) *
                if others.card - k ≤ 1 then (1 : ℂ) else 0) := by
              apply Finset.sum_congr rfl
              intro selected hselected
              obtain ⟨hsubset, hcard⟩ :=
                Finset.mem_powersetCard.mp hselected
              rw [Finset.card_sdiff_of_subset hsubset, hcard]
          _ = (others.card.choose k : ℂ) *
                (((-1 : ℂ) ^ k * (k.factorial : ℂ)) *
                  if others.card - k ≤ 1 then (1 : ℂ) else 0) := by
              simp only [tsub_le_iff_right, mul_ite, mul_one, mul_zero, Finset.sum_ite_irrel,
                Finset.sum_const, Finset.card_powersetCard, nsmul_eq_mul]
    _ = if others.Nonempty then (0 : ℂ) else 1 := by
      cases hcard : others.card with
      | zero =>
        have hempty : others = ∅ := Finset.card_eq_zero.mp hcard
        simp only [zero_add, Finset.range_one, zero_tsub, zero_le, ↓reduceIte, mul_one, Finset.sum_singleton,
          Nat.choose_self, Nat.cast_one, pow_zero, Nat.factorial_zero, hempty, Finset.not_nonempty_empty]
      | succ n =>
        have hnonempty : others.Nonempty :=
          Finset.card_pos.mp (by omega)
        simp only [hnonempty, ↓reduceIte]
        have hsubset : ({n, n + 1} : Finset ℕ) ⊆
            Finset.range (others.card + 1) := by
          intro k hk
          simp only [Finset.mem_insert, Finset.mem_singleton] at hk
          simp only [Finset.mem_range]
          omega
        have hzero (k : ℕ) (hk : k ∈ Finset.range (others.card + 1))
            (hnot : k ∉ ({n, n + 1} : Finset ℕ)) :
            (others.card.choose k : ℂ) *
              (((-1 : ℂ) ^ k * (k.factorial : ℂ)) *
                if others.card - k ≤ 1 then (1 : ℂ) else 0) = 0 := by
          have hlt : k < others.card + 1 := Finset.mem_range.mp hk
          have hne₁ : k ≠ n := by
            intro heq
            apply hnot
            simp only [heq, Finset.mem_insert, Finset.mem_singleton, Nat.left_eq_add, one_ne_zero, or_false]
          have hne₂ : k ≠ n + 1 := by
            intro heq
            apply hnot
            simp only [heq, Finset.mem_insert, Nat.add_eq_left, one_ne_zero, Finset.mem_singleton, or_true]
          have hlarge : ¬ others.card - k ≤ 1 := by
            omega
          simp only [hlarge, ↓reduceIte, mul_zero]
        calc
          (∑ k ∈ Finset.range (n + 1 + 1),
              ((n + 1).choose k : ℂ) *
                (((-1 : ℂ) ^ k * (k.factorial : ℂ)) *
                  if n + 1 - k ≤ 1 then (1 : ℂ) else 0)) =
            ∑ k ∈ ({n, n + 1} : Finset ℕ),
              ((n + 1).choose k : ℂ) *
                (((-1 : ℂ) ^ k * (k.factorial : ℂ)) *
                  if n + 1 - k ≤ 1 then (1 : ℂ) else 0) := by
              simpa only [tsub_le_iff_right, Order.add_one_le_iff, mul_ite, mul_one, mul_zero, Finset.mem_singleton,
                Nat.left_eq_add, one_ne_zero, not_false_eq_true, Finset.sum_insert, lt_add_iff_pos_left, Order.lt_one_iff,
                ↓reduceIte, Nat.choose_succ_self_right, Nat.cast_add, Nat.cast_one, Finset.sum_singleton, Nat.choose_self, one_mul,
                hcard] using (Finset.sum_subset hsubset hzero).symm
          _ = 0 := by
            simp only [tsub_le_iff_right, Order.add_one_le_iff, mul_ite, mul_one, mul_zero, Finset.mem_singleton,
              Nat.left_eq_add, one_ne_zero, not_false_eq_true, Finset.sum_insert, lt_add_iff_pos_left, Order.lt_one_iff,
              ↓reduceIte, Nat.choose_succ_self_right, Nat.cast_add, Nat.cast_one, Finset.sum_singleton, Nat.choose_self, pow_succ,
              mul_neg, Nat.factorial_succ, Nat.cast_mul, neg_mul, one_mul]
            split_ifs with h
            · ring
            · omega

theorem partitionMobius_sum {t : ℕ} (rows : Finset (Fin t)) :
    (∑ partition : Finpartition rows, partitionMobius partition) =
      if rows.card ≤ 1 then (1 : ℂ) else 0 := by
  classical
  induction rows using Finset.strongInduction with
  | H rows ih =>
    by_cases hempty : rows = ∅
    · subst rows
      let emptyPartition : Finpartition (∅ : Finset (Fin t)) :=
        Finpartition.empty (Finset (Fin t))
      have huniv :
          (Finset.univ :
            Finset (Finpartition (∅ : Finset (Fin t)))) =
              {emptyPartition} := by
        ext partition
        simp only [Finset.mem_univ, Finset.mem_singleton, true_iff]
        change partition = Finpartition.empty (Finset (Fin t))
        exact partition_empty_eq partition
      rw [huniv]
      simp only [Finpartition.empty, Finset.bot_eq_empty, partitionMobius, Finset.sum_singleton, Finset.prod_empty,
        Finset.card_empty, zero_le, ↓reduceIte, emptyPartition]
    · obtain ⟨distinguished, hdistinguished⟩ :=
        Finset.nonempty_iff_ne_empty.mpr hempty
      let weight : Finset (Fin t) → ℂ := fun block =>
        (-1 : ℂ) ^ (block.card - 1) *
          ((block.card - 1).factorial : ℂ)
      calc
        (∑ partition : Finpartition rows,
            partitionMobius partition) =
          ∑ partition : Finpartition rows,
            ∏ block ∈ partition.parts, weight block := by
              simp only [partitionMobius, weight]
        _ = ∑ selected ∈ (rows.erase distinguished).powerset,
              weight (insert distinguished selected) *
                ∑ partition :
                    Finpartition (rows \ insert distinguished selected),
                  ∏ block ∈ partition.parts, weight block :=
              partition_weight_sum weight rows
                distinguished hdistinguished
        _ = ∑ selected ∈ (rows.erase distinguished).powerset,
              ((-1 : ℂ) ^ selected.card *
                (selected.card.factorial : ℂ)) *
                if ((rows.erase distinguished) \ selected).card ≤ 1
                  then (1 : ℂ) else 0 := by
              apply Finset.sum_congr rfl
              intro selected hselected
              have hsubset : selected ⊆ rows.erase distinguished :=
                Finset.mem_powerset.mp hselected
              have hnot : distinguished ∉ selected := by
                intro hmem
                exact Finset.notMem_erase distinguished rows (hsubset hmem)
              have hblock : insert distinguished selected ⊆ rows := by
                intro row hrow
                rcases Finset.mem_insert.mp hrow with hrow | hrow
                · simpa only [hrow] using hdistinguished
                · exact (Finset.mem_erase.mp (hsubset hrow)).2
              have hnonempty :
                  (insert distinguished selected).Nonempty :=
                ⟨distinguished,
                  Finset.mem_insert_self distinguished selected⟩
              have hcomplement :
                  rows \ insert distinguished selected =
                    (rows.erase distinguished) \ selected := by
                ext row
                simp only [Finset.mem_sdiff, Finset.mem_insert, not_or, and_left_comm, Finset.mem_erase, ne_eq, and_assoc]
              have hinner :
                  (∑ partition :
                      Finpartition (rows \ insert distinguished selected),
                    ∏ block ∈ partition.parts, weight block) =
                    if (rows \ insert distinguished selected).card ≤ 1
                      then (1 : ℂ) else 0 := by
                calc
                  (∑ partition :
                      Finpartition (rows \ insert distinguished selected),
                    ∏ block ∈ partition.parts, weight block) =
                      ∑ partition :
                          Finpartition (rows \ insert distinguished selected),
                        partitionMobius partition := by
                          simp only [partitionMobius, weight]
                  _ = if (rows \ insert distinguished selected).card ≤ 1
                        then (1 : ℂ) else 0 :=
                    ih (rows \ insert distinguished selected)
                      (Finset.sdiff_ssubset hblock hnonempty)
              rw [hinner, hcomplement]
              simp only [hnot, not_false_eq_true, Finset.card_insert_of_notMem, add_tsub_cancel_right, mul_ite, mul_one,
                mul_zero, weight]
        _ = if (rows.erase distinguished).Nonempty then (0 : ℂ) else 1 :=
              signed_factorial_powerset (rows.erase distinguished)
        _ = if rows.card ≤ 1 then (1 : ℂ) else 0 := by
              have hcard :
                  (rows.erase distinguished).card + 1 = rows.card := by
                rw [Finset.card_erase_of_mem hdistinguished]
                have hpos : 0 < rows.card := Finset.card_pos.mpr
                  ⟨distinguished, hdistinguished⟩
                omega
              by_cases hremaining : (rows.erase distinguished).Nonempty
              · have hnot : ¬ rows.card ≤ 1 := by
                  have hpos := Finset.card_pos.mpr hremaining
                  omega
                simp only [hremaining, ↓reduceIte, hnot]
              · have hzero : (rows.erase distinguished).card = 0 := by
                  apply Finset.card_eq_zero.mpr
                  exact Finset.not_nonempty_iff_eq_empty.mp hremaining
                have hsmall : rows.card ≤ 1 := by omega
                simp only [hremaining, ↓reduceIte, hsmall]

theorem partition_cycle_factorial {t : ℕ} (rows : Finset (Fin t)) :
    (∑ partition : Finpartition rows,
      ∏ block ∈ partition.parts, (block.card - 1).factorial) =
        rows.card.factorial := by
  classical
  induction rows using Finset.strongInduction with
  | H rows ih =>
    by_cases hempty : rows = ∅
    · subst rows
      exact partition_cycle_factorial_empty t
    · obtain ⟨distinguished, hdistinguished⟩ :=
        Finset.nonempty_iff_ne_empty.mpr hempty
      have hmaps :
          ∀ partition ∈ (Finset.univ : Finset (Finpartition rows)),
            (partition.part distinguished).erase distinguished ∈
              (rows.erase distinguished).powerset := by
        intro partition _
        apply Finset.mem_powerset.mpr
        intro row hrow
        obtain ⟨hne, hpart⟩ := Finset.mem_erase.mp hrow
        exact Finset.mem_erase.mpr
          ⟨hne, partition.part_subset distinguished hpart⟩
      calc
        (∑ partition : Finpartition rows,
            ∏ block ∈ partition.parts, (block.card - 1).factorial) =
          ∑ selected ∈ (rows.erase distinguished).powerset,
            ∑ partition ∈
                (Finset.univ : Finset (Finpartition rows)).filter
                  (fun partition =>
                    (partition.part distinguished).erase distinguished =
                      selected),
              ∏ block ∈ partition.parts, (block.card - 1).factorial :=
            (Finset.sum_fiberwise_of_maps_to hmaps
              (fun partition : Finpartition rows =>
                ∏ block ∈ partition.parts, (block.card - 1).factorial)).symm
        _ = ∑ selected ∈ (rows.erase distinguished).powerset,
              selected.card.factorial *
                (rows \ insert distinguished selected).card.factorial := by
          apply Finset.sum_congr rfl
          intro selected hselected
          have hsubselected : selected ⊆ rows.erase distinguished :=
            Finset.mem_powerset.mp hselected
          rw [partition_cycle_factorial_fiber rows distinguished
            hdistinguished selected hsubselected]
          have hblock : insert distinguished selected ⊆ rows := by
            intro row hrow
            rcases Finset.mem_insert.mp hrow with hrow | hrow
            · simpa only [hrow] using hdistinguished
            · exact (Finset.mem_erase.mp (hsubselected hrow)).2
          have hnonempty : (insert distinguished selected).Nonempty :=
            ⟨distinguished,
              Finset.mem_insert_self distinguished selected⟩
          rw [ih (rows \ insert distinguished selected)
            (Finset.sdiff_ssubset hblock hnonempty)]
        _ = ∑ selected ∈ (rows.erase distinguished).powerset,
              selected.card.factorial *
                ((rows.erase distinguished) \ selected).card.factorial := by
          apply Finset.sum_congr rfl
          intro selected _
          have hcomplement :
              rows \ insert distinguished selected =
                (rows.erase distinguished) \ selected := by
            ext row
            simp only [Finset.mem_sdiff, Finset.mem_insert, not_or, and_left_comm, Finset.mem_erase, ne_eq, and_assoc]
          rw [hcomplement]
        _ = ((rows.erase distinguished).card + 1).factorial :=
          sum_powerset_factorial_mul_factorial (rows.erase distinguished)
        _ = rows.card.factorial := by
          rw [Finset.card_erase_of_mem hdistinguished]
          congr 1
          have hpos : 0 < rows.card := Finset.card_pos.mpr
            ⟨distinguished, hdistinguished⟩
          omega

theorem partition_cycle_factorial_complex {t : ℕ}
    (rows : Finset (Fin t)) :
    (∑ partition : Finpartition rows,
      ∏ block ∈ partition.parts,
        ((block.card - 1).factorial : ℂ)) =
      (rows.card.factorial : ℂ) := by
  exact_mod_cast partition_cycle_factorial rows

theorem partition_selected_blocks_card_lt {t : ℕ}
    {rows : Finset (Fin t)} (partition : Finpartition rows)
    (selected : Finset (Finset (Fin t)))
    (hselected : selected ⊆ partition.parts)
    (hne : selected ≠ partition.parts) :
    (∑ block ∈ selected, block.card) < rows.card := by
  classical
  have hproper : ¬partition.parts ⊆ selected := by
    intro hreverse
    exact hne (Finset.Subset.antisymm hselected hreverse)
  obtain ⟨block, hblock, hnot⟩ := Finset.not_subset.mp hproper
  rw [← partition.sum_card_parts]
  exact Finset.sum_lt_sum_of_subset hselected hblock hnot
    (Finset.card_pos.mpr (partition.nonempty_of_mem_parts hblock))
    (fun _ _ _ => Nat.zero_le _)

theorem eval_powerSum_sub_column_monomial (t s : ℕ)
    (point : Fin t × Fin s → ℂ) (column : Fin s)
    (block : Finset (Fin t)) :
    MvPolynomial.eval point (powerSum t s block) -
        ∏ row ∈ block, point (row, column) =
      ∑ other ∈ (Finset.univ : Finset (Fin s)).erase column,
        ∏ row ∈ block, point (row, other) := by
  classical
  simp only [powerSum, map_sum, map_prod, MvPolynomial.eval_X]
  rw [← Finset.add_sum_erase (Finset.univ : Finset (Fin s))
    (fun other => ∏ row ∈ block, point (row, other))
    (Finset.mem_univ column)]
  ring

theorem eval_partitionBlockFactor_excluded_columns (t s : ℕ)
    (point : Fin t × Fin s → ℂ) (column : Fin s)
    {rows : Finset (Fin t)} (partition : Finpartition rows) :
    MvPolynomial.eval (fun row => point (row, column))
        (partitionBlockFactor
          (fun block => MvPolynomial.eval point (powerSum t s block))
          partition) =
      ∏ block ∈ partition.parts,
        ∑ other ∈ (Finset.univ : Finset (Fin s)).erase column,
          ∏ row ∈ block, point (row, other) := by
  classical
  simp only [partitionBlockFactor, map_prod, map_sub,
    MvPolynomial.eval_C, MvPolynomial.eval_X]
  apply Finset.prod_congr rfl
  intro block _
  exact eval_powerSum_sub_column_monomial t s point column block

theorem eval_partitionDerivative_excluded_columns
    (t s d : ℕ) (point : Fin t × Fin s → ℂ)
    (i : Fin t) (column : Fin s) :
    MvPolynomial.eval (fun row => point (row, column))
        (partitionDerivative t d i
          (fun block => MvPolynomial.eval point (powerSum t s block))) =
      ∑ rows ∈
          ((Finset.univ : Finset (Fin t)).erase i).powersetCard (d - 1),
        ∑ partition : Finpartition rows,
          partitionMobius partition *
            ∏ block ∈ partition.parts,
              ∑ other ∈ (Finset.univ : Finset (Fin s)).erase column,
                ∏ row ∈ block, point (row, other) := by
  classical
  simp only [partitionDerivative, map_sum, map_mul, MvPolynomial.eval_C]
  apply Finset.sum_congr rfl
  intro rows _
  apply Finset.sum_congr rfl
  intro partition _
  rw [eval_partitionBlockFactor_excluded_columns]

noncomputable def columnAssignmentFiberPartition
    {t s : ℕ} (rows : Finset (Fin t)) (assignment : Fin t → Fin s) :
    Finpartition rows := by
  classical
  exact Finpartition.ofSetSetoid (Setoid.ker assignment) rows

theorem mem_columnAssignmentFiberPartition_part_iff
    {t s : ℕ} (rows : Finset (Fin t)) (assignment : Fin t → Fin s)
    (left right : Fin t) :
    right ∈ (columnAssignmentFiberPartition rows assignment).part left ↔
      left ∈ rows ∧ right ∈ rows ∧ assignment left = assignment right := by
  classical
  change right ∈
      (Finpartition.ofSetSetoid (Setoid.ker assignment) rows).part left ↔
    left ∈ rows ∧ right ∈ rows ∧ assignment left = assignment right
  exact Finpartition.mem_part_ofSetSetoid_iff_rel
    (s := Setoid.ker assignment) rows

theorem columnAssignmentFiberPartition_mobius_product
    {t s : ℕ} (rows : Finset (Fin t)) (assignment : Fin t → Fin s) :
    (∏ block ∈ (columnAssignmentFiberPartition rows assignment).parts,
      ∑ partition : Finpartition block, partitionMobius partition) =
      if Set.InjOn assignment (rows : Set (Fin t)) then (1 : ℂ) else 0 := by
  classical
  let fiber := columnAssignmentFiberPartition rows assignment
  by_cases hinj : Set.InjOn assignment (rows : Set (Fin t))
  · rw [if_pos hinj]
    apply Finset.prod_eq_one
    intro block hblock
    rw [partitionMobius_sum, if_pos]
    apply Finset.card_le_one.mpr
    intro left hleft right hright
    have hleft_rows : left ∈ rows := fiber.subset hblock hleft
    have hright_rows : right ∈ rows := fiber.subset hblock hright
    have hpart : fiber.part left = block :=
      fiber.part_eq_of_mem hblock hleft
    have hsame : assignment left = assignment right :=
      ((mem_columnAssignmentFiberPartition_part_iff
        rows assignment left right).mp (by
          change right ∈ fiber.part left
          rw [hpart]
          exact hright)).2.2
    exact hinj hleft_rows hright_rows hsame
  · rw [if_neg hinj]
    have hcollision : ∃ left ∈ rows, ∃ right ∈ rows,
        left ≠ right ∧ assignment left = assignment right := by
      by_contra hnone
      apply hinj
      intro left hleft right hright heq
      by_contra hne
      apply hnone
      exact ⟨left, hleft, right, hright, hne, heq⟩
    obtain ⟨left, hleft, right, hright, hne, hsame⟩ := hcollision
    let block := fiber.part left
    have hblock : block ∈ fiber.parts := fiber.part_mem.mpr hleft
    apply Finset.prod_eq_zero hblock
    rw [partitionMobius_sum, if_neg]
    intro hsmall
    have hleft_block : left ∈ block := fiber.mem_part hleft
    have hright_block : right ∈ block :=
      (mem_columnAssignmentFiberPartition_part_iff
        rows assignment left right).mpr ⟨hleft, hright, hsame⟩
    exact hne ((Finset.card_le_one.mp hsmall)
      left hleft_block right hright_block)

theorem partition_mem_restrict_of_refinement
    {α : Type*} [DecidableEq α] {rows : Finset α}
    {fine coarse : Finpartition rows} (hrefine : fine ≤ coarse)
    {coarseBlock : Finset α} (hcoarseBlock : coarseBlock ∈ coarse.parts)
    {block : Finset α} :
    block ∈ (fine.restrict (coarse.subset hcoarseBlock)).parts ↔
      block ∈ fine.parts ∧ block ⊆ coarseBlock := by
  change block ∈
    (fine.parts.image (fun part => part ⊓ coarseBlock)).erase ∅ ↔ _
  constructor
  · intro hblock
    obtain ⟨hne, himage⟩ := Finset.mem_erase.mp hblock
    obtain ⟨part, hpart_mem, heq⟩ := Finset.mem_image.mp himage
    obtain ⟨containing, hcontaining, hsubset⟩ := hrefine hpart_mem
    obtain ⟨row, hrow⟩ := Finset.nonempty_iff_ne_empty.mpr hne
    have hintersection : row ∈ part ⊓ coarseBlock := by
      rw [heq]
      exact hrow
    have hrowpart : row ∈ part :=
      (Finset.mem_inter.mp hintersection).1
    have hrowcoarse : row ∈ coarseBlock :=
      (Finset.mem_inter.mp hintersection).2
    have hcoarse : containing = coarseBlock :=
      coarse.eq_of_mem_parts hcontaining hcoarseBlock
        (hsubset hrowpart) hrowcoarse
    have hpartsubset : part ⊆ coarseBlock := hcoarse ▸ hsubset
    have hpart_eq : part = block := by
      calc
        part = part ⊓ coarseBlock := (inf_eq_left.mpr hpartsubset).symm
        _ = block := heq
    exact ⟨hpart_eq ▸ hpart_mem, hpart_eq ▸ hpartsubset⟩
  · rintro ⟨hblock, hsubset⟩
    refine Finset.mem_erase.mpr ⟨fine.ne_empty hblock, ?_⟩
    exact Finset.mem_image.mpr
      ⟨block, hblock, inf_eq_left.mpr hsubset⟩

theorem partition_bind_refines
    {α : Type*} [DecidableEq α] {rows : Finset α}
    (coarse : Finpartition rows)
    (refinements : ∀ block : coarse.parts, Finpartition block.val) :
    coarse.bind (fun block hblock => refinements ⟨block, hblock⟩) ≤ coarse := by
  intro block hblock
  obtain ⟨containing, hcontaining, hmember⟩ :=
    Finpartition.mem_bind.mp hblock
  exact ⟨containing, hcontaining,
    (refinements ⟨containing, hcontaining⟩).subset hmember⟩

noncomputable def partitionRefinementEquiv
    {α : Type*} [DecidableEq α] {rows : Finset α}
    (coarse : Finpartition rows) :
    {fine : Finpartition rows // fine ≤ coarse} ≃
      (∀ block : coarse.parts, Finpartition block.val) where
  toFun fine block := fine.val.restrict (coarse.subset block.property)
  invFun refinements :=
    ⟨coarse.bind (fun block hblock => refinements ⟨block, hblock⟩),
      partition_bind_refines coarse refinements⟩
  left_inv fine := by
    apply Subtype.ext
    apply Finpartition.ext
    ext block
    change
      block ∈
        (coarse.bind (fun part hpart =>
          fine.val.restrict (coarse.subset hpart))).parts ↔
        block ∈ fine.val.parts
    rw [Finpartition.mem_bind]
    constructor
    · rintro ⟨part, hpart, hblock⟩
      exact (partition_mem_restrict_of_refinement
        fine.property hpart).mp hblock |>.1
    · intro hblock
      obtain ⟨part, hpart, hsubset⟩ := fine.property hblock
      exact ⟨part, hpart,
        (partition_mem_restrict_of_refinement
          fine.property hpart).mpr ⟨hblock, hsubset⟩⟩
  right_inv refinements := by
    funext block
    apply Finpartition.ext
    ext part
    change
      part ∈
        ((coarse.bind (fun other hother =>
          refinements ⟨other, hother⟩)).restrict
            (coarse.subset block.property)).parts ↔
        part ∈ (refinements block).parts
    rw [partition_mem_restrict_of_refinement
      (partition_bind_refines coarse refinements) block.property,
      Finpartition.mem_bind]
    constructor
    · rintro ⟨⟨other, hother, hpart⟩, hsubset⟩
      obtain ⟨row, hrow⟩ :=
        (refinements ⟨other, hother⟩).nonempty_of_mem_parts hpart
      have hrowother : row ∈ other :=
        (refinements ⟨other, hother⟩).subset hpart hrow
      have hrowblock : row ∈ block.val := hsubset hrow
      have heq : other = block.val :=
        coarse.eq_of_mem_parts hother block.property hrowother hrowblock
      subst other
      exact hpart
    · intro hpart
      exact ⟨⟨block.val, block.property, hpart⟩,
        (refinements block).subset hpart⟩

theorem partitionMobius_bind
    {t : ℕ} {rows : Finset (Fin t)} (coarse : Finpartition rows)
    (refinements : ∀ block : coarse.parts, Finpartition block.val) :
    partitionMobius
        (coarse.bind
          (fun block hblock => refinements ⟨block, hblock⟩)) =
      ∏ block : coarse.parts, partitionMobius (refinements block) := by
  classical
  unfold partitionMobius
  rw [Finpartition.bind_parts]
  rw [Finset.prod_biUnion]
  · simp only [SetLike.eta, Finset.univ_eq_attach]
  · intro left _ right _ hne
    change Disjoint (refinements left).parts (refinements right).parts
    rw [Finset.disjoint_left]
    intro block hleft hright
    have hsubsetleft : block ⊆ left.val :=
      (refinements left).subset hleft
    have hsubsetright : block ⊆ right.val :=
      (refinements right).subset hright
    obtain ⟨row, hrow⟩ :=
      (refinements left).nonempty_of_mem_parts hleft
    have heq : left.val = right.val :=
      coarse.eq_of_mem_parts left.property right.property
        (hsubsetleft hrow) (hsubsetright hrow)
    exact hne (Subtype.ext heq)

theorem partitionMobius_sum_refinements
    {t : ℕ} {rows : Finset (Fin t)} (coarse : Finpartition rows)
    [DecidablePred (fun fine : Finpartition rows => fine ≤ coarse)] :
    (∑ fine : {fine : Finpartition rows // fine ≤ coarse},
      partitionMobius fine.val) =
      ∏ block : coarse.parts,
        ∑ refinement : Finpartition block.val,
          partitionMobius refinement := by
  classical
  calc
    (∑ fine : {fine : Finpartition rows // fine ≤ coarse},
        partitionMobius fine.val) =
      ∑ refinements : ∀ block : coarse.parts, Finpartition block.val,
        partitionMobius
          (coarse.bind
            (fun block hblock => refinements ⟨block, hblock⟩)) := by
        apply Fintype.sum_equiv (partitionRefinementEquiv coarse)
        intro fine
        exact congrArg partitionMobius
          (congrArg Subtype.val
            ((partitionRefinementEquiv coarse).left_inv fine)).symm
    _ = ∑ refinements : ∀ block : coarse.parts, Finpartition block.val,
          ∏ block : coarse.parts, partitionMobius (refinements block) := by
      apply Finset.sum_congr rfl
      intro refinements _
      exact partitionMobius_bind coarse refinements
    _ = ∏ block : coarse.parts,
          ∑ refinement : Finpartition block.val,
            partitionMobius refinement :=
      (Fintype.prod_sum
        (fun block : coarse.parts =>
          fun refinement : Finpartition block.val =>
            partitionMobius refinement)).symm

theorem columnAssignmentFiberPartition_mobius_sum_refinements
    {t s : ℕ} (rows : Finset (Fin t)) (assignment : Fin t → Fin s)
    [DecidablePred (fun fine : Finpartition rows =>
      fine ≤ columnAssignmentFiberPartition rows assignment)] :
    (∑ fine : {fine : Finpartition rows //
        fine ≤ columnAssignmentFiberPartition rows assignment},
      partitionMobius fine.val) =
      if Set.InjOn assignment (rows : Set (Fin t)) then (1 : ℂ) else 0 := by
  classical
  let coarse := columnAssignmentFiberPartition rows assignment
  calc
    (∑ fine : {fine : Finpartition rows //
          fine ≤ columnAssignmentFiberPartition rows assignment},
        partitionMobius fine.val) =
      ∏ block : coarse.parts,
        ∑ refinement : Finpartition block.val,
          partitionMobius refinement :=
      partitionMobius_sum_refinements coarse
    _ = ∏ block ∈ coarse.parts,
          ∑ refinement : Finpartition block,
            partitionMobius refinement :=
      Finset.prod_coe_sort coarse.parts
        (fun block : Finset (Fin t) =>
          ∑ refinement : Finpartition block, partitionMobius refinement)
    _ = if Set.InjOn assignment (rows : Set (Fin t))
          then (1 : ℂ) else 0 :=
      columnAssignmentFiberPartition_mobius_product rows assignment

theorem partition_refines_columnAssignmentFiberPartition_iff
    {t s : ℕ} (rows : Finset (Fin t)) (assignment : Fin t → Fin s)
    (partition : Finpartition rows) :
    partition ≤ columnAssignmentFiberPartition rows assignment ↔
      ∀ block ∈ partition.parts,
        ∀ left ∈ block, ∀ right ∈ block,
          assignment left = assignment right := by
  classical
  let fiber := columnAssignmentFiberPartition rows assignment
  constructor
  · intro hrefine block hblock left hleft right hright
    obtain ⟨containing, hcontaining, hsubset⟩ := hrefine hblock
    have hpart : fiber.part left = containing :=
      fiber.part_eq_of_mem hcontaining (hsubset hleft)
    exact ((mem_columnAssignmentFiberPartition_part_iff
      rows assignment left right).mp (by
        change right ∈ fiber.part left
        rw [hpart]
        exact hsubset hright)).2.2
  · intro hconstant block hblock
    obtain ⟨left, hleft⟩ := partition.nonempty_of_mem_parts hblock
    have hleft_rows : left ∈ rows := partition.subset hblock hleft
    refine ⟨fiber.part left, fiber.part_mem.mpr hleft_rows, ?_⟩
    intro right hright
    have hright_rows : right ∈ rows := partition.subset hblock hright
    exact (mem_columnAssignmentFiberPartition_part_iff
      rows assignment left right).mpr
      ⟨hleft_rows, hright_rows,
        hconstant block hblock left hleft right hright⟩

noncomputable def partitionBlockRepresentative
    {α : Type*} [DecidableEq α] {rows : Finset α}
    (partition : Finpartition rows) (block : partition.parts) : rows :=
  ⟨Classical.choose (partition.nonempty_of_mem_parts block.property),
    partition.subset block.property
      (Classical.choose_spec
        (partition.nonempty_of_mem_parts block.property))⟩

theorem partitionBlockRepresentative_mem
    {α : Type*} [DecidableEq α] {rows : Finset α}
    (partition : Finpartition rows) (block : partition.parts) :
    (partitionBlockRepresentative partition block).val ∈ block.val :=
  Classical.choose_spec (partition.nonempty_of_mem_parts block.property)

noncomputable def partitionBlockAssignmentEquiv
    {α column : Type*} [DecidableEq α] {rows : Finset α}
    (partition : Finpartition rows) :
    (partition.parts → column) ≃
      {assignment : rows → column //
        ∀ (block : Finset α) (hblock : block ∈ partition.parts)
          (left : α) (hleft : left ∈ block)
          (right : α) (hright : right ∈ block),
          assignment ⟨left, partition.subset hblock hleft⟩ =
            assignment ⟨right, partition.subset hblock hright⟩} where
  toFun assignment :=
    ⟨fun row => assignment
      ⟨partition.part row.val, partition.part_mem.mpr row.property⟩, by
      intro block hblock left hleft right hright
      have hleftpart : partition.part left = block :=
        partition.part_eq_of_mem hblock hleft
      have hrightpart : partition.part right = block :=
        partition.part_eq_of_mem hblock hright
      exact congrArg assignment
        (Subtype.ext (hleftpart.trans hrightpart.symm))⟩
  invFun assignment block :=
    assignment.val (partitionBlockRepresentative partition block)
  left_inv assignment := by
    funext block
    change assignment
      ⟨partition.part (partitionBlockRepresentative partition block).val,
        _⟩ = assignment block
    apply congrArg assignment
    exact Subtype.ext
      (partition.part_eq_of_mem block.property
        (partitionBlockRepresentative_mem partition block))
  right_inv assignment := by
    apply Subtype.ext
    funext row
    change assignment.val
      (partitionBlockRepresentative partition
        ⟨partition.part row.val,
          partition.part_mem.mpr row.property⟩) = assignment.val row
    exact assignment.property (partition.part row.val)
      (partition.part_mem.mpr row.property)
      (partitionBlockRepresentative partition
        ⟨partition.part row.val,
          partition.part_mem.mpr row.property⟩).val
      (partitionBlockRepresentative_mem partition
        ⟨partition.part row.val,
          partition.part_mem.mpr row.property⟩)
      row.val (partition.mem_part row.property)

theorem partitionBlockAssignmentEquiv_prod
    {α column R : Type*} [DecidableEq α] [CommMonoid R]
    {rows : Finset α} (partition : Finpartition rows)
    (assignment : partition.parts → column)
    (weight : α → column → R) :
    (∏ block : partition.parts,
      ∏ row : block.val, weight row.val (assignment block)) =
      ∏ row : rows,
        weight row.val
          ((partitionBlockAssignmentEquiv partition assignment).val row) := by
  classical
  calc
    (∏ block : partition.parts,
        ∏ row : block.val, weight row.val (assignment block)) =
      ∏ entry : (Σ block : partition.parts, block.val),
        weight entry.2.val (assignment entry.1) :=
      (Fintype.prod_sigma
        (fun entry : (Σ block : partition.parts, block.val) =>
          weight entry.2.val (assignment entry.1))).symm
    _ = ∏ row : rows,
          weight row.val
            ((partitionBlockAssignmentEquiv partition assignment).val row) := by
      apply Fintype.prod_equiv partition.equivSigmaParts.symm
      intro entry
      change weight entry.2.val (assignment entry.1) =
        weight entry.2.val
          (assignment
            ⟨partition.part entry.2.val, _⟩)
      congr 1
      apply congrArg assignment
      apply Subtype.ext
      exact (partition.part_eq_of_mem entry.1.property
        entry.2.property).symm

theorem partition_block_assignment_sum_comm
    {t : ℕ} {column : Type*} [Fintype column] [DecidableEq column]
    {rows : Finset (Fin t)} (weight : Fin t → column → ℂ) :
    (∑ partition : Finpartition rows,
      partitionMobius partition *
        ∑ assignment : partition.parts → column,
          ∏ block : partition.parts,
            ∏ row : block.val, weight row.val (assignment block)) =
      ∑ assignment : rows → column,
        (∏ row : rows, weight row.val (assignment row)) *
          ∑ partition ∈
              (Finset.univ : Finset (Finpartition rows)).filter
                (fun partition =>
                  ∀ (block : Finset (Fin t))
                    (hblock : block ∈ partition.parts)
                    (left : Fin t) (hleft : left ∈ block)
                    (right : Fin t) (hright : right ∈ block),
                    assignment ⟨left, partition.subset hblock hleft⟩ =
                      assignment ⟨right, partition.subset hblock hright⟩),
            partitionMobius partition := by
  classical
  let compatible (partition : Finpartition rows)
      (assignment : rows → column) : Prop :=
    ∀ (block : Finset (Fin t)) (hblock : block ∈ partition.parts)
      (left : Fin t) (hleft : left ∈ block)
      (right : Fin t) (hright : right ∈ block),
      assignment ⟨left, partition.subset hblock hleft⟩ =
        assignment ⟨right, partition.subset hblock hright⟩
  calc
    (∑ partition : Finpartition rows,
      partitionMobius partition *
        ∑ assignment : partition.parts → column,
          ∏ block : partition.parts,
            ∏ row : block.val, weight row.val (assignment block)) =
      ∑ partition : Finpartition rows,
        ∑ assignment : partition.parts → column,
          partitionMobius partition *
            ∏ block : partition.parts,
              ∏ row : block.val, weight row.val (assignment block) := by
        simp_rw [Finset.mul_sum]
    _ = ∑ partition : Finpartition rows,
          ∑ assignment : {assignment : rows → column //
            compatible partition assignment},
            partitionMobius partition *
              ∏ row : rows, weight row.val (assignment.val row) := by
        apply Finset.sum_congr rfl
        intro partition _
        apply Fintype.sum_equiv (partitionBlockAssignmentEquiv partition)
        intro assignment
        congr 1
        exact partitionBlockAssignmentEquiv_prod
          partition assignment weight
    _ = ∑ partition : Finpartition rows,
          ∑ assignment : rows → column,
            if compatible partition assignment then
              partitionMobius partition *
                ∏ row : rows, weight row.val (assignment row)
            else 0 := by
        apply Finset.sum_congr rfl
        intro partition _
        rw [← Finset.sum_filter]
        exact (Finset.sum_subtype
          ((Finset.univ : Finset (rows → column)).filter
            (compatible partition))
          (by simp only [Finset.mem_filter, Finset.mem_univ, true_and, implies_true])
          (fun assignment : rows → column =>
            partitionMobius partition *
              ∏ row : rows, weight row.val (assignment row))).symm
    _ = ∑ assignment : rows → column,
          ∑ partition : Finpartition rows,
            if compatible partition assignment then
              partitionMobius partition *
                ∏ row : rows, weight row.val (assignment row)
            else 0 := Finset.sum_comm
    _ = ∑ assignment : rows → column,
          (∏ row : rows, weight row.val (assignment row)) *
            ∑ partition ∈
                (Finset.univ : Finset (Finpartition rows)).filter
                  (compatible · assignment),
              partitionMobius partition := by
        apply Finset.sum_congr rfl
        intro assignment _
        rw [Finset.mul_sum, ← Finset.sum_filter]
        apply Finset.sum_congr rfl
        intro partition _
        ac_rfl
    _ = _ := rfl

noncomputable def selectedRowAssignmentExtend
    {t s : ℕ} (rows : Finset (Fin t))
    (assignment : rows → Fin s) (defaultColumn : Fin s) : Fin t → Fin s :=
  fun row => if hrow : row ∈ rows then assignment ⟨row, hrow⟩ else defaultColumn

@[simp] theorem selectedRowAssignmentExtend_apply
    {t s : ℕ} (rows : Finset (Fin t))
    (assignment : rows → Fin s) (defaultColumn : Fin s) (row : rows) :
    selectedRowAssignmentExtend rows assignment defaultColumn row.val =
      assignment row := by
  classical
  simp only [selectedRowAssignmentExtend, row.property, ↓reduceDIte, Subtype.coe_eta]

theorem selectedRowAssignmentExtend_injOn_iff
    {t s : ℕ} (rows : Finset (Fin t))
    (assignment : rows → Fin s) (defaultColumn : Fin s) :
    Set.InjOn (selectedRowAssignmentExtend rows assignment defaultColumn)
        (rows : Set (Fin t)) ↔
      Function.Injective assignment := by
  classical
  constructor
  · intro hinj left right heq
    apply Subtype.ext
    apply hinj left.property right.property
    simpa only [selectedRowAssignmentExtend_apply] using heq
  · intro hinj left hleft right hright heq
    have hvalues :
        assignment ⟨left, hleft⟩ = assignment ⟨right, hright⟩ := by
      calc
        assignment ⟨left, hleft⟩ =
            selectedRowAssignmentExtend rows assignment defaultColumn left :=
          (selectedRowAssignmentExtend_apply rows assignment
            defaultColumn ⟨left, hleft⟩).symm
        _ = selectedRowAssignmentExtend rows assignment
            defaultColumn right := heq
        _ = assignment ⟨right, hright⟩ :=
          selectedRowAssignmentExtend_apply rows assignment
            defaultColumn ⟨right, hright⟩
    exact congrArg Subtype.val (hinj hvalues)

theorem selectedRowAssignment_mobius_sum_refinements
    {t s : ℕ} (rows : Finset (Fin t))
    (assignment : rows → Fin s) (defaultColumn : Fin s)
    [DecidablePred (fun fine : Finpartition rows =>
      fine ≤ columnAssignmentFiberPartition rows
        (selectedRowAssignmentExtend rows assignment defaultColumn))] :
    (∑ fine : {fine : Finpartition rows //
        fine ≤ columnAssignmentFiberPartition rows
          (selectedRowAssignmentExtend rows assignment defaultColumn)},
      partitionMobius fine.val) =
      if Function.Injective assignment then (1 : ℂ) else 0 := by
  classical
  rw [columnAssignmentFiberPartition_mobius_sum_refinements]
  by_cases hinj : Function.Injective assignment
  · rw [if_pos hinj, if_pos
      ((selectedRowAssignmentExtend_injOn_iff
        rows assignment defaultColumn).mpr hinj)]
  · rw [if_neg hinj, if_neg]
    intro hextend
    exact hinj ((selectedRowAssignmentExtend_injOn_iff
      rows assignment defaultColumn).mp hextend)

theorem selectedRowAssignment_partitionMobius_filter_sum
    {t s : ℕ} (rows : Finset (Fin t))
    (assignment : rows → Fin s) (defaultColumn : Fin s) :
    (∑ partition ∈
        (Finset.univ : Finset (Finpartition rows)).filter
          (fun partition =>
            ∀ (block : Finset (Fin t))
              (hblock : block ∈ partition.parts)
              (left : Fin t) (hleft : left ∈ block)
              (right : Fin t) (hright : right ∈ block),
              assignment ⟨left, partition.subset hblock hleft⟩ =
                assignment ⟨right, partition.subset hblock hright⟩),
      partitionMobius partition) =
      if Function.Injective assignment then (1 : ℂ) else 0 := by
  classical
  let extended := selectedRowAssignmentExtend rows assignment defaultColumn
  let fiber := columnAssignmentFiberPartition rows extended
  have hcompatible (partition : Finpartition rows) :
      (∀ (block : Finset (Fin t)) (hblock : block ∈ partition.parts)
        (left : Fin t) (hleft : left ∈ block)
        (right : Fin t) (hright : right ∈ block),
        assignment ⟨left, partition.subset hblock hleft⟩ =
          assignment ⟨right, partition.subset hblock hright⟩) ↔
        partition ≤ fiber := by
    rw [partition_refines_columnAssignmentFiberPartition_iff]
    constructor
    · intro hconstant block hblock left hleft right hright
      have hleft_rows := partition.subset hblock hleft
      have hright_rows := partition.subset hblock hright
      change extended left = extended right
      change
        selectedRowAssignmentExtend rows assignment defaultColumn left =
          selectedRowAssignmentExtend rows assignment defaultColumn right
      rw [selectedRowAssignmentExtend_apply rows assignment
        defaultColumn ⟨left, hleft_rows⟩,
        selectedRowAssignmentExtend_apply rows assignment
          defaultColumn ⟨right, hright_rows⟩]
      exact hconstant block hblock left hleft right hright
    · intro hconstant block hblock left hleft right hright
      have hleft_rows := partition.subset hblock hleft
      have hright_rows := partition.subset hblock hright
      have heq := hconstant block hblock left hleft right hright
      change extended left = extended right at heq
      change
        selectedRowAssignmentExtend rows assignment defaultColumn left =
          selectedRowAssignmentExtend rows assignment defaultColumn right
        at heq
      rw [selectedRowAssignmentExtend_apply rows assignment
        defaultColumn ⟨left, hleft_rows⟩,
        selectedRowAssignmentExtend_apply rows assignment
          defaultColumn ⟨right, hright_rows⟩] at heq
      exact heq
  calc
    (∑ partition ∈
        (Finset.univ : Finset (Finpartition rows)).filter
          (fun partition =>
            ∀ (block : Finset (Fin t))
              (hblock : block ∈ partition.parts)
              (left : Fin t) (hleft : left ∈ block)
              (right : Fin t) (hright : right ∈ block),
              assignment ⟨left, partition.subset hblock hleft⟩ =
                assignment ⟨right, partition.subset hblock hright⟩),
      partitionMobius partition) =
      ∑ partition ∈
        (Finset.univ : Finset (Finpartition rows)).filter
          (fun partition => partition ≤ fiber),
        partitionMobius partition := by
        apply Finset.sum_congr
        · ext partition
          simp only [Finset.mem_filter, Finset.mem_univ, true_and]
          exact hcompatible partition
        · intro partition _
          rfl
    _ = ∑ partition : {partition : Finpartition rows // partition ≤ fiber},
        partitionMobius partition.val := by
      apply Finset.sum_subtype
      intro partition
      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    _ = if Function.Injective assignment then (1 : ℂ) else 0 :=
      selectedRowAssignment_mobius_sum_refinements
        rows assignment defaultColumn

theorem excludedColumnAssignment_partitionMobius_filter_sum
    {t s : ℕ} (rows : Finset (Fin t)) (excluded : Fin s)
    (assignment : rows → {column : Fin s // column ≠ excluded}) :
    (∑ partition ∈
        (Finset.univ : Finset (Finpartition rows)).filter
          (fun partition =>
            ∀ (block : Finset (Fin t))
              (hblock : block ∈ partition.parts)
              (left : Fin t) (hleft : left ∈ block)
              (right : Fin t) (hright : right ∈ block),
              assignment ⟨left, partition.subset hblock hleft⟩ =
                assignment ⟨right, partition.subset hblock hright⟩),
      partitionMobius partition) =
      if Function.Injective assignment then (1 : ℂ) else 0 := by
  classical
  let raw : rows → Fin s := fun row => (assignment row).val
  have hinj : Function.Injective raw ↔ Function.Injective assignment := by
    constructor
    · intro hraw left right heq
      apply hraw
      exact congrArg Subtype.val heq
    · intro hassignment left right heq
      apply hassignment
      exact Subtype.ext heq
  calc
    (∑ partition ∈
        (Finset.univ : Finset (Finpartition rows)).filter
          (fun partition =>
            ∀ (block : Finset (Fin t))
              (hblock : block ∈ partition.parts)
              (left : Fin t) (hleft : left ∈ block)
              (right : Fin t) (hright : right ∈ block),
              assignment ⟨left, partition.subset hblock hleft⟩ =
                assignment ⟨right, partition.subset hblock hright⟩),
      partitionMobius partition) =
      ∑ partition ∈
        (Finset.univ : Finset (Finpartition rows)).filter
          (fun partition =>
            ∀ (block : Finset (Fin t))
              (hblock : block ∈ partition.parts)
              (left : Fin t) (hleft : left ∈ block)
              (right : Fin t) (hright : right ∈ block),
              raw ⟨left, partition.subset hblock hleft⟩ =
                raw ⟨right, partition.subset hblock hright⟩),
        partitionMobius partition := by
          apply Finset.sum_congr
          · ext partition
            simp only [Finset.mem_filter, Finset.mem_univ, true_and]
            constructor
            · intro hconstant block hblock left hleft right hright
              exact congrArg Subtype.val
                (hconstant block hblock left hleft right hright)
            · intro hconstant block hblock left hleft right hright
              exact Subtype.ext
                (hconstant block hblock left hleft right hright)
          · intro partition _
            rfl
    _ = if Function.Injective raw then (1 : ℂ) else 0 :=
      selectedRowAssignment_partitionMobius_filter_sum
        rows raw excluded
    _ = if Function.Injective assignment then (1 : ℂ) else 0 := by
      by_cases hassignment : Function.Injective assignment
      · rw [if_pos hassignment, if_pos (hinj.mpr hassignment)]
      · rw [if_neg hassignment, if_neg]
        exact fun hraw => hassignment (hinj.mp hraw)

theorem partitionMobius_excluded_columns_eq_embeddings
    (t s : ℕ) (point : Fin t × Fin s → ℂ) (excluded : Fin s)
    (rows : Finset (Fin t)) :
    (∑ partition : Finpartition rows,
      partitionMobius partition *
        ∏ block ∈ partition.parts,
          ∑ other ∈ (Finset.univ : Finset (Fin s)).erase excluded,
            ∏ row ∈ block, point (row, other)) =
      ∑ embedding : rows ↪ {column : Fin s // column ≠ excluded},
        ∏ row : rows, point (row.val, (embedding row).val) := by
  classical
  let column := {column : Fin s // column ≠ excluded}
  let weight : Fin t → column → ℂ :=
    fun row other => point (row, other.val)
  have hblock (block : Finset (Fin t)) :
      (∑ other ∈ (Finset.univ : Finset (Fin s)).erase excluded,
        ∏ row ∈ block, point (row, other)) =
      ∑ other : column,
        ∏ row : block, weight row.val other := by
    calc
      (∑ other ∈ (Finset.univ : Finset (Fin s)).erase excluded,
        ∏ row ∈ block, point (row, other)) =
        ∑ other ∈ (Finset.univ : Finset (Fin s)).erase excluded,
          ∏ row : block, point (row.val, other) := by
          apply Finset.sum_congr rfl
          intro other _
          exact (Finset.prod_coe_sort block
            (fun row => point (row, other))).symm
      _ = ∑ other : column,
          ∏ row : block, weight row.val other := by
        apply Finset.sum_subtype
        intro other
        simp only [Finset.mem_erase, ne_eq, ne_comm, Finset.mem_univ, and_true]
  calc
    (∑ partition : Finpartition rows,
      partitionMobius partition *
        ∏ block ∈ partition.parts,
          ∑ other ∈ (Finset.univ : Finset (Fin s)).erase excluded,
            ∏ row ∈ block, point (row, other)) =
      ∑ partition : Finpartition rows,
        partitionMobius partition *
          ∑ assignment : partition.parts → column,
            ∏ block : partition.parts,
              ∏ row : block.val,
                weight row.val (assignment block) := by
        apply Finset.sum_congr rfl
        intro partition _
        congr 1
        calc
          (∏ block ∈ partition.parts,
            ∑ other ∈ (Finset.univ : Finset (Fin s)).erase excluded,
              ∏ row ∈ block, point (row, other)) =
            ∏ block : partition.parts,
              ∑ other ∈ (Finset.univ : Finset (Fin s)).erase excluded,
                ∏ row ∈ block.val, point (row, other) :=
              (Finset.prod_coe_sort partition.parts
                (fun block =>
                  ∑ other ∈
                    (Finset.univ : Finset (Fin s)).erase excluded,
                    ∏ row ∈ block, point (row, other))).symm
          _ = ∏ block : partition.parts,
                ∑ other : column,
                  ∏ row : block.val, weight row.val other := by
              apply Finset.prod_congr rfl
              intro block _
              exact hblock block.val
          _ = ∑ assignment : partition.parts → column,
                ∏ block : partition.parts,
                  ∏ row : block.val,
                    weight row.val (assignment block) :=
              Fintype.prod_sum
                (fun block : partition.parts =>
                  fun other : column =>
                    ∏ row : block.val, weight row.val other)
    _ = ∑ assignment : rows → column,
          (∏ row : rows, weight row.val (assignment row)) *
            ∑ partition ∈
                (Finset.univ : Finset (Finpartition rows)).filter
                  (fun partition =>
                    ∀ (block : Finset (Fin t))
                      (hblock : block ∈ partition.parts)
                      (left : Fin t) (hleft : left ∈ block)
                      (right : Fin t) (hright : right ∈ block),
                      assignment
                          ⟨left, partition.subset hblock hleft⟩ =
                        assignment
                          ⟨right, partition.subset hblock hright⟩),
              partitionMobius partition :=
      partition_block_assignment_sum_comm weight
    _ = ∑ assignment : rows → column,
          (∏ row : rows, weight row.val (assignment row)) *
            if Function.Injective assignment then (1 : ℂ) else 0 := by
        apply Finset.sum_congr rfl
        intro assignment _
        congr 1
        exact excludedColumnAssignment_partitionMobius_filter_sum
          rows excluded assignment
    _ = ∑ assignment ∈
            (Finset.univ : Finset (rows → column)).filter
              Function.Injective,
          ∏ row : rows, weight row.val (assignment row) := by
        rw [Finset.sum_filter]
        apply Finset.sum_congr rfl
        intro assignment _
        split <;> simp
    _ = ∑ assignment : {assignment : rows → column //
            Function.Injective assignment},
          ∏ row : rows, weight row.val (assignment.val row) := by
        apply Finset.sum_subtype
        intro assignment
        simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    _ = ∑ embedding : rows ↪ column,
          ∏ row : rows, weight row.val (embedding row) := by
        apply Fintype.sum_equiv
          (Equiv.subtypeInjectiveEquivEmbedding rows column)
        intro assignment
        rfl
    _ = _ := rfl

theorem eval_partitionDerivative_eq_excluded_embeddings
    (t s d : ℕ) (point : Fin t × Fin s → ℂ)
    (i : Fin t) (excluded : Fin s) :
    MvPolynomial.eval (fun row => point (row, excluded))
        (partitionDerivative t d i
          (fun block => MvPolynomial.eval point (powerSum t s block))) =
      ∑ rows ∈
          ((Finset.univ : Finset (Fin t)).erase i).powersetCard (d - 1),
        ∑ embedding : rows ↪ {column : Fin s // column ≠ excluded},
          ∏ row : rows, point (row.val, (embedding row).val) := by
  classical
  rw [eval_partitionDerivative_excluded_columns]
  apply Finset.sum_congr rfl
  intro rows _
  exact partitionMobius_excluded_columns_eq_embeddings
    t s point excluded rows

theorem eval_minorSum_pderiv_eq_partitionDerivative
    (t s d : ℕ) (hd : 0 < d)
    (point : Fin t × Fin s → ℂ) (i : Fin t) (column : Fin s) :
    MvPolynomial.eval point
        (MvPolynomial.pderiv (i, column) (minorSum t s d)) =
      MvPolynomial.eval (fun row => point (row, column))
        (partitionDerivative t d i
          (fun block => MvPolynomial.eval point (powerSum t s block))) := by
  calc
    MvPolynomial.eval point
        (MvPolynomial.pderiv (i, column) (minorSum t s d)) =
      ∑ rows ∈
          ((Finset.univ : Finset (Fin t)).erase i).powersetCard (d - 1),
        ∑ embedding : rows ↪ {other : Fin s // other ≠ column},
          ∏ row : rows, point (row.val, (embedding row).val) :=
      eval_minorSum_pderiv_eq_excluded_embeddings t s d hd point i column
    _ = MvPolynomial.eval (fun row => point (row, column))
          (partitionDerivative t d i
            (fun block => MvPolynomial.eval point (powerSum t s block))) :=
      (eval_partitionDerivative_eq_excluded_embeddings
        t s d point i column).symm

end Standalone_PartitionInversion

section Standalone_Incidence

open scoped BigOperators

abbrev IncidenceRowBlock (t : ℕ) :=
  {block : Finset (Fin t) // block.Nonempty}

abbrev IncidenceParameter (t : ℕ) := IncidenceRowBlock t → ℂ

abbrev IncidenceColumns (t s : ℕ) := Fin s → Fin t → ℂ

noncomputable def incidenceParameterExtend {t : ℕ}
    (p : IncidenceParameter t) (block : Finset (Fin t)) : ℂ :=
  if h : block.Nonempty then p ⟨block, h⟩ else 0

@[simp] theorem incidenceParameterExtend_nonempty {t : ℕ}
    (p : IncidenceParameter t) (block : Finset (Fin t))
    (hblock : block.Nonempty) :
    incidenceParameterExtend p block = p ⟨block, hblock⟩ := by
  simp only [incidenceParameterExtend, hblock, ↓reduceDIte]

theorem incidence_partitionBlockFactor_congr_of_nonempty {t : ℕ}
    (p q : Finset (Fin t) → ℂ)
    (h : ∀ block : Finset (Fin t), block.Nonempty → p block = q block)
    {rows : Finset (Fin t)} (partition : Finpartition rows) :
    partitionBlockFactor p partition = partitionBlockFactor q partition := by
  classical
  unfold partitionBlockFactor
  apply Finset.prod_congr rfl
  intro block hblock
  rw [h block (partition.nonempty_of_mem_parts hblock)]

theorem incidence_partitionDerivative_congr_of_nonempty
    (t d : ℕ) (i : Fin t) (p q : Finset (Fin t) → ℂ)
    (h : ∀ block : Finset (Fin t), block.Nonempty → p block = q block) :
    partitionDerivative t d i p = partitionDerivative t d i q := by
  classical
  unfold partitionDerivative
  apply Finset.sum_congr rfl
  intro rows _
  apply Finset.sum_congr rfl
  intro partition _
  rw [incidence_partitionBlockFactor_congr_of_nonempty p q h partition]

noncomputable def partitionFiberCoordinateEsymmPolynomial
    (t q : ℕ) : MvPolynomial (Fin t) ℂ :=
  MvPolynomial.esymm (Fin t) ℂ q

theorem partitionFiberCoordinateEsymmPolynomial_succ_eq_deleted
    (t q : ℕ) (i : Fin t) :
    partitionFiberCoordinateEsymmPolynomial t (q + 1) =
      deletedCoordinateEsymmPolynomial t (q + 1) i +
        MvPolynomial.X i * deletedCoordinateEsymmPolynomial t q i := by
  classical
  apply MvPolynomial.funext
  intro u
  have heval :
      MvPolynomial.eval u
          (partitionFiberCoordinateEsymmPolynomial t (q + 1)) =
        coordinateEsymm u (q + 1) := by
    rw [partitionFiberCoordinateEsymmPolynomial, MvPolynomial.esymm,
      coordinateEsymm, Finset.esymm_map_val]
    simp only [map_sum, map_prod, MvPolynomial.eval_X]
  simp only [map_add, map_mul, MvPolynomial.eval_X]
  rw [heval, eval_deletedCoordinateEsymmPolynomial,
    eval_deletedCoordinateEsymmPolynomial]
  exact coordinateEsymm_succ_eq_deleted u i q

theorem sum_deletedCoordinateEsymmPolynomial (t q : ℕ) :
    (∑ i : Fin t, deletedCoordinateEsymmPolynomial t q i) =
      MvPolynomial.C ((t - q : ℕ) : ℂ) *
        partitionFiberCoordinateEsymmPolynomial t q := by
  classical
  apply MvPolynomial.funext
  intro u
  have heval :
      MvPolynomial.eval u
          (partitionFiberCoordinateEsymmPolynomial t q) =
        coordinateEsymm u q := by
    rw [partitionFiberCoordinateEsymmPolynomial, MvPolynomial.esymm,
      coordinateEsymm, Finset.esymm_map_val]
    simp only [map_sum, map_prod, MvPolynomial.eval_X]
  simp only [map_sum, map_mul, MvPolynomial.eval_C]
  simp_rw [eval_deletedCoordinateEsymmPolynomial]
  rw [heval]
  exact sum_deletedCoordinateEsymm u q

theorem deletedCoordinateEsymmPolynomial_eq_alternating
    (t : ℕ) (i : Fin t) (q : ℕ) :
    deletedCoordinateEsymmPolynomial t q i =
      ∑ j ∈ Finset.range (q + 1),
        (-MvPolynomial.X i) ^ (q - j) *
          partitionFiberCoordinateEsymmPolynomial t j := by
  classical
  induction q with
  | zero =>
      simp only [deletedCoordinateEsymmPolynomial, Multiset.esymm, Finset.erase_val,
        Multiset.powersetCard_zero_left, Multiset.map_singleton, Multiset.prod_zero, Multiset.sum_singleton, zero_add,
        Finset.range_one, zero_tsub, pow_zero, partitionFiberCoordinateEsymmPolynomial, MvPolynomial.esymm, one_mul,
        Finset.sum_singleton, Finset.powersetCard_zero, Finset.prod_empty]
  | succ q ih =>
      have hrec :=
        partitionFiberCoordinateEsymmPolynomial_succ_eq_deleted t q i
      have hdeleted :
          deletedCoordinateEsymmPolynomial t (q + 1) i =
            partitionFiberCoordinateEsymmPolynomial t (q + 1) -
              MvPolynomial.X i * deletedCoordinateEsymmPolynomial t q i := by
        linear_combination -hrec
      have hsum :
          (∑ j ∈ Finset.range (q + 1),
            (-MvPolynomial.X i) ^ (q + 1 - j) *
              partitionFiberCoordinateEsymmPolynomial t j) =
            -(MvPolynomial.X i *
              ∑ j ∈ Finset.range (q + 1),
                (-MvPolynomial.X i) ^ (q - j) *
                  partitionFiberCoordinateEsymmPolynomial t j) := by
        rw [Finset.mul_sum, ← Finset.sum_neg_distrib]
        apply Finset.sum_congr rfl
        intro j hj
        have hjle : j ≤ q := by
          have hjrange := Finset.mem_range.mp hj
          omega
        rw [show q + 1 - j = (q - j) + 1 by omega, pow_succ]
        ring
      have hfinal :
          (∑ j ∈ Finset.range (q + 1 + 1),
            (-MvPolynomial.X i) ^ (q + 1 - j) *
              partitionFiberCoordinateEsymmPolynomial t j) =
            (∑ j ∈ Finset.range (q + 1),
              (-MvPolynomial.X i) ^ (q + 1 - j) *
                partitionFiberCoordinateEsymmPolynomial t j) +
              partitionFiberCoordinateEsymmPolynomial t (q + 1) := by
        rw [Finset.sum_range_succ]
        simp only [tsub_self, pow_zero, one_mul]
      calc
        deletedCoordinateEsymmPolynomial t (q + 1) i =
            partitionFiberCoordinateEsymmPolynomial t (q + 1) -
              MvPolynomial.X i * deletedCoordinateEsymmPolynomial t q i :=
          hdeleted
        _ = partitionFiberCoordinateEsymmPolynomial t (q + 1) -
              MvPolynomial.X i *
                ∑ j ∈ Finset.range (q + 1),
                  (-MvPolynomial.X i) ^ (q - j) *
                    partitionFiberCoordinateEsymmPolynomial t j := by
          rw [ih]
        _ = ∑ j ∈ Finset.range (q + 1 + 1),
              (-MvPolynomial.X i) ^ (q + 1 - j) *
                partitionFiberCoordinateEsymmPolynomial t j := by
          rw [hfinal, hsum]
          ring

noncomputable def minorSumPowerParameters (t s : ℕ)
    (x : Fin t × Fin s → ℂ) : IncidenceParameter t :=
  fun block => MvPolynomial.eval x (powerSum t s block.1)

theorem partitionDerivative_incidencePowerParameters
    (t s d : ℕ) (x : Fin t × Fin s → ℂ) (i : Fin t) :
    partitionDerivative t d i
        (incidenceParameterExtend (minorSumPowerParameters t s x)) =
      partitionDerivative t d i
        (fun block => MvPolynomial.eval x (powerSum t s block)) := by
  apply incidence_partitionDerivative_congr_of_nonempty
  intro block hblock
  simp only [incidenceParameterExtend, hblock, ↓reduceDIte, minorSumPowerParameters]

theorem eval_minorSum_pderiv_eq_incidencePartitionDerivative
    (t s d : ℕ) (hd : 0 < d)
    (x : Fin t × Fin s → ℂ) (i : Fin t) (a : Fin s) :
    MvPolynomial.eval x
        (MvPolynomial.pderiv (i, a) (minorSum t s d)) =
      MvPolynomial.eval (fun j => x (j, a))
        (partitionDerivative t d i
          (incidenceParameterExtend (minorSumPowerParameters t s x))) := by
  rw [eval_minorSum_pderiv_eq_partitionDerivative t s d hd x i a]
  rw [partitionDerivative_incidencePowerParameters]

def minorSumColumns (t s : ℕ)
    (x : Fin t × Fin s → ℂ) : IncidenceColumns t s :=
  fun a i => x (i, a)

theorem incidenceRowBlock_card (t : ℕ) :
    Fintype.card (IncidenceRowBlock t) = 2 ^ t - 1 := by
  classical
  rw [Fintype.card_subtype]
  simp_rw [Finset.nonempty_iff_ne_empty]
  rw [Finset.filter_ne', Finset.card_erase_of_mem (Finset.mem_univ _)]
  simp only [Finset.card_univ, Fintype.card_finset, Fintype.card_fin]

abbrev IncidenceCoordinate (t s : ℕ) :=
  IncidenceRowBlock t ⊕ (Fin s × Fin t)

def incidenceCoordinatePoint (t s : ℕ)
    (p : IncidenceParameter t) (columns : IncidenceColumns t s) :
    IncidenceCoordinate t s → ℂ :=
  Sum.elim p (fun coordinate => columns coordinate.1 coordinate.2)

noncomputable def partitionIncidenceEquation (t s d : ℕ)
    (a : Fin s) (i : Fin t) : MvPolynomial (IncidenceCoordinate t s) ℂ :=
  ∑ rows ∈ ((Finset.univ : Finset (Fin t)).erase i).powersetCard (d - 1),
    ∑ partition : Finpartition rows,
      MvPolynomial.C (partitionMobius partition) *
        ∏ block ∈ partition.parts.attach,
          (MvPolynomial.X
              (Sum.inl ⟨block.1,
                partition.nonempty_of_mem_parts block.2⟩) -
            ∏ row ∈ block.1,
              MvPolynomial.X (Sum.inr (a, row)))

theorem eval_partitionIncidenceEquation (t s d : ℕ)
    (p : IncidenceParameter t) (columns : IncidenceColumns t s)
    (a : Fin s) (i : Fin t) :
    MvPolynomial.eval (incidenceCoordinatePoint t s p columns)
        (partitionIncidenceEquation t s d a i) =
      MvPolynomial.eval (columns a)
        (partitionDerivative t d i (incidenceParameterExtend p)) := by
  classical
  simp only [partitionIncidenceEquation, partitionDerivative,
    partitionBlockFactor, map_sum, map_mul, map_prod, map_sub,
    MvPolynomial.eval_C, MvPolynomial.eval_X,
    incidenceCoordinatePoint]
  apply Finset.sum_congr rfl
  intro rows _
  apply Finset.sum_congr rfl
  intro partition _
  congr 1
  calc
    (∏ block ∈ partition.parts.attach,
        (p ⟨block.1, partition.nonempty_of_mem_parts block.2⟩ -
          ∏ row ∈ block.1, columns a row)) =
        ∏ block ∈ partition.parts.attach,
          (incidenceParameterExtend p block.1 -
            ∏ row ∈ block.1, columns a row) := by
      apply Finset.prod_congr rfl
      intro block _
      rw [incidenceParameterExtend_nonempty p block.1
        (partition.nonempty_of_mem_parts block.2)]
    _ = ∏ block ∈ partition.parts,
          (incidenceParameterExtend p block -
            ∏ row ∈ block, columns a row) :=
      Finset.prod_attach partition.parts
        (fun block => incidenceParameterExtend p block -
          ∏ row ∈ block, columns a row)

noncomputable def partitionIncidenceIdeal (t s d : ℕ) :
    Ideal (MvPolynomial (IncidenceCoordinate t s) ℂ) :=
  Ideal.span
    (Set.range fun coordinate : Fin s × Fin t =>
      partitionIncidenceEquation t s d coordinate.1 coordinate.2)

theorem partitionIncidence_monicReduction_mem
    (t s d : ℕ) (column : Fin s) (i : Fin t) :
    let q := d - 1
    let k : ℂ := ((t - q : ℕ) : ℂ)
    let a : ℂ := (-1 : ℂ) ^ q * (q.factorial : ℂ)
    let embed : Fin t → IncidenceCoordinate t s :=
      fun row => Sum.inr (column, row)
    let D : Fin t → MvPolynomial (IncidenceCoordinate t s) ℂ :=
      fun row => MvPolynomial.rename embed
        (deletedCoordinateEsymmPolynomial t q row)
    let E : ℕ → MvPolynomial (IncidenceCoordinate t s) ℂ :=
      fun j => MvPolynomial.rename embed
        (partitionFiberCoordinateEsymmPolynomial t j)
    let R : Fin t → MvPolynomial (IncidenceCoordinate t s) ℂ :=
      fun row => partitionIncidenceEquation t s d column row -
        MvPolynomial.C a * D row
    MvPolynomial.C k *
        (MvPolynomial.C a *
          (∑ j ∈ Finset.range q,
            (-MvPolynomial.X (Sum.inr (column, i))) ^ (q - j) * E j) +
          R i) -
        ∑ row : Fin t, R row ∈ partitionIncidenceIdeal t s d := by
  classical
  dsimp
  let q := d - 1
  let k : ℂ := ((t - q : ℕ) : ℂ)
  let a : ℂ := (-1 : ℂ) ^ q * (q.factorial : ℂ)
  let embed : Fin t → IncidenceCoordinate t s :=
    fun row => Sum.inr (column, row)
  let Q : Fin t → MvPolynomial (IncidenceCoordinate t s) ℂ :=
    fun row => partitionIncidenceEquation t s d column row
  let D : Fin t → MvPolynomial (IncidenceCoordinate t s) ℂ :=
    fun row => MvPolynomial.rename embed
      (deletedCoordinateEsymmPolynomial t q row)
  let E : ℕ → MvPolynomial (IncidenceCoordinate t s) ℂ :=
    fun j => MvPolynomial.rename embed
      (partitionFiberCoordinateEsymmPolynomial t j)
  let R : Fin t → MvPolynomial (IncidenceCoordinate t s) ℂ :=
    fun row => Q row - MvPolynomial.C a * D row
  have hsource (row : Fin t) :
      Q row = MvPolynomial.C a * D row + R row := by
    dsimp [R]
    ring
  have hsumD :
      (∑ row : Fin t, D row) = MvPolynomial.C k * E q := by
    have h := congrArg
      (MvPolynomial.rename embed)
      (sum_deletedCoordinateEsymmPolynomial t q)
    simpa [D, E, k, map_sum, map_mul] using h
  have hdeleted :
      D i =
        (∑ j ∈ Finset.range q,
          (-MvPolynomial.X (Sum.inr (column, i))) ^ (q - j) * E j) +
        E q := by
    have h := congrArg
      (MvPolynomial.rename embed)
      (deletedCoordinateEsymmPolynomial_eq_alternating t i q)
    rw [Finset.sum_range_succ] at h
    simpa only [tsub_self, pow_zero, one_mul, map_add, map_sum, map_mul, map_pow, map_neg,
      MvPolynomial.rename_X] using h
  have hsumQ :
      (∑ row : Fin t, Q row) =
        MvPolynomial.C a * MvPolynomial.C k * E q +
          ∑ row : Fin t, R row := by
    simp_rw [hsource]
    rw [Finset.sum_add_distrib, ← Finset.mul_sum, hsumD]
    ring
  change
    MvPolynomial.C k *
        (MvPolynomial.C a *
          (∑ j ∈ Finset.range q,
            (-MvPolynomial.X (Sum.inr (column, i))) ^ (q - j) * E j) +
          R i) -
        ∑ row : Fin t, R row ∈ partitionIncidenceIdeal t s d
  have heq :
      MvPolynomial.C k *
          (MvPolynomial.C a *
            (∑ j ∈ Finset.range q,
              (-MvPolynomial.X (Sum.inr (column, i))) ^ (q - j) * E j) +
            R i) -
          ∑ row : Fin t, R row =
        MvPolynomial.C k * Q i - ∑ row : Fin t, Q row := by
    rw [hsource i, hdeleted, hsumQ]
    ring
  rw [heq]
  apply Ideal.sub_mem
  · apply Ideal.mul_mem_left
    apply Ideal.subset_span
    exact ⟨(column, i), rfl⟩
  · apply Ideal.sum_mem
    intro row _
    apply Ideal.subset_span
    exact ⟨(column, row), rfl⟩

theorem incidence_mvPolynomial_totalDegree_map_le
    {σ R S : Type*} [CommSemiring R] [CommSemiring S]
    (f : R →+* S) (g : MvPolynomial σ R) :
    (MvPolynomial.map f g).totalDegree ≤ g.totalDegree := by
  classical
  unfold MvPolynomial.totalDegree
  exact Finset.sup_mono (MvPolynomial.support_map_subset f g)

abbrev PartitionIncidenceCoordinateRing (t s d : ℕ) :=
  MvPolynomial (IncidenceCoordinate t s) ℂ ⧸
    partitionIncidenceIdeal t s d

noncomputable def partitionIncidenceGlobalBaseProjection
    (t s d : ℕ) :
    MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ →ₐ[ℂ]
      PartitionIncidenceCoordinateRing t s d :=
  MvPolynomial.aeval (Sum.elim
    (fun block =>
      Ideal.Quotient.mk (partitionIncidenceIdeal t s d)
        (MvPolynomial.X (Sum.inl block)))
    (fun coordinate =>
      Ideal.Quotient.mk (partitionIncidenceIdeal t s d)
        (MvPolynomial.rename
          (fun row : Fin t => Sum.inr (coordinate.1, row))
          (partitionFiberCoordinateEsymmPolynomial t
            (coordinate.2.val + 1)))))

noncomputable abbrev partitionIncidenceGlobalBaseAlgebra
    (t s d : ℕ) :
    Algebra
      (MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)
      (PartitionIncidenceCoordinateRing t s d) :=
  (partitionIncidenceGlobalBaseProjection t s d).toRingHom.toAlgebra

noncomputable def partitionIncidenceGlobalColumnLift
    (t s d : ℕ) :
    MvPolynomial (IncidenceCoordinate t s) ℂ →+*
      MvPolynomial (Fin s × Fin t)
        (MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ) :=
  MvPolynomial.eval₂Hom
    ((MvPolynomial.C :
      MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ →+*
        MvPolynomial (Fin s × Fin t)
          (MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)).comp
      (MvPolynomial.C : ℂ →+*
        MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ))
    (Sum.elim
      (fun block : IncidenceRowBlock t =>
        MvPolynomial.C (MvPolynomial.X (Sum.inl block)))
      (fun coordinate : Fin s × Fin t => MvPolynomial.X coordinate))

theorem partitionIncidenceGlobalColumnLift_aeval
    (t s d : ℕ) (f : MvPolynomial (IncidenceCoordinate t s) ℂ) :
    letI := partitionIncidenceGlobalBaseAlgebra t s d
    MvPolynomial.aeval
      (fun coordinate : Fin s × Fin t =>
        Ideal.Quotient.mk (partitionIncidenceIdeal t s d)
          (MvPolynomial.X (Sum.inr coordinate)))
      (partitionIncidenceGlobalColumnLift t s d f) =
      Ideal.Quotient.mk (partitionIncidenceIdeal t s d) f := by
  classical
  letI := partitionIncidenceGlobalBaseAlgebra t s d
  haveI : Module (MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)
      (MvPolynomial (IncidenceCoordinate t s) ℂ ⧸ partitionIncidenceIdeal t s d) :=
    Algebra.toModule
  induction f using MvPolynomial.induction_on with
  | C c =>
      calc
        _ = algebraMap
            (MvPolynomial
              (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)
            (PartitionIncidenceCoordinateRing t s d)
            (MvPolynomial.C c) := by
          simp only [partitionIncidenceGlobalColumnLift, MvPolynomial.eval₂Hom_C, RingHom.coe_comp, Function.comp_apply,
            MvPolynomial.algHom_C]
        _ = Ideal.Quotient.mk (partitionIncidenceIdeal t s d)
            (MvPolynomial.C c) := by
          change partitionIncidenceGlobalBaseProjection t s d
              (MvPolynomial.C c) = _
          simpa only [partitionIncidenceGlobalBaseProjection, MvPolynomial.algHom_C, MvPolynomial.algebraMap_eq] using
            (Ideal.Quotient.mk_algebraMap (R₁ := ℂ) (partitionIncidenceIdeal t s d) c).symm
  | add f g hf hg =>
      simp only [map_add, hf, hg]
  | mul_X f coordinate hf =>
      calc
        _ = Ideal.Quotient.mk (partitionIncidenceIdeal t s d) f *
            MvPolynomial.aeval
              (fun coordinate : Fin s × Fin t =>
                Ideal.Quotient.mk (partitionIncidenceIdeal t s d)
                  (MvPolynomial.X (Sum.inr coordinate)))
              (partitionIncidenceGlobalColumnLift t s d
                (MvPolynomial.X coordinate)) := by
          rw [map_mul, map_mul, hf]
        _ = Ideal.Quotient.mk (partitionIncidenceIdeal t s d) f *
              Ideal.Quotient.mk (partitionIncidenceIdeal t s d)
                (MvPolynomial.X coordinate) := by
          apply congrArg
            (fun y : PartitionIncidenceCoordinateRing t s d =>
              Ideal.Quotient.mk (partitionIncidenceIdeal t s d) f * y)
          cases coordinate with
          | inl block =>
              rw [show partitionIncidenceGlobalColumnLift t s d
                    (MvPolynomial.X (Sum.inl block)) =
                  MvPolynomial.C (MvPolynomial.X (Sum.inl block)) by
                    simp only [partitionIncidenceGlobalColumnLift, MvPolynomial.eval₂Hom_X', Sum.elim_inl],
                MvPolynomial.aeval_C]
              change partitionIncidenceGlobalBaseProjection t s d
                (MvPolynomial.X (Sum.inl block)) = _
              simp only [partitionIncidenceGlobalBaseProjection, MvPolynomial.aeval_X, Sum.elim_inl]
          | inr coordinate =>
              simp only [partitionIncidenceGlobalColumnLift, MvPolynomial.eval₂Hom_X', Sum.elim_inr, MvPolynomial.aeval_X]
        _ = Ideal.Quotient.mk (partitionIncidenceIdeal t s d)
              (f * MvPolynomial.X coordinate) :=
          (map_mul (Ideal.Quotient.mk (partitionIncidenceIdeal t s d))
            f (MvPolynomial.X coordinate)).symm

noncomputable def partitionIncidenceGlobalPowerRemainder
    (t s d : ℕ) (coordinate : Fin s × Fin t) :
    MvPolynomial (Fin s × Fin t)
      (MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ) :=
  let q := d - 1
  let k : ℂ := ((t - q : ℕ) : ℂ)
  let a : ℂ := (-1 : ℂ) ^ q * (q.factorial : ℂ)
  let embed : Fin t → IncidenceCoordinate t s :=
    fun row => Sum.inr (coordinate.1, row)
  let R : Fin t → MvPolynomial (IncidenceCoordinate t s) ℂ := fun row =>
    partitionIncidenceEquation t s d coordinate.1 row -
      MvPolynomial.C a *
        MvPolynomial.rename embed
          (deletedCoordinateEsymmPolynomial t q row)
  let low : MvPolynomial (Fin s × Fin t)
      (MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ) :=
    ∑ j : Fin (d - 2),
      (-MvPolynomial.X coordinate) ^ (q - (j.val + 1)) *
        MvPolynomial.C (MvPolynomial.X (Sum.inr (coordinate.1, j)))
  MvPolynomial.C
      (MvPolynomial.C (-(k * (q.factorial : ℂ))⁻¹)) *
    (MvPolynomial.C (MvPolynomial.C (k * a)) * low +
      MvPolynomial.C (MvPolynomial.C k) *
        partitionIncidenceGlobalColumnLift t s d (R coordinate.2) -
      ∑ row : Fin t,
        partitionIncidenceGlobalColumnLift t s d (R row))

theorem partitionIncidenceGlobalPowerRemainder_aeval
    {t s d : ℕ} (hd : 3 ≤ d) (ht : d ≤ t)
    (coordinate : Fin s × Fin t) :
    letI := partitionIncidenceGlobalBaseAlgebra t s d
    (Ideal.Quotient.mk (partitionIncidenceIdeal t s d)
      (MvPolynomial.X (Sum.inr coordinate))) ^ (d - 1) =
      MvPolynomial.aeval
        (fun row : Fin s × Fin t =>
          Ideal.Quotient.mk (partitionIncidenceIdeal t s d)
            (MvPolynomial.X (Sum.inr row)))
        (partitionIncidenceGlobalPowerRemainder t s d coordinate) := by
  classical
  letI := partitionIncidenceGlobalBaseAlgebra t s d
  haveI : Module (MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)
      (MvPolynomial (IncidenceCoordinate t s) ℂ ⧸ partitionIncidenceIdeal t s d) :=
    Algebra.toModule
  let q := d - 1
  let k : ℂ := ((t - q : ℕ) : ℂ)
  let a : ℂ := (-1 : ℂ) ^ q * (q.factorial : ℂ)
  let I := partitionIncidenceIdeal t s d
  let x : Fin s × Fin t → PartitionIncidenceCoordinateRing t s d :=
    fun row => Ideal.Quotient.mk I (MvPolynomial.X (Sum.inr row))
  let embed : Fin t → IncidenceCoordinate t s :=
    fun row => Sum.inr (coordinate.1, row)
  let E : ℕ → MvPolynomial (IncidenceCoordinate t s) ℂ :=
    fun j => MvPolynomial.rename embed
      (partitionFiberCoordinateEsymmPolynomial t j)
  let R : Fin t → MvPolynomial (IncidenceCoordinate t s) ℂ :=
    fun row => partitionIncidenceEquation t s d coordinate.1 row -
      MvPolynomial.C a * MvPolynomial.rename embed
        (deletedCoordinateEsymmPolynomial t q row)
  let low : MvPolynomial (Fin s × Fin t)
      (MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ) :=
    ∑ j : Fin (d - 2),
      (-MvPolynomial.X coordinate) ^ (q - (j.val + 1)) *
        MvPolynomial.C (MvPolynomial.X (Sum.inr (coordinate.1, j)))
  have hlift (f : MvPolynomial (IncidenceCoordinate t s) ℂ) :
      MvPolynomial.aeval x (partitionIncidenceGlobalColumnLift t s d f) =
        Ideal.Quotient.mk I f :=
    partitionIncidenceGlobalColumnLift_aeval t s d f
  have hcertificate :
      MvPolynomial.C k *
        (MvPolynomial.C a *
          (∑ j ∈ Finset.range q,
            (-MvPolynomial.X (Sum.inr coordinate)) ^ (q - j) * E j) +
            R coordinate.2) -
          ∑ row : Fin t, R row ∈ I := by
    simpa [q, k, a, I, embed, E, R] using
      partitionIncidence_monicReduction_mem t s d coordinate.1 coordinate.2
  have hzero : Ideal.Quotient.mk I
      (MvPolynomial.C k *
        (MvPolynomial.C a *
          (∑ j ∈ Finset.range q,
            (-MvPolynomial.X (Sum.inr coordinate)) ^ (q - j) * E j) +
            R coordinate.2) -
          ∑ row : Fin t, R row) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr hcertificate
  have hk : k ≠ 0 := by
    dsimp [k, q]
    exact_mod_cast (show t - (d - 1) ≠ 0 by omega)
  have hfact : (q.factorial : ℂ) ≠ 0 := by
    exact_mod_cast Nat.factorial_ne_zero q
  have hbase (j : Fin (d - 2)) :
      algebraMap
        (MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)
        (PartitionIncidenceCoordinateRing t s d)
        (MvPolynomial.X (Sum.inr (coordinate.1, j))) =
        Ideal.Quotient.mk I (E (j.val + 1)) := by
    change partitionIncidenceGlobalBaseProjection t s d
      (MvPolynomial.X (Sum.inr (coordinate.1, j))) = _
    simp [partitionIncidenceGlobalBaseProjection, E, embed, I]
  have hconst (c : ℂ) :
      algebraMap
        (MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)
        (PartitionIncidenceCoordinateRing t s d) (MvPolynomial.C c) =
        Ideal.Quotient.mk I (MvPolynomial.C c) := by
    change partitionIncidenceGlobalBaseProjection t s d
      (MvPolynomial.C c) = _
    simpa [partitionIncidenceGlobalBaseProjection, I] using
      (Ideal.Quotient.mk_algebraMap (R₁ := ℂ) I c).symm
  have hloweval :
      MvPolynomial.aeval x low =
        ∑ j : Fin (d - 2),
          (-x coordinate) ^ (q - (j.val + 1)) *
            Ideal.Quotient.mk I (E (j.val + 1)) := by
    dsimp [low]
    simp only [map_sum, map_mul, map_pow, map_neg,
      MvPolynomial.aeval_X, MvPolynomial.aeval_C]
    simp_rw [hbase]
  have hsplitSource :
      (∑ j ∈ Finset.range q,
        (-MvPolynomial.X coordinate.2) ^ (q - j) *
          partitionFiberCoordinateEsymmPolynomial t j) =
        (-MvPolynomial.X coordinate.2 : MvPolynomial (Fin t) ℂ) ^ q +
        ∑ j : Fin (d - 2),
          (-MvPolynomial.X coordinate.2) ^ (q - (j.val + 1)) *
            partitionFiberCoordinateEsymmPolynomial t (j.val + 1) := by
    have hqeq : q = (d - 2) + 1 := by dsimp [q]; omega
    conv_lhs => rw [hqeq, Finset.sum_range_succ']
    simp only [Nat.sub_zero, partitionFiberCoordinateEsymmPolynomial,
      MvPolynomial.esymm_zero, mul_one]
    rw [Fin.sum_univ_eq_sum_range
      (fun j : ℕ =>
        (-MvPolynomial.X coordinate.2 : MvPolynomial (Fin t) ℂ) ^
          (q - (j + 1)) * MvPolynomial.esymm (Fin t) ℂ (j + 1))
      (d - 2)]
    simp [hqeq, add_comm]
  have hsplit :
      (∑ j ∈ Finset.range q,
        (-MvPolynomial.X (Sum.inr coordinate)) ^ (q - j) * E j) =
        (-MvPolynomial.X (Sum.inr coordinate) :
          MvPolynomial (IncidenceCoordinate t s) ℂ) ^ q +
        ∑ j : Fin (d - 2),
          (-MvPolynomial.X (Sum.inr coordinate)) ^ (q - (j.val + 1)) *
            E (j.val + 1) := by
    have h := congrArg (MvPolynomial.rename embed) hsplitSource
    simpa [E, embed, map_sum, map_add, map_mul, map_pow, map_neg]
      using h
  change x coordinate ^ q =
    MvPolynomial.aeval x (partitionIncidenceGlobalPowerRemainder t s d coordinate)
  unfold partitionIncidenceGlobalPowerRemainder
  change x coordinate ^ q =
    MvPolynomial.aeval x
      (MvPolynomial.C (MvPolynomial.C (-(k * (q.factorial : ℂ))⁻¹)) *
        (MvPolynomial.C (MvPolynomial.C (k * a)) * low +
          MvPolynomial.C (MvPolynomial.C k) *
            partitionIncidenceGlobalColumnLift t s d (R coordinate.2) -
          ∑ row : Fin t, partitionIncidenceGlobalColumnLift t s d (R row)))
  simp only [map_mul, map_add, map_sub, map_sum, MvPolynomial.aeval_C]
  simp_rw [hconst, hlift]
  rw [hloweval]
  rw [hsplit] at hzero
  simp only [map_sub, map_mul, map_add, map_sum, map_pow, map_neg] at hzero
  have hsign : a * (-1 : ℂ) ^ q = (q.factorial : ℂ) := by
    have heven : Even (q + q) := ⟨q, by omega⟩
    calc
      a * (-1 : ℂ) ^ q =
          ((-1 : ℂ) ^ q * (-1 : ℂ) ^ q) * (q.factorial : ℂ) := by
        dsimp [a]
        ring
      _ = (-1 : ℂ) ^ (q + q) * (q.factorial : ℂ) := by rw [pow_add]
      _ = (q.factorial : ℂ) := by rw [heven.neg_one_pow]; ring
  have hunit : k * (q.factorial : ℂ) ≠ 0 := mul_ne_zero hk hfact
  have hsign_quot :
      Ideal.Quotient.mk I (MvPolynomial.C a) * (-x coordinate) ^ q =
        Ideal.Quotient.mk I (MvPolynomial.C (q.factorial : ℂ)) *
          x coordinate ^ q := by
    rw [← neg_one_mul (x coordinate), mul_pow]
    have hminus :
        (-1 : PartitionIncidenceCoordinateRing t s d) ^ q =
          Ideal.Quotient.mk I (MvPolynomial.C ((-1 : ℂ) ^ q)) := by
      simp
    rw [hminus]
    change Ideal.Quotient.mk I (MvPolynomial.C a) *
        (Ideal.Quotient.mk I (MvPolynomial.C ((-1 : ℂ) ^ q)) *
          x coordinate ^ q) = _
    rw [← mul_assoc, ← map_mul, ← MvPolynomial.C_mul, hsign]
  let S : PartitionIncidenceCoordinateRing t s d :=
    ∑ j : Fin (d - 2),
      (-x coordinate) ^ (q - (j.val + 1)) *
        Ideal.Quotient.mk I (E (j.val + 1))
  let T : PartitionIncidenceCoordinateRing t s d :=
    Ideal.Quotient.mk I (MvPolynomial.C (k * a)) * S +
      Ideal.Quotient.mk I (MvPolynomial.C k) *
        Ideal.Quotient.mk I (R coordinate.2) -
      ∑ row : Fin t, Ideal.Quotient.mk I (R row)
  have hlinear :
      Ideal.Quotient.mk I (MvPolynomial.C (k * (q.factorial : ℂ))) *
        x coordinate ^ q + T = 0 := by
    calc
      _ = Ideal.Quotient.mk I (MvPolynomial.C k) *
          (Ideal.Quotient.mk I (MvPolynomial.C a) *
            ((-x coordinate) ^ q + S) +
            Ideal.Quotient.mk I (R coordinate.2)) -
          ∑ row : Fin t, Ideal.Quotient.mk I (R row) := by
        dsimp [T]
        simp only [map_mul]
        linear_combination
          -(Ideal.Quotient.mk I (MvPolynomial.C k)) * hsign_quot
      _ = 0 := by
        simpa [S, x, embed, E] using hzero
  have hinv :
      Ideal.Quotient.mk I
          (MvPolynomial.C (-(k * (q.factorial : ℂ))⁻¹)) *
        Ideal.Quotient.mk I
          (MvPolynomial.C (k * (q.factorial : ℂ))) = -1 := by
    rw [← map_mul, ← MvPolynomial.C_mul, neg_mul,
      inv_mul_cancel₀ hunit]
    simp
  change x coordinate ^ q =
    Ideal.Quotient.mk I
      (MvPolynomial.C (-(k * (q.factorial : ℂ))⁻¹)) *
      (Ideal.Quotient.mk I (MvPolynomial.C k) *
          Ideal.Quotient.mk I (MvPolynomial.C a) * S +
        Ideal.Quotient.mk I (MvPolynomial.C k) *
          Ideal.Quotient.mk I (R coordinate.2) -
        ∑ row : Fin t, Ideal.Quotient.mk I (R row))
  rw [← map_mul, ← MvPolynomial.C_mul]
  change x coordinate ^ q =
    Ideal.Quotient.mk I
      (MvPolynomial.C (-(k * (q.factorial : ℂ))⁻¹)) * T
  calc
    x coordinate ^ q =
        -(Ideal.Quotient.mk I
          (MvPolynomial.C (-(k * (q.factorial : ℂ))⁻¹)) *
          Ideal.Quotient.mk I
            (MvPolynomial.C (k * (q.factorial : ℂ)))) *
          x coordinate ^ q := by rw [hinv]; ring
    _ = Ideal.Quotient.mk I
          (MvPolynomial.C (-(k * (q.factorial : ℂ))⁻¹)) * T := by
      have hscaled := congrArg
        (fun z : PartitionIncidenceCoordinateRing t s d =>
          Ideal.Quotient.mk I
            (MvPolynomial.C (-(k * (q.factorial : ℂ))⁻¹)) * z)
        hlinear
      simp only [mul_zero] at hscaled
      linear_combination -hscaled

noncomputable def incidenceUniversalPartitionBlockFactor
    {t : ℕ} {ι B : Type*} [CommRing B]
    (parameter : Finset (Fin t) → B) (index : Fin t → ι)
    {rows : Finset (Fin t)} (partition : Finpartition rows) :
    MvPolynomial ι B :=
  ∏ block ∈ partition.parts,
    (MvPolynomial.C (parameter block) -
      ∏ row ∈ block, MvPolynomial.X (index row))

theorem incidenceUniversalPartitionBlockFactor_totalDegree
    {t : ℕ} {ι B : Type*} [CommRing B] [Nontrivial B]
    (parameter : Finset (Fin t) → B) (index : Fin t → ι)
    {rows : Finset (Fin t)} (partition : Finpartition rows) :
    (incidenceUniversalPartitionBlockFactor parameter index partition).totalDegree ≤
      rows.card := by
  classical
  unfold incidenceUniversalPartitionBlockFactor
  calc
    (∏ block ∈ partition.parts,
        (MvPolynomial.C (parameter block) -
          ∏ row ∈ block, (MvPolynomial.X (index row) :
            MvPolynomial ι B))).totalDegree ≤
      ∑ block ∈ partition.parts,
        (MvPolynomial.C (parameter block) -
          ∏ row ∈ block, (MvPolynomial.X (index row) :
            MvPolynomial ι B)).totalDegree :=
      MvPolynomial.totalDegree_finsetProd _ _
    _ ≤ ∑ block ∈ partition.parts, block.card := by
      apply Finset.sum_le_sum
      intro block _
      calc
        (MvPolynomial.C (parameter block) -
          ∏ row ∈ block, (MvPolynomial.X (index row) :
            MvPolynomial ι B)).totalDegree ≤
          max (MvPolynomial.C (parameter block) : MvPolynomial ι B).totalDegree
            (∏ row ∈ block,
              (MvPolynomial.X (index row) : MvPolynomial ι B)).totalDegree :=
          MvPolynomial.totalDegree_sub _ _
        _ ≤ block.card := by
          rw [MvPolynomial.totalDegree_C, Nat.max_eq_right (Nat.zero_le _)]
          calc
            (∏ row ∈ block,
              (MvPolynomial.X (index row) : MvPolynomial ι B)).totalDegree ≤
              ∑ row ∈ block,
                (MvPolynomial.X (index row) : MvPolynomial ι B).totalDegree :=
              MvPolynomial.totalDegree_finsetProd _ _
            _ ≤ block.card := by simp only [MvPolynomial.totalDegree_X, Finset.sum_const, smul_eq_mul, mul_one, Std.le_refl]
    _ = rows.card := partition.sum_card_parts

theorem incidenceUniversalPartitionBlockFactor_homogeneousComponent
    {t : ℕ} {ι B : Type*} [CommRing B]
    (parameter : Finset (Fin t) → B) (index : Fin t → ι)
    {rows : Finset (Fin t)} (partition : Finpartition rows) :
    MvPolynomial.homogeneousComponent rows.card
      (incidenceUniversalPartitionBlockFactor parameter index partition) =
      MvPolynomial.C ((-1 : B) ^ partition.parts.card) *
        ∏ row ∈ rows, MvPolynomial.X (index row) := by
  classical
  have hblock (block : Finset (Fin t)) :
      (∏ row ∈ block,
        (MvPolynomial.X (index row) : MvPolynomial ι B)).IsHomogeneous
          block.card := by
    convert MvPolynomial.IsHomogeneous.prod block
      (fun row => (MvPolynomial.X (index row) : MvPolynomial ι B))
      (fun _ => 1)
      (fun row _ => MvPolynomial.isHomogeneous_X B (index row)) using 1
    simp only [Finset.sum_const, smul_eq_mul, mul_one]
  have hterm (selected : Finset (Finset (Fin t))) :
      (((-1 : MvPolynomial ι B) ^ selected.card *
          (∏ block ∈ partition.parts \ selected,
            MvPolynomial.C (parameter block))) *
          ∏ block ∈ selected,
            ∏ row ∈ block, MvPolynomial.X (index row)).IsHomogeneous
          (∑ block ∈ selected, block.card) := by
    have hsign :
        ((-1 : MvPolynomial ι B) ^ selected.card).IsHomogeneous 0 := by
      convert (MvPolynomial.isHomogeneous_C ι (-1 : B)).pow selected.card
        using 1 <;> simp
    have hconstants :
        (∏ block ∈ partition.parts \ selected,
          (MvPolynomial.C (parameter block) : MvPolynomial ι B)).IsHomogeneous 0 := by
      convert MvPolynomial.IsHomogeneous.prod
        (partition.parts \ selected)
        (fun block => (MvPolynomial.C (parameter block) : MvPolynomial ι B))
        (fun _ => 0)
        (fun block _ => MvPolynomial.isHomogeneous_C ι (parameter block))
        using 1
      simp only [Finset.sum_const_zero]
    have hmonomials :
        (∏ block ∈ selected,
          ∏ row ∈ block,
            (MvPolynomial.X (index row) : MvPolynomial ι B)).IsHomogeneous
          (∑ block ∈ selected, block.card) :=
      MvPolynomial.IsHomogeneous.prod selected
        (fun block => ∏ row ∈ block,
          (MvPolynomial.X (index row) : MvPolynomial ι B))
        (fun block => block.card)
        (fun block _ => hblock block)
    simpa only [add_zero, zero_add] using (hsign.mul hconstants).mul hmonomials
  unfold incidenceUniversalPartitionBlockFactor
  rw [Finset.prod_sub, map_sum]
  refine (Finset.sum_eq_single_of_mem partition.parts
    (Finset.mem_powerset_self partition.parts) ?_).trans ?_
  · intro selected hselected hne
    have hlt := partition_selected_blocks_card_lt partition selected
      (Finset.mem_powerset.mp hselected) hne
    rw [MvPolynomial.homogeneousComponent_of_mem (hterm selected),
      if_neg (by omega)]
  · have hfull :
        (((-1 : MvPolynomial ι B) ^ partition.parts.card *
            (∏ block ∈ partition.parts \ partition.parts,
              MvPolynomial.C (parameter block))) *
            ∏ block ∈ partition.parts,
              ∏ row ∈ block, MvPolynomial.X (index row)).IsHomogeneous
          rows.card := by
      simpa only [partition.sum_card_parts] using hterm partition.parts
    rw [MvPolynomial.homogeneousComponent_eq_self hfull]
    simp only [Finset.sdiff_self, Finset.prod_empty, mul_one]
    have hprod :
        (∏ block ∈ partition.parts,
          ∏ row ∈ block,
            (MvPolynomial.X (index row) : MvPolynomial ι B)) =
          ∏ row ∈ rows, MvPolynomial.X (index row) := by
      calc
        (∏ block ∈ partition.parts,
          ∏ row ∈ block,
            (MvPolynomial.X (index row) : MvPolynomial ι B)) =
            ∏ row ∈ partition.parts.biUnion id,
              MvPolynomial.X (index row) :=
          (Finset.prod_biUnion partition.disjoint).symm
        _ = ∏ row ∈ rows, MvPolynomial.X (index row) := by
          simp only [partition.biUnion_parts]
    rw [hprod]
    simp only [MvPolynomial.C_pow, MvPolynomial.C_neg, MvPolynomial.C_1]

noncomputable def incidenceUniversalPartitionDerivative
    {t : ℕ} {ι B : Type*} [CommRing B] [Algebra ℂ B]
    (d : ℕ) (i : Fin t)
    (parameter : Finset (Fin t) → B) (index : Fin t → ι) :
    MvPolynomial ι B :=
  ∑ rows ∈ ((Finset.univ : Finset (Fin t)).erase i).powersetCard (d - 1),
    ∑ partition : Finpartition rows,
      MvPolynomial.C (algebraMap ℂ B (partitionMobius partition)) *
        incidenceUniversalPartitionBlockFactor parameter index partition

theorem incidenceUniversalPartitionDerivative_totalDegree
    {t : ℕ} {ι B : Type*} [CommRing B] [Nontrivial B] [Algebra ℂ B]
    (d : ℕ) (i : Fin t)
    (parameter : Finset (Fin t) → B) (index : Fin t → ι) :
    (incidenceUniversalPartitionDerivative d i parameter index).totalDegree ≤
      d - 1 := by
  classical
  unfold incidenceUniversalPartitionDerivative
  apply MvPolynomial.totalDegree_finsetSum_le
  intro rows hrows
  have hrowscard : rows.card = d - 1 :=
    (Finset.mem_powersetCard.mp hrows).2
  apply MvPolynomial.totalDegree_finsetSum_le
  intro partition _
  calc
    (MvPolynomial.C (algebraMap ℂ B (partitionMobius partition)) *
      incidenceUniversalPartitionBlockFactor parameter index partition).totalDegree ≤
        (MvPolynomial.C (algebraMap ℂ B (partitionMobius partition)) :
          MvPolynomial ι B).totalDegree +
            (incidenceUniversalPartitionBlockFactor parameter index partition).totalDegree :=
      MvPolynomial.totalDegree_mul _ _
    _ = (incidenceUniversalPartitionBlockFactor parameter index partition).totalDegree := by
      rw [MvPolynomial.totalDegree_C, Nat.zero_add]
    _ ≤ rows.card :=
      incidenceUniversalPartitionBlockFactor_totalDegree parameter index partition
    _ = d - 1 := hrowscard

theorem incidenceUniversalPartitionDerivative_homogeneousComponent
    {t : ℕ} {ι B : Type*} [CommRing B] [Algebra ℂ B]
    (d : ℕ) (i : Fin t)
    (parameter : Finset (Fin t) → B) (index : Fin t → ι) :
    MvPolynomial.homogeneousComponent (d - 1)
      (incidenceUniversalPartitionDerivative d i parameter index) =
      MvPolynomial.C
          (algebraMap ℂ B
            (((-1 : ℂ) ^ (d - 1)) * ((d - 1).factorial : ℂ))) *
        MvPolynomial.map (algebraMap ℂ B)
          (MvPolynomial.rename index
            (deletedCoordinateEsymmPolynomial t (d - 1) i)) := by
  classical
  unfold incidenceUniversalPartitionDerivative
  rw [map_sum]
  have hrename :
      MvPolynomial.map (algebraMap ℂ B)
        (MvPolynomial.rename index
          (deletedCoordinateEsymmPolynomial t (d - 1) i)) =
      ∑ rows ∈ ((Finset.univ : Finset (Fin t)).erase i).powersetCard (d - 1),
        ∏ row ∈ rows, (MvPolynomial.X (index row) : MvPolynomial ι B) := by
    rw [deletedCoordinateEsymmPolynomial, Finset.esymm_map_val]
    simp only [map_sum, map_prod, MvPolynomial.rename_X,
      MvPolynomial.map_X]
  rw [hrename, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro rows hrows
  have hcard : rows.card = d - 1 :=
    (Finset.mem_powersetCard.mp hrows).2
  rw [map_sum]
  calc
    (∑ partition : Finpartition rows,
        MvPolynomial.homogeneousComponent (d - 1)
          (MvPolynomial.C (algebraMap ℂ B (partitionMobius partition)) *
            incidenceUniversalPartitionBlockFactor parameter index partition)) =
      ∑ partition : Finpartition rows,
        MvPolynomial.C
          (algebraMap ℂ B
            (((-1 : ℂ) ^ (d - 1)) *
              ∏ block ∈ partition.parts,
                ((block.card - 1).factorial : ℂ))) *
          ∏ row ∈ rows, MvPolynomial.X (index row) := by
      apply Finset.sum_congr rfl
      intro partition _
      rw [MvPolynomial.homogeneousComponent_C_mul, ← hcard,
        incidenceUniversalPartitionBlockFactor_homogeneousComponent]
      have hmobi := congrArg (algebraMap ℂ B)
        (partitionMobius_mul_neg_one_pow partition)
      simp only [map_mul, map_pow, map_neg, map_one] at hmobi
      rw [← mul_assoc, ← MvPolynomial.C_mul, hmobi, hcard]
      simp only [map_mul, map_pow, map_neg, map_one]
    _ = MvPolynomial.C
          (algebraMap ℂ B
            (((-1 : ℂ) ^ (d - 1)) * ((d - 1).factorial : ℂ))) *
          ∏ row ∈ rows, MvPolynomial.X (index row) := by
      rw [← Finset.sum_mul, ← map_sum]
      congr 2
      rw [← map_sum, ← Finset.mul_sum,
        partition_cycle_factorial_complex rows, hcard]

noncomputable def partitionIncidenceGlobalUniversalParameter
    (t s d : ℕ) (block : Finset (Fin t)) :
    (MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ) :=
  if h : block.Nonempty then
    MvPolynomial.X (Sum.inl ⟨block, h⟩)
  else 0

theorem partitionIncidenceGlobalColumnLift_equation
    (t s d : ℕ) (a : Fin s) (i : Fin t) :
    partitionIncidenceGlobalColumnLift t s d
      (partitionIncidenceEquation t s d a i) =
      incidenceUniversalPartitionDerivative d i
        (partitionIncidenceGlobalUniversalParameter t s d)
        (fun row : Fin t => (a, row)) := by
  classical
  unfold partitionIncidenceGlobalColumnLift partitionIncidenceEquation
    incidenceUniversalPartitionDerivative
  simp only [map_sum, map_mul, map_prod, map_sub,
    MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
    RingHom.coe_comp, Function.comp_apply,
    MvPolynomial.algebraMap_eq]
  apply Finset.sum_congr rfl
  intro rows _
  apply Finset.sum_congr rfl
  intro partition _
  congr 1
  unfold incidenceUniversalPartitionBlockFactor
  calc
    (∏ block ∈ partition.parts.attach,
      (MvPolynomial.C
        (MvPolynomial.X
          (Sum.inl ⟨block.1,
            partition.nonempty_of_mem_parts block.2⟩)) -
        ∏ row ∈ block.1,
          (MvPolynomial.X (a, row) :
            MvPolynomial (Fin s × Fin t)
              ((MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ))))) =
      ∏ block ∈ partition.parts.attach,
        (MvPolynomial.C
          (partitionIncidenceGlobalUniversalParameter t s d block.1) -
          ∏ row ∈ block.1,
            (MvPolynomial.X (a, row) :
              MvPolynomial (Fin s × Fin t)
                ((MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)))) := by
      apply Finset.prod_congr rfl
      intro block _
      simp only [partitionIncidenceGlobalUniversalParameter, partition.nonempty_of_mem_parts block.2, ↓reduceDIte]
    _ = ∏ block ∈ partition.parts,
        (MvPolynomial.C
          (partitionIncidenceGlobalUniversalParameter t s d block) -
          ∏ row ∈ block,
            (MvPolynomial.X (a, row) :
              MvPolynomial (Fin s × Fin t)
                ((MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)))) :=
      Finset.prod_attach partition.parts
        (fun block =>
          (MvPolynomial.C
            (partitionIncidenceGlobalUniversalParameter t s d block) -
            ∏ row ∈ block,
              (MvPolynomial.X (a, row) :
                MvPolynomial (Fin s × Fin t)
                  ((MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)))))

theorem incidence_totalDegree_sub_homogeneousComponent_universal
    {σ B : Type*} [CommRing B]
    (f : MvPolynomial σ B) {q : ℕ}
    (hf : f.totalDegree ≤ q) :
    (f - MvPolynomial.homogeneousComponent q f).totalDegree ≤ q - 1 := by
  classical
  rw [MvPolynomial.totalDegree, Finset.sup_le_iff]
  intro m hm
  have hmne :
      MvPolynomial.coeff m
        (f - MvPolynomial.homogeneousComponent q f) ≠ 0 :=
    MvPolynomial.mem_support_iff.mp hm
  have hmq : m.degree ≠ q := by
    intro heq
    apply hmne
    simp only [MvPolynomial.coeff_sub, MvPolynomial.coeff_homogeneousComponent, heq, ↓reduceIte, sub_self]
  have hmcoeff : MvPolynomial.coeff m f ≠ 0 := by
    intro hzero
    apply hmne
    simp only [MvPolynomial.coeff_sub, hzero, MvPolynomial.coeff_homogeneousComponent, hmq, ↓reduceIte, sub_self]
  have hmle : m.degree ≤ q :=
    (MvPolynomial.le_totalDegree
      (MvPolynomial.mem_support_iff.mpr hmcoeff)).trans hf
  change m.degree ≤ q - 1
  omega

theorem partitionIncidenceGlobalColumnLift_deleted
    (t s d : ℕ) (a : Fin s) (i : Fin t) (q : ℕ) :
    partitionIncidenceGlobalColumnLift t s d
      (MvPolynomial.rename
        (fun row : Fin t => (Sum.inr (a, row) : IncidenceCoordinate t s))
        (deletedCoordinateEsymmPolynomial t q i)) =
      MvPolynomial.map
        (algebraMap ℂ ((MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)))
        (MvPolynomial.rename
          (fun row : Fin t => (a, row))
          (deletedCoordinateEsymmPolynomial t q i)) := by
  classical
  unfold partitionIncidenceGlobalColumnLift
    deletedCoordinateEsymmPolynomial
  rw [Finset.esymm_map_val]
  simp only [map_sum, map_prod, MvPolynomial.rename_X,
    MvPolynomial.eval₂Hom_X', MvPolynomial.map_X, Sum.elim_inr]

noncomputable def partitionIncidenceGlobalEquationRemainder
    (t s d : ℕ) (a : Fin s) (i : Fin t) :
    MvPolynomial (IncidenceCoordinate t s) ℂ :=
  partitionIncidenceEquation t s d a i -
    MvPolynomial.C
      (((-1 : ℂ) ^ (d - 1)) * ((d - 1).factorial : ℂ)) *
      MvPolynomial.rename
        (fun row : Fin t => (Sum.inr (a, row) : IncidenceCoordinate t s))
        (deletedCoordinateEsymmPolynomial t (d - 1) i)

theorem partitionIncidenceGlobalEquationRemainder_lift_eq
    (t s d : ℕ) (a : Fin s) (i : Fin t) :
    partitionIncidenceGlobalColumnLift t s d
      (partitionIncidenceGlobalEquationRemainder t s d a i) =
      incidenceUniversalPartitionDerivative d i
        (partitionIncidenceGlobalUniversalParameter t s d)
        (fun row : Fin t => (a, row)) -
      MvPolynomial.C
        (algebraMap ℂ ((MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ))
          (((-1 : ℂ) ^ (d - 1)) * ((d - 1).factorial : ℂ))) *
      MvPolynomial.map
        (algebraMap ℂ ((MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)))
        (MvPolynomial.rename
          (fun row : Fin t => (a, row))
          (deletedCoordinateEsymmPolynomial t (d - 1) i)) := by
  unfold partitionIncidenceGlobalEquationRemainder
  rw [map_sub, map_mul, partitionIncidenceGlobalColumnLift_equation,
    partitionIncidenceGlobalColumnLift_deleted]
  congr 2
  simp only [partitionIncidenceGlobalColumnLift, MvPolynomial.C_mul, MvPolynomial.C_pow, MvPolynomial.C_neg,
    MvPolynomial.C_1, map_natCast, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_pow,
    MvPolynomial.eval₂_neg, MvPolynomial.eval₂_one, MvPolynomial.eval₂_natCast, MvPolynomial.algebraMap_eq]

theorem partitionIncidenceGlobalEquationRemainder_outer_totalDegree_aux
    (t s d : ℕ) (a : Fin s) (i : Fin t) :
    (partitionIncidenceGlobalColumnLift t s d
      (partitionIncidenceGlobalEquationRemainder t s d a i)).totalDegree ≤
      d - 2 := by
  rw [partitionIncidenceGlobalEquationRemainder_lift_eq,
    ← incidenceUniversalPartitionDerivative_homogeneousComponent]
  simpa only [Nat.sub_sub, Nat.reduceAdd] using
    (incidence_totalDegree_sub_homogeneousComponent_universal
      (incidenceUniversalPartitionDerivative d i (partitionIncidenceGlobalUniversalParameter t s d)
        (fun row : Fin t => (a, row)))
      (incidenceUniversalPartitionDerivative_totalDegree d i (partitionIncidenceGlobalUniversalParameter t s d)
        (fun row : Fin t => (a, row))))

theorem partitionIncidenceGlobalEquationRemainder_outer_totalDegree
    (t s d : ℕ) (a : Fin s) (i : Fin t) :
    (partitionIncidenceGlobalColumnLift t s d
      (partitionIncidenceGlobalEquationRemainder t s d a i)).totalDegree ≤
      d - 2 :=
  partitionIncidenceGlobalEquationRemainder_outer_totalDegree_aux t s d a i

theorem partitionIncidenceGlobalPowerRemainder_totalDegree
    {t s d : ℕ} (hd : 3 ≤ d) (coordinate : Fin s × Fin t) :
    (partitionIncidenceGlobalPowerRemainder t s d coordinate).totalDegree <
      d - 1 := by
  classical
  let q := d - 1
  let k : ℂ := ((t - q : ℕ) : ℂ)
  let lead : ℂ := (-1 : ℂ) ^ q * (q.factorial : ℂ)
  let B := (MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)
  let R : Fin t → MvPolynomial (IncidenceCoordinate t s) ℂ :=
    fun row => partitionIncidenceGlobalEquationRemainder
      t s d coordinate.1 row
  let low : MvPolynomial (Fin s × Fin t) B :=
    ∑ j : Fin (d - 2),
      (-MvPolynomial.X coordinate) ^ (q - (j.val + 1)) *
        MvPolynomial.C (MvPolynomial.X (Sum.inr (coordinate.1, j)))
  have hq : 0 < q := by dsimp [q]; omega
  have hCmul (c : B) (f : MvPolynomial (Fin s × Fin t) B) :
      (MvPolynomial.C c * f).totalDegree ≤ f.totalDegree := by
    calc
      (MvPolynomial.C c * f).totalDegree ≤
          (MvPolynomial.C c).totalDegree + f.totalDegree :=
        MvPolynomial.totalDegree_mul _ _
      _ = f.totalDegree := by
        rw [MvPolynomial.totalDegree_C, Nat.zero_add]
  have hR (row : Fin t) :
      (partitionIncidenceGlobalColumnLift t s d (R row)).totalDegree ≤
        q - 1 := by
    dsimp [R, q]
    simpa only [Nat.sub_sub, Nat.reduceAdd] using
      partitionIncidenceGlobalEquationRemainder_outer_totalDegree t s d coordinate.1 row
  have hlow : low.totalDegree ≤ q - 1 := by
    apply MvPolynomial.totalDegree_finsetSum_le
    intro j _
    calc
      ((-MvPolynomial.X coordinate :
          MvPolynomial (Fin s × Fin t) B) ^
            (q - (j.val + 1)) *
          MvPolynomial.C
            (MvPolynomial.X (Sum.inr (coordinate.1, j)))).totalDegree ≤
        ((-MvPolynomial.X coordinate :
          MvPolynomial (Fin s × Fin t) B) ^
            (q - (j.val + 1))).totalDegree +
          (MvPolynomial.C
            (MvPolynomial.X (Sum.inr (coordinate.1, j))) :
              MvPolynomial (Fin s × Fin t) B).totalDegree :=
        MvPolynomial.totalDegree_mul _ _
      _ ≤ (q - (j.val + 1)) *
          (-MvPolynomial.X coordinate :
            MvPolynomial (Fin s × Fin t) B).totalDegree + 0 := by
        gcongr
        · exact MvPolynomial.totalDegree_pow _ _
        · exact (MvPolynomial.totalDegree_C _).le
      _ ≤ q - 1 := by
        have hj : j.val + 1 ≤ q := by
          have hj' := j.isLt
          dsimp [q]
          omega
        rw [MvPolynomial.totalDegree_neg,
          MvPolynomial.totalDegree_X, Nat.mul_one, Nat.add_zero]
        omega
  have hinside :
      (MvPolynomial.C (MvPolynomial.C (k * lead)) * low +
        MvPolynomial.C (MvPolynomial.C k) *
          partitionIncidenceGlobalColumnLift t s d (R coordinate.2) -
        ∑ row : Fin t,
          partitionIncidenceGlobalColumnLift t s d (R row)).totalDegree ≤
        q - 1 := by
    apply (MvPolynomial.totalDegree_sub _ _).trans
    apply max_le
    · apply (MvPolynomial.totalDegree_add _ _).trans
      apply max_le
      · exact (hCmul _ low).trans hlow
      · exact (hCmul _ _).trans (hR coordinate.2)
    · apply MvPolynomial.totalDegree_finsetSum_le
      intro row _
      exact hR row
  change
    (MvPolynomial.C (MvPolynomial.C (-(k * (q.factorial : ℂ))⁻¹)) *
      (MvPolynomial.C (MvPolynomial.C (k * lead)) * low +
        MvPolynomial.C (MvPolynomial.C k) *
          partitionIncidenceGlobalColumnLift t s d (R coordinate.2) -
        ∑ row : Fin t,
          partitionIncidenceGlobalColumnLift t s d (R row))).totalDegree < q
  exact lt_of_le_of_lt
    ((hCmul _ _).trans hinside)
    (Nat.sub_lt hq (by omega))

noncomputable def minorSumGraphPullback
    (t s : ℕ) :
    MvPolynomial (IncidenceCoordinate t s) ℂ →ₐ[ℂ]
      MvPolynomial (Fin t × Fin s) ℂ :=
  MvPolynomial.aeval <| Sum.elim
    (fun block : IncidenceRowBlock t => powerSum t s block.1)
    (fun coordinate : Fin s × Fin t =>
      MvPolynomial.X (coordinate.2, coordinate.1))

theorem minorSumGraphPullback_eval
    (t s : ℕ) (point : Fin t × Fin s → ℂ)
    (f : MvPolynomial (IncidenceCoordinate t s) ℂ) :
    MvPolynomial.eval point
        (minorSumGraphPullback t s f) =
      MvPolynomial.eval
        (incidenceCoordinatePoint t s
          (minorSumPowerParameters t s point)
          (minorSumColumns t s point)) f := by
  change
    MvPolynomial.aeval point
      (MvPolynomial.aeval
        (Sum.elim
          (fun block : IncidenceRowBlock t => powerSum t s block.1)
          (fun coordinate : Fin s × Fin t =>
            MvPolynomial.X (coordinate.2, coordinate.1))) f) =
      MvPolynomial.aeval
        (incidenceCoordinatePoint t s
          (minorSumPowerParameters t s point)
          (minorSumColumns t s point)) f
  have hcoordinates :
      (fun coordinate : IncidenceCoordinate t s =>
        MvPolynomial.aeval point
          (Sum.elim
            (fun block : IncidenceRowBlock t => powerSum t s block.1)
            (fun coordinate : Fin s × Fin t =>
              MvPolynomial.X (coordinate.2, coordinate.1)) coordinate)) =
        incidenceCoordinatePoint t s
          (minorSumPowerParameters t s point)
          (minorSumColumns t s point) := by
    funext coordinate
    cases coordinate with
    | inl block =>
        simp only [Sum.elim_inl, MvPolynomial.aeval_def, Algebra.algebraMap_self, MvPolynomial.eval₂_id,
          incidenceCoordinatePoint, minorSumPowerParameters]
    | inr coordinate =>
        simp only [Sum.elim_inr, MvPolynomial.aeval_X, incidenceCoordinatePoint, minorSumColumns]
  rw [MvPolynomial.comp_aeval_apply, hcoordinates]

theorem minorSumGraphPullback_incidenceEquation
    (t s d : ℕ) (hd : 0 < d) (column : Fin s) (row : Fin t) :
    minorSumGraphPullback t s
        (partitionIncidenceEquation t s d column row) =
      MvPolynomial.pderiv (row, column) (minorSum t s d) := by
  apply MvPolynomial.funext
  intro point
  rw [minorSumGraphPullback_eval,
    eval_partitionIncidenceEquation]
  exact (eval_minorSum_pderiv_eq_incidencePartitionDerivative
    t s d hd point row column).symm

abbrev BlockIncidenceCoordinate (b t s : ℕ) :=
  Fin b × IncidenceCoordinate t s

abbrev BlockIncidenceColumn (b t s : ℕ) :=
  Fin b × (Fin s × Fin t)

abbrev BlockIncidenceBaseIndex (b t s d : ℕ) :=
  Fin b × (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2)))

noncomputable def blockIncidenceEquation (b t s d : ℕ)
    (coordinate : BlockIncidenceColumn b t s) :
    MvPolynomial (BlockIncidenceCoordinate b t s) ℂ :=
  MvPolynomial.rename
    (fun z : IncidenceCoordinate t s => (coordinate.1, z))
    (partitionIncidenceEquation t s d coordinate.2.1 coordinate.2.2)

noncomputable abbrev blockIncidenceIdeal (b t s d : ℕ) :
    Ideal (MvPolynomial (BlockIncidenceCoordinate b t s) ℂ) :=
  Ideal.span (Set.range (blockIncidenceEquation b t s d))

noncomputable abbrev BlockIncidenceCoordinateRing (b t s d : ℕ) :=
  MvPolynomial (BlockIncidenceCoordinate b t s) ℂ ⧸
    blockIncidenceIdeal b t s d

noncomputable def blockIncidenceBaseProjection (b t s d : ℕ) :
    MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ →ₐ[ℂ]
      BlockIncidenceCoordinateRing b t s d :=
  MvPolynomial.aeval fun coordinate =>
    match coordinate.2 with
    | Sum.inl block =>
        Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
          (MvPolynomial.X (coordinate.1, Sum.inl block))
    | Sum.inr column =>
        Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
          (MvPolynomial.rename
            (fun row : Fin t => (coordinate.1, Sum.inr (column.1, row)))
            (partitionFiberCoordinateEsymmPolynomial t
              (column.2.val + 1)))

noncomputable abbrev blockIncidenceBaseAlgebra (b t s d : ℕ) :
    Algebra (MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ)
      (BlockIncidenceCoordinateRing b t s d) :=
  (blockIncidenceBaseProjection b t s d).toRingHom.toAlgebra

theorem blockIncidence_adjoin_column_coordinates
    (b t s d : ℕ) :
    letI := blockIncidenceBaseAlgebra b t s d
    Algebra.adjoin
      (MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ)
      (Set.range fun coordinate : BlockIncidenceColumn b t s =>
        Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
          (MvPolynomial.X (coordinate.1, Sum.inr coordinate.2))) =
      (⊤ : Subalgebra
        (MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ)
        (BlockIncidenceCoordinateRing b t s d)) := by
  classical
  letI := blockIncidenceBaseAlgebra b t s d
  let T : Subalgebra
      (MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ)
      (BlockIncidenceCoordinateRing b t s d) :=
    Algebra.adjoin _
      (Set.range fun coordinate : BlockIncidenceColumn b t s =>
        Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
          (MvPolynomial.X (coordinate.1, Sum.inr coordinate.2)))
  apply top_unique
  intro a ha
  obtain ⟨f, rfl⟩ :=
    Ideal.Quotient.mk_surjective (I := blockIncidenceIdeal b t s d) a
  clear ha
  change Ideal.Quotient.mk (blockIncidenceIdeal b t s d) f ∈ T
  induction f using MvPolynomial.induction_on with
  | C c =>
      let basec : MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ :=
        MvPolynomial.C c
      have heq : algebraMap
          (MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ)
          (BlockIncidenceCoordinateRing b t s d) basec =
            Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
              (MvPolynomial.C c) := by
        change blockIncidenceBaseProjection b t s d basec = _
        simpa [basec, blockIncidenceBaseProjection] using
          (Ideal.Quotient.mk_algebraMap (R₁ := ℂ)
            (blockIncidenceIdeal b t s d) c).symm
      rw [← heq]
      exact T.algebraMap_mem basec
  | add f g hf hg =>
      simpa only [map_add] using T.add_mem hf hg
  | mul_X f coordinate hf =>
      rw [map_mul]
      apply T.mul_mem hf
      rcases coordinate with ⟨h, coordinate⟩
      cases coordinate with
      | inl block =>
          let baseblock : MvPolynomial
              (BlockIncidenceBaseIndex b t s d) ℂ :=
            MvPolynomial.X (h, Sum.inl block)
          have heq : algebraMap
              (MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ)
              (BlockIncidenceCoordinateRing b t s d) baseblock =
                Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
                  (MvPolynomial.X (h, Sum.inl block)) := by
            change blockIncidenceBaseProjection
              b t s d baseblock = _
            simp only [blockIncidenceBaseProjection, MvPolynomial.aeval_X, baseblock]
          rw [← heq]
          exact T.algebraMap_mem baseblock
      | inr coordinate =>
          exact Algebra.subset_adjoin ⟨(h, coordinate), rfl⟩

theorem blockIncidenceBase_ringKrullDim (b t s d : ℕ) :
    ringKrullDim
      (MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ) =
      ((b * ((2 ^ t - 1) + s * (d - 2)) : ℕ) : WithBot ℕ∞) := by
  rw [MvPolynomial.ringKrullDim_of_isNoetherianRing,
    ringKrullDim_eq_zero_of_field, Nat.card_eq_fintype_card,
    Fintype.card_prod, Fintype.card_sum, Fintype.card_prod,
    incidenceRowBlock_card]
  simp only [Fintype.card_fin, Nat.cast_mul, Nat.cast_add, zero_add]

theorem blockIncidence_ringKrullDim_le_of_power_reductions
    {b t s d : ℕ} (hd : 3 ≤ d)
    (remainder : BlockIncidenceColumn b t s →
      MvPolynomial (BlockIncidenceColumn b t s)
        (MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ))
    (hdegree : ∀ coordinate, (remainder coordinate).totalDegree < d - 1)
    (hrel :
      letI := blockIncidenceBaseAlgebra b t s d
      ∀ coordinate : BlockIncidenceColumn b t s,
        (Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
          (MvPolynomial.X (coordinate.1, Sum.inr coordinate.2))) ^ (d - 1) =
        MvPolynomial.aeval
          (fun row : BlockIncidenceColumn b t s =>
            Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
              (MvPolynomial.X (row.1, Sum.inr row.2)))
          (remainder coordinate)) :
    ringKrullDim (BlockIncidenceCoordinateRing b t s d) ≤
      ((b * ((2 ^ t - 1) + s * (d - 2)) : ℕ) : WithBot ℕ∞) := by
  letI := blockIncidenceBaseAlgebra b t s d
  letI : Module.Finite
      (MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ)
      (BlockIncidenceCoordinateRing b t s d) :=
    finite_of_totalDegree_power_reductions
      (fun coordinate : BlockIncidenceColumn b t s =>
        Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
          (MvPolynomial.X (coordinate.1, Sum.inr coordinate.2)))
      (d - 1) (by omega) remainder hdegree hrel
      (blockIncidence_adjoin_column_coordinates b t s d)
  letI : Algebra.IsIntegral
      (MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ)
      (BlockIncidenceCoordinateRing b t s d) :=
    Algebra.IsIntegral.of_finite _ _
  exact ringKrullDim_le_of_isIntegral.trans
    (blockIncidenceBase_ringKrullDim b t s d).le

noncomputable def blockIncidenceBaseRename
    (b t s d : ℕ) (block : Fin b) :
    MvPolynomial
        (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ →+*
      (MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ) :=
  (MvPolynomial.rename
    (fun coordinate : IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2)) =>
      (block, coordinate))).toRingHom

noncomputable def blockIncidencePowerRemainder
    (b t s d : ℕ)
    (coordinate : Fin b × (Fin s × Fin t)) :
    MvPolynomial (Fin b × (Fin s × Fin t))
      ((MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ)) :=
  MvPolynomial.rename
    (fun row : Fin s × Fin t => (coordinate.1, row))
    (MvPolynomial.map
      (blockIncidenceBaseRename b t s d coordinate.1)
      (partitionIncidenceGlobalPowerRemainder t s d coordinate.2))

theorem blockIncidencePowerRemainder_totalDegree
    {b t s d : ℕ} (hd : 3 ≤ d)
    (coordinate : Fin b × (Fin s × Fin t)) :
    (blockIncidencePowerRemainder
      b t s d coordinate).totalDegree < d - 1 := by
  unfold blockIncidencePowerRemainder
  exact lt_of_le_of_lt
    ((MvPolynomial.totalDegree_rename_le _ _).trans
      (incidence_mvPolynomial_totalDegree_map_le _ _))
    (partitionIncidenceGlobalPowerRemainder_totalDegree hd coordinate.2)

noncomputable def blockIncidenceSingleBlockInclusion
    (b t s d : ℕ) (block : Fin b) :
    PartitionIncidenceCoordinateRing t s d →ₐ[ℂ]
      BlockIncidenceCoordinateRing b t s d :=
  Ideal.Quotient.liftₐ (partitionIncidenceIdeal t s d)
    ((Ideal.Quotient.mkₐ ℂ
      (blockIncidenceIdeal b t s d)).comp
      (MvPolynomial.rename
        (fun z : IncidenceCoordinate t s => (block, z))))
    (by
      intro f hf
      rw [partitionIncidenceIdeal,
        Ideal.mem_span_range_iff_exists_fun] at hf
      obtain ⟨coefficients, hcoefficients⟩ := hf
      rw [← hcoefficients, map_sum]
      apply Finset.sum_eq_zero
      intro coordinate _
      rw [map_mul]
      have hgenerator :
          MvPolynomial.rename
            (fun z : IncidenceCoordinate t s => (block, z))
            (partitionIncidenceEquation t s d
              coordinate.1 coordinate.2) ∈
            blockIncidenceIdeal b t s d := by
        exact Ideal.subset_span
          ⟨(block, coordinate), rfl⟩
      have hzero :
          Ideal.Quotient.mk
            (blockIncidenceIdeal b t s d)
            (MvPolynomial.rename
              (fun z : IncidenceCoordinate t s => (block, z))
              (partitionIncidenceEquation t s d
                coordinate.1 coordinate.2)) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hgenerator
      change _ *
        Ideal.Quotient.mk
          (blockIncidenceIdeal b t s d)
          (MvPolynomial.rename
            (fun z : IncidenceCoordinate t s => (block, z))
            (partitionIncidenceEquation t s d
              coordinate.1 coordinate.2)) = 0
      rw [hzero, mul_zero])

theorem blockIncidenceSingleBlockInclusion_mk
    (b t s d : ℕ) (block : Fin b)
    (p : MvPolynomial (IncidenceCoordinate t s) ℂ) :
    blockIncidenceSingleBlockInclusion b t s d block
      (Ideal.Quotient.mk (partitionIncidenceIdeal t s d) p) =
      Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
        (MvPolynomial.rename
          (fun z : IncidenceCoordinate t s => (block, z)) p) := by
  rfl

theorem blockIncidenceBaseProjection_comm
    (b t s d : ℕ) (block : Fin b) :
    (blockIncidenceBaseProjection b t s d).comp
        (MvPolynomial.rename
          (fun z : IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2)) =>
            (block, z))) =
      (blockIncidenceSingleBlockInclusion b t s d block).comp
        (partitionIncidenceGlobalBaseProjection t s d) := by
  ext z
  rcases z with z | ⟨column, index⟩
  · simp only [AlgHom.comp_apply, MvPolynomial.rename_X,
      blockIncidenceBaseProjection, partitionIncidenceGlobalBaseProjection,
      MvPolynomial.aeval_X]
    change
      Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
          (MvPolynomial.X (block, Sum.inl z)) =
        blockIncidenceSingleBlockInclusion b t s d block
          (Ideal.Quotient.mk (partitionIncidenceIdeal t s d)
            (MvPolynomial.X (Sum.inl z)))
    rw [blockIncidenceSingleBlockInclusion_mk]
    simp only [MvPolynomial.rename_X]
  · simp only [AlgHom.comp_apply, MvPolynomial.rename_X,
      blockIncidenceBaseProjection, partitionIncidenceGlobalBaseProjection,
      MvPolynomial.aeval_X]
    change
      Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
        (MvPolynomial.rename
          (fun row : Fin t => (block, Sum.inr (column, row)))
          (partitionFiberCoordinateEsymmPolynomial t (index.val + 1))) =
        blockIncidenceSingleBlockInclusion b t s d block
          (Ideal.Quotient.mk (partitionIncidenceIdeal t s d)
            (MvPolynomial.rename
              (fun row : Fin t => Sum.inr (column, row))
              (partitionFiberCoordinateEsymmPolynomial t (index.val + 1))))
    rw [blockIncidenceSingleBlockInclusion_mk,
      MvPolynomial.rename_rename]
    rfl

theorem blockIncidencePowerRemainder_aeval
    {b t s d : ℕ} (hd : 3 ≤ d) (ht : d ≤ t)
    (coordinate : Fin b × (Fin s × Fin t)) :
    letI := blockIncidenceBaseAlgebra b t s d
    (Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
      (MvPolynomial.X (coordinate.1, Sum.inr coordinate.2))) ^ (d - 1) =
      MvPolynomial.aeval
        (fun row : Fin b × (Fin s × Fin t) =>
          Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
            (MvPolynomial.X (row.1, Sum.inr row.2)))
        (blockIncidencePowerRemainder b t s d coordinate) := by
  classical
  letI := blockIncidenceBaseAlgebra b t s d
  letI := partitionIncidenceGlobalBaseAlgebra t s d
  haveI : Module (MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ)
      (MvPolynomial (BlockIncidenceCoordinate b t s) ℂ ⧸ blockIncidenceIdeal b t s d) :=
    Algebra.toModule
  haveI : Module (MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)
      (MvPolynomial (IncidenceCoordinate t s) ℂ ⧸ partitionIncidenceIdeal t s d) :=
    Algebra.toModule
  let φ := blockIncidenceSingleBlockInclusion b t s d coordinate.1
  have hcoeff
      (p : MvPolynomial
        (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ) :
      algebraMap
        (MvPolynomial (BlockIncidenceBaseIndex b t s d) ℂ)
        (BlockIncidenceCoordinateRing b t s d)
        (blockIncidenceBaseRename b t s d coordinate.1 p) =
      φ (algebraMap
        (MvPolynomial (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)
        (PartitionIncidenceCoordinateRing t s d) p) := by
    change
      blockIncidenceBaseProjection b t s d
        ((MvPolynomial.rename
          (fun z : IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2)) =>
            (coordinate.1, z))) p) =
      φ (partitionIncidenceGlobalBaseProjection t s d p)
    exact DFunLike.congr_fun
      (blockIncidenceBaseProjection_comm b t s d coordinate.1) p
  have hpoly
      (p : MvPolynomial (Fin s × Fin t)
        (MvPolynomial
          (IncidenceRowBlock t ⊕ (Fin s × Fin (d - 2))) ℂ)) :
      MvPolynomial.aeval
        (fun row : Fin b × (Fin s × Fin t) =>
          Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
            (MvPolynomial.X (row.1, Sum.inr row.2)))
        (MvPolynomial.rename
          (fun row : Fin s × Fin t => (coordinate.1, row))
          (MvPolynomial.map
            (blockIncidenceBaseRename b t s d coordinate.1) p)) =
      φ (MvPolynomial.aeval
        (fun row : Fin s × Fin t =>
          Ideal.Quotient.mk (partitionIncidenceIdeal t s d)
            (MvPolynomial.X (Sum.inr row))) p) := by
    induction p using MvPolynomial.induction_on with
    | C p =>
        simpa using hcoeff p
    | add p q hp hq =>
        simp [hp, hq]
    | mul_X p row hp =>
        simp [hp, φ, blockIncidenceSingleBlockInclusion_mk]
  have hsource := congrArg φ
    (partitionIncidenceGlobalPowerRemainder_aeval hd ht coordinate.2)
  rw [map_pow] at hsource
  rw [blockIncidenceSingleBlockInclusion_mk] at hsource
  simp only [MvPolynomial.rename_X] at hsource
  rw [← hpoly] at hsource
  exact hsource

theorem blockIncidence_ringKrullDim_le_degree
    {b t s d : ℕ} (hd : 3 ≤ d) (ht : d ≤ t) :
    ringKrullDim (BlockIncidenceCoordinateRing b t s d) ≤
      ((b * ((2 ^ t - 1) + s * (d - 2)) : ℕ) : WithBot ℕ∞) := by
  exact blockIncidence_ringKrullDim_le_of_power_reductions hd
    (blockIncidencePowerRemainder b t s d)
    (blockIncidencePowerRemainder_totalDegree hd)
    (blockIncidencePowerRemainder_aeval hd ht)

end Standalone_Incidence

section Standalone_SourceCircuitBridge

open scoped BigOperators

noncomputable section

noncomputable def sourceSlicedGradientLinearInput {k m : ℕ}
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (j : Fin m) : FreeAffineInput (Fin k) where
  constant := 0
  inputCoefficients :=
    (Finsupp.linearEquivFunOnFinite ℂ ℂ (Fin k)).symm
      (fun i => W (Pi.single i 1) j)

theorem sourceSlicedGradientLinearInput_polynomial {k m : ℕ}
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (j : Fin m) :
    (sourceSlicedGradientLinearInput W j).polynomial =
      linearCoordinatePolynomial W j := by
  simp only [FreeAffineInput.polynomial,
    sourceSlicedGradientLinearInput, MvPolynomial.C_0, zero_add,
    Finsupp.linearCombination_eq_fintype_linearCombination_apply,
    Fintype.linearCombination_apply, linearCoordinatePolynomial]
  apply Finset.sum_congr rfl
  intro i _
  simp only [MvPolynomial.smul_eq_C_mul]

noncomputable def sourceFreeAffineFormFiniteLinearCombination
    {ι α : Type*} [Fintype α]
    (coefficient : α → ℂ) (form : α → FreeAffineForm ι) :
    FreeAffineForm ι where
  constant := ∑ j, coefficient j * (form j).constant
  inputCoefficients := ∑ j, coefficient j • (form j).inputCoefficients
  gateCoefficients := ∑ j, coefficient j • (form j).gateCoefficients

theorem sourceFreeAffineFormFiniteLinearCombination_eval
    {ι α : Type*} [Fintype α]
    (coefficient : α → ℂ) (form : α → FreeAffineForm ι)
    (values : Array (MvPolynomial ι ℂ)) :
    (sourceFreeAffineFormFiniteLinearCombination coefficient form).eval values =
      ∑ j, MvPolynomial.C (coefficient j) * (form j).eval values := by
  simp only [FreeAffineForm.eval,
    sourceFreeAffineFormFiniteLinearCombination,
    map_sum, map_mul, map_smul]
  simp only [MvPolynomial.smul_eq_C_mul]
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro j _
  ring

theorem sourceFreeAffineFormFiniteLinearCombination_gate_bound
    {ι α : Type*} [Fintype α]
    (coefficient : α → ℂ) (form : α → FreeAffineForm ι)
    (bound : ℕ)
    (hform : ∀ j i, (form j).gateCoefficients i ≠ 0 → i < bound) :
    ∀ i,
      (sourceFreeAffineFormFiniteLinearCombination coefficient form).gateCoefficients i ≠ 0 →
        i < bound := by
  intro i hi
  by_contra hbound
  have hzero : ∀ j, (form j).gateCoefficients i = 0 := by
    intro j
    by_contra hj
    exact hbound (hform j i hj)
  apply hi
  simp only [sourceFreeAffineFormFiniteLinearCombination, Finsupp.coe_finsetSum, Finsupp.coe_smul,
    Finset.sum_apply, Pi.smul_apply, hzero, smul_eq_mul, mul_zero, Finset.sum_const_zero]

noncomputable def sourceSlicedGradientReverseOutputForm
    {k m : ℕ}
    (circuit : FreeAffineCircuit (Fin m))
    (output : FreeAffineForm (Fin m))
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ))
    (i : Fin k) : FreeAffineForm (Fin k) :=
  sourceFreeAffineFormFiniteLinearCombination
    (fun j : Fin m => (A (Pi.single j 1)) i)
    (fun j : Fin m =>
      (((ReverseAdjoint.CircuitAdjoint.run circuit output).inputAdjoints j).substituteInputs
        (sourceSlicedGradientLinearInput W)))

theorem sourceSlicedGradientReverseOutputForm_gate_bound
    {k m : ℕ}
    (circuit : FreeAffineCircuit (Fin m))
    (output : FreeAffineForm (Fin m))
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ))
    (i : Fin k) (index : ℕ)
    (hindex : (sourceSlicedGradientReverseOutputForm
      circuit output W A i).gateCoefficients index ≠ 0) :
    index <
      ((ReverseAdjoint.CircuitAdjoint.run circuit output).circuit.substituteInputs
        (sourceSlicedGradientLinearInput W)).program.length := by
  apply sourceFreeAffineFormFiniteLinearCombination_gate_bound
    (fun j : Fin m => (A (Pi.single j 1)) i)
    (fun j : Fin m =>
      (((ReverseAdjoint.CircuitAdjoint.run circuit output).inputAdjoints j).substituteInputs
        (sourceSlicedGradientLinearInput W)))
    ((ReverseAdjoint.CircuitAdjoint.run circuit output).circuit.substituteInputs
      (sourceSlicedGradientLinearInput W)).program.length
    ?_ index hindex
  intro j r hr
  have h := (ReverseAdjoint.CircuitAdjoint.run circuit output).validInputAdjoints j r
    (by simpa only [ne_eq, FreeAffineForm.substituteInputs] using hr)
  simpa only [FreeAffineCircuit.substituteInputs, List.length_map, gt_iff_lt] using h

theorem exists_actual_slicedGradient_freeAffineCircuit
    {k m : ℕ}
    (circuit : FreeAffineCircuit (Fin m))
    (output : FreeAffineForm (Fin m))
    (houtput : output ∈ circuit.outputs)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ)) :
    ∃ D : FreeAffineCircuit (Fin k),
      D.multiplicationCount = 3 * circuit.multiplicationCount ∧
      D.polynomials = (Finset.univ : Finset (Fin k)).toList.map
        (slicedGradientPolynomial (output.eval circuit.values) W A) := by
  classical
  let state := ReverseAdjoint.CircuitAdjoint.run circuit output
  let substitution := sourceSlicedGradientLinearInput W
  let base := state.circuit.substituteInputs substitution
  let forms : List (FreeAffineForm (Fin k)) :=
    (Finset.univ : Finset (Fin k)).toList.map
      (sourceSlicedGradientReverseOutputForm circuit output W A)
  have hvalid : ∀ form ∈ forms, ∀ index : ℕ,
      form.gateCoefficients index ≠ 0 → index < base.program.length := by
    intro form hform index hindex
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hform
    exact sourceSlicedGradientReverseOutputForm_gate_bound
      circuit output W A i index hindex
  refine ⟨base.withOutputs forms hvalid, ?_, ?_⟩
  · change base.multiplicationCount = 3 * circuit.multiplicationCount
    dsimp [base, state, substitution]
    rw [FreeAffineCircuit.multiplicationCount_substituteInputs,
      ReverseAdjoint.CircuitAdjoint.run_multiplicationCount]
  · change forms.map (fun form => form.eval base.values) = _
    dsimp [forms]
    simp only [List.map_map]
    apply List.map_congr_left
    intro i _
    change (sourceSlicedGradientReverseOutputForm circuit output W A i).eval
      base.values = _
    unfold sourceSlicedGradientReverseOutputForm
    rw [sourceFreeAffineFormFiniteLinearCombination_eval]
    unfold slicedGradientPolynomial
    apply Finset.sum_congr rfl
    intro j _
    congr 1
    dsimp [base, state, substitution]
    rw [FreeAffineCircuit.values_substituteInputs,
      FreeAffineForm.eval_substituteInputs,
      ReverseAdjoint.CircuitAdjoint.run_inputAdjoints
        circuit output houtput j]
    refine DFunLike.congr_fun (MvPolynomial.algHom_ext ?_) _
    intro row
    simpa only [MvPolynomial.aeval_eq_bind₁, MvPolynomial.bind₁_X_right] using
      sourceSlicedGradientLinearInput_polynomial W row

theorem exists_normalized_permanent_affine_specialization_circuit
    {n m : ℕ}
    (circuit : ArithmeticCircuit (Fin n × Fin n))
    (hpermanent : circuit.polynomial = permanent n)
    (substitution : (Fin n × Fin n) → FreeAffineInput (Fin m))
    (P : MvPolynomial (Fin m) ℂ)
    (c : ℂ) (hc : c ≠ 0)
    (hspecialization :
      MvPolynomial.aeval (fun ij => (substitution ij).polynomial)
          (permanent n) = MvPolynomial.C c * P) :
    ∃ D : FreeAffineCircuit (Fin m),
      ∃ output : FreeAffineForm (Fin m),
        output ∈ D.outputs ∧
        output.eval D.values = P ∧
        D.multiplicationCount ≤ circuit.size := by
  classical
  let free := FreeAffineCircuit.ofArithmetic circuit
  let base := free.substituteInputs substitution
  let raw : FreeAffineForm (Fin m) :=
    (FreeAffineForm.gate circuit.output).substituteInputs substitution
  let output : FreeAffineForm (Fin m) := c⁻¹ • raw
  have hraw : raw ∈ base.outputs := by
    simp only [FreeAffineCircuit.substituteInputs, FreeAffineCircuit.ofArithmetic, List.map_map, List.map_cons,
      List.map_nil, List.mem_cons, List.not_mem_nil, or_false, base, free, raw]
  have hvalid : ∀ form ∈ ([output] : List (FreeAffineForm (Fin m))),
      ∀ index : ℕ,
        form.gateCoefficients index ≠ 0 → index < base.program.length := by
    intro form hform index hindex
    have heq : form = output := List.mem_singleton.mp hform
    subst form
    have hrawne : raw.gateCoefficients index ≠ 0 := by
      intro hz
      apply hindex
      change ((c⁻¹ • raw.gateCoefficients : ℕ →₀ ℂ) index) = 0
      simp only [Finsupp.coe_smul, Pi.smul_apply, hz, smul_eq_mul, mul_zero]
    exact base.validOutputs raw hraw index hrawne
  let D := base.withOutputs [output] hvalid
  refine ⟨D, output, by simp only [FreeAffineCircuit.withOutputs, List.mem_cons, List.not_mem_nil, or_false, D], ?_, ?_⟩
  · change output.eval base.values = P
    change (c⁻¹ • raw).eval base.values = P
    rw [FreeAffineForm.eval_smul]
    have hrawvalue : raw.eval base.values =
        MvPolynomial.aeval (fun ij => (substitution ij).polynomial)
          (permanent n) := by
      dsimp [raw, base]
      rw [FreeAffineCircuit.values_substituteInputs,
        FreeAffineForm.eval_substituteInputs,
        FreeAffineForm.eval_gate,
        FreeAffineCircuit.values_ofArithmetic]
      change MvPolynomial.aeval (fun ij => (substitution ij).polynomial)
        circuit.polynomial = _
      rw [hpermanent]
      apply DFunLike.congr_fun (x := permanent n)
      apply MvPolynomial.algHom_ext
      intro ij
      simp only [MvPolynomial.aeval_eq_bind₁, MvPolynomial.bind₁_X_right]
    rw [hrawvalue, hspecialization]
    rw [MvPolynomial.smul_eq_C_mul, ← mul_assoc, ← map_mul,
      inv_mul_cancel₀ hc, map_one, one_mul]
  · change base.multiplicationCount ≤ circuit.size
    dsimp [base, free]
    rw [FreeAffineCircuit.multiplicationCount_substituteInputs]
    exact FreeAffineCircuit.multiplicationCount_ofArithmetic_le circuit

theorem exists_normalized_permanent_slicedGradient_circuit
    {n m k : ℕ}
    (circuit : ArithmeticCircuit (Fin n × Fin n))
    (hpermanent : circuit.polynomial = permanent n)
    (substitution : (Fin n × Fin n) → FreeAffineInput (Fin m))
    (P : MvPolynomial (Fin m) ℂ)
    (c : ℂ) (hc : c ≠ 0)
    (hspecialization :
      MvPolynomial.aeval (fun ij => (substitution ij).polynomial)
          (permanent n) = MvPolynomial.C c * P)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ)) :
    ∃ D : FreeAffineCircuit (Fin k),
      D.multiplicationCount ≤ 3 * circuit.size ∧
      D.polynomials = (Finset.univ : Finset (Fin k)).toList.map
        (slicedGradientPolynomial P W A) := by
  obtain ⟨source, output, houtput, hvalue, hcount⟩ :=
    exists_normalized_permanent_affine_specialization_circuit
      circuit hpermanent substitution P c hc hspecialization
  obtain ⟨D, hDcount, hDpolynomials⟩ :=
    exists_actual_slicedGradient_freeAffineCircuit
      source output houtput W A
  refine ⟨D, ?_, ?_⟩
  · rw [hDcount]
    exact Nat.mul_le_mul_left 3 hcount
  · simpa only [hvalue] using hDpolynomials

noncomputable def freeAffineCircuitSquareFamily
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k))
    (output : Fin k → FreeAffineForm (Fin k)) (target : Fin k → ℂ) :
    Fin (Fintype.card (Fin k ⊕ Fin circuit.program.length)) →
      MvPolynomial (Fin k ⊕ Fin circuit.program.length) ℂ :=
  fun i =>
    Fin.append
      (freeAffineCircuitInstructionEquation circuit)
      (fun j : Fin k =>
        freeAffineExtendedForm
          (n := circuit.program.length) (output j) -
          MvPolynomial.C (target j))
      (Fin.cast (by simp only [Fintype.card_sum, Fintype.card_fin, Nat.add_comm]) i)

theorem freeAffineCircuitSquareFamily_ofFn
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k))
    (output : Fin k → FreeAffineForm (Fin k)) (target : Fin k → ℂ) :
    List.ofFn (freeAffineCircuitSquareFamily circuit output target) =
      (List.ofFn fun j : Fin circuit.program.length =>
        freeAffineCircuitInstructionEquation circuit j) ++
      (List.ofFn fun i : Fin k =>
        freeAffineExtendedForm
          (n := circuit.program.length) (output i) -
          MvPolynomial.C (target i)) := by
  let gates := freeAffineCircuitInstructionEquation circuit
  let outputs : Fin k → MvPolynomial (Fin k ⊕ Fin circuit.program.length) ℂ :=
    fun i => freeAffineExtendedForm
      (n := circuit.program.length) (output i) - MvPolynomial.C (target i)
  have hcard : circuit.program.length + k =
      Fintype.card (Fin k ⊕ Fin circuit.program.length) := by
    simp only [Nat.add_comm, Fintype.card_sum, Fintype.card_fin]
  have hcast :
      List.ofFn (freeAffineCircuitSquareFamily circuit output target) =
      List.ofFn (Fin.append gates outputs) := by
    simpa only [Fintype.card_sum, Fintype.card_fin, freeAffineCircuitSquareFamily, Fin.cast_cast,
      List.ofFn_fin_append] using (List.ofFn_congr hcard (Fin.append gates outputs)).symm
  rw [hcast, List.ofFn_fin_append]

theorem sourceCircuit_ofList_ofFn_eq_span_range
    {R : Type*} [CommSemiring R] {n : ℕ} (f : Fin n → R) :
    Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) := by
  change Ideal.span {p : R | p ∈ List.ofFn f} =
    Ideal.span (Set.range f)
  congr 1
  ext p
  simp only [List.mem_ofFn, Set.mem_setOf_eq, Set.mem_range]

theorem freeAffineCircuitSquareFamily_span_range
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k))
    (output : Fin k → FreeAffineForm (Fin k)) (target : Fin k → ℂ) :
    Ideal.span (Set.range
      (freeAffineCircuitSquareFamily circuit output target)) =
      affineTriangularInstructionIdeal
        (fun j : Fin circuit.program.length =>
          freeAffineInstructionRhs
            (n := circuit.program.length) (circuit.program.get j)) ⊔
      affineGateRawOutputIdeal
        (fun i : Fin k =>
          freeAffineExtendedForm
            (n := circuit.program.length) (output i)) target := by
  rw [← sourceCircuit_ofList_ofFn_eq_span_range,
    freeAffineCircuitSquareFamily_ofFn,
    Ideal.ofList_append,
    sourceCircuit_ofList_ofFn_eq_span_range,
    sourceCircuit_ofList_ofFn_eq_span_range]
  rfl

theorem freeAffineCircuitSquareFamily_degree_product_le
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k))
    (output : Fin k → FreeAffineForm (Fin k)) (target : Fin k → ℂ) :
    (∏ i,
      (freeAffineCircuitSquareFamily circuit output target i).totalDegree) ≤
      2 ^ circuit.multiplicationCount := by
  have hlist := congrArg
    (fun l : List
        (MvPolynomial (Fin k ⊕ Fin circuit.program.length) ℂ) =>
      (l.map (fun p => p.totalDegree)).prod)
    (freeAffineCircuitSquareFamily_ofFn circuit output target)
  have hproduct :
      (∏ i,
        (freeAffineCircuitSquareFamily circuit output target i).totalDegree) =
        (∏ j : Fin circuit.program.length,
          (freeAffineCircuitInstructionEquation circuit j).totalDegree) *
        (∏ i : Fin k,
          (freeAffineExtendedForm
            (n := circuit.program.length) (output i) -
              MvPolynomial.C (target i)).totalDegree) := by
    simpa only [List.map_append, List.prod_append,
      List.map_ofFn, Fin.prod_ofFn, Function.comp_apply] using hlist
  rw [hproduct]
  calc
    (∏ j : Fin circuit.program.length,
      (freeAffineCircuitInstructionEquation circuit j).totalDegree) *
      (∏ i : Fin k,
        (freeAffineExtendedForm
          (n := circuit.program.length) (output i) -
          MvPolynomial.C (target i)).totalDegree) ≤
        2 ^ circuit.multiplicationCount * 1 := by
          apply Nat.mul_le_mul
          · exact freeAffineCircuitInstructionEquation_degree_product_le circuit
          · calc
              (∏ i : Fin k,
                (freeAffineExtendedForm
                  (n := circuit.program.length) (output i) -
                  MvPolynomial.C (target i)).totalDegree) ≤
                    ∏ _ : Fin k, (1 : ℕ) := by
                      apply Finset.prod_le_prod'
                      intro i _
                      exact affine_output_equation_totalDegree_le_one
                        (freeAffineExtendedForm
                          (n := circuit.program.length) (output i))
                        (target i)
                        (freeAffineExtendedForm_totalDegree_le_one
                          (n := circuit.program.length) (output i))
              _ = 1 := by simp only [Finset.prod_const_one]
    _ = 2 ^ circuit.multiplicationCount := Nat.mul_one _

theorem freeAffineCircuitSquareFamily_isWeaklyRegular
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k))
    (output : Fin k → FreeAffineForm (Fin k))
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (target : Fin k → ℂ)
    (houtput : ∀ i, (output i).eval circuit.values = F i) :
    RingTheory.Sequence.IsWeaklyRegular
      (MvPolynomial (Fin k ⊕ Fin circuit.program.length) ℂ)
      (List.ofFn (freeAffineCircuitSquareFamily circuit output target)) := by
  rw [freeAffineCircuitSquareFamily_ofFn]
  apply affine_triangular_instruction_output_equations_isWeaklyRegular
    (fun j : Fin circuit.program.length =>
      freeAffineInstructionRhs
        (n := circuit.program.length) (circuit.program.get j))
    (freeAffineCircuitGate circuit)
    (fun i : Fin k =>
      freeAffineExtendedForm
        (n := circuit.program.length) (output i))
    F target
  · intro j
    simpa only [affineGateGraphEvaluation, MvPolynomial.aeval_eq_bind₁, List.get_eq_getElem,
      freeAffineCircuitGraphEvaluation] using freeAffineCircuitGate_eq_graphEvaluation_rhs circuit j
  · intro j i hi
    exact freeAffineInstructionRhs_mem_gate_vars
      (circuit.program.get j) j (circuit.valid j) i hi
  · intro i
    simpa only [affineGateGraphEvaluation, MvPolynomial.aeval_eq_bind₁, freeAffineCircuitGraphEvaluation] using
      (freeAffineCircuitGraphEvaluation_extendedForm circuit (output i)).trans (houtput i)
  · exact homogeneousMap_allTarget_translated_isWeaklyRegular
      F target e he hF hzero

theorem freeAffineCircuitSquareFamily_zeroLocus_finite
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k))
    (output : Fin k → FreeAffineForm (Fin k))
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (target : Fin k → ℂ)
    (houtput : ∀ i, (output i).eval circuit.values = F i) :
    (MvPolynomial.zeroLocus ℂ
      (Ideal.span (Set.range
        (freeAffineCircuitSquareFamily circuit output target)))).Finite := by
  let rhs : Fin circuit.program.length →
      MvPolynomial (Fin k ⊕ Fin circuit.program.length) ℂ :=
    fun j => freeAffineInstructionRhs
      (n := circuit.program.length) (circuit.program.get j)
  let gate : Fin circuit.program.length → MvPolynomial (Fin k) ℂ :=
    freeAffineCircuitGate circuit
  let out : Fin k → MvPolynomial (Fin k ⊕ Fin circuit.program.length) ℂ :=
    fun i => freeAffineExtendedForm
      (n := circuit.program.length) (output i)
  have hgate : ∀ j, gate j = affineGateGraphEvaluation gate (rhs j) := by
    intro j
    simpa [gate, rhs, affineGateGraphEvaluation,
      freeAffineCircuitGraphEvaluation] using
      freeAffineCircuitGate_eq_graphEvaluation_rhs circuit j
  have htop : ∀ j i : Fin circuit.program.length,
      Sum.inr i ∈ (rhs j).vars → i.val < j.val := by
    intro j i hi
    exact freeAffineInstructionRhs_mem_gate_vars
      (circuit.program.get j) j (circuit.valid j) i hi
  have hout : ∀ i, affineGateGraphEvaluation gate (out i) = F i := by
    intro i
    simpa only [affineGateGraphEvaluation, MvPolynomial.aeval_eq_bind₁, freeAffineCircuitGraphEvaluation] using
      (freeAffineCircuitGraphEvaluation_extendedForm circuit (output i)).trans (houtput i)
  let E := affineTriangularInstructionOutputClosedFiberAlgEquiv
    rhs gate out F target hgate htop hout
  letI : Module.Finite ℂ (homogeneousMapClosedFiber F target) :=
    homogeneousMapFiber_finiteDimensional F e he hF hzero target
  have hfinite : Module.Finite ℂ
      (MvPolynomial (Fin k ⊕ Fin circuit.program.length) ℂ ⧸
        (affineTriangularInstructionIdeal rhs ⊔
          affineGateRawOutputIdeal out target)) :=
    Module.Finite.of_injective E.toLinearMap E.injective
  rw [freeAffineCircuitSquareFamily_span_range]
  exact affine_zeroLocus_finite_of_moduleFinite_quotient _ hfinite

theorem freeAffineCircuit_homogeneousFiberDegree_le_two_pow
    {k : ℕ} (circuit : FreeAffineCircuit (Fin k))
    (output : Fin k → FreeAffineForm (Fin k))
    (F : Fin k → MvPolynomial (Fin k) ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (target : Fin k → ℂ)
    (houtput : ∀ i, (output i).eval circuit.values = F i) :
    e ^ k ≤ 2 ^ circuit.multiplicationCount := by
  let rhs : Fin circuit.program.length →
      MvPolynomial (Fin k ⊕ Fin circuit.program.length) ℂ :=
    fun j => freeAffineInstructionRhs
      (n := circuit.program.length) (circuit.program.get j)
  let gate : Fin circuit.program.length → MvPolynomial (Fin k) ℂ :=
    freeAffineCircuitGate circuit
  let out : Fin k → MvPolynomial (Fin k ⊕ Fin circuit.program.length) ℂ :=
    fun i => freeAffineExtendedForm
      (n := circuit.program.length) (output i)
  have hgate : ∀ j, gate j = affineGateGraphEvaluation gate (rhs j) := by
    intro j
    simpa [gate, rhs, affineGateGraphEvaluation,
      freeAffineCircuitGraphEvaluation] using
      freeAffineCircuitGate_eq_graphEvaluation_rhs circuit j
  have htop : ∀ j i : Fin circuit.program.length,
      Sum.inr i ∈ (rhs j).vars → i.val < j.val := by
    intro j i hi
    exact freeAffineInstructionRhs_mem_gate_vars
      (circuit.program.get j) j (circuit.valid j) i hi
  have hout : ∀ i, affineGateGraphEvaluation gate (out i) = F i := by
    intro i
    simpa only [affineGateGraphEvaluation, MvPolynomial.aeval_eq_bind₁, freeAffineCircuitGraphEvaluation] using
      (freeAffineCircuitGraphEvaluation_extendedForm circuit (output i)).trans (houtput i)
  let f := freeAffineCircuitSquareFamily circuit output target
  have hweak := freeAffineCircuitSquareFamily_isWeaklyRegular
    circuit output F e he hF hzero target houtput
  have hfinite := freeAffineCircuitSquareFamily_zeroLocus_finite
    circuit output F e he hF hzero target houtput
  have hbezout := affine_finrank_le_degree_product_of_weaklyRegular
    f hweak hfinite
  rw [freeAffineCircuitSquareFamily_span_range] at hbezout
  have hfiber := affineTriangularInstructionOutputClosedFiber_finrank
    rhs gate out F e he hF hzero target hgate htop hout
  change
    Module.finrank ℂ
      (MvPolynomial (Fin k ⊕ Fin circuit.program.length) ℂ ⧸
        (affineTriangularInstructionIdeal rhs ⊔
          affineGateRawOutputIdeal out target)) = e ^ k at hfiber
  rw [hfiber] at hbezout
  exact hbezout.trans
    (freeAffineCircuitSquareFamily_degree_product_le
      circuit output target)

theorem normalizedPermanent_slicedGradient_homogeneousFiberDegree_le_two_pow
    {n m k : ℕ}
    (circuit : ArithmeticCircuit (Fin n × Fin n))
    (hpermanent : circuit.polynomial = permanent n)
    (substitution : (Fin n × Fin n) → FreeAffineInput (Fin m))
    (P : MvPolynomial (Fin m) ℂ)
    (c : ℂ) (hc : c ≠ 0)
    (hspecialization :
      MvPolynomial.aeval (fun ij => (substitution ij).polynomial)
          (permanent n) = MvPolynomial.C c * P)
    (W : (Fin k → ℂ) →ₗ[ℂ] (Fin m → ℂ))
    (A : (Fin m → ℂ) →ₗ[ℂ] (Fin k → ℂ))
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (slicedGradientPolynomial P W A i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point
        (slicedGradientPolynomial P W A i) = 0) ↔ point = 0) :
    e ^ k ≤ 2 ^ (3 * circuit.size) := by
  obtain ⟨D, hcount, hpolynomials⟩ :=
    exists_normalized_permanent_slicedGradient_circuit
      circuit hpermanent substitution P c hc hspecialization W A
  have hexists (i : Fin k) :
      ∃ form : FreeAffineForm (Fin k),
        form.eval D.values = slicedGradientPolynomial P W A i := by
    have hmem : slicedGradientPolynomial P W A i ∈ D.polynomials := by
      rw [hpolynomials]
      exact List.mem_map.mpr ⟨i, by simp only [Finset.mem_toList, Finset.mem_univ], rfl⟩
    change slicedGradientPolynomial P W A i ∈
      D.outputs.map (fun form => form.eval D.values) at hmem
    obtain ⟨form, _, hform⟩ := List.mem_map.mp hmem
    exact ⟨form, hform⟩
  choose forms hforms using hexists
  calc
    e ^ k ≤ 2 ^ D.multiplicationCount :=
      freeAffineCircuit_homogeneousFiberDegree_le_two_pow
        D forms (slicedGradientPolynomial P W A)
        e he hF hzero (fun _ => 0) hforms
    _ ≤ 2 ^ (3 * circuit.size) :=
      Nat.pow_le_pow_right (by decide : 0 < (2 : ℕ)) hcount

end

end Standalone_SourceCircuitBridge

section Standalone_TreeCoefficients

open scoped BigOperators

noncomputable def treeBlockVector {r : ℕ}
    (block : Finset (Fin r)) : Fin r → ℂ :=
  fun row => if row ∈ block then 1 else 0

noncomputable def treeQuotientLinearForm {r : ℕ}
    (vector : Fin r → ℂ) : SquareZeroAlgebra r :=
  ∑ row : Fin r,
    algebraMap ℂ (SquareZeroAlgebra r) (vector row) *
      squareZeroVariable r row

theorem treeQuotientLinearForm_eq_column {r k : ℕ}
    (U : Matrix (Fin r) (Fin k) ℂ) (column : Fin k) :
    Ideal.Quotient.mk (squareZeroIdeal r) (columnLinearForm U column) =
      treeQuotientLinearForm (fun row => U row column) := by
  simp only [columnLinearForm, treeQuotientLinearForm,
    squareZeroVariable, map_sum, map_mul]
  apply Finset.sum_congr rfl
  intro row _
  congr 1

theorem treeQuotientLinearForm_block {r : ℕ}
    (block : Finset (Fin r)) :
    treeQuotientLinearForm (treeBlockVector block) =
      squareZeroBlockSum r block := by
  classical
  simp only [treeQuotientLinearForm, treeBlockVector, MonoidWithZeroHom.map_ite_one_zero, ite_mul, one_mul,
    zero_mul, Finset.sum_ite_mem, Finset.univ_inter, squareZeroBlockSum]

theorem treeQuotientLinearForm_add {r : ℕ}
    (left right : Fin r → ℂ) :
    treeQuotientLinearForm (fun row => left row + right row) =
      treeQuotientLinearForm left + treeQuotientLinearForm right := by
  simp only [treeQuotientLinearForm, map_add, add_mul, Finset.sum_add_distrib]

theorem treeQuotientLinearForm_smul {r : ℕ}
    (a : ℂ) (vector : Fin r → ℂ) :
    treeQuotientLinearForm (fun row => a * vector row) =
      algebraMap ℂ (SquareZeroAlgebra r) a *
        treeQuotientLinearForm vector := by
  simp only [treeQuotientLinearForm, map_mul, mul_assoc, Finset.mul_sum]

theorem treeQuotientLinearForm_sum {r : ℕ} {ι : Type*}
    (indices : Finset ι) (vectors : ι → Fin r → ℂ) :
    treeQuotientLinearForm (fun row => ∑ i ∈ indices, vectors i row) =
      ∑ i ∈ indices, treeQuotientLinearForm (vectors i) := by
  classical
  induction indices using Finset.induction_on with
  | empty => simp only [treeQuotientLinearForm, Finset.sum_empty, map_zero, zero_mul, Finset.sum_const_zero]
  | @insert i indices hi ih =>
      simp only [Finset.sum_insert hi]
      rw [treeQuotientLinearForm_add, ih]

noncomputable def treeNodeVector {r : ℕ} {ι : Type*}
    [DecidableEq ι] (blocks : ι → Finset (Fin r))
    (left right : BlockTree ι) (ζ : ℂ) (j : ℕ) : Fin r → ℂ :=
  fun row =>
    (∑ i ∈ left.leaves, treeBlockVector (blocks i) row) +
      (2 * ζ ^ j) *
        (∑ i ∈ right.leaves, treeBlockVector (blocks i) row)

theorem treeQuotientLinearForm_node {r : ℕ} {ι : Type*}
    [DecidableEq ι] (blocks : ι → Finset (Fin r))
    (left right : BlockTree ι) (ζ : ℂ) (j : ℕ) :
    treeQuotientLinearForm (treeNodeVector blocks left right ζ j) =
      (∑ i ∈ left.leaves, squareZeroBlockSum r (blocks i)) +
        algebraMap ℂ (SquareZeroAlgebra r) (2 * ζ ^ j) *
          (∑ i ∈ right.leaves, squareZeroBlockSum r (blocks i)) := by
  unfold treeNodeVector
  rw [treeQuotientLinearForm_add,
    treeQuotientLinearForm_smul,
    treeQuotientLinearForm_sum,
    treeQuotientLinearForm_sum]
  simp only [treeQuotientLinearForm_block]

noncomputable def treeLinearFormVectors {r : ℕ} {ι : Type*}
    [DecidableEq ι] (blocks : ι → Finset (Fin r))
    (t d : ℕ) (ζ : ℂ) : BlockTree ι → List (Fin r → ℂ)
  | .leaf i => List.replicate (t - d) (treeBlockVector (blocks i))
  | .branch left right =>
      treeLinearFormVectors blocks t d ζ left ++
        treeLinearFormVectors blocks t d ζ right ++
          List.ofFn (fun j : Fin d =>
            treeNodeVector blocks left right ζ j)

theorem treeLinearFormVectors_quotient_prod {r : ℕ} {ι : Type*}
    [DecidableEq ι] (blocks : ι → Finset (Fin r))
    (t d : ℕ) (ζ : ℂ) (tree : BlockTree ι) :
    ((treeLinearFormVectors blocks t d ζ tree).map
      treeQuotientLinearForm).prod =
      subtreeLinearFormProduct
        (fun i => squareZeroBlockSum r (blocks i)) t d ζ tree := by
  classical
  induction tree with
  | leaf i =>
      simp only [treeLinearFormVectors, List.map_replicate, treeQuotientLinearForm_block, List.prod_replicate,
        subtreeLinearFormProduct]
  | branch left right ihleft ihright =>
      simp only [treeLinearFormVectors, List.map_append,
        List.prod_append, subtreeLinearFormProduct, ihleft, ihright]
      congr 1
      rw [List.map_ofFn, List.prod_ofFn]
      simpa only [Function.comp_apply, treeQuotientLinearForm_node] using
        (Fin.prod_univ_eq_prod_range
          (fun j : ℕ =>
            (∑ i ∈ left.leaves, squareZeroBlockSum r (blocks i)) +
              algebraMap ℂ (SquareZeroAlgebra r) (2 * ζ ^ j) *
                (∑ i ∈ right.leaves, squareZeroBlockSum r (blocks i))) d)

theorem tree_leafList_length_pos {ι : Type*} (tree : BlockTree ι) :
    0 < tree.leafList.length := by
  induction tree with
  | leaf i => simp only [BlockTree.leafList, List.length_cons, List.length_nil, zero_add, Order.lt_one_iff]
  | branch left right ihleft ihright =>
      simp only [BlockTree.leafList, List.length_append]
      omega

theorem treeLinearFormVectors_length {r : ℕ} {ι : Type*}
    [DecidableEq ι] (blocks : ι → Finset (Fin r))
    (t d : ℕ) (hd : d ≤ t) (ζ : ℂ) (tree : BlockTree ι) :
    (treeLinearFormVectors blocks t d ζ tree).length =
      tree.leafList.length * t - d := by
  induction tree with
  | leaf i => simp only [treeLinearFormVectors, List.length_replicate, BlockTree.leafList, List.length_cons,
                List.length_nil, zero_add, one_mul]
  | branch left right ihleft ihright =>
      have hleftone : 1 ≤ left.leafList.length :=
        tree_leafList_length_pos left
      have hrightone : 1 ≤ right.leafList.length :=
        tree_leafList_length_pos right
      have hleft : d ≤ left.leafList.length * t :=
        le_trans hd (by simpa only [one_mul] using Nat.mul_le_mul_right t hleftone)
      have hright : d ≤ right.leafList.length * t :=
        le_trans hd (by simpa only [one_mul] using Nat.mul_le_mul_right t hrightone)
      simp only [treeLinearFormVectors, List.length_append,
        List.length_ofFn, BlockTree.leafList, List.length_append,
        ihleft, ihright, Nat.add_mul]
      omega

noncomputable def treeLinearFormMatrix {r : ℕ} {ι : Type*}
    [DecidableEq ι] (blocks : ι → Finset (Fin r))
    (t d : ℕ) (ζ : ℂ) (tree : BlockTree ι) :
    Matrix (Fin r)
      (Fin (treeLinearFormVectors blocks t d ζ tree).length) ℂ :=
  fun row column =>
    (treeLinearFormVectors blocks t d ζ tree).get column row

theorem treeLinearFormMatrix_quotient_prod {r : ℕ} {ι : Type*}
    [DecidableEq ι] (blocks : ι → Finset (Fin r))
    (t d : ℕ) (ζ : ℂ) (tree : BlockTree ι) :
    Ideal.Quotient.mk (squareZeroIdeal r)
      (columnLinearFormProduct (treeLinearFormMatrix blocks t d ζ tree)) =
        subtreeLinearFormProduct
          (fun i => squareZeroBlockSum r (blocks i)) t d ζ tree := by
  classical
  calc
    Ideal.Quotient.mk (squareZeroIdeal r)
        (columnLinearFormProduct
          (treeLinearFormMatrix blocks t d ζ tree)) =
        ∏ column : Fin (treeLinearFormVectors blocks t d ζ tree).length,
          treeQuotientLinearForm
            ((treeLinearFormVectors blocks t d ζ tree).get column) := by
              simp only [columnLinearFormProduct, map_prod]
              apply Finset.prod_congr rfl
              intro column _
              exact treeQuotientLinearForm_eq_column
                (treeLinearFormMatrix blocks t d ζ tree) column
    _ = ((treeLinearFormVectors blocks t d ζ tree).map
          treeQuotientLinearForm).prod := by
            rw [← List.prod_ofFn]
            congr 1
            exact List.ofFn_getElem_eq_map
              (treeLinearFormVectors blocks t d ζ tree)
              treeQuotientLinearForm
    _ = subtreeLinearFormProduct
          (fun i => squareZeroBlockSum r (blocks i)) t d ζ tree :=
            treeLinearFormVectors_quotient_prod blocks t d ζ tree

noncomputable def sourceRowBlock (b t : ℕ) (h : Fin b) :
    Finset (Fin (b * t)) :=
  (Finset.univ : Finset (Fin t)).image
    (fun j => (finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t)) (h, j))

theorem mem_sourceRowBlock {b t : ℕ} (h : Fin b)
    (row : Fin (b * t)) :
    row ∈ sourceRowBlock b t h ↔
      ((finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t)).symm row).1 = h := by
  classical
  constructor
  · intro hrow
    obtain ⟨j, _, hj⟩ := Finset.mem_image.mp hrow
    subst row
    simp only [Equiv.symm_apply_apply]
  · intro hrow
    let e : Fin b × Fin t ≃ Fin (b * t) := finProdFinEquiv
    refine Finset.mem_image.mpr
      ⟨(e.symm row).2, Finset.mem_univ _, ?_⟩
    change e (h, (e.symm row).2) = row
    calc
      e (h, (e.symm row).2) =
          e ((e.symm row).1, (e.symm row).2) := by rw [hrow]
      _ = e (e.symm row) := by rw [Prod.eta]
      _ = row := e.apply_symm_apply row

theorem sourceRowBlock_card (b t : ℕ) (h : Fin b) :
    (sourceRowBlock b t h).card = t := by
  classical
  have hinj : Function.Injective
      (fun j : Fin t =>
        (finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t)) (h, j)) := by
    intro left right heq
    exact congrArg Prod.snd
      ((finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t)).injective heq)
  unfold sourceRowBlock
  rw [Finset.card_image_of_injective _ hinj]
  exact Fintype.card_fin t

theorem sourceRowBlock_disjoint {b t : ℕ} {left right : Fin b}
    (hne : left ≠ right) :
    Disjoint (sourceRowBlock b t left) (sourceRowBlock b t right) := by
  rw [Finset.disjoint_left]
  intro row hleft hright
  exact hne ((mem_sourceRowBlock left row).mp hleft |>.symm.trans
    ((mem_sourceRowBlock right row).mp hright))

theorem squareFreeExponent_le_iff {ι : Type*}
    (left right : Finset ι) :
    squareFreeExponent left ≤ squareFreeExponent right ↔ left ⊆ right := by
  classical
  constructor
  · intro h i hi
    by_contra hnot
    have hvalue := h i
    simp only [squareFreeExponent_apply, hi, ↓reduceIte, hnot, nonpos_iff_eq_zero, one_ne_zero] at hvalue
  · intro h i
    by_cases hi : i ∈ left
    · simp only [squareFreeExponent_apply, hi, ↓reduceIte, h hi, Std.le_refl]
    · simp only [squareFreeExponent_apply, hi, ↓reduceIte, zero_le]

theorem squareFreeExponent_sub {ι : Type*} [DecidableEq ι]
    (target removed : Finset ι) :
    squareFreeExponent target - squareFreeExponent removed =
      squareFreeExponent (target \ removed) := by
  classical
  ext i
  by_cases htarget : i ∈ target <;>
    by_cases hremoved : i ∈ removed <;>
      simp [Finsupp.tsub_apply, squareFreeExponent_apply,
        htarget, hremoved]

theorem coeff_squareFreeMonomial_mul {ι : Type*} [DecidableEq ι]
    (target removed : Finset ι) (p : MvPolynomial ι ℂ) :
    MvPolynomial.coeff (squareFreeExponent target)
      (squareFreeMonomial removed * p) =
        if removed ⊆ target then
          MvPolynomial.coeff (squareFreeExponent (target \ removed)) p
        else 0 := by
  classical
  rw [squareFreeMonomial_eq_monomial,
    MvPolynomial.coeff_monomial_mul']
  simp only [squareFreeExponent_le_iff, squareFreeExponent_sub, one_mul]

theorem squareZeroCoefficient_variable_product_mul (r : ℕ)
    (target removed : Finset (Fin r)) (p : SquareZeroAlgebra r) :
    squareZeroCoefficient r target
      ((∏ i ∈ removed, squareZeroVariable r i) * p) =
        if removed ⊆ target then
          squareZeroCoefficient r (target \ removed) p
        else 0 := by
  classical
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective p
  rw [← squareFreeMonomial_quotient_eq_variable_product,
    ← map_mul, squareZeroCoefficient_mk,
    coeff_squareFreeMonomial_mul]
  split_ifs <;> simp [squareZeroCoefficient_mk]

theorem squareFreeExponent_sum {ι : Type*} (rows : Finset ι) :
    (squareFreeExponent rows).sum (fun _ n => n) = rows.card := by
  classical
  simp only [Finsupp.sum, squareFreeExponent_support, squareFreeExponent_apply, Finset.sum_ite_mem,
    Finset.inter_self, Finset.sum_const, smul_eq_mul, mul_one]

theorem squareFreeExponent_multinomial {ι : Type*}
    (rows : Finset ι) :
    (squareFreeExponent rows).multinomial = rows.card.factorial := by
  classical
  rw [Finsupp.multinomial]
  change
    ((squareFreeExponent rows).sum (fun _ n => n)).factorial /
        (squareFreeExponent rows).prod (fun _ n => n.factorial) =
      rows.card.factorial
  rw [squareFreeExponent_sum]
  have hfactor :
      (squareFreeExponent rows).prod (fun _ n => n.factorial) = 1 := by
    rw [Finsupp.prod, squareFreeExponent_support]
    apply Finset.prod_eq_one
    intro row hrow
    simp only [squareFreeExponent_apply, hrow, ↓reduceIte, Nat.factorial_one]
  rw [hfactor, Nat.div_one]

theorem squareFreeExponent_prod_treeBlockVector {r : ℕ}
    (rows block : Finset (Fin r)) :
    (squareFreeExponent rows).prod
        (fun row n => treeBlockVector block row ^ n) =
      if rows ⊆ block then (1 : ℂ) else 0 := by
  classical
  by_cases hsubset : rows ⊆ block
  · simp only [if_pos hsubset, Finsupp.prod,
      squareFreeExponent_support]
    apply Finset.prod_eq_one
    intro row hrow
    simp only [treeBlockVector, hsubset hrow, ↓reduceIte, squareFreeExponent_apply, hrow, one_pow]
  · obtain ⟨row, hrow, hnot⟩ := Finset.not_subset.mp hsubset
    simp only [if_neg hsubset, Finsupp.prod,
      squareFreeExponent_support]
    apply Finset.prod_eq_zero hrow
    simp only [treeBlockVector, hnot, ↓reduceIte, squareFreeExponent_apply, hrow, pow_one]

theorem squareZeroCoefficient_squareZeroBlockSum_pow (r : ℕ)
    (rows block : Finset (Fin r)) (degree : ℕ) :
    squareZeroCoefficient r rows (squareZeroBlockSum r block ^ degree) =
      if rows ⊆ block ∧ rows.card = degree then
        (degree.factorial : ℂ)
      else 0 := by
  classical
  have hblock :
      Ideal.Quotient.mk (squareZeroIdeal r)
          (∑ row : Fin r,
            treeBlockVector block row •
              (MvPolynomial.X row : MvPolynomial (Fin r) ℂ)) =
        squareZeroBlockSum r block := by
    simp only [treeBlockVector, ite_smul, one_smul, zero_smul, Finset.sum_ite_mem, Finset.univ_inter, map_sum,
      squareZeroBlockSum, squareZeroVariable]
  rw [← hblock, ← map_pow, squareZeroCoefficient_mk,
    MvPolynomial.coeff_linearCombination_X_pow_of_fintype,
    squareFreeExponent_sum, squareFreeExponent_multinomial,
    squareFreeExponent_prod_treeBlockVector]
  by_cases hcard : rows.card = degree
  · by_cases hsubset : rows ⊆ block
    · rw [if_pos hcard, if_pos hsubset, if_pos ⟨hsubset, hcard⟩, mul_one, hcard]
    · rw [if_pos hcard, if_neg hsubset, if_neg fun h => hsubset h.1, mul_zero]
  · rw [if_neg hcard, if_neg fun h => hcard h.2]

theorem squareZero_fullBlockProduct {r : ℕ} {ι : Type*}
    (blocks : ι → Finset (Fin r))
    (indices : Finset ι) (t : ℕ)
    (hcard : ∀ i ∈ indices, (blocks i).card = t)
    (hdisjoint : Set.PairwiseDisjoint (↑indices) blocks) :
    (∏ i ∈ indices, squareZeroBlockSum r (blocks i) ^ t) =
      ((t.factorial ^ indices.card : ℕ) : SquareZeroAlgebra r) *
        ∏ row ∈ indices.biUnion blocks, squareZeroVariable r row := by
  classical
  calc
    (∏ i ∈ indices, squareZeroBlockSum r (blocks i) ^ t) =
        ∏ i ∈ indices,
          ((t.factorial : ℕ) : SquareZeroAlgebra r) *
            ∏ row ∈ blocks i, squareZeroVariable r row := by
              apply Finset.prod_congr rfl
              intro i hi
              rw [← hcard i hi, squareZeroBlockSum_pow_card]
    _ = ((t.factorial : ℕ) : SquareZeroAlgebra r) ^ indices.card *
          ∏ i ∈ indices,
            ∏ row ∈ blocks i, squareZeroVariable r row := by
              rw [Finset.prod_mul_distrib, Finset.prod_const]
    _ = ((t.factorial ^ indices.card : ℕ) : SquareZeroAlgebra r) *
          ∏ row ∈ indices.biUnion blocks, squareZeroVariable r row := by
              rw [Nat.cast_pow, Finset.prod_biUnion hdisjoint]

theorem squareZeroCoefficient_exceptionalBlockProduct
    {r : ℕ} {ι : Type*}
    (blocks : ι → Finset (Fin r)) (indices : Finset ι)
    (exceptional : ι) (t d : ℕ)
    (target : Finset (Fin r))
    (hcard : ∀ i ∈ indices, (blocks i).card = t)
    (hdisjoint : Set.PairwiseDisjoint (↑indices) blocks) :
    squareZeroCoefficient r target
      (squareZeroBlockSum r (blocks exceptional) ^ (t - d) *
        ∏ i ∈ indices, squareZeroBlockSum r (blocks i) ^ t) =
      if indices.biUnion blocks ⊆ target ∧
          target \ indices.biUnion blocks ⊆ blocks exceptional ∧
          (target \ indices.biUnion blocks).card = t - d then
        ((t.factorial ^ indices.card : ℕ) : ℂ) *
          (((t - d).factorial : ℕ) : ℂ)
      else 0 := by
  classical
  rw [squareZero_fullBlockProduct blocks indices t hcard hdisjoint]
  have hscalar :
      squareZeroBlockSum r (blocks exceptional) ^ (t - d) *
          (((t.factorial ^ indices.card : ℕ) : SquareZeroAlgebra r) *
            ∏ row ∈ indices.biUnion blocks, squareZeroVariable r row) =
        ((t.factorial ^ indices.card : ℕ) : ℂ) •
          ((∏ row ∈ indices.biUnion blocks, squareZeroVariable r row) *
            squareZeroBlockSum r (blocks exceptional) ^ (t - d)) := by
    rw [Nat.cast_smul_eq_nsmul, nsmul_eq_mul]
    ring
  rw [hscalar, map_smul,
    squareZeroCoefficient_variable_product_mul,
    squareZeroCoefficient_squareZeroBlockSum_pow]
  by_cases hunion : indices.biUnion blocks ⊆ target
  · by_cases hrest : target \ indices.biUnion blocks ⊆ blocks exceptional ∧
        (target \ indices.biUnion blocks).card = t - d
    · rw [if_pos hunion, if_pos hrest, if_pos ⟨hunion, hrest⟩, smul_eq_mul]
    · rw [if_pos hunion, if_neg hrest, if_neg fun h => hrest h.2, smul_zero]
  · rw [if_neg hunion, if_neg fun h => hunion h.1, smul_zero]

theorem sourceRowBlock_biUnion_erase (b t : ℕ) (h : Fin b) :
    ((Finset.univ : Finset (Fin b)).erase h).biUnion
        (sourceRowBlock b t) =
      (Finset.univ : Finset (Fin (b * t))) \ sourceRowBlock b t h := by
  classical
  ext row
  simp only [Finset.mem_biUnion, Finset.mem_erase, ne_eq, Finset.mem_univ, and_true, mem_sourceRowBlock,
    finProdFinEquiv_symm_apply, exists_eq_right', Finset.mem_sdiff, true_and]

theorem squareZeroCoefficient_sourceExceptionalBlock
    (b t d : ℕ) (omitted : Finset (Fin (b * t)))
    (homitted : omitted.card = d) (h : Fin b) :
    squareZeroCoefficient (b * t)
        ((Finset.univ : Finset (Fin (b * t))) \ omitted)
        (squareZeroBlockSum (b * t) (sourceRowBlock b t h) ^ (t - d) *
          ∏ j ∈ (Finset.univ : Finset (Fin b)).erase h,
            squareZeroBlockSum (b * t) (sourceRowBlock b t j) ^ t) =
      if omitted ⊆ sourceRowBlock b t h then
        ((t.factorial ^ (b - 1) : ℕ) : ℂ) *
          (((t - d).factorial : ℕ) : ℂ)
      else 0 := by
  classical
  have hdisjoint : Set.PairwiseDisjoint
      (↑((Finset.univ : Finset (Fin b)).erase h))
      (sourceRowBlock b t) := by
    intro left _ right _ hne
    exact sourceRowBlock_disjoint hne
  rw [squareZeroCoefficient_exceptionalBlockProduct
    (sourceRowBlock b t)
    ((Finset.univ : Finset (Fin b)).erase h)
    h t d ((Finset.univ : Finset (Fin (b * t))) \ omitted)
    (fun j _ => sourceRowBlock_card b t j) hdisjoint,
    sourceRowBlock_biUnion_erase]
  have hremaining :
      ((Finset.univ : Finset (Fin (b * t))) \ omitted) \
          ((Finset.univ : Finset (Fin (b * t))) \
            sourceRowBlock b t h) =
        sourceRowBlock b t h \ omitted := by
    ext row
    simp only [Finset.mem_sdiff, Finset.mem_univ, true_and, Decidable.not_not, and_comm]
  rw [hremaining]
  have hsubset_equiv :
      (Finset.univ \ sourceRowBlock b t h) ⊆
          (Finset.univ \ omitted) ↔
        omitted ⊆ sourceRowBlock b t h :=
    Finset.sdiff_subset_sdiff_iff_subset
      (Finset.subset_univ (sourceRowBlock b t h))
      (Finset.subset_univ omitted)
  by_cases hsubset : omitted ⊆ sourceRowBlock b t h
  · have hfirst := hsubset_equiv.mpr hsubset
    have hcard :
        (sourceRowBlock b t h \ omitted).card = t - d := by
      rw [Finset.card_sdiff_of_subset hsubset,
        sourceRowBlock_card, homitted]
    simp only [hfirst, sdiff_le_iff, hsubset, sup_of_le_right, Std.le_refl, hcard, and_self, ↓reduceIte,
      Finset.mem_univ, Finset.card_erase_of_mem, Finset.card_univ, Fintype.card_fin, Nat.cast_pow]
  · have hfirst :
        ¬(Finset.univ \ sourceRowBlock b t h) ⊆
          (Finset.univ \ omitted) :=
        fun hfirst => hsubset (hsubset_equiv.mp hfirst)
    simp only [hfirst, sdiff_le_iff, Finset.sup_eq_union', Finset.subset_union_right, true_and, false_and,
      ↓reduceIte, hsubset]

theorem squareZeroCoefficient_sourceTree_expansion
    (b t d : ℕ) (hdpos : 0 < d) (hd : d ≤ t)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ d)
    (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ)
    (omitted : Finset (Fin (b * t)))
    (homitted : omitted.card = d) :
    squareZeroCoefficient (b * t)
        ((Finset.univ : Finset (Fin (b * t))) \ omitted)
        (subtreeLinearFormProduct
          (fun h => squareZeroBlockSum (b * t) (sourceRowBlock b t h))
          t d ζ tree) =
      ∑ h : Fin b,
        subtreeCoefficient
            (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) tree h *
          if omitted ⊆ sourceRowBlock b t h then
            ((t.factorial ^ (b - 1) : ℕ) : ℂ) *
              (((t - d).factorial : ℕ) : ℂ)
          else 0 := by
  classical
  rw [squareZero_subtreeLinearFormProduct_eq_expansion
    (b * t) (sourceRowBlock b t) tree t d hdpos hd hζ hnodup
    (fun h _ => sourceRowBlock_card b t h), hleaves, map_sum]
  apply Finset.sum_congr rfl
  intro h _
  rw [← Algebra.smul_def, map_smul,
    squareZeroCoefficient_sourceExceptionalBlock
    b t d omitted homitted h]
  rfl

theorem sourceRowBlock_exceptional_unique
    {b t : ℕ} (omitted : Finset (Fin (b * t)))
    (hnonempty : omitted.Nonempty) {left right : Fin b}
    (hleft : omitted ⊆ sourceRowBlock b t left)
    (hright : omitted ⊆ sourceRowBlock b t right) :
    left = right := by
  by_contra hne
  obtain ⟨row, hrow⟩ := hnonempty
  exact (Finset.disjoint_left.mp (sourceRowBlock_disjoint hne))
    (hleft hrow) (hright hrow)

theorem squareZeroCoefficient_sourceTree_eq_zero
    (b t d : ℕ) (hdpos : 0 < d) (hd : d ≤ t)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ d)
    (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ)
    (omitted : Finset (Fin (b * t)))
    (homitted : omitted.card = d)
    (hnot : ∀ h : Fin b, ¬omitted ⊆ sourceRowBlock b t h) :
    squareZeroCoefficient (b * t)
        ((Finset.univ : Finset (Fin (b * t))) \ omitted)
        (subtreeLinearFormProduct
          (fun h => squareZeroBlockSum (b * t) (sourceRowBlock b t h))
          t d ζ tree) = 0 := by
  rw [squareZeroCoefficient_sourceTree_expansion
    b t d hdpos hd hζ tree hnodup hleaves omitted homitted]
  apply Finset.sum_eq_zero
  intro h _
  simp only [hnot h, ↓reduceIte, mul_zero]

theorem squareZeroCoefficient_sourceTree_eq_factorial
    (b t d : ℕ) (hdpos : 0 < d) (hd : d ≤ t)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ d)
    (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ)
    (omitted : Finset (Fin (b * t)))
    (homitted : omitted.card = d) (h : Fin b)
    (hsubset : omitted ⊆ sourceRowBlock b t h) :
    squareZeroCoefficient (b * t)
        ((Finset.univ : Finset (Fin (b * t))) \ omitted)
        (subtreeLinearFormProduct
          (fun j => squareZeroBlockSum (b * t) (sourceRowBlock b t j))
          t d ζ tree) =
      subtreeCoefficient
          (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) tree h *
        (((t - d).factorial : ℕ) : ℂ) *
        (((t.factorial : ℕ) : ℂ) ^ (b - 1)) := by
  classical
  have hnonempty : omitted.Nonempty := by
    rw [← Finset.card_pos]
    omega
  rw [squareZeroCoefficient_sourceTree_expansion
    b t d hdpos hd hζ tree hnodup hleaves omitted homitted,
    Finset.sum_eq_single h]
  · simp only [hsubset, ↓reduceIte, Nat.cast_pow]
    ring
  · intro j _ hj
    have hother : ¬omitted ⊆ sourceRowBlock b t j := by
      intro hother
      exact hj (sourceRowBlock_exceptional_unique omitted
        hnonempty hother hsubset)
    simp only [hother, ↓reduceIte, mul_zero]
  · simp only [Finset.mem_univ, not_true_eq_false, Nat.cast_pow, mul_ite, mul_zero, ite_eq_right_iff, mul_eq_zero,
      pow_eq_zero_iff', Nat.cast_eq_zero, ne_eq, IsEmpty.forall_iff]

theorem sourceTree_leafList_length (b : ℕ)
    (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ) :
    tree.leafList.length = b := by
  classical
  have hset : tree.leafList.toFinset = tree.leaves := by
    ext i
    simp only [List.mem_toFinset, BlockTree.mem_leaves_iff]
  calc
    tree.leafList.length = tree.leafList.toFinset.card :=
      (List.toFinset_card_of_nodup hnodup).symm
    _ = tree.leaves.card := congrArg Finset.card hset
    _ = b := by simp only [hleaves, Finset.card_univ, Fintype.card_fin]

theorem sourceTreeLinearFormVectors_length
    (b t d : ℕ) (hd : d ≤ t) (ζ : ℂ)
    (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ) :
    (treeLinearFormVectors (sourceRowBlock b t) t d ζ tree).length =
      b * t - d := by
  rw [treeLinearFormVectors_length (sourceRowBlock b t)
    t d hd ζ tree, sourceTree_leafList_length b tree hnodup hleaves]

noncomputable def sourceTreeMatrix (b t d : ℕ) (hd : d ≤ t)
    (ζ : ℂ) (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ) :
    Matrix (Fin (b * t)) (Fin (b * t - d)) ℂ :=
  fun row column =>
    treeLinearFormMatrix (sourceRowBlock b t) t d ζ tree row
      ((finCongr
        (sourceTreeLinearFormVectors_length
          b t d hd ζ tree hnodup hleaves).symm) column)

theorem sourceTreeMatrix_columnLinearFormProduct
    (b t d : ℕ) (hd : d ≤ t) (ζ : ℂ)
    (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ) :
    columnLinearFormProduct
        (sourceTreeMatrix b t d hd ζ tree hnodup hleaves) =
      columnLinearFormProduct
        (treeLinearFormMatrix (sourceRowBlock b t) t d ζ tree) := by
  classical
  unfold columnLinearFormProduct
  refine Fintype.prod_equiv
    (finCongr
      (sourceTreeLinearFormVectors_length
        b t d hd ζ tree hnodup hleaves).symm)
    (fun column =>
      columnLinearForm
        (sourceTreeMatrix b t d hd ζ tree hnodup hleaves) column)
    (fun column =>
      columnLinearForm
        (treeLinearFormMatrix (sourceRowBlock b t) t d ζ tree) column)
    ?_
  intro column
  rfl

theorem sourceTreeMatrix_quotient_prod
    (b t d : ℕ) (hd : d ≤ t) (ζ : ℂ)
    (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ) :
    Ideal.Quotient.mk (squareZeroIdeal (b * t))
        (columnLinearFormProduct
          (sourceTreeMatrix b t d hd ζ tree hnodup hleaves)) =
      subtreeLinearFormProduct
        (fun h => squareZeroBlockSum (b * t) (sourceRowBlock b t h))
        t d ζ tree := by
  rw [sourceTreeMatrix_columnLinearFormProduct
    b t d hd ζ tree hnodup hleaves,
    treeLinearFormMatrix_quotient_prod]

theorem sourceBlockAlpha_eq_permanent {r d : ℕ}
    (U : Matrix (Fin r) (Fin (r - d)) ℂ)
    (omitted : Finset (Fin r))
    (rowEquiv : Fin (r - d) ≃ {row : Fin r // row ∉ omitted}) :
    sourceBlockAlpha r d U omitted =
      Matrix.permanent
        (fun i j => U (rowEquiv i).val j) := by
  classical
  let matchingEquiv :
      ({row : Fin r // row ∉ omitted} ≃ Fin (r - d)) ≃
        Equiv.Perm (Fin (r - d)) :=
    { toFun := fun matching => matching.symm.trans rowEquiv.symm
      invFun := fun matching => rowEquiv.symm.trans matching.symm
      left_inv := by
        intro matching
        ext row
        simp only [Equiv.symm_trans, Equiv.symm_symm, Equiv.trans_apply, Equiv.apply_symm_apply]
      right_inv := by
        intro matching
        ext column
        simp only [Equiv.symm_trans, Equiv.symm_symm, Equiv.trans_apply, Equiv.symm_apply_apply] }
  unfold sourceBlockAlpha Matrix.permanent
  refine Fintype.sum_equiv matchingEquiv _ _ ?_
  intro matching
  refine Fintype.prod_equiv matching _ _ ?_
  intro row
  simp only [Equiv.coe_fn_mk, Equiv.trans_apply, Equiv.symm_apply_apply, Equiv.apply_symm_apply, matchingEquiv]

noncomputable def sourceComplementRowEquiv
    (r d : ℕ) (omitted : Finset (Fin r))
    (homitted : omitted.card = d) :
    Fin (r - d) ≃ {row : Fin r // row ∉ omitted} :=
  Fintype.equivOfCardEq (by
    classical
    rw [Fintype.card_fin,
      Fintype.card_subtype_compl
        (fun row : Fin r => row ∈ omitted),
      Fintype.card_fin, Fintype.card_coe, homitted])

noncomputable def sourceComplementSquareFreeRowEquiv
    (r d : ℕ) (omitted : Finset (Fin r))
    (homitted : omitted.card = d) :
    Fin (r - d) ≃
      {row : Fin r // row ∈ (Finset.univ : Finset (Fin r)) \ omitted} :=
  (sourceComplementRowEquiv r d omitted homitted).trans
    (Equiv.subtypeEquivRight (fun row => by simp only [Finset.mem_sdiff, Finset.mem_univ, true_and]))

theorem sourceBlockAlpha_eq_squareZeroCoefficient
    {r d : ℕ} (U : Matrix (Fin r) (Fin (r - d)) ℂ)
    (omitted : Finset (Fin r))
    (homitted : omitted.card = d) :
    sourceBlockAlpha r d U omitted =
      squareZeroCoefficient r
        ((Finset.univ : Finset (Fin r)) \ omitted)
        (Ideal.Quotient.mk (squareZeroIdeal r)
          (columnLinearFormProduct U)) := by
  symm
  rw [squareZeroCoefficient_mk,
    coeff_columnLinearFormProduct_eq_permanent U
      ((Finset.univ : Finset (Fin r)) \ omitted)
      (sourceComplementSquareFreeRowEquiv r d omitted homitted),
    sourceBlockAlpha_eq_permanent U omitted
      (sourceComplementRowEquiv r d omitted homitted)]
  rfl

theorem sourceTreeMatrix_alpha_eq_coefficient
    (b t d : ℕ) (hd : d ≤ t) (ζ : ℂ)
    (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ)
    (omitted : Finset (Fin (b * t)))
    (homitted : omitted.card = d) :
    sourceBlockAlpha (b * t) d
        (sourceTreeMatrix b t d hd ζ tree hnodup hleaves)
        omitted =
      squareZeroCoefficient (b * t)
        ((Finset.univ : Finset (Fin (b * t))) \ omitted)
        (subtreeLinearFormProduct
          (fun h => squareZeroBlockSum (b * t) (sourceRowBlock b t h))
          t d ζ tree) := by
  rw [sourceBlockAlpha_eq_squareZeroCoefficient
    (sourceTreeMatrix b t d hd ζ tree hnodup hleaves)
    omitted homitted,
    sourceTreeMatrix_quotient_prod]

theorem sourceTreeMatrix_alpha_eq_zero
    (b t d : ℕ) (hdpos : 0 < d) (hd : d ≤ t)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ d)
    (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ)
    (omitted : Finset (Fin (b * t)))
    (homitted : omitted.card = d)
    (hnot : ∀ h : Fin b, ¬omitted ⊆ sourceRowBlock b t h) :
    sourceBlockAlpha (b * t) d
        (sourceTreeMatrix b t d hd ζ tree hnodup hleaves)
        omitted = 0 := by
  rw [sourceTreeMatrix_alpha_eq_coefficient
    b t d hd ζ tree hnodup hleaves omitted homitted,
    squareZeroCoefficient_sourceTree_eq_zero
      b t d hdpos hd hζ tree hnodup hleaves omitted homitted hnot]

theorem sourceTreeMatrix_alpha_eq_factorial
    (b t d : ℕ) (hdpos : 0 < d) (hd : d ≤ t)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ d)
    (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ)
    (omitted : Finset (Fin (b * t)))
    (homitted : omitted.card = d) (h : Fin b)
    (hsubset : omitted ⊆ sourceRowBlock b t h) :
    sourceBlockAlpha (b * t) d
        (sourceTreeMatrix b t d hd ζ tree hnodup hleaves)
        omitted =
      subtreeCoefficient
          (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) tree h *
        (((t - d).factorial : ℕ) : ℂ) *
        (((t.factorial : ℕ) : ℂ) ^ (b - 1)) := by
  rw [sourceTreeMatrix_alpha_eq_coefficient
    b t d hd ζ tree hnodup hleaves omitted homitted,
    squareZeroCoefficient_sourceTree_eq_factorial
      b t d hdpos hd hζ tree hnodup hleaves
      omitted homitted h hsubset]

theorem sourceBlockAlpha_algebraMap
    {R : Type*} [CommSemiring R] [Algebra ℂ R]
    {r d : ℕ} (U : Matrix (Fin r) (Fin (r - d)) ℂ)
    (omitted : Finset (Fin r)) :
    sourceBlockAlpha r d
        (fun row column => algebraMap ℂ R (U row column)) omitted =
      algebraMap ℂ R (sourceBlockAlpha r d U omitted) := by
  classical
  simp only [sourceBlockAlpha, map_sum, map_prod]

noncomputable def sourceRowBlockMinorSum
    {R : Type*} [CommSemiring R] (b t s d : ℕ)
    (X : Matrix (Fin (b * t)) (Fin s) R) (h : Fin b) : R :=
  ∑ omitted ∈ (sourceRowBlock b t h).powersetCard d,
    ∑ columns ∈ (Finset.univ : Finset (Fin s)).powersetCard d,
      sourceBlockMinor (b * t) s X omitted columns

theorem sourceRowBlock_powersetCard_eq_filter
    (b t d : ℕ) (h : Fin b) :
    (sourceRowBlock b t h).powersetCard d =
      ((Finset.univ : Finset (Fin (b * t))).powersetCard d).filter
        (fun omitted => omitted ⊆ sourceRowBlock b t h) := by
  classical
  ext omitted
  simp only [Finset.mem_powersetCard, and_comm, Finset.mem_filter, Finset.subset_univ, true_and]

theorem sourceTreeMatrix_alpha_eq_block_sum
    (b t d : ℕ) (hdpos : 0 < d) (hd : d ≤ t)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ d)
    (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ)
    (omitted : Finset (Fin (b * t)))
    (homitted : omitted.card = d) :
    sourceBlockAlpha (b * t) d
        (sourceTreeMatrix b t d hd ζ tree hnodup hleaves) omitted =
      (((t - d).factorial : ℕ) : ℂ) *
        (((t.factorial : ℕ) : ℂ) ^ (b - 1)) *
        ∑ h : Fin b,
          if omitted ⊆ sourceRowBlock b t h then
            subtreeCoefficient
              (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) tree h
          else 0 := by
  classical
  by_cases hblock : ∃ h : Fin b, omitted ⊆ sourceRowBlock b t h
  · obtain ⟨h, hh⟩ := hblock
    have hnonempty : omitted.Nonempty :=
      Finset.card_pos.mp (homitted.symm ▸ hdpos)
    have hunique : ∀ h' : Fin b,
        (omitted ⊆ sourceRowBlock b t h') ↔ h' = h := by
      intro h'
      constructor
      · intro hh'
        exact sourceRowBlock_exceptional_unique omitted hnonempty hh' hh
      · rintro rfl
        exact hh
    rw [sourceTreeMatrix_alpha_eq_factorial
      b t d hdpos hd hζ tree hnodup hleaves omitted homitted h hh]
    simp_rw [hunique]
    simp only [mul_comm, mul_left_comm, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte, mul_assoc]
  · have hnone : ∀ h : Fin b, ¬ omitted ⊆ sourceRowBlock b t h := by
      simpa only [not_exists] using hblock
    rw [sourceTreeMatrix_alpha_eq_zero
      b t d hdpos hd hζ tree hnodup hleaves omitted homitted hnone]
    simp only [hnone, ↓reduceIte, Finset.sum_const_zero, mul_zero]

theorem sourceRowBlock_weighted_minor_sum
    {R : Type*} [CommSemiring R]
    (b t s d : ℕ) (X : Matrix (Fin (b * t)) (Fin s) R)
    (weight : Fin b → R) :
    (∑ omitted ∈ (Finset.univ : Finset (Fin (b * t))).powersetCard d,
      (∑ h : Fin b,
        if omitted ⊆ sourceRowBlock b t h then weight h else 0) *
        ∑ columns ∈ (Finset.univ : Finset (Fin s)).powersetCard d,
          sourceBlockMinor (b * t) s X omitted columns) =
      ∑ h : Fin b, weight h * sourceRowBlockMinorSum b t s d X h := by
  classical
  simp_rw [Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro h _
  unfold sourceRowBlockMinorSum
  rw [sourceRowBlock_powersetCard_eq_filter b t d h]
  simp only [Finset.mul_sum, ite_mul, zero_mul, Finset.sum_ite_irrel, Finset.sum_const_zero, Finset.sum_filter,
    mul_ite, mul_zero]

theorem sourceTreeBlockMatrix_permanent_eq_separated
    {R : Type*} [CommSemiring R] [Algebra ℂ R]
    (b t s d : ℕ) (hdpos : 0 < d) (hd : d ≤ t)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ d)
    (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ)
    (X : Matrix (Fin (b * t)) (Fin s) R) :
    rectangularPermanent
        (sourceBlockMatrix (b * t) s d X
          (fun row column =>
            algebraMap ℂ R
              (sourceTreeMatrix b t d hd ζ tree hnodup hleaves row column))) =
      (((s - d).factorial : ℕ) : R) *
        algebraMap ℂ R (((t - d).factorial : ℕ) : ℂ) *
        algebraMap ℂ R ((((t.factorial : ℕ) : ℂ) ^ (b - 1))) *
        ∑ h : Fin b,
          algebraMap ℂ R
              (subtreeCoefficient
                (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) tree h) *
            sourceRowBlockMinorSum b t s d X h := by
  classical
  have hb : 0 < b := by
    have hleaf : tree.leafList.length > 0 := tree_leafList_length_pos tree
    rw [sourceTree_leafList_length b tree hnodup hleaves] at hleaf
    exact hleaf
  have hrows : d ≤ b * t := by
    calc
      d ≤ t := hd
      _ ≤ b * t := Nat.le_mul_of_pos_left t hb
  rw [sourceBlockMatrix_permanent_eq_matchingExpansion
    (b * t) s d hrows X
    (fun row column =>
      algebraMap ℂ R
        (sourceTreeMatrix b t d hd ζ tree hnodup hleaves row column))]
  unfold sourceBlockMatchingExpansion
  let common : R :=
    algebraMap ℂ R (((t - d).factorial : ℕ) : ℂ) *
      algebraMap ℂ R ((((t.factorial : ℕ) : ℂ) ^ (b - 1)))
  let weight : Fin b → R := fun h =>
    algebraMap ℂ R
      (subtreeCoefficient
        (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) tree h)
  have hcoefficient (omitted : Finset (Fin (b * t)))
      (homitted : omitted.card = d) :
      sourceBlockAlpha (b * t) d
          (fun row column =>
            algebraMap ℂ R
              (sourceTreeMatrix b t d hd ζ tree hnodup hleaves
                row column)) omitted =
        common * ∑ h : Fin b,
          if omitted ⊆ sourceRowBlock b t h then weight h else 0 := by
    rw [sourceBlockAlpha_algebraMap,
      sourceTreeMatrix_alpha_eq_block_sum
        b t d hdpos hd hζ tree hnodup hleaves omitted homitted]
    simp only [map_mul, map_sum]
    change common *
      (∑ h : Fin b,
        algebraMap ℂ R
          (if omitted ⊆ sourceRowBlock b t h then
            subtreeCoefficient
              (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) tree h
          else 0)) =
      common *
        ∑ h : Fin b,
          if omitted ⊆ sourceRowBlock b t h then weight h else 0
    congr 1
    apply Finset.sum_congr rfl
    intro h _
    split <;> simp [weight]
  have hsum :
      (∑ omitted ∈ (Finset.univ : Finset (Fin (b * t))).powersetCard d,
        ∑ columns ∈ (Finset.univ : Finset (Fin s)).powersetCard d,
          sourceBlockAlpha (b * t) d
              (fun row column =>
                algebraMap ℂ R
                  (sourceTreeMatrix b t d hd ζ tree hnodup hleaves
                    row column)) omitted *
            sourceBlockMinor (b * t) s X omitted columns) =
        common *
          ∑ h : Fin b, weight h * sourceRowBlockMinorSum b t s d X h := by
    calc
      _ = common *
          (∑ omitted ∈
            (Finset.univ : Finset (Fin (b * t))).powersetCard d,
            (∑ h : Fin b,
              if omitted ⊆ sourceRowBlock b t h then weight h else 0) *
              ∑ columns ∈ (Finset.univ : Finset (Fin s)).powersetCard d,
                sourceBlockMinor (b * t) s X omitted columns) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro omitted homitted
            rw [hcoefficient omitted
              (Finset.mem_powersetCard.mp homitted).2]
            simp only [← Finset.mul_sum, mul_assoc]
      _ = _ := by
        rw [sourceRowBlock_weighted_minor_sum b t s d X weight]
  rw [hsum]
  dsimp [common, weight]
  ring

noncomputable def sourceRowBlockEmbedding
    (b t : ℕ) (h : Fin b) : Fin t ↪ Fin (b * t) where
  toFun row :=
    (finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t)) (h, row)
  inj' := by
    intro left right heq
    exact congrArg Prod.snd
      ((finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t)).injective heq)

theorem sourceRowBlock_eq_map
    (b t : ℕ) (h : Fin b) :
    sourceRowBlock b t h =
      (Finset.univ : Finset (Fin t)).map
        (sourceRowBlockEmbedding b t h) := by
  classical
  ext row
  change
    row ∈ (Finset.univ : Finset (Fin t)).image
      (fun localRow =>
        (finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t))
          (h, localRow)) ↔
      row ∈ (Finset.univ : Finset (Fin t)).map
        (sourceRowBlockEmbedding b t h)
  constructor
  · intro hrow
    obtain ⟨localRow, _, rfl⟩ := Finset.mem_image.mp hrow
    exact Finset.mem_map.mpr
      ⟨localRow, Finset.mem_univ _, rfl⟩
  · intro hrow
    obtain ⟨localRow, _, rfl⟩ := Finset.mem_map.mp hrow
    exact Finset.mem_image.mpr
      ⟨localRow, Finset.mem_univ _, rfl⟩

theorem sourceBlockMinor_sourceRowBlockEmbedding
    {R : Type*} [CommSemiring R]
    (b t s : ℕ) (h : Fin b)
    (X : Matrix (Fin (b * t)) (Fin s) R)
    (rows : Finset (Fin t)) (columns : Finset (Fin s)) :
    sourceBlockMinor (b * t) s X
        (rows.map (sourceRowBlockEmbedding b t h)) columns =
      sourceBlockMinor t s
        (fun row column => X (sourceRowBlockEmbedding b t h row) column)
        rows columns := by
  classical
  let rowEquiv : rows ≃ rows.map (sourceRowBlockEmbedding b t h) :=
    Finset.equivMap (sourceRowBlockEmbedding b t h) rows
  let matchingEquiv :
      (rows.map (sourceRowBlockEmbedding b t h) ≃ columns) ≃
        (rows ≃ columns) :=
    { toFun := fun matching => rowEquiv.trans matching
      invFun := fun matching => rowEquiv.symm.trans matching
      left_inv := by
        intro matching
        ext row
        simp only [Equiv.trans_apply, Equiv.apply_symm_apply]
      right_inv := by
        intro matching
        ext row
        simp only [Equiv.trans_apply, Equiv.symm_apply_apply] }
  unfold sourceBlockMinor
  refine Fintype.sum_equiv matchingEquiv _ _ ?_
  intro matching
  symm
  refine Fintype.prod_equiv rowEquiv _ _ ?_
  intro row
  simp only [Finset.equivMap, Equiv.coe_fn_mk, Equiv.trans_apply, Equiv.ofBijective_apply, matchingEquiv,
    rowEquiv]

theorem sourceRowBlockMinorSum_eq_local_minors
    {R : Type*} [CommSemiring R]
    (b t s d : ℕ) (h : Fin b)
    (X : Matrix (Fin (b * t)) (Fin s) R) :
    sourceRowBlockMinorSum b t s d X h =
      ∑ rows ∈ (Finset.univ : Finset (Fin t)).powersetCard d,
        ∑ columns ∈ (Finset.univ : Finset (Fin s)).powersetCard d,
          sourceBlockMinor t s
            (fun row column => X (sourceRowBlockEmbedding b t h row) column)
            rows columns := by
  classical
  unfold sourceRowBlockMinorSum
  rw [sourceRowBlock_eq_map,
    Finset.powersetCard_map]
  simp only [Finset.sum_map]
  apply Finset.sum_congr rfl
  intro rows _
  apply Finset.sum_congr rfl
  intro columns _
  exact sourceBlockMinor_sourceRowBlockEmbedding b t s h X rows columns

noncomputable def sourceRowBlockVariableEmbedding
    (b t s : ℕ) (h : Fin b) :
    (Fin t × Fin s) ↪ (Fin (b * t) × Fin s) where
  toFun entry :=
    (sourceRowBlockEmbedding b t h entry.1, entry.2)
  inj' := by
    intro left right heq
    have hfirst :
        sourceRowBlockEmbedding b t h left.1 =
          sourceRowBlockEmbedding b t h right.1 :=
      congrArg (fun entry : Fin (b * t) × Fin s => entry.1) heq
    have hsecond : left.2 = right.2 :=
      congrArg (fun entry : Fin (b * t) × Fin s => entry.2) heq
    exact Prod.ext
      ((sourceRowBlockEmbedding b t h).injective hfirst) hsecond

theorem sourceRowBlockMinorSum_eq_rename_minorSum
    (b t s d : ℕ) (h : Fin b) :
    sourceRowBlockMinorSum b t s d
        (fun row column =>
          (MvPolynomial.X (row, column) :
            MvPolynomial (Fin (b * t) × Fin s) ℂ)) h =
      MvPolynomial.rename
        (sourceRowBlockVariableEmbedding b t s h)
        (minorSum t s d) := by
  classical
  rw [sourceRowBlockMinorSum_eq_local_minors b t s d h
    (fun row column =>
      (MvPolynomial.X (row, column) :
        MvPolynomial (Fin (b * t) × Fin s) ℂ))]
  unfold minorSum sourceBlockMinor
  simp only [map_sum, map_prod, MvPolynomial.rename_X]
  rfl

theorem sourceRowBlockVariableEmbedding_disjoint
    (b t s : ℕ) {left right : Fin b} (hne : left ≠ right) :
    Disjoint
      (Set.range (sourceRowBlockVariableEmbedding b t s left))
      (Set.range (sourceRowBlockVariableEmbedding b t s right)) := by
  classical
  rw [Set.disjoint_left]
  rintro entry ⟨leftVariable, hleft⟩ ⟨rightVariable, hright⟩
  have hrows :
      sourceRowBlockEmbedding b t left leftVariable.1 =
        sourceRowBlockEmbedding b t right rightVariable.1 :=
    congrArg Prod.fst (hleft.trans hright.symm)
  have hleftmem :
      sourceRowBlockEmbedding b t left leftVariable.1 ∈
        sourceRowBlock b t left := by
    rw [sourceRowBlock_eq_map]
    exact Finset.mem_map.mpr
      ⟨leftVariable.1, Finset.mem_univ _, rfl⟩
  have hrightmem :
      sourceRowBlockEmbedding b t left leftVariable.1 ∈
        sourceRowBlock b t right := by
    rw [hrows, sourceRowBlock_eq_map]
    exact Finset.mem_map.mpr
      ⟨rightVariable.1, Finset.mem_univ _, rfl⟩
  exact (Finset.disjoint_left.mp (sourceRowBlock_disjoint hne))
    hleftmem hrightmem

theorem sourceTreeBlockMatrix_permanent_eq_separated_minorSum
    (b t s d : ℕ) (hdpos : 0 < d) (hd : d ≤ t)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ d)
    (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ) :
    rectangularPermanent
        (sourceBlockMatrix (b * t) s d
          (fun row column =>
            (MvPolynomial.X (row, column) :
              MvPolynomial (Fin (b * t) × Fin s) ℂ))
          (fun row column =>
            algebraMap ℂ (MvPolynomial (Fin (b * t) × Fin s) ℂ)
              (sourceTreeMatrix b t d hd ζ tree hnodup hleaves row column))) =
      (((s - d).factorial : ℕ) :
          MvPolynomial (Fin (b * t) × Fin s) ℂ) *
        algebraMap ℂ (MvPolynomial (Fin (b * t) × Fin s) ℂ)
          (((t - d).factorial : ℕ) : ℂ) *
        algebraMap ℂ (MvPolynomial (Fin (b * t) × Fin s) ℂ)
          ((((t.factorial : ℕ) : ℂ) ^ (b - 1))) *
        ∑ h : Fin b,
          algebraMap ℂ (MvPolynomial (Fin (b * t) × Fin s) ℂ)
              (subtreeCoefficient
                (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) tree h) *
            MvPolynomial.rename
              (sourceRowBlockVariableEmbedding b t s h)
              (minorSum t s d) := by
  simpa only [sourceRowBlockMinorSum_eq_rename_minorSum] using
    (sourceTreeBlockMatrix_permanent_eq_separated
      (R := MvPolynomial (Fin (b * t) × Fin s) ℂ)
      b t s d hdpos hd hζ tree hnodup hleaves
      (fun row column =>
        (MvPolynomial.X (row, column) :
          MvPolynomial (Fin (b * t) × Fin s) ℂ)))

end Standalone_TreeCoefficients

section Standalone_SourcePermanentSpecialization

open scoped BigOperators

noncomputable section

theorem permanent_aeval_eq_matrix_permanent
    {n : ℕ} {ι : Type*}
    (A : Matrix (Fin n) (Fin n) (MvPolynomial ι ℂ)) :
    MvPolynomial.aeval (fun ij : Fin n × Fin n => A ij.1 ij.2)
      (permanent n) = Matrix.permanent A := by
  classical
  simp only [permanent, Matrix.permanent, map_sum, map_prod,
    MvPolynomial.aeval_X]

theorem matrixPermanent_eq_rectangularPermanent_reindex
    {n : ℕ} {α β R : Type*}
    [Fintype α] [Fintype β] [CommSemiring R]
    (row : Fin n ≃ α) (column : Fin n ≃ β)
    (A : Matrix α β R) :
    Matrix.permanent (fun i j : Fin n => A (row i) (column j)) =
      rectangularPermanent A := by
  classical
  unfold Matrix.permanent rectangularPermanent
  let matchingEquiv : Equiv.Perm (Fin n) ≃ (α ≃ β) :=
    { toFun := fun σ => row.symm.trans (σ.symm.trans column)
      invFun := fun matching =>
        (row.trans (matching.trans column.symm)).symm
      left_inv := by
        intro σ
        ext i
        simp only [Equiv.symm_trans, Equiv.symm_symm, Equiv.trans_apply, Equiv.symm_apply_apply]
      right_inv := by
        intro matching
        ext i
        simp only [Equiv.symm_trans, Equiv.symm_symm, Equiv.trans_apply, Equiv.apply_symm_apply] }
  refine Fintype.sum_equiv matchingEquiv _ _ ?_
  intro σ
  refine Fintype.prod_equiv (σ.trans row) _ _ ?_
  intro i
  simp only [Equiv.trans_apply, Equiv.symm_trans, Equiv.symm_symm, Equiv.coe_fn_mk, Equiv.symm_apply_apply,
    matchingEquiv]

def sourceBlockAffineInput
    {r s d : ℕ}
    (U : Matrix (Fin r) (Fin (r - d)) ℂ) :
    (Fin r ⊕ Fin (s - d)) →
      (Fin s ⊕ Fin (r - d)) → FreeAffineInput (Fin (r * s))
  | .inl row, .inl column =>
      ⟨0, Finsupp.single
        ((finProdFinEquiv : Fin r × Fin s ≃ Fin (r * s))
          (row, column)) 1⟩
  | .inl row, .inr column => ⟨U row column, 0⟩
  | .inr _, .inl _ => ⟨1, 0⟩
  | .inr _, .inr _ => ⟨0, 0⟩

theorem sourceBlockAffineInput_polynomial
    {r s d : ℕ}
    (U : Matrix (Fin r) (Fin (r - d)) ℂ)
    (row : Fin r ⊕ Fin (s - d))
    (column : Fin s ⊕ Fin (r - d)) :
    (sourceBlockAffineInput U row column).polynomial =
      sourceBlockMatrix r s d
        (fun i j =>
          MvPolynomial.X
            ((finProdFinEquiv : Fin r × Fin s ≃ Fin (r * s))
              (i, j)))
        (fun i j =>
          algebraMap ℂ (MvPolynomial (Fin (r * s)) ℂ) (U i j))
        row column := by
  cases row <;> cases column <;>
    simp [sourceBlockAffineInput, FreeAffineInput.polynomial,
      sourceBlockMatrix, Matrix.fromBlocks]

theorem sourceBlock_affine_permanent_specialization
    {n r s d : ℕ}
    (rowEquiv : Fin n ≃ Fin r ⊕ Fin (s - d))
    (columnEquiv : Fin n ≃ Fin s ⊕ Fin (r - d))
    (U : Matrix (Fin r) (Fin (r - d)) ℂ) :
    MvPolynomial.aeval
        (fun ij : Fin n × Fin n =>
          (sourceBlockAffineInput U
            (rowEquiv ij.1) (columnEquiv ij.2)).polynomial)
        (permanent n) =
      rectangularPermanent
        (sourceBlockMatrix r s d
          (fun i j =>
            MvPolynomial.X
              ((finProdFinEquiv : Fin r × Fin s ≃ Fin (r * s))
                (i, j)))
          (fun i j =>
            algebraMap ℂ (MvPolynomial (Fin (r * s)) ℂ)
              (U i j))) := by
  let B : Matrix (Fin r ⊕ Fin (s - d))
      (Fin s ⊕ Fin (r - d))
      (MvPolynomial (Fin (r * s)) ℂ) :=
    sourceBlockMatrix r s d
      (fun i j =>
        MvPolynomial.X
          ((finProdFinEquiv : Fin r × Fin s ≃ Fin (r * s))
            (i, j)))
      (fun i j =>
        algebraMap ℂ (MvPolynomial (Fin (r * s)) ℂ) (U i j))
  have hentry (i j : Fin n) :
      (sourceBlockAffineInput U (rowEquiv i) (columnEquiv j)).polynomial =
        B (rowEquiv i) (columnEquiv j) :=
    sourceBlockAffineInput_polynomial U (rowEquiv i) (columnEquiv j)
  calc
    MvPolynomial.aeval
        (fun ij : Fin n × Fin n =>
          (sourceBlockAffineInput U
            (rowEquiv ij.1) (columnEquiv ij.2)).polynomial)
        (permanent n) =
      Matrix.permanent
        (fun i j => B (rowEquiv i) (columnEquiv j)) := by
          rw [show
            (fun ij : Fin n × Fin n =>
              (sourceBlockAffineInput U
                (rowEquiv ij.1) (columnEquiv ij.2)).polynomial) =
              (fun ij : Fin n × Fin n =>
                B (rowEquiv ij.1) (columnEquiv ij.2)) by
                  funext ij
                  exact hentry ij.1 ij.2]
          exact permanent_aeval_eq_matrix_permanent
            (fun i j => B (rowEquiv i) (columnEquiv j))
    _ = rectangularPermanent B :=
      matrixPermanent_eq_rectangularPermanent_reindex
        rowEquiv columnEquiv B

theorem sourceBlock_floor_reindex_sizes
    {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n) :
    blockRows n d + (blockColumns n d - d) = n ∧
      blockColumns n d + (blockRows n d - d) = n := by
  have hr := degree_le_blockRows hd hn
  have hs := degree_le_blockColumns n d
  have hsize := block_size_identity n d
  omega

def sourceBlockRowEquiv
    {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n) :
    Fin n ≃ Fin (blockRows n d) ⊕ Fin (blockColumns n d - d) :=
  (finCongr (sourceBlock_floor_reindex_sizes hd hn).1.symm).trans
    (finSumFinEquiv :
      Fin (blockRows n d) ⊕ Fin (blockColumns n d - d) ≃
        Fin (blockRows n d + (blockColumns n d - d))).symm

def sourceBlockColumnEquiv
    {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n) :
    Fin n ≃ Fin (blockColumns n d) ⊕ Fin (blockRows n d - d) :=
  (finCongr (sourceBlock_floor_reindex_sizes hd hn).2.symm).trans
    (finSumFinEquiv :
      Fin (blockColumns n d) ⊕ Fin (blockRows n d - d) ≃
        Fin (blockColumns n d + (blockRows n d - d))).symm

def sourceTreeBlockCommonFactor (b t s d : ℕ) : ℂ :=
  (((s - d).factorial : ℕ) : ℂ) *
    (((t - d).factorial : ℕ) : ℂ) *
    ((((t.factorial : ℕ) : ℂ) ^ (b - 1)))

theorem sourceTreeBlockCommonFactor_ne_zero (b t s d : ℕ) :
    sourceTreeBlockCommonFactor b t s d ≠ 0 := by
  unfold sourceTreeBlockCommonFactor
  exact mul_ne_zero
    (mul_ne_zero
      (by exact_mod_cast (s - d).factorial_ne_zero)
      (by exact_mod_cast (t - d).factorial_ne_zero))
    (pow_ne_zero _ (by exact_mod_cast t.factorial_ne_zero))

theorem sourceBlockMatrix_rectangularPermanent_flatten
    (r s d : ℕ) (U : Matrix (Fin r) (Fin (r - d)) ℂ) :
    rectangularPermanent
        (sourceBlockMatrix r s d
          (fun i j =>
            (MvPolynomial.X
              ((finProdFinEquiv : Fin r × Fin s ≃ Fin (r * s))
                (i, j)) : MvPolynomial (Fin (r * s)) ℂ))
          (fun i j =>
            algebraMap ℂ (MvPolynomial (Fin (r * s)) ℂ) (U i j))) =
      MvPolynomial.rename
        (finProdFinEquiv : Fin r × Fin s ≃ Fin (r * s))
        (rectangularPermanent
          (sourceBlockMatrix r s d
            (fun i j =>
              (MvPolynomial.X (i, j) :
                MvPolynomial (Fin r × Fin s) ℂ))
            (fun i j =>
              algebraMap ℂ (MvPolynomial (Fin r × Fin s) ℂ)
                (U i j)))) := by
  classical
  simp only [rectangularPermanent, map_sum, map_prod]
  apply Finset.sum_congr rfl
  intro matching _
  apply Finset.prod_congr rfl
  intro row _
  cases row with
  | inl i =>
      cases hcolumn : matching (.inl i) <;>
        simp [sourceBlockMatrix, Matrix.fromBlocks]
  | inr i =>
      cases hcolumn : matching (.inr i) <;>
        simp [sourceBlockMatrix, Matrix.fromBlocks]

def sourceTreeSeparatedMinorSum
    (b t s d : ℕ) (tree : BlockTree (Fin b)) :
    MvPolynomial (Fin (b * t) × Fin s) ℂ :=
  ∑ h : Fin b,
    MvPolynomial.C
      (subtreeCoefficient
        (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) tree h) *
      MvPolynomial.rename
        (sourceRowBlockVariableEmbedding b t s h)
        (minorSum t s d)

theorem sourceTreeBlock_affine_permanent_specialization
    {n d : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ d)
    (tree : BlockTree (Fin (blockCount n d)))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ) :
    ∃ (sub : Fin n × Fin n → FreeAffineInput (Fin (blockVariables n d)))
      (c : ℂ), c ≠ 0 ∧
        MvPolynomial.aeval (fun ij => (sub ij).polynomial)
            (permanent n) =
          MvPolynomial.C c *
            MvPolynomial.rename
              (finProdFinEquiv :
                Fin (blockRows n d) × Fin (blockColumns n d) ≃
                  Fin (blockVariables n d))
              (sourceTreeSeparatedMinorSum
                (blockCount n d) (blockWidth d) (blockColumns n d) d tree) := by
  let b := blockCount n d
  let t := blockWidth d
  let s := blockColumns n d
  have hrows : blockRows n d = b * t := rfl
  have hvariables : blockVariables n d = (b * t) * s := rfl
  have hdt : d ≤ t := by
    dsimp [t]
    unfold blockWidth
    omega
  let U : Matrix (Fin (b * t)) (Fin (b * t - d)) ℂ :=
    sourceTreeMatrix b t d hdt ζ tree hnodup hleaves
  let er : Fin n ≃ Fin (b * t) ⊕ Fin (s - d) :=
    sourceBlockRowEquiv hd hn
  let ec : Fin n ≃ Fin s ⊕ Fin (b * t - d) :=
    sourceBlockColumnEquiv hd hn
  let sub : Fin n × Fin n → FreeAffineInput (Fin (blockVariables n d)) :=
    fun ij => sourceBlockAffineInput U (er ij.1) (ec ij.2)
  refine ⟨sub, sourceTreeBlockCommonFactor b t s d,
    sourceTreeBlockCommonFactor_ne_zero b t s d, ?_⟩
  change
    MvPolynomial.aeval
        (fun ij : Fin n × Fin n =>
          (sourceBlockAffineInput U (er ij.1) (ec ij.2)).polynomial)
        (permanent n) =
      (MvPolynomial.C (sourceTreeBlockCommonFactor b t s d) :
        MvPolynomial (Fin ((b * t) * s)) ℂ) *
        MvPolynomial.rename
          (finProdFinEquiv : Fin (b * t) × Fin s ≃ Fin ((b * t) * s))
          (sourceTreeSeparatedMinorSum b t s d tree)
  rw [sourceBlock_affine_permanent_specialization er ec U,
    sourceBlockMatrix_rectangularPermanent_flatten]
  rw [sourceTreeBlockMatrix_permanent_eq_separated_minorSum
    b t s d (by omega) hdt hζ tree hnodup hleaves]
  simp only [MvPolynomial.algebraMap_eq, map_natCast, map_mul, map_pow, map_sum, MvPolynomial.algHom_C,
    MvPolynomial.rename_rename, sourceTreeBlockCommonFactor, sourceTreeSeparatedMinorSum]

end

end Standalone_SourcePermanentSpecialization

section Standalone_MainReduction

open scoped BigOperators

noncomputable section

def separatedBlockMinorSum (b t s d : ℕ) (weight : Fin b → ℂ) :
    MvPolynomial (Fin (b * t) × Fin s) ℂ :=
  ∑ h : Fin b,
    MvPolynomial.C (weight h) *
      MvPolynomial.rename (sourceRowBlockVariableEmbedding b t s h)
        (minorSum t s d)

theorem separatedBlockMinorSum_isHomogeneous
    (b t s d : ℕ) (weight : Fin b → ℂ) :
    (separatedBlockMinorSum b t s d weight).IsHomogeneous d := by
  classical
  unfold separatedBlockMinorSum
  apply MvPolynomial.IsHomogeneous.sum
  intro h _
  exact (minorSum_isHomogeneous t s d).rename_isHomogeneous.C_mul (weight h)

theorem separatedBlockMinorSum_offBlock_pderiv
    (b t s d : ℕ) {h j : Fin b} (hne : h ≠ j)
    (i : Fin t) (a : Fin s) :
    MvPolynomial.pderiv
        (sourceRowBlockVariableEmbedding b t s h (i, a))
        (MvPolynomial.rename (sourceRowBlockVariableEmbedding b t s j)
          (minorSum t s d)) = 0 := by
  classical
  apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
  intro hmem
  have himage := MvPolynomial.vars_rename
    (sourceRowBlockVariableEmbedding b t s j)
    (minorSum t s d) hmem
  obtain ⟨entry, _, hentry⟩ := Finset.mem_image.mp himage
  exact Set.disjoint_left.mp
    (sourceRowBlockVariableEmbedding_disjoint b t s hne)
    ⟨(i, a), rfl⟩ ⟨entry, hentry⟩

theorem separatedBlockMinorSum_pderiv
    (b t s d : ℕ) (weight : Fin b → ℂ)
    (h : Fin b) (i : Fin t) (a : Fin s) :
    MvPolynomial.pderiv
        (sourceRowBlockVariableEmbedding b t s h (i, a))
        (separatedBlockMinorSum b t s d weight) =
      MvPolynomial.C (weight h) *
        MvPolynomial.rename (sourceRowBlockVariableEmbedding b t s h)
          (MvPolynomial.pderiv (i, a) (minorSum t s d)) := by
  classical
  unfold separatedBlockMinorSum
  rw [map_sum]
  rw [Finset.sum_eq_single h]
  · rw [MvPolynomial.pderiv_C_mul,
      MvPolynomial.pderiv_rename
        (sourceRowBlockVariableEmbedding b t s h).injective]
  · intro j _ hj
    rw [MvPolynomial.pderiv_C_mul,
      separatedBlockMinorSum_offBlock_pderiv
        b t s d hj.symm i a, mul_zero]
  · simp only [Finset.mem_univ, not_true_eq_false, Derivation.leibniz, smul_eq_mul, MvPolynomial.derivation_C,
      mul_zero, add_zero, mul_eq_zero, map_eq_zero, IsEmpty.forall_iff]

def blockMinorGraphPullback (b t s : ℕ) :
    MvPolynomial (BlockIncidenceCoordinate b t s) ℂ →ₐ[ℂ]
      MvPolynomial (Fin (b * t) × Fin s) ℂ :=
  MvPolynomial.aeval fun coordinate =>
    match coordinate.2 with
    | Sum.inl block =>
        MvPolynomial.rename
          (sourceRowBlockVariableEmbedding b t s coordinate.1)
          (powerSum t s block.1)
    | Sum.inr column =>
        MvPolynomial.X
          (sourceRowBlockVariableEmbedding b t s coordinate.1
            (column.2, column.1))

theorem blockMinorGraphPullback_rename
    (b t s : ℕ) (h : Fin b)
    (f : MvPolynomial (IncidenceCoordinate t s) ℂ) :
    blockMinorGraphPullback b t s
        (MvPolynomial.rename
          (fun coordinate : IncidenceCoordinate t s => (h, coordinate)) f) =
      MvPolynomial.rename (sourceRowBlockVariableEmbedding b t s h)
        (minorSumGraphPullback t s f) := by
  classical
  induction f using MvPolynomial.induction_on with
  | C c => simp only [blockMinorGraphPullback, MvPolynomial.aeval_eq_bind₁, MvPolynomial.algHom_C,
             MvPolynomial.algebraMap_eq, minorSumGraphPullback]
  | add f g hf hg =>
      simp only [map_add, hf, hg]
  | mul_X f coordinate hf =>
      rw [map_mul, map_mul, map_mul, hf]
      cases coordinate with
      | inl block =>
          simp only [minorSumGraphPullback, MvPolynomial.aeval_eq_bind₁, blockMinorGraphPullback, MvPolynomial.rename_X,
            MvPolynomial.bind₁_X_right, Sum.elim_inl, map_mul]
      | inr column =>
          simp only [minorSumGraphPullback, MvPolynomial.aeval_eq_bind₁, blockMinorGraphPullback, MvPolynomial.rename_X,
            MvPolynomial.bind₁_X_right, Sum.elim_inr, map_mul]

theorem blockMinorGraphPullback_equation
    (b t s d : ℕ) (hd : 0 < d)
    (coordinate : BlockIncidenceColumn b t s) :
    blockMinorGraphPullback b t s
        (blockIncidenceEquation b t s d coordinate) =
      MvPolynomial.rename
        (sourceRowBlockVariableEmbedding b t s coordinate.1)
        (MvPolynomial.pderiv (coordinate.2.2, coordinate.2.1)
          (minorSum t s d)) := by
  unfold blockIncidenceEquation
  rw [blockMinorGraphPullback_rename,
    minorSumGraphPullback_incidenceEquation t s d hd]

abbrev separatedBlockGradientIdeal
    (b t s d : ℕ) (weight : Fin b → ℂ) :
    Ideal (MvPolynomial (Fin (b * t) × Fin s) ℂ) :=
  homogeneousMapIdeal
    (fun coordinate : Fin (b * t) × Fin s =>
      MvPolynomial.pderiv coordinate
        (separatedBlockMinorSum b t s d weight))

abbrev SeparatedBlockCriticalCoordinateRing
    (b t s d : ℕ) (weight : Fin b → ℂ) :=
  MvPolynomial (Fin (b * t) × Fin s) ℂ ⧸
    separatedBlockGradientIdeal b t s d weight

theorem blockMinorGraphPullback_equation_mem_gradient
    (b t s d : ℕ) (weight : Fin b → ℂ)
    (hw : ∀ h, weight h ≠ 0) (hd : 0 < d)
    (coordinate : BlockIncidenceColumn b t s) :
    blockMinorGraphPullback b t s
        (blockIncidenceEquation b t s d coordinate) ∈
      separatedBlockGradientIdeal b t s d weight := by
  classical
  rw [blockMinorGraphPullback_equation b t s d hd]
  let z : Fin (b * t) × Fin s :=
    sourceRowBlockVariableEmbedding b t s coordinate.1
      (coordinate.2.2, coordinate.2.1)
  have hderiv :
      MvPolynomial.pderiv z
          (separatedBlockMinorSum b t s d weight) =
        MvPolynomial.C (weight coordinate.1) *
          MvPolynomial.rename
            (sourceRowBlockVariableEmbedding b t s coordinate.1)
            (MvPolynomial.pderiv (coordinate.2.2, coordinate.2.1)
              (minorSum t s d)) :=
    separatedBlockMinorSum_pderiv
      b t s d weight coordinate.1 coordinate.2.2 coordinate.2.1
  have hmember :
      MvPolynomial.pderiv z
          (separatedBlockMinorSum b t s d weight) ∈
        separatedBlockGradientIdeal b t s d weight :=
    Ideal.subset_span ⟨z, rfl⟩
  have hscaled :=
    (separatedBlockGradientIdeal b t s d weight).mul_mem_left
      (MvPolynomial.C ((weight coordinate.1)⁻¹)) hmember
  rw [hderiv, ← mul_assoc, ← MvPolynomial.C_mul,
    inv_mul_cancel₀ (hw coordinate.1), MvPolynomial.C_1, one_mul]
    at hscaled
  exact hscaled

def blockIncidenceWeightedCriticalGraph
    (b t s d : ℕ) (weight : Fin b → ℂ)
    (hw : ∀ h, weight h ≠ 0) (hd : 0 < d) :
    BlockIncidenceCoordinateRing b t s d →ₐ[ℂ]
      SeparatedBlockCriticalCoordinateRing b t s d weight := by
  let J := separatedBlockGradientIdeal b t s d weight
  let φ : MvPolynomial (BlockIncidenceCoordinate b t s) ℂ →ₐ[ℂ]
      SeparatedBlockCriticalCoordinateRing b t s d weight :=
    (Ideal.Quotient.mkₐ ℂ J).comp
      (blockMinorGraphPullback b t s)
  apply Ideal.Quotient.liftₐ (blockIncidenceIdeal b t s d) φ
  intro f hf
  have hker : blockIncidenceIdeal b t s d ≤
      RingHom.ker φ.toRingHom := by
    rw [Ideal.span_le]
    rintro _ ⟨coordinate, rfl⟩
    change Ideal.Quotient.mk J
      (blockMinorGraphPullback b t s
        (blockIncidenceEquation b t s d coordinate)) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact blockMinorGraphPullback_equation_mem_gradient
      b t s d weight hw hd coordinate
  exact hker hf

def blockMinorMatrixCoordinateLift (b t s : ℕ) :
    (Fin (b * t) × Fin s) → BlockIncidenceCoordinate b t s :=
  fun coordinate =>
    (((finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t)).symm
        coordinate.1).1,
      Sum.inr (coordinate.2,
        ((finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t)).symm
          coordinate.1).2))

theorem blockMinorGraphPullback_rename_matrix
    (b t s : ℕ) (f : MvPolynomial (Fin (b * t) × Fin s) ℂ) :
    blockMinorGraphPullback b t s
        (MvPolynomial.rename
          (blockMinorMatrixCoordinateLift b t s) f) = f := by
  classical
  induction f using MvPolynomial.induction_on with
  | C c => simp only [blockMinorGraphPullback, MvPolynomial.aeval_eq_bind₁, MvPolynomial.algHom_C,
             MvPolynomial.algebraMap_eq]
  | add f g hf hg => simp only [map_add, hf, hg]
  | mul_X f coordinate hf =>
      rw [map_mul, map_mul, hf]
      have hcoordinate :
          sourceRowBlockVariableEmbedding b t s
              (((finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t)).symm
                coordinate.1).1)
              (((finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t)).symm
                coordinate.1).2, coordinate.2) = coordinate := by
        apply Prod.ext
        · change
            (finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t))
              ((finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t)).symm
                coordinate.1) = coordinate.1
          exact Equiv.apply_symm_apply _ _
        · rfl
      rw [MvPolynomial.rename_X]
      simp only [blockMinorGraphPullback,
        MvPolynomial.aeval_X, blockMinorMatrixCoordinateLift]
      change f * MvPolynomial.X
        (sourceRowBlockVariableEmbedding b t s
          (((finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t)).symm
            coordinate.1).1)
          (((finProdFinEquiv : Fin b × Fin t ≃ Fin (b * t)).symm
            coordinate.1).2, coordinate.2)) =
          f * MvPolynomial.X coordinate
      rw [hcoordinate]

theorem blockIncidenceWeightedCriticalGraph_surjective
    (b t s d : ℕ) (weight : Fin b → ℂ)
    (hw : ∀ h, weight h ≠ 0) (hd : 0 < d) :
    Function.Surjective
      (blockIncidenceWeightedCriticalGraph
        b t s d weight hw hd) := by
  classical
  intro y
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective
    (I := separatedBlockGradientIdeal b t s d weight) y
  refine ⟨Ideal.Quotient.mk (blockIncidenceIdeal b t s d)
    (MvPolynomial.rename
      (blockMinorMatrixCoordinateLift b t s) f), ?_⟩
  change Ideal.Quotient.mk
    (separatedBlockGradientIdeal b t s d weight)
    (blockMinorGraphPullback b t s
      (MvPolynomial.rename
        (blockMinorMatrixCoordinateLift b t s) f)) = _
  rw [blockMinorGraphPullback_rename_matrix]

theorem separatedBlockCriticalCoordinateRing_ringKrullDim_le_incidence
    (b t s d : ℕ) (weight : Fin b → ℂ)
    (hw : ∀ h, weight h ≠ 0) (hd : 0 < d) :
    ringKrullDim (SeparatedBlockCriticalCoordinateRing
      b t s d weight) ≤
      ringKrullDim (BlockIncidenceCoordinateRing b t s d) :=
  ringKrullDim_le_of_surjective
    (blockIncidenceWeightedCriticalGraph
      b t s d weight hw hd).toRingHom
    (blockIncidenceWeightedCriticalGraph_surjective
      b t s d weight hw hd)

def flattenedSeparatedBlockMinorSum
    (b t s d : ℕ) (weight : Fin b → ℂ) :
    MvPolynomial (Fin ((b * t) * s)) ℂ :=
  MvPolynomial.rename
    (finProdFinEquiv : Fin (b * t) × Fin s ≃ Fin ((b * t) * s))
    (separatedBlockMinorSum b t s d weight)

theorem flattenedSeparatedBlockMinorSum_isHomogeneous
    (b t s d : ℕ) (weight : Fin b → ℂ) :
    (flattenedSeparatedBlockMinorSum b t s d weight).IsHomogeneous d := by
  exact MvPolynomial.IsHomogeneous.rename_isHomogeneous
    (separatedBlockMinorSum_isHomogeneous b t s d weight)

theorem separatedBlockGradientIdeal_map_flatten
    (b t s d : ℕ) (weight : Fin b → ℂ) :
    (separatedBlockGradientIdeal b t s d weight).map
      (MvPolynomial.renameEquiv ℂ
        (finProdFinEquiv :
          Fin (b * t) × Fin s ≃ Fin ((b * t) * s))).toRingHom =
      homogeneousMapIdeal
        (fun j : Fin ((b * t) * s) =>
          MvPolynomial.pderiv j
            (flattenedSeparatedBlockMinorSum b t s d weight)) := by
  classical
  let e : Fin (b * t) × Fin s ≃ Fin ((b * t) * s) :=
    finProdFinEquiv
  change
    (Ideal.span (Set.range fun j : Fin (b * t) × Fin s =>
      MvPolynomial.pderiv j
        (separatedBlockMinorSum b t s d weight))).map
      (MvPolynomial.renameEquiv ℂ e).toRingHom =
    Ideal.span (Set.range fun j : Fin ((b * t) * s) =>
      MvPolynomial.pderiv j
        (MvPolynomial.rename e
          (separatedBlockMinorSum b t s d weight)))
  rw [Ideal.map_span]
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
    change
      MvPolynomial.rename e
        (MvPolynomial.pderiv j
          (separatedBlockMinorSum b t s d weight)) ∈
        Ideal.span (Set.range fun k : Fin ((b * t) * s) =>
          MvPolynomial.pderiv k
            (MvPolynomial.rename e
              (separatedBlockMinorSum b t s d weight)))
    rw [← MvPolynomial.pderiv_rename e.injective]
    exact Ideal.subset_span ⟨e j, rfl⟩
  · rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    have hrename := MvPolynomial.pderiv_rename e.injective
      (e.symm j) (separatedBlockMinorSum b t s d weight)
    rw [e.apply_symm_apply] at hrename
    change
      MvPolynomial.pderiv j
        (MvPolynomial.rename e
          (separatedBlockMinorSum b t s d weight)) ∈ _
    rw [hrename]
    apply Ideal.subset_span
    exact ⟨MvPolynomial.pderiv (e.symm j)
      (separatedBlockMinorSum b t s d weight),
      ⟨e.symm j, rfl⟩, rfl⟩

def separatedBlockCriticalFlattenEquiv
    (b t s d : ℕ) (weight : Fin b → ℂ) :
    SeparatedBlockCriticalCoordinateRing b t s d weight ≃ₐ[ℂ]
      criticalCoordinateRing
        (flattenedSeparatedBlockMinorSum b t s d weight) :=
  Ideal.quotientEquivAlg
    (separatedBlockGradientIdeal b t s d weight)
    (homogeneousMapIdeal
      (fun j : Fin ((b * t) * s) =>
        MvPolynomial.pderiv j
          (flattenedSeparatedBlockMinorSum b t s d weight)))
    (MvPolynomial.renameEquiv ℂ
      (finProdFinEquiv :
        Fin (b * t) × Fin s ≃ Fin ((b * t) * s)))
    (separatedBlockGradientIdeal_map_flatten
      b t s d weight).symm

theorem flattenedSeparatedBlockMinorSum_criticalLocusDimension_le_of_incidence
    {b t s d : ℕ} (hd : 3 ≤ d)
    (weight : Fin b → ℂ) (hw : ∀ h, weight h ≠ 0)
    (hincidence :
      ringKrullDim (BlockIncidenceCoordinateRing b t s d) ≤
        ((b * ((2 ^ t - 1) + s * (d - 2)) : ℕ) : WithBot ℕ∞)) :
    criticalLocusDimension
      (flattenedSeparatedBlockMinorSum b t s d weight) ≤
        ((b * ((2 ^ t - 1) + s * (d - 2)) : ℕ) : WithBot ℕ∞) := by
  unfold criticalLocusDimension
  calc
    ringKrullDim (criticalCoordinateRing
      (flattenedSeparatedBlockMinorSum b t s d weight)) =
        ringKrullDim
          (SeparatedBlockCriticalCoordinateRing
            b t s d weight) :=
      (separatedBlockCriticalFlattenEquiv
        b t s d weight).symm.toRingEquiv.ringKrullDim
    _ ≤ ringKrullDim (BlockIncidenceCoordinateRing b t s d) :=
      separatedBlockCriticalCoordinateRing_ringKrullDim_le_incidence
        b t s d weight hw (by omega)
    _ ≤ ((b * ((2 ^ t - 1) + s * (d - 2)) : ℕ) : WithBot ℕ∞) :=
      hincidence

theorem flattenedSeparatedBlockMinorSum_criticalLocusDimension_le
    {b t s d : ℕ} (hd : 3 ≤ d) (ht : d ≤ t)
    (weight : Fin b → ℂ) (hw : ∀ h, weight h ≠ 0) :
    criticalLocusDimension
      (flattenedSeparatedBlockMinorSum b t s d weight) ≤
        ((b * ((2 ^ t - 1) + s * (d - 2)) : ℕ) : WithBot ℕ∞) := by
  exact flattenedSeparatedBlockMinorSum_criticalLocusDimension_le_of_incidence
    hd weight hw (blockIncidence_ringKrullDim_le_degree hd ht)

def sourceTreeBlockWeight (b d : ℕ) (tree : BlockTree (Fin b)) :
    Fin b → ℂ :=
  fun h => subtreeCoefficient
    (((-1 : ℂ) ^ (d + 1)) * (2 : ℂ) ^ d) tree h

theorem sourceTreeBlockWeight_ne_zero
    {b d : ℕ} (hd : 0 < d)
    (tree : BlockTree (Fin b))
    (hnodup : tree.leafList.Nodup)
    (hleaves : tree.leaves = Finset.univ) :
    ∀ h : Fin b, sourceTreeBlockWeight b d tree h ≠ 0 := by
  intro h
  exact (rootOfUnity_subtreeCoefficient_and_total_ne_zero
    hd tree hnodup).1 h (by simp only [hleaves, Finset.mem_univ])

def sourceSeparatedBlockMinorSum
    (n d : ℕ) (weight : Fin (blockCount n d) → ℂ) :
    MvPolynomial (Fin (blockVariables n d)) ℂ :=
  flattenedSeparatedBlockMinorSum
    (blockCount n d) (blockWidth d) (blockColumns n d) d weight

theorem sourceSeparatedBlockMinorSum_isHomogeneous
    (n d : ℕ) (weight : Fin (blockCount n d) → ℂ) :
    (sourceSeparatedBlockMinorSum n d weight).IsHomogeneous d := by
  exact flattenedSeparatedBlockMinorSum_isHomogeneous
    (blockCount n d) (blockWidth d) (blockColumns n d) d weight

theorem sourceSeparatedBlockMinorSum_criticalLocusDimension_le
    {n d : ℕ} (hd : 3 ≤ d)
    (weight : Fin (blockCount n d) → ℂ)
    (hw : ∀ h, weight h ≠ 0) :
    criticalLocusDimension (sourceSeparatedBlockMinorSum n d weight) ≤
      ((blockCount n d *
        (powerSumParameter d + blockColumns n d * (d - 2)) : ℕ) :
          WithBot ℕ∞) := by
  have ht : d ≤ blockWidth d := by
    unfold blockWidth
    omega
  change
    criticalLocusDimension
      (flattenedSeparatedBlockMinorSum
        (blockCount n d) (blockWidth d) (blockColumns n d) d weight) ≤
      ((blockCount n d *
        ((2 ^ blockWidth d - 1) + blockColumns n d * (d - 2)) : ℕ) :
          WithBot ℕ∞)
  exact flattenedSeparatedBlockMinorSum_criticalLocusDimension_le
    hd ht weight hw

structure CircuitPrefix (ι : Type) where
  program : List (Instruction ι)
  valid : ∀ position : Fin program.length,
    (program.get position).referencesBounded position.val

namespace CircuitPrefix

def values {ι : Type} (state : CircuitPrefix ι) :
    Array (MvPolynomial ι ℂ) :=
  state.program.foldl
    (fun values instruction => values.push (instruction.eval values)) #[]

def empty (ι : Type) : CircuitPrefix ι where
  program := []
  valid position := Fin.elim0 position

theorem forwardFold_size {ι : Type} (program : List (Instruction ι))
    (previous : Array (MvPolynomial ι ℂ)) :
    (program.foldl
      (fun values instruction => values.push (instruction.eval values))
        previous).size = previous.size + program.length := by
  induction program generalizing previous with
  | nil => simp only [List.foldl_nil, List.length_nil, add_zero]
  | cons instruction rest ih =>
    simpa only [List.foldl_cons, List.length_cons, Nat.add_comm, Array.size_push, Nat.add_assoc] using
      ih (previous.push (instruction.eval previous))

theorem values_size {ι : Type} (state : CircuitPrefix ι) :
    state.values.size = state.program.length := by
  simpa only [values, List.size_toArray, List.length_nil, zero_add] using
    forwardFold_size state.program (#[] : Array (MvPolynomial ι ℂ))

def append {ι : Type} (state : CircuitPrefix ι)
    (instruction : Instruction ι)
    (hvalid : instruction.referencesBounded state.program.length) :
    CircuitPrefix ι where
  program := state.program ++ [instruction]
  valid := by
    intro position
    by_cases hposition : position.val < state.program.length
    · change
        ((state.program ++ [instruction])[position.val]).referencesBounded
          position.val
      rw [List.getElem_append_left hposition]
      exact state.valid ⟨position.val, hposition⟩
    · have hlast : position.val = state.program.length := by
        have hlt := position.isLt
        simp only [List.length_append, List.length_singleton] at hlt
        omega
      change
        ((state.program ++ [instruction])[position.val]).referencesBounded
          position.val
      rw [List.getElem_append_right (by omega)]
      simpa only [hlast, tsub_self, List.getElem_cons_zero] using hvalid

theorem append_values {ι : Type} (state : CircuitPrefix ι)
    (instruction : Instruction ι)
    (hvalid : instruction.referencesBounded state.program.length) :
    (state.append instruction hvalid).values =
      state.values.push (instruction.eval state.values) := by
  simp only [values, append, List.foldl_append, List.foldl_cons, List.foldl_nil]

theorem append_values_getD_of_lt {ι : Type} (state : CircuitPrefix ι)
    (instruction : Instruction ι)
    (hvalid : instruction.referencesBounded state.program.length)
    (index : ℕ) (hindex : index < state.program.length) :
    (state.append instruction hvalid).values.getD index 0 =
      state.values.getD index 0 := by
  rw [append_values]
  have hsize : index < state.values.size := by
    simpa only [values_size] using hindex
  simp only [Array.getD_eq_getD_getElem?, Array.getElem?_push, Nat.ne_of_lt hsize, ↓reduceIte]

theorem append_values_getD_new {ι : Type} (state : CircuitPrefix ι)
    (instruction : Instruction ι)
    (hvalid : instruction.referencesBounded state.program.length) :
    (state.append instruction hvalid).values.getD
      state.program.length 0 = instruction.eval state.values := by
  rw [append_values, ← values_size state]
  simp only [Array.getD_eq_getD_getElem?, Array.size_push, lt_add_iff_pos_right, Order.lt_one_iff, getElem?_pos,
    Array.getElem_push_eq, Option.getD_some]

theorem exists_extension_computing {ι : Type}
    (polynomial : MvPolynomial ι ℂ) (state : CircuitPrefix ι) :
    ∃ (extension : CircuitPrefix ι) (output : ℕ),
      state.program.length ≤ extension.program.length ∧
      output < extension.program.length ∧
      extension.values.getD output 0 = polynomial ∧
      ∀ index : ℕ, index < state.program.length →
        extension.values.getD index 0 = state.values.getD index 0 := by
  induction polynomial using MvPolynomial.induction_on generalizing state with
  | C coefficient =>
    have hvalid :
        (Instruction.scalar coefficient : Instruction ι).referencesBounded
          state.program.length := by
      simp only [Instruction.referencesBounded]
    let extension := state.append (.scalar coefficient) hvalid
    refine ⟨extension, state.program.length, ?_, ?_, ?_, ?_⟩
    · simp only [append, List.length_append, List.length_cons, List.length_nil, zero_add, le_add_iff_nonneg_right,
        zero_le, extension]
    · simp only [append, List.length_append, List.length_cons, List.length_nil, zero_add, lt_add_iff_pos_right,
        Order.lt_one_iff, extension]
    · simpa only [Array.getD_eq_getD_getElem?, Instruction.eval] using
        append_values_getD_new state (.scalar coefficient) hvalid
    · intro index hindex
      exact append_values_getD_of_lt state (.scalar coefficient)
        hvalid index hindex
  | add left right ihleft ihright =>
    obtain ⟨first, leftIndex, hprefixFirst, hleftIndex, hleft, hfirst⟩ :=
      ihleft state
    obtain ⟨second, rightIndex, hfirstSecond, hrightIndex, hright, hsecond⟩ :=
      ihright first
    have hleftSecond : leftIndex < second.program.length := by
      omega
    have hvalid :
        (Instruction.add leftIndex rightIndex : Instruction ι)
          |>.referencesBounded second.program.length := by
      simp only [Instruction.referencesBounded, hleftSecond, decide_true, hrightIndex, Bool.and_self]
    let extension := second.append (.add leftIndex rightIndex) hvalid
    refine ⟨extension, second.program.length, ?_, ?_, ?_, ?_⟩
    · simp only [extension, append, List.length_append,
        List.length_singleton]
      omega
    · simp only [append, List.length_append, List.length_cons, List.length_nil, zero_add, lt_add_iff_pos_right,
        Order.lt_one_iff, extension]
    · rw [show extension = second.append
          (.add leftIndex rightIndex) hvalid from rfl,
        append_values_getD_new]
      simp only [Instruction.eval]
      rw [hsecond leftIndex hleftIndex, hleft, hright]
    · intro index hindex
      have hfirstIndex : index < first.program.length := by
        omega
      have hsecondIndex : index < second.program.length := by omega
      rw [show extension = second.append
          (.add leftIndex rightIndex) hvalid from rfl,
        append_values_getD_of_lt second _ hvalid index hsecondIndex,
        hsecond index hfirstIndex, hfirst index hindex]
  | mul_X polynomial inputIndex ih =>
    obtain ⟨first, polynomialIndex, hprefixFirst, hpolynomialIndex,
      hpolynomial, hfirst⟩ := ih state
    have hinput :
        (Instruction.input inputIndex : Instruction ι).referencesBounded
          first.program.length := by
      simp only [Instruction.referencesBounded]
    let second := first.append (.input inputIndex) hinput
    have hpolynomialSecond : polynomialIndex < second.program.length := by
      simpa [second, append] using Nat.lt_succ_of_lt hpolynomialIndex
    have hvariableSecond : first.program.length < second.program.length := by
      simp only [append, List.length_append, List.length_cons, List.length_nil, zero_add, lt_add_iff_pos_right,
        Order.lt_one_iff, second]
    have hmul :
        (Instruction.mul polynomialIndex first.program.length : Instruction ι)
          |>.referencesBounded second.program.length := by
      simp only [Instruction.referencesBounded, hpolynomialSecond, decide_true, hvariableSecond, Bool.and_self]
    let extension := second.append
      (.mul polynomialIndex first.program.length) hmul
    refine ⟨extension, second.program.length, ?_, ?_, ?_, ?_⟩
    · simp only [extension, second, append, List.length_append,
        List.length_singleton]
      omega
    · simp only [append, List.length_append, List.length_cons, List.length_nil, zero_add, lt_add_iff_pos_right,
        Order.lt_one_iff, extension]
    · rw [show extension = second.append
          (.mul polynomialIndex first.program.length) hmul from rfl,
        append_values_getD_new]
      simp only [Instruction.eval]
      rw [show second = first.append (.input inputIndex) hinput from rfl,
        append_values_getD_of_lt first _ hinput
          polynomialIndex hpolynomialIndex,
        append_values_getD_new first (.input inputIndex) hinput,
        hpolynomial]
      rfl
    · intro index hindex
      have hfirstIndex : index < first.program.length := by
        omega
      have hsecondIndex : index < second.program.length := by
        simpa [second, append] using Nat.lt_succ_of_lt hfirstIndex
      rw [show extension = second.append
          (.mul polynomialIndex first.program.length) hmul from rfl,
        append_values_getD_of_lt second _ hmul index hsecondIndex,
        show second = first.append (.input inputIndex) hinput from rfl,
        append_values_getD_of_lt first _ hinput index hfirstIndex,
        hfirst index hindex]

end CircuitPrefix

namespace ArithmeticCircuit

end ArithmeticCircuit

theorem exists_arithmeticCircuit_polynomial {ι : Type}
    (polynomial : MvPolynomial ι ℂ) :
    ∃ circuit : ArithmeticCircuit ι,
      circuit.polynomial = polynomial := by
  obtain ⟨state, output, _, houtput, hpolynomial, _⟩ :=
    CircuitPrefix.exists_extension_computing polynomial
      (CircuitPrefix.empty ι)
  let circuit : ArithmeticCircuit ι :=
    ⟨state.program, output, houtput, state.valid⟩
  refine ⟨circuit, ?_⟩
  exact hpolynomial

theorem circuitComplexity_le_of_circuit {ι : Type}
    {polynomial : MvPolynomial ι ℂ} (circuit : ArithmeticCircuit ι)
    (hpolynomial : circuit.polynomial = polynomial) :
    circuitComplexity polynomial ≤ circuit.size := by
  exact Nat.sInf_le ⟨circuit, hpolynomial, rfl⟩

theorem circuitComplexity_attained_of_exists {ι : Type}
    (polynomial : MvPolynomial ι ℂ)
    (hrepresentable : ∃ circuit : ArithmeticCircuit ι,
      circuit.polynomial = polynomial) :
    ∃ circuit : ArithmeticCircuit ι,
      circuit.polynomial = polynomial ∧
        circuit.size = circuitComplexity polynomial := by
  have hnonempty :
      {size : ℕ | ∃ circuit : ArithmeticCircuit ι,
        circuit.polynomial = polynomial ∧ circuit.size = size}.Nonempty := by
    obtain ⟨circuit, hcircuit⟩ := hrepresentable
    exact ⟨circuit.size, circuit, hcircuit, rfl⟩
  exact Nat.sInf_mem hnonempty

theorem circuitComplexity_attained {ι : Type}
    (polynomial : MvPolynomial ι ℂ) :
    ∃ circuit : ArithmeticCircuit ι,
      circuit.polynomial = polynomial ∧
        circuit.size = circuitComplexity polynomial := by
  exact circuitComplexity_attained_of_exists polynomial
    (exists_arithmeticCircuit_polynomial polynomial)

theorem real_le_circuitComplexity_iff {ι : Type}
    (polynomial : MvPolynomial ι ℂ)
    (bound : ℝ) :
    bound ≤ (circuitComplexity polynomial : ℝ) ↔
      ∀ circuit : ArithmeticCircuit ι,
        circuit.polynomial = polynomial → bound ≤ (circuit.size : ℝ) := by
  constructor
  · intro hbound circuit hcircuit
    exact hbound.trans (by
      exact_mod_cast circuitComplexity_le_of_circuit circuit hcircuit)
  · intro hbound
    obtain ⟨circuit, hpolynomial, hsize⟩ :=
      circuitComplexity_attained polynomial
    simpa only [hsize] using hbound circuit hpolynomial

theorem homogeneous_logarithmic_product_bound_of_fiber_cardinalities
    {k e q cardinality : ℕ} (he : 0 < e)
    (hdegree : e ^ k ≤ cardinality)
    (hbezout : cardinality ≤ 2 ^ q) :
    (k : ℝ) * Real.logb 2 (e : ℝ) ≤ (q : ℝ) := by
  have hpower : e ^ k ≤ 2 ^ q := hdegree.trans hbezout
  have hreal : (e : ℝ) ^ k ≤ (2 : ℝ) ^ q := by
    exact_mod_cast hpower
  have he_real : 0 < (e : ℝ) := by
    exact_mod_cast he
  have hlog := Real.logb_le_logb_of_le
    (by norm_num : (1 : ℝ) < 2) (pow_pos he_real k) hreal
  simpa only [ge_iff_le, Real.logb_pow, Nat.one_lt_ofNat, Real.logb_self_eq_one, mul_one] using hlog

theorem sliced_gradient_logarithmic_bound_of_fiber_cardinalities
    {k d q cardinality : ℕ} (hd : 2 ≤ d)
    (hdegree : (d - 1) ^ k ≤ cardinality)
    (hbezout : cardinality ≤ 2 ^ q) :
    (k : ℝ) * Real.logb 2 ((d : ℝ) - 1) ≤ (q : ℝ) := by
  have he : 0 < d - 1 := by omega
  have hcast : ((d - 1 : ℕ) : ℝ) = (d : ℝ) - 1 := by
    rw [Nat.cast_sub (by omega : 1 ≤ d)]
    norm_num
  simpa only [ge_iff_le, hcast] using
    (homogeneous_logarithmic_product_bound_of_fiber_cardinalities (k := k) (e := d - 1) (q := q) he hdegree hbezout)

theorem exists_source_parameter_slicedGradient
    {n d dimension : ℕ} (hd : 3 ≤ d)
    (hn : 6 * blockWidth d ≤ n)
    (hscale : 4 * powerSumParameter d ≤
      blockWidth d * blockColumns n d)
    (hdimension : dimension ≤ blockCount n d *
      (powerSumParameter d + blockColumns n d * (d - 2)))
    (P : MvPolynomial (Fin (blockVariables n d)) ℂ)
    (hP : P.IsHomogeneous d)
    (hcritical : criticalLocusDimension P ≤
      (dimension : WithBot ℕ∞)) :
    ∃ (W : (Fin (sliceRank n d) → ℂ) →ₗ[ℂ]
          (Fin (blockVariables n d) → ℂ))
      (A : (Fin (blockVariables n d) → ℂ) →ₗ[ℂ]
          (Fin (sliceRank n d) → ℂ)),
      Function.Injective W ∧
      (∀ i : Fin (sliceRank n d),
        (slicedGradientPolynomial P W A i).IsHomogeneous (d - 1)) ∧
      (∀ u : Fin (sliceRank n d) → ℂ,
        (∀ i : Fin (sliceRank n d),
          MvPolynomial.eval u (slicedGradientPolynomial P W A i) = 0) ↔
            u = 0) := by
  have hhalf := twice_criticalDimension_lt_blockVariables
    hd hn hscale hdimension
  have hk := sliceRank_le_codimension hd hn hscale hdimension
  have hm := sliceRank_lt_blockVariables
    (eight_le_blockVariables hd hn)
  have hsub :
      blockVariables n d - (blockVariables n d - dimension) = dimension := by
    omega
  have hcodimension :
      criticalLocusDimension P ≤
        ((blockVariables n d -
          (blockVariables n d - dimension) : ℕ) : WithBot ℕ∞) := by
    simpa only [hsub] using hcritical
  exact exists_slicedGradient_of_criticalLocus_codimension
    P (by omega) hP hk hm hcodimension

theorem exists_source_block_slicedGradient
