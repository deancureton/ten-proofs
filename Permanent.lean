theorem homogeneousMap_allRank_coordinateSubsetGradedIdealPiece_eq_bot_of_lt
    {k e : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (restricted : Finset (Fin k)) (n : ℕ) (hn : n < e) :
    homogeneousMapGradedIdealPiece
      (homogeneousMapAllKCoordinateSubsetIdeal F restricted) n = ⊥ := by
  classical
  apply bot_unique
  intro p hp
  change (p : MvPolynomial (Fin k) ℂ) ∈
    homogeneousMapAllKCoordinateSubsetIdeal F restricted at hp
  have hrange :
      Set.range (fun i : {i : Fin k // i ∈ restricted} => F i.1) =
        F '' (restricted : Set (Fin k)) := by
    ext q
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨i.1, i.2, rfl⟩
    · rintro ⟨i, hi, rfl⟩
      exact ⟨⟨i, hi⟩, rfl⟩
  change (p : MvPolynomial (Fin k) ℂ) ∈
    Ideal.span (F '' (restricted : Set (Fin k))) at hp
  rw [← hrange] at hp
  obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hp
  have hcomponent := congrArg (MvPolynomial.homogeneousComponent n) hc
  simp only [map_sum] at hcomponent
  have hterms : ∀ i : {i : Fin k // i ∈ restricted},
      MvPolynomial.homogeneousComponent n (c i * F i.1) = 0 :=
    fun i => homogeneousComponent_mul_of_right_isHomogeneous_of_lt
      (c i) (F i.1) (hF i.1) hn
  simp_rw [hterms, Finset.sum_const_zero,
    MvPolynomial.homogeneousComponent_eq_self p.property] at hcomponent
  have hpzero : p = 0 := Subtype.ext hcomponent.symm
  simp only [hpzero, zero_mem]

noncomputable def homogeneousMapAllKActualCoordinateHilbert
    {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ)
    (restricted : Finset (Fin k)) (n : ℕ) : ℕ :=
  Module.finrank ℂ
    (homogeneousMapGradedQuotientPiece
      (homogeneousMapAllKCoordinateSubsetIdeal F restricted) n)

theorem homogeneousMap_allRank_actualCoordinateHilbert_empty
    {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ) (n : ℕ) :
    homogeneousMapAllKActualCoordinateHilbert F ∅ n =
      (k + n - 1).choose n := by
  classical
  letI : Module.Finite ℂ
      (MvPolynomial.homogeneousSubmodule (Fin k) ℂ n) :=
    (Submodule.fg_iff_finiteDimensional _).mp
      (MvPolynomial.homogeneousSubmodule_fg (Fin k) ℂ n)
  have hpiece :
      homogeneousMapGradedIdealPiece
        (homogeneousMapAllKCoordinateSubsetIdeal F ∅) n = ⊥ := by
    rw [homogeneousMap_allRank_coordinateSubsetIdeal_empty]
    ext p
    change ((p : MvPolynomial (Fin k) ℂ) ∈
      (⊥ : Ideal (MvPolynomial (Fin k) ℂ))) ↔
      p ∈ (⊥ : Submodule ℂ
        (MvPolynomial.homogeneousSubmodule (Fin k) ℂ n))
    simp only [Submodule.mem_bot, ZeroMemClass.coe_eq_zero]
  unfold homogeneousMapAllKActualCoordinateHilbert
  calc
    Module.finrank ℂ
        (homogeneousMapGradedQuotientPiece
          (homogeneousMapAllKCoordinateSubsetIdeal F ∅) n) =
        Module.finrank ℂ
          (MvPolynomial.homogeneousSubmodule (Fin k) ℂ n ⧸
            (⊥ : Submodule ℂ
              (MvPolynomial.homogeneousSubmodule (Fin k) ℂ n))) :=
      (Submodule.quotEquivOfEq _ _ hpiece).finrank_eq
    _ = Module.finrank ℂ
        (MvPolynomial.homogeneousSubmodule (Fin k) ℂ n) :=
      (Submodule.quotEquivOfEqBot _ rfl).finrank_eq
    _ = (k + n - 1).choose n := by
      simpa only [Fintype.card_fin] using (homogeneousMap_homogeneousSubmodule_finrank (ι := Fin k) n)

theorem homogeneousMap_allRank_actualCoordinateHilbert_insert_of_lt
    {k e : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (restricted : Finset (Fin k)) (j : Fin k)
    (n : ℕ) (hn : n < e) :
    homogeneousMapAllKActualCoordinateHilbert F (insert j restricted) n =
