    change
      Ideal.Quotient.mk
        (Ideal.span (Set.range
          (homogeneousMapAllTargetReesCoordinate F target e)))
        (Polynomial.aeval
          (MvPolynomial.X (0 : Fin (k + 1)))
          (Polynomial.X - Polynomial.C a)) = _
    simp only [Polynomial.aeval_X, Polynomial.aeval_C, MvPolynomial.algebraMap_eq, map_sub]
  rw [Polynomial.ker_evalRingHom,
    homogeneousMapAllTargetReesChartIdeal, Ideal.map_span, Ideal.map_span]
  simp only [Set.image_singleton]
  rw [hgenerator]

noncomputable def homogeneousMapAllTargetReesPolynomialParameterFiberEquiv
    {k : ℕ} (F : Fin k → MvPolynomial (Fin k) ℂ)
    (target : Fin k → ℂ) (e : ℕ) (a : ℂ) :
    letI : Algebra (Polynomial ℂ)
      (homogeneousMapAllTargetReesQuotient F target e) :=
        homogeneousMapAllTargetReesParameterAlgebra F target e
    (homogeneousMapAllTargetReesQuotient F target e ⧸
      (RingHom.ker (Polynomial.evalRingHom a)).map
        (algebraMap (Polynomial ℂ)
          (homogeneousMapAllTargetReesQuotient F target e))) ≃ₐ[ℂ]
      homogeneousMapClosedFiber F (fun i => target i * a ^ e) := by
  letI : Algebra (Polynomial ℂ)
      (homogeneousMapAllTargetReesQuotient F target e) :=
    homogeneousMapAllTargetReesParameterAlgebra F target e
  have hideal := homogeneousMapAllTargetReesParameterMaximalIdeal_map F target e a
  exact (Ideal.quotientEquivAlgOfEq ℂ hideal).trans
    (homogeneousMapAllTargetReesDoubleQuotientFiberEquiv F target e a)

theorem homogeneousMap_closedFiber_finrank_of_rees_finite
    (k : ℕ) (F : Fin k → MvPolynomial (Fin k) ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (target : Fin k → ℂ)
    (hfinite :
      letI : Algebra (Polynomial ℂ)
        (homogeneousMapAllTargetReesQuotient F target e) :=
          homogeneousMapAllTargetReesParameterAlgebra F target e
      Module.Finite (Polynomial ℂ)
        (homogeneousMapAllTargetReesQuotient F target e)) :
    Module.finrank ℂ (homogeneousMapClosedFiber F target) = e ^ k := by
  let A := homogeneousMapAllTargetReesQuotient F target e
  letI : Algebra (Polynomial ℂ) A :=
    homogeneousMapAllTargetReesParameterAlgebra F target e
  have hparameter (a : ℂ) :
      Module.finrank ℂ
        (A ⧸ (RingHom.ker (Polynomial.evalRingHom a)).map
          (algebraMap (Polynomial ℂ) A)) =
        Module.finrank (Polynomial ℂ) A := by
    exact homogeneousMap_allTarget_rees_parameterFiber_finrank
      F target e he hF hzero hfinite a
  have htarget :=
    (homogeneousMapAllTargetReesPolynomialParameterFiberEquiv
      F target e 1).toLinearEquiv.finrank_eq
  have hzeroFiber :=
    (homogeneousMapAllTargetReesPolynomialParameterFiberEquiv
      F target e 0).toLinearEquiv.finrank_eq
  have htarget_scale :
      (fun i : Fin k => target i * (1 : ℂ) ^ e) = target := by
    funext i
    simp only [one_pow, mul_one]
  have hzero_scale :
      (fun i : Fin k => target i * (0 : ℂ) ^ e) =
        (0 : Fin k → ℂ) := by
    funext i
    simp only [zero_pow he.ne', mul_zero, Pi.zero_apply]
  rw [htarget_scale] at htarget
  rw [hzero_scale] at hzeroFiber
  calc
    Module.finrank ℂ (homogeneousMapClosedFiber F target) =
        Module.finrank ℂ
          (A ⧸ (RingHom.ker (Polynomial.evalRingHom 1)).map
            (algebraMap (Polynomial ℂ) A)) := htarget.symm
    _ = Module.finrank (Polynomial ℂ) A := hparameter 1
    _ = Module.finrank ℂ
          (A ⧸ (RingHom.ker (Polynomial.evalRingHom 0)).map
            (algebraMap (Polynomial ℂ) A)) := (hparameter 0).symm
    _ = Module.finrank ℂ (homogeneousMapClosedFiber F 0) := hzeroFiber
    _ = e ^ k := homogeneousMap_zeroClosedFiber_finrank k F e he hF hzero

theorem homogeneousMap_closedFiber_finrank
    (k : ℕ) (F : Fin k → MvPolynomial (Fin k) ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : Fin k → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (target : Fin k → ℂ) :
    Module.finrank ℂ (homogeneousMapClosedFiber F target) = e ^ k :=
  homogeneousMap_closedFiber_finrank_of_rees_finite
    k F e he hF hzero target
    (homogeneousMap_allTarget_rees_moduleFinite
      F target e he hF hzero)

end Standalone_MultivariateBezout

noncomputable section Standalone_FreeAffine

open scoped BigOperators

structure FreeAffineForm (ι : Type*) where
  constant : ℂ
  inputCoefficients : ι →₀ ℂ
  gateCoefficients : ℕ →₀ ℂ

namespace FreeAffineForm

def eval {ι : Type*} (form : FreeAffineForm ι)
    (values : Array (MvPolynomial ι ℂ)) : MvPolynomial ι ℂ :=
  MvPolynomial.C form.constant +
    Finsupp.linearCombination ℂ MvPolynomial.X form.inputCoefficients +
    Finsupp.linearCombination ℂ (fun index => values.getD index 0)
      form.gateCoefficients

@[simp] protected def zero {ι : Type*} : FreeAffineForm ι := ⟨0, 0, 0⟩

instance {ι : Type*} : Zero (FreeAffineForm ι) := ⟨FreeAffineForm.zero⟩

@[simp] protected def add {ι : Type*} (left right : FreeAffineForm ι) :
    FreeAffineForm ι :=
  ⟨left.constant + right.constant,
    left.inputCoefficients + right.inputCoefficients,
    left.gateCoefficients + right.gateCoefficients⟩

instance {ι : Type*} : Add (FreeAffineForm ι) := ⟨FreeAffineForm.add⟩

@[simp] protected def sub {ι : Type*} (left right : FreeAffineForm ι) :
    FreeAffineForm ι :=
  ⟨left.constant - right.constant,
    left.inputCoefficients - right.inputCoefficients,
    left.gateCoefficients - right.gateCoefficients⟩

instance {ι : Type*} : Sub (FreeAffineForm ι) := ⟨FreeAffineForm.sub⟩

@[simp] protected def smul {ι : Type*} (coefficient : ℂ) (form : FreeAffineForm ι) :
    FreeAffineForm ι :=
  ⟨coefficient * form.constant,
    coefficient • form.inputCoefficients,
    coefficient • form.gateCoefficients⟩

instance {ι : Type*} : SMul ℂ (FreeAffineForm ι) :=
  ⟨FreeAffineForm.smul⟩

def scalar {ι : Type*} (coefficient : ℂ) : FreeAffineForm ι :=
  ⟨coefficient, 0, 0⟩

def input {ι : Type*} (index : ι) : FreeAffineForm ι :=
  ⟨0, Finsupp.single index 1, 0⟩

def gate {ι : Type*} (index : ℕ) : FreeAffineForm ι :=
  ⟨0, 0, Finsupp.single index 1⟩

@[simp] theorem eval_zero {ι : Type*}
    (values : Array (MvPolynomial ι ℂ)) :
    (0 : FreeAffineForm ι).eval values = 0 := by
  change
    MvPolynomial.C (0 : ℂ) +
      Finsupp.linearCombination ℂ MvPolynomial.X (0 : ι →₀ ℂ) +
      Finsupp.linearCombination ℂ (fun index => values.getD index 0)
        (0 : ℕ →₀ ℂ) = 0
  simp only [map_zero, add_zero, Array.getD_eq_getD_getElem?]

@[simp] theorem eval_scalar {ι : Type*} (coefficient : ℂ)
    (values : Array (MvPolynomial ι ℂ)) :
    (scalar coefficient : FreeAffineForm ι).eval values =
      MvPolynomial.C coefficient := by
  simp only [eval, scalar, map_zero, add_zero, Array.getD_eq_getD_getElem?]

@[simp] theorem eval_input {ι : Type*} (index : ι)
    (values : Array (MvPolynomial ι ℂ)) :
    (input index).eval values = MvPolynomial.X index := by
  simp only [eval, input, Finsupp.linearCombination_single, one_smul, zero_add, Array.getD_eq_getD_getElem?,
    map_zero, add_zero]

@[simp] theorem eval_gate {ι : Type*} (index : ℕ)
    (values : Array (MvPolynomial ι ℂ)) :
    (gate index : FreeAffineForm ι).eval values = values.getD index 0 := by
  simp only [eval, gate, map_zero, add_zero, Array.getD_eq_getD_getElem?, Finsupp.linearCombination_single,
    one_smul, zero_add]

@[simp] theorem eval_add {ι : Type*} (left right : FreeAffineForm ι)
    (values : Array (MvPolynomial ι ℂ)) :
    (left + right).eval values = left.eval values + right.eval values := by
  change
    MvPolynomial.C (left.constant + right.constant) +
      Finsupp.linearCombination ℂ MvPolynomial.X
        (left.inputCoefficients + right.inputCoefficients) +
      Finsupp.linearCombination ℂ (fun index => values.getD index 0)
        (left.gateCoefficients + right.gateCoefficients) = _
  simp only [map_add, add_assoc, Array.getD_eq_getD_getElem?, eval, add_left_comm, add_comm]

@[simp] theorem eval_sub {ι : Type*} (left right : FreeAffineForm ι)
    (values : Array (MvPolynomial ι ℂ)) :
    (left - right).eval values = left.eval values - right.eval values := by
  change
    MvPolynomial.C (left.constant - right.constant) +
      Finsupp.linearCombination ℂ MvPolynomial.X
        (left.inputCoefficients - right.inputCoefficients) +
      Finsupp.linearCombination ℂ (fun index => values.getD index 0)
        (left.gateCoefficients - right.gateCoefficients) = _
  simp only [sub_eq_add_neg, map_add, map_neg, add_assoc, Array.getD_eq_getD_getElem?, eval, neg_add_rev,
    add_comm, add_left_comm]

@[simp] theorem eval_smul {ι : Type*} (coefficient : ℂ)
    (form : FreeAffineForm ι) (values : Array (MvPolynomial ι ℂ)) :
    (coefficient • form).eval values = coefficient • form.eval values := by
  change
    MvPolynomial.C (coefficient * form.constant) +
      Finsupp.linearCombination ℂ MvPolynomial.X
        (coefficient • form.inputCoefficients) +
      Finsupp.linearCombination ℂ (fun index => values.getD index 0)
        (coefficient • form.gateCoefficients) = _
  simp only [MvPolynomial.C_mul, map_smul, MvPolynomial.smul_eq_C_mul, Array.getD_eq_getD_getElem?, eval,
    smul_add]

end FreeAffineForm

structure FreeAffineInput (ι : Type*) where
  constant : ℂ
  inputCoefficients : ι →₀ ℂ

namespace FreeAffineInput

def polynomial {ι : Type*} (input : FreeAffineInput ι) :
    MvPolynomial ι ℂ :=
  MvPolynomial.C input.constant +
    Finsupp.linearCombination ℂ MvPolynomial.X input.inputCoefficients

end FreeAffineInput

namespace FreeAffineForm

def substituteInputs {ι κ : Type*} (form : FreeAffineForm ι)
    (substitution : ι → FreeAffineInput κ) : FreeAffineForm κ where
  constant := form.constant +
    Finsupp.linearCombination ℂ
      (fun index => (substitution index).constant) form.inputCoefficients
  inputCoefficients := Finsupp.linearCombination ℂ
    (fun index => (substitution index).inputCoefficients)
    form.inputCoefficients
  gateCoefficients := form.gateCoefficients

theorem eval_substituteInputs {ι κ : Type*} (form : FreeAffineForm ι)
    (substitution : ι → FreeAffineInput κ)
    (values : Array (MvPolynomial ι ℂ)) :
    (form.substituteInputs substitution).eval
      (values.map (MvPolynomial.aeval
        (fun index => (substitution index).polynomial))) =
      MvPolynomial.aeval
        (fun index => (substitution index).polynomial)
        (form.eval values) := by
  let φ : MvPolynomial ι ℂ →ₐ[ℂ] MvPolynomial κ ℂ :=
    MvPolynomial.aeval (fun index => (substitution index).polynomial)
  have hgate (index : ℕ) :
      (values.map φ).getD index 0 = φ (values.getD index 0) := by
    cases hvalue : values[index]? <;> simp [hvalue]
  have hgateCombination :
      Finsupp.linearCombination ℂ
        (fun index => (values.map φ).getD index 0) form.gateCoefficients =
        φ (Finsupp.linearCombination ℂ
          (fun index => values.getD index 0) form.gateCoefficients) := by
    simpa only [hgate, Array.getD_eq_getD_getElem?, AlgHom.coe_toLinearMap, Function.comp_def,
      AlgHom.toLinearMap_apply] using
      (Finsupp.apply_linearCombination ℂ φ.toLinearMap (fun index => values.getD index 0) form.gateCoefficients).symm
  have hinputCombination :
      φ (Finsupp.linearCombination ℂ MvPolynomial.X
        form.inputCoefficients) =
        Finsupp.linearCombination ℂ
          (fun index => (substitution index).polynomial)
          form.inputCoefficients := by
    simpa [φ, Function.comp_def] using
      Finsupp.apply_linearCombination ℂ φ.toLinearMap
        (MvPolynomial.X : ι → MvPolynomial ι ℂ)
        form.inputCoefficients
  have hconstantCombination :
      (MvPolynomial.C
        (Finsupp.linearCombination ℂ
          (fun index => (substitution index).constant)
          form.inputCoefficients) : MvPolynomial κ ℂ) =
        Finsupp.linearCombination ℂ
          (fun index =>
            (MvPolynomial.C (substitution index).constant :
              MvPolynomial κ ℂ))
          form.inputCoefficients := by
    simpa only [Algebra.linearMap_apply, MvPolynomial.algebraMap_eq, Function.comp_def] using
      Finsupp.apply_linearCombination ℂ (Algebra.linearMap ℂ (MvPolynomial κ ℂ))
        (fun index => (substitution index).constant) form.inputCoefficients
  have hlinearCombination :
      Finsupp.linearCombination ℂ
        (MvPolynomial.X : κ → MvPolynomial κ ℂ)
        (Finsupp.linearCombination ℂ
          (fun index => (substitution index).inputCoefficients)
          form.inputCoefficients) =
        Finsupp.linearCombination ℂ
          (fun index => Finsupp.linearCombination ℂ
            (MvPolynomial.X : κ → MvPolynomial κ ℂ)
            (substitution index).inputCoefficients)
          form.inputCoefficients := by
    simpa only [Function.comp_def] using
      Finsupp.apply_linearCombination ℂ (Finsupp.linearCombination ℂ (MvPolynomial.X : κ → MvPolynomial κ ℂ))
        (fun index => (substitution index).inputCoefficients) form.inputCoefficients
  have hsplitCombination :
      Finsupp.linearCombination ℂ
        (fun index => (substitution index).polynomial)
        form.inputCoefficients =
      Finsupp.linearCombination ℂ
        (fun index => MvPolynomial.C (substitution index).constant)
        form.inputCoefficients +
      Finsupp.linearCombination ℂ
        (fun index => Finsupp.linearCombination ℂ
          (MvPolynomial.X : κ → MvPolynomial κ ℂ)
          (substitution index).inputCoefficients)
        form.inputCoefficients := by
    simp only [FreeAffineInput.polynomial, Finsupp.linearCombination_apply, Finsupp.sum, smul_add,
      Finset.sum_add_distrib]
  change
    MvPolynomial.C
        (form.constant + Finsupp.linearCombination ℂ
          (fun index => (substitution index).constant)
          form.inputCoefficients) +
      Finsupp.linearCombination ℂ MvPolynomial.X
        (Finsupp.linearCombination ℂ
          (fun index => (substitution index).inputCoefficients)
          form.inputCoefficients) +
      Finsupp.linearCombination ℂ
        (fun index => (values.map φ).getD index 0)
        form.gateCoefficients =
      φ (MvPolynomial.C form.constant +
        Finsupp.linearCombination ℂ MvPolynomial.X
          form.inputCoefficients +
        Finsupp.linearCombination ℂ
          (fun index => values.getD index 0) form.gateCoefficients)
  rw [map_add, map_add, map_add, hconstantCombination,
    hlinearCombination, hinputCombination, hgateCombination,
    hsplitCombination]
  simp only [add_assoc, MvPolynomial.aeval_eq_bind₁, Array.getD_eq_getD_getElem?, MvPolynomial.algHom_C,
    MvPolynomial.algebraMap_eq, φ]

end FreeAffineForm

inductive FreeAffineInstruction (ι : Type*) where
  | affine (form : FreeAffineForm ι)
  | mul (left right : ℕ)

namespace FreeAffineInstruction

def referencesBounded {ι : Type*} (position : ℕ) :
    FreeAffineInstruction ι → Bool
  | .affine form =>
    decide (∀ index ∈ form.gateCoefficients.support, index < position)
  | .mul left right => decide (left < position) && decide (right < position)

def isMultiplication {ι : Type*} : FreeAffineInstruction ι → Bool
  | .affine _ => false
  | .mul _ _ => true

def eval {ι : Type*} (values : Array (MvPolynomial ι ℂ)) :
    FreeAffineInstruction ι → MvPolynomial ι ℂ
  | .affine form => form.eval values
  | .mul left right => values.getD left 0 * values.getD right 0

def substituteInputs {ι κ : Type*}
    (substitution : ι → FreeAffineInput κ) :
    FreeAffineInstruction ι → FreeAffineInstruction κ
  | .affine form => .affine (form.substituteInputs substitution)
  | .mul left right => .mul left right

@[simp] theorem referencesBounded_substituteInputs {ι κ : Type*}
    (substitution : ι → FreeAffineInput κ)
    (instruction : FreeAffineInstruction ι) (position : ℕ) :
    (instruction.substituteInputs substitution).referencesBounded position =
      instruction.referencesBounded position := by
  cases instruction <;> rfl

theorem eval_substituteInputs {ι κ : Type*}
    (substitution : ι → FreeAffineInput κ)
    (instruction : FreeAffineInstruction ι)
    (values : Array (MvPolynomial ι ℂ)) :
    (instruction.substituteInputs substitution).eval
      (values.map (MvPolynomial.aeval
        (fun index => (substitution index).polynomial))) =
      MvPolynomial.aeval
        (fun index => (substitution index).polynomial)
        (instruction.eval values) := by
  cases instruction with
  | affine form =>
    exact FreeAffineForm.eval_substituteInputs form substitution values
  | mul left right =>
    let φ : MvPolynomial ι ℂ →ₐ[ℂ] MvPolynomial κ ℂ :=
      MvPolynomial.aeval (fun index => (substitution index).polynomial)
    have hget (index : ℕ) :
        (values.map φ).getD index 0 = φ (values.getD index 0) := by
      cases hvalue : values[index]? <;> simp [hvalue]
    change
      (values.map φ).getD left 0 * (values.map φ).getD right 0 =
        φ (values.getD left 0 * values.getD right 0)
    rw [map_mul, hget, hget]

def ofInstruction {ι : Type} : Instruction ι → FreeAffineInstruction ι
  | .input index => .affine (FreeAffineForm.input index)
  | .scalar coefficient => .affine (FreeAffineForm.scalar coefficient)
  | .add left right =>
    .affine (FreeAffineForm.gate left + FreeAffineForm.gate right)
  | .sub left right =>
    .affine (FreeAffineForm.gate left - FreeAffineForm.gate right)
  | .mul left right => .mul left right

@[simp] theorem eval_ofInstruction {ι : Type}
    (instruction : Instruction ι) (values : Array (MvPolynomial ι ℂ)) :
    (ofInstruction instruction).eval values = instruction.eval values := by
  cases instruction <;>
    simp [ofInstruction, eval, Instruction.eval]

theorem referencesBounded_ofInstruction {ι : Type}
    (instruction : Instruction ι) (position : ℕ)
    (valid : instruction.referencesBounded position) :
    (ofInstruction instruction).referencesBounded position := by
  cases instruction with
  | input index =>
    simp only [referencesBounded, ofInstruction, FreeAffineForm.input, Finsupp.support_zero, Finset.notMem_empty,
      IsEmpty.forall_iff, implies_true, decide_true]
  | scalar coefficient =>
    simp only [referencesBounded, ofInstruction, FreeAffineForm.scalar, Finsupp.support_zero, Finset.notMem_empty,
      IsEmpty.forall_iff, implies_true, decide_true]
  | add left right =>
    simp only [Instruction.referencesBounded, Bool.and_eq_true,
      decide_eq_true_eq] at valid
    simp only [ofInstruction, referencesBounded,
      FreeAffineForm.gate, decide_eq_true_eq]
    intro index hindex
    rw [Finsupp.mem_support_iff] at hindex
    by_cases hleft : index = left
    · simpa only [hleft] using valid.1
    · by_cases hright : index = right
      · simpa only [hright] using valid.2
      · change
          ((Finsupp.single left (1 : ℂ) + Finsupp.single right 1 : ℕ →₀ ℂ)
            index) ≠ 0
          at hindex
        simp only [Finsupp.coe_add, Pi.add_apply, ne_eq, hleft, not_false_eq_true, Finsupp.single_eq_of_ne, hright,
          add_zero, not_true_eq_false] at hindex
  | sub left right =>
    simp only [Instruction.referencesBounded, Bool.and_eq_true,
      decide_eq_true_eq] at valid
    simp only [ofInstruction, referencesBounded,
      FreeAffineForm.gate, decide_eq_true_eq]
    intro index hindex
    rw [Finsupp.mem_support_iff] at hindex
    by_cases hleft : index = left
    · simpa only [hleft] using valid.1
    · by_cases hright : index = right
      · simpa only [hright] using valid.2
      · change
          ((Finsupp.single left (1 : ℂ) - Finsupp.single right 1 : ℕ →₀ ℂ)
            index) ≠ 0
          at hindex
        simp only [Finsupp.coe_sub, Pi.sub_apply, ne_eq, hleft, not_false_eq_true, Finsupp.single_eq_of_ne, hright,
          sub_self, not_true_eq_false] at hindex
  | mul left right =>
    simpa only [referencesBounded, ofInstruction, Bool.and_eq_true, decide_eq_true_eq,
      Instruction.referencesBounded] using valid

end FreeAffineInstruction

structure FreeAffineCircuit (ι : Type*) where
  program : List (FreeAffineInstruction ι)
  outputs : List (FreeAffineForm ι)
  valid : ∀ position : Fin program.length,
    (program.get position).referencesBounded position.val
  validOutputs : ∀ form ∈ outputs, ∀ index : ℕ,
    form.gateCoefficients index ≠ 0 → index < program.length

namespace FreeAffineCircuit

def values {ι : Type*} (circuit : FreeAffineCircuit ι) :
    Array (MvPolynomial ι ℂ) :=
  circuit.program.foldl
    (fun values instruction => values.push (instruction.eval values)) #[]

def polynomials {ι : Type*} (circuit : FreeAffineCircuit ι) :
    List (MvPolynomial ι ℂ) :=
  circuit.outputs.map fun form => form.eval circuit.values

def multiplicationCount {ι : Type*} (circuit : FreeAffineCircuit ι) : ℕ :=
  (circuit.program.filter FreeAffineInstruction.isMultiplication).length

def substituteInputs {ι κ : Type*} (circuit : FreeAffineCircuit ι)
    (substitution : ι → FreeAffineInput κ) : FreeAffineCircuit κ where
  program := circuit.program.map
    (FreeAffineInstruction.substituteInputs substitution)
  outputs := circuit.outputs.map
    (fun form => form.substituteInputs substitution)
  valid := by
    intro position
    have hposition : position.val < circuit.program.length := by
      simpa only [List.length_map] using position.isLt
    have hvalid := circuit.valid ⟨position.val, hposition⟩
    simpa only [List.get_eq_getElem, List.getElem_map,
      FreeAffineInstruction.referencesBounded_substituteInputs] using hvalid
  validOutputs := by
    intro form hform index hindex
    obtain ⟨original, horiginal, rfl⟩ := List.mem_map.mp hform
    simpa only [List.length_map] using circuit.validOutputs original horiginal index hindex

@[simp] theorem multiplicationCount_substituteInputs {ι κ : Type*}
    (circuit : FreeAffineCircuit ι)
    (substitution : ι → FreeAffineInput κ) :
    (circuit.substituteInputs substitution).multiplicationCount =
      circuit.multiplicationCount := by
  change
    ((circuit.program.map
      (FreeAffineInstruction.substituteInputs substitution)).filter
      FreeAffineInstruction.isMultiplication).length =
      (circuit.program.filter
        FreeAffineInstruction.isMultiplication).length
  induction circuit.program with
  | nil => simp only [List.map_nil, List.filter_nil, List.length_nil]
  | cons instruction tail ih =>
    cases instruction <;>
      simp [FreeAffineInstruction.substituteInputs,
        FreeAffineInstruction.isMultiplication, ih]

theorem values_substituteInputs {ι κ : Type*}
    (circuit : FreeAffineCircuit ι)
    (substitution : ι → FreeAffineInput κ) :
    (circuit.substituteInputs substitution).values =
      circuit.values.map
        (MvPolynomial.aeval
          (fun index => (substitution index).polynomial)) := by
  let φ : MvPolynomial ι ℂ →ₐ[ℂ] MvPolynomial κ ℂ :=
    MvPolynomial.aeval (fun index => (substitution index).polynomial)
  have hfold (program : List (FreeAffineInstruction ι))
      (initial : Array (MvPolynomial ι ℂ)) :
      (program.map (FreeAffineInstruction.substituteInputs substitution)).foldl
        (fun current instruction => current.push (instruction.eval current))
        (initial.map φ) =
      (program.foldl
        (fun current instruction => current.push (instruction.eval current))
        initial).map φ := by
    induction program generalizing initial with
    | nil => rfl
    | cons instruction rest ih =>
      simp only [List.map_cons, List.foldl_cons]
      rw [FreeAffineInstruction.eval_substituteInputs,
        ← Array.map_push]
      exact ih (initial.push (instruction.eval initial))
  simpa [values, substituteInputs, φ] using
    hfold circuit.program (#[] : Array (MvPolynomial ι ℂ))

def withOutputs {ι : Type*} (circuit : FreeAffineCircuit ι)
    (outputs : List (FreeAffineForm ι))
    (validOutputs : ∀ form ∈ outputs, ∀ index : ℕ,
      form.gateCoefficients index ≠ 0 → index < circuit.program.length) :
    FreeAffineCircuit ι where
  program := circuit.program
  outputs := outputs
  valid := circuit.valid
  validOutputs := validOutputs

def ofArithmetic {ι : Type} (circuit : ArithmeticCircuit ι) :
    FreeAffineCircuit ι where
  program := circuit.program.map FreeAffineInstruction.ofInstruction
  outputs := [FreeAffineForm.gate circuit.output]
  valid := by
    intro position
    have hposition : position.val < circuit.program.length := by
      simpa only [List.length_map] using position.isLt
    have hvalid := circuit.valid ⟨position.val, hposition⟩
    simpa only [List.get_eq_getElem, List.getElem_map] using
      FreeAffineInstruction.referencesBounded_ofInstruction (circuit.program.get ⟨position.val, hposition⟩) position.val
        hvalid
  validOutputs := by
    intro form hform index hindex
    simp only [List.mem_singleton] at hform
    subst form
    change (Finsupp.single circuit.output (1 : ℂ)) index ≠ 0 at hindex
    have heq : index = circuit.output :=
      (Finsupp.single_apply_ne_zero.mp hindex).1
    simpa only [heq, List.length_map, gt_iff_lt] using circuit.output_lt

@[simp] theorem values_ofArithmetic {ι : Type}
    (circuit : ArithmeticCircuit ι) :
    (ofArithmetic circuit).values = circuit.values := by
  simp only [values, ofArithmetic, ArithmeticCircuit.values, List.foldl_map]
  simp_rw [FreeAffineInstruction.eval_ofInstruction]

theorem multiplicationCount_ofArithmetic_le {ι : Type}
    (circuit : ArithmeticCircuit ι) :
    (ofArithmetic circuit).multiplicationCount ≤ circuit.size := by
  change
    ((circuit.program.map FreeAffineInstruction.ofInstruction).filter
      FreeAffineInstruction.isMultiplication).length ≤
      (circuit.program.filter Instruction.isArithmetic).length
  induction circuit.program with
  | nil => simp only [List.map_nil, List.filter_nil, List.length_nil, Std.le_refl]
  | cons instruction tail ih =>
    cases instruction <;>
      simp [FreeAffineInstruction.ofInstruction,
        FreeAffineInstruction.isMultiplication, Instruction.isArithmetic] at * <;>
      omega

end FreeAffineCircuit

end Standalone_FreeAffine

noncomputable section Standalone_ReverseMode

open scoped BigOperators

theorem pderiv_linearCombination {ι κ : Type*} (input : ι)
    (family : κ → MvPolynomial ι ℂ) (coefficients : κ →₀ ℂ) :
    MvPolynomial.pderiv input
        (Finsupp.linearCombination ℂ family coefficients) =
      Finsupp.linearCombination ℂ
        (fun index => MvPolynomial.pderiv input (family index))
        coefficients := by
  simpa only [Derivation.coeFn_coe, Function.comp_def] using
    Finsupp.apply_linearCombination ℂ (MvPolynomial.pderiv input).toLinearMap family coefficients

theorem pderiv_input_linearCombination {ι : Type*} (input : ι)
    (coefficients : ι →₀ ℂ) :
    MvPolynomial.pderiv input
        (Finsupp.linearCombination ℂ MvPolynomial.X coefficients) =
      MvPolynomial.C (coefficients input) := by
  classical
  rw [pderiv_linearCombination]
  by_cases hinput : coefficients input = 0
  · simp only [MvPolynomial.pderiv_X, Pi.single_apply, Finsupp.linearCombination_apply, Finsupp.sum, smul_ite,
      smul_zero, Finset.sum_ite_eq', Finsupp.mem_support_iff, hinput, ne_eq, not_true_eq_false, ↓reduceIte,
      MvPolynomial.C_0]
  · simp only [MvPolynomial.pderiv_X, Pi.single_apply, Finsupp.linearCombination_apply, Finsupp.sum, smul_ite,
      MvPolynomial.smul_eq_C_mul, mul_one, smul_zero, Finset.sum_ite_eq', Finsupp.mem_support_iff, ne_eq, hinput,
      not_false_eq_true, ↓reduceIte]

theorem FreeAffineForm.pderiv_eval {ι : Type*}
    (form : FreeAffineForm ι) (values : Array (MvPolynomial ι ℂ))
    (input : ι) :
    MvPolynomial.pderiv input (form.eval values) =
      MvPolynomial.C (form.inputCoefficients input) +
        Finsupp.linearCombination ℂ
          (fun gate => MvPolynomial.pderiv input
            (values.getD gate 0)) form.gateCoefficients := by
  simp only [FreeAffineForm.eval, map_add, MvPolynomial.pderiv_C,
    zero_add]
  rw [pderiv_input_linearCombination, pderiv_linearCombination]

structure ReverseAdjoint (ι : Type*) where
  inputAdjoints : ι →₀ MvPolynomial ι ℂ
  gateAdjoints : ℕ →₀ MvPolynomial ι ℂ
  multiplicationCount : ℕ

namespace ReverseAdjoint

def scaleCoefficients {ι κ : Type*}
    (adjoint : MvPolynomial ι ℂ) (coefficients : κ →₀ ℂ) :
    κ →₀ MvPolynomial ι ℂ :=
  coefficients.mapRange (fun coefficient =>
    MvPolynomial.C coefficient * adjoint) (by simp only [MvPolynomial.C_0, zero_mul])

@[simp] theorem scaleCoefficients_apply {ι κ : Type*}
    (adjoint : MvPolynomial ι ℂ) (coefficients : κ →₀ ℂ)
    (index : κ) :
    scaleCoefficients adjoint coefficients index =
      MvPolynomial.C (coefficients index) * adjoint := by
  simp only [scaleCoefficients, Finsupp.mapRange_apply]

theorem linearCombination_scaleCoefficients {ι κ : Type*}
    (adjoint : MvPolynomial ι ℂ) (coefficients : κ →₀ ℂ)
    (family : κ → MvPolynomial ι ℂ) :
    Finsupp.linearCombination (MvPolynomial ι ℂ) family
        (scaleCoefficients adjoint coefficients) =
      adjoint * Finsupp.linearCombination ℂ family coefficients := by
  classical
  simp only [Finsupp.linearCombination_apply, scaleCoefficients]
  rw [Finsupp.sum_mapRange_index
    (h := fun index coefficient => coefficient • family index)
    (fun _ => by simp only [smul_eq_mul, zero_mul])]
  simp only [Finsupp.sum, smul_eq_mul, mul_assoc, mul_left_comm, MvPolynomial.smul_eq_C_mul, Finset.mul_sum]

theorem linearCombination_erase_add {ι κ : Type*}
    (adjoints : κ →₀ MvPolynomial ι ℂ)
    (family : κ → MvPolynomial ι ℂ) (index : κ) :
    Finsupp.linearCombination (MvPolynomial ι ℂ) family
          (adjoints.erase index) +
        adjoints index * family index =
      Finsupp.linearCombination (MvPolynomial ι ℂ) family adjoints := by
  classical
  calc
    Finsupp.linearCombination (MvPolynomial ι ℂ) family
          (adjoints.erase index) + adjoints index * family index =
        Finsupp.linearCombination (MvPolynomial ι ℂ) family
          (adjoints.erase index) +
          Finsupp.linearCombination (MvPolynomial ι ℂ) family
            (Finsupp.single index (adjoints index)) := by
              simp only [Finsupp.linearCombination_single, smul_eq_mul]
    _ = Finsupp.linearCombination (MvPolynomial ι ℂ) family
          (adjoints.erase index +
            Finsupp.single index (adjoints index)) := by
              rw [map_add]
    _ = Finsupp.linearCombination (MvPolynomial ι ℂ) family adjoints := by
              rw [Finsupp.erase_add_single]

def affine {ι : Type*} (state : ReverseAdjoint ι)
    (position : ℕ) (form : FreeAffineForm ι) : ReverseAdjoint ι where
  inputAdjoints := state.inputAdjoints +
    scaleCoefficients (state.gateAdjoints position)
      form.inputCoefficients
  gateAdjoints := state.gateAdjoints.erase position +
    scaleCoefficients (state.gateAdjoints position)
      form.gateCoefficients
  multiplicationCount := state.multiplicationCount

@[simp] theorem affine_inputAdjoints_apply {ι : Type*}
    (state : ReverseAdjoint ι) (position : ℕ)
    (form : FreeAffineForm ι) (input : ι) :
    (state.affine position form).inputAdjoints input =
      state.inputAdjoints input +
        MvPolynomial.C (form.inputCoefficients input) *
          state.gateAdjoints position := by
  simp only [affine, Finsupp.coe_add, Pi.add_apply, scaleCoefficients_apply]

def mul {ι : Type*} (state : ReverseAdjoint ι)
    (values : Array (MvPolynomial ι ℂ))
    (position left right : ℕ) : ReverseAdjoint ι where
  inputAdjoints := state.inputAdjoints
  gateAdjoints := state.gateAdjoints.erase position +
    Finsupp.single left
      (state.gateAdjoints position * values.getD right 0) +
    Finsupp.single right
      (state.gateAdjoints position * values.getD left 0)
  multiplicationCount := state.multiplicationCount + 2

def step {ι : Type*} (values : Array (MvPolynomial ι ℂ))
    (state : ReverseAdjoint ι)
    (instruction : FreeAffineInstruction ι × ℕ) : ReverseAdjoint ι :=
  match instruction.1 with
  | .affine form => state.affine instruction.2 form
  | .mul left right => state.mul values instruction.2 left right

def initial {ι : Type*} (output : FreeAffineForm ι) : ReverseAdjoint ι where
  inputAdjoints := scaleCoefficients 1 output.inputCoefficients
  gateAdjoints := scaleCoefficients 1 output.gateCoefficients
  multiplicationCount := 0

def potential {ι : Type*} (state : ReverseAdjoint ι)
    (values : Array (MvPolynomial ι ℂ)) (input : ι) :
    MvPolynomial ι ℂ :=
  state.inputAdjoints input +
    Finsupp.linearCombination (MvPolynomial ι ℂ)
      (fun gate => MvPolynomial.pderiv input (values.getD gate 0))
      state.gateAdjoints

theorem initial_potential {ι : Type*}
    (output : FreeAffineForm ι)
    (values : Array (MvPolynomial ι ℂ)) (input : ι) :
    (initial output).potential values input =
      MvPolynomial.pderiv input (output.eval values) := by
  rw [FreeAffineForm.pderiv_eval]
  simp only [potential, initial, scaleCoefficients_apply, mul_one, Array.getD_eq_getD_getElem?,
    linearCombination_scaleCoefficients, one_mul]

theorem potential_affine {ι : Type*}
    (state : ReverseAdjoint ι)
    (values : Array (MvPolynomial ι ℂ))
    (position : ℕ) (form : FreeAffineForm ι) (input : ι)
    (hgate : values.getD position 0 = form.eval values) :
    (state.affine position form).potential values input =
      state.potential values input := by
  let family : ℕ → MvPolynomial ι ℂ :=
    fun gate => MvPolynomial.pderiv input (values.getD gate 0)
  have hderivative :
      family position =
        MvPolynomial.C (form.inputCoefficients input) +
          Finsupp.linearCombination ℂ family form.gateCoefficients := by
    dsimp [family]
    rw [hgate, FreeAffineForm.pderiv_eval]
  have herase := linearCombination_erase_add
    state.gateAdjoints family position
  change
    (state.inputAdjoints input +
      MvPolynomial.C (form.inputCoefficients input) *
        state.gateAdjoints position) +
      Finsupp.linearCombination (MvPolynomial ι ℂ) family
        (state.gateAdjoints.erase position +
          scaleCoefficients (state.gateAdjoints position)
            form.gateCoefficients) =
    state.inputAdjoints input +
      Finsupp.linearCombination (MvPolynomial ι ℂ) family
        state.gateAdjoints
  rw [map_add, linearCombination_scaleCoefficients, ← herase,
    hderivative]
  ring

theorem potential_mul {ι : Type*}
    (state : ReverseAdjoint ι)
    (values : Array (MvPolynomial ι ℂ))
    (position left right : ℕ) (input : ι)
    (hgate : values.getD position 0 =
      values.getD left 0 * values.getD right 0) :
    (state.mul values position left right).potential values input =
      state.potential values input := by
  let family : ℕ → MvPolynomial ι ℂ :=
    fun gate => MvPolynomial.pderiv input (values.getD gate 0)
  have hderivative :
      family position =
        family left * values.getD right 0 +
          values.getD left 0 * family right := by
    dsimp [family]
    rw [hgate, MvPolynomial.pderiv_mul]
  have herase := linearCombination_erase_add
    state.gateAdjoints family position
  change
    state.inputAdjoints input +
      Finsupp.linearCombination (MvPolynomial ι ℂ) family
        (state.gateAdjoints.erase position +
          Finsupp.single left
            (state.gateAdjoints position * values.getD right 0) +
          Finsupp.single right
            (state.gateAdjoints position * values.getD left 0)) =
    state.inputAdjoints input +
      Finsupp.linearCombination (MvPolynomial ι ℂ) family
        state.gateAdjoints
  rw [map_add, map_add, Finsupp.linearCombination_single,
    Finsupp.linearCombination_single, ← herase, hderivative]
  simp only [smul_eq_mul]
  ring

theorem step_potential {ι : Type*}
    (values : Array (MvPolynomial ι ℂ))
    (state : ReverseAdjoint ι)
    (instruction : FreeAffineInstruction ι × ℕ) (input : ι)
    (hgate : values.getD instruction.2 0 =
      instruction.1.eval values) :
    (step values state instruction).potential values input =
      state.potential values input := by
  cases instruction with
  | mk instruction position =>
    cases instruction with
    | affine form =>
      exact potential_affine state values position form input hgate
    | mul left right =>
      exact potential_mul state values position left right input hgate

theorem foldl_potential {ι : Type*}
    (values : Array (MvPolynomial ι ℂ))
    (instructions : List (FreeAffineInstruction ι × ℕ))
    (state : ReverseAdjoint ι) (input : ι)
    (hgate : ∀ instruction ∈ instructions,
      values.getD instruction.2 0 = instruction.1.eval values) :
    (instructions.foldl (step values) state).potential values input =
      state.potential values input := by
  induction instructions generalizing state with
  | nil => rfl
  | cons instruction rest ih =>
    rw [List.foldl_cons, ih (step values state instruction)
      (fun gate hmem => hgate gate (by simp only [List.mem_cons, hmem, or_true]))]
    exact step_potential values state instruction input
      (hgate instruction (by simp only [List.mem_cons, true_or]))

def forwardStep {ι : Type*} (values : Array (MvPolynomial ι ℂ))
    (instruction : FreeAffineInstruction ι) :
    Array (MvPolynomial ι ℂ) :=
  values.push (instruction.eval values)

theorem forwardFold_size {ι : Type*}
    (program : List (FreeAffineInstruction ι))
    (values : Array (MvPolynomial ι ℂ)) :
    (program.foldl forwardStep values).size =
      values.size + program.length := by
  induction program generalizing values with
  | nil => simp only [List.foldl_nil, List.length_nil, add_zero]
  | cons instruction rest ih =>
    simpa only [List.foldl_cons, forwardStep, List.length_cons, Nat.add_comm, Array.size_push,
      Nat.add_assoc] using ih (forwardStep values instruction)

theorem forwardFold_getD_of_lt {ι : Type*}
    (program : List (FreeAffineInstruction ι))
    (values : Array (MvPolynomial ι ℂ))
    (index : ℕ) (hindex : index < values.size) :
    (program.foldl forwardStep values).getD index 0 =
      values.getD index 0 := by
  induction program generalizing values with
  | nil => rfl
  | cons instruction rest ih =>
    have hpush : index < (forwardStep values instruction).size := by
      simpa only [forwardStep, Array.size_push, Order.lt_add_one_iff, Nat.succ_eq_add_one] using
        Nat.lt_trans hindex (Nat.lt_succ_self values.size)
    rw [List.foldl_cons, ih (forwardStep values instruction) hpush]
    simp only [forwardStep, Array.getD_eq_getD_getElem?, Array.getElem?_push, Nat.ne_of_lt hindex, ↓reduceIte]

theorem eval_congr_of_referencesBounded {ι : Type*}
    (instruction : FreeAffineInstruction ι) (position : ℕ)
    (before after : Array (MvPolynomial ι ℂ))
    (hvalid : instruction.referencesBounded position)
    (hvalues : ∀ index < position,
      before.getD index 0 = after.getD index 0) :
    instruction.eval before = instruction.eval after := by
  classical
  cases instruction with
  | affine form =>
    simp only [FreeAffineInstruction.referencesBounded,
      decide_eq_true_eq] at hvalid
    simp only [FreeAffineInstruction.eval, FreeAffineForm.eval]
    congr 1
    simp only [Finsupp.linearCombination_apply, Finsupp.sum]
    apply Finset.sum_congr rfl
    intro index hindex
    rw [hvalues index (hvalid index hindex)]
  | mul left right =>
    simp only [FreeAffineInstruction.referencesBounded,
      Bool.and_eq_true, decide_eq_true_eq] at hvalid
    simp only [FreeAffineInstruction.eval, hvalues left hvalid.1, Array.getD_eq_getD_getElem?,
      hvalues right hvalid.2]

theorem forwardFold_gateEquation {ι : Type*}
    (program : List (FreeAffineInstruction ι))
    (values : Array (MvPolynomial ι ℂ))
    (hvalid : ∀ position : Fin program.length,
      (program.get position).referencesBounded
        (values.size + position.val))
    (position : Fin program.length) :
    (program.foldl forwardStep values).getD
        (values.size + position.val) 0 =
      (program.get position).eval
        (program.foldl forwardStep values) := by
  induction program generalizing values with
  | nil => exact Fin.elim0 position
  | cons instruction rest ih =>
    cases position using Fin.cases with
    | zero =>
      have hhead : instruction.referencesBounded values.size := by
        simpa only [List.length_cons, Fin.coe_ofNat_eq_mod, Nat.zero_mod, add_zero, List.get_eq_getElem,
          List.getElem_cons_zero] using hvalid 0
      calc
        ((instruction :: rest).foldl forwardStep values).getD
            (values.size + (0 : Fin (instruction :: rest).length).val) 0 =
          (forwardStep values instruction).getD values.size 0 := by
            simp only [List.foldl_cons, Fin.val_zero, Nat.add_zero]
            apply forwardFold_getD_of_lt
            simp only [forwardStep, Array.size_push, lt_add_iff_pos_right, Order.lt_one_iff]
        _ = instruction.eval values := by
          simp only [forwardStep, Array.getD_eq_getD_getElem?, Array.size_push, lt_add_iff_pos_right, Order.lt_one_iff,
            getElem?_pos, Array.getElem_push_eq, Option.getD_some]
        _ = instruction.eval
              ((instruction :: rest).foldl forwardStep values) := by
          apply eval_congr_of_referencesBounded
            instruction values.size values _ hhead
          intro index hindex
          exact (forwardFold_getD_of_lt
            (instruction :: rest) values index hindex).symm
        _ = ((instruction :: rest).get
              (0 : Fin (instruction :: rest).length)).eval
              ((instruction :: rest).foldl forwardStep values) := rfl
    | succ position =>
      let next := forwardStep values instruction
      have hrest : ∀ index : Fin rest.length,
          (rest.get index).referencesBounded
            (next.size + index.val) := by
        intro index
        have hindex := hvalid index.succ
        simpa [next, forwardStep, Nat.add_assoc, Nat.add_comm,
          Nat.add_left_comm] using hindex
      have htail := ih next hrest position
      simpa [next, List.foldl_cons, forwardStep, Nat.add_assoc,
        Nat.add_comm, Nat.add_left_comm] using htail

def run {ι : Type*} (circuit : FreeAffineCircuit ι)
    (output : FreeAffineForm ι) : ReverseAdjoint ι :=
  (circuit.program.zipIdx.reverse).foldl
    (step circuit.values) (initial output)

theorem circuit_values_size {ι : Type*}
    (circuit : FreeAffineCircuit ι) :
    circuit.values.size = circuit.program.length := by
  change
    (circuit.program.foldl forwardStep
      (#[] : Array (MvPolynomial ι ℂ))).size = circuit.program.length
  simpa only [List.size_toArray, List.length_nil, zero_add] using
    forwardFold_size circuit.program (#[] : Array (MvPolynomial ι ℂ))

theorem circuit_gateEquation {ι : Type*}
    (circuit : FreeAffineCircuit ι)
    (position : Fin circuit.program.length) :
    circuit.values.getD position.val 0 =
      (circuit.program.get position).eval circuit.values := by
  have hvalid : ∀ index : Fin circuit.program.length,
      (circuit.program.get index).referencesBounded
        ((#[] : Array (MvPolynomial ι ℂ)).size + index.val) := by
    intro index
    simpa only [List.size_toArray, List.length_nil, zero_add, List.get_eq_getElem] using circuit.valid index
  change
    (circuit.program.foldl forwardStep
      (#[] : Array (MvPolynomial ι ℂ))).getD position.val 0 =
      (circuit.program.get position).eval
        (circuit.program.foldl forwardStep
          (#[] : Array (MvPolynomial ι ℂ)))
  simpa only [Array.getD_eq_getD_getElem?, List.get_eq_getElem, List.size_toArray, List.length_nil,
    zero_add] using forwardFold_gateEquation circuit.program (#[] : Array (MvPolynomial ι ℂ)) hvalid position

theorem run_potential {ι : Type*}
    (circuit : FreeAffineCircuit ι)
    (output : FreeAffineForm ι) (input : ι) :
    (run circuit output).potential circuit.values input =
      MvPolynomial.pderiv input (output.eval circuit.values) := by
  unfold run
  rw [foldl_potential]
  · exact initial_potential output circuit.values input
  · intro instruction hmem
    have hzip : instruction ∈ circuit.program.zipIdx := by
      simpa only [List.mem_reverse] using hmem
    rcases instruction with ⟨gate, position⟩
    obtain ⟨hposition, hgate⟩ := List.mem_zipIdx' hzip
    simpa only [Array.getD_eq_getD_getElem?, hgate, List.get_eq_getElem] using
      circuit_gateEquation circuit ⟨position, hposition⟩

theorem step_gateAdjoints_lt {ι : Type*}
    (values : Array (MvPolynomial ι ℂ))
    (state : ReverseAdjoint ι)
    (instruction : FreeAffineInstruction ι) (position : ℕ)
    (hvalid : instruction.referencesBounded position)
    (hstate : ∀ index, state.gateAdjoints index ≠ 0 →
      index < position + 1) :
    ∀ index,
      (step values state (instruction, position)).gateAdjoints index ≠ 0 →
        index < position := by
  classical
  intro index hnonzero
  by_contra hlt
  have hge : position ≤ index := Nat.le_of_not_gt hlt
  have herase : (state.gateAdjoints.erase position) index = 0 := by
    by_cases heq : index = position
    · subst index
      simp only [Finsupp.erase_same]
    · rw [Finsupp.erase_ne heq]
      by_contra hindex
      have hbound := hstate index hindex
      omega
  cases instruction with
  | affine form =>
    simp only [FreeAffineInstruction.referencesBounded,
      decide_eq_true_eq] at hvalid
    have hcoefficient : form.gateCoefficients index = 0 := by
      by_contra hcoefficient
      have hbound := hvalid index
        (Finsupp.mem_support_iff.mpr hcoefficient)
      omega
    simp only [step, affine, Finsupp.coe_add, Pi.add_apply, herase, scaleCoefficients_apply, hcoefficient,
      MvPolynomial.C_0, zero_mul, add_zero, ne_eq, not_true_eq_false] at hnonzero
  | mul left right =>
    simp only [FreeAffineInstruction.referencesBounded,
      Bool.and_eq_true, decide_eq_true_eq] at hvalid
    have hleft : left ≠ index := by omega
    have hright : right ≠ index := by omega
    simp only [step, mul, Array.getD_eq_getD_getElem?, Finsupp.single_mul, Finsupp.coe_add, Pi.add_apply, herase,
      Finsupp.mul_apply, ne_eq, hleft, not_false_eq_true, Finsupp.single_eq_of_ne', mul_zero, add_zero, hright,
      not_true_eq_false] at hnonzero

theorem reverseFold_gateAdjoints_lt {ι : Type*}
    (program : List (FreeAffineInstruction ι))
    (values : Array (MvPolynomial ι ℂ)) (start : ℕ)
    (state : ReverseAdjoint ι)
    (hvalid : ∀ instruction ∈ program.zipIdx start,
      instruction.1.referencesBounded instruction.2)
    (hstate : ∀ index, state.gateAdjoints index ≠ 0 →
      index < start + program.length) :
    ∀ index,
      (((program.zipIdx start).reverse).foldl (step values)
        state).gateAdjoints index ≠ 0 → index < start := by
  induction program generalizing start state with
  | nil =>
    simpa only [List.zipIdx_nil, List.reverse_nil, List.foldl_nil, ne_eq, List.length_nil, add_zero] using hstate
  | cons instruction rest ih =>
    have hhead : instruction.referencesBounded start := by
      apply hvalid (instruction, start)
      simp only [List.zipIdx_cons, List.mem_cons, true_or]
    have hrest : ∀ gate ∈ rest.zipIdx (start + 1),
        gate.1.referencesBounded gate.2 := by
      intro gate hgate
      apply hvalid gate
      simp only [List.zipIdx_cons, List.mem_cons, hgate, or_true]
    have hbound : ∀ index, state.gateAdjoints index ≠ 0 →
        index < (start + 1) + rest.length := by
      intro index hindex
      have hindex' := hstate index hindex
      simp only [List.length_cons] at hindex'
      omega
    have hmid := ih (start + 1) state hrest hbound
    simp only [List.zipIdx_cons, List.reverse_cons, List.foldl_append,
      List.foldl_cons, List.foldl_nil]
    exact step_gateAdjoints_lt values
      (((rest.zipIdx (start + 1)).reverse).foldl
        (step values) state)
      instruction start hhead hmid

theorem initial_gateAdjoints_lt {ι : Type*}
    (circuit : FreeAffineCircuit ι)
    (output : FreeAffineForm ι) (houtput : output ∈ circuit.outputs) :
    ∀ index, (initial output).gateAdjoints index ≠ 0 →
      index < circuit.program.length := by
  intro index hindex
  have hcoefficient : output.gateCoefficients index ≠ 0 := by
    intro hzero
    apply hindex
    simp only [initial, scaleCoefficients_apply, hzero, MvPolynomial.C_0, mul_one]
  exact circuit.validOutputs output houtput index hcoefficient

theorem run_gateAdjoints_eq_zero {ι : Type*}
    (circuit : FreeAffineCircuit ι)
    (output : FreeAffineForm ι) (houtput : output ∈ circuit.outputs) :
    (run circuit output).gateAdjoints = 0 := by
  have hvalid : ∀ instruction ∈ circuit.program.zipIdx,
      instruction.1.referencesBounded instruction.2 := by
    intro instruction hmem
    rcases instruction with ⟨gate, position⟩
    obtain ⟨hposition, hgate⟩ := List.mem_zipIdx' hmem
    simpa only [hgate, List.get_eq_getElem] using circuit.valid ⟨position, hposition⟩
  have hbound := reverseFold_gateAdjoints_lt circuit.program
    circuit.values 0 (initial output) hvalid
      (by simpa only [ne_eq, zero_add] using initial_gateAdjoints_lt circuit output houtput)
  apply Finsupp.ext
  intro index
  change (run circuit output).gateAdjoints index = 0
  by_contra hnonzero
  have hlt : index < 0 := by
    apply hbound index
    exact hnonzero
  omega

theorem run_inputAdjoints {ι : Type*}
    (circuit : FreeAffineCircuit ι)
    (output : FreeAffineForm ι) (houtput : output ∈ circuit.outputs)
    (input : ι) :
    (run circuit output).inputAdjoints input =
      MvPolynomial.pderiv input (output.eval circuit.values) := by
  have hpotential := run_potential circuit output input
  rw [potential, run_gateAdjoints_eq_zero circuit output houtput]
    at hpotential
  simpa only [Array.getD_eq_getD_getElem?, map_zero, add_zero] using hpotential

def appendInstruction {ι : Type*} (circuit : FreeAffineCircuit ι)
    (instruction : FreeAffineInstruction ι)
    (hvalid : instruction.referencesBounded circuit.program.length) :
    FreeAffineCircuit ι where
  program := circuit.program ++ [instruction]
  outputs := circuit.outputs
  valid := by
    intro position
    by_cases hposition : position.val < circuit.program.length
    · change
        ((circuit.program ++ [instruction])[position.val]).referencesBounded
          position.val
      rw [List.getElem_append_left hposition]
      exact circuit.valid ⟨position.val, hposition⟩
    · have hlast : position.val = circuit.program.length := by
        have hlt := position.isLt
        simp only [List.length_append, List.length_singleton] at hlt
        omega
      change
        ((circuit.program ++ [instruction])[position.val]).referencesBounded
          position.val
      rw [List.getElem_append_right (by omega)]
      simpa only [hlast, tsub_self, List.getElem_cons_zero] using hvalid
  validOutputs := by
    intro form hform index hindex
    have hbound := circuit.validOutputs form hform index hindex
    simp only [List.length_append, List.length_singleton]
    omega

theorem appendInstruction_values {ι : Type*}
    (circuit : FreeAffineCircuit ι)
    (instruction : FreeAffineInstruction ι)
    (hvalid : instruction.referencesBounded circuit.program.length) :
    (appendInstruction circuit instruction hvalid).values =
      circuit.values.push (instruction.eval circuit.values) := by
  change
    ((circuit.program ++ [instruction]).foldl forwardStep
      (#[] : Array (MvPolynomial ι ℂ))) =
      (circuit.program.foldl forwardStep
        (#[] : Array (MvPolynomial ι ℂ))).push
          (instruction.eval
            (circuit.program.foldl forwardStep
              (#[] : Array (MvPolynomial ι ℂ))))
  simp only [List.foldl_append, List.foldl_cons, forwardStep, List.foldl_nil]

def appendReverseProducts {ι : Type*}
    (circuit : FreeAffineCircuit ι) (adjoint : FreeAffineForm ι)
    (left right : ℕ)
    (hadjoint : ∀ index, adjoint.gateCoefficients index ≠ 0 →
      index < circuit.program.length)
    (hleft : left < circuit.program.length)
    (hright : right < circuit.program.length) : FreeAffineCircuit ι := by
  have haffine :
      (FreeAffineInstruction.affine adjoint).referencesBounded
        circuit.program.length := by
    simp only [FreeAffineInstruction.referencesBounded,
      decide_eq_true_eq]
    intro index hindex
    exact hadjoint index (Finsupp.mem_support_iff.mp hindex)
  let first := appendInstruction circuit (.affine adjoint) haffine
  have hfirst : first.program.length = circuit.program.length + 1 := by
    simp only [appendInstruction, List.length_append, List.length_cons, List.length_nil, zero_add, first]
  have hrightProduct :
      (FreeAffineInstruction.mul circuit.program.length right :
        FreeAffineInstruction ι).referencesBounded
          first.program.length := by
    simp only [FreeAffineInstruction.referencesBounded,
      Bool.and_eq_true, decide_eq_true_eq]
    constructor
    · omega
    · omega
  let second := appendInstruction first
    (.mul circuit.program.length right) hrightProduct
  have hsecond : second.program.length = circuit.program.length + 2 := by
    simp only [appendInstruction, List.append_assoc, List.cons_append, List.nil_append, List.length_append,
      List.length_cons, List.length_nil, zero_add, Nat.reduceAdd, second, first]
  have hleftProduct :
      (FreeAffineInstruction.mul circuit.program.length left :
        FreeAffineInstruction ι).referencesBounded
          second.program.length := by
    simp only [FreeAffineInstruction.referencesBounded,
      Bool.and_eq_true, decide_eq_true_eq]
    constructor
    · omega
    · omega
  exact appendInstruction second
    (.mul circuit.program.length left) hleftProduct

theorem appendReverseProducts_program_length {ι : Type*}
    (circuit : FreeAffineCircuit ι) (adjoint : FreeAffineForm ι)
    (left right : ℕ)
    (hadjoint : ∀ index, adjoint.gateCoefficients index ≠ 0 →
      index < circuit.program.length)
    (hleft : left < circuit.program.length)
    (hright : right < circuit.program.length) :
    (appendReverseProducts circuit adjoint left right
      hadjoint hleft hright).program.length =
        circuit.program.length + 3 := by
  simp only [appendReverseProducts, appendInstruction, List.append_assoc, List.cons_append, List.nil_append,
    List.length_append, List.length_cons, List.length_nil, zero_add, Nat.reduceAdd]

theorem appendReverseProducts_values {ι : Type*}
    (circuit : FreeAffineCircuit ι) (adjoint : FreeAffineForm ι)
    (left right : ℕ)
    (hadjoint : ∀ index, adjoint.gateCoefficients index ≠ 0 →
      index < circuit.program.length)
    (hleft : left < circuit.program.length)
    (hright : right < circuit.program.length) :
    (appendReverseProducts circuit adjoint left right
      hadjoint hleft hright).values =
      ((circuit.values.push (adjoint.eval circuit.values)).push
        (adjoint.eval circuit.values * circuit.values.getD right 0)).push
          (adjoint.eval circuit.values * circuit.values.getD left 0) := by
  have hfirst :
      (circuit.values.push (adjoint.eval circuit.values)).getD
        circuit.program.length 0 = adjoint.eval circuit.values := by
    rw [← circuit_values_size circuit]
    simp only [Array.getD_eq_getD_getElem?, Array.size_push, lt_add_iff_pos_right, Order.lt_one_iff, getElem?_pos,
      Array.getElem_push_eq, Option.getD_some]
  have hrightFirst :
      (circuit.values.push (adjoint.eval circuit.values)).getD right 0 =
        circuit.values.getD right 0 := by
    have hne : right ≠ circuit.values.size := by
      rw [circuit_values_size]
      exact Nat.ne_of_lt hright
    simp only [Array.getD_eq_getD_getElem?, Array.getElem?_push, hne, ↓reduceIte]
  have hsecond :
      ((circuit.values.push (adjoint.eval circuit.values)).push
        (adjoint.eval circuit.values *
          circuit.values.getD right 0)).getD circuit.program.length 0 =
        adjoint.eval circuit.values := by
    have hne : circuit.program.length ≠
        (circuit.values.push (adjoint.eval circuit.values)).size := by
      simp only [Array.size_push, circuit_values_size, ne_eq, Nat.left_eq_add, one_ne_zero, not_false_eq_true]
    rw [Array.getD_eq_getD_getElem?, Array.getElem?_push,
      if_neg hne]
    simpa only [Array.getD_eq_getD_getElem?] using hfirst
  have hleftSecond :
      ((circuit.values.push (adjoint.eval circuit.values)).push
        (adjoint.eval circuit.values *
          circuit.values.getD right 0)).getD left 0 =
        circuit.values.getD left 0 := by
    have hleftFirst : left ≠ circuit.values.size := by
      rw [circuit_values_size]
      exact Nat.ne_of_lt hleft
    have hleftNext : left ≠ circuit.values.size + 1 := by
      rw [circuit_values_size]
      omega
    simp only [Array.getD_eq_getD_getElem?, Array.getElem?_push, Array.size_push, hleftNext, ↓reduceIte,
      hleftFirst]
  simp only [appendReverseProducts, appendInstruction_values,
    FreeAffineInstruction.eval, hfirst, hrightFirst, hsecond,
    hleftSecond]

theorem appendReverseProducts_values_getD_of_lt {ι : Type*}
    (circuit : FreeAffineCircuit ι) (adjoint : FreeAffineForm ι)
    (left right : ℕ)
    (hadjoint : ∀ index, adjoint.gateCoefficients index ≠ 0 →
      index < circuit.program.length)
    (hleft : left < circuit.program.length)
    (hright : right < circuit.program.length)
    (index : ℕ) (hindex : index < circuit.program.length) :
    (appendReverseProducts circuit adjoint left right
      hadjoint hleft hright).values.getD index 0 =
        circuit.values.getD index 0 := by
  have hzero : index ≠ circuit.values.size := by
    rw [circuit_values_size]
    omega
  have hone : index ≠ circuit.values.size + 1 := by
    rw [circuit_values_size]
    omega
  have htwo : index ≠ circuit.values.size + 1 + 1 := by
    rw [circuit_values_size]
    omega
  rw [appendReverseProducts_values]
  simp only [Array.getD_eq_getD_getElem?, Array.getElem?_push, Array.size_push, htwo, ↓reduceIte, hone, hzero]

theorem appendReverseProducts_values_right {ι : Type*}
    (circuit : FreeAffineCircuit ι) (adjoint : FreeAffineForm ι)
    (left right : ℕ)
    (hadjoint : ∀ index, adjoint.gateCoefficients index ≠ 0 →
      index < circuit.program.length)
    (hleft : left < circuit.program.length)
    (hright : right < circuit.program.length) :
    (appendReverseProducts circuit adjoint left right
      hadjoint hleft hright).values.getD
        (circuit.program.length + 1) 0 =
          adjoint.eval circuit.values * circuit.values.getD right 0 := by
  rw [appendReverseProducts_values, ← circuit_values_size circuit]
  have hmiddle : circuit.values.size + 1 <
      ((circuit.values.push (adjoint.eval circuit.values)).push
        (adjoint.eval circuit.values *
          circuit.values.getD right 0)).size := by
    simp only [Array.getD_eq_getD_getElem?, Array.size_push, lt_add_iff_pos_right, Order.lt_one_iff]
  have hlast : circuit.values.size + 1 <
      (((circuit.values.push (adjoint.eval circuit.values)).push
        (adjoint.eval circuit.values *
          circuit.values.getD right 0)).push
            (adjoint.eval circuit.values *
              circuit.values.getD left 0)).size := by
    simp only [Array.getD_eq_getD_getElem?, Array.size_push, Order.lt_add_one_iff, le_add_iff_nonneg_right,
      zero_le]
  calc
    (((circuit.values.push (adjoint.eval circuit.values)).push
        (adjoint.eval circuit.values *
          circuit.values.getD right 0)).push
            (adjoint.eval circuit.values *
              circuit.values.getD left 0)).getD
                (circuit.values.size + 1) 0 =
      (((circuit.values.push (adjoint.eval circuit.values)).push
        (adjoint.eval circuit.values *
          circuit.values.getD right 0)).push
            (adjoint.eval circuit.values *
              circuit.values.getD left 0))[circuit.values.size + 1]'hlast :=
                  (Array.getElem_eq_getD 0).symm
    _ = ((circuit.values.push (adjoint.eval circuit.values)).push
          (adjoint.eval circuit.values *
            circuit.values.getD right 0))[circuit.values.size + 1]'hmiddle :=
                Array.getElem_push_lt hmiddle
    _ = adjoint.eval circuit.values * circuit.values.getD right 0 := by
      simpa only [Array.getD_eq_getD_getElem?, Array.size_push] using
        (Array.getElem_push_eq (xs := circuit.values.push (adjoint.eval circuit.values)) (x :=
          adjoint.eval circuit.values * circuit.values.getD right 0))

theorem appendReverseProducts_values_left {ι : Type*}
    (circuit : FreeAffineCircuit ι) (adjoint : FreeAffineForm ι)
    (left right : ℕ)
    (hadjoint : ∀ index, adjoint.gateCoefficients index ≠ 0 →
      index < circuit.program.length)
    (hleft : left < circuit.program.length)
    (hright : right < circuit.program.length) :
    (appendReverseProducts circuit adjoint left right
      hadjoint hleft hright).values.getD
        (circuit.program.length + 2) 0 =
          adjoint.eval circuit.values * circuit.values.getD left 0 := by
  rw [appendReverseProducts_values, ← circuit_values_size circuit]
  have hlast : circuit.values.size + 2 <
      (((circuit.values.push (adjoint.eval circuit.values)).push
        (adjoint.eval circuit.values *
          circuit.values.getD right 0)).push
            (adjoint.eval circuit.values *
              circuit.values.getD left 0)).size := by
    simp only [Array.getD_eq_getD_getElem?, Array.size_push, lt_add_iff_pos_right, Order.lt_one_iff]
  calc
    (((circuit.values.push (adjoint.eval circuit.values)).push
        (adjoint.eval circuit.values *
          circuit.values.getD right 0)).push
            (adjoint.eval circuit.values *
              circuit.values.getD left 0)).getD
                (circuit.values.size + 2) 0 =
      (((circuit.values.push (adjoint.eval circuit.values)).push
        (adjoint.eval circuit.values *
          circuit.values.getD right 0)).push
            (adjoint.eval circuit.values *
              circuit.values.getD left 0))[circuit.values.size + 2]'hlast :=
                  (Array.getElem_eq_getD 0).symm
    _ = adjoint.eval circuit.values * circuit.values.getD left 0 := by
      simpa only [Array.getD_eq_getD_getElem?, Array.size_push] using
        (Array.getElem_push_eq (xs :=
          (circuit.values.push (adjoint.eval circuit.values)).push
            (adjoint.eval circuit.values * circuit.values.getD right 0))
          (x := adjoint.eval circuit.values * circuit.values.getD left 0))

theorem appendReverseProducts_eval_form {ι : Type*}
    (circuit : FreeAffineCircuit ι) (adjoint : FreeAffineForm ι)
    (left right : ℕ)
    (hadjoint : ∀ index, adjoint.gateCoefficients index ≠ 0 →
      index < circuit.program.length)
    (hleft : left < circuit.program.length)
    (hright : right < circuit.program.length)
    (form : FreeAffineForm ι)
    (hform : ∀ index, form.gateCoefficients index ≠ 0 →
      index < circuit.program.length) :
    form.eval (appendReverseProducts circuit adjoint left right
      hadjoint hleft hright).values = form.eval circuit.values := by
  simp only [FreeAffineForm.eval]
  refine congrArg₂ (· + ·) rfl ?_
  simp only [Finsupp.linearCombination_apply, Finsupp.sum]
  apply Finset.sum_congr rfl
  intro index hindex
  rw [appendReverseProducts_values_getD_of_lt circuit adjoint
    left right hadjoint hleft hright index
      (hform index (Finsupp.mem_support_iff.mp hindex))]

theorem appendReverseProducts_multiplicationCount {ι : Type*}
    (circuit : FreeAffineCircuit ι) (adjoint : FreeAffineForm ι)
    (left right : ℕ)
    (hadjoint : ∀ index, adjoint.gateCoefficients index ≠ 0 →
      index < circuit.program.length)
    (hleft : left < circuit.program.length)
    (hright : right < circuit.program.length) :
    (appendReverseProducts circuit adjoint left right
      hadjoint hleft hright).multiplicationCount =
        circuit.multiplicationCount + 2 := by
  simp only [FreeAffineCircuit.multiplicationCount, appendReverseProducts, appendInstruction,
    List.append_assoc, List.cons_append, List.nil_append, List.filter_append,
    FreeAffineInstruction.isMultiplication, Bool.false_eq_true, not_false_eq_true, List.filter_cons_of_neg,
    List.filter_cons_of_pos, List.filter_nil, List.length_append, List.length_cons, List.length_nil,
    zero_add, Nat.reduceAdd]

theorem affineForm_gateBound_mono {ι : Type*}
    (form : FreeAffineForm ι) {oldBound newBound : ℕ}
    (hbound : oldBound ≤ newBound)
    (hvalid : ∀ index, form.gateCoefficients index ≠ 0 →
      index < oldBound) :
    ∀ index, form.gateCoefficients index ≠ 0 → index < newBound := by
  intro index hindex
  exact Nat.lt_of_lt_of_le (hvalid index hindex) hbound

theorem affineForm_gateBound_add {ι : Type*}
    (left right : FreeAffineForm ι) (bound : ℕ)
    (hleft : ∀ index, left.gateCoefficients index ≠ 0 → index < bound)
    (hright : ∀ index, right.gateCoefficients index ≠ 0 → index < bound) :
    ∀ index, (left + right).gateCoefficients index ≠ 0 →
      index < bound := by
  intro index hindex
  change ((left.gateCoefficients + right.gateCoefficients : ℕ →₀ ℂ) index) ≠ 0
    at hindex
  by_cases hleftZero : left.gateCoefficients index = 0
  · apply hright index
    intro hrightZero
    apply hindex
    simp only [Finsupp.coe_add, Pi.add_apply, hleftZero, hrightZero, add_zero]
  · exact hleft index hleftZero

theorem affineForm_gateBound_smul {ι : Type*}
    (coefficient : ℂ) (form : FreeAffineForm ι) (bound : ℕ)
    (hvalid : ∀ index, form.gateCoefficients index ≠ 0 →
      index < bound) :
    ∀ index, (coefficient • form).gateCoefficients index ≠ 0 →
      index < bound := by
  intro index hindex
  change ((coefficient • form.gateCoefficients : ℕ →₀ ℂ) index) ≠ 0 at hindex
  apply hvalid index
  intro hzero
  apply hindex
  simp only [Finsupp.coe_smul, Pi.smul_apply, hzero, smul_eq_mul, mul_zero]

theorem affineForm_gateBound_gate {ι : Type*}
    (position bound : ℕ) (hposition : position < bound) :
    ∀ index,
      (FreeAffineForm.gate position : FreeAffineForm ι).gateCoefficients
        index ≠ 0 → index < bound := by
  intro index hindex
  change (Finsupp.single position (1 : ℂ)) index ≠ 0 at hindex
  have heq := (Finsupp.single_apply_ne_zero.mp hindex).1
  simpa only [heq, gt_iff_lt] using hposition

structure CircuitAdjoint (ι : Type*) where
  circuit : FreeAffineCircuit ι
  sourceLength : ℕ
  sourceLength_le : sourceLength ≤ circuit.program.length
  inputAdjoints : ι → FreeAffineForm ι
  gateAdjoints : ℕ → FreeAffineForm ι
  validInputAdjoints : ∀ input index,
    (inputAdjoints input).gateCoefficients index ≠ 0 →
      index < circuit.program.length
  validGateAdjoints : ∀ gate index,
    (gateAdjoints gate).gateCoefficients index ≠ 0 →
      index < circuit.program.length

namespace CircuitAdjoint

def initial {ι : Type*} (circuit : FreeAffineCircuit ι)
    (output : FreeAffineForm ι) : CircuitAdjoint ι where
  circuit := circuit
  sourceLength := circuit.program.length
  sourceLength_le := le_rfl
  inputAdjoints := fun input =>
    FreeAffineForm.scalar (output.inputCoefficients input)
  gateAdjoints := fun gate =>
    FreeAffineForm.scalar (output.gateCoefficients gate)
  validInputAdjoints := by
    intro input index hindex
    simp only [FreeAffineForm.scalar, Finsupp.coe_zero, Pi.zero_apply, ne_eq, not_true_eq_false] at hindex
  validGateAdjoints := by
    intro gate index hindex
    simp only [FreeAffineForm.scalar, Finsupp.coe_zero, Pi.zero_apply, ne_eq, not_true_eq_false] at hindex

def affine {ι : Type*} (state : CircuitAdjoint ι)
    (position : ℕ) (form : FreeAffineForm ι) : CircuitAdjoint ι where
  circuit := state.circuit
  sourceLength := state.sourceLength
  sourceLength_le := state.sourceLength_le
  inputAdjoints := fun input =>
    state.inputAdjoints input +
      form.inputCoefficients input • state.gateAdjoints position
  gateAdjoints := fun gate =>
    if gate = position then 0 else
      state.gateAdjoints gate +
        form.gateCoefficients gate • state.gateAdjoints position
  validInputAdjoints := by
    intro input index hindex
    exact affineForm_gateBound_add
      (state.inputAdjoints input)
      (form.inputCoefficients input • state.gateAdjoints position)
      state.circuit.program.length
      (state.validInputAdjoints input)
      (affineForm_gateBound_smul (form.inputCoefficients input)
        (state.gateAdjoints position) state.circuit.program.length
        (state.validGateAdjoints position)) index hindex
  validGateAdjoints := by
    intro gate index hindex
    by_cases hgate : gate = position
    · subst gate
      simp only [] at hindex
      change ((0 : ℕ →₀ ℂ) index) ≠ 0 at hindex
      simp only [Finsupp.coe_zero, Pi.zero_apply, ne_eq, not_true_eq_false] at hindex
    · apply affineForm_gateBound_add
        (state.gateAdjoints gate)
        (form.gateCoefficients gate • state.gateAdjoints position)
        state.circuit.program.length
        (state.validGateAdjoints gate)
        (affineForm_gateBound_smul (form.gateCoefficients gate)
          (state.gateAdjoints position) state.circuit.program.length
          (state.validGateAdjoints position)) index
      simpa only [ne_eq, hgate, ↓reduceIte] using hindex

def mul {ι : Type*} (state : CircuitAdjoint ι)
    (position left right : ℕ)
    (hleft : left < state.sourceLength)
    (hright : right < state.sourceLength) : CircuitAdjoint ι := by
  let hadjoint : ∀ index,
      (state.gateAdjoints position).gateCoefficients index ≠ 0 →
        index < state.circuit.program.length :=
    state.validGateAdjoints position
  let hleft' : left < state.circuit.program.length :=
    Nat.lt_of_lt_of_le hleft state.sourceLength_le
  let hright' : right < state.circuit.program.length :=
    Nat.lt_of_lt_of_le hright state.sourceLength_le
  let next := appendReverseProducts state.circuit
    (state.gateAdjoints position) left right hadjoint hleft' hright'
  have hnext : next.program.length = state.circuit.program.length + 3 :=
    appendReverseProducts_program_length state.circuit
      (state.gateAdjoints position) left right hadjoint hleft' hright'
  refine
    { circuit := next
      sourceLength := state.sourceLength
      sourceLength_le :=
        Nat.le_trans state.sourceLength_le (by omega)
      inputAdjoints := state.inputAdjoints
      gateAdjoints := fun gate =>
        (if gate = position then 0 else state.gateAdjoints gate) +
          (if gate = left then
            FreeAffineForm.gate (state.circuit.program.length + 1)
          else 0) +
          (if gate = right then
            FreeAffineForm.gate (state.circuit.program.length + 2)
          else 0)
      validInputAdjoints := ?_
      validGateAdjoints := ?_ }
  · intro input index hindex
    apply affineForm_gateBound_mono (state.inputAdjoints input)
      (by omega) (state.validInputAdjoints input) index hindex
  · intro gate index hindex
    have hbase :
        ∀ index,
          (if gate = position then (0 : FreeAffineForm ι)
            else state.gateAdjoints gate).gateCoefficients index ≠ 0 →
              index < next.program.length := by
      by_cases hgate : gate = position
      · subst gate
        intro index hindex
        simp only [] at hindex
        change ((0 : ℕ →₀ ℂ) index) ≠ 0 at hindex
        simp only [Finsupp.coe_zero, Pi.zero_apply, ne_eq, not_true_eq_false] at hindex
      · simpa only [hgate, ↓reduceIte, ne_eq] using
          affineForm_gateBound_mono (state.gateAdjoints gate) (by omega) (state.validGateAdjoints gate)
    have hleftForm :
        ∀ index,
          (if gate = left then
            FreeAffineForm.gate (state.circuit.program.length + 1)
          else (0 : FreeAffineForm ι)).gateCoefficients index ≠ 0 →
            index < next.program.length := by
      by_cases hgate : gate = left
      · simpa only [hgate, ↓reduceIte, ne_eq] using
          affineForm_gateBound_gate (ι := ι) (state.circuit.program.length + 1) next.program.length (by omega)
      · simp only [hgate, ↓reduceIte]
        intro index hindex
        change ((0 : ℕ →₀ ℂ) index) ≠ 0 at hindex
        simp only [Finsupp.coe_zero, Pi.zero_apply, ne_eq, not_true_eq_false] at hindex
    have hrightForm :
        ∀ index,
          (if gate = right then
            FreeAffineForm.gate (state.circuit.program.length + 2)
          else (0 : FreeAffineForm ι)).gateCoefficients index ≠ 0 →
            index < next.program.length := by
      by_cases hgate : gate = right
      · simpa only [hgate, ↓reduceIte, ne_eq] using
          affineForm_gateBound_gate (ι := ι) (state.circuit.program.length + 2) next.program.length (by omega)
      · simp only [hgate, ↓reduceIte]
        intro index hindex
        change ((0 : ℕ →₀ ℂ) index) ≠ 0 at hindex
        simp only [Finsupp.coe_zero, Pi.zero_apply, ne_eq, not_true_eq_false] at hindex
    exact affineForm_gateBound_add
      ((if gate = position then 0 else state.gateAdjoints gate) +
        (if gate = left then
          FreeAffineForm.gate (state.circuit.program.length + 1)
        else 0))
      (if gate = right then
        FreeAffineForm.gate (state.circuit.program.length + 2)
      else 0)
      next.program.length
      (affineForm_gateBound_add
        (if gate = position then 0 else state.gateAdjoints gate)
        (if gate = left then
          FreeAffineForm.gate (state.circuit.program.length + 1)
        else 0)
        next.program.length hbase hleftForm)
      hrightForm index hindex

@[simp] theorem mul_circuit {ι : Type*}
    (state : CircuitAdjoint ι) (position left right : ℕ)
    (hleft : left < state.sourceLength)
    (hright : right < state.sourceLength) :
    (state.mul position left right hleft hright).circuit =
      appendReverseProducts state.circuit
        (state.gateAdjoints position) left right
        (state.validGateAdjoints position)
        (Nat.lt_of_lt_of_le hleft state.sourceLength_le)
        (Nat.lt_of_lt_of_le hright state.sourceLength_le) := rfl

@[simp] theorem mul_inputAdjoints_apply {ι : Type*}
    (state : CircuitAdjoint ι) (position left right : ℕ)
    (hleft : left < state.sourceLength)
    (hright : right < state.sourceLength) (input : ι) :
    (state.mul position left right hleft hright).inputAdjoints input =
      state.inputAdjoints input := rfl

@[simp] theorem mul_gateAdjoints_apply {ι : Type*}
    (state : CircuitAdjoint ι) (position left right : ℕ)
    (hleft : left < state.sourceLength)
    (hright : right < state.sourceLength) (gate : ℕ) :
    (state.mul position left right hleft hright).gateAdjoints gate =
      (if gate = position then 0 else state.gateAdjoints gate) +
        (if gate = left then
          FreeAffineForm.gate (state.circuit.program.length + 1)
        else 0) +
        (if gate = right then
          FreeAffineForm.gate (state.circuit.program.length + 2)
        else 0) := rfl

theorem mul_eval_form {ι : Type*}
    (state : CircuitAdjoint ι) (position left right : ℕ)
    (hleft : left < state.sourceLength)
    (hright : right < state.sourceLength)
    (form : FreeAffineForm ι)
    (hform : ∀ index, form.gateCoefficients index ≠ 0 →
      index < state.circuit.program.length) :
    form.eval (state.mul position left right hleft hright).circuit.values =
      form.eval state.circuit.values := by
  rw [mul_circuit]
  exact appendReverseProducts_eval_form state.circuit
    (state.gateAdjoints position) left right
    (state.validGateAdjoints position)
    (Nat.lt_of_lt_of_le hleft state.sourceLength_le)
    (Nat.lt_of_lt_of_le hright state.sourceLength_le)
    form hform

theorem mul_values_getD_of_lt {ι : Type*}
    (state : CircuitAdjoint ι) (position left right : ℕ)
    (hleft : left < state.sourceLength)
    (hright : right < state.sourceLength)
    (gate : ℕ) (hgate : gate < state.circuit.program.length) :
    (state.mul position left right hleft hright).circuit.values.getD
        gate 0 = state.circuit.values.getD gate 0 := by
  rw [mul_circuit]
  exact appendReverseProducts_values_getD_of_lt state.circuit
    (state.gateAdjoints position) left right
    (state.validGateAdjoints position)
    (Nat.lt_of_lt_of_le hleft state.sourceLength_le)
    (Nat.lt_of_lt_of_le hright state.sourceLength_le) gate hgate

theorem mul_multiplicationCount {ι : Type*}
    (state : CircuitAdjoint ι) (position left right : ℕ)
    (hleft : left < state.sourceLength)
    (hright : right < state.sourceLength) :
    (state.mul position left right hleft hright).circuit.multiplicationCount =
      state.circuit.multiplicationCount + 2 := by
  exact appendReverseProducts_multiplicationCount state.circuit
    (state.gateAdjoints position) left right
    (state.validGateAdjoints position)
    (Nat.lt_of_lt_of_le hleft state.sourceLength_le)
    (Nat.lt_of_lt_of_le hright state.sourceLength_le)

end CircuitAdjoint

def instructionCost {ι : Type*} : FreeAffineInstruction ι → ℕ
  | .affine _ => 0
  | .mul _ _ => 2

theorem instructionCost_sum {ι : Type*}
    (program : List (FreeAffineInstruction ι)) :
    (program.map instructionCost).sum =
      2 * (program.filter FreeAffineInstruction.isMultiplication).length := by
  induction program with
  | nil => simp only [List.map_nil, List.sum_nil, List.filter_nil, List.length_nil, mul_zero]
  | cons instruction rest ih =>
    cases instruction with
    | affine form =>
      simpa only [List.map_cons, instructionCost, List.sum_cons, zero_add, FreeAffineInstruction.isMultiplication,
        Bool.false_eq_true, not_false_eq_true, List.filter_cons_of_neg] using ih
    | mul left right =>
      simp only [List.map_cons, instructionCost, List.sum_cons, ih, FreeAffineInstruction.isMultiplication,
        List.filter_cons_of_pos, List.length_cons, Nat.add_comm, Nat.mul_add, mul_one]

theorem zipIdx_instructionCost_sum {ι : Type*}
    (program : List (FreeAffineInstruction ι)) (start : ℕ) :
    ((program.zipIdx start).map (fun instruction =>
      instructionCost instruction.1)).sum =
      (program.map instructionCost).sum := by
  induction program generalizing start with
  | nil => simp only [List.zipIdx_nil, List.map_nil, List.sum_nil]
  | cons instruction rest ih =>
    simpa only [List.zipIdx_cons, List.map_cons, List.sum_cons, Nat.add_left_cancel_iff] using
      congrArg (fun count : ℕ => instructionCost instruction + count) (ih (start + 1))

namespace CircuitAdjoint

theorem affine_inputAdjoints_eval {ι : Type*}
    (state : CircuitAdjoint ι) (position : ℕ)
    (form : FreeAffineForm ι) (input : ι) :
    ((state.affine position form).inputAdjoints input).eval
        (state.affine position form).circuit.values =
      (state.inputAdjoints input).eval state.circuit.values +
        MvPolynomial.C (form.inputCoefficients input) *
          (state.gateAdjoints position).eval state.circuit.values := by
  change
    (state.inputAdjoints input +
      form.inputCoefficients input • state.gateAdjoints position).eval
        state.circuit.values = _
  simp only [FreeAffineForm.eval_add, FreeAffineForm.eval_smul, MvPolynomial.smul_eq_C_mul]

theorem affine_gateAdjoints_eval {ι : Type*}
    (state : CircuitAdjoint ι) (position : ℕ)
    (form : FreeAffineForm ι) (gate : ℕ) :
    ((state.affine position form).gateAdjoints gate).eval
        (state.affine position form).circuit.values =
      if gate = position then 0 else
        (state.gateAdjoints gate).eval state.circuit.values +
          MvPolynomial.C (form.gateCoefficients gate) *
            (state.gateAdjoints position).eval state.circuit.values := by
  change
    (if gate = position then (0 : FreeAffineForm ι) else
      state.gateAdjoints gate +
        form.gateCoefficients gate • state.gateAdjoints position).eval
          state.circuit.values = _
  split_ifs with hgate
  · simp only [FreeAffineForm.eval_zero]
  · simp only [FreeAffineForm.eval_add, FreeAffineForm.eval_smul, MvPolynomial.smul_eq_C_mul]

theorem mul_new_right {ι : Type*}
    (state : CircuitAdjoint ι) (position left right : ℕ)
    (hleft : left < state.sourceLength)
    (hright : right < state.sourceLength) :
    (state.mul position left right hleft hright).circuit.values.getD
        (state.circuit.program.length + 1) 0 =
      (state.gateAdjoints position).eval state.circuit.values *
        state.circuit.values.getD right 0 := by
  rw [mul_circuit]
  exact appendReverseProducts_values_right state.circuit
    (state.gateAdjoints position) left right
    (state.validGateAdjoints position)
    (Nat.lt_of_lt_of_le hleft state.sourceLength_le)
    (Nat.lt_of_lt_of_le hright state.sourceLength_le)

theorem mul_new_left {ι : Type*}
    (state : CircuitAdjoint ι) (position left right : ℕ)
    (hleft : left < state.sourceLength)
    (hright : right < state.sourceLength) :
    (state.mul position left right hleft hright).circuit.values.getD
        (state.circuit.program.length + 2) 0 =
      (state.gateAdjoints position).eval state.circuit.values *
        state.circuit.values.getD left 0 := by
  rw [mul_circuit]
  exact appendReverseProducts_values_left state.circuit
    (state.gateAdjoints position) left right
    (state.validGateAdjoints position)
    (Nat.lt_of_lt_of_le hleft state.sourceLength_le)
    (Nat.lt_of_lt_of_le hright state.sourceLength_le)

theorem mul_inputAdjoints_eval {ι : Type*}
    (state : CircuitAdjoint ι) (position left right : ℕ)
    (hleft : left < state.sourceLength)
    (hright : right < state.sourceLength) (input : ι) :
    ((state.mul position left right hleft hright).inputAdjoints input).eval
        (state.mul position left right hleft hright).circuit.values =
      (state.inputAdjoints input).eval state.circuit.values := by
  rw [mul_inputAdjoints_apply]
  exact mul_eval_form state position left right hleft hright
    (state.inputAdjoints input) (state.validInputAdjoints input)

theorem mul_gateAdjoints_eval {ι : Type*}
    (state : CircuitAdjoint ι) (position left right : ℕ)
    (hleft : left < state.sourceLength)
    (hright : right < state.sourceLength) (gate : ℕ) :
    ((state.mul position left right hleft hright).gateAdjoints gate).eval
        (state.mul position left right hleft hright).circuit.values =
      (if gate = position then 0 else
        (state.gateAdjoints gate).eval state.circuit.values) +
      (if gate = left then
        (state.gateAdjoints position).eval state.circuit.values *
          state.circuit.values.getD right 0 else 0) +
      (if gate = right then
        (state.gateAdjoints position).eval state.circuit.values *
          state.circuit.values.getD left 0 else 0) := by
  have hold := mul_eval_form state position left right hleft hright
    (state.gateAdjoints gate) (state.validGateAdjoints gate)
  have hrightGate := mul_new_right state position left right hleft hright
  have hleftGate := mul_new_left state position left right hleft hright
  have hbase :
      (if gate = position then (0 : FreeAffineForm ι)
        else state.gateAdjoints gate).eval
          (state.mul position left right hleft hright).circuit.values =
        if gate = position then 0 else
          (state.gateAdjoints gate).eval state.circuit.values := by
    by_cases hgate : gate = position
    · simp only [hgate, ↓reduceIte, FreeAffineForm.eval_zero]
    · simp only [hgate, ↓reduceIte]
      exact hold
  have hrightForm :
      (if gate = left then
        FreeAffineForm.gate (state.circuit.program.length + 1)
      else (0 : FreeAffineForm ι)).eval
        (state.mul position left right hleft hright).circuit.values =
      if gate = left then
        (state.gateAdjoints position).eval state.circuit.values *
          state.circuit.values.getD right 0 else 0 := by
    by_cases hgate : gate = left
    · simp only [hgate, ↓reduceIte, FreeAffineForm.eval_gate]
      exact hrightGate
    · simp only [hgate, ↓reduceIte, FreeAffineForm.eval_zero]
  have hleftForm :
      (if gate = right then
        FreeAffineForm.gate (state.circuit.program.length + 2)
      else (0 : FreeAffineForm ι)).eval
        (state.mul position left right hleft hright).circuit.values =
      if gate = right then
        (state.gateAdjoints position).eval state.circuit.values *
          state.circuit.values.getD left 0 else 0 := by
    by_cases hgate : gate = right
    · simp only [hgate, ↓reduceIte, FreeAffineForm.eval_gate]
      exact hleftGate
    · simp only [hgate, ↓reduceIte, FreeAffineForm.eval_zero]
  rw [mul_gateAdjoints_apply, FreeAffineForm.eval_add,
    FreeAffineForm.eval_add, hbase, hrightForm, hleftForm]

def step {ι : Type*} (state : CircuitAdjoint ι)
    (instruction : FreeAffineInstruction ι × ℕ) : CircuitAdjoint ι :=
  match instruction.1 with
  | .affine form => state.affine instruction.2 form
  | .mul left right =>
    if h : left < state.sourceLength ∧ right < state.sourceLength then
      state.mul instruction.2 left right h.1 h.2
    else
      state

@[simp] theorem step_sourceLength {ι : Type*}
    (state : CircuitAdjoint ι)
    (instruction : FreeAffineInstruction ι × ℕ) :
    (step state instruction).sourceLength = state.sourceLength := by
  rcases instruction with ⟨instruction, position⟩
  cases instruction with
  | affine form => rfl
  | mul left right =>
    by_cases h : left < state.sourceLength ∧
      right < state.sourceLength
    · simp only [step, h, and_self, ↓reduceDIte, mul]
    · simp only [step, h, ↓reduceDIte]

theorem step_multiplicationCount {ι : Type*}
    (state : CircuitAdjoint ι)
    (instruction : FreeAffineInstruction ι × ℕ)
    (hposition : instruction.2 < state.sourceLength)
    (hvalid : instruction.1.referencesBounded instruction.2) :
    (step state instruction).circuit.multiplicationCount =
      state.circuit.multiplicationCount +
        ReverseAdjoint.instructionCost instruction.1 := by
  rcases instruction with ⟨instruction, position⟩
  cases instruction with
  | affine form =>
    change state.circuit.multiplicationCount = _
    simp only [instructionCost, add_zero]
  | mul left right =>
    simp only [FreeAffineInstruction.referencesBounded,
      Bool.and_eq_true, decide_eq_true_eq] at hvalid
    have hbounds : left < state.sourceLength ∧
        right < state.sourceLength := by
      constructor <;> omega
    simpa only [step, hbounds, and_self, ↓reduceDIte, mul_circuit, instructionCost] using
      mul_multiplicationCount state position left right hbounds.1 hbounds.2

theorem foldl_multiplicationCount {ι : Type*}
    (instructions : List (FreeAffineInstruction ι × ℕ))
    (state : CircuitAdjoint ι)
    (hposition : ∀ instruction ∈ instructions,
      instruction.2 < state.sourceLength)
    (hvalid : ∀ instruction ∈ instructions,
      instruction.1.referencesBounded instruction.2) :
    (instructions.foldl step state).circuit.multiplicationCount =
      state.circuit.multiplicationCount +
        (instructions.map (fun instruction =>
          ReverseAdjoint.instructionCost instruction.1)).sum := by
  induction instructions generalizing state with
  | nil => simp only [List.foldl_nil, List.map_nil, List.sum_nil, add_zero]
  | cons instruction rest ih =>
    have hheadPosition := hposition instruction (by simp only [List.mem_cons, true_or])
    have hheadValid := hvalid instruction (by simp only [List.mem_cons, true_or])
    have hrestPosition : ∀ gate ∈ rest,
        gate.2 < (step state instruction).sourceLength := by
      intro gate hgate
      rw [step_sourceLength]
      apply hposition gate
      simp only [List.mem_cons, hgate, or_true]
    have hrestValid : ∀ gate ∈ rest,
        gate.1.referencesBounded gate.2 := by
      intro gate hgate
      apply hvalid gate
      simp only [List.mem_cons, hgate, or_true]
    simp only [List.foldl_cons, List.map_cons, List.sum_cons]
    rw [ih (step state instruction) hrestPosition hrestValid,
      step_multiplicationCount state instruction
        hheadPosition hheadValid]
    omega

def run {ι : Type*} (circuit : FreeAffineCircuit ι)
    (output : FreeAffineForm ι) : CircuitAdjoint ι :=
  circuit.program.zipIdx.reverse.foldl step (initial circuit output)

theorem run_multiplicationCount {ι : Type*}
    (circuit : FreeAffineCircuit ι) (output : FreeAffineForm ι) :
    (run circuit output).circuit.multiplicationCount =
      3 * circuit.multiplicationCount := by
  have hposition : ∀ instruction ∈ circuit.program.zipIdx.reverse,
      instruction.2 < (initial circuit output).sourceLength := by
    intro instruction hmem
    have hzip : instruction ∈ circuit.program.zipIdx := by
      simpa only [List.mem_reverse] using hmem
    rcases instruction with ⟨gate, position⟩
    obtain ⟨hposition, _⟩ := List.mem_zipIdx' hzip
    exact hposition
  have hvalid : ∀ instruction ∈ circuit.program.zipIdx.reverse,
      instruction.1.referencesBounded instruction.2 := by
    intro instruction hmem
    have hzip : instruction ∈ circuit.program.zipIdx := by
      simpa only [List.mem_reverse] using hmem
    rcases instruction with ⟨gate, position⟩
    obtain ⟨hposition, hgate⟩ := List.mem_zipIdx' hzip
    simpa only [hgate, List.get_eq_getElem] using circuit.valid ⟨position, hposition⟩
  unfold run
  rw [foldl_multiplicationCount _ _ hposition hvalid]
  simp only [initial, List.map_reverse, List.sum_reverse]
  rw [ReverseAdjoint.zipIdx_instructionCost_sum,
    ReverseAdjoint.instructionCost_sum]
  change
    circuit.multiplicationCount +
      2 * circuit.multiplicationCount =
        3 * circuit.multiplicationCount
  omega

theorem step_realizes {ι : Type*}
    (state : CircuitAdjoint ι) (adjoints : ReverseAdjoint ι)
    (sourceValues : Array (MvPolynomial ι ℂ))
    (instruction : FreeAffineInstruction ι × ℕ)
    (hposition : instruction.2 < state.sourceLength)
    (hvalid : instruction.1.referencesBounded instruction.2)
    (hforward : ∀ gate, gate < state.sourceLength →
      state.circuit.values.getD gate 0 = sourceValues.getD gate 0)
    (hinput : ∀ input,
      (state.inputAdjoints input).eval state.circuit.values =
        adjoints.inputAdjoints input)
    (hgate : ∀ gate,
      (state.gateAdjoints gate).eval state.circuit.values =
        adjoints.gateAdjoints gate) :
    (∀ gate, gate < state.sourceLength →
      (step state instruction).circuit.values.getD gate 0 =
        sourceValues.getD gate 0) ∧
    (∀ input,
      ((step state instruction).inputAdjoints input).eval
        (step state instruction).circuit.values =
          (ReverseAdjoint.step sourceValues adjoints
            instruction).inputAdjoints input) ∧
    (∀ gate,
      ((step state instruction).gateAdjoints gate).eval
        (step state instruction).circuit.values =
          (ReverseAdjoint.step sourceValues adjoints
            instruction).gateAdjoints gate) := by
  classical
  rcases instruction with ⟨instruction, position⟩
  cases instruction with
  | affine form =>
    refine ⟨?_, ?_, ?_⟩
    · intro gate hbound
      exact hforward gate hbound
    · intro input
      change
        ((state.affine position form).inputAdjoints input).eval
            (state.affine position form).circuit.values =
          (adjoints.affine position form).inputAdjoints input
      rw [affine_inputAdjoints_eval,
        ReverseAdjoint.affine_inputAdjoints_apply,
        hinput input, hgate position]
    · intro gate
      change
        ((state.affine position form).gateAdjoints gate).eval
            (state.affine position form).circuit.values =
          (adjoints.affine position form).gateAdjoints gate
      rw [affine_gateAdjoints_eval]
      change
        (if gate = position then 0 else
          (state.gateAdjoints gate).eval state.circuit.values +
            MvPolynomial.C (form.gateCoefficients gate) *
              (state.gateAdjoints position).eval state.circuit.values) =
          (adjoints.gateAdjoints.erase position +
            ReverseAdjoint.scaleCoefficients
              (adjoints.gateAdjoints position)
              form.gateCoefficients) gate
      by_cases heq : gate = position
      · subst gate
        have hcoefficient : form.gateCoefficients position = 0 := by
          simp only [FreeAffineInstruction.referencesBounded,
            decide_eq_true_eq] at hvalid
          by_contra hnonzero
          have hlt := hvalid position
            (Finsupp.mem_support_iff.mpr hnonzero)
          omega
        simp only [↓reduceIte, Finsupp.coe_add, Pi.add_apply, Finsupp.erase_same, scaleCoefficients_apply,
          hcoefficient, MvPolynomial.C_0, zero_mul, add_zero]
      · simp only [heq, ↓reduceIte, hgate gate, hgate position, Finsupp.coe_add, Pi.add_apply, Finsupp.erase_ne heq,
          scaleCoefficients_apply]
  | mul left right =>
    simp only [FreeAffineInstruction.referencesBounded,
      Bool.and_eq_true, decide_eq_true_eq] at hvalid
    have hbounds : left < state.sourceLength ∧
        right < state.sourceLength := by
      constructor <;> omega
    have hleftValue := hforward left hbounds.1
    have hrightValue := hforward right hbounds.2
    have hstep :
        step state (.mul left right, position) =
          state.mul position left right hbounds.1 hbounds.2 := by
      simp only [step, hbounds, and_self, ↓reduceDIte]
    rw [hstep]
    refine ⟨?_, ?_, ?_⟩
    · intro gate hbound
      rw [mul_values_getD_of_lt state position left right
        hbounds.1 hbounds.2 gate
          (Nat.lt_of_lt_of_le hbound state.sourceLength_le)]
      exact hforward gate hbound
    · intro input
      change
        ((state.mul position left right hbounds.1 hbounds.2).inputAdjoints
          input).eval
            (state.mul position left right hbounds.1 hbounds.2).circuit.values =
              adjoints.inputAdjoints input
      rw [mul_inputAdjoints_eval]
      exact hinput input
    · intro gate
      rw [mul_gateAdjoints_eval]
      change
        (if gate = position then 0 else
          (state.gateAdjoints gate).eval state.circuit.values) +
        (if gate = left then
          (state.gateAdjoints position).eval state.circuit.values *
            state.circuit.values.getD right 0 else 0) +
        (if gate = right then
          (state.gateAdjoints position).eval state.circuit.values *
            state.circuit.values.getD left 0 else 0) =
        (adjoints.gateAdjoints.erase position +
          Finsupp.single left
            (adjoints.gateAdjoints position *
              sourceValues.getD right 0) +
          Finsupp.single right
            (adjoints.gateAdjoints position *
              sourceValues.getD left 0)) gate
      simp only [Finsupp.add_apply, Finsupp.erase_apply,
        Finsupp.single_apply, hgate gate, hgate position,
        hleftValue, hrightValue, eq_comm]

theorem foldl_realizes {ι : Type*}
    (instructions : List (FreeAffineInstruction ι × ℕ))
    (state : CircuitAdjoint ι) (adjoints : ReverseAdjoint ι)
    (sourceValues : Array (MvPolynomial ι ℂ))
    (hposition : ∀ instruction ∈ instructions,
      instruction.2 < state.sourceLength)
    (hvalid : ∀ instruction ∈ instructions,
      instruction.1.referencesBounded instruction.2)
    (hforward : ∀ gate, gate < state.sourceLength →
      state.circuit.values.getD gate 0 = sourceValues.getD gate 0)
    (hinput : ∀ input,
      (state.inputAdjoints input).eval state.circuit.values =
        adjoints.inputAdjoints input)
    (hgate : ∀ gate,
      (state.gateAdjoints gate).eval state.circuit.values =
        adjoints.gateAdjoints gate) :
    (∀ gate, gate < state.sourceLength →
      (instructions.foldl step state).circuit.values.getD gate 0 =
        sourceValues.getD gate 0) ∧
    (∀ input,
      ((instructions.foldl step state).inputAdjoints input).eval
        (instructions.foldl step state).circuit.values =
          (instructions.foldl
            (ReverseAdjoint.step sourceValues) adjoints).inputAdjoints
              input) ∧
    (∀ gate,
      ((instructions.foldl step state).gateAdjoints gate).eval
        (instructions.foldl step state).circuit.values =
          (instructions.foldl
            (ReverseAdjoint.step sourceValues) adjoints).gateAdjoints
              gate) := by
  induction instructions generalizing state adjoints with
  | nil =>
    exact ⟨hforward, hinput, hgate⟩
  | cons instruction rest ih =>
    have hheadPosition := hposition instruction (by simp only [List.mem_cons, true_or])
    have hheadValid := hvalid instruction (by simp only [List.mem_cons, true_or])
    obtain ⟨hnextForward, hnextInput, hnextGate⟩ :=
      step_realizes state adjoints sourceValues instruction
        hheadPosition hheadValid hforward hinput hgate
    have hrestPosition : ∀ gate ∈ rest,
        gate.2 < (step state instruction).sourceLength := by
      intro gate hmem
      rw [step_sourceLength]
      apply hposition gate
      simp only [List.mem_cons, hmem, or_true]
    have hrestValid : ∀ gate ∈ rest,
        gate.1.referencesBounded gate.2 := by
      intro gate hmem
      apply hvalid gate
      simp only [List.mem_cons, hmem, or_true]
    have hnextForward' : ∀ gate,
        gate < (step state instruction).sourceLength →
          (step state instruction).circuit.values.getD gate 0 =
            sourceValues.getD gate 0 := by
      intro gate hbound
      apply hnextForward gate
      simpa only [step_sourceLength] using hbound
    have hresult := ih (step state instruction)
      (ReverseAdjoint.step sourceValues adjoints instruction)
      hrestPosition hrestValid hnextForward' hnextInput hnextGate
    simpa only [List.foldl_cons, Array.getD_eq_getD_getElem?, step_sourceLength] using hresult

theorem run_realizes {ι : Type*}
    (circuit : FreeAffineCircuit ι) (output : FreeAffineForm ι) :
    (∀ gate, gate < circuit.program.length →
      (run circuit output).circuit.values.getD gate 0 =
        circuit.values.getD gate 0) ∧
    (∀ input,
      ((run circuit output).inputAdjoints input).eval
        (run circuit output).circuit.values =
          (ReverseAdjoint.run circuit output).inputAdjoints input) ∧
    (∀ gate,
      ((run circuit output).gateAdjoints gate).eval
        (run circuit output).circuit.values =
          (ReverseAdjoint.run circuit output).gateAdjoints gate) := by
  have hposition : ∀ instruction ∈ circuit.program.zipIdx.reverse,
      instruction.2 < (initial circuit output).sourceLength := by
    intro instruction hmem
    have hzip : instruction ∈ circuit.program.zipIdx := by
      simpa only [List.mem_reverse] using hmem
    rcases instruction with ⟨gate, position⟩
    obtain ⟨hposition, _⟩ := List.mem_zipIdx' hzip
    exact hposition
  have hvalid : ∀ instruction ∈ circuit.program.zipIdx.reverse,
      instruction.1.referencesBounded instruction.2 := by
    intro instruction hmem
    have hzip : instruction ∈ circuit.program.zipIdx := by
      simpa only [List.mem_reverse] using hmem
    rcases instruction with ⟨gate, position⟩
    obtain ⟨hposition, hgate⟩ := List.mem_zipIdx' hzip
    simpa only [hgate, List.get_eq_getElem] using circuit.valid ⟨position, hposition⟩
  have hforward : ∀ gate,
      gate < (initial circuit output).sourceLength →
        (initial circuit output).circuit.values.getD gate 0 =
          circuit.values.getD gate 0 := by
    intro gate hgate
    rfl
  have hinput : ∀ input,
      ((initial circuit output).inputAdjoints input).eval
          (initial circuit output).circuit.values =
        (ReverseAdjoint.initial output).inputAdjoints input := by
    intro input
    simp only [initial, FreeAffineForm.eval_scalar, ReverseAdjoint.initial, scaleCoefficients_apply, mul_one]
  have hgate : ∀ gate,
      ((initial circuit output).gateAdjoints gate).eval
          (initial circuit output).circuit.values =
        (ReverseAdjoint.initial output).gateAdjoints gate := by
    intro gate
    simp only [initial, FreeAffineForm.eval_scalar, ReverseAdjoint.initial, scaleCoefficients_apply, mul_one]
  simpa only [run, initial, List.foldl_reverse, Array.getD_eq_getD_getElem?, ReverseAdjoint.run] using
    foldl_realizes circuit.program.zipIdx.reverse (initial circuit output) (ReverseAdjoint.initial output)
      circuit.values hposition hvalid hforward hinput hgate

theorem run_inputAdjoints {ι : Type*}
    (circuit : FreeAffineCircuit ι)
    (output : FreeAffineForm ι) (houtput : output ∈ circuit.outputs)
    (input : ι) :
    ((run circuit output).inputAdjoints input).eval
      (run circuit output).circuit.values =
        MvPolynomial.pderiv input (output.eval circuit.values) := by
  calc
    ((run circuit output).inputAdjoints input).eval
        (run circuit output).circuit.values =
      (ReverseAdjoint.run circuit output).inputAdjoints input :=
        (run_realizes circuit output).2.1 input
    _ = MvPolynomial.pderiv input (output.eval circuit.values) :=
      ReverseAdjoint.run_inputAdjoints circuit output houtput input

end CircuitAdjoint

end ReverseAdjoint

end Standalone_ReverseMode

