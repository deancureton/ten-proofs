  apply List.forall₂_map_right_iff.mpr
  apply List.forall₂_same.mpr
  intro r _ x
  change e (r * x) = e r * e x
  exact e.map_mul r x

theorem homogeneousMap_allRank_ringEquiv_isWeaklyRegular_ofFn_image
    {R S : Type*} [CommRing R] [CommRing S]
