theorem homogeneousMap_allRank_bounded_homogeneous_hilbert_coefficient_univ
    (k e n : ℕ) :
    homogeneousMapAllKBoundedHomogeneousHilbertCoefficient k e n Finset.univ =
      homogeneousMapAllKBoxHilbertCoefficient k e n := by
  classical
  unfold homogeneousMapAllKBoundedHomogeneousHilbertCoefficient
    homogeneousMapAllKBoxHilbertCoefficient
  let s : Finset (Fin k →₀ ℕ) :=
    ((Finset.univ : Finset (Fin k)).finsuppAntidiag n).filter
      (fun d => ∀ i ∈ (Finset.univ : Finset (Fin k)), d i < e)
  let t : Finset (Fin k → Fin e) :=
    (Finset.univ : Finset (Fin k → Fin e)).filter
      (fun a => (∑ i : Fin k, (a i : ℕ)) = n)
  change s.card = t.card
  let φ (d : Fin k →₀ ℕ) (hd : d ∈ s) : Fin k → Fin e :=
    fun i => ⟨d i, (Finset.mem_filter.mp hd).2 i (Finset.mem_univ _)⟩
  refine Finset.card_bij φ ?_ ?_ ?_
  · intro d hd
    simp only [t, Finset.mem_filter, Finset.mem_univ, true_and]
    have hdegree :=
      (Finset.mem_finsuppAntidiag.mp (Finset.mem_filter.mp hd).1).1
    simpa only using hdegree
  · intro d₁ hd₁ d₂ hd₂ h
    apply Finsupp.ext
    intro i
    simpa only using congrArg (fun a : Fin k → Fin e => (a i : ℕ)) h
  · intro a ha
    have ha' : (∑ i : Fin k, (a i : ℕ)) = n := by
      simpa [t] using ha
    let d : Fin k →₀ ℕ :=
      Finsupp.equivFunOnFinite.symm (fun i => (a i : ℕ))
    have hdapply (i : Fin k) : d i = (a i : ℕ) := by
      simp only [Finsupp.equivFunOnFinite_symm_apply_apply, d]
    have hd : d ∈ s := by
      simp only [s, Finset.mem_filter, Finset.mem_finsuppAntidiag,
        Finset.subset_univ, and_true]
      constructor
      · simpa only [hdapply] using ha'
      · intro i _
        rw [hdapply]
        exact (a i).isLt
    refine ⟨d, hd, ?_⟩
    funext i
    apply Fin.ext
    exact hdapply i

theorem homogeneousMap_allRank_bounded_homogeneous_hilbert_coefficient_univ_sum
    (k e : ℕ) (hk : 0 < k) :
    (∑ n ∈ Finset.range (k * e),
      homogeneousMapAllKBoundedHomogeneousHilbertCoefficient k e n Finset.univ) =
      e ^ k := by
  classical
  let f : (Fin k → Fin e) → ℕ := fun a => ∑ i : Fin k, (a i : ℕ)
  have hf :
      ((Finset.univ : Finset (Fin k → Fin e)) : Set (Fin k → Fin e)).MapsTo f
        (Finset.range (k * e) : Set ℕ) := by
    intro a _
    change f a ∈ Finset.range (k * e)
    apply Finset.mem_range.mpr
    have hstrict :
        (∑ i : Fin k, (a i : ℕ)) < ∑ _i : Fin k, e := by
      apply Finset.sum_lt_sum
      · intro i _
        exact Nat.le_of_lt (a i).isLt
      · refine ⟨⟨0, hk⟩, Finset.mem_univ _, ?_⟩
        exact (a ⟨0, hk⟩).isLt
    simpa only [gt_iff_lt, Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul] using hstrict
  have hcard := Finset.card_eq_sum_card_fiberwise
    (s := (Finset.univ : Finset (Fin k → Fin e)))
    (t := Finset.range (k * e)) hf
  change
    Fintype.card (Fin k → Fin e) =
      ∑ n ∈ Finset.range (k * e),
        ((Finset.univ : Finset (Fin k → Fin e)).filter
          (fun a => f a = n)).card at hcard
  rw [Fintype.card_fun, Fintype.card_fin, Fintype.card_fin] at hcard
  simp_rw [homogeneousMap_allRank_bounded_homogeneous_hilbert_coefficient_univ]
  simpa only [homogeneousMapAllKBoxHilbertCoefficient] using hcard.symm

theorem homogeneousMap_allRank_bounded_homogeneous_hilbert_coefficient_univ_eq_zero_of_le
    (k e n : ℕ) (hk : 0 < k) (hn : k * e ≤ n) :
    homogeneousMapAllKBoundedHomogeneousHilbertCoefficient k e n Finset.univ = 0 := by
  classical
  rw [homogeneousMap_allRank_bounded_homogeneous_hilbert_coefficient_univ]
  unfold homogeneousMapAllKBoxHilbertCoefficient
  rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
  intro a _ ha
  have hstrict :
      (∑ i : Fin k, (a i : ℕ)) < ∑ _i : Fin k, e := by
    apply Finset.sum_lt_sum
    · intro i _
      exact Nat.le_of_lt (a i).isLt
    · refine ⟨⟨0, hk⟩, Finset.mem_univ _, ?_⟩
      exact (a ⟨0, hk⟩).isLt
  have hlt : (∑ i : Fin k, (a i : ℕ)) < k * e := by
    simpa only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul] using hstrict
  omega

theorem homogeneousMap_allRank_bounded_homogeneous_hilbert_coefficient_univ_sum_of_cutoff
    (k e N : ℕ) (hk : 0 < k) (hN : k * e ≤ N) :
    (∑ n ∈ Finset.range N,
      homogeneousMapAllKBoundedHomogeneousHilbertCoefficient k e n Finset.univ) =
        e ^ k := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hN
  rw [Finset.sum_range_add]
  have htail :
      (∑ i ∈ Finset.range m,
        homogeneousMapAllKBoundedHomogeneousHilbertCoefficient k e
          (k * e + i) Finset.univ) = 0 := by
    apply Finset.sum_eq_zero
    intro i _
    apply homogeneousMap_allRank_bounded_homogeneous_hilbert_coefficient_univ_eq_zero_of_le
      k e (k * e + i) hk
    omega
  rw [htail, add_zero]
  exact homogeneousMap_allRank_bounded_homogeneous_hilbert_coefficient_univ_sum k e hk

