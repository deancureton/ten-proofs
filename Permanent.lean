theorem homogeneousMap_allTarget_totalDegree_sub_homogeneousComponent_le
    {σ B : Type*} [CommRing B]
    (f : MvPolynomial σ B) {q : ℕ}
    (hf : f.totalDegree ≤ q) :
    (f - MvPolynomial.homogeneousComponent q f).totalDegree ≤ q - 1 := by
  classical
  rw [MvPolynomial.totalDegree, Finset.sup_le_iff]
  intro m hm
  have hmne :
      MvPolynomial.coeff m
        (f - MvPolynomial.homogeneousComponent q f) ≠ 0 :=
    MvPolynomial.mem_support_iff.mp hm
  have hmq : m.degree ≠ q := by
    intro heq
    apply hmne
    simp only [MvPolynomial.coeff_sub, MvPolynomial.coeff_homogeneousComponent, heq, ↓reduceIte, sub_self]
  have hmcoeff : MvPolynomial.coeff m f ≠ 0 := by
    intro hzero
    apply hmne
    simp only [MvPolynomial.coeff_sub, hzero, MvPolynomial.coeff_homogeneousComponent, hmq, ↓reduceIte, sub_self]
  have hmle : m.degree ≤ q :=
    (MvPolynomial.le_totalDegree
      (MvPolynomial.mem_support_iff.mpr hmcoeff)).trans hf
  change m.degree ≤ q - 1
  omega

theorem homogeneousMap_allTarget_homogeneous_linear_sub_constant_isSMulRegular
    {ι : Type*}
    (I : Ideal (MvPolynomial ι ℂ))
    (hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule ι ℂ))
    (t : MvPolynomial ι ℂ)
    (ht : t.IsHomogeneous 1)
    (htregular : IsSMulRegular (MvPolynomial ι ℂ ⧸ I) t)
    (c : ℂ) :
    IsSMulRegular (MvPolynomial ι ℂ ⧸ I)
      (t - MvPolynomial.C c) := by
  classical
  have htcolon :=
    (isSMulRegular_quotient_iff_mem_of_smul_mem I t).mp htregular
  apply (isSMulRegular_quotient_iff_mem_of_smul_mem I
    (t - MvPolynomial.C c)).mpr
  intro p hp
  have hp' : (t - MvPolynomial.C c) * p ∈ I := by
    simpa only [smul_eq_mul] using hp
  have haux : ∀ n : ℕ, ∀ q : MvPolynomial ι ℂ,
      q.totalDegree ≤ n →
      (t - MvPolynomial.C c) * q ∈ I → q ∈ I := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro q hq hproduct
      have hcomp := MvPolynomial.homogeneousComponent_mem_of_mem
        hI hproduct (n + 1)
      have hqhigh : MvPolynomial.homogeneousComponent (n + 1) q = 0 :=
        MvPolynomial.homogeneousComponent_eq_zero (n + 1) q (by omega)
      rw [sub_mul, map_sub, mul_comm t q,
        homogeneousComponent_mul_of_right_isHomogeneous q t ht
          (by omega),
        MvPolynomial.homogeneousComponent_C_mul,
        hqhigh,
        mul_zero, sub_zero] at hcomp
      have htop : MvPolynomial.homogeneousComponent n q ∈ I := by
        apply htcolon (MvPolynomial.homogeneousComponent n q)
        simpa only [smul_eq_mul, add_tsub_cancel_right, mul_comm] using hcomp
      by_cases hn : n = 0
      · subst n
        have hqzero : q.totalDegree = 0 := Nat.eq_zero_of_le_zero hq
        have hsum : MvPolynomial.homogeneousComponent 0 q = q := by
          simpa only [hqzero, zero_add,
            Finset.sum_range_succ, Finset.sum_range_zero, zero_add] using
            (MvPolynomial.sum_homogeneousComponent q)
        exact hsum ▸ htop
      · let q' := q - MvPolynomial.homogeneousComponent n q
        have hdegree : q'.totalDegree < n := by
          have hbound :=
            homogeneousMap_allTarget_totalDegree_sub_homogeneousComponent_le q hq
          change (q - MvPolynomial.homogeneousComponent n q).totalDegree < n
          omega
        have hq' : (t - MvPolynomial.C c) * q' ∈ I := by
          change (t - MvPolynomial.C c) *
            (q - MvPolynomial.homogeneousComponent n q) ∈ I
          rw [mul_sub]
          exact I.sub_mem hproduct
            (I.mul_mem_left (t - MvPolynomial.C c) htop)
        have hq'mem : q' ∈ I :=
          ih q'.totalDegree hdegree q' (le_refl _) hq'
        have hdecomp : q' + MvPolynomial.homogeneousComponent n q = q := by
          dsimp [q']
          ring
        rw [← hdecomp]
        exact I.add_mem hq'mem htop
  exact haux p.totalDegree p (le_refl _) hp'

theorem homogeneousMap_allTarget_homogeneous_aeval_isSMulRegular
    {ι : Type*}
    (I : Ideal (MvPolynomial ι ℂ))
    (hI : I.IsHomogeneous (MvPolynomial.homogeneousSubmodule ι ℂ))
    (t : MvPolynomial ι ℂ)
    (ht : t.IsHomogeneous 1)
    (htregular : IsSMulRegular (MvPolynomial ι ℂ ⧸ I) t)
    (p : Polynomial ℂ) (hp : p ≠ 0) :
    IsSMulRegular (MvPolynomial ι ℂ ⧸ I)
      (Polynomial.aeval t p) := by
  classical
  have hleading : p.leadingCoeff ≠ 0 :=
    Polynomial.leadingCoeff_ne_zero.mpr hp
  have hunit : IsUnit
      (MvPolynomial.C p.leadingCoeff : MvPolynomial ι ℂ) :=
    (isUnit_iff_ne_zero.mpr hleading).map
      (MvPolynomial.C : ℂ →+* MvPolynomial ι ℂ)
  have hregularLeading :
      IsSMulRegular (MvPolynomial ι ℂ ⧸ I)
        (MvPolynomial.C p.leadingCoeff) :=
    hunit.isSMulRegular _
  have hprod : ∀ roots : Multiset ℂ,
      IsSMulRegular (MvPolynomial ι ℂ ⧸ I)
        ((roots.map fun a => t - MvPolynomial.C a).prod) := by
    intro roots
    induction roots using Multiset.induction_on with
    | empty =>
        simp only [Multiset.map_zero, Multiset.prod_zero, IsSMulRegular.one]
    | @cons a roots ih =>
        simpa only [Multiset.map_cons, Multiset.prod_cons] using
          (homogeneousMap_allTarget_homogeneous_linear_sub_constant_isSMulRegular I hI t ht htregular a).mul ih
  have hsplit := (IsAlgClosed.splits p).eq_prod_roots
  have heval := congrArg (Polynomial.aeval t) hsplit
  have heval' :
      Polynomial.aeval t p =
        MvPolynomial.C p.leadingCoeff *
          ((p.roots.map fun a => t - MvPolynomial.C a).prod) := by
    simpa only [map_mul, Polynomial.aeval_C, MvPolynomial.algebraMap_eq, map_multiset_prod, Multiset.map_map,
      Function.comp_apply, Polynomial.aeval_sub, Polynomial.aeval_X] using heval
  rw [heval']
  exact hregularLeading.mul (hprod p.roots)

noncomputable def homogeneousMapReesTargetHom
    {ι : Type*} [Finite ι]
    (F : ι → MvPolynomial ι ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : ι → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (target : ι → ℂ) :
    homogeneousMapSubalgebra F →ₐ[ℂ] Polynomial ℂ :=
  (MvPolynomial.aeval fun i : ι =>
    Polynomial.C (target i) * Polynomial.X ^ e).comp
    (homogeneousMapCoordinateAlgEquiv F e he hF hzero).symm.toAlgHom

theorem homogeneousMapReesTargetHom_coordinate
    {ι : Type*} [Finite ι]
    (F : ι → MvPolynomial ι ℂ)
    (e : ℕ) (he : 0 < e)
    (hF : ∀ i, (F i).IsHomogeneous e)
    (hzero : ∀ point : ι → ℂ,
      (∀ i, MvPolynomial.eval point (F i) = 0) ↔ point = 0)
    (target : ι → ℂ) (i : ι) :
    homogeneousMapReesTargetHom F e he hF hzero target
      (⟨F i, homogeneousMap_coordinate_mem_subalgebra F i⟩ :
        homogeneousMapSubalgebra F) =
      Polynomial.C (target i) * Polynomial.X ^ e := by
  let E := homogeneousMapCoordinateAlgEquiv F e he hF hzero
  have hE : E (MvPolynomial.X i) =
      (⟨F i, homogeneousMap_coordinate_mem_subalgebra F i⟩ :
        homogeneousMapSubalgebra F) := by
    apply Subtype.ext
    change MvPolynomial.aeval F (MvPolynomial.X i) = F i
    simp only [MvPolynomial.aeval_eq_bind₁, MvPolynomial.bind₁_X_right]
  change (MvPolynomial.aeval fun q : ι =>
    Polynomial.C (target q) * Polynomial.X ^ e)
    (E.symm
      (⟨F i, homogeneousMap_coordinate_mem_subalgebra F i⟩ :
        homogeneousMapSubalgebra F)) = _
  rw [← hE, E.symm_apply_apply, MvPolynomial.aeval_X]

