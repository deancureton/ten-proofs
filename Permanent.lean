theorem homogeneousMap_allRank_bounded_homogeneous_hilbert_coefficient_insert_recurrence
    (k e n : ℕ) (restricted : Finset (Fin k)) (j : Fin k)
    (hj : j ∉ restricted) :
    homogeneousMapAllKBoundedHomogeneousHilbertCoefficient k e (e + n)
        (insert j restricted) +
      homogeneousMapAllKBoundedHomogeneousHilbertCoefficient k e n restricted =
      homogeneousMapAllKBoundedHomogeneousHilbertCoefficient k e (e + n) restricted := by
  classical
  let s : Finset (Fin k →₀ ℕ) :=
    ((Finset.univ : Finset (Fin k)).finsuppAntidiag (e + n)).filter
      (fun d => ∀ i ∈ restricted, d i < e)
  let t : Finset (Fin k →₀ ℕ) :=
    ((Finset.univ : Finset (Fin k)).finsuppAntidiag n).filter
      (fun d => ∀ i ∈ restricted, d i < e)
  have hgood :
      (s.filter (fun d => d j < e)).card =
        homogeneousMapAllKBoundedHomogeneousHilbertCoefficient k e (e + n)
          (insert j restricted) := by
    unfold homogeneousMapAllKBoundedHomogeneousHilbertCoefficient
    congr 1
    ext d
    simp only [Finset.mem_filter, Finset.mem_finsuppAntidiag, Finset.subset_univ, and_comm, true_and,
      and_left_comm, Finset.mem_insert, forall_eq_or_imp, s]
  have hbad :
      t.card = (s.filter (fun d => ¬ d j < e)).card := by
    refine Finset.card_bij (fun d _ => d + Finsupp.single j e) ?_ ?_ ?_
    · intro d hd
      simp only [t, Finset.mem_filter, Finset.mem_finsuppAntidiag,
        Finset.subset_univ, and_true] at hd
      simp only [s, Finset.mem_filter, Finset.mem_finsuppAntidiag,
        Finset.subset_univ, and_true]
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · have hdegree : d.degree = n := by
          simpa only [Finsupp.degree_eq_sum] using hd.1
        have hsum : (d + Finsupp.single j e).degree = n + e := by
          simp only [map_add, hdegree, Finsupp.degree_single]
        simpa only [Finsupp.coe_add, Pi.add_apply, Finsupp.degree_eq_sum, Nat.add_comm] using hsum
      · intro i hi
        have hij : j ≠ i := by
          intro h
          exact hj (h ▸ hi)
        simpa only [Finsupp.coe_add, Pi.add_apply, ne_eq, hij, not_false_eq_true, Finsupp.single_eq_of_ne', add_zero,
          gt_iff_lt] using hd.2 i hi
      · simp only [Finsupp.coe_add, Pi.add_apply, Finsupp.single_eq_same, add_lt_iff_neg_right, not_lt_zero,
          not_false_eq_true]
    · intro d₁ _ d₂ _ h
      exact add_right_cancel h
    · intro d hd
      simp only [s, Finset.mem_filter, Finset.mem_finsuppAntidiag,
        Finset.subset_univ, and_true] at hd
      let a : Fin k →₀ ℕ := d - Finsupp.single j e
      have hle : e ≤ d j := by omega
      have hrecover : a + Finsupp.single j e = d := by
        ext i
        by_cases hi : j = i
        · subst i
          simpa [a] using Nat.sub_add_cancel hle
        · simp only [Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply, ne_eq, hi, not_false_eq_true,
            Finsupp.single_eq_of_ne', tsub_zero, add_zero, a]
      refine ⟨a, ?_, hrecover⟩
      simp only [t, Finset.mem_filter, Finset.mem_finsuppAntidiag,
        Finset.subset_univ, and_true]
      refine ⟨?_, ?_⟩
      · have hdegree : d.degree = e + n := by
          simpa only [Finsupp.degree_eq_sum] using hd.1.1
        have hrecoverDegree := congrArg Finsupp.degree hrecover
        have hadegree : a.degree + e = e + n := by
          simpa only [map_add, Finsupp.degree_single, hdegree] using hrecoverDegree
        have han : a.degree = n := by omega
        simpa only [Finsupp.degree_eq_sum] using han
      · intro i hi
        have hji : j ≠ i := by
          intro h
          exact hj (h ▸ hi)
        simpa [a, Finsupp.single_apply, hji] using hd.1.2 i hi
  have hsplit := Finset.card_filter_add_card_filter_not
    (s := s) (fun d : Fin k →₀ ℕ => d j < e)
  change homogeneousMapAllKBoundedHomogeneousHilbertCoefficient k e (e + n)
      (insert j restricted) + t.card = s.card
  rw [← hgood, hbad]
  exact hsplit

theorem homogeneousMap_allRank_hilbert_coefficient_eq_bounded_of_insert_recurrence
    (k e : ℕ) (restricted : Finset (Fin k)) (j : Fin k)
    (hj : j ∉ restricted) (Hprev Hnext : ℕ → ℕ)
    (hprev : ∀ n, Hprev n =
      homogeneousMapAllKBoundedHomogeneousHilbertCoefficient k e n restricted)
    (hlow : ∀ n, n < e → Hnext n = Hprev n)
    (hrec : ∀ n, Hnext (e + n) + Hprev n = Hprev (e + n)) :
    ∀ n, Hnext n =
      homogeneousMapAllKBoundedHomogeneousHilbertCoefficient k e n
        (insert j restricted) := by
  intro n
  by_cases hn : n < e
  · calc
      Hnext n = Hprev n := hlow n hn
      _ = homogeneousMapAllKBoundedHomogeneousHilbertCoefficient k e n
        restricted := hprev n
      _ = homogeneousMapAllKBoundedHomogeneousHilbertCoefficient k e n
        (insert j restricted) :=
          (homogeneousMap_allRank_bounded_homogeneous_hilbert_coefficient_insert_of_lt
            k e n restricted j hn).symm
  · obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le (Nat.le_of_not_gt hn)
    have hactual := hrec m
    have hbounded :=
      homogeneousMap_allRank_bounded_homogeneous_hilbert_coefficient_insert_recurrence
        k e m restricted j hj
    have hprevlow := hprev m
    have hprevhigh := hprev (e + m)
    omega

