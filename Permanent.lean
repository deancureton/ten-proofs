noncomputable def homogeneousMapFinSuccFirstPivotPlaneMap
    {n : ℕ} (c : Fin (n + 1) → ℂ) :
    (Fin n → ℂ) →ₗ[ℂ] (Fin (n + 1) → ℂ) :=
